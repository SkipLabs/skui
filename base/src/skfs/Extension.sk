class ArrayFile(value: Array<File>) extends File {
  //
  static fun type(obj: File): this {
    obj match {
    | x @ ArrayFile _ -> x
    | _ -> cast_violation("ArrayFile", obj)
    }
  }

  static fun fromInts(value: Array<Int>): ArrayFile {
    ArrayFile(value.map(v -> IntFile(v)))
  }

  static fun converter<T>(conv: File ~> T): File ~> Array<T> {
    f ~> ArrayFile::map(f, conv)
  }

  static fun map<T>(f: File, conv: File -> T): Array<T> {
    ArrayFile::type(f).value.map(conv)
  }

  static fun conv<T>(f: File, conv: File -> File): ArrayFile {
    ArrayFile(ArrayFile::map(f, conv))
  }
}

class OptFile(value: ?File) extends File {
  fun each(f: File -> void): void {
    this.value.each(f);
  }

  fun map<T2>(f: File -> T2): ?T2 {
    this.value.map(f);
  }

  fun flatMap<T2>(f: File -> ?T2): ?T2 {
    this.value.flatMap(f);
  }

  static fun converter<T>(conv: File ~> T): File ~> ?T {
    f ~> OptFile::type(f).map(conv)
  }

  static fun type(obj: File): this {
    obj match {
    | x @ OptFile _ -> x
    | _ -> cast_violation("OptFile", obj)
    }
  }
}

extension class DirName {
  static fun make(parent: DirName, child: String): DirName {
    static::create(parent.toString() + child);
  }

  static fun check(child: String, optBasename: ?DirName = None()): DirName {
    optBasename match {
    | Some(basename) -> DirName::make(basename, child)
    | _ -> DirName::create(`/${child}`)
    };
  }
}

extension base class FixedData {
  fun getTick(): ?Tick;
}

extension base class DMap {
  fun getLastTick(): ?Tick
  | Nil() -> None()
  | Node{tick} -> Some(tick.max)
}

extension base class IFixedDir {
  fun getTick(): ?Tick {
    if (this.data.isEmpty()) {
      None()
    } else {
      middle = (this.data.size() - 1) / 2;
      tickRange = this.get(middle).tag;
      Some(tickRange.max)
    }
  }
}

extension class FixedDataMap {
  fun getTick(): ?Tick {
    optFTick = this.tombs.getTick();
    optDTick = this.data.getTick();
    (optFTick, optDTick) match {
    | (None(), None()) -> None()
    | (Some(t), None())
    | (None(), Some(t)) ->
      Some(t)
    | (Some(ft), Some(dt)) -> Some(max(ft, dt))
    }
  }
}

extension class DataMap {
  fun getTick(): ?Tick {
    optFTick = this.tombs.getLastTick();
    optDTick = this.data.getLastTick();
    (optFTick, optDTick) match {
    | (None(), None()) -> None()
    | (Some(t), None())
    | (None(), Some(t)) ->
      Some(t)
    | (Some(ft), Some(dt)) -> Some(max(ft, dt))
    }
  }
}

extension class EagerDir {
  fun getLastTick(): ?Tick {
    optFTick = this.fixedData.getTick();
    optDTick = this.data.getTick();
    (optFTick, optDTick) match {
    | (None(), None()) -> None()
    | (Some(t), None())
    | (None(), Some(t)) ->
      Some(t)
    | (Some(ft), Some(dt)) -> Some(max(ft, dt))
    }
  }
}

class UInt32File(value: UInt32) extends File

