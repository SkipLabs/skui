module Utils;

fun toString<T>(x: T): String {
  vector = mutable Vector<String>[];
  writer = mutable Debug.BufferedWriter(str -> vector.push(str));
  inspect(x).print(writer);
  writer.flush();
  vector.join("");
}

@cpp_extern("SKIP_Utils_sha256")
native fun sha256(toEncode: String): String;

module end;
