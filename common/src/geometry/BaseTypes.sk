module Geometry;

value class Range(min: Float, max: Float) uses Hashable, Equality {
  fun size(): Float {
    this.max - this.min
  }

  fun isIn(n: Float): Bool {
    n >= this.min && n < this.max;
  }
}

/**
 * A radius for either circular or elliptical shapes.
 */
value class Radius(
  /**
   * The radius value on the horizontal axis.
   */
  x: Float,
  /**
   * The radius value on the vertical  axis.
   */
  y: Float,
) uses Hashable, Equality {
  static fun circular(radius: Float): Radius {
    Radius(radius, radius);
  }

  static fun elliptical(x: Float, y: Float): Radius {
    Radius(x, y);
  }

  static fun zero(): Radius {
    static::circular(0.0);
  }

  fun isCircular(): Bool {
    this.x == this.y
  }

  /**
   * Binary addition operator.
   * Returns a radius whose x value is the sum of the x values of the two operands, and whose y value is the sum of the y values of the two operands.
   */
  fun +(other: Radius): Radius {
    Radius(this.x + other.x, this.y + other.y);
  }

  /**
   * Binary subtraction operator
   * Returns a radius whose x value is the left-hand-side operand's x minus the right-hand-side operand's x and whose y value is the left-hand-side operand's y minus the right-hand-side operand's y.
   */
  fun -(other: Radius): Radius {
    Radius(this.x - other.x, this.y - other.y);
  }

  /**
   * Returns a Radius whose dimensions are the dimensions of the left-hand-side operand (a Size) multiplied by the scalar right-hand-side operand (a Float).
   */
  fun *(operand: Float): Radius {
    Radius(this.x * operand, this.y * operand);
  }

  /**
   * Returns a radius whose coordinates are the coordinates of the left-hand-side operand (a radius) divided by the scalar right-hand-side operand (a Float).
   */
  fun /(operand: Float): Radius {
    Radius(this.x / operand, this.y / operand);
  }

  /**
   * Returns a radius whose coordinates are the coordinates of the left-hand-side operand (a radius) divided by the scalar right-hand-side operand (a Int).
   */
  fun iDiv(operand: Int): Radius {
    Radius(
      (this.x.toInt() / operand).toFloat(),
      (this.y.toInt() / operand).toFloat(),
    );
  }

  fun %(operand: Int): Radius {
    Radius(Math.modulo(this.x, operand), Math.modulo(this.y, operand));
  }

  fun inflate(delta: Float): Radius {
    Radius(this.x + delta, this.y + delta);
  }
}

/**
 * An set of radii for each corner of a rectangle.
 *
 *
 * The [RectRadius] class specifies offsets in terms of visual corners, e.g. [topLeft].
 */
base class RectRadius private () {
  /**
   * The top-left [Radius].
   */
  fun getTopLeft(): Radius;

  /**
   * The top-right [Radius].
   */
  fun getTopRight(): Radius;

  /**
   * The bottom-left [Radius].
   */
  fun getBottomLeft(): Radius;

  /**
   * The bottom-right [Radius].
   */
  fun getBottomRight(): Radius;
}
/**
 * A transform consisting of a translation, a rotation, and a uniform scale.
 */
value class RSTransform(
  /**
   * The cosine of the rotation multiplied by the scale factor.
   */
  scos: Float,
  /**
   * The sine of the rotation multiplied by that same scale factor.
   */
  ssin: Float,
  /**
   * The x coordinate of the translation, minus [scos] multiplied by the
   * x-coordinate of the rotation point, plus [ssin] multiplied by the
   * y-coordinate of the rotation point.
   */
  tx: Float,
  /**
   * The y coordinate of the translation, minus [ssin] multiplied by the
   * x-coordinate of the rotation point, minus [scos] multiplied by the
   * y-coordinate of the rotation point.
   */
  ty: Float,
) uses Hashable, Equality {}

/**
 * Position a child box within a container box, either above or below a target
 * point.
 *
 * The container's size is described by `size`.
 *
 * The target point is specified by `target`, as an offset from the top left of
 * the container.
 *
 * The child box's size is given by `childSize`.
 *
 * The return value is the suggested distance from the top left of the
 * container box to the top left of the child box.
 *
 * The suggested position will be above the target point if `preferBelow` is
 * false, and below the target point if it is true, unless it wouldn't fit on
 * the preferred side but would fit on the other side.
 *
 * The suggested position will place the nearest side of the child to the
 * target point `verticalOffset` from the target point (even if it cannot fit
 * given that constraint).
 *
 * The suggested position will be at least `margin` away from the edge of the
 * container. If possible, the child will be positioned so that its center is
 * aligned with the target point. If the child cannot fit horizontally within
 * the container given the margin, then the child will be centered in the
 * container.
 *
 * Used by [Tooltip] to position a tooltip relative to its parent.
 *
 */
fun positionDependentBox{
  size: Size,
  childSize: Size,
  target: Offset,
  preferBelow: Bool,
  verticalOffset: Float = 0.0,
  margin: Float = 10.0,
}: Offset {
  // VERTICAL DIRECTION
  fitsBelow =
    target.dy + verticalOffset + childSize.height <=
    size.height - margin;
  fitsAbove = target.dy - verticalOffset - childSize.height >= margin;
  tooltipBelow = if (preferBelow) {
    fitsBelow || !fitsAbove
  } else {
    !(fitsAbove || !fitsBelow)
  };
  y = if (tooltipBelow) {
    Math.min(target.dy + verticalOffset, size.height - margin);
  } else {
    Math.max(target.dy - verticalOffset - childSize.height, margin);
  };
  // HORIZONTAL DIRECTION
  x = if (size.width - margin * 2.0 < childSize.width) {
    (size.width - childSize.width) / 2.0;
  } else {
    normalizedTargetX = Math.clamp(target.dx, margin, size.width - margin);
    edge = margin + childSize.width / 2.0;
    if (normalizedTargetX < edge) {
      margin;
    } else if (Math.greater(normalizedTargetX, size.width - edge)) {
      size.width - margin - childSize.width;
    } else {
      normalizedTargetX - childSize.width / 2.0;
    }
  };
  Offset(x, y);
}

fun coefficient(src: Geometry.Offset, dst: Geometry.Offset): ?(Float, Float) {
  srcX = src.dx;
  dstX = dst.dx;
  if (Math.like(srcX, dstX)) {
    None()
  } else {
    srcY = src.dy;
    dstY = dst.dy;
    a = (dstY - srcY) / (dstX - srcX);
    b = dstY - (a * dstX);
    Some((a, b))
  }
}

fun parallelAt(coeff: (Float, Float), distance: Float): (Float, Float) {
  (a, b) = coeff;
  if (Math.like(a, 0.0)) {
    (a, b + distance)
  } else {
    diff = Math.sqrt(distance * distance * (a * a + 1.0));
    (
      a,
      if (distance > 0.0) {
        if (b + diff > b) b + diff else b - diff
      } else if (b + diff > b) {
        b - diff
      } else {
        b + diff
      },
    )
  }
}

fun intersection(
  coeff1: (Float, Float),
  coeff2: (Float, Float),
): Geometry.Offset {
  (a1, b1) = coeff1;
  (a2, b2) = coeff2;
  x = (b2 - b1) / (a1 - a2);
  y = a1 * x + b1;
  Geometry.Offset(x, y)
}

fun intersect(a: Offset, b: Offset, c: Offset, d: Offset): Bool {
  cross = (p1, p2, p3) ->
    (p2.dx - p1.dx) * (p3.dy - p1.dy) - (p2.dy - p1.dy) * (p3.dx - p1.dx);

  cross1 = cross(a, b, c);
  cross2 = cross(a, b, d);
  cross3 = cross(c, d, a);
  cross4 = cross(c, d, b);

  Math.lowerOrEquals(cross1 * cross2, 0.0) &&
    Math.lowerOrEquals(cross3 * cross4, 0.0)
}

module end;
