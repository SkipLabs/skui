module Ui;

base class Handle extends SKStore.File {
  fun draw(
    shift: Ui.Shift,
    window: Geometry.Rectangle,
    height: Int,
    ratio: Float,
    frame: Int,
  ): void;
}

class LambdaHandle(
  fn: (Ui.Shift, Geometry.Rectangle, Int, Float, Int) ~> void,
) extends Ui.Handle {
  fun draw(
    shift: Ui.Shift,
    window: Geometry.Rectangle,
    height: Int,
    ratio: Float,
    frame: Int,
  ): void {
    this.fn(shift, window, height, ratio, frame);
  }
}

class Handles(
  value: Array<Ui.Handle>,
  optViewport: ?Ui.Path = None(),
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Handles _ -> x
    | _ -> SKStore.cast_violation("Ui.Handles", obj)
    }
  }
}

base class Drawable extends SKStore.File uses HasClassName {
  fun toOrigin(): this;
  fun translate(offset: Geometry.Offset): this;
  fun size(): Geometry.Size;
}

class Drawables(
  value: Array<Drawable>,
  optViewport: ?Ui.Path = None(),
) extends SKStore.File {
  //

  fun toOrigin(): Drawables {
    !this.value = this.value.map(d -> d.toOrigin());
    this
  }

  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Drawables _ -> x
    | _ -> SKStore.cast_violation("Ui.Drawables", obj)
    }
  }
}

base class Supplier

base class RectangleDrawable(bounds: Geometry.Rect) extends Drawable {
  fun translate(offset: Geometry.Offset): this {
    !this.bounds = this.bounds.translate(offset.dx, offset.dy);
    this
  }

  fun toOrigin(): this {
    offset = this.bounds.topLeft();
    !this.bounds = this.bounds.translate(-offset.dx, -offset.dy);
    this
  }

  fun size(): Geometry.Size {
    this.bounds.size()
  }
}

class DummyDrawable() extends Drawable {
  fun translate(_offset: Geometry.Offset): this {
    dummy()
  }

  fun toOrigin(): this {
    dummy()
  }

  fun size(): Geometry.Size {
    dummy()
  }
}

module end;
