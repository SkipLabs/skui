    Geometry.Size(80.0, 60.0),
  );
  T.expectEq(
    rect.intersectSegment(
      Geometry.Offset(200.0, 200.0),
      Geometry.Offset(200.0, 400.0),
    ),
    true,
  );
}

@test
fun intersectSegment_touching_corner(): void {
  rect = Geometry.Rect::fromOffsetSize(
    Geometry.Offset(200.0, 300.0),
    Geometry.Size(80.0, 60.0),
  );
  T.expectEq(
    rect.intersectSegment(
      Geometry.Offset(160.0, 270.0),
      Geometry.Offset(160.0, 270.0),
    ),
    false,
  );
}

@test
fun intersectSegment_start_inside_end_outside(): void {
  rect = Geometry.Rect::fromOffsetSize(
    Geometry.Offset(200.0, 300.0),
    Geometry.Size(80.0, 60.0),
  );
  T.expectEq(
    rect.intersectSegment(
      Geometry.Offset(200.0, 300.0),
      Geometry.Offset(300.0, 400.0),
    ),
    true,
  );
}

@test
fun intersectSegment_parallel_above(): void {
  rect = Geometry.Rect::fromOffsetSize(
    Geometry.Offset(200.0, 300.0),
    Geometry.Size(80.0, 60.0),
  );
  T.expectEq(
    rect.intersectSegment(
      Geometry.Offset(100.0, 250.0),
      Geometry.Offset(300.0, 250.0),
    ),
