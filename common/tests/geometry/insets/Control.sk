@test
fun intersectSegment_on_left_side(): void {
  rect = Geometry.Rect::fromOffsetSize(
    Geometry.Offset(200.0, 300.0),
    Geometry.Size(80.0, 60.0),
  );
  T.expectEq(
    rect.intersectSegment(
      Geometry.Offset(200.0, 260.0),
      Geometry.Offset(200.0, 340.0),
    ),
    true,
  );
}

@test
fun intersectSegment_just_misses_corner(): void {
  rect = Geometry.Rect::fromOffsetSize(
    Geometry.Offset(200.0, 300.0),
    Geometry.Size(80.0, 60.0),
  );
  T.expectEq(
    rect.intersectSegment(
      Geometry.Offset(119.9, 239.9),
      Geometry.Offset(119.9, 239.9),
    ),
    false,
  );
}

module end;
