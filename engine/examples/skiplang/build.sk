module SkuiEngExamplesBuild;

/**
 * @brief Defines source directories based on the environment.
 *
 * @param env The build environment.
 * @return An array of source directory paths.
 */
@skui_build__source_dirs
fun source_dirs(env: SkuiBuild.Env): Array<String> {
  // If the environment is not targeting WebAssembly, include the native source directory
  if (!env.isWasm32()) Array["../../../views/native/src"] else Array[]
}

/**
 * @brief Defines include directories based on the environment.
 *
 * @param env The build environment.
 * @return An array of include directory paths.
 */
@skui_build__include_dirs
fun include_dirs(env: SkuiBuild.Env): Array<String> {
  // If the environment is not targeting WebAssembly, include native include directories
  if (!env.isWasm32()) {
    Array[
      "../../../opengl/native/src/includes", ///< OpenGL includes
      "../../../base/native/src/includes", ///< Base includes
      "../../../x11gl/native/src/includes", ///< X11GL includes
    ]
  } else {
    Array[]
  }
}

/**
 * @brief Defines extra source files based on the environment.
 *
 * @param env The build environment.
 * @return An array of extra source file paths.
 */
@skui_build__extra_sources
fun extra_sources(env: SkuiBuild.Env): Array<String> {
  // If the environment is not targeting WebAssembly, include additional X11GL source files
  if (!env.isWasm32()) {
    Array[
      "../../../x11gl/extra/Host.sk", ///< Host-specific code
      "../../../x11gl/extra/X11Events.sk", ///< X11 event handling
      "../../../x11gl/extra/X11Key.sk", ///< X11 key handling
    ]
  } else {
    Array[]
  }
}

module end;

/**
 * @brief Main function to build the project and handle errors.
 */
fun main(): void {
  SkuiBuild.build("skuieng_examples") match {
  | Failure(err) ->
    skipExit(err.code) ///< Exit with error code on failure
  | _ ->
    void ///< Do nothing on success
  }
}
