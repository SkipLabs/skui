module alias H = UiEngineHandle;

module SkuiEngex;

const kName: String = "skuiengex";
const rootPath: SKStore.DirName = SKStore.DirName::create("/ui/eng/ex/");

class Example(
  command: Cli.Command,
  getter: Cli.ParseResults ~> UiEngine.Renderable,
  deserializer: (
    String,
    Map<String, UiEngine.Serializable> ~> UiEngine.Serializable,
  ),
)

fun main(): void {
  available = mutable Vector[
    SKUIEngExButton.example(),
    SKUIEngExButton2.example(),
  ];
  perform(available);
}

fun perform(available: readonly Vector<Example>): void {
  command = SKUIMain.complete(
    Cli.Command(kName)
      .about("SKUI's Engine example viewer")
      .arg(
        Cli.Arg::bool("version")
          .short("V")
          .long("version")
          .about("Print version info and exit"),
      ),
  )
    .help()
    .subcommand(
      Cli.Command("help").extra().about("Displays help for a subcommand"),
    );
  available.each(v -> !command = command.subcommand(v.command));
  args = Cli.parseArgs(command);
  args.error match {
  | Some(err) ->
    error = args.subcommand match {
    | Some(subcmd) ->
      command._subcommands.find(c -> c.name == subcmd) match {
      | Some(cmd) -> Cli.usage(cmd, false, Some(command))
      | None() -> `Unknown subcommand ${subcmd}`
      }
    | None() -> Cli.usage(command, false)
    };
    SKUIMain.display(None(), Some(`error: ${err.getMessage()}\n${error}`))
  | _ ->
    if (args.getBool("version")) {
      git_commit = #env ("GIT_COMMIT_HASH");
      SKUIMain.display(Some(`${kName} (${git_commit})`))
    } else {
      args.maybeGetSubcommand() match {
      | Some(subcmd) ->
        if (subcmd == "help") {
          optSubcmd = args.extra.maybeGet(0);
          optSubcmd.flatMap(subcmd ->
            args.cmd._subcommands.filter(cmd -> cmd.name == subcmd).maybeGet(0)
          ) match {
          | Some(cmd) ->
            SKUIMain.display(Some(Cli.usage(cmd, true, Some(args.cmd))))
          | _ ->
            error = optSubcmd
              .map(cmd -> `error: Invalid subcommand ${cmd}`)
              .default("error: No subcommand specified");
            SKUIMain.display(Some(Cli.usage(args.cmd, true)), Some(error))
          };
        } else {
          available.filter(v -> v.command.name == subcmd).maybeGet(0) match {
          | Some(example) ->
            wId = 0;
            title = example.command._about match {
            | Some(t) -> t
            | _ -> command._about.fromSome()
            };
            _ = SKStore.gContextInit(SKStore.Context::create{});
            SKStore.Context::withGc(context ~> {
              initEngineWidget(context, args, wId, example);
              context.initPre();
            });
            SKUIMain.init(wId, title, args)
          | _ -> invariant_violation(`Unknown subcommand ${subcmd}`)
          }
        }
      | None() -> SKUIMain.display(Some(Cli.usage(args.cmd, true)))
      }
    }
  }
}

fun initEngineWidget(
  context: mutable SKStore.Context,
  args: Cli.ParseResults,
  wId: Int,
  example: Example,
): void {
  context.setGlobal(
    `UiEngine.Deserializer.${example.deserializer.i0}`,
    UiEngine.Deserializer(example.deserializer.i1),
  );
  context.setGlobal("Ui.Properties.Root", SKStore.DirNameFile(rootPath));
  support = SKUIGL.DrawableSupport(SKUI.pictureToTexturable);
  optPath: ?String = None();
  H.init(context, optPath);
  builder = (ctx, root) ~> {
    UiSerializableProp.Property::initValues(
      ctx,
      optPath,
      Array[(SKStore.StrID("root"), Some(example.getter(args)))],
    );
    property = UiSerializableProp.Property::forName(ctx, optPath, "root");
    hdl = UiEngine.widgetPipeline(ctx, property, root);
    (ctx, _root) ~> hdl.get(ctx).widget
  };
  SKUI.init(context, wId, builder, support);
}

module end;
