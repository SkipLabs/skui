module alias H = UiEngineHandle;

module SkuiEng;

const rootPath: SKStore.DirName = SKStore.DirName::create("/ui/js_engine/");

class Renderer(name: String, optDescription: ?String) uses Show {
  fun toString(): String {
    this.optDescription match {
    | Some(d) -> `${this.name}: ${d}`
    | _ -> this.name
    }
  }
}

@export("skuieng_examples")
fun examples(): void {
  // TODO: manage exceptions
  pos = SKStore.newObstack();
  renderers = jsExamples()
    .map(jsa ->
      jsa.value.map(jsv -> {
        jso = jsv.expectObject();
        Renderer(jso.getString("name"), jso.maybeGetString("description"));
      })
    )
    .default(Vector[]);
  perform(
    unsafe_chill_trust_me(renderers),
    Environ.args().drop(1).collect(Vector),
  );
  SKStore.destroyObstack(pos);
}

fun perform(examples: Vector<Renderer>, args: Vector<String>): void {
  if (examples.isEmpty()) {
    SKUIMain.display(None(), Some("No renderer available"), false)
  } else {
    available = Set::createFromItems(examples.map(e -> e.name));
    filtered = args.filter(a -> available.contains(a));
    if (filtered.isEmpty()) {
      dExamples = examples.map(e -> e.toString());
      SKUIMain.display(
        None(),
        Some(
          `Enable to display '${args.join(
            "/",
          )}', the available renderers are:\n${dExamples.join("\n")}`,
        ),
        false,
      )
    } else {
      examples
        .filter(e -> e.name == filtered[0])
        .each(example -> {
          wId = 0;
          title = example.optDescription.default("SKUI's JS Engine");
          _ = SKStore.gContextInit(SKStore.Context{});
          SKStore.Context::withoutGc(context ~> {
            initEngineWidget(context, wId, example.name);
            context.initPre()
          });
          SKUIJS.init(uint32(wId), title);
        })
    }
  }
}

@cpp_extern("SKUI_UiEngineJS_examples")
native fun jsExamples(): ?JSON.Array;

@cpp_extern("SKUI_UiEngineJS_getExample")
native fun getExample(name: String): ?JSON.Value;

fun initEngineWidget(
  context: mutable SKStore.Context,
  wId: Int,
  name: String,
): void {
  context.setGlobal("Ui.Properties.Root", SKStore.DirNameFile(rootPath));
  UiEnginePicture.init(context);
  support = SKUIGL.DrawableSupport(UiEnginePicture.pictureToTexturable);
  optPath: ?String = None();
  H.init(context, optPath);
  optRenderable = getExample(name);
  builder = (ctx, root) ~> {
    UiSerializableProp.Property::initValues(
      ctx,
      optPath,
      Array[(SKStore.StrID("root"), optRenderable.map(UiEngine.fromJSON))],
    );
    property = UiSerializableProp.Property::forName(ctx, optPath, "root");
    hdl = UiEngine.widgetPipeline(ctx, property, root);
    (ctx, _root) ~> hdl.get(ctx).widget
  };
  SKUI.init(context, wId, builder, support);
}

module end;
