module UiFlex;

extension base class Alignment {
  fun toCode(): Int
  | Start() -> 0
  | End() -> 1
  | Center() -> 2
  | SpaceBetween() -> 3
  | SpaceAround() -> 4
  | SpaceEvenly() -> 5

  static fun fromCode(code: Int): Alignment {
    code match {
    | 1 -> End()
    | 2 -> Center()
    | 3 -> SpaceBetween()
    | 4 -> SpaceAround()
    | 5 -> SpaceEvenly()
    | 0
    | _ ->
      Start()
    }
  }
}

extension base class CrossAlignment {
  fun toCode(): Int
  | CrossStart() -> 0
  | CrossEnd() -> 1
  | CrossCenter() -> 2
  | CrossStretch() -> 3

  static fun fromCode(code: Int): CrossAlignment {
    code match {
    | 1 -> CrossEnd()
    | 2 -> CrossCenter()
    | 3 -> CrossStretch()
    | 0
    | _ ->
      CrossStart()
    }
  }
}

module end;

module UiEngine;

class Wrap{
  optWidgets: ?Serializable = None(),
  optVertical: ?Serializable = None(),
  optRigthToLeft: ?Serializable = None(),
  optDownToUp: ?Serializable = None(),
  optMainAlignment: ?Serializable = None(),
  optCrossAlignment: ?Serializable = None(),
  optRunAlignment: ?Serializable = None(),
  optSpacing: ?Serializable = None(),
  optRunSpacing: ?Serializable = None(),
} extends Description {
  //
  fun collect(collector: Renderable -> void): void {
    this.optWidgets.each(s -> collect(s, collector))
  }

  fun build(
    context: mutable SKStore.Context,
    name: String,
    root: UiRoot.Storage,
    prebuilt: (mutable SKStore.Context, String) ~> ?Ui.Widget,
  ): Ui.Widget {
    path = Ui.Path::create(`#layout#${static::identifier}#${name}`);
    widgets = toWidgetsCollection(context, this.optWidgets, root, prebuilt);
    vertical = toBoolOptGetter(context, this.optVertical);
    rigthToLeft = toBoolOptGetter(context, this.optRigthToLeft);
    downToUp = toBoolOptGetter(context, this.optDownToUp);
    mainAlignment = toIntOptGetter(context, this.optMainAlignment);
    crossAlignment = toIntOptGetter(context, this.optCrossAlignment);
    runAlignment = toIntOptGetter(context, this.optRunAlignment);
    spacing = toIntOptGetter(context, this.optSpacing);
    runSpacing = toIntOptGetter(context, this.optRunSpacing);
    Ui.Wrap::createForController(
      context,
      path,
      UiWrap.LamController{
        direction => ctx ~>
          if (vertical(ctx, false).default(false)) Ui.VerticalAxis() else {
            Ui.HorizontalAxis()
          },
        horizontalDirection => ctx ~>
          if (rigthToLeft(ctx, false).default(false)) Ui.ToLeft() else {
            Ui.ToRight()
          },
        verticalDirection => ctx ~>
          if (downToUp(ctx, false).default(false)) Ui.Up() else {
            Ui.Down()
          },
        mainAxisAlignment => ctx ~>
          mainAlignment(ctx, false).default(0) match {
          | 1 -> UiWrap.End()
          | 2 -> UiWrap.Center()
          | 3 -> UiWrap.SpaceBetween()
          | 4 -> UiWrap.SpaceAround()
          | 5 -> UiWrap.SpaceEvenly()
          | 0
          | _ ->
            UiWrap.Start()
          },
        crossAxisAlignment => ctx ~>
          crossAlignment(ctx, false).default(0) match {
          | 1 -> UiWrap.End()
          | 2 -> UiWrap.Center()
          | 0
          | _ ->
            UiWrap.Start()
          },
        runAlignment => ctx ~>
          runAlignment(ctx, false).default(0) match {
          | 1 -> UiWrap.End()
          | 2 -> UiWrap.Center()
          | 3 -> UiWrap.SpaceBetween()
          | 4 -> UiWrap.SpaceAround()
          | 5 -> UiWrap.SpaceEvenly()
          | 0
          | _ ->
            UiWrap.Start()
          },
        spacing => ctx ~> spacing(ctx, false).default(0).toFloat(),
        runSpacing => ctx ~> runSpacing(ctx, false).default(0).toFloat(),
        widgets,
      },
      toOptConfGetter(context, this.optConfiguration),
    )
  }
}

const kFlexStart: Int = 0;
const kFlexEnd: Int = 1;
const kFlexCenter: Int = 2;
const kFlexSpaceBetween: Int = 3;
const kFlexSpaceAround: Int = 4;
const kFlexSpaceEvenly: Int = 5;

const kFlexStretch: Int = 3;

class Flex{
  optWidgets: ?Serializable = None(),
  optVertical: ?Serializable = None(),
  optRigthToLeft: ?Serializable = None(),
  optDownToUp: ?Serializable = None(),
  optMainAlignment: ?Serializable = None(),
  optCrossAlignment: ?Serializable = None(),
  optMaxSize: ?Serializable = None(),
} extends Description {
  //
  static fun vertical(
    widgets: Array<Widgetable>,
    mainAlignment: UiFlex.Alignment = UiFlex.Start(),
    crossAlignment: UiFlex.CrossAlignment = UiFlex.CrossStart(),
  ): Flex {
    Flex{
      optWidgets => Some(UiEngine.SArray(widgets)),
      optVertical => Some(UiEngine.SBool(true)),
      optMainAlignment => Some(SInt(mainAlignment.toCode())),
      optCrossAlignment => Some(SInt(crossAlignment.toCode())),
    }
  }

  fun collect(collector: Renderable -> void): void {
    this.optWidgets.each(s -> collect(s, collector))
  }

  fun build(
    context: mutable SKStore.Context,
    name: String,
    root: UiRoot.Storage,
    prebuilt: (mutable SKStore.Context, String) ~> ?Ui.Widget,
  ): Ui.Widget {
    path = Ui.Path::create(`#layout#${static::identifier}#${name}`);
    widgets = toWidgetsCollection(context, this.optWidgets, root, prebuilt);
    vertical = toBoolOptGetter(context, this.optVertical);
    rigthToLeft = toBoolOptGetter(context, this.optRigthToLeft);
    downToUp = toBoolOptGetter(context, this.optDownToUp);
    mainAlignment = toIntOptGetter(context, this.optMainAlignment);
    crossAlignment = toIntOptGetter(context, this.optCrossAlignment);
    Ui.Flex::createForController(
      context,
      path,
      UiFlex.LamController{
        direction => ctx ~>
          if (vertical(ctx, false).default(false)) Ui.VerticalAxis() else {
            Ui.HorizontalAxis()
          },
        horizontalDirection => ctx ~>
          if (rigthToLeft(ctx, false).default(false)) Ui.ToLeft() else {
            Ui.ToRight()
          },
        verticalDirection => ctx ~>
          if (downToUp(ctx, false).default(false)) Ui.Up() else {
            Ui.Down()
          },
        mainAxisAlignment => ctx ~>
          UiFlex.Alignment::fromCode(mainAlignment(ctx, false).default(0)),
        crossAxisAlignment => ctx ~>
          UiFlex.CrossAlignment::fromCode(
            crossAlignment(ctx, false).default(0),
          ),
        widgets,
      },
      toOptConfGetter(context, this.optConfiguration),
    )
  }
}

class AspectRatio{
  optWidget: ?Serializable = None(),
  optRatio: ?Serializable = None(),
  optCentered: ?Serializable = None(),
} extends Description {
  //
  fun collect(collector: Renderable -> void): void {
    this.optWidget.each(s -> collect(s, collector))
  }

  fun build(
    context: mutable SKStore.Context,
    name: String,
    root: UiRoot.Storage,
    prebuilt: (mutable SKStore.Context, String) ~> ?Ui.Widget,
  ): Ui.Widget {
    path = Ui.Path::create(`#in#${static::identifier}#${name}`);
    widget = toWidgetGetter(context, this.optWidget, root, prebuilt);
    centered = toBoolOptGetter(context, this.optCentered);
    ratio = toFloatOptGetter(context, this.optRatio);
    Ui.AspectRatio::create(
      context,
      path,
      UiAspectRatio.LamController{
        widget,
        centered => ctx ~> centered(ctx, false).default(true),
        aspectRatio => ctx ~> ratio(ctx, false).default(0.0),
      },
    );
  }
}

module end;
