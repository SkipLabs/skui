extension class AspectRatio {
  const identifier: String = "aspectratio";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "child" => SOption(this.optWidget),
        "ratio" => SOption(this.optRatio),
        "centered" => SOption(this.optCentered),
        "configuration" => SOption(this.optConfiguration),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): AspectRatio {
    AspectRatio{
      optWidget => maybeGet(value, "child"),
      optCentered => maybeGet(value, "centered"),
      optRatio => maybeGet(value, "ratio"),
      optConfiguration => maybeGet(value, "configuration"),
    }
  }
}

module end;
