module UiEngine;

extension class Wrap extends SObject {
  const identifier: String = "wrap";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "children" => SOption(this.optWidgets),
        "vertical" => SOption(this.optVertical),
        "cross-reversed" => SOption(this.optRigthToLeft),
        "main-reversed" => SOption(this.optDownToUp),
        "main-alignment" => SOption(this.optMainAlignment),
        "cross-alignment" => SOption(this.optCrossAlignment),
        "run-alignment" => SOption(this.optRunAlignment),
        "spacing" => SOption(this.optSpacing),
        "run-spacing" => SOption(this.optRunSpacing),
        "configuration" => SOption(this.optConfiguration),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    Wrap{
      optWidgets => maybeGet(value, "children"),
      optVertical => maybeGet(value, "vertical"),
      optRigthToLeft => maybeGet(value, "cross-reversed"),
      optDownToUp => maybeGet(value, "main-reversed"),
      optMainAlignment => maybeGet(value, "main-alignment"),
      optCrossAlignment => maybeGet(value, "cross-alignment"),
      optRunAlignment => maybeGet(value, "run-alignment"),
      optSpacing => maybeGet(value, "spacing"),
      optRunSpacing => maybeGet(value, "run-spacing"),
      optConfiguration => maybeGet(value, "configuration"),
    }
  }
}

