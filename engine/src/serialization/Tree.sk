module UiEngine;

extension class TreeItem extends SObject {
  //
  fun serialize(): (String, Map<String, Serializable>) {
    (identifier, fields) = this.item.serialize();
    !fields = Maps.add(fields, "id", SString(this.id));
    !fields = Maps.add(fields, "items", SOption(this.optItems));
    (identifier, fields)
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    TreeItem(
      getString(value, "id"),
      UiTree.Item::deserialize(value),
      maybeGet(value, "items"),
    );
  }

  static fun fromSerializable(s: Serializable): TreeItem {
    s match {
    | t @ TreeItem _ -> t
    | _ -> SKStore.cast_violation("UiEngine.TreeItem", s)
    }
  }
}

extension class Tree {
  //
  const identifier: String = "tree";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "items" => this.items,
        "allow-multiple-selection" => SOption(this.optAllowMultipleSelection),
        "badge-max-char" => SOption(this.optBadgeMaxChar),
        "menu-getter" => SOption(this.optMenuGetter),
        "selection-listener" => SOption(this.optSelectionListener),
        "expansion-listener" => SOption(this.optExpansionListener),
        "tree-performer" => SOption(this.optTreePerformer),
        "tree-dropper" => SOption(this.optTreeDropper),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    static{
      items => value.get("items"),
      optAllowMultipleSelection => maybeGet(value, "allow-multiple-selection"),
      optBadgeMaxChar => maybeGet(value, "badge-max-char"),
      optMenuGetter => maybeGet(value, "menu-getter"),
      optSelectionListener => maybeGet(value, "selection-listener"),
      optExpansionListener => maybeGet(value, "expansion-listener"),
      optTreePerformer => maybeGet(value, "tree-performer"),
      optTreeDropper => maybeGet(value, "tree-dropper"),
    }
  }
}

module end;
