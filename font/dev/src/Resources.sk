module SKIP_SKUIFontTestsRes;

@cpp_extern("SKIP_resources_tests_luximr_bin")
native fun luximrBin(): Array<UInt8>;

@cpp_extern("SKIP_resources_tests_luxirr_bin")
native fun luxirrBin(): Array<UInt8>;

@cpp_extern("SKIP_resources_tests_luxisr_bin")
native fun luxisrBin(): Array<UInt8>;

@cpp_extern("SKIP_resources_tests_xab_bin")
native fun xabBin(): Array<UInt8>;

@cpp_extern("SKIP_resources_tests_xdsff_bin")
native fun xdsffBin(): Array<UInt8>;

@cpp_extern("SKIP_resources_tests_xdvso_bin")
native fun xdvsoBin(): Array<UInt8>;

@cpp_extern("SKIP_resources_tests_xtnr_bin")
native fun xtnrBin(): Array<UInt8>;

// Liberation Sans Regular (SIL OFL 1.1), from the fonts-liberation package.
@cpp_extern("SKIP_resources_tests_liberation_bin")
native fun liberationBin(): Array<UInt8>;

// The same font converted to WOFF 1.0 (zlib-compressed tables).
@cpp_extern("SKIP_resources_tests_liberation_woff_bin")
native fun liberationWoffBin(): Array<UInt8>;

// A minimal TrueType font with COLR v0 and CPAL tables, built for the tests
// (see font/tests/Colr.sk).
@cpp_extern("SKIP_resources_tests_colr_bin")
native fun colrBin(): Array<UInt8>;

module end;
