module TrueType;

/**
 * A DEFLATE (RFC 1951) decompressor, with the zlib wrapper (RFC 1950), used
 * to read WOFF tables. It runs the same way natively and in wasm, without a
 * native zlib.
 *
 * Malformed input throws FontFormatError.
 */

const inflateLengthBase: Array<Int> = Array[
  3,
  4,
  5,
  6,
  7,
  8,
  9,
  10,
  11,
  13,
  15,
  17,
  19,
  23,
  27,
  31,
