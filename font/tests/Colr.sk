module SKUIFontTest;

// A minimal TrueType font with COLR v0 and CPAL tables (built for these
// tests), with units per em 1000:
// - glyph 1 'A' is a color glyph made of two layers, bottom to top:
//   glyph 2, a square (0, 0)-(600, 600), in palette entry 1, and glyph 3, a
//   square (200, 200)-(400, 400), in the text color (index 0xFFFF);
// - glyph 4 'B' is a plain glyph;
// - CPAL palette 0 has entry 0 = opaque blue and entry 1 = red with alpha
//   128 (color records are stored as BGRA).
fun testColorFont(): Array<UInt8> {
  SKIP_SKUIFontTestsRes.colrBin()
}

@test
fun colrLayers(): void {
  font = TrueType.parse(testColorFont());
  expectEqualsAt(
    font.getColorLayers(1),
    Some(
      Array[
        TrueType.ColorLayer(2, Some(Color::rgbaInt(255, 0, 0, 128))),
        TrueType.ColorLayer(3, None()),
      ],
    ),
    "A",
  );
  // A glyph without a COLR entry, and a font without COLR.
  expectEqualsAt(font.getColorLayers(4), None(), "B");
  expectEqualsAt(
    TrueType.parse(SKIP_SKUIFontTestsRes.luxisrBin()).getColorLayers(36),
    None(),
    "luxisr",
  );
}

@test
fun cpalColors(): void {
  font = TrueType.parse(testColorFont());
  expectEqualsAt(
    TrueType.cpalColor(font.cpal, 0),
    Some(Color::rgbaInt(0, 0, 255, 255)),
    "0",
  );
  // Foreground and out-of-range entries.
  expectEqualsAt(TrueType.cpalColor(font.cpal, 0xffff), None(), "fg");
  expectEqualsAt(TrueType.cpalColor(font.cpal, 2), None(), "2");
}

fun pathBounds(path: Shape.Path): (Float, Float, Float, Float) {
  points = path.elements
    .map(e ->
      e match {
      | Shape.MoveTo(p) -> Some(p)
      | Shape.LineTo(p) -> Some(p)
      | _ -> None()
      }
    )
    .filterNone();
  (
    points.map(p -> p.dx).reduce((a, b) -> Math.min(a, b), 1e9),
    points.map(p -> p.dy).reduce((a, b) -> Math.min(a, b), 1e9),
    points.map(p -> p.dx).reduce((a, b) -> Math.max(a, b), -1e9),
    points.map(p -> p.dy).reduce((a, b) -> Math.max(a, b), -1e9),
  )
}

@test
fun colrGlyph(): void {
  // 1000 units per em at 1000 / 72 * 96 * 72 / 96 = 1000 px: 1 unit = 1 px.
  face = TrueType.Face::make(
    TrueType.parse(testColorFont()),
    Font.Options{size => 1000.0 * 72.0 / 96.0, dpi => 96.0},
  );
  glyph = face.getGlyph('A').fromSome();
  expectEqualsAt(glyph.isColor(), true, "isColor");
  expectEqualsAt(glyph.colorLayers.size(), 2, "layers");
  bottom = glyph.colorLayers[0];
  top = glyph.colorLayers[1];
  expectEqualsAt(bottom.color, Some(Color::rgbaInt(255, 0, 0, 128)), "red");
  expectEqualsAt(top.color, None(), "foreground");
  // The layers are in the same coordinates as the glyph outline (Y down,
  // relative to the glyph image): the base outline and the bottom layer
  // cover the whole image, the top layer its middle third.
  expectEqualsAt(
    pathBounds(glyph.optPath.fromSome()),
    (0.0, 0.0, 600.0, 600.0),
    "outline",
  );
  expectEqualsAt(pathBounds(bottom.path), (0.0, 0.0, 600.0, 600.0), "bottom");
  expectEqualsAt(pathBounds(top.path), (200.0, 200.0, 400.0, 400.0), "top");
  // A plain glyph has no layers.
  expectEqualsAt(face.getGlyph('B').fromSome().isColor(), false, "B");
}

@test
fun colrMalformed(): void {
  // Truncated tables are ignored.
  expectEqualsAt(
    TrueType.colrLayers(uint8(Array[0, 0, 0, 1, 0, 0, 0, 14]), Array[], 1),
    None(),
    "short",
  );
  colr = uint8(
    Array[0, 0, 0, 1, 0, 0, 0, 14, 0, 0, 0, 20, 0, 9, 0, 1, 0, 0, 0, 2],
  );
  expectEqualsAt(TrueType.colrLayers(colr, Array[], 1), None(), "truncated");
}

module end;
