module SKUIFontTest;

// Kerning of a character pair in FUnits (scale = units per em).
fun unscaledKern(font: TrueType.Font, c1: Char, c2: Char): Int {
  font
    .getKern(
      font.fupe(),
      font.getIndex(c1).fromSome(),
      font.getIndex(c2).fromSome(),
    )
    .asInt()
}

@testr
fun gposKern(r: String ~> TrueType.Font): void {
  font = r("liberation");
  expectEqualsAt(font.gposKernSubtables.isEmpty(), false, "subtables");
  // Expected values computed independently from the font's GPOS table
  // (lookup 17, pair adjustment format 1).
  for ((pair, expected) in Array[
    (('A', 'V'), -152),
    (('T', 'o'), -227),
    (('L', 'T'), -152),
    (('Y', '.'), -264),
    (('A', 'W'), -76),
  ]) {
    (c1, c2) = pair;
    expectEqualsAt(unscaledKern(font, c1, c2), expected, `${c1}${c2}`)
  };
  // A pair without kerning.
  expectEqualsAt(unscaledKern(font, 'o', 'o'), 0, "oo");
}

@testr
fun gposKernScaled(r: String ~> TrueType.Font): void {
  font = r("liberation");
  // 12px: -152 * 12 * 64 / 2048 = -57 in 26.6.
  scale = Fixed.Int26_6::fromInt(12);
  kern = font.getKern(
    scale,
    font.getIndex('A').fromSome(),
    font.getIndex('V').fromSome(),
  );
  expectEqualsAt(kern.asInt(), -57, "AV@12");
}

@testr
fun kernTableFallback(r: String ~> TrueType.Font): void {
  // luxisr has no GPOS: the kern table is still used.
  font = r("luxisr");
  expectEqualsAt(font.gposKernSubtables.isEmpty(), true, "no GPOS");
  expectEqualsAt(unscaledKern(font, 'A', 'V'), -144, "AV");
}

@test
fun gposSharedLookup(): void {
  // Two 'kern' features (e.g. for two scripts) sharing lookup 0, a pair
  // adjustment format 1 subtable kerning glyphs (1, 2) by -50.
  data = uint8(
    Array[
      // GPOS header: version 1.0, script list, feature list, lookup list.
      0x00,
      0x01,
      0x00,
      0x00,
      0x00,
      0x00,
      0x00,
      0x0a,
      0x00,
      0x24,
      // 10: feature list, 2 features.
      0x00,
      0x02,
      0x6b,
      0x65,
      0x72,
      0x6e,
      0x00,
      0x0e, // "kern" -> 10 + 14 = 24
      0x6b,
      0x65,
      0x72,
      0x6e,
      0x00,
      0x0e,
      // 24: feature: params, 1 lookup, index 0.
      0x00,
      0x00,
      0x00,
      0x01,
      0x00,
      0x00,
      // 30: padding.
      0x00,
      0x00,
      0x00,
      0x00,
      0x00,
      0x00,
      // 36: lookup list, 1 lookup at 36 + 4 = 40.
      0x00,
      0x01,
      0x00,
      0x04,
      // 40: lookup type 2, flag 0, 1 subtable at 40 + 8 = 48.
      0x00,
      0x02,
      0x00,
      0x00,
      0x00,
      0x01,
      0x00,
      0x08,
      // 48: pair pos format 1, coverage at +12, valueFormat1 = XAdvance,
      // valueFormat2 = 0, 1 pair set at +18.
      0x00,
      0x01,
      0x00,
      0x0c,
      0x00,
      0x04,
      0x00,
      0x00,
      0x00,
      0x01,
      0x00,
      0x12,
      // 60: coverage format 1, 1 glyph: 1.
      0x00,
      0x01,
      0x00,
      0x01,
      0x00,
      0x01,
      // 66: pair set: 1 pair, second glyph 2, xAdvance -50.
      0x00,
      0x01,
      0x00,
      0x02,
      0xff,
      0xce,
    ],
  );
  subtables = TrueType.parseGposKern(data);
  expectEqualsAt(subtables.size(), 1, "subtables");
  expectEqualsAt(TrueType.gposKern(data, subtables, 1, 2), Some(-50), "1-2");
  expectEqualsAt(TrueType.gposKern(data, subtables, 1, 3), None(), "1-3");
}

@test
fun gposMalformed(): void {
  // Truncated or garbage GPOS data never throws: kerning is just ignored.
  for (data in Array[
    Array<UInt8>[],
    uint8(Array[0, 1, 0, 0, 0, 10, 0, 12, 0, 14]),
    uint8(Array[0, 1, 0, 0, 0, 10, 0, 12, 0, 14, 0, 1, 0x6b, 0x65]),
  ]) {
    subtables = TrueType.parseGposKern(data);
    expectEqualsAt(
      TrueType.gposKern(data, subtables, 1, 2),
      None(),
      data.size(),
    )
  }
}

module end;
