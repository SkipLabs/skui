fun variedPoints(font: TrueType.Font): Array<(Int, Int)> {
  g = mutable TrueType.GlyphBuf{};
  !g = g.load(font, font.fupe(), 1, Font.HintingNone());
  g.points.map(p -> (p.x.asInt(), p.y.asInt())).collect(Array)
}

fun variedAdvance(font: TrueType.Font): Int {
  g = mutable TrueType.GlyphBuf{};
  !g = g.load(font, font.fupe(), 1, Font.HintingNone());
  g.advanceWidth.asInt()
}

@test
fun variationAxes(): void {
  font = TrueType.parse(testVariableFont());
  expectEqualsAt(font.axes.size(), 1, "axes");
  axis = font.axes[0];
  expectEqualsAt(
    (axis.tag, axis.minValue, axis.defaultValue, axis.maxValue),
    ("wght", 100.0, 400.0, 900.0),
    "wght",
  );
  expectEqualsAt(font.isVaried(), false, "default");
  // Non-variable fonts ignore variations.
  !font = TrueType.parse(testCffFont());
  expectEqualsAt(
    font.withVariation(Map["wght" => 700.0]).isVaried(),
    false,
    "static",
  );
}

@test
fun variationNormalize(): void {
  font = TrueType.parse(testVariableFont());
  coords = (w: Float) -> font.withVariation(Map["wght" => w]).coords.values[0];
  // min, default, max.
  expectEqualsAt(coords(100.0), -0x4000, "100");
  expectEqualsAt(coords(400.0), 0, "400");
  expectEqualsAt(coords(900.0), 0x4000, "900");
  // Clamped to the axis range.
  expectEqualsAt(coords(2000.0), 0x4000, "2000");
  // 650 is halfway between 400 and 900: 0.5, mapped to 0.25 by avar.
  expectEqualsAt(coords(650.0), 0x1000, "650");
  // 250 is halfway between 100 and 400: -0.5; avar interpolates between
  // (-1, -1) and (0, 0), so it stays -0.5.
  expectEqualsAt(coords(250.0), -0x2000, "250");
}

@test
fun variationDefaultOutline(): void {
  font = TrueType.parse(testVariableFont());
  expectEqualsAt(
    variedPoints(font.withVariation(Map["wght" => 400.0])),
    Array[(100, 0), (500, 0), (500, 500), (100, 500)],
    "default",
  );
  expectEqualsAt(variedAdvance(font), 600, "advance");
}

@test
fun variationMax(): void {
  // wght 900: scalar 1 for the +1 tuple, 0 for the -1 tuple. Points 1 and 2
  // move by +100. Points 0 and 3 (x = 100) have no explicit delta: their
  // inferred delta comes from the contour's reference points 1 and 2 (both
  // at x = 500, delta +100); x = 100 is outside their range, so it takes
  // the delta of the nearest one, +100. The second phantom point moves by
  // +100, so the advance is 700.
  font = TrueType.parse(testVariableFont()).withVariation(Map["wght" => 900.0]);
  expectEqualsAt(
    variedPoints(font),
    Array[(200, 0), (600, 0), (600, 500), (200, 500)],
    "points",
  );
  expectEqualsAt(variedAdvance(font), 700, "advance");
  // HVAR: 600 + 100.
  expectEqualsAt(
    font.getHMetric(font.fupe(), uint16(1)).advanceWidth.asInt(),
    700,
    "HVAR",
  );
}

@test
fun variationMin(): void {
  // wght 100: only the -1 tuple applies, moving every point by -50,
  // including the first phantom point. Glyph outlines are positioned
  // relative to the first phantom point (the origin, at x = lsb before the
  // outline), so a uniform shift leaves the drawn outline unchanged.
  font = TrueType.parse(testVariableFont()).withVariation(Map["wght" => 100.0]);
  expectEqualsAt(
    variedPoints(font),
    Array[(100, 0), (500, 0), (500, 500), (100, 500)],
    "points",
  );
  // Both phantom points 0 and 1 move by -50: the advance is unchanged.
  expectEqualsAt(variedAdvance(font), 600, "advance");
  // HVAR: 600 - 50.
  expectEqualsAt(
    font.getHMetric(font.fupe(), uint16(1)).advanceWidth.asInt(),
    550,
    "HVAR",
  );
}

@test
fun variationIntermediate(): void {
  // wght 650 -> 0.25 after avar: the +1 tuple has scalar 0.25.
  font = TrueType.parse(testVariableFont()).withVariation(Map["wght" => 650.0]);
  expectEqualsAt(
    variedPoints(font),
    Array[(125, 0), (525, 0), (525, 500), (125, 500)],
    "points",
  );
  expectEqualsAt(
    font.getHMetric(font.fupe(), uint16(1)).advanceWidth.asInt(),
    625,
    "HVAR",
  );
}

@test
fun variationFace(): void {
  // Face::make applies Options.variation.
  font = TrueType.parse(testVariableFont());
  advance = (variation: Map<String, Float>) ->
    TrueType.Face::make(
      font,
      Font.Options{size => 1000.0 * 72.0 / 96.0, dpi => 96.0, variation},
    )
      .getGlyphAdvance('A')
      .fromSome()
      .asInt();
  expectEqualsAt(advance(Map[]), 600 * 64, "default");
  expectEqualsAt(advance(Map["wght" => 900.0]), 700 * 64, "900");
}

@test
fun variationRegionScalar(): void {
  coords = (v: Int) -> TrueType.VariationCoords(Array[v]);
  one = 0x4000;
  scalar = (v: Int, start: Int, peak: Int, end: Int) ->
    TrueType.regionScalar(coords(v), Array[peak], Array[start], Array[end]);
  // At the peak, outside, and halfway on each side of a 0..1 region.
  expectEqualsAt(scalar(one, 0, one, one), 1.0, "peak");
  expectEqualsAt(scalar(-one, 0, one, one), 0.0, "outside");
  expectEqualsAt(scalar(one / 2, 0, one, one), 0.5, "half");
  // Intermediate region 0.25..0.5..1.
  expectEqualsAt(scalar(one * 3 / 8, one / 4, one / 2, one), 0.5, "rise");
  expectEqualsAt(scalar(one * 3 / 4, one / 4, one / 2, one), 0.5, "fall");
  // A zero peak does not restrict the region.
  expectEqualsAt(scalar(one, 0, 0, 0), 1.0, "zero peak");
}

module end;
