module UiEvent;

class TouchPoint(
  point: Geometry.Offset,
  screen: Geometry.Offset,
) uses Hashable, Equality {}

class Touch(points: Array<TouchPoint>) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Touch _ -> x
    | _ -> invariant_violation("Must be UiEvent.Touch")
    }
  }
}

class Size(width: Int, height: Int) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Size _ -> x
    | _ -> SKStore.cast_violation("UiEvent.Size", obj)
    }
  }
}

module end;
