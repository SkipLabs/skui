module Font;

class FaceSources(value: Array<FaceSource>) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ FaceSources _ -> x
    | _ -> invariant_violation("Must be Font.FaceSources")
    }
  }

  static fun parse(json: String): FaceSources {
    static::fromJSON(JSON.decode(json))
  }

  static fun fromJSON(jsv: JSON.Value): FaceSources {
    jsonArray = jsv.expectArray();
    FaceSources(
      jsonArray.value.map(jsv -> FaceSource::fromJSON(jsv)).toArray(),
    );
  }
}

class TypeFace(typeface: TypefaceInfo, face: Face) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ TypeFace _ -> x
    | _ -> invariant_violation("Must be Font.TypeFace")
    }
  }

  fun height(): Float {
    this.face.height();
  }

  fun metrics(): (Float, Float) {
    (this.face.metrics.ascent.toFloat(), this.face.metrics.descent.toFloat())
  }
}

class FaceID(
  typeface: TypefaceInfo,
  size: Float,
  dpi: Float,
  hinting: Font.Hinting,
) extends SKStore.Key {
  static fun create(
    typeface: TypefaceInfo,
    size: Float,
    dpi: Float = 96.0,
    hinting: Font.Hinting = Font.HintingNone(),
  ): this {
    FaceID(typeface, size, dpi, hinting)
  }

  fun isNotBold(): Bool {
    !this.typeface.weight.isBold()
  }

  fun toString(): String {
    `${this.typeface}:${this.hinting}:${this.size}:${this.dpi}`;
  }
}

class GlyphID(fid: FaceID, char: Char, pxRange: Int = 8) extends SKStore.Key {
  //
  static fun create(fid: FaceID, char: Char, pxRange: Int = 8): this {
    GlyphID(fid, char, pxRange);
  }

  fun scale(s: Float): GlyphID {
    !this.fid.size = this.fid.size * s;
    this
  }

  fun compare(other: SKStore.Key): Order {
    other match {
    | oid @ GlyphID _ ->
      cOrder = this.char.compare(oid.char);
      if (cOrder == EQ()) {
        fidOrder = this.fid.compare(oid.fid);
        if (fidOrder == EQ()) {
          this.pxRange.compare(oid.pxRange);
        } else {
          fidOrder
        }
      } else {
        cOrder
      }
    | _ -> this.getClassName().compare(other.getClassName())
    }
  }

  fun toString(): String {
    `${this.fid}:${this.char}:${this.pxRange}`;
  }
}

class Msdf(
  image: Ui.Image,
  conv: Geometry.Rect ~> Geometry.Rect,
) extends SKStore.File {
  //
  static fun make(
    _char: Char,
    info: (Ui.Image, (Geometry.Rect, Float) ~> Geometry.Rect),
    scale: Float = 1.0,
  ): this {
    static(info.i0, r ~> info.i1(r, scale))
  }
}

class GlyphFile(optFace: ?Face, glyph: Glyph) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ GlyphFile _ -> x
    | _ -> invariant_violation("Must be Font.GlyphFile")
    }
  }

  fun getKern(optPrevious: ?Char = None()): Float {
    optPrevious
      .flatMap(previous ->
        this.optFace.map(face ->
          face.getKern(previous, this.glyph.index).toFloat()
        )
      )
      .default(0.0);
  }

  fun ascent(): Float {
    this.optFace.map(face -> face.metrics.ascent.toFloat()).default(0.0);
  }

  fun descent(): Float {
    this.optFace.map(face -> face.metrics.descent.toFloat()).default(0.0);
  }

  fun width(): Float {
    this.glyph.width();
  }

  fun height(): Float {
    this.optFace.map(face -> face.height()).default(this.glyph.height());
  }

  fun topLeft(): Geometry.Offset {
    this.glyph.topLeft()
  }

  fun offset(kern: Float): Geometry.Offset {
    this.topLeft().translate(kern, this.ascent())
  }

  fun size(): Geometry.Size {
    Geometry.Size(this.width(), this.height())
  }

  fun imageSize(): (Int, Int) {
    (this.glyph.imageWidth(), this.glyph.imageHeight())
  }

  static fun default(optFace: ?Font.Face, size: Float): GlyphFile {
    height = optFace
      .map(face -> face.metrics.height())
      .default(Ui.Pt(size).pixels());
    rect = Geometry.Rect::fromOffsetSize(
      Geometry.Offset::zero,
      Geometry.Size(height / 2.0, height),
    );
    GlyphFile(
      None(),
      Font.Glyph{
        index => -1,
        optPath => Some(Shape.Path::strokeRectangle(rect, 2.0)),
        bounds => Bounds{
          bounds => rect.toFixed(),
          advance => Fixed.Int26_6::fromFloat((height / 2.0) + 2.0),
        },
        dr => rect.toRectangle(),
      },
    );
  }
}

module end;
