module TrueType;

const msdfFontSize: Float = 45.0;

class File(font: Font) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ File _ -> x
    | _ -> invariant_violation("Must be TrueType.File")
    }
  }
}

base class State {
  fun getSources(context: mutable SKStore.Context): ?SKStore.Loadable;
  fun getFont(
    context: mutable SKStore.Context,
    name: String,
  ): ?SKStore.Loadable;
  fun setSources(
    context: mutable SKStore.Context,
    sources: Font.FaceSources,
  ): void;
  fun setFont(
    context: mutable SKStore.Context,
    name: String,
    ttf: TrueType.File,
  ): void;

  fun setSourcesError(context: mutable SKStore.Context, optError: ?Text): void;

  fun setFontError(
    context: mutable SKStore.Context,
    name: String,
    optError: ?Text,
  ): void;
}

fun createFontSupport(
  context: mutable SKStore.Context,
  predefined: SortedMap<Font.TypefaceInfo, String>,
  optBasename: ?SKStore.DirName = None(),
): Ui.FontSupport {
  filesProps = fontSupplier(context, predefined, optBasename);
  faceProps = faceSupplier(context, filesProps, optBasename);
  glyphProps = glyphSupplier(context, faceProps, optBasename);
  msdfProps = msdfSupplier(context, glyphProps, optBasename);
  Ui.FontSupport(faceProps, glyphProps, msdfProps);
}

fun fontSupplier(
  context: mutable SKStore.Context,
  predef: SortedMap<Font.TypefaceInfo, String>,
  optBasename: ?SKStore.DirName = None(),
): Ui.GetterOne<SKStore.Future<TrueType.File>, Font.TypefaceInfo> {
  typefacePath = SKStore.DirName::check("fonts/ttfs/typefaces/", optBasename);
  typefaceHdl = SKStore.LHandle::lazy(
    Font.TypefaceInfo::keyType,
    SKStore.Loadable::btype,
    context,
    typefacePath,
    (_ctx, _self, typeface) ~> {
      predef.maybeGet(typeface) match {
      | Some(base64) ->
        buffer = Base64.decode(base64);
        SKStore.Loaded(TrueType.File(TrueType.parse(buffer)))
      | None() ->
        SKStore.LoadFailed(Some(!"Only prefefined fonts are managed."))
      }
    },
    false,
  );
  (ctx, typeface) ~>
    SKStore.LoadableFuture(TrueType.File::type, typefaceHdl.get(ctx, typeface))
}

fun faceSupplier(
  context: mutable SKStore.Context,
  fontSources: Ui.GetterOne<SKStore.Future<TrueType.File>, Font.TypefaceInfo>,
  optBasename: ?SKStore.DirName = None(),
): Ui.GetterOne<SKStore.Future<Font.TypeFace>, Font.FaceID> {
  facePath = SKStore.DirName::check("fonts/ttfs/faces/", optBasename);
  faceHdl = SKStore.LHandle::lazy(
    Font.FaceID::keyType,
    SKStore.Loadable::btype,
    context,
    facePath,
    (context, _self, fid) ~> {
      futur = fontSources(context, fid.typeface);
      futur.load(context, (_, fontFile) ~> {
        Font.TypeFace(
          fid.typeface,
          TrueType.Face::make(
            fontFile.font,
            Font.Options{
              size => fid.size,
              dpi => fid.dpi,
              hinting => fid.hinting,
            },
          ),
        )
      })
    },
    false,
  );
  (ctx, faceId) ~>
    SKStore.LoadableFuture(Font.TypeFace::type, faceHdl.get(ctx, faceId))
}

fun glyphSupplier(
  context: mutable SKStore.Context,
  faceSources: Ui.GetterOne<SKStore.Future<Font.TypeFace>, Font.FaceID>,
  optBasename: ?SKStore.DirName = None(),
  optPath: ?String = None(),
): Ui.GetterOne<Font.GlyphFile, Font.GlyphID> {
  glyphPath = SKStore.DirName::check(
    optPath.default("fonts/ttfs/glyphs/"),
    optBasename,
  );
  glyphHdl = SKStore.LHandle::lazy(
    Font.GlyphID::keyType,
    Font.GlyphFile::type,
    context,
    glyphPath,
    (context, _self, gid) ~> {
      futur = faceSources(context, gid.fid);
      futur
        .maybeGet()
        .map(typeface -> {
          face = typeface.face;
          optGlyph = face.getGlyph(gid.char);
          if (optGlyph.isNone()) {
            !optGlyph = face.getGlyph('\ufffd');
          };
          if (optGlyph.isNone()) {
            !optGlyph = face.getGlyph('?');
          };
          optGlyph match {
          | Some(glyph) -> Font.GlyphFile(Some(face), glyph)
          | _ -> Font.GlyphFile::default(Some(face), gid.fid.size)
          };
        })
        .default(Font.GlyphFile::default(None(), gid.fid.size))
    },
    false,
  );
  (ctx, glyphId) ~> glyphHdl.get(ctx, glyphId);
}

fun msdfSupplier(
  context: mutable SKStore.Context,
  glyphProps: Ui.GetterOne<Font.GlyphFile, Font.GlyphID>,
  optBasename: ?SKStore.DirName = None(),
): Ui.GetterOne<?Font.Msdf, Font.GlyphID> {
  msdfPath = SKStore.DirName::check("fonts/ttfs/msdf/", optBasename);
  msdfHdl = SKStore.LHandle::optLazy(
    Font.GlyphID::keyType,
    Font.Msdf::type,
    context,
    msdfPath,
    (context, _self, gid) ~> {
      glyph = glyphProps(context, gid);
      glyph.glyph.optPath.map(path -> {
        info = MTSDF.toMSDF{
          shape => MTSDF.Shape::fromPath(path),
          pxRange => gid.pxRange,
        };
        Font.Msdf::make(gid.char, info)
      })
    },
    false,
  );
  (ctx, glyphId) ~> msdfHdl.maybeGetValue(ctx, glyphId);
}

module end;
