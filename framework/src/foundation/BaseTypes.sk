module JSON;
extension base class Value extends JSONValue {
  fun toJSON(): JSON.Value {
    this
  }
}

module end;

extension base class Text extends SKStore.File {
  static fun btype(obj: SKStore.File): Text {
    obj match {
    | x @ Text _ -> x
    | _ -> SKStore.cast_violation("Text", obj)
    }
  }
}
