module FWKPipeline;

const vpConstraintsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/vpconstraints/",
);
const viewportsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/viewports/",
);
const nodeSumsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/nodeSums/",
);
const nodeOffsetsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/nodeOffsets/",
);
const computedNodeInfosPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/nodeInfos/computed/",
);
const visibleNodeInfosPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/nodeInfos/visible/",
);
const vpWindowPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/viewportWindow/",
);
const nodeLayersPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/nodeLayers/",
);

const nodeRelativeLayersPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/nodeLayers/relative/",
);

const nodeDrawablesPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/nodeDrawables/",
);

class KOffsets(path: Ui.Path) extends SKStore.Key {
  fun toString(): String {
    this.path.toString()
  }
}

class RPath(path: Ui.Path) extends SKStore.Key {
  fun toString(): String {
    this.path.toString()
  }
}

const gNodeInfo: SKStore.EHandle<Ui.Path, NodeInfo> = SKStore.EHandle(
  Ui.Path::keyType,
  NodeInfo::type,
  computedNodeInfosPath.pre(),
);

fun hasNodeInfos(
  context: mutable SKStore.Context,
  isUntracked: Bool = false,
): Bool {
  FWKEnv.exists(context, computedNodeInfosPath.pre(), isUntracked)
}

fun maybeGetInfo(
  context: mutable SKStore.Context,
  path: Ui.Path,
  isUntracked: Bool = false,
): ?NodeInfo {
  if (hasNodeInfos(context, isUntracked)) {
    gNodeInfo.maybeGetValue(context, path, isUntracked)
  } else {
    None()
  }
}

class NodeSum(
  optWidget: ?Ui.Widget,
  summary: Ui.NodeSum,
  userData: Ui.UserDataGetter,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ NodeSum _ -> x
    | _ -> SKStore.cast_violation("FWKPipeline.NodeSum", obj)
    }
  }

  fun computeNodeInfo(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    relative: Geometry.Offset,
  ): NodeInfo {
    optUserData = this.userData(context);
    optDrawInfo = this.optWidget.flatMap(widget ->
      widget.computeDrawInfo(
        context,
        support,
        relative,
        this.summary,
        optUserData,
      )
    );
    NodeInfo(
      this.optWidget,
      Ui.NodeInfo(this.summary, optUserData, optDrawInfo),
    )
  }
}

class NodeInfo(optWidget: ?Ui.Widget, info: Ui.NodeInfo) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ NodeInfo _ -> x
    | _ -> SKStore.cast_violation("FWKPipeline.NodeInfo", obj)
    }
  }

  fun viewport(): Ui.Path {
    this.info.nodeSum.optViewport.fromSome()
  }

  fun computeLayer(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
  ): Array<Ui.Drawable> {
    this.optWidget.map(widget ->
      widget.computeLayer(context, support, absolute, layer, this.info)
    ).default(Array[]);
  }

  fun isRoot(): Bool {
    this.info.nodeSum.optParent.isNone()
  }
}

class Layer(nodeInfo: NodeInfo, offset: Geometry.Point) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Layer _ -> x
    | _ -> SKStore.cast_violation("FWKPipeline.Layer", obj)
    }
  }

  fun computeLayer(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
  ): Array<Ui.Drawable> {
    this.nodeInfo.computeLayer(context, support, absolute, layer)
  }
}

class RelativeLayer(
  layer: Layer,
  relative: Geometry.Offset,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ RelativeLayer _ -> x
    | _ -> invariant_violation("Must be FWKPipeline.RelativeLayer")
    }
  }
}

fun initPipeline(
  context: mutable SKStore.Context,
  widgetGetter: Ui.GetterOne<Ui.Widget, UiRoot.Storage>,
  windowHdl: SKStore.EHandle<SKStore.IID, UiEvent.Size>,
  root: UiRoot.Storage,
  support: Ui.DrawableSupport,
  wId: Int,
): void {
  // Collect mouse / keys states to manage Dropdrow / Tooltips
  mouseState = prepareMouse(context);
  keysState = prepareKeys(context);
  widgetHdl = root.manageWidgets(
    context,
    Ui.Path("root"),
    widgetGetter,
    ctx ~> mouseState.get(ctx),
    ctx ~> keysState.get(ctx),
  );
  FWKKeys.init(context);
  FWKMouse.init(context);
  FWKPointer.init(context);
  previousConstraintsHdl = context.makePreDir(
    Ui.Path::keyType,
    Ui.BoxConstraints::type,
    vpConstraintsPath,
    Array[],
  );
  constraintsHdl = windowHdl.map(
    Ui.Path::keyType,
    Ui.BoxConstraints::type,
    context,
    Ui.constraintsPath,
    (context, writer, _, it) ~> {
      size = it.first;
      file = widgetHdl.get(context);
      writer.set(
        file.widget.path,
        Ui.BoxConstraints::tight(size.width.toFloat(), size.height.toFloat()),
      )
    },
  );
  viewportsHdl = widgetHdl.hdl.map(
    Ui.MainKey::keyType,
    Ui.ViewportDef::type,
    context,
    Ui.viewportsPath,
    (context, writer, key, it) ~> {
      widget = it.first.widget;
      viewportDef = widget.getViewportDefinition(context) match {
      | Some(definition) ->
        if (definition.path != widget.path || definition.optWidget.isSome()) {
          Ui.ViewportDef(Some(widget), Array[definition], widget.path, None())
        } else if (definition.path == widget.path) {
          definition with {optWidget => Some(widget)}
        } else {
          definition;
        }
      | _ -> Ui.ViewportDef(Some(widget), Array[], widget.path, None())
      };
      writer.set(key, viewportDef);
    },
  );
  viewportLeafsHdl = viewportsHdl.map(
    Ui.Path::keyType,
    Ui.ViewportLeaf::type,
    context,
    viewportsPath,
    (_, writer, _, it) ~> fillViewportDefinitions(it.first, writer),
  );
  nodesHdl = viewportLeafsHdl.map(
    Ui.Path::keyType,
    Ui.Node::type,
    context,
    FWK.nodesPath,
    (context, writer, key, it) ~> {
      viewport = it.first;
      constraints = previousConstraintsHdl.maybeGet(context, key) match {
      | Some(constraints) -> constraints
      | _ ->
        constraintsHdl.maybeGet(context, key).default(Ui.BoxConstraints::new())
      };
      node = viewport.widget.getNode(context, constraints);
      writer.set(key, node);
    },
  );
  previousNodeInfosHdl = context.makePreDir(
    Ui.Path::keyType,
    NodeInfo::type,
    computedNodeInfosPath,
    Array[],
  );
  previousNodeOffsetsHdl = context.makePreDir(
    Ui.Path::keyType,
    Ui.NodeOffsets::type,
    nodeOffsetsPath,
    Array[],
  );
  FWKEnv.declare(context, computedNodeInfosPath.pre());
  previousVpInfosHdl = context.makePreDir(
    Ui.Path::keyType,
    Ui.NViewport::type,
    Ui.vpInfosPath,
    Array[],
  );
  nodeSumsHdl = nodesHdl.map(
    k ~> k,
    f ~> f,
    context,
    nodeSumsPath,
    (context, writer, path, it) ~> {
      node = it.first;
      oZero = Geometry.Offset::zero;
      fillNodeSums(
        context,
        path,
        oZero,
        oZero,
        node,
        writer,
        (ctx, path, iu) ~> previousNodeInfosHdl.getValue(ctx, path, iu).info,
        (ctx, path, iu) ~> previousNodeOffsetsHdl.maybeGetValue(ctx, path, iu),
        (ctx, path, iu) ~> previousVpInfosHdl.getValue(ctx, path, iu),
      )
    },
  );
  _ = nodeSumsHdl.map(
    Ui.Path::keyType,
    Ui.NodeOffsets::type,
    context,
    nodeOffsetsPath,
    (_, writer, key, it) ~>
      key match {
      | id @ KOffsets _ -> writer.set(id.path, Ui.NodeOffsets::type(it.first))
      | _ -> void
      }
    ,
  );
  // Update viewport constraints for next update
  _ = viewportLeafsHdl.map(
    Ui.Path::keyType,
    Ui.BoxConstraints::type,
    context,
    vpConstraintsPath,
    (context, writer, key, _) ~> {
      nodeSum = NodeSum::type(nodeSumsHdl.get(context, key));
      constraints = constraintsHdl.maybeGet(context, key) match {
      | Some(constraints) -> constraints
      | _ ->
        size = nodeSum.summary.size;
        Ui.BoxConstraints::tight(size.width, size.height)
      };
      writer.set(key, constraints)
    },
  );
  computedNodeInfosHdl = nodeSumsHdl.map(
    Ui.Path::keyType,
    NodeInfo::type,
    context,
    computedNodeInfosPath,
    (context, writer, key, it) ~>
      key match {
      | id @ Ui.Path _ ->
        ratio = context
          .getGlobal("FWK.Ratio")
          .map(FWK.Ratio::type)
          .map(r -> r.fn(context, wId))
          .default(1.0);
        relative = Geometry.Offset::type(nodeSumsHdl.get(context, RPath(id)));
        writer.set(
          id,
          NodeSum::type(it.first).computeNodeInfo(
            context,
            Ui.RatioDrawableSupport(support, ratio),
            relative,
          ),
        )
      | _ -> void
      }
    ,
  );
  vpInfosHdl = viewportLeafsHdl.map(
    Ui.Path::keyType,
    Ui.NViewport::type,
    context,
    Ui.vpInfosPath,
    (context, writer, key, it) ~> {
      offset = it.first.optReference
        .flatMap(iPath -> {
          nodeInfo = computedNodeInfosHdl.get(context, iPath);
          nodeInfo.info.optDrawInfo.map(di -> di.offset)
        })
        .default(Geometry.Point(0, 0));
      sizeInfo = computedNodeInfosHdl.get(context, key);
      sizeOffsets = Ui.NodeOffsets::type(
        nodeSumsHdl.get(context, KOffsets(key)),
      );
      writer.set(
        key,
        Ui.NViewport(
          offset,
          Geometry.Rect::fromOffsetSize(
            sizeOffsets.viewport,
            sizeInfo.info.size(),
          ).toRectangle(),
          sizeInfo.info.nodeSum.optViewport,
        ),
      )
    },
  );
  visibleNodeInfosHdl = computedNodeInfosHdl.map(
    Ui.Path::keyType,
    Layer::type,
    context,
    visibleNodeInfosPath,
    (context, writer, key, it) ~> {
      nodeInfo = it.first;
      nodeOffsets = Ui.NodeOffsets::type(
        nodeSumsHdl.get(context, KOffsets(key)),
      );
      viewport = vpInfosHdl.get(context, nodeInfo.viewport());
      nodeRect = Geometry.Rect::fromOffsetSize(
        nodeOffsets.viewport,
        nodeInfo.info.size(),
      )
        .toRectangle()
        .translate(viewport.offset);
      window = viewport.window.translate(viewport.window.min.neg());
      if (nodeRect.overlaps(window)) {
        writer.set(key, Layer(nodeInfo, viewport.offset))
      }
    },
  );
  nodeLayersHdl = visibleNodeInfosHdl.map(
    Ui.KLayer::keyType,
    Layer::type,
    context,
    nodeLayersPath,
    (_context, writer, path, it) ~> {
      layer = it.first;
      writer.set(Ui.KLayer(path, Ui.MainLayer()), layer);
      writer.set(Ui.KLayer(path, Ui.BackgroundLayer()), layer);
      writer.set(Ui.KLayer(path, Ui.ForegroundLayer()), layer);
    },
  );
  nodeDrawablesHdl = nodeLayersHdl.map(
    Ui.KLayer::keyType,
    Ui.Drawables::type,
    context,
    nodeDrawablesPath,
    (context, writer, kLayer, it) ~> {
      layer = it.first;
      nodeOffsets = Ui.NodeOffsets::type(
        nodeSumsHdl.get(context, KOffsets(kLayer.path)),
      );
      ratio = context
        .getGlobal("FWK.Ratio")
        .map(FWK.Ratio::type)
        .map(r -> r.fn(context, wId))
        .default(1.0);
      drawables = layer.computeLayer(
        context,
        Ui.RatioDrawableSupport(support, ratio),
        nodeOffsets.viewport,
        kLayer.layer,
      );
      if (!drawables.isEmpty()) {
        writer.set(
          kLayer,
          Ui.Drawables(drawables, Some(layer.nodeInfo.viewport())),
        )
      }
    },
  );
  support.init(context, nodeDrawablesHdl);
  initMouse(
    context,
    widgetHdl,
    (ctx, path, iu) ~> computedNodeInfosHdl.getValue(ctx, path, iu).info,
    (ctx, path, iu) ~> nodesHdl.getValue(ctx, path, iu),
    (ctx, path, iu) ~> vpInfosHdl.getValue(ctx, path, iu),
    root,
  );
  initKeys(
    context,
    widgetHdl,
    (ctx, path, iu) ~> computedNodeInfosHdl.getValue(ctx, path, iu).info,
    (ctx, path, iu) ~> nodesHdl.getValue(ctx, path, iu),
    root,
  )
}

fun fillViewportDefinitions(
  definition: Ui.ViewportDef,
  writer: mutable SKStore.TWriter<Ui.Path, Ui.ViewportLeaf>,
  optParent: ?Ui.Path = None(),
): void {
  definition.optWidget.each(widget ->
    writer.set(
      definition.path,
      Ui.ViewportLeaf(widget, optParent, definition.optReference),
    )
  );
  definition.children_.each(child ->
    fillViewportDefinitions(child, writer, Some(definition.path))
  )
}

fun fillNodeSums(
  context: mutable SKStore.Context,
  path: Ui.Path,
  viewport: Geometry.Offset,
  relative: Geometry.Offset,
  node: Ui.Node,
  writer: mutable SKStore.TWriter<SKStore.Key, SKStore.File>,
  nodeInfoGetter: Ui.NodeInfoGetter,
  nodeOffsetsGetter: Ui.GetterTwo<?Ui.NodeOffsets, Ui.Path, Bool>,
  viewportGetter: Ui.ViewportGetter,
  optParent: ?Ui.Path = None(),
): void {
  nodeSum = NodeSum(
    Some(node.widget),
    Ui.NodeSum::create(
      nodeInfoGetter,
      (ctx, iu) ~> nodeOffsetsGetter(ctx, node.widget.path, iu),
      viewportGetter,
      node.size,
      optParent,
      Some(path),
    ),
    node.userData,
  );
  nodeOffsets = Ui.NodeOffsets(viewport, relative);
  writer.set(KOffsets(node.widget.path), nodeOffsets);
  writer.set(RPath(node.widget.path), nodeOffsets.relativeViewport());
  writer.set(node.widget.path, nodeSum);
  node.subNodes.each(c -> {
    cOffset = c.getOffset();
    c match {
    | child @ Ui.CNode _ ->
      fillNodeSums(
        context,
        path,
        viewport.move(cOffset),
        cOffset,
        child.node,
        writer,
        nodeInfoGetter,
        nodeOffsetsGetter,
        viewportGetter,
        Some(node.widget.path),
      )
    | link @ Ui.CLink _ ->
      linksOffsets = Ui.NodeOffsets(viewport.move(cOffset), cOffset);
      writer.set(KOffsets(link.path), linksOffsets);
      writer.set(RPath(link.path), linksOffsets.relativeViewport());
      writer.set(
        link.path,
        NodeSum(
          None(),
          Ui.NodeSum::create(
            nodeInfoGetter,
            (ctx, iu) ~> nodeOffsetsGetter(ctx, link.path, iu),
            viewportGetter,
            link.getSize(),
            optParent,
            Some(path),
          ),
          Ui.constUserData(None()),
        ),
      )
    }
  });
}

module end;
