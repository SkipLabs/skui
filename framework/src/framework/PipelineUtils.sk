module FWK;

const nodesPath: SKStore.DirName = SKStore.DirName::create("/ui/fwk/nodes/");
const widgetsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/widgets/",
);

const focusablesPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/focusables/",
);
const previousFocusablesPath: SKStore.DirName = focusablesPath.pre();
const mouseStatePath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/state/mouse/",
);
const previousMouseStatePath: SKStore.DirName = mouseStatePath.pre();
const keysStatePath: SKStore.DirName = SKStore.DirName::create(
  "/ui/fwk/state/keys/",
);
const previousKeysStatePath: SKStore.DirName = keysStatePath.pre();

const fsHandle: SKStore.IHandle<Ui.MainKey, FocusState> = SKStore.IHandle(
  Ui.MainKey::keyType,
  FocusState::type,
  previousKeysStatePath,
);

const msHandle: SKStore.IHandle<Ui.MainKey, MouseState> = SKStore.IHandle(
  Ui.MainKey::keyType,
  MouseState::type,
  previousMouseStatePath,
);

fun getFocusState(
  context: mutable SKStore.Context,
  isUntracked: Bool = false,
): FocusState {
  fsHandle.getValue(context, Ui.MainKey(), isUntracked);
}

fun getMouseState(
  context: mutable SKStore.Context,
  isUntracked: Bool = false,
): MouseState {
  msHandle.getValue(context, Ui.MainKey(), isUntracked);
}

fun getBounds(
  context: mutable SKStore.Context,
  path: Ui.Path,
  isUntracked: Bool = false,
): ?Geometry.Rect {
  FWKPipeline.gNodeInfo.maybeGetValue(context, path, isUntracked).map(ni ->
    ni.info.getWindowBounds(context, isUntracked)
  )
}

@cpp_extern("SKIP_FWK_applyCursor")
native fun applyCursor(wId: UInt32, cursor: UInt32): void;

@cpp_extern("SKIP_FWK_update")
native fun update(wId: UInt32): void;

module end;
