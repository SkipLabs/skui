module SystemProperties;

const path: SKStore.DirName = SKStore.DirName::create("/ui/system/properties/");

const handle: SKStore.IHandle<SKStore.StrID, SKStore.File> = SKStore.IHandle(
  SKStore.StrID::keyType,
  f ~> f,
  path,
);
const requiredFocus: SKStore.StrID = SKStore.StrID("required-visible");
const horizontalDirection: SKStore.StrID = SKStore.StrID(
  "horizontal-direction",
);

class Todo(todo: (mutable SKStore.Context) ~> void) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Todo _ -> x
    | _ -> invariant_violation("Must be SystemProperties.Todo")
    }
  }
}

class QuitManager(manage: Ui.Getter<Bool>) extends SKStore.File
class ExitManager(exit: Ui.Getter<void>) extends SKStore.File

fun initOnExit(context: mutable SKStore.Context, exit: Ui.Getter<void>): void {
  context.setGlobal("FWK.Exit", ExitManager(exit))
}

fun exit(context: mutable SKStore.Context): void {
  context.getGlobal("FWK.Exit").map(ExitManager::type).each(m ->
    m.exit(context)
  )
}

fun quit(context: mutable SKStore.Context, wId: Int): Bool {
  //
  context
    .getGlobal(`FWK.Quit[${wId}]`)
    .map(QuitManager::type)
    .map(m -> m.manage(context))
    .default(true)
}

base class Command extends SKUIMessage.Command {
  fun toJSON(): JSON.Value
  | Repeat(toRepeat, optRepeatOn, count) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "toRepeat" => JSON.IntNumber(toRepeat),
        "repeatOn" => optRepeatOn.map(v -> v.toJSON()).default(JSON.Null()),
        "count" => JSON.IntNumber(count),
      ].filter((_k, v) -> !v.isNull()),
    )

  static fun fromJSON(jsv: JSON.Value): Command {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "SystemProperties.Repeat" ->
      Repeat(
        jso.getInt("toRepeat"),
        jso.maybeGet("repeatOn").map(FWK.Repeat::fromJSON),
        jso.getInt("count"),
      )
    | _ ->
      invariant_violation(
        `Invalid json object ${cl} for SystemProperties.Command`,
      )
    }
  }
}

class Repeat(
  toRepeat: Int,
  optRepeatOn: ?FWK.Repeat = None(),
  count: Int = 1,
) extends Command {
  fun next(): this {
    !this.count = this.count + 1;
    this;
  }
}

fun statusFromJSON(jsv: JSON.Value): Status {
  jso = jsv.expectObject();
  cl = jso.getString("__class");
  cl match {
  | "Running" -> Running(jso.maybeGetInt("progress"))
  | "KO" -> KO(jso.maybeGet("error").map(Text::fromJSON))
  | "OK" -> OK()
  | _ -> invariant_violation(`Invalid json object ${cl} for Status`)
  }
}

fun repeat(
  context: mutable SKStore.Context,
  todo: mutable SKStore.Context ~> void,
  optRepeatOn: ?FWK.Repeat = None(),
): void {
  todo(context);
  optRepeatOn.each(repeatOn -> {
    id = context.timeStamp().value;
    context.setGlobal(`SystemProperties.Repeat(${id})`, Todo(todo));
    emit(context, Repeat(id, Some(repeatOn), 1), false, Some(500))
  })
}

class Messages()
  extends SKUIMessage.Support
  uses SKUIMessage.WithUpdate<Command> {
  fun init(_context: mutable SKStore.Context): void {
    void
  }

  protected fun convert(message: JSON.Value): Command {
    Command::fromJSON(message)
  }

  protected fun convertCmd(command: SKUIMessage.Command): Command {
    command as Command _;
  }

  protected fun execute(
    context: mutable SKStore.Context,
    name: String,
    scope: String,
    command: Command,
  ): void {
    command match {
    | repeatable @ Repeat _ ->
      SKUIMessage.repeat(
        context,
        name,
        scope,
        repeatable.next(),
        ctx ~> {
          ctx
            .getGlobal(`SystemProperties.Repeat(${repeatable.toRepeat})`)
            .map(Todo::type)
            .each(todo -> todo.todo(ctx))
        },
        repeatable.optRepeatOn,
        false,
        50,
        ctx ~>
          ctx.removeGlobal(`SystemProperties.Repeat(${repeatable.toRepeat})`)
        ,
      )
    }
  }
}

fun init(context: mutable SKStore.Context): void {
  _ = context.makeNotTyped(path, Array[]);
  context.registerMessageSupport("system", "properties", Messages());
}

fun emit(
  context: mutable SKStore.Context,
  command: Command,
  asyncMode: Bool = false,
  optDelay: ?Int = None(),
): void {
  SKUIMessage.emit(
    context,
    "system",
    "properties",
    command,
    asyncMode,
    optDelay,
  );
}

fun message(command: Command): SKUIMessage.Message {
  SKUIMessage.Message("system", "properties", command);
}

class TPath(path: Ui.Path, tick: SKStore.Tick) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ TPath _ -> x
    | _ -> SKStore.cast_violation("SystemProperties.TPath", obj)
    }
  }
}

fun getRequiredFocus(context: mutable SKStore.Context): ?Ui.Path {
  handle.maybeGetValue(context, requiredFocus).map(TPath::type).flatMap(td ->
    if (td.tick == context.tick) {
      Some(td.path)
    } else {
      None()
    }
  )
}

fun getHorizontalDirection(
  context: mutable SKStore.Context,
): Ui.HorizontalDirection {
  handle
    .maybeGetValue(context, horizontalDirection)
    .map(Ui.HorizontalDirection::btype)
    .default(Ui.ToRight());
}

fun setRequireFocus(context: mutable SKStore.Context, path: Ui.Path): void {
  handle.write(context, requiredFocus, TPath(path, context.tick));
}

fun setHorizontalDirection(
  context: mutable SKStore.Context,
  direction: Ui.HorizontalDirection,
): void {
  handle.write(context, horizontalDirection, direction)
}

fun setQuitManager(
  context: mutable SKStore.Context,
  manage: Ui.Getter<Bool>,
  wId: Int,
): void {
  handle.write(
    context,
    SKStore.StrID(`quit-manager${wId}`),
    QuitManager(manage),
  )
}

module end;
