module Geometry;

extension class Size extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Size _ -> x
    | _ -> SKStore.cast_violation("Geometry.Size", obj)
    }
  }
}

extension class ISize extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ ISize _ -> x
    | _ -> SKStore.cast_violation("Geometry.ISize", obj)
    }
  }
}

module end;
