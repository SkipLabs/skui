fun fill(
  p: SortedMap<String, UiIcon.Predefined>,
): SortedMap<String, UiIcon.Predefined> {
  p.add(
    "material",
    UiIcon.Predefined(
      UiIcon.LamCodes(icon ~> iconCodePoint(icon).map(Char::fromCode)),
      regularB64(),
    ),
  );
}

module end;
