fun iconCodePoint(icon: UiIcon.Icon): ?Int {
  name = icon match {
  | UiIcon.ArrowLeft() -> "arrow-left"
  | UiIcon.ArrowUp() -> "arrow-up"
  | UiIcon.ArrowRight() -> "arrow-right"
  | UiIcon.ArrowDown() -> "arrow-down"
  | UiIcon.ArrowTopLeft() -> "arrow-top-left"
  | UiIcon.ArrowTopRight() -> "arrow-top-right"
  | UiIcon.ArrowCircleLeft() -> "arrow-circle-left"
  | UiIcon.ArrowCircleUp() -> "arrow-circle-up"
  | UiIcon.ArrowCircleRight() -> "arrow-circle-right"
  | UiIcon.ArrowCircleDown() -> "arrow-circle-down"
  | UiIcon.ArrowsHorizontal() -> "arrows-horizontal"
  | UiIcon.ArrowsVertical() -> "arrows-vertical"
  | UiIcon.ArrowsCorner() -> "arrows-corner"
  | UiIcon.AngleLeft() -> "angle-left"
  | UiIcon.AngleUp() -> "angle-up"
  | UiIcon.AngleRight() -> "angle-right"
  | UiIcon.AngleDown() -> "angle-down"
  | UiIcon.DoubleAngleLeft() -> "double-angle-left"
  | UiIcon.DoubleAngleUp() -> "double-angle-up"
  | UiIcon.DoubleAngleRight() -> "double-angle-right"
  | UiIcon.DoubleAngleDown() -> "double-angle-down"
  | UiIcon.Move() -> "move"
  | UiIcon.Fullscreen() -> "fullscreen"
  | UiIcon.Redo() -> "back-right"
  | UiIcon.ExchangeVertical() -> "exchange-vertical"
  | UiIcon.Save() -> "save"
  | UiIcon.Direction() -> "direction"
  | UiIcon.MultipleDirection() -> "direction-alt"
  | UiIcon.User() -> "user"
  | UiIcon.Link() -> "link"
  | UiIcon.Unlink() -> "unlink"
  | UiIcon.Trash() -> "trash"
  | UiIcon.Target() -> "target"
  | UiIcon.Tag() -> "tag"
  | UiIcon.Desktop() -> "desktop"
  | UiIcon.Tablet() -> "tablet"
  | UiIcon.Mobile() -> "mobile"
  | UiIcon.Email() -> "email"
  | UiIcon.Star() -> "star"
  | UiIcon.Signal() -> "signal"
  | UiIcon.ShoppingCart() -> "shopping-cart"
  | UiIcon.Settings() -> "settings"
  | UiIcon.Search() -> "search"
  | UiIcon.ZoomIn() -> "zoom-in"
  | UiIcon.ZoomOut() -> "zoom-out"
  | UiIcon.Cut() -> "cut"
  | UiIcon.Bookmark() -> "bookmark"
  | UiIcon.Bookmarked() -> "bookmarked"
  | UiIcon.Reload() -> "reload"
  | UiIcon.Plus() -> "plus"
  | UiIcon.Minus() -> "minus"
  | UiIcon.Close() -> "close"
  | UiIcon.Pin() -> "pin"
  | UiIcon.Pencil() -> "pencil"
  | UiIcon.Forbiden() -> "forbiden"
  | UiIcon.Lock() -> "lock"
  | UiIcon.Unlock() -> "unlock"
  | UiIcon.LocationArrow() -> "location-arrow"
  | UiIcon.Layout() -> "layout"
  | UiIcon.Layers() -> "layers"
  | UiIcon.Key() -> "key"
  | UiIcon.Image() -> "image"
  | UiIcon.Heart() -> "heart"
  | UiIcon.HeartBroken() -> "heart-broken"
  | UiIcon.HandStop() -> "hand-stop"
  | UiIcon.HandOpen() -> "hand-open"
  | UiIcon.HandDrag() -> "hand-drag"
  | UiIcon.Flag() -> "flag"
  | UiIcon.Eye() -> "eye"
  | UiIcon.Import() -> "import"
  | UiIcon.Export() -> "export"
  | UiIcon.Comment() -> "comment"
  | UiIcon.Clip() -> "clip"
  | UiIcon.Check() -> "check"
  | UiIcon.CheckBox() -> "checkbox"
  | UiIcon.Briefcase() -> "work"
  | UiIcon.Bolt() -> "bolt"

  | UiIcon.Dashboard() -> "dashboard"
  | UiIcon.World() -> "world"
  | UiIcon.Timer() -> "timer"
  | UiIcon.Time() -> "time"
  | UiIcon.ThumbUp() -> "thumb-up"
  | UiIcon.ThumbDown() -> "thumb-down"
  | UiIcon.PowerOff() -> "power-off"
  | UiIcon.Map() -> "map"
  | UiIcon.Menu() -> "menu"
  | UiIcon.Filter() -> "filter"
  | UiIcon.Clipboard() -> "clipboard"
  | UiIcon.Copy() -> "copy"
  | UiIcon.Info() -> "info"
  | UiIcon.Home() -> "home"
  | UiIcon.Help() -> "help"
  | UiIcon.Alert() -> "alert"
  | UiIcon.Anchor() -> "anchor"
  | UiIcon.Archive() -> "archive"
  | UiIcon.Cloud() -> "cloud"
  | UiIcon.CloudUp() -> "cloud-up"
  | UiIcon.CloudDown() -> "cloud-down"
  | UiIcon.File() -> "file"
  | UiIcon.Files() -> "files"
  | UiIcon.Folder() -> "folder"
  | UiIcon.Zip() -> "zip"
  | UiIcon.More() -> "more"
  | UiIcon.Occulted() -> "more-alt"
  | UiIcon.Share() -> "share"
  | UiIcon.Calendar() -> "calendar"
  | UiIcon.Paste() -> "paste"
  | UiIcon.Volume() -> "volume"
  | UiIcon.Custom(name) -> name
  };
  codePoints.maybeGet(name);
}

module end;
