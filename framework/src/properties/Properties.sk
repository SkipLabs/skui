module UiBoolProp;

class Timed extends Ui.TimedFile<Bool> {
  static fun type(file: SKStore.File): Timed {
    file match {
    | x @ Timed _ -> x
    | _ -> SKStore.cast_violation("UiBoolProp.Timed", file)
    }
  }
}

class Property extends
  Ui.BoolProperty,
  Ui.PropertyFile<Bool, Timed, SKStore.BoolFile>,
{
  //
  fun get from Ui.PropertyFile;
  fun getTimed from Ui.PropertyFile;

  protected static fun timed(
    optV: ?Bool,
    tick: SKStore.Tick,
    source: Int,
  ): Timed {
    Timed(optV, tick, source)
  }

  protected static fun timedFromFile(file: SKStore.File): Timed {
    file match {
    | x @ Timed _ -> x
    | _ -> SKStore.cast_violation("UiBoolProp.Timed", file)
    }
  }

  protected static fun valueFromFile(file: SKStore.File): Bool {
    SKStore.BoolFile::type(file).value
  }

  protected static fun fileValueFromFile(file: SKStore.File): SKStore.BoolFile {
    SKStore.BoolFile::type(file)
  }

  protected static fun valueToFile(value: Bool): SKStore.BoolFile {
    SKStore.BoolFile(value)
  }

  protected static fun getDefaultValue(): Bool {
    false
  }

  static fun toIHandle(
    hdl: SKStore.EHandle<SKStore.StrID, Timed>,
  ): SKStore.IHandle<SKStore.StrID, Timed> {
    SKStore.toIHandle(hdl)
  }

  fun toggle(context: mutable SKStore.Context, source: Int): void {
    this.set(context, Some(!this.get(context, true)), source)
  }
}

class Const extends Ui.BoolProperty, Ui.PropertyConst<Bool, Timed> {
  //
  fun get from Ui.PropertyConst;
  fun getTimed from Ui.PropertyConst;

  protected static fun timed(optV: ?Bool, tick: SKStore.Tick): Timed {
    Timed(optV, tick, 0)
  }

  protected static fun getDefaultValue(): Bool {
    false
  }

  fun toggle(_context: mutable SKStore.Context, _source: Int): void {
    void
  }
}

module end;

