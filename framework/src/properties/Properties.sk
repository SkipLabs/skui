class Const extends Ui.RangeProperty, Ui.PropertyConst<Range, Timed> {
  //
  fun get from Ui.PropertyConst;
  fun getTimed from Ui.PropertyConst;

  protected static fun timed(optV: ?Range, tick: SKStore.Tick): Timed {
    Timed(optV, tick, 0)
  }

  protected static fun getDefaultValue(): Range {
    Range(0, 0)
  }
}

module end;

module UiStatusProp;

class Timed extends Ui.TimedFile<Status> {
  static fun type(file: SKStore.File): Timed {
    file match {
    | x @ Timed _ -> x
    | _ -> SKStore.cast_violation("UiStatusProp.Timed", file)
    }
  }
}

class Property extends Ui.StatusProperty, Ui.FPropertyFile<Status, Timed> {
  //
  fun get from Ui.FPropertyFile;
  fun getTimed from Ui.FPropertyFile;

  protected static fun timed(
    optV: ?Status,
    tick: SKStore.Tick,
    source: Int,
  ): Timed {
    Timed(optV, tick, source)
  }

  protected static fun timedFromFile(file: SKStore.File): Timed {
    file match {
    | x @ Timed _ -> x
    | _ -> SKStore.cast_violation("UiStatusProp.Timed", file)
    }
  }

  protected static fun valueFromFile(file: SKStore.File): Status {
    file match {
    | x @ Status _ -> x
    | _ -> SKStore.cast_violation("SKStore.StatusFile", file)
    }
  }

  protected static fun getDefaultValue(): Status {
    OK()
  }

  static fun toIHandle(
    hdl: SKStore.EHandle<SKStore.StrID, Timed>,
  ): SKStore.IHandle<SKStore.StrID, Timed> {
    SKStore.toIHandle(hdl)
  }
}

class Const extends Ui.StatusProperty, Ui.PropertyConst<Status, Timed> {
  //
  fun get from Ui.PropertyConst;
  fun getTimed from Ui.PropertyConst;

  protected static fun timed(optV: ?Status, tick: SKStore.Tick): Timed {
    Timed(optV, tick, 0)
  }

  protected static fun getDefaultValue(): Status {
    OK()
  }
}

module end;
