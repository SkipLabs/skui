module Ui;

class Boundary private (
  value: Float,
  included: Bool = true,
) uses Hashable, Orderable {
  static fun zero(): Boundary {
    Boundary(0.0, true);
  }

  static fun inf(negative: Bool = false): Boundary {
    if (negative) {
      Boundary(-Float::inf, true);
    } else {
      Boundary(Float::inf, true);
    }
  }

  static fun create(value: Float, included: Bool = true): Boundary {
    invariant(!value.isNaN(), `Nan boundary`);
    Boundary(value, included);
  }

  fun isInf(): Bool {
    this.value == Float::inf || this.value == -Float::inf
  }

  fun isLeft(value: Float): Bool {
    if (this.included) {
      value <= this.value
    } else {
      value < this.value
    }
  }

  fun isRight(value: Float): Bool {
    if (this.included) {
      value >= this.value
    } else {
      value > this.value
    }
  }

  fun withValue(value: Float): Boundary {
    static::create(value, this.included)
  }

  // The only non-finite numbers are NaN, positive infinitity and negative infinity.
  fun isFinite(): Bool {
    !this.value.isNaN() &&
      Float::inf != this.value &&
      -Float::inf != this.value;
  }
}

class Interval private (min: Boundary, max: Boundary) uses Hashable, Orderable {
  static fun new(min: Boundary, max: Boundary): Interval {
    //invariant(min.value <= max.value, `max must be greater than min`);
    Interval(min, max);
  }

  static fun make{min: ?Float = None(), max: ?Float = None()}: Interval {
    (min, max) match {
    | (Some(mi), Some(ma)) ->
      Interval(Boundary::create(mi), Boundary::create(ma))
    | (Some(mi), None()) -> Interval(Boundary::create(mi), Boundary::inf())
    | (None(), Some(ma)) ->
      Interval(Boundary::create(0.0), Boundary::create(ma))
    | _ -> static::zeroInfinite()
    };
  }

  static fun included(min: Float, max: Float): Interval {
    invariant(min <= max, "max must be greater than min");
    Interval(Boundary::create(min), Boundary::create(max));
  }

  static fun forMin(min: Float, included: Bool = true): Interval {
    Interval(Boundary::create(min, included), Boundary::inf());
  }

  static fun forMax(max: Float, included: Bool = true): Interval {
    Interval(Boundary::create(0.0, true), Boundary::create(max, included));
  }

  static fun zeroInfinite(): Interval {
    static::new(Boundary::zero(), Boundary::inf());
  }

  fun freeMax(): Interval {
    static::new(this.min, Boundary::inf());
  }

  fun isSatisfiedBy(value: Float): Bool {
    this.min.isRight(value) && this.max.isLeft(value)
  }

  fun isTight(): Bool {
    this.min.value >= this.max.value
  }

  fun isBounded(): Bool {
    this.max.value < Float::inf
  }

  fun isInfinite(): Bool {
    this.max.value >= Float::inf
  }

  fun withMax(value: Float): Interval {
    !this.min = this.min.withValue(Math.min(this.min.value, value));
    !this.max = this.max.withValue(Math.min(this.max.value, value));
    this;
  }

  fun withMin(value: Float): Interval {
    !this.min = this.min.withValue(Math.max(this.min.value, value));
    !this.max = this.max.withValue(Math.max(this.max.value, value));
    this;
  }

  /**
   * Scales each interval parameter by the given factor.
   */
  fun *(factor: Float): Interval {
    Interval(
      Boundary::create(this.min.value * factor, this.min.included),
      Boundary::create(this.max.value * factor, this.max.included),
    );
  }
  /**
   * Scales each interval parameter by the inverse of the given factor.
   */
  fun /(factor: Float): Interval {
    Interval(
      Boundary::create(this.min.value / factor, this.min.included),
      Boundary::create(this.max.value / factor, this.max.included),
    );
  }

  fun iDiv(factor: Int): Interval {
    minValue = this.min.value.toInt() / factor;
    maxValue = this.max.value.toInt() / factor;
    Interval(
      Boundary::create(minValue.toFloat(), this.min.included),
      Boundary::create(maxValue.toFloat(), this.max.included),
    );
  }

  fun %(factor: Int): Interval {
    Interval(
      Boundary::create(Math.modulo(this.min.value, factor), this.min.included),
      Boundary::create(Math.modulo(this.max.value, factor), this.max.included),
    );
  }
  /**
   * Returns whether the object's interval are normalized.
   * Interval are normalized if the minimums are less than or
   * equal to the corresponding maximums.
   */
  fun isNormalized(): Bool {
    this.min.value <= this.max.value;
  }

  fun isPositive(): Bool {
    this.min.value >= 0.0;
  }

  fun normalize(optMin: ?Float = None()): Interval {
    minValue = optMin match {
    | Some(min) ->
      if (this.min.value >= min) {
        this.min.value
      } else {
        min
      }
    | _ -> this.min.value
    };
    maxValue = if (minValue >= this.max.value) {
      minValue
    } else {
      this.max.value
    };
    Interval(
      Boundary::create(minValue, this.min.included),
      Boundary::create(maxValue, this.max.included),
    );
  }

  fun copyWith{min: ?Float = None(), max: ?Float = None()}: Interval {
    min match {
    | Some(mi) ->
      max match {
      | Some(ma) ->
        Interval(
          Boundary::create(mi, this.min.included),
          Boundary::create(ma, this.max.included),
        )
      | _ -> Interval(Boundary::create(mi, this.min.included), this.max)
      }
    | _ ->
      max match {
      | Some(ma) -> Interval(this.min, Boundary::create(ma, this.min.included))
      | _ -> Interval(this.min, this.max)
      }
    };
  }
}
/**
 * TLayout constraints for [RenderBox] layout.
 *
 * A [Size] respects a [BoxConstraints] if, and only if, all of the following
 * relations hold:
 *
 * * [minWidth] <= [Size.width] <= [maxWidth]
 * * [minHeight] <= [Size.height] <= [maxHeight]
 *
 * The constraints themselves must satisfy these relations:
 *
 * * 0.0 <= [minWidth] <= [maxWidth] <= [double.infinity]
 * * 0.0 <= [minHeight] <= [maxHeight] <= [double.infinity]
 *
 * [double.infinity] is a legal value for each constraint.
 *
 * ## The box layout model
 *
 * Render objects are laid out by a one-pass layout
 * model which walks down the render tree passing constraints, then walks back
 * up the render tree passing concrete geometry.
 *
 * For boxes, the constraints are [BoxConstraints], which, as described herein,
 * consist of four numbers: a minimum width [minWidth], a maximum width
 * [maxWidth], a minimum height [minHeight], and a maximum height [maxHeight].
 *
 * The geometry for boxes consists of a [Size], which must satisfy the
 * constraints described above.
 *
 * Each [RenderBox] (the objects that provide the layout models for box
 * widgets) receives [BoxConstraints] from its parent, then lays out each of
 * its children, then picks a [Size] that satisfies the [BoxConstraints].
 *
 * Render objects position their children independently of laying them out.
 * Frequently, the parent will use the children's sizes to determine their
 * position. A child does not know its position and will not necessarily be
 * laid out again, or repainted, if its position changes.
 *
 * ## Terminology
 *
 * When the minimum constraints and the maximum constraint in an axis are the
 * same, that axis is _tightly_ constrained. See: [new
 * BoxConstraints.tightFor], [new BoxConstraints.tightForFinite], [tighten],
 * [hasTightWidth], [hasTightHeight], [isTight].
 *
 * An axis with a minimum constraint of 0.0 is _loose_ (regardless of the
 * maximum constraint; if it is also 0.0, then the axis is simultaneously tight
 * and loose!). See: [new BoxConstraints.loose], [loosen].
 *
 * An axis whose maximum constraint is not infinite is _bounded_. See:
 * [hasBoundedWidth], [hasBoundedHeight].
 *
 * An axis whose maximum constraint is infinite is _unbounded_. An axis is
 * _expanding_ if it is tightly infinite (its minimum and maximum constraints
 * are both infinite). See: [new BoxConstraints.expand].
 *
 * An axis whose _minimum_ constraint is infinite is just said to be _infinite_
 * (since by definition the maximum constraint must also be infinite in that
 * case). See: [hasInfiniteWidth], [hasInfiniteHeight].
 *
 * A size is _constrained_ when it satisfies a [BoxConstraints] description.
 * See: [constrain], [constrainWidth], [constrainHeight],
 * [constrainDimensions], [constrainSizeAndAttemptToPreserveAspectRatio],
 * [isSatisfiedBy].
 */
class BoxConstraints(
  width: Interval,
  height: Interval,
) extends Ui.Constraints, SKStore.File uses Orderable, Hashable {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ BoxConstraints _ -> x
    | _ -> invariant_violation("Must be Ui.BoxConstraints")
    }
  }

  static fun new(): BoxConstraints {
    BoxConstraints(Interval::zeroInfinite(), Interval::zeroInfinite());
  }

  static fun make{
    minWidth: ?Float = None(),
    maxWidth: ?Float = None(),
    minHeight: ?Float = None(),
    maxHeight: ?Float = None(),
  }: BoxConstraints {
    BoxConstraints(
      Interval::make{min => minWidth, max => maxWidth},
      Interval::make{min => minHeight, max => maxHeight},
    );
  }

  /**
   * Creates box constraints that is respected only by the given size.
   */
  static fun tight(width: Float, height: Float): BoxConstraints {
    BoxConstraints(
      Interval::included(width, width),
      Interval::included(height, height),
    )
  }

  /**
   * Creates box constraints that is respected the given min size.
   */
  static fun min(width: Float, height: Float): BoxConstraints {
    BoxConstraints(Interval::forMin(width), Interval::forMin(height))
  }

  /**
   * Creates box constraints that is respected the given max size.
   */
  static fun max(width: Float, height: Float): BoxConstraints {
    BoxConstraints(Interval::forMax(width), Interval::forMax(height))
  }

  /**
   * Creates box constraints that is respected the given min width.
   */
  static fun forMinWidth(width: Float): BoxConstraints {
    BoxConstraints(Interval::forMin(width), Interval::zeroInfinite())
  }

  /**
   * Creates box constraints that is respected the given min height.
   */
  static fun forMinHeight(height: Float): BoxConstraints {
    BoxConstraints(Interval::zeroInfinite(), Interval::forMin(height))
  }

  /**
   * Creates box constraints that is respected the given max width.
   */
  static fun forMaxWidth(width: Float): BoxConstraints {
    BoxConstraints(Interval::forMax(width), Interval::zeroInfinite())
  }

  /**
   * Creates box constraints that is respected the given max height.
   */
  static fun forMaxHeight(height: Float): BoxConstraints {
    BoxConstraints(Interval::zeroInfinite(), Interval::forMax(height))
  }

  /**
   * Creates box constraints that is respected the given min max height.
   */
  static fun forHeight(min: Float, max: Float): BoxConstraints {
    BoxConstraints(Interval::zeroInfinite(), Interval::included(min, max))
  }

  /**
   * Creates box constraints that is respected the given min max width.
   */
  static fun forWidth(min: Float, max: Float): BoxConstraints {
    BoxConstraints(Interval::included(min, max), Interval::zeroInfinite())
  }

  /**
   * Creates box constraints that require the given width or height.
   *
   * See also:
   *
   *  * [new BoxConstraints.tightForFinite], which is similar but instead of
   *    being tight if the value is non-null, is tight if the value is not
   *    infinite.
   */
  static fun tightFor{
    width: ?Float = None(),
    height: ?Float = None(),
  }: BoxConstraints {
    width match {
    | Some(w) ->
      height match {
      | Some(h) -> BoxConstraints::tight(w, h)
      | _ -> BoxConstraints(Interval::included(w, w), Interval::zeroInfinite())
      }
    | _ ->
      height match {
      | Some(h) ->
        BoxConstraints(Interval::zeroInfinite(), Interval::included(h, h))
      | _ -> BoxConstraints::new()
      }
    };
  }

  /**
   * Creates box constraints that require the given width or height, except if
   * they are infinite.
   *
   * See also:
   *
   *  * [new BoxConstraints.tightFor], which is similar but instead of being
   *    tight if the value is not infinite, is tight if the value is non-null.
   */
  static fun tightForFinite{
    width: Float = Float::inf,
    height: Float = Float::inf,
  }: BoxConstraints {
    minWidth = if (width != Float::inf) {
      width
    } else {
      0.0
    };
    minHeight = if (height != Float::inf) {
      height
    } else {
      0.0
    };
    BoxConstraints(
      Interval::included(minWidth, width),
      Interval::included(minHeight, height),
    )
  }

  /**
   * Creates box constraints that forbid sizes larger than the given size.
   */
  static fun loose(width: Float, height: Float): BoxConstraints {
    BoxConstraints(
      Interval::included(0.0, width),
      Interval::included(0.0, height),
    )
  }

  /**
   * Creates box constraints that expand to fill another box constraints.
   *
   * If width or height is given, the constraints will require exactly the
   * given value in the given dimension.
   */
  static fun expand{
    width: ?Float = None(),
    height: ?Float = None(),
  }: BoxConstraints {
    width match {
    | Some(w) ->
      height match {
      | Some(h) -> BoxConstraints::tight(w, h)
      | _ ->
        BoxConstraints(
          Interval::included(w, w),
          Interval::included(Float::inf, Float::inf),
        )
      }
    | _ ->
      height match {
      | Some(h) ->
        BoxConstraints(
          Interval::included(Float::inf, Float::inf),
          Interval::included(h, h),
        )
      | _ ->
        BoxConstraints(
          Interval::included(Float::inf, Float::inf),
          Interval::included(Float::inf, Float::inf),
        )
      }
    };
  }

  /**
   * Creates box constraints that is respected the given max width.
   */
  fun withMaxWidth(width: Float): BoxConstraints {
    !this.width = this.width.withMax(width);
    this;
  }

  /**
   * Creates box constraints that is respected the given max width.
   */
  fun withMaxHeight(height: Float): BoxConstraints {
    !this.height = this.height.withMax(height);
    this;
  }

  fun tightWidth(width: Float): BoxConstraints {
    !this.width = Interval::included(width, width);
    this;
  }

  fun tightHeight(height: Float): BoxConstraints {
    !this.height = Interval::included(height, height);
    this;
  }

  fun freeWidth(): BoxConstraints {
    !this.width = Interval::zeroInfinite();
    this;
  }

  fun freeHeight(): BoxConstraints {
    !this.height = Interval::zeroInfinite();
    this
  }

  fun minWidth(): Float {
    this.width.min.value;
  }

  fun maxWidth(): Float {
    this.width.max.value;
  }

  fun minHeight(): Float {
    this.height.min.value;
  }

  fun maxHeight(): Float {
    this.height.max.value;
  }

  /**
   * Creates a copy of this box constraints but with the given fields replaced with the new values.
   */
  fun copyWith{
    minWidth: ?Float = None(),
    maxWidth: ?Float = None(),
    minHeight: ?Float = None(),
    maxHeight: ?Float = None(),
  }: BoxConstraints {
    BoxConstraints(
      this.width.copyWith{min => minWidth, max => maxWidth},
      this.height.copyWith{min => minHeight, max => maxHeight},
    );
  }

  /**
   * Returns new box constraints that are smaller by the given edge dimensions.
   */
  fun deflate(edges: Geometry.InsetsGeometry): BoxConstraints {
    horizontal = edges.horizontal();
    vertical = edges.vertical();
    deflatedMinWidth = Math.max(0.0, this.width.min.value - horizontal);
    deflatedMaxWidth = if (this.width.isBounded()) {
      Math.max(deflatedMinWidth, this.width.max.value - horizontal);
    } else {
      Float::inf
    };
    deflatedMinHeight = Math.max(0.0, this.height.min.value - vertical);
    deflatedMaxHeight = if (this.height.isBounded()) {
      Math.max(deflatedMinHeight, this.height.max.value - vertical)
    } else {
      Float::inf
    };
    BoxConstraints(
      Interval::included(deflatedMinWidth, deflatedMaxWidth),
      Interval::included(deflatedMinHeight, deflatedMaxHeight),
    )
  }

  /**
   * Returns new box constraints that remove the minimum width and height requirements.
   */
  fun loosen(): BoxConstraints {
    BoxConstraints(
      this.width.copyWith{min => Some(0.0)},
      this.height.copyWith{min => Some(0.0)},
    )
  }

  fun loseWith(): BoxConstraints {
    BoxConstraints(this.width.copyWith{min => Some(0.0)}, this.height)
  }

  fun loseHeight(): BoxConstraints {
    BoxConstraints(this.width, this.height.copyWith{min => Some(0.0)})
  }

  fun expanded(): BoxConstraints {
    this.tighten{
      width => Some(this.maxWidth()),
      height => Some(this.maxHeight()),
    };
  }

  /**
   * Returns new box constraints that respect the given constraints while being
   * as close as possible to the original constraints.
   */
  fun enforce(constraints: BoxConstraints): BoxConstraints {
    minWidth = Math.clamp(
      this.width.min.value,
      constraints.width.min.value,
      constraints.width.max.value,
    );
    maxWidth = Math.clamp(
      this.width.max.value,
      constraints.width.min.value,
      constraints.width.max.value,
    );
    minHeight = Math.clamp(
      this.height.min.value,
      constraints.height.min.value,
      constraints.height.max.value,
    );
    maxHeight = Math.clamp(
      this.height.max.value,
      constraints.height.min.value,
      constraints.height.max.value,
    );
    BoxConstraints(
      Interval::included(minWidth, maxWidth),
      Interval::included(minHeight, maxHeight),
    )
  }
  /**
   * Returns new box constraints with a tight width close to
   * the given max width while still respecting the original
   * box constraints.
   */
  fun tightenToMaxWidth(): BoxConstraints {
    invariant(this.hasBoundedWidth(), "Must have bounded width");
    this.tighten{width => Some(this.maxWidth())};
  }

  /**
   * Returns new box constraints with a tight width and/or height as close to
   * the given width and height as possible while still respecting the original
   * box constraints.
   */
  fun tighten{
    width: ?Float = None(),
    height: ?Float = None(),
    enforce: Bool = false,
  }: BoxConstraints {
    if (enforce) {
      this.copyWith{
        minWidth => width,
        maxWidth => width,
        minHeight => height,
        maxHeight => height,
      };
    } else {
      minWidth = width match {
      | Some(w) -> this.constrainWidth(w)
      | _ -> this.width.min.value
      };
      maxWidth = width match {
      | Some(w) -> this.constrainWidth(w)
      | _ -> this.width.max.value
      };
      minHeight = height match {
      | Some(h) -> this.constrainHeight(h)
      | _ -> this.height.min.value
      };
      maxHeight = height match {
      | Some(h) -> this.constrainHeight(h)
      | _ -> this.height.max.value
      };
      BoxConstraints(
        Interval::included(minWidth, maxWidth),
        Interval::included(minHeight, maxHeight),
      )
    }
  }

  /**
   * A box constraints with the width and height constraints flipped.
   */
  fun flip(): BoxConstraints {
    BoxConstraints(this.height, this.width);
  }

  /**
   * Returns box constraints with the same width constraints but with
   * unconstrained height.
   */
  fun widthConstraints(): BoxConstraints {
    BoxConstraints(this.width, Interval::zeroInfinite());
  }

  /**
   * Returns box constraints with the same height constraints but with
   * unconstrained width
   */
  fun heightConstraints(): BoxConstraints {
    BoxConstraints(Interval::zeroInfinite(), this.height);
  }

  /**
   * Returns the width that both satisfies the constraints and is as close as
   * possible to the given width.
   */
  fun constrainWidth(width: Float): Float {
    Math.clamp(width, this.width.min.value, this.width.max.value)
  }

  /**
   * Returns the height that both satisfies the constraints and is as close as
   * possible to the given height.
   */
  fun constrainHeight(height: Float): Float {
    Math.clamp(height, this.height.min.value, this.height.max.value)
  }

  /**
   * Returns the size that both satisfies the constraints and is as close as
   * possible to the given size.
   *
   * See also:
   *
   *  * [constrainDimensions], which applies the same algorithm to
   *    separately provided widths and heights.
   */
  fun constrain(size: Geometry.Size): Geometry.Size {
    Geometry.Size(
      this.constrainWidth(size.width),
      this.constrainHeight(size.height),
    );
  }

  /**
   * The biggest size that satisfies the constraints.
   */
  fun biggest(): Geometry.Size {
    Geometry.Size(
      this.constrainWidth(Float::inf),
      this.constrainHeight(Float::inf),
    );
  }

  /**
   * The biggest size that satisfies the constraints.
   */
  fun smallest(): Geometry.Size {
    Geometry.Size(this.constrainWidth(0.0), this.constrainHeight(0.0));
  }

  /**
   * Whether there is exactly one width value that satisfies the constraints.
   */
  fun hasTightWidth(): Bool {
    this.width.isTight()
  }

  /**
   * Whether there is exactly one height value that satisfies the constraints.
   */
  fun hasTightHeight(): Bool {
    this.height.isTight()
  }

  /**
   * Whether there is exactly one size that satisfies the constraints.
   */
  fun isTight(): Bool {
    this.hasTightWidth() && this.hasTightHeight();
  }

  /**
   * Whether there is an upper bound on the maximum width.
   *
   * See also:
   *
   *  * [hasBoundedHeight], the equivalent for the vertical axis.
   *  * [hasInfiniteWidth], which describes whether the minimum width
   *    constraint is infinite.
   */
  fun hasBoundedWidth(): Bool {
    this.width.isBounded()
  }

  /**
   * Whether there is an upper bound on the maximum height.
   *
   * See also:
   *
   *  * [hasBoundedWidth], the equivalent for the horizontal axis.
   *  * [hasInfiniteHeight], which describes whether the minimum height
   *    constraint is infinite.
   */
  fun hasBoundedHeight(): Bool {
    this.height.isBounded()
  }

  /**
   * Whether the width constraint is infinite.
   *
   * Such a constraint is used to indicate that a box should grow as large as
   * some other constraint (in this case, horizontally). If constraints are
   * infinite, then they must have other (non-infinite) constraints [enforce]d
   * upon them, or must be [tighten]ed, before they can be used to derive a
   * [Size] for a [RenderBox.size].
   *
   * See also:
   *
   *  * [hasInfiniteHeight], the equivalent for the vertical axis.
   *  * [hasBoundedWidth], which describes whether the maximum width
   *    constraint is finite.
   */
  fun hasInfiniteWidth(): Bool {
    this.width.isInfinite()
  }

  /**
   * Whether the height constraint is infinite.
   *
   * Such a constraint is used to indicate that a box should grow as large as
   * some other constraint (in this case, vertically). If constraints are
   * infinite, then they must have other (non-infinite) constraints [enforce]d
   * upon them, or must be [tighten]ed, before they can be used to derive a
   * [Size] for a [RenderBox.size].
   *
   * See also:
   *
   *  * [hasInfiniteWidth], the equivalent for the horizontal axis.
   *  * [hasBoundedHeight], which describes whether the maximum height
   *    constraint is finite.
   */
  fun hasInfiniteHeight(): Bool {
    this.height.isInfinite()
  }

  /**
   * Whether the given size satisfies the constraints.
   */
  fun isSatisfiedBy(size: Geometry.Size): Bool {
    this.width.isSatisfiedBy(size.width) &&
      this.height.isSatisfiedBy(size.height)
  }

  /**
   * Scales each constraint parameter by the given factor.
   */
  fun *(factor: Float): BoxConstraints {
    BoxConstraints(this.width * factor, this.height * factor);
  }

  /**
   * Scales each constraint parameter by the inverse of the given factor.
   */
  fun /(factor: Float): BoxConstraints {
    BoxConstraints(this.width / factor, this.height / factor);
  }

  /**
   * Scales each constraint parameter by the inverse of the given factor, rounded to the nearest integer.
   */
  fun iDiv(factor: Int): BoxConstraints {
    BoxConstraints(this.width.iDiv(factor), this.height.iDiv(factor));
  }

  /**
   * Computes the remainder of each constraint parameter by the given value.
   */
  fun %(factor: Int): BoxConstraints {
    BoxConstraints(this.width % factor, this.height % factor);
  }

  /**
   * Returns whether the object's constraints are normalized.
   * Constraints are normalized if the minimums are less than or
   * equal to the corresponding maximums.
   *
   * For example, a BoxConstraints object with a minWidth of 100.0
   * and a maxWidth of 90.0 is not normalized.
   *
   * Most of the APIs on BoxConstraints expect the constraints to be
   * normalized and have undefined behavior when they are not. In
   * checked mode, many of these APIs will assert if the constraints
   * are not normalized.
   */
  fun isNormalized(): Bool {
    this.width.isNormalized() &&
      this.width.isPositive() &&
      this.height.isNormalized() &&
      this.height.isPositive()
  }

  /**
   * Returns a box constraints that [isNormalized].
   *
   * The returned [maxWidth] is at least as large as the [minWidth]. Similarly,
   * the returned [maxHeight] is at least as large as the [minHeight].
   */
  fun normalize(): BoxConstraints {
    if (this.isNormalized()) {
      this
    } else {
      BoxConstraints(
        this.width.normalize(Some(0.0)),
        this.height.normalize(Some(0.0)),
      )
    }
  }

  /**
   * Linearly interpolate between two BoxConstraints.
   *
   * If either is null, this function interpolates from a [BoxConstraints]
   * object whose fields are all set to 0.0.
   */
  static fun lerp(
    a: ?BoxConstraints,
    b: ?BoxConstraints,
    t: Float,
  ): ?BoxConstraints {
    a match {
    | Some(ap) ->
      b match {
      | Some(bp) ->
        // Return None() instead ??
        invariant(
          (ap.width.min.isFinite() && bp.width.min.isFinite()) ||
            (ap.width.min.isInf() && bp.width.min.isInf()),
          "Cannot interpolate between finite constraints and unbounded constraints.",
        );
        invariant(
          (ap.width.max.isFinite() && bp.width.max.isFinite()) ||
            (ap.width.max.isInf() && bp.width.max.isInf()),
          "Cannot interpolate between finite constraints and unbounded constraints.",
        );
        invariant(
          (ap.height.min.isFinite() && bp.height.min.isFinite()) ||
            (ap.height.min.isInf() && bp.height.min.isInf()),
          "Cannot interpolate between finite constraints and unbounded constraints.",
        );
        invariant(
          (ap.height.max.isFinite() && bp.height.max.isFinite()) ||
            (ap.height.max.isInf() && bp.height.max.isInf()),
          "Cannot interpolate between finite constraints and unbounded constraints.",
        );
        minWidth = if (ap.width.min.isFinite()) {
          Math.lerp(ap.width.min.value, bp.width.min.value, t)
        } else {
          Float::inf
        };
        maxWidth = if (ap.width.max.isFinite()) {
          Math.lerp(ap.width.max.value, bp.width.max.value, t)
        } else {
          Float::inf
        };
        minHeight = if (ap.height.min.isFinite()) {
          Math.lerp(ap.height.min.value, bp.height.min.value, t)
        } else {
          Float::inf
        };
        maxHeight = if (ap.height.max.isFinite()) {
          Math.lerp(ap.height.max.value, bp.height.max.value, t)
        } else {
          Float::inf
        };
        Some(
          BoxConstraints(
            Interval::included(minWidth, maxWidth),
            Interval::included(minHeight, maxHeight),
          ),
        )
      | _ -> Some(ap * (1.0 - t))
      }
    | _ ->
      b match {
      | Some(bp) -> Some(bp * t)
      | _ -> None()
      }
    }
  }
}

module end;
