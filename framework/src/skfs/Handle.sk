module SKStore;

extension base class Handle {
  fun getRange(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): .Range {
    this.getProp(
      context,
      property,
      f ~> RangeFile::type(f).value,
      .Range(0, 0),
      isUntracked,
    )
  }

  fun maybeGetRange(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): ?.Range {
    this.maybeGetProp(context, property, RangeFile::type, isUntracked).map(
      rf -> rf.value,
    )
  }

  fun getStatus(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): Status {
    this.getProp(context, property, Status::btype, OK(), isUntracked)
  }

  fun maybeGetStatus(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): ?Status {
    this.maybeGetProp(context, property, Status::btype, isUntracked)
  }
}

module end;
