module Ui;

trait NoViewports {
  //
  fun getViewportDefinition(_context: mutable SKStore.Context): ?ViewportDef {
    None()
  }
}

trait WithViewports {
  //
  protected fun getPath(): Path;
  protected fun getWidgets(context: mutable SKStore.Context): Array<Widget>;

  fun getViewportDefinition(context: mutable SKStore.Context): ?ViewportDef {
    vector = mutable Vector<ViewportDef>[];
    this.getWidgets(context).each(w ->
      w.getViewportDefinition(context).each(vector.push)
    );
    vector.size() match {
    | 0 -> None()
    | 1 -> Some(vector.first())
    | _ -> Some(ViewportDef(None(), vector.toArray(), this.getPath(), None()))
    }
  }
}

trait ScrollingStorage {
  //
  protected fun getHandle(): SKStore.IHandle<SKStore.Key, SKStore.File>;

  fun setScroll(context: mutable SKStore.Context, optScroll: ?Ui.Scroll): void {
    this.getHandle().writeOrRemove(context, scrollProp, optScroll)
  }

  fun setScrolling(
    context: mutable SKStore.Context,
    optTick: ?SKStore.Tick,
  ): void {
    this.getHandle().writeOrRemove(
      context,
      scrollingProp,
      optTick.map(t -> SKStore.IntFile(t.value)),
    )
  }

  fun getScrolling(context: mutable SKStore.Context): ?SKStore.Tick {
    this.getHandle().maybeGetInt(context, scrollingProp).map(v ->
      SKStore.Tick(v)
    )
  }
}

trait ScrollingState {
  //
  protected fun getHandle(): SKStore.EHandle<SKStore.Key, SKStore.File>;
  protected fun getComputed(): SKStore.EHandle<SKStore.Key, SKStore.File>;
  protected fun getStatePath(): String;
  protected fun setScrollCmd(?Ui.Scroll): SKUIMessage.Command;
  protected fun manageScrollingCmd(Int, SKStore.Tick): SKUIMessage.Command;

  fun getScroll(context: mutable SKStore.Context): ?Ui.Scroll {
    conv: SKStore.File ~> Ui.Scroll = f ~>
      f match {
      | s @ Ui.Scroll _ -> s
      | _ -> SKStore.cast_violation("Ui.Scroll", f)
      };
    this.getHandle().maybeGetProp(context, Ui.scrollProp, conv);
  }

  fun getEnsureVisible(context: mutable SKStore.Context): ?Ui.Visible {
    conv: SKStore.File ~> Ui.Visible = f ~>
      f match {
      | v @ Ui.Visible _ -> v
      | _ -> SKStore.cast_violation("Ui.Visible", f)
      };
    this.getComputed()
      .maybeGetProp(context, Ui.ensureVisibleProp, conv)
      .flatMap(v -> if (v.tick == context.getTick()) Some(v) else None());
  }

  fun emitScrolling(context: mutable SKStore.Context, value: Int): void {
    this.emit(context, this.manageScrollingCmd(value, context.getTick()));
  }

  fun emitScroll(context: mutable SKStore.Context, value: ?Ui.Scroll): void {
    this.emit(context, this.setScrollCmd(value));
  }

  protected fun emit(
    context: mutable SKStore.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(
      context,
      this.getStatePath(),
      this.getHandle().dirName.toString(),
      command,
    );
  }
}

module end;
