module Ui;

class Dialogs protected {
  controller: UiDialogs.Controller,
  state: UiDialogs.State,
  private supplier: mutable SKStore.Context ~> Widget,
} extends StrictWidget uses WithNodeCache, FWK.NoFocusHandler {
  //
  type Params = UiDialogs.Parameters;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Ui.Path,
    params: UiDialogs.Parameters,
    cache: NodeCache,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    mainHdl = context.makeDir(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      UiDialog.widgetDirName(path.makeChild("source")),
      Array[(SKStore.IID(0), SKStore.IntFile(0))],
    );
    builderHdl = mainHdl.map(
      SKStore.IID::keyType,
      WidgetFile::type,
      context,
      UiDialog.widgetDirName(path),
      (context, writer, key, _file) ~> {
        writer.set(
          key,
          WidgetFile(
            Stack::createForController(
              context,
              path.makeChild("stack"),
              UiStack.LamController{
                widgets => UiDialogs.Collection(
                  params.controller,
                  params.state,
                ),
              },
            ),
          ),
        )
      },
    );
    static{
      path,
      controller => params.controller,
      state => params.state,
      cache,
      optConfiguration,
      supplier => ctx ~> builderHdl.get(ctx, SKStore.IID(0)).widget,
      tick => context.tick,
    }
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    builtNode = this.supplier(context).getNode(context, constraints);
    Node(
      this,
      builtNode.size,
      Array[CNode(builtNode, Geometry.Offset::zero, constraints)],
    )
  }

  fun getViewportDefinition(context: mutable SKStore.Context): ?ViewportDef {
    this.supplier(context).getViewportDefinition(context);
  }

  fun alert(
    context: mutable SKStore.Context,
    text: Text,
    optTitle: ?Text = None(),
  ): void {
    this.state.open(context, UiDialogs.Alert{text, optTitle})
  }

  fun confirm(
    context: mutable SKStore.Context,
    text: Text,
    onConfirm: (mutable SKStore.Context, Bool, Int) ~> void,
    type_: UiDialogs.QType = UiDialogs.YesNo(),
    optTitle: ?Text = None(),
    autoClose: Bool = true,
  ): void {
    this.state.open(
      context,
      UiDialogs.Question{text, onConfirm, type_, optTitle, autoClose},
    )
  }

  fun input(
    context: mutable SKStore.Context,
    message: Text,
    onInput: (mutable SKStore.Context, String, Int) ~> void,
    optTitle: ?Text = None(),
    autoClose: Bool = true,
    settings: UiDialogs.Settings = UiDialogs.Settings{},
  ): void {
    this.state.open(
      context,
      UiDialogs.Input{message, onInput, optTitle, autoClose, settings},
    )
  }
}

module end;
