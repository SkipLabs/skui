module Ui;

class TabsSc protected {
  reference: Path,
  controller: UiTabsSc.Controller,
  state: UiTabsSc.State,
  widget: mutable SKStore.Context ~> Widget,
} extends StrictWidget uses WithNodeCache {
  //
  type Params = UiTabsSc.Parameters;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Path,
    params: UiTabsSc.Parameters,
    cache: NodeCache,
    optConfiguration: ?Getter<Configuration> = None(),
  ): this {
    mainHdl = context.makeDir(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      UiTabsSc.widgetDirName(path.makeChild("source")),
      Array[(SKStore.IID(0), SKStore.IntFile(0))],
    );
    widgetHdl = mainHdl.map(
      SKStore.IID::keyType,
      WidgetFile::type,
      context,
      UiTabsSc.widgetDirName(path),
      (context, writer, key, _) ~> {
        subPath = path.makeChild("viewport");
        writer.set(
          key,
          WidgetFile(
            Flex::createForController(
              context,
              subPath,
              UiFlex.LamController{
                widgets => params.controller,
                direction => params.controller.getDirection,
                crossAxisAlignment => _ctx ~> UiFlex.CrossStretch(),
              },
            ),
          ),
        )
      },
    );
    static{
      path,
      controller => params.controller,
      state => params.state,
      reference => params.reference,
      optConfiguration,
      cache,
      widget => ctx ~> widgetHdl.get(ctx, SKStore.IID(0)).widget,
      tick => context.getTick(),
    }
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    direction = this.controller.getDirection(context);
    child = this.viewportChild(context, constraints, Some(direction));
    spaces = UiTabsSc.space * 2.0;
    (size, offset) = direction match {
    | HorizontalAxis() ->
      (
        constraints.constrain(child.node.size + Geometry.Size(spaces, 0.0)),
        Geometry.Offset(UiTabsSc.space, 0.0),
      )
    | VerticalAxis() ->
      (
        constraints.constrain(child.node.size + Geometry.Size(0.0, spaces)),
        Geometry.Offset(0.0, UiTabsSc.space),
      )
    };
    lSize = direction match {
    | HorizontalAxis() -> size - Geometry.Size(spaces, 0.0)
    | VerticalAxis() -> size - Geometry.Size(0.0, spaces)
    };
    Node::create(
      this,
      size,
      Array[
        CLink::create(
          this.path.makeChild("vp"),
          Geometry.Rect::fromOffsetSize(offset, lSize),
          Opaque(),
          child.constraints,
        ),
      ],
      ctx ~> this.computeUserData(ctx, child.node, lSize, direction),
    );
  }

  fun computeDrawInfo(
    context: mutable SKStore.Context,
    _support: Ui.DrawableSupport,
    _relative: Geometry.Offset,
    nodeSum: NodeSum,
    optUserData: ?UserData,
  ): ?DrawInfo {
    metrics = optUserData.map(ud ~> ud as Metrics _).fromSome();
    drawInfo = UiTabsSc.DrawInfo::compute(context, this, nodeSum.size, metrics);
    Some(drawInfo);
  }

  fun viewportChild(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
    optDirection: ?Axis = None(),
  ): CNode {
    direction = optDirection match {
    | Some(d) -> d
    | _ -> this.controller.getDirection(context)
    };
    widget = this.widget(context);
    cConstraints = direction match {
    | HorizontalAxis() -> constraints.freeWidth()
    | VerticalAxis() -> constraints.freeHeight()
    };
    node = widget.getNode(context, cConstraints);
    CNode::create(node, Geometry.Offset::zero, cConstraints)
  }

  fun getViewportDefinition(context: mutable SKStore.Context): ?ViewportDef {
    viewport = this.path.makeChild("vp");
    Some(
      ViewportDef(
        Some(
          UiTabs.Viewport{
            path => this.path.makeChild("viewport"),
            scroll => this,
            tick => context.getTick(),
          },
        ),
        Array[],
        viewport,
        Some(this.path),
      ),
    )
  }

  fun getHoverHandler(
    _context: mutable SKStore.Context,
    childGetter: Getter<?FWK.HoverHandler>,
  ): ?HoverHandlerGetter {
    Some((ctx, offset, ni) ~> {
      drawInfo = ni.optDrawInfo.map(di ~> di as UiTabsSc.DrawInfo _).fromSome();
      otherwise = () -> {
        drawInfo.optScrollAfter match {
        | Some(scrollAfter) ->
          if (scrollAfter.contains(offset)) {
            UiTabsSc.HoverHandler(
              this,
              Some(UiTabsSc.After()),
              childGetter(ctx),
            )
          } else {
            UiTabsSc.HoverHandler(this, None(), childGetter(ctx))
          }
        | _ -> UiTabsSc.HoverHandler(this, None(), childGetter(ctx))
        }
      };

      Some(
        drawInfo.optScrollBefore match {
        | Some(scrollBefore) ->
          if (scrollBefore.contains(offset)) {
            UiTabsSc.HoverHandler(
              this,
              Some(UiTabsSc.Before()),
              childGetter(ctx),
            )
          } else {
            otherwise()
          }
        | _ -> otherwise()
        },
      )
    })
  }

  fun getDropHandler(
    _context: mutable SKStore.Context,
    childGetter: Getter<?FWK.DropHandler>,
  ): ?DropHandlerGetter {
    Some((ctx, _o, ni) ~>
      Some(UiTabsSc.DropHandler(this, ni, childGetter(ctx)))
    );
  }

  fun checkFocusHandlers(
    context: mutable SKStore.Context,
    nodeInfo: Getter<NodeInfo>,
    handlers: readonly Vector<FWK.FocusHandler>,
  ): Vector<FWK.FocusHandler> {
    ni = nodeInfo(context);
    metrics = ni.optUserData.map(ud ~> ud as Metrics _).fromSome();
    wrappedFocusHandlers(handlers, optFocusHandler ->
      optFocusHandler.map(fh -> {
        index = 0;
        while (index < metrics.ids.size()) {
          path = metrics.ids[index];
          if (path.isParentOf(fh.getIdentifier())) {
            break void;
          };
          !index = index + 1;
        };
        UiTabsSc.FocusHandler{
          scroll => this,
          category => "tabScroll",
          optFocusHandler,
          index,
        }
      })
    );
  }

  fun computeLayer(
    context: mutable SKStore.Context,
    support: DrawableSupport,
    absolute: Geometry.Offset,
    layer: LayerId,
    node: NodeInfo,
  ): Array<Drawable> {
    layer match {
    | MainLayer()
    | BackgroundLayer() ->
      Array[]
    | ForegroundLayer() ->
      drawables = mutable Vector<Drawable>[];
      drawInfo = node.optDrawInfo
        .map(di ~> di as UiTabsSc.DrawInfo _)
        .fromSome();
      this.fillForeground(context, support, absolute, drawInfo, drawables);
      drawables.toArray()
    };
  }

  private fun computeUserData(
    context: mutable SKStore.Context,
    node: Node,
    size: Geometry.Size,
    direction: Axis,
  ): ?UserData {
    (sizes, max) = direction match {
    | HorizontalAxis() ->
      (node.subNodes.map(c -> (c as CNode _).node.size.width), size.width)
    | VerticalAxis() ->
      (node.subNodes.map(c -> (c as CNode _).node.size.height), size.height)
    };
    ids = node.subNodes.map(c -> (c as CNode _).node.widget.path);
    Some(UiTabsSc.computeMetrics(context, this.state, sizes, max, ids))
  }

  private fun fillForeground(
    context: mutable SKStore.Context,
    support: DrawableSupport,
    absolute: Geometry.Offset,
    drawInfo: UiTabsSc.DrawInfo,
    drawables: mutable Vector<Drawable>,
  ): void {
    direction = this.controller.getDirection(context);
    drawInfo.optScrollBefore.each(scrollBefore -> {
      regular = context.getThemeColor(UiTheme.Regular());
      color = if (this.state.getHover(context) == Some(UiTabsSc.Before())) {
        regular
      } else {
        regular.scaleAlpha(0.5)
      };
      direction match {
      | HorizontalAxis() ->
        width = scrollBefore.width() - 4.0;
        drawables.push(
          support.triangle(
            absolute +
              scrollBefore
                .topLeft()
                .translate(2.0, (scrollBefore.height() - width) / 2.0),
            Geometry.Size::square(width),
            color,
            UiSide.Left(),
          ),
        )
      | VerticalAxis() ->
        height = scrollBefore.height() - 4.0;
        drawables.push(
          support.triangle(
            absolute +
              scrollBefore
                .topLeft()
                .translate((scrollBefore.width() - height) / 2.0, 2.0),
            Geometry.Size::square(height),
            color,
            UiSide.Top(),
          ),
        )
      }
    });
    drawInfo.optScrollAfter.each(scrollAfter -> {
      regular = context.getThemeColor(UiTheme.Regular());
      color = if (this.state.getHover(context) == Some(UiTabsSc.After())) {
        regular
      } else {
        regular.scaleAlpha(0.5)
      };
      direction match {
      | HorizontalAxis() ->
        width = scrollAfter.width() - 4.0;
        drawables.push(
          support.triangle(
            absolute +
              scrollAfter
                .topLeft()
                .translate(2.0, (scrollAfter.height() - width) / 2.0),
            Geometry.Size::square(width),
            color,
            UiSide.Right(),
          ),
        )
      | VerticalAxis() ->
        height = scrollAfter.height() - 4.0;
        drawables.push(
          support.triangle(
            absolute +
              scrollAfter
                .topLeft()
                .translate((scrollAfter.width() - height) / 2.0, 2.0),
            Geometry.Size::square(height),
            color,
            UiSide.Bottom(),
          ),
        )
      }
    });
  }
}

module end;
