module Ui;

class Tree protected {
  controller: UiTree.Controller,
  state: UiTree.State,
  widget: mutable SKStore.Context ~> Widget,
  private bar: UiTree.Bar,
} extends StrictWidget uses WithNodeCache {
  //
  type Params = UiTree.Parameters;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Path,
    params: UiTree.Parameters,
    cache: NodeCache,
    optConfiguration: ?Getter<Configuration> = None(),
  ): this {
    mainHdl = context.makeDir(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      UiTree.widgetDirName(path.makeChild("source")),
      Array[(SKStore.IID(0), SKStore.IntFile(0))],
    );
    visibleWidgetsList = params.state
      .getVisibleItems()
      .map(
        context,
        UiTree.itemsDirName(path.makeChild("widgets")),
        (ctx, key, item) ~> {
          id = key as Path _;
          tiPath = path.makeChild("items").add(id);
          tiContoller = UiTreeItem.LamController{
            current => ctx ~> params.state.getCurrent(ctx) == Some(id),
            selected => ctx ~> params.state.isSelected(ctx, id),
            allowExpansion => _ctx ~> !item.item.leaf,
            text => _ctx ~> item.item.text,
            icon => (ctx, fs) ~>
              item.item.icon
                .flatMap(d -> d.toIconBuilder())
                .flatMap(ib -> ib.buildIcon(ctx, fs)),
            tooltip => _ctx ~> item.item.tooltip,
            badge => ctx ~> params.state.getBadge(ctx, id),
            progress => ctx ~> params.state.getProgress(ctx, id),
            depth => _ctx ~> item.depth,
            expanded => ctx ~> params.state.isExpanded(ctx, id),
            focused => ctx ~> ctx.isFocused(path),
            select => (ctx, toggle, keep) ~> {
              SystemProperties.setRequireFocus(ctx, path);
              params.state.select(ctx, id, toggle, keep)
            },
            fire => ctx ~> params.state.fire(ctx, id),
            drop => params.controller.onDrop,
            contextMenuItems => ctx ~> {
              selection = params.state.getSelection(ctx);
              params.controller.getContextMenuItems(ctx, Some(id), selection);
            },
          };
          WidgetFile(
            TreeItem::create(
              ctx,
              tiPath,
              UiTreeItem.Parameters(
                path,
                id,
                tiContoller,
                UiTreeItem.init(ctx, tiPath, tiContoller),
              ),
            ),
          )
        },
        WidgetFile::type,
        w ~> w,
      );
    widgetHdl = mainHdl.map(
      SKStore.IID::keyType,
      WidgetFile::type,
      context,
      UiTree.widgetDirName(path),
      (context, writer, key, _) ~> {
        subPath = path.makeChild("viewport");
        writer.set(
          key,
          WidgetFile(
            Flex::createForController(
              context,
              subPath,
              UiFlex.LamController{
                widgets => WidgetsList(visibleWidgetsList),
                direction => _ctx ~> VerticalAxis(),
                crossAxisAlignment => _ctx ~> UiFlex.CrossStretch(),
              },
            ),
          ),
        )
      },
    );
    static{
      path,
      controller => params.controller,
      state => params.state,
      optConfiguration,
      cache,
      widget => ctx ~> widgetHdl.get(ctx, SKStore.IID(0)).widget,
      tick => context.getTick(),
      bar => UiTree.Bar{
        path => path.makeChild("bar"),
        reference => path,
        state => params.state,
        tick => context.getTick(),
      },
    }
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    widget = this.widget(context);
    cConstraints = constraints.freeHeight();
    node = widget.getNode(context, cConstraints);
    size = constraints.constrain(node.size);
    height = node.subNodes
      .maybeFirst()
      .flatMap(child ->
        child match {
        | cNode @ CNode _ -> Some(cNode.node.size.height)
        | _ -> None()
        }
      )
      .default(20.0);
    count = this.state.getSize(context);
    //
    Node(
      this,
      size,
      Array[
        CLink(
          this.path.makeChild("vp"),
          Geometry.Rect::fromOffsetSize(Geometry.Offset::zero, size),
          Opaque(),
          cConstraints,
        ),
        CLink(
          this.path.makeChild("barVp"),
          Geometry.Rect::fromOffsetSize(Geometry.Offset::zero, size),
          Opaque(false, false),
          constraints,
        ),
      ],
      ctx ~>
        Some(
          UiTree.Metrics::compute(
            ctx,
            height,
            count,
            size.height,
            this.state.getScroll,
          ),
        )
      ,
    );
  }

  fun computeDrawInfo(
    context: mutable SKStore.Context,
    _support: Ui.DrawableSupport,
    _relative: Geometry.Offset,
    nodeSum: NodeSum,
    optUserData: ?UserData,
  ): ?DrawInfo {
    metrics = optUserData.map(ud ~> ud as UiTree.Metrics _).fromSome();
    drawInfo = UiTree.DrawInfo::compute(context, this, nodeSum.size, metrics);
    Some(drawInfo);
  }

  fun getViewportDefinition(context: mutable SKStore.Context): ?ViewportDef {
    Some(
      ViewportDef(
        None(),
        Array[
          ViewportDef(
            Some(this.widget(context)),
            Array[],
            this.path.makeChild("vp"),
            Some(this.path),
          ),
          ViewportDef(
            Some(this.bar),
            Array[],
            this.path.makeChild("barVp"),
            None(),
          ),
        ],
        this.path,
        None(),
      ),
    );
  }

  fun checkFocusHandlers(
    _context: mutable SKStore.Context,
    _nodeInfo: Getter<NodeInfo>,
    _handlers: readonly Vector<FWK.FocusHandler>,
  ): Vector<FWK.FocusHandler> {
    Vector[UiTree.FocusHandler{category => "tree", tree => this}]
  }

  fun getHoverHandler(
    _context: mutable SKStore.Context,
    childGetter: Getter<?FWK.HoverHandler>,
  ): ?HoverHandlerGetter {
    Some((ctx, offset, ni) ~> {
      drawInfo = ni.optDrawInfo.map(di ~> di as UiTree.DrawInfo _).fromSome();
      bar = drawInfo.optBar match {
      | Some(bar) -> bar.i1.contains(offset)
      | _ -> false
      };
      Some(UiTree.HoverHandler(this, bar, childGetter(ctx)))
    })
  }

  fun getLockHandler(
    _context: mutable SKStore.Context,
    _childGetter: Getter<?FWK.LockHandler>,
  ): ?LockHandlerGetter {
    Some((ctx, mouse, ni) ~> {
      offset = mouse.offset();
      inBar = if (mouse.isPrimaryPressed(ctx.getTick())) {
        drawInfo = ni.optDrawInfo.map(di ~> di as UiTree.DrawInfo _).fromSome();
        drawInfo.optBar match {
        | Some(bar) -> bar.i1.contains(offset)
        | _ -> false
        };
      } else {
        false
      };
      if (inBar) {
        Some(UiTree.LockHandler(this))
      } else {
        None()
      }
    })
  }

  fun getDropHandler(
    _context: mutable SKStore.Context,
    childGetter: Getter<?FWK.DropHandler>,
  ): ?DropHandlerGetter {
    Some((ctx, _o, ni) ~> Some(UiTree.DropHandler(this, ni, childGetter(ctx))));
  }
}

module end;
