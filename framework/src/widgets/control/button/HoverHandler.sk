module UiButton;

class HoverHandler(button: Ui.Button) extends FWK.HoverHandler {
  fun getIdentifier(): Ui.Path {
    this.button.path
  }

  fun enter(context: mutable SKStore.Context): void {
    if (!this.button.controller.isDisabled(context)) {
      FWKPointer.setCursor(context, Ui.HandCursor());
    };
  }

  fun manage(
    context: mutable SKStore.Context,
    mouse: UiEvent.MouseFile,
    _optPrevious: ?FWK.HoverHandler,
  ): FWK.Result {
    if (this.button.controller.isDisabled(context)) {
      return FWK.Result(false);
    };
    FWK.Result(
      if (mouse.isPrimaryPressed(context.getTick())) {
        SystemProperties.setRequireFocus(context, this.button.path);
        this.button.state.emitArmed(context, true);
        true
      } else if (
        mouse.isPrimaryReleased(context.getTick()) &&
        this.button.state.isArmed(context)
      ) {
        this.button.state.emitArmed(context, false);
        this.button.controller.fire(
          context,
          Some(mouse.getPrimaryClickCount()),
        );
        true
      } else {
        false
      },
    )
  }

  fun exit(context: mutable SKStore.Context): void {
    FWKPointer.resetCursor(context);
    this.button.state.emitArmed(context, false);
  }

  fun getTooltip(context: mutable SKStore.Context): ?FWK.SourcedWidget {
    Ui.buildTooltip(
      context,
      this.button.path,
      this.button.controller.getTooltip,
    )
  }
}

module end;
