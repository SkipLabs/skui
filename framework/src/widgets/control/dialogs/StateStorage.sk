module UiDialogs;

const statePath: String = "ui/dialogs/state";
const computedPath: String = "ui/dialogs/computed";

class Info(id: Int, visible: Bool, optFocused: ?Ui.Path)

class Infos(value: Array<Info> = Array[], next: Int = 0) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Infos _ -> x
    | _ -> invariant_violation("Must be UiDialogs.Infos")
    }
  }
}

class HState(
  storage: SKStore.IHandle<SKStore.Key, SKStore.File>,
  computed: SKStore.EHandle<SKStore.Key, SKStore.File>,
) extends State {
  fun getDialogCount(context: mutable SKStore.Context): Int {
    this.computed.getInt(context, SKStore.KSize())
  }

  fun getDialog(context: mutable SKStore.Context, index: Int): Ui.Dialog {
    this.computed.maybeGetProp(context, SKStore.IID(index), Ui.WidgetFile::type)
      .map(f -> f.widget as Ui.Dialog _)
      .fromSome()
  }

  fun open(context: mutable SKStore.Context, kind: Kind): void {
    Ui.setTodo(context, this.storage, Open(kind));
  }

  fun close(context: mutable SKStore.Context, id: Int): void {
    Ui.setTodo(context, this.storage, Close(id));
  }

  fun setVisible(
    context: mutable SKStore.Context,
    id: Int,
    visible: Bool,
  ): void {
    Ui.setTodo(context, this.storage, SetVisible(id, visible));
  }

  fun openAlert(
    context: mutable SKStore.Context,
    text: Text,
    optTitle: ?Text = None(),
  ): void {
    Ui.setTodo(context, this.storage, Open(Alert{text, optTitle}));
  }

  fun openConfirmDialog(
    context: mutable SKStore.Context,
    text: Text,
    onConfirm: (mutable SKStore.Context, Bool, Int) ~> void,
    autoClose: Bool = true,
    type_: UiDialogs.QType = UiDialogs.YesNo(),
    optTitle: ?Text = None(),
  ): void {
    Ui.setTodo(
      context,
      this.storage,
      Open(Question{text, onConfirm, type_, optTitle, autoClose}),
    );
  }

  fun openInputDialog(
    context: mutable SKStore.Context,
    message: Text,
    onInput: (mutable SKStore.Context, String, Int) ~> void,
    autoClose: Bool = true,
    optTitle: ?Text = None(),
    settings: Settings = Settings{},
  ): void {
    Ui.setTodo(
      context,
      this.storage,
      Open(Input{message, onInput, optTitle, autoClose, settings}),
    );
  }
}

fun init(context: mutable SKStore.Context, path: Ui.Path): State {
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeDir(
    SKStore.StrID::keyType,
    Ui.Todo::type,
    dirName,
    Array[(Ui.todoProp, Ui.Todo(Ui.Init(), context.tick))],
  );
  storage = SKStore.IHandle::notTyped(dirName);
  computedDirName = SKStore.DirName::make(dirName, "computed/");
  computedHdl = SKStore.derive(
    context,
    dirName.toString(),
    computedDirName,
    stateHdl,
    Ui.todoProp,
    Array[Ui.keysProp],
    update,
    None(),
  );
  afterHdl = computedHdl.map(
    k ~> k,
    f ~> f,
    context,
    SKStore.DirName::make(dirName, "after/"),
    (context, writer, key, it) ~> {
      key match {
      | iid @ SKStore.IID _ ->
        dialog = (it.first as Kind _).toDialog(
          context,
          path.makeChild("dialog").makeChild(`k${iid}`),
          iid.value,
          ctx ~> Ui.setTodo(ctx, storage, Close(iid.value)),
        );
        dialog.getMainFocusable(context).each(focusable ->
          SystemProperties.setRequireFocus(context, focusable)
        );
        writer.set(iid, Ui.WidgetFile(dialog))
      | _ -> void
      }
    },
  );
  indexedHdl = computedHdl.map(
    k ~> k,
    f ~> f,
    context,
    SKStore.DirName::make(dirName, "indexed/"),
    (context, writer, key, it) ~>
      if (key == Ui.keysProp) {
        keys = Infos::type(it.first);
        count = 0;
        for (info in keys.value) {
          afterHdl.maybeGet(context, SKStore.IID(info.id)) match {
          | Some(f) ->
            if (info.visible) {
              writer.set(SKStore.IID(count), f);
              !count = count + 1
            }
          | _ -> void
          }
        };
        writer.set(SKStore.KSize(), SKStore.IntFile(count));
      }
    ,
  );
  HState(storage, indexedHdl)
}

fun update(
  context: mutable SKStore.Context,
  _scope: String,
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  todo: Ui.Todo,
  _optUserData: ?SKStore.UserData,
): void {
  execute(context, todo.command, values)
}

fun execute(
  context: mutable SKStore.Context,
  executable: Ui.Executable,
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
): void {
  keys = values.get(Ui.keysProp).map(Infos::type).default(Infos());
  executable match {
  | Ui.Multiple(cmds) -> cmds.each(cmd -> execute(context, cmd, values))
  | Ui.Init() -> void
  | Open(kind) ->
    focusState = FWK.getFocusState(context, true);
    optFocused = focusState.optFocused.map(fh -> fh.getIdentifier());
    !keys.value = Arrays.add(keys.value, Info(keys.next, true, optFocused));
    values.set(SKStore.IID(keys.next), Some(kind));
    !keys.next = keys.next + 1
  | SetVisible(dialogId, visible) ->
    !keys.value = keys.value.map(i -> {
      if (i.id == dialogId) !i.visible = visible;
      i
    })
  | Close(dialogId) ->
    keys.value.maybeGet(keys.value.size() - 1).each(i ->
      if (i.id == dialogId) {
        i.optFocused.each(focused ->
          SystemProperties.setRequireFocus(context, focused)
        )
      }
    );
    !keys.value = keys.value.filter(i -> i.id != dialogId);
    values.remove(SKStore.IID(dialogId))
  | _ -> SKStore.cast_violation("UiDialogs.Executable", executable)
  };
  values.set(Ui.keysProp, Some(keys));
}

module end;
