module UiDropdown;

class LamController{
  onClose_: mutable SKStore.Context ~> void,
} extends Controller {
  //
  static fun fromArray(
    items: Ui.GetterOne<Array<ItemBase>, Bool>,
    onClose_: mutable SKStore.Context ~> void,
  ): this {
    LamController{
      items => (ctx, ui) ~> ArrayCollection(items(ctx, ui)),
      onClose_,
    }
  }

  fun onClose(context: mutable SKStore.Context): void {
    this.onClose_(context)
  }
}

module end;
