module UiInput;

const vSpace: Int = 16;
const hSpace: Int = 6;
const textGap: Int = 6;
const vTextGap: Int = 4;

class Layout(
  textOffset: Float,
  textWidth: Float,
  textHeight: Float,
  body: Float,
  width: Float,
  height: Float,
  prefix: Float,
  suffix: Float,
  fire: Float,
  clear: Float,
  hide: Float,
  icon: Float,
) extends Ui.UserData

base class Target uses HasClassName, Equality {
  children =
  | TPos(?Int)
}

base class PredefinedTarget() extends Target {
  children =
  | TColumn(next: Bool)
  | TGroup(optNext: ?Bool)
  | TLine(optNext: ?Bool)
}

base class Scroll(index: Int) extends SKStore.File uses Orderable {
  children =
  | Left()
  | Right()

  fun isRight(): Bool
  | Right _ -> true
  | Left _ -> false
}

base class Visible(index: Int, tick: SKStore.Tick) extends SKStore.File {
  children =
  | Pos()
  | Incr()
}

class Part(spaces: Int, word: String)

class Parts(value: Vector<Part>) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Parts _ -> x
    | _ -> invariant_violation("Must be UiInput.Parts")
    }
  }
}

base class Supplier {
  fun getTextProperty(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?Ui.StringProperty;
  fun getPositionProperty(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?Ui.IntProperty;
  fun getSelectionProperty(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?Ui.RangeProperty;
  fun getStatusProperty(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?Ui.StatusProperty;
}

base class Controller {
  fun getKind(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Kind;
  fun isDisabled(context: mutable SKStore.Context): Bool;
  fun isEditable(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Bool;
  fun isWithCounter(context: mutable SKStore.Context): Bool;
  fun isWithStatus(context: mutable SKStore.Context): Bool;
  fun isWithLabel(context: mutable SKStore.Context): Bool;
  fun isWithClear(context: mutable SKStore.Context): Bool;
  fun isAlignRight(context: mutable SKStore.Context): Bool;
  fun isPlaceholderAsLabel(context: mutable SKStore.Context): Bool;

  fun getIcon(context: mutable SKStore.Context, fontSize: Float): ?Ui.Icon;
  fun getFireIcon(context: mutable SKStore.Context, fontSize: Float): ?Ui.Icon;
  fun getTooltip(context: mutable SKStore.Context): ?.Text;
  fun getLabel(context: mutable SKStore.Context): ?.Text;
  fun getPrefix(context: mutable SKStore.Context): ?.Text;
  fun getSuffix(context: mutable SKStore.Context): ?.Text;
  fun getPlaceHolder(context: mutable SKStore.Context): ?.Text;

  fun getMaxChars(context: mutable SKStore.Context): Int;
  fun getVisibleChars(context: mutable SKStore.Context): Int;
  fun getActionMessages(
    context: mutable SKStore.Context,
    value: String,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;
  fun getFocusLostMessages(
    context: mutable SKStore.Context,
    value: String,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;
}

base class State {
  fun getSize(context: mutable SKStore.Context): Int;
  fun isHover(context: mutable SKStore.Context): Bool;
  fun isArmed(context: mutable SKStore.Context): Bool;
  fun getPosition(context: mutable SKStore.Context): Int;
  fun getSelection(
    context: mutable SKStore.Context,
    isUntracker: Bool = false,
  ): ?.Range;
  fun getText(
    context: mutable SKStore.Context,
    isUntracker: Bool = false,
  ): String;
  fun isShowing(mutable SKStore.Context): Bool;
  fun getStatus(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Status;
  fun isMoveSelection(
    context: mutable SKStore.Context,
    isUntracker: Bool = false,
  ): Bool;
  fun isScrolling(context: mutable SKStore.Context): Bool;
  fun isCaretVisible(context: mutable SKStore.Context): Bool;
  fun getTarget(context: mutable SKStore.Context): ?Int;
  fun getScroll(context: mutable SKStore.Context): ?Scroll;
  fun getParts(context: mutable SKStore.Context): Parts;
  fun getEnsureVisible(context: mutable SKStore.Context): ?Visible;

  fun emitHover(context: mutable SKStore.Context, value: Bool): void;
  fun emitArmed(context: mutable SKStore.Context, value: Bool): void;
  fun emitMoveSelection(context: mutable SKStore.Context, value: Bool): void;
  fun emitReset(context: mutable SKStore.Context): void;
  fun emitShowing(context: mutable SKStore.Context, value: Bool): void;
  fun emitDiacritic(context: mutable SKStore.Context, value: Char): void;
  fun emitUnicode(context: mutable SKStore.Context, optValue: ?Int): void;
  fun emitUndo(
    context: mutable SKStore.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;
  fun emitRedo(
    context: mutable SKStore.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;
  fun emitCut(context: mutable SKStore.Context): void;
  fun emitCopy(context: mutable SKStore.Context): void;
  fun emitUpper(context: mutable SKStore.Context): void;
  fun emitLower(context: mutable SKStore.Context): void;
  fun emitPaste(context: mutable SKStore.Context): void;
  fun emitInsert(
    context: mutable SKStore.Context,
    text: String,
    ignoreSelection: Bool,
    optPosition: ?Int,
  ): void;
  fun emitTarget(
    context: mutable SKStore.Context,
    optTarget: ?Int,
    scrolling: Bool,
  ): void;
  fun emitDeleteTo(
    context: mutable SKStore.Context,
    target: Target,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;
  fun emitGoTo(
    context: mutable SKStore.Context,
    target: Target,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;
  fun emitSelectTo(
    context: mutable SKStore.Context,
    target: Target,
    ensureVisible: Bool = true,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;
  fun emitBlinking(context: mutable SKStore.Context, value: Bool): void;
  fun emitScroll(context: mutable SKStore.Context, value: ?Scroll): void;
  fun emitScrolling(context: mutable SKStore.Context, value: Int): void;
  fun emitAll(
    context: mutable SKStore.Context,
    commands: readonly Vector<Command>,
  ): void;
}

class Parameters(controller: Controller, state: State) extends Ui.Parameters {}

base class Storage {
  fun getName(): String;
  fun getScope(): String;

  fun getScrolling(context: mutable SKStore.Context): ?SKStore.Tick;
  fun getTodo(context: mutable SKStore.Context): Ui.Todo;

  fun setHover(context: mutable SKStore.Context, value: Bool): void;
  fun setArmed(context: mutable SKStore.Context, value: Bool): void;
  fun setBlinking(context: mutable SKStore.Context, value: Bool): void;
  fun setScrolling(
    context: mutable SKStore.Context,
    optTick: ?SKStore.Tick,
  ): void;
  fun setVisibility(
    context: mutable SKStore.Context,
    optVisibility: ?Ui.Visibility,
  ): void;
  fun getVisibility(context: mutable SKStore.Context): ?Ui.Visibility;

  fun setShowing(context: mutable SKStore.Context, value: Bool): void;

  fun setMoveSelection(
    context: mutable SKStore.Context,
    moveSelection: Bool,
  ): void;

  fun setTodo(context: mutable SKStore.Context, cmd: Executable): void;
  fun setScroll(context: mutable SKStore.Context, optScroll: ?Scroll): void;
}

class Behavior(
  optCharFilter: ?Char ~> Bool = None(),
  optValidator: ?Vector<Char> ~> Validity = None(),
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Behavior _ -> x
    | _ -> invariant_violation("Must be UiInput.Behavior")
    }
  }
}

base class Kind extends SKStore.File uses Equality {
  children =
  | Text()
  | Password()
  | ASCII()
  | Integer(optMin: ?Int = None(), optMax: ?Int = None())
  | Real()
  | Hex()
  | Octal()
  | Binary()
  | Pattern(pattern: String)
  | Custom(dirName: SKStore.DirName, key: SKStore.StrID)

  fun toBehavior(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Behavior
  | Text _
  | Password _ ->
    Behavior()
  | Integer(optMin, optMax) ->
    Behavior(
      Some(c ~> filterInt(c, optMin)),
      Some(cs ~> validateInteger(cs, optMin, optMax)),
    )
  | ASCII() -> Behavior(Some(Unicode.isASCII))
  | Real() -> Behavior(Some(filterReal), Some(validateReal))
  | Hex() -> Behavior(Some(Chars.isHexDigit))
  | Octal() -> Behavior(Some(Chars.isOctalDigit))
  | Binary() -> Behavior(Some(c ~> c == '0' || c == '1'))
  | Pattern(pattern) ->
    !pattern = if (pattern.startsWith("^")) pattern else `^${pattern}`;
    !pattern = if (pattern.endsWith("$")) pattern else `${pattern}$`;
    fPattern = pattern;
    Behavior(
      None(),
      Some(vc ~>
        if (RegExp.test(vc.toArray(), fPattern)) Valid() else {
          KO(Some(!"Text don't match pattern."))
        }
      ),
    )
  | Custom(dirName, key) ->
    SKStore.HValue(
      SKStore.EHandle(SKStore.StrID::keyType, Behavior::type, dirName),
      key,
    ).get(context, isUntracked)
}

mutable class Verifier(
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  source: Int,
) {
  mutable fun writePosition(pos: Int): void {
    setPosition(this.values, pos, this.source);
  }

  mutable fun writeText(text: String): void {
    setText(this.values, text, this.source);
  }

  mutable fun writeSelection(optRange: ?Range): void {
    setSelection(this.values, optRange, this.source)
  }

  mutable fun writeEnsureVisible(visible: Visible): void {
    this.values.set(Ui.ensureVisibleProp, Some(visible));
  }

  mutable fun writeUserStatus(status: Status): void {
    setUserStatus(this.values, status, this.source);
  }
}

base class Undoable() {
  fun undo(verifier: mutable Verifier, tick: SKStore.Tick): void;
  fun redo(verifier: mutable Verifier, tick: SKStore.Tick): void;
}

class LamUndoable(
  lamUndo: (mutable Verifier, SKStore.Tick) ~> void,
  lamRedo: (mutable Verifier, SKStore.Tick) ~> void,
) extends Undoable {
  fun undo(verifier: mutable Verifier, tick: SKStore.Tick): void {
    this.lamUndo(verifier, tick)
  }
  fun redo(verifier: mutable Verifier, tick: SKStore.Tick): void {
    this.lamRedo(verifier, tick)
  }
}

class History(
  index: Int = -1,
  undoables: Array<Undoable> = Array[],
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ History _ -> x
    | _ -> invariant_violation("Must be UiInput.History")
    }
  }

  fun undo(verifier: mutable Verifier, tick: SKStore.Tick): (History, Bool) {
    this.undoables.maybeGet(this.index) match {
    | Some(undoable) ->
      undoable.undo(verifier, tick);
      !this.index = Math.max(this.index - 1, -1);
      (this, true)
    | _ -> (this, false)
    }
  }

  fun redo(verifier: mutable Verifier, tick: SKStore.Tick): (History, Bool) {
    this.undoables.maybeGet(this.index + 1) match {
    | Some(undoable) ->
      undoable.redo(verifier, tick);
      !this.index = Math.min(this.index + 1, this.undoables.size());
      (this, true)
    | _ -> (this, false)
    }
  }

  fun add(undoable: Undoable): History {
    undoables = if (this.index < this.undoables.size() - 1) {
      Vector::mcreateFromItems(this.undoables.slice(0, this.index + 1));
    } else {
      Vector::mcreateFromItems(this.undoables)
    };
    undoables.push(undoable);
    History(undoables.size() - 1, undoables.toArray())
  }
}

module end;
