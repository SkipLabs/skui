module UiMonospace;

class Layout protected {
  widgets: Ui.WidgetsCollection,
} extends Ui.StrictWidget uses Ui.WithNodeCache, FWK.NoFocusHandler {
  //
  type Params = LayoutParameters;
  type Buffer = Ui.NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Ui.Path,
    params: LayoutParameters,
    cache: Ui.NodeCache,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static{
      path,
      widgets => params.widgets,
      cache,
      optConfiguration,
      tick => context.getTick(),
    }
  }

  fun getViewportDefinition(
    _context: mutable SKStore.Context,
  ): ?Ui.ViewportDef {
    None()
  }

  protected fun getWidgets(context: mutable SKStore.Context): Array<Ui.Widget> {
    this.widgets.all(context)
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: Ui.BoxConstraints,
  ): Ui.Node {
    width = 0.0;
    height = 0.0;
    cns = this.widgets.all(context).map(line -> {
      top = height;
      node = line.getNode(context, constraints);
      !height = height + node.size.height;
      !width = Math.max(width, node.size.width);
      Ui.CNode(node, Geometry.Offset(0.0, top), constraints);
    });
    Ui.Node(this, Geometry.Size(width, height), cns)
  }
}

module end;
