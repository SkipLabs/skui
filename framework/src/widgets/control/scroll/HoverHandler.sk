module UiScroll;

class HoverHandler(
  path: Ui.Path,
  controller: Controller,
  sizesHdl: SKStore.Handle<SKStore.IID, UiScroll.Sizes>,
) extends Ui.HoverHandlerWrapper {
  //
  fun getIdentifier(): Ui.Path {
    this.path
  }

  protected fun onEnter(_context: mutable SKStore.Context): void {
    void
  }

  protected fun onMouse(
    context: mutable SKStore.Context,
    mouse: UiEvent.MouseFile,
  ): FWK.Result {
    wheel = mouse.getWheelValue(context.getTick());
    FWK.Result(
      if (wheel != 0) {
        incr = Math.sign(-wheel).toInt();
        unit = this.controller.getUnit(context, false);
        if (FWK.isShiftDown(context, true)) {
          hScroll = this.controller.getHScroll(context, true);
          this.sizesHdl.maybeGetValue(context, SKStore.IID(0), true)
            .map(hSizes -> {
              hScroll.set(
                context,
                Some(hSizes.clamp(hScroll.get(context, true) + (incr * unit))),
                0,
              );
              true
            })
            .default(false)
        } else {
          vScroll = this.controller.getVScroll(context, true);
          this.sizesHdl.maybeGetValue(context, SKStore.IID(1), true)
            .map(vSizes -> {
              vScroll.set(
                context,
                Some(vSizes.clamp(vScroll.get(context, true) + (incr * unit))),
                0,
              );
              true
            })
            .default(false)
        };
      } else {
        false
      },
    );
  }

  protected fun onExit(_context: mutable SKStore.Context): void {
    void
  }
}

module end;
