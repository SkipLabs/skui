module UiSplit;

class LamController{
  first: Ui.Getter<Ui.Widget>,
  second: Ui.Getter<Ui.Widget>,
  axis: Ui.GetterOne<Ui.Axis, Bool>,
  separation: Ui.GetterOne<Ui.SeparationProperty, Bool>,
} extends Controller {
  fun getAxis(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Ui.Axis {
    this.axis(context, isUntracked)
  }

  fun getSeparation(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Ui.SeparationProperty {
    this.separation(context, isUntracked)
  }

  fun getFirstWidget(context: mutable SKStore.Context): Ui.Widget {
    this.first(context)
  }

  fun getSecondWidget(context: mutable SKStore.Context): Ui.Widget {
    this.second(context)
  }
}

module end;
