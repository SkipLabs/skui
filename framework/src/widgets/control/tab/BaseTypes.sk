module UiTab;

const padding: Float = 16.0;
const closeIconSize: Float = 16.0;

class Icon(icon: Ui.Icon, onTop: Bool)

base class Mode uses Orderable {
  children =
  | Basic()
  | Flat()

  static fun all(): Array<Mode> {
    Array[Basic(), Flat()]
  }

  fun toCode(): Int
  | Basic() -> 0
  | Flat() -> 1

  static fun fromCode(code: Int): Mode {
    code match {
    | 1 -> Flat()
    | 0
    | _ ->
      Basic()
    }
  }

  fun toString(): String
  | Basic() -> "Basic"
  | Flat() -> "Flat"
}

base class Controller extends SKStore.UserData, SKStore.File {
  fun isDisabled(context: mutable SKStore.Context): Bool;
  fun isActive(context: mutable SKStore.Context): Bool;
  fun isSelected(context: mutable SKStore.Context): Bool;
  fun isClosable(context: mutable SKStore.Context): Bool;
  fun isPinned(context: mutable SKStore.Context): Bool;
  fun getText(context: mutable SKStore.Context): ?Text;
  fun getSide(context: mutable SKStore.Context): .UiSide;
  fun getIcon(context: mutable SKStore.Context, fontSize: Float): ?Icon;
  fun getMode(context: mutable SKStore.Context): Mode;
  fun getDiscriminant(context: mutable SKStore.Context): ?Text;
  fun getTooltip(context: mutable SKStore.Context): ?Text;
  fun getBadge(context: mutable SKStore.Context): ?Ui.Badge;
  fun getProgress(context: mutable SKStore.Context): ?Ui.Progress;
  fun onFire(context: mutable SKStore.Context): void;
  fun onClose(context: mutable SKStore.Context): void;
  fun onDrop(
    context: mutable SKStore.Context,
    source: String,
    destination: String,
    before: Bool,
  ): void;
}

base class State {
  fun getArmed(context: mutable SKStore.Context): ?Bool;
  fun getHover(context: mutable SKStore.Context): ?Bool;
  fun getIndeterminate(context: mutable SKStore.Context): ?Int;
  fun getTargeted(context: mutable SKStore.Context): ?Ui.Drop;

  fun setArmed(
    context: mutable SKStore.Context,
    close: Bool,
    value: Bool,
  ): void;
  fun setHover(
    context: mutable SKStore.Context,
    close: Bool,
    value: Bool,
  ): void;
  fun setTargeted(context: mutable SKStore.Context, optDrop: ?Ui.Drop): void;

  fun emitIndeterminate(context: mutable SKStore.Context, value: Int): void;
}

base class Storage {
  fun getName(): String;
  fun getScope(): String;

  fun setIndeterminate(context: mutable SKStore.Context, optValue: ?Int): void;
}

class Parameters(
  reference: Ui.Path,
  controller: Controller,
  state: State,
) extends Ui.Parameters {}

class Layout(
  optLabel: ?(String, Geometry.Size, Font.FaceID),
  optBadge: ?(String, Geometry.Size, Font.FaceID),
  optDiscriminant: ?(String, Geometry.Size, Font.FaceID),
  optIcon: ?(Ui.Icon, Geometry.Size, Bool),
  closable: Bool,
  vertical: Bool,
  iconTextGap: Float,
) extends Ui.UserData {
  //
  fun computeSize(): Geometry.Size {
    bWidth = this.optBadge.map(badge ->
      if (badge.i0.isBlank()) {
        8.0
      } else {
        badge.i1.width
      }
    ).default(0.0);
    (width, height) = this.optLabel match {
    | Some((_, tSize, _)) ->
      tWidth = tSize.width;
      tHeight = tSize.height;
      (width, height) = this.optIcon match {
      | Some((_, iSize, onTop)) ->
        if (onTop) {
          (
            Math.max(tWidth, iSize.width + 2.0 * bWidth),
            tHeight + iSize.height + this.iconTextGap,
          )
        } else {
          (
            tWidth + bWidth + iSize.width + this.iconTextGap,
            Math.max(tHeight, iSize.height),
          )
        }
      | _ -> (tWidth + bWidth, tHeight)
      };
      this.optDiscriminant.each(d ->
        !height = height + d.i1.height.toFloat() + this.iconTextGap
      );
      if (this.closable) !width = width + this.iconTextGap + closeIconSize;
      (width, height)
    | _ ->
      this.optIcon match {
      | Some((_, iSize, _)) ->
        width = iSize.width + 2.0 * bWidth;
        if (this.closable) !width = width + this.iconTextGap + closeIconSize;
        (width, iSize.height)
      | _ -> invariant_violation("Tab must have almost a text or an icon.")
      }
    };
    Geometry.Size(width + 2.0 * padding, height + 2.0 * padding)
  }
}

module end;
