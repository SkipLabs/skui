module UiTab;

class LamController{
  disabled: mutable SKStore.Context ~> Bool = _ctx ~> false,
  active: mutable SKStore.Context ~> Bool = _ctx ~> false,
  selected: mutable SKStore.Context ~> Bool = _ctx ~> false,
  closable: mutable SKStore.Context ~> Bool = _ctx ~> false,
  pinned: mutable SKStore.Context ~> Bool = _ctx ~> false,
  text: mutable SKStore.Context ~> ?Text = _ctx ~> None(),
  side: mutable SKStore.Context ~> .UiSide = _ctx ~> UiSide.Top(),
  icon: (mutable SKStore.Context, Float) ~> ?Icon = (_ctx, _fs) ~> None(),
  mode: mutable SKStore.Context ~> Mode = _ctx ~> Basic(),
  discriminant: mutable SKStore.Context ~> ?Text = _ctx ~> None(),
  tooltip: mutable SKStore.Context ~> ?Text = _ctx ~> None(),
  badge: mutable SKStore.Context ~> ?Ui.Badge = _ctx ~> None(),
  progress: mutable SKStore.Context ~> ?Ui.Progress = _ctx ~> None(),
  fire: mutable SKStore.Context ~> void = _ctx ~> void,
  close: mutable SKStore.Context ~> void = _ctx ~> void,
  drop: (mutable SKStore.Context, String, String, Bool) ~> void = (
    _ctx,
    _src,
    _dst,
    _b,
  ) ~>
    void,
} extends Controller {
  //
  fun isDisabled(context: mutable SKStore.Context): Bool {
    this.disabled(context)
  }

  fun isActive(context: mutable SKStore.Context): Bool {
    this.active(context)
  }

  fun isSelected(context: mutable SKStore.Context): Bool {
    this.selected(context)
  }

  fun isClosable(context: mutable SKStore.Context): Bool {
    this.closable(context)
  }

  fun isPinned(context: mutable SKStore.Context): Bool {
    this.pinned(context)
  }

  fun getText(context: mutable SKStore.Context): ?Text {
    this.text(context)
  }

  fun getIcon(context: mutable SKStore.Context, fontSize: Float): ?Icon {
    this.icon(context, fontSize)
  }

  fun getSide(context: mutable SKStore.Context): .UiSide {
    this.side(context)
  }

  fun getMode(context: mutable SKStore.Context): Mode {
    this.mode(context)
  }

  fun getDiscriminant(context: mutable SKStore.Context): ?Text {
    this.discriminant(context)
  }

  fun getTooltip(context: mutable SKStore.Context): ?Text {
    this.tooltip(context)
  }

  fun getBadge(context: mutable SKStore.Context): ?Ui.Badge {
    this.badge(context)
  }

  fun getProgress(context: mutable SKStore.Context): ?Ui.Progress {
    this.progress(context)
  }

  fun onFire(context: mutable SKStore.Context): void {
    this.fire(context)
  }

  fun onClose(context: mutable SKStore.Context): void {
    this.close(context)
  }

  fun onDrop(
    context: mutable SKStore.Context,
    source: String,
    destination: String,
    before: Bool,
  ): void {
    this.drop(context, source, destination, before)
  }
}

module end;
