module UiTab;

class HoverHandler(
  path: Ui.Path,
  controller: Controller,
  state: State,
  close: Bool,
) extends FWK.HoverHandler {
  fun getIdentifier(): Ui.Path {
    if (this.close) this.path.makeChild("close") else this.path;
  }

  fun enter(context: mutable SKStore.Context): void {
    if (!this.controller.isDisabled(context)) {
      this.state.setHover(context, this.close, true);
      FWKPointer.setCursor(context, Ui.HandCursor());
    };
  }

  fun manage(
    context: mutable SKStore.Context,
    mouse: UiEvent.MouseFile,
    _optPrevious: ?FWK.HoverHandler,
  ): FWK.Result {
    if (this.controller.isDisabled(context)) {
      return FWK.Result(false)
    };
    FWK.Result(
      if (mouse.isPrimaryPressed(context.getTick())) {
        SystemProperties.setRequireFocus(context, this.path);
        this.state.setArmed(context, this.close, true);
        true
      } else if (
        mouse.isPrimaryReleased(context.getTick()) &&
        this.state.getArmed(context) == Some(this.close)
      ) {
        this.state.setArmed(context, this.close, false);
        if (this.close) {
          this.controller.onClose(context)
        } else {
          this.controller.onFire(context)
        };
        true
      } else {
        false
      },
    )
  }

  fun exit(context: mutable SKStore.Context): void {
    FWKPointer.resetCursor(context);
    this.state.setArmed(context, this.close, false);
    this.state.setHover(context, this.close, false);
  }

  fun getTooltip(context: mutable SKStore.Context): ?FWK.SourcedWidget {
    if (!this.close) {
      Ui.buildTooltip(context, this.path, this.controller.getTooltip)
    } else {
      None()
    }
  }
}

module end;
