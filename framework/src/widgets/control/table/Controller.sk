module UiTable;

class LamController{
  columns: Ui.Getter<Array<Column>>,
  rows: Ui.Getter<Array<Row>>,
  columnWidth: Ui.GetterOne<Width, String>,
  showCheckboxes: Ui.Getter<Bool> = Ui.default(true),
  showOddEven: Ui.Getter<Bool> = Ui.default(true),
  rowHeight: Ui.GetterOne<Float, Bool> = Ui.defaultOne(52.0),
  headerHeight: Ui.GetterOne<Float, Bool> = Ui.defaultOne(56.0),
  selectionModel: Ui.GetterOne<SelectionModel, Bool> = Ui.defaultOne(
    Multiple(),
  ),
  progress: Ui.Getter<?Ui.Progress> = Ui.default(None()),
  rowProgress: Ui.GetterOne<?Ui.Progress, String> = Ui.defaultOne(None()),
  placeHolder: Ui.Getter<Text> = Ui.default(!"No content in table."),
  gridPolicy: Ui.Getter<GridPolicy> = Ui.default(Horizontal()),
  columnOrder: Ui.GetterOne<?Order, String> = Ui.defaultOne(None()),
  contextMenuItems: Ui.GetterTwo<
    Array<UiDropdown.Item>,
    ?String,
    Array<String>,
  > = Ui.defaultTwo(Array[]),
  selectionChange: Ui.GetterTwo<
    Array<SKUIMessage.Message>,
    Array<String>,
    Bool,
  > = Ui.defaultTwo(Array[]),
  fire: Ui.GetterThree<
    Array<SKUIMessage.Message>,
    ?String,
    Array<String>,
    Bool,
  > = Ui.defaultThree(Array[]),
  sort: Ui.GetterThree<
    Array<SKUIMessage.Message>,
    String,
    Sort,
    Bool,
  > = Ui.defaultThree(Array[]),
} extends Controller {
  //
  fun getColumns(context: mutable SKStore.Context): Array<Column> {
    this.columns(context)
  }

  fun getRows(context: mutable SKStore.Context): Array<Row> {
    this.rows(context)
  }

  fun getColumnWidth(context: mutable SKStore.Context, column: String): Width {
    this.columnWidth(context, column)
  }

  fun isShowCheckboxes(context: mutable SKStore.Context): Bool {
    this.showCheckboxes(context)
  }

  fun isShowOddEven(context: mutable SKStore.Context): Bool {
    this.showOddEven(context)
  }

  fun getSelectionModel(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): SelectionModel {
    this.selectionModel(context, isUntracked)
  }

  fun getProgress(context: mutable SKStore.Context): ?Ui.Progress {
    this.progress(context)
  }

  fun getRowProgress(
    context: mutable SKStore.Context,
    row: String,
  ): ?Ui.Progress {
    this.rowProgress(context, row)
  }

  fun getPlaceHolder(context: mutable SKStore.Context): Text {
    this.placeHolder(context)
  }

  fun getGridPolicy(context: mutable SKStore.Context): GridPolicy {
    this.gridPolicy(context)
  }

  fun getColumnOrder(context: mutable SKStore.Context, column: String): ?Order {
    this.columnOrder(context, column)
  }

  fun getRowHeight(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Float {
    this.rowHeight(context, isUntracked)
  }

  fun getHeaderHeight(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Float {
    this.headerHeight(context, isUntracked)
  }

  fun getContextMenuItems(
    context: mutable SKStore.Context,
    optCurrent: ?String,
    selections: Array<String>,
  ): Array<UiDropdown.Item> {
    this.contextMenuItems(context, optCurrent, selections)
  }

  fun getSelectionChangeMessages(
    context: mutable SKStore.Context,
    selections: Array<String>,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.selectionChange(context, selections, isUntracked)
  }

  fun getFireMessages(
    context: mutable SKStore.Context,
    optCurrent: ?String,
    selections: Array<String>,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.fire(context, optCurrent, selections, isUntracked)
  }

  fun getSortMessages(
    context: mutable SKStore.Context,
    column: String,
    sort: Sort,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.sort(context, column, sort, isUntracked)
  }
}

module end;
