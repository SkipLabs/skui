module UiTableRow;

class LamController{
  widths: Ui.GetterOne<Array<Float>, Bool>,
  height: Ui.GetterOne<Float, Bool>,
  cells: Ui.Getter<Array<Ui.TableCell>>,
  selected: Ui.Getter<Bool> = Ui.default(false),
  hover: Ui.Getter<Bool> = Ui.default(false),
  separators: Ui.Getter<Bool> = Ui.default(false),
  highlighted: Ui.Getter<Bool> = Ui.default(false),
} extends Controller {
  //
  fun getWidths(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Array<Float> {
    this.widths(context, isUntracked)
  }

  fun getHeight(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Float {
    this.height(context, isUntracked)
  }

  fun getCells(context: mutable SKStore.Context): Array<Ui.TableCell> {
    this.cells(context)
  }

  fun isSelected(context: mutable SKStore.Context): Bool {
    this.selected(context)
  }

  fun isHover(context: mutable SKStore.Context): Bool {
    this.hover(context)
  }

  fun isHighlighted(context: mutable SKStore.Context): Bool {
    this.highlighted(context)
  }

  fun hasSeparators(context: mutable SKStore.Context): Bool {
    this.separators(context)
  }
}

module end;
