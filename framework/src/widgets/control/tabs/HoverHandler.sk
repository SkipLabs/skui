module UiTabs;

class HoverHandler(tabs: Ui.Tabs) extends Ui.HoverHandlerWrapper {
  //
  fun getIdentifier(): Ui.Path {
    this.tabs.path
  }

  protected fun isParentBefore(): Bool {
    false
  }

  protected fun onMouse(
    _context: mutable SKStore.Context,
    _mouse: UiEvent.MouseFile,
  ): FWK.Result {
    FWK.Result(false)
  }

  fun getDropdown(_context: mutable SKStore.Context): ?FWK.SourcedWidget {
    (getHoverHandlerLeaf(Some(this)) match {
    | Some(hh) ->
      hh match {
      | thh @ UiTab.HoverHandler _ -> Some(thh)
      | _ -> None()
      }
    | _ -> None()
    }) match {
    | Some(thh) ->
      Some(
        FWK.SourcedWidget(Some(thh.path), (ctx, root) ~> {
          items = mutable Vector[
            if (!thh.controller.isPinned(ctx)) {
              UiDropdown.Item{
                id => "pin",
                text => _ctx ~> !"Pin",
                separator => _ctx ~> Ui.Both(),
                perform => ctx ~> this.tabs.state.pin(ctx, thh.path.id, true),
              }
            } else {
              UiDropdown.Item{
                id => "unpin",
                text => _ctx ~> !"Unpin",
                separator => _ctx ~> Ui.Both(),
                perform => ctx ~> this.tabs.state.pin(ctx, thh.path.id, false),
              }
            },
          ];
          closableInfo = this.tabs.state.getClosableInfo(
            ctx,
            Some(thh.path.id),
          );
          if (!closableInfo.closables.isEmpty()) {
            items.push(
              UiDropdown.Item{
                id => "close",
                text => _ctx ~> !"Close",
                shortcut => ctx ~>
                  if (thh.controller.isActive(ctx)) {
                    Some(Ui.Shortcut("F4", true, false, false))
                  } else {
                    None()
                  },
                separator => _ctx ~> Ui.Both(),
                perform => ctx ~>
                  this.tabs.controller.onClose(ctx, Array[thh.path.id]),
                disabled => ctx ~> !thh.controller.isClosable(ctx),
              },
            );
            items.push(
              UiDropdown.Item{
                id => "closeOthers",
                text => _ctx ~> !"Close others",
                disabled => _ctx ~>
                  closableInfo.right.isEmpty() && closableInfo.left.isEmpty(),
                perform => ctx ~>
                  this.tabs.controller.onClose(
                    ctx,
                    Arrays.merge(closableInfo.right, closableInfo.left),
                  ),
              },
            );
            items.push(
              UiDropdown.Item{
                id => "closeToTheRight",
                text => _ctx ~> !"Close to the right",
                disabled => _ctx ~> closableInfo.right.isEmpty(),
                perform => ctx ~>
                  this.tabs.controller.onClose(ctx, closableInfo.right),
              },
            );
            items.push(
              UiDropdown.Item{
                id => "closeToTheLeft",
                text => _ctx ~> !"Close to the left",
                disabled => _ctx ~> closableInfo.left.isEmpty(),
                perform => ctx ~>
                  this.tabs.controller.onClose(ctx, closableInfo.left),
              },
            );
            items.push(
              UiDropdown.Item{
                id => "closeAll",
                text => _ctx ~> !"Close all",
                separator => _ctx ~> Ui.After(),
                perform => ctx ~>
                  this.tabs.controller.onClose(ctx, closableInfo.closables),
              },
            );
          };
          Some(
            root.buildDropdown(
              ctx,
              thh.path.makeChild("@tabsContextMenu"),
              items.toArray(),
            ),
          )
        }),
      )
    | _ ->
      Some(
        FWK.SourcedWidget(Some(this.tabs.path), (ctx, root) ~> {
          closableInfo = this.tabs.state.getClosableInfo(ctx, None());
          if (!closableInfo.closables.isEmpty()) {
            items = Array[
              UiDropdown.Item{
                id => "closeAll",
                text => _ctx ~> !"Close all",
                separator => _ctx ~> Ui.After(),
                perform => ctx ~>
                  this.tabs.controller.onClose(ctx, closableInfo.closables),
              },
            ];
            Some(
              root.buildDropdown(
                ctx,
                this.tabs.path.makeChild("@tabsContextMenu"),
                items,
              ),
            )
          } else {
            None()
          }
        }),
      )
    }
  }
}

fun getHoverHandlerLeaf(optHoverHandler: ?FWK.HoverHandler): ?FWK.HoverHandler {
  optHoverHandler match {
  | Some(hh) ->
    hh match {
    | hhw @ Ui.HoverHandlerWrapper _ -> getHoverHandlerLeaf(hhw.optHoverHandler)
    | _ -> Some(hh)
    }
  | _ -> None()
  }
}

module end;
