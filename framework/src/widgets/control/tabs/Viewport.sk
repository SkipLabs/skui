module UiTabs;

class Viewport{
  scroll: Ui.TabsSc,
} extends Ui.Widget uses FWK.NoFocusHandler, Ui.NoViewports {
  //
  fun getNode(
    context: mutable SKStore.Context,
    constraints: Ui.BoxConstraints,
  ): Ui.Node {
    child = this.scroll.viewportChild(context, constraints);
    Ui.Node::create(this, child.node.size, Array[child])
  }
}

module end;
