module UiTabsSc;

fun widgetDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/tabs/viewport/widget/")
}

fun verifiedMetricsDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/tabs/scroll/metrics/verified/")
}

fun computedMetricsDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/tabs/scroll/metrics/computed/")
}

const space: Float = 16.0;

base class Target extends SKStore.File uses Orderable, Show {
  children =
  | Index(value: Int)

  fun toString(): String
  | Before() -> "Before"
  | After() -> "After"
  | Index(value) -> `Index[${value}]`

  fun asHover(): Hover
  | Before() -> Before()
  | After() -> After()
  | Index _ -> invariant_violation("UiTabsSc.Index is not UiTabsSc.Hover.")
}

base class Hover extends Target {
  children =
  | Before()
  | After()
}

base class Controller extends Ui.WidgetsCollection {
  fun getDirection(context: mutable SKStore.Context): Ui.Axis;
  fun getVisibleSource(context: mutable SKStore.Context): ?Ui.Visible;
  fun getDropMessages(
    context: mutable SKStore.Context,
    source: String,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;
}

base class State extends Ui.StateWithScroll {
  fun getHover(context: mutable SKStore.Context): ?Hover;
  fun isScrolling(context: mutable SKStore.Context): Bool;
  fun emitHover(context: mutable SKStore.Context, value: ?Hover): void;
  fun emitGoTo(
    context: mutable SKStore.Context,
    value: Target,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;
}

class Parameters(
  reference: Ui.Path,
  controller: Controller,
  state: State,
) extends Ui.Parameters

base class Storage extends Ui.StorageWithScroll {
  fun getName(): String;
  fun getScope(): String;

  fun setTodo(context: mutable SKStore.Context, cmd: Executable): void;
  fun setHover(context: mutable SKStore.Context, optHover: ?Hover): void;
}

module end;
