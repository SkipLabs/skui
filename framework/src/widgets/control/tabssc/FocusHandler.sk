module UiTabsSc;

class FocusHandler{
  scroll: Ui.TabsSc,
  index: Int,
} extends Ui.FocusHandlerWrapper uses FWK.OnlyShortcuts {
  //
  protected fun getMainIdentifier(): Ui.Path {
    this.scroll.path;
  }

  protected fun getShortcuts(
    _context: mutable SKStore.Context,
  ): Array<FWK.ShortcutAction> {
    Array[]
  }

  protected fun onEnter(context: mutable SKStore.Context): Bool {
    this.scroll.state.emitGoTo(context, Index(this.index));
    true
  }
}

module end;
