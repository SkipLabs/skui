module UiToggle;

const statePath: String = "ui/toggle/state";

class HStorage(handle: SKStore.INotTyped) extends Storage {
  //
  static fun forScope(context: mutable SKStore.Context, scope: String): ?this {
    hdl = SKStore.IHandle::notTyped(SKStore.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(hdl)) else None()
  }

  fun setArmed(context: mutable SKStore.Context, value: Bool): void {
    this.handle.write(context, Ui.armedProp, SKStore.BoolFile(value))
  }

  fun setHover(context: mutable SKStore.Context, value: Bool): void {
    this.handle.write(context, Ui.hoverProp, SKStore.BoolFile(value))
  }
}

class HState(handle: SKStore.NotTyped) extends State {
  //
  fun isArmed(context: mutable SKStore.Context): Bool {
    this.handle.getBool(context, Ui.armedProp)
  }

  fun isHover(context: mutable SKStore.Context): Bool {
    this.handle.getBool(context, Ui.hoverProp)
  }

  fun emitArmed(context: mutable SKStore.Context, value: Bool): void {
    this.emit(context, SetArmed(value))
  }

  fun emitHover(context: mutable SKStore.Context, value: Bool): void {
    this.emit(context, SetHover(value))
  }

  fun emitAll(
    context: mutable SKStore.Context,
    armed: Bool,
    hover: Bool,
  ): void {
    this.emit(context, Multiple(Array[SetArmed(armed), SetHover(hover)]))
  }

  private fun emit(
    context: mutable SKStore.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(
      context,
      statePath,
      this.handle.dirName.toString(),
      command,
    );
  }
}

fun init(context: mutable SKStore.Context, path: Ui.Path): State {
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeNotTyped(dirName, Array[]);
  HState(stateHdl)
}

module end;
