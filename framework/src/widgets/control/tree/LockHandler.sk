module UiTree;

class LockHandler(tree: Ui.Tree) extends FWK.LockHandler {
  //
  fun update(
    context: mutable SKStore.Context,
    mouse: UiEvent.MouseFile,
  ): ?FWK.LockHandler {
    if (!mouse.isPrimaryDown(context.getTick())) {
      None()
    } else {
      FWKPipeline.gNodeInfo.maybeGetValue(
        context,
        this.tree.path,
        true,
      ).flatMap(nodeInfo ->
        nodeInfo.info.optUserData
          .map(v ~> v as Metrics _)
          .map(m -> {
            height = nodeInfo.info.size().height;
            wOffset = nodeInfo.info.getWindowOffset(context, true, true);
            offset = mouse.offset() - wOffset;
            sheight = m.axis.unity * height / m.axis.main;
            pointed = (offset.dy / sheight).toInt();
            before = m.axis.visibleCount / 2;
            after = m.axis.visibleCount - before;
            start = Math.max(pointed - before, 0);
            end = Math.min(pointed + after, m.axis.count);
            if (start < m.axis.range.start) {
              this.tree.state.emitVisible(context, start);
            } else if (start > m.axis.range.start && end > m.axis.range.end) {
              this.tree.state.emitVisible(context, end);
            };
            this
          })
      )
    }
  }
}

module end;
