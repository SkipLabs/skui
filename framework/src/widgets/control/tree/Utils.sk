module UiTree;

fun itemsDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/tree/items/")
}

fun widgetDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/tree/widget/")
}

class MainKey() extends SKStore.Key {
  //
  static fun keyType(obj: SKStore.Key): this {
    obj match {
    | x @ MainKey _ -> x
    | _ -> SKStore.cast_violation("UiTree.MainKey", obj)
    }
  }

  fun toString(): String {
    this.getClassName()
  }
}

class ItemKey(path: Ui.Path, info: Int) extends SKStore.Key {
  //
  fun toString(): String {
    `${this.info}:${this.path}`
  }

  fun compare(other: SKStore.Key): Order {
    other match {
    | oKey @ ItemKey _ -> (this.info, this.path).compare((oKey.info, oKey.path))
    | _ -> this.getClassName().compare(other.getClassName())
    }
  }
}

fun create(
  context: mutable SKStore.Context,
  path: Ui.Path,
  allItemsDirName: SKStore.DirName,
  controller: Controller,
  expansion: Ui.GetterOne<Bool, Ui.Path>,
): (
  Ui.ListHandle<ItemFile>,
  Ui.Getter<Int>,
  Ui.GetterOne<?Ui.Progress, Ui.Path>,
  Ui.GetterOne<?Ui.Badge, Ui.Path>,
) {
  mainHdl = context.makeDir(
    Ui.MainKey::keyType,
    SKStore.IntFile::type,
    itemsDirName(path.makeChild("source")),
    Array<(SKStore.Key, SKStore.File)>[(Ui.MainKey(), SKStore.IntFile(0))],
  );
  itemsHdl = mainHdl.map(
    k ~> k,
    f ~> f,
    context,
    allItemsDirName,
    (context, writer, _key, _it) ~> {
      allItems = mutable Vector<ItemKey>[];
      fillItem(context, controller, expansion, allItems);
      writer.set(SKStore.KKeys(), SKStore.Keys(allItems.toArray()));
      writer.set(SKStore.KSize(), SKStore.IntFile(allItems.size()))
    },
  );
  visibleItemsHdl = itemsHdl
    .map(
      ItemKey::keyType,
      SKStore.IntFile::type,
      context,
      itemsDirName(path.makeChild("visible")),
      (context, writer, key, it) ~> {
        if (key == SKStore.KKeys()) {
          keys = SKStore.Keys::type(it.first).value;
          if (FWKPipeline.hasNodeInfos(context)) {
            FWKPipeline.gNodeInfo.maybeGetValue(context, path).each(ni ->
              ni.info.optUserData
                .map(ud ~> ud as Metrics _)
                .each(metrics ->
                  for (idx in metrics.axis.range) {
                    keys.maybeGet(idx).each(k ->
                      writer.set(ItemKey::keyType(k), SKStore.IntFile(0))
                    )
                  }
                )
            )
          }
        };
      },
    )
    .map(
      Ui.Path::keyType,
      ItemFile::type,
      context,
      itemsDirName(path),
      (context, writer, key, _) ~> {
        writer.set(
          key.path,
          ItemFile(controller.getItem(context, key.path), key.info),
        )
      },
    );
  progressHdl = visibleItemsHdl.map(
    Ui.Path::keyType,
    Ui.Progress::btype,
    context,
    itemsDirName(path.makeChild("progress")),
    (context, writer, path, _) ~> {
      controller.getProgress(context, path).each(progress ->
        writer.set(path, progress)
      )
    },
  );
  badgeHdl = visibleItemsHdl.map(
    Ui.Path::keyType,
    Ui.Badge::type,
    context,
    itemsDirName(path.makeChild("badge")),
    (context, writer, path, _) ~> {
      controller.getBadge(context, path).each(text ->
        writer.set(path, Ui.Badge(text, controller.getBadgeMaxChar(context)))
      )
    },
  );
  visibleItemsList = Ui.ListHandle(
    visibleItemsHdl
      .map(
        k ~> k,
        f ~> f,
        context,
        itemsDirName(path.makeChild("grouped")),
        (_, writer, key, it) ~> {
          writer.set(SKStore.KKeys(), key);
          writer.set(key, it.first);
        },
      )
      .map(
        k ~> k,
        f ~> f,
        context,
        itemsDirName(path.makeChild("joined")),
        (context, writer, key, it) ~> {
          files = it.toArray();
          if (key == SKStore.KKeys()) {
            items = SKStore.Keys::type(itemsHdl.get(context, SKStore.KKeys()))
              .value.map(ItemKey::keyType)
              .map(i -> i.path);
            set = SortedSet::createFromItems(files.map(Ui.Path::type));
            writer.set(
              SKStore.KKeys(),
              SKStore.Keys(items.filter(set.contains)),
            );
            writer.set(SKStore.KSize(), SKStore.IntFile(files.size()))
          } else {
            writer.setArray(key, files);
          }
        },
      ),
    ItemFile::type,
  );
  (
    visibleItemsList,
    ctx ~> itemsHdl.getInt(ctx, SKStore.KSize()),
    (ctx, path) ~> progressHdl.maybeGetValue(ctx, path),
    (ctx, path) ~> badgeHdl.maybeGetValue(ctx, path),
  )
}

fun fillItem(
  context: mutable SKStore.Context,
  controller: Controller,
  expansion: Ui.GetterOne<Bool, Ui.Path>,
  allItems: mutable Vector<ItemKey>,
  optParent: ?Ui.Path = None(),
  depth: Int = 0,
): void {
  controller.getItems(context, optParent).each(items ->
    for (item in items) {
      path = Ui.Path(item, optParent);
      allItems.push(ItemKey(path, depth));
      if (expansion(context, path)) {
        fillItem(
          context,
          controller,
          expansion,
          allItems,
          Some(path),
          depth + 1,
        )
      }
    }
  )
}

module end;
