module UiRoot;

const statePath: String = "ui/root/state";

base class Storage {
  fun closeMenu(context: mutable SKStore.Context): void;
  fun setShownTooltip(context: mutable SKStore.Context, id: String): void;
  fun isMenuClosed(context: mutable SKStore.Context): Bool;
  fun isTooltipShown(context: mutable SKStore.Context, path: Ui.Path): Bool;

  fun manageWidgets(
    context: mutable SKStore.Context,
    path: Ui.Path,
    widgetGetter: Ui.GetterOne<Ui.Widget, UiRoot.Storage>,
    mouseMenu: Ui.Getter<FWK.MouseState>,
    focusMenu: Ui.Getter<FWK.FocusState>,
  ): SKStore.EHValue<Ui.MainKey, Ui.WidgetFile>;

  fun buildDropdown(
    context: mutable SKStore.Context,
    path: Ui.Path,
    items: Array<UiDropdown.ItemBase>,
  ): Ui.Dropdown;
}

module end;
