module UiRoot;

base class Layer extends SKStore.Key {
  children =
  | Main()
  | Menu()
  | Tooltip()

  fun toString(): String {
    this.getClassName();
  }

  static fun bKeyType(obj: SKStore.Key): Layer {
    obj match {
    | x @ Layer _ -> x
    | _ -> SKStore.cast_violation("UiRoot.Layer", obj)
    }
  }

  fun compare(other: SKStore.Key): Order {
    other match {
    | oLayer @ Layer _ ->
      (this, oLayer) match {
      | (Main(), Main()) -> EQ()
      | (Main(), Menu()) -> LT()
      | (Main(), Tooltip()) -> LT()
      | (Menu(), Menu()) -> EQ()
      | (Menu(), Main()) -> GT()
      | (Menu(), Tooltip()) -> LT()
      | (Tooltip(), Tooltip()) -> EQ()
      | (Tooltip(), Main()) -> GT()
      | (Tooltip(), Menu()) -> GT()
      }
    | _ -> this.getClassName().compare(other.getClassName())
    }
  }
}

base class Command extends SKUIMessage.Command {
  children =
  | ShowTooltip(String)

  fun toJSON(): JSON.Value
  | ShowTooltip(id) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "id" => JSON.String(id),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Command {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiRoot.ShowTooltip" -> ShowTooltip(jso.getString("id"))
    | _ -> invariant_violation(`Invalid json object ${cl} for UiRoot.Command`)
    }
  }
}

class HStorage private (
  state: SKStore.IHandle<SKStore.Key, SKStore.File>,
  handle: SKStore.EHandle<Layer, SKStore.IntFile>,
  content: SKStore.EHandle<SKStore.Key, SKStore.File>,
) extends Storage, SKStore.File {
  //
  static fun forScope(context: mutable SKStore.Context, scope: String): ?this {
    dirName = SKStore.DirName::create(scope);
    stateHdl = SKStore.IHandle::notTyped(dirName);
    contentHdl = SKStore.EHandle::notTyped(
      SKStore.DirName::make(dirName, "content/"),
    );
    rootHdl = SKStore.EHandle(
      Layer::bKeyType,
      SKStore.IntFile::type,
      SKStore.DirName::make(dirName, "main/"),
    );
    stateExists = stateHdl.exists(context);
    contentExists = contentHdl.exists(context);
    rootExists = rootHdl.exists(context);
    if (stateExists && contentExists && rootExists) {
      Some(HStorage(stateHdl, rootHdl, contentHdl))
    } else {
      None()
    }
  }

  static fun create(
    context: mutable SKStore.Context,
    dirName: SKStore.DirName,
  ): this {
    stateHdl = context.makeNotTyped(
      dirName,
      Array[(Main(), SKStore.IntFile(0))],
    );
    contentHdl = context.makeNotTyped(
      SKStore.DirName::make(dirName, "content/"),
      Array[(Main(), SKStore.IntFile(0))],
    );
    rootHdl = context.makeDir(
      Layer::bKeyType,
      SKStore.IntFile::type,
      SKStore.DirName::make(dirName, "main/"),
      Array[
        (Menu(), SKStore.IntFile(0)),
        (Tooltip(), SKStore.IntFile(0)),
        (Main(), SKStore.IntFile(0)),
      ],
    );
    static(SKStore.toIHandle(stateHdl), rootHdl, contentHdl)
  }

  fun manageWidgets(
    context: mutable SKStore.Context,
    path: Ui.Path,
    widgetGetter: Ui.GetterOne<Ui.Widget, UiRoot.Storage>,
    mouseMenu: Ui.Getter<FWK.MouseState>,
    focusMenu: Ui.Getter<FWK.FocusState>,
  ): SKStore.EHValue<Ui.MainKey, Ui.WidgetFile> {
    dirName = this.state.dirName;
    contentHdl = this.content.map(
      k ~> k,
      Ui.WidgetFile::type,
      context,
      SKStore.DirName::make(dirName, "widgetcontent/"),
      (context, writer, key, _) ~>
        writer.set(key, Ui.WidgetFile(widgetGetter(context, this)))
      ,
    );
    widgetSourcesPath = SKStore.DirName::make(dirName, "widgetsources/");
    preWidgetSourcesHdl = context.makePreDir(
      Layer::bKeyType,
      SKStore.OptFile::type,
      widgetSourcesPath,
      .Array[
        (Main(), SKStore.OptFile(None())),
        (Menu(), SKStore.OptFile(None())),
        (Tooltip(), SKStore.OptFile(None())),
      ],
    );
    widgetSourcesHdl = this.handle.map(
      Layer::bKeyType,
      SKStore.OptFile::type,
      context,
      widgetSourcesPath,
      (context, writer, key, _) ~> {
        key match {
        | Main() ->
          writer.set(
            key,
            SKStore.OptFile(
              Some(
                FWK.SourcedWidget(None(), (ctx, _root) ~> {
                  dialogsPath = path.makeChild("@dialogs");
                  state = UiDialogs.init(ctx, dialogsPath);
                  ctx.setDialogsState(state);
                  Some(
                    Ui.Dialogs::create(
                      ctx,
                      dialogsPath,
                      UiDialogs.Parameters(
                        UiDialogs.LamController{
                          content => ctx ~> contentHdl.get(ctx, Main()).widget,
                        },
                        state,
                      ),
                    ),
                  )
                }),
              ),
            ),
          )
        | Menu() ->
          optPreMenu = preWidgetSourcesHdl
            .getValue(context, Menu(), true)
            .map(FWK.SourcedWidget::type);
          optHMS = mouseMenu(context).optMenuSupplier;
          optHover = optHMS.flatMap(ddh ->
            ddh.i1.getDropdown(context).map(dd -> (ddh.i0, dd, ddh.i2))
          );
          focusState = focusMenu(context);
          optFocused = focusState.optMenuSupplier.flatMap(ddh ->
            ddh.i0.getDropdown(context).map(dd -> (dd, ddh.i1))
          );
          optDropdown = if (optHover.isSome() && optFocused.isSome()) {
            h = optHover.fromSome();
            f = optFocused.fromSome();
            if (h.i2 > f.i1) {
              Some((h.i1, Some(h.i0)))
            } else {
              Some((f.i0, None()))
            }
          } else if (optHover.isSome()) {
            optHover.map(h -> (h.i1, Some(h.i0)))
          } else {
            optFocused.map(f -> (f.i0, None()))
          };
          optMenu = optDropdown
            .map(dd -> dd.i0.toMenu(dd.i1, this.closeMenu))
            .map(menu ->
              optPreMenu match {
              | Some(preMenu) -> menu with {optFocused => preMenu.optFocused}
              | _ ->
                menu with {
                  optFocused => focusState.optFocused.map(f ->
                    f.getIdentifier()
                  ),
                }
              }
            );
          if (optMenu.isNone()) {
            optPreMenu.each(preMenu ->
              preMenu.optFocused.each(path ->
                SystemProperties.setRequireFocus(context, path)
              )
            )
          };
          writer.set(key, SKStore.OptFile(optMenu))
        | Tooltip() ->
          ms = mouseMenu(context);
          optSW = if (ms.optDragHandler.isNone()) {
            ms.optHoverHandler match {
            | Some(hh) ->
              hh.getTooltip(context) match {
              | Some(sw) ->
                if (
                  sw.optPath
                    .map(path -> this.isTooltipShown(context, path))
                    .default(false)
                ) {
                  Some(sw.toTooltip(FWKMouse.getMouse(context, true).offset()))
                } else {
                  sw.optPath.each(path ->
                    this.emit(context, ShowTooltip(path.toString()), Some(500))
                  );
                  None()
                }
              | _ -> None()
              }
            | _ -> None()
            }
          } else {
            None()
          };
          writer.set(key, SKStore.OptFile(optSW))
        }
      },
    );
    widgetsHdl = widgetSourcesHdl
      .map(
        SKStore.KIndexed::bKeyType,
        f ~> f,
        context,
        SKStore.DirName::make(dirName, "widgetsbuild/"),
        (context, writer, key, it) ~> {
          opt = it.first;
          opt.map(FWK.SourcedWidget::type).each(sw -> {
            sw.widget(context, this).each(widget -> {
              if (key == Menu()) {
                widget match {
                | ml @ Ui.MenuLayout _ ->
                  SystemProperties.setRequireFocus(
                    context,
                    ml.controller.getWidget(context).path,
                  )
                | _ -> void
                }
              };
              writer.set(SKStore.KIdx(key), Ui.WElem(widget));
              writer.set(SKStore.KKeys(), SKStore.KeyFile(key));
            })
          })
        },
      )
      .map(
        SKStore.KIndexed::bKeyType,
        Ui.WInfo::btype,
        context,
        SKStore.DirName::make(dirName, "widgets/"),
        (_, writer, key, it) ~>
          key match {
          | SKStore.KKeys() ->
            values = it
              .values()
              .collect(Array)
              .map(SKStore.KeyFile::type)
              .map(v ~> Layer::bKeyType(v.value));
            layers = values.sorted();
            keys = Ui.WKeys(layers);
            writer.set(key, keys);
            writer.set(SKStore.KSize(), Ui.WSize(values.size()))
          | _ -> writer.set(key, Ui.WElem::type(it.first))
          }
        ,
      );
    widgetCollection = Ui.KIndexedCollection(widgetsHdl);
    sourceHdl = context.makeDir(
      Ui.MainKey::keyType,
      SKStore.IntFile::type,
      SKStore.DirName::make(dirName, "widgetsource/"),
      Array[(Ui.MainKey(), SKStore.IntFile(0))],
    );
    SKStore.EHValue(
      sourceHdl.map(
        Ui.MainKey::keyType,
        Ui.WidgetFile::type,
        context,
        SKStore.DirName::make(dirName, "widget/"),
        (context, writer, key, _) ~> {
          stack = Ui.Stack::createForController(
            context,
            path.makeChild("@stack"),
            UiStack.LamController{widgets => widgetCollection},
          );
          writer.set(key, Ui.WidgetFile(stack))
        },
      ),
      Ui.MainKey(),
    );
  }

  fun isMenuClosed(context: mutable SKStore.Context): Bool {
    this.state.maybeGetInt(context, Ui.closedProp)
      .map(v -> v == context.getTick().value)
      .default(false);
  }

  fun closeMenu(context: mutable SKStore.Context): void {
    builtHdl = SKStore.EHandle::notTyped(
      SKStore.DirName::make(this.state.dirName, "widgetsbuild/"),
    );
    if (builtHdl.exists(context)) {
      conv: SKStore.File ~> Ui.Widget = f ~> Ui.WidgetFile::type(f).widget;
      builtHdl.maybeGetProp(context, Menu(), conv).each(w ->
        w match {
        | ml @ Ui.MenuLayout _ ->
          ml.controller.getWidget(context) match {
          | dd @ Ui.Dropdown _ -> dd.state.setClose(context)
          | _ -> void
          }
        | _ -> void
        }
      );
    };
    this.state.write(
      context,
      Ui.closedProp,
      SKStore.IntFile(context.getTick().value + 1),
    )
  }

  fun buildDropdown(
    context: mutable SKStore.Context,
    path: Ui.Path,
    items: Array<UiDropdown.ItemBase>,
  ): Ui.Dropdown {
    itemsCollection = UiDropdown.ArrayCollection(items);
    controller = UiDropdown.LamController{
      items => (_ctx, _iu) ~> itemsCollection,
      onClose_ => this.closeMenu,
    };
    Ui.Dropdown::create(
      context,
      path,
      UiDropdown.init(context, path, controller),
    )
  }

  fun setShownTooltip(context: mutable SKStore.Context, id: String): void {
    this.state.write(context, Ui.activeProp, SKStore.StringFile(id))
  }

  fun isTooltipShown(context: mutable SKStore.Context, path: Ui.Path): Bool {
    this.state.maybeGetString(context, Ui.activeProp)
      .map(v -> v == path.toString())
      .default(false);
  }

  private fun emit(
    context: mutable SKStore.Context,
    command: SKUIMessage.Command,
    optDelay: ?Int = None(),
  ): void {
    SKUIMessage.emit(
      context,
      statePath,
      this.state.dirName.toString(),
      command,
      false,
      optDelay,
    );
  }
}

module end;
