module UiConstrained;

base class Controller extends Ui.Parameters {
  fun getConstraints(context: mutable SKStore.Context): Ui.BoxConstraints;
  fun getWidget(context: mutable SKStore.Context): ?Ui.Widget;
  fun isEnforced(context: mutable SKStore.Context): Bool;
}

class LamController{
  constraints: mutable SKStore.Context ~> Ui.BoxConstraints,
  widget: mutable SKStore.Context ~> ?Ui.Widget = _ctx ~> None(),
  enforced: mutable SKStore.Context ~> Bool = _ctx ~> false,
} extends Controller {
  //
  fun getConstraints(context: mutable SKStore.Context): Ui.BoxConstraints {
    this.constraints(context)
  }

  fun getWidget(context: mutable SKStore.Context): ?Ui.Widget {
    this.widget(context)
  }

  fun isEnforced(context: mutable SKStore.Context): Bool {
    this.enforced(context)
  }
}

module end;

module Ui;

class Constrained{
  controller: UiConstrained.Controller,
} extends StrictWidget uses FWK.NoFocusHandler, WithNodeCache {
  //
  type Params = UiConstrained.Controller;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Ui.Path,
    controller: UiConstrained.Controller,
    cache: NodeCache,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static{path, controller, optConfiguration, cache, tick => context.getTick()}
  }

  fun layout(context: mutable SKStore.Context, constr: BoxConstraints): Node {
    constraints = this.controller.getConstraints(context);
    cConstraints = if (this.controller.isEnforced(context)) {
      constr.enforce(constraints);
    } else {
      constraints.enforce(constr);
    };
    this.controller.getWidget(context) match {
    | Some(constrained) ->
      node = constrained.getNode(context, cConstraints);
      Ui.Node::create(
        this,
        node.size,
        Array[Ui.CNode::create(node, Geometry.Offset::zero, cConstraints)],
      )
    | _ -> Ui.Node::create(this, cConstraints.smallest())
    }
  }

  fun getViewportDefinition(context: mutable SKStore.Context): ?ViewportDef {
    this.controller.getWidget(context).flatMap(w ->
      w.getViewportDefinition(context)
    )
  }
}

module end;
