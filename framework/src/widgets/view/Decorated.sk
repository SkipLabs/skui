module UiDecorated;

base class Controller extends Ui.Parameters {
  fun getWidget(context: mutable SKStore.Context): ?Ui.Widget;
  fun getDecoration(context: mutable SKStore.Context): Ui.Decoration;
  fun getDirection(context: mutable SKStore.Context): Ui.HorizontalDirection;
}

class LamController{
  decoration: mutable SKStore.Context ~> Ui.Decoration,
  widget: mutable SKStore.Context ~> ?Ui.Widget = _ctx ~> None(),
  direction: mutable SKStore.Context ~> Ui.HorizontalDirection = _ctx ~>
    Ui.ToRight(),
} extends Controller {
  //
  fun getDecoration(context: mutable SKStore.Context): Ui.Decoration {
    this.decoration(context)
  }

  fun getWidget(context: mutable SKStore.Context): ?Ui.Widget {
    this.widget(context)
  }

  fun getDirection(context: mutable SKStore.Context): Ui.HorizontalDirection {
    this.direction(context)
  }
}

module end;

module Ui;

class Decorated{
  controller: UiDecorated.Controller,
} extends StrictWidget uses FWK.NoFocusHandler, WithNodeCache {
  //
  type Params = UiDecorated.Controller;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Path,
    controller: UiDecorated.Controller,
    cache: NodeCache,
    optConfiguration: ?Getter<Configuration> = None(),
  ): this {
    static{path, controller, optConfiguration, cache, tick => context.getTick()}
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    decoration = this.controller.getDecoration(context);
    direction = this.controller.getDirection(context);
    padding = decoration.getPadding(direction);
    cConstraints = constraints.deflate(padding);
    this.controller.getWidget(context) match {
    | Some(widget) ->
      node = widget.getNode(context, cConstraints);
      offset = Geometry.Offset(padding.left, padding.top);
      size = padding.inflateSize(node.size);
      Node(this, size, Array[CNode(node, offset, cConstraints)])
    | _ ->
      biggest = cConstraints.biggest();
      smallest = cConstraints.smallest();
      width = if (cConstraints.hasBoundedWidth()) {
        biggest.width
      } else {
        smallest.width
      };
      height = if (cConstraints.hasBoundedHeight()) {
        biggest.height
      } else {
        smallest.height
      };
      Node(this, padding.inflateSize(Geometry.Size(width, height)))
    };
  }

  fun getViewportDefinition(context: mutable SKStore.Context): ?ViewportDef {
    this.controller.getWidget(context).flatMap(w ->
      w.getViewportDefinition(context)
    )
  }

  fun computeLayer(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    layer match {
    | BackgroundLayer() ->
      drawables = mutable Vector<Ui.Drawable>[];
      decoration = this.controller.getDecoration(context);
      direction = this.controller.getDirection(context);
      decoration.fillDrawables(
        context,
        support,
        absolute,
        node.size(),
        direction,
        drawables,
      );
      drawables.toArray()
    | MainLayer()
    | ForegroundLayer() ->
      Array[]
    };
  }
}

module end;
