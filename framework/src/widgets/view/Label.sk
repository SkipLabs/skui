module UiLabel;

const side: Float = 4.0;

base class Controller extends Ui.Parameters {
  fun isDisabled(context: mutable SKStore.Context): Bool;
  fun getText(context: mutable SKStore.Context): ?Text;
  fun getIcon(context: mutable SKStore.Context, fontSize: Float): ?Ui.Icon;
  fun getTooltip(context: mutable SKStore.Context): ?Text;
  fun getTextFont(context: mutable SKStore.Context): UiTheme.Font;
}

class Layout(size: Geometry.Size) extends Ui.UserData

class LamController{
  disabled: mutable SKStore.Context ~> Bool = _ctx ~> false,
  text: mutable SKStore.Context ~> ?Text = _ctx ~> None(),
  icon: (mutable SKStore.Context, Float) ~> ?Ui.Icon = (_ctx, _fs) ~> None(),
  tooltip: mutable SKStore.Context ~> ?Text = _ctx ~> None(),
  textFont: mutable SKStore.Context ~> UiTheme.Font = _ctx ~> UiTheme.Basic(),
} extends Controller {
  //
  fun isDisabled(context: mutable SKStore.Context): Bool {
    this.disabled(context)
  }

  fun getText(context: mutable SKStore.Context): ?Text {
    this.text(context)
  }

  fun getIcon(context: mutable SKStore.Context, fontSize: Float): ?Ui.Icon {
    this.icon(context, fontSize)
  }

  fun getTooltip(context: mutable SKStore.Context): ?Text {
    this.tooltip(context)
  }

  fun getTextFont(context: mutable SKStore.Context): UiTheme.Font {
    this.textFont(context)
  }
}

module end;

module Ui;

class Label protected {
  controller: UiLabel.Controller,
} extends StrictWidget uses FWK.NoFocusHandler, WithNodeCache, NoViewports {
  //
  type Params = UiLabel.Controller;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Ui.Path,
    controller: UiLabel.Controller,
    cache: NodeCache,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static{path, controller, optConfiguration, cache, tick => context.getTick()}
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    faceId = context.getThemeFont(this.controller.getTextFont(context));
    txt = "";
    iconTextGap = context.getThemeThickness(UiTheme.IconTextGap()).toFloat();
    lineSpacing = context.getThemeThickness(UiTheme.LineSpacing());
    innerSize = this.controller.getText(context) match {
    | Some(text) ->
      textSupport = context.getTextSupport();
      str = context.translate(text);
      !txt = str;
      size = textSupport.getLinesSize(context, str, None(), faceId, _lh ->
        lineSpacing.toFloat()
      );
      this.controller.getIcon(context, faceId.size) match {
      | Some(icon) ->
        iSize = icon.size(context);
        Geometry.Size(size.width + iSize.width + iconTextGap, size.height)
      | _ -> size
      }
    | _ ->
      this.controller.getIcon(context, faceId.size) match {
      | Some(icon) -> icon.size(context)
      | _ -> Geometry.Size::square(0.0)
      }
    };
    size = constraints.constrain(
      innerSize + Geometry.Size(2.0 * UiLabel.side, 0.0),
    );
    Node::create(
      this,
      size,
      Array[],
      constUserData(Some(UiLabel.Layout(innerSize))),
    )
  }

  fun computeLayer(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    layer match {
    | MainLayer() ->
      drawables = mutable Vector<Ui.Drawable>[];
      innerSize = node.optUserData
        .map(l ~> l as UiLabel.Layout _)
        .fromSome().size;
      this.fillMain(
        context,
        support,
        absolute,
        node.size(),
        innerSize,
        drawables,
      );
      drawables.toArray()
    | BackgroundLayer()
    | ForegroundLayer() ->
      Array[]
    };
  }

  private fun fillMain(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    size: Geometry.Size,
    innerSize: Geometry.Size,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    foreground = if (this.controller.isDisabled(context)) {
      context.getThemeColor(UiTheme.Disabled())
    } else {
      context.getThemeColor(UiTheme.Regular())
    };
    left = Math.max(UiLabel.side, (size.width - innerSize.width) / 2.0);
    remainingWidth = size.width - 2.0 * UiLabel.side;
    faceId = context.getThemeFont(this.controller.getTextFont(context));
    iconTextGap = context.getThemeThickness(UiTheme.IconTextGap()).toFloat();
    lineSpacing = context.getThemeThickness(UiTheme.LineSpacing()).toFloat();
    this.controller.getIcon(context, faceId.size).each(icon -> {
      iSize = icon.size(context);
      top = (size.height - iSize.height) / 2.0;
      iOffset = absolute.translate(left, top).ceil();
      icon.fillDrawables(
        context,
        support,
        iOffset,
        iSize,
        foreground,
        drawables,
      );
      !left = left + iSize.width + iconTextGap;
      !remainingWidth = remainingWidth - (iSize.width + iconTextGap);
    });
    this.controller.getText(context).each(text -> {
      width = remainingWidth;
      height = innerSize.height;
      str = context.translate(text);
      top = (size.height - innerSize.height) / 2.0;
      lines = context
        .getTextSupport()
        .getLines(
          context,
          str,
          Geometry.Size(width, height),
          Text.Style{faceId, lineSpacing => Text.ConstLineSpacing(lineSpacing)},
        );
      lines.each(l ->
        l.fillDrawables(
          context,
          support,
          absolute.translate(left, top),
          foreground,
          drawables,
        )
      )
    });
  }

  fun getHoverHandler(
    _context: mutable SKStore.Context,
    _childGetter: Getter<?FWK.HoverHandler>,
  ): ?HoverHandlerGetter {
    None()
    /*this.controller.getTooltip(context).map(tooltip ->
      (_, _, _) ~>
        UiTooltiped.HoverHandler(this.path, _ctx ~> tooltip, Some(500), None())
    )*/
  }
}

module end;
