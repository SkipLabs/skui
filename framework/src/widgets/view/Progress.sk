module Ui;

class Indicator protected {
  controller: UiProgress.Controller,
  state: UiProgress.State,
} extends StrictWidget uses FWK.NoFocusHandler, WithNodeCache, NoViewports {
  //
  type Params = UiProgress.Parameters;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Ui.Path,
    params: UiProgress.Parameters,
    cache: NodeCache,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static{
      path,
      controller => params.controller,
      state => params.state,
      optConfiguration,
      cache,
      tick => context.getTick(),
    }
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    refSize = Geometry.Size::square(
      context.getThemeThickness(UiTheme.Indicator()).toFloat(),
    );
    size = constraints.constrain(refSize);
    Ui.Node::create(this, size)
  }

  fun computeLayer(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    layer match {
    | MainLayer() -> this.computeMain(context, support, absolute, node.size())
    | BackgroundLayer()
    | ForegroundLayer() ->
      Array[]
    };
  }

  fun computeMain(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    size: Geometry.Size,
  ): Array<Ui.Drawable> {
    refSize = Geometry.Size::square(
      context.getThemeThickness(UiTheme.Indicator()).toFloat(),
    );
    indSize = size.min(refSize);
    offset = absolute.move(((size - indSize) / 2.0).toOffset());
    this.controller.getProgress(context) match {
    | Some(progress) ->
      Array[
        support.progress(
          offset,
          indSize,
          progress.toFloat(),
          context.getThemeColor(UiTheme.PrimaryLoading()),
          context.getThemeColor(UiTheme.SecondaryLoading()),
          context.getThemeThickness(UiTheme.Loading()).toFloat(),
        ),
      ]
    | _ ->
      step = this.state.getIndeterminate(context) match {
      | Some(v) -> v
      | _ ->
        this.state.emitIndeterminate(context, 0);
        0
      };
      Array[
        support.loading(
          offset,
          indSize,
          context.getThemeColor(UiTheme.PrimaryLoading()),
          context.getThemeColor(UiTheme.SecondaryLoading()),
          step,
        ),
      ]
    }
  }
}

module end;
