module UiText;

const metricsPath: String = "/ui/verified/texts/metrics/";

base class Controller {
  fun getText(context: mutable SKStore.Context): Text;
  fun getStyle(context: mutable SKStore.Context): Text.Style;
}

class Parameters(controller: Controller, pxRange: Int) extends Ui.Parameters

class LamController{
  text: mutable SKStore.Context ~> Text,
  style: mutable SKStore.Context ~> Text.Style,
} extends Controller {
  fun getText(context: mutable SKStore.Context): Text {
    this.text(context)
  }

  fun getStyle(context: mutable SKStore.Context): Text.Style {
    this.style(context)
  }
}

class LineInfo(
  text: String,
  offset: Geometry.Offset,
  optClip: ?Geometry.Rectangle,
)

class DrawInfo(value: Array<?LineInfo>) extends Ui.DrawInfo {
  static fun compute(
    context: mutable SKStore.Context,
    absolute: Geometry.Offset,
    size: Geometry.Size,
    layout: Layout,
  ): this {
    top = layout.metrics.style.vAlignment match {
    | Text.Top() -> Math.ceil(absolute.dy)
    | Text.Middle() ->
      Math.ceil(absolute.dy + (size.height - layout.size.height) / 2.0)
    | Text.Bottom() ->
      Math.floor(absolute.dy + size.height - layout.size.height)
    };
    fullLine = layout.fullLine();
    reduced = layout.metrics.reduce(context, size.width.toFloat());
    static(
      reduced.mapWithIndex((index, line) -> {
        (text, twidth) = line;
        !index = index + 1;
        left = layout.metrics.style.hAlignment match {
        | Text.Center() -> Math.ceil(absolute.dx + (size.width - twidth) / 2.0)
        | Text.Justify()
        | Text.Left() ->
          Math.ceil(absolute.dx)
        | Text.Right() -> Math.floor(absolute.dx + size.width - twidth)
        };
        optLineInfo = if (
          top >= absolute.dy &&
          Math.floor(top + layout.metrics.height) <=
            Math.ceil(absolute.dy + size.height)
        ) {
          Some(LineInfo(text, Geometry.Offset(left, top), None()))
        } else {
          None()
        };
        !top = top + fullLine;
        optLineInfo
      }),
    )
  }
}

class Run(
  width: Float,
  columns: Array<(Float, Float)>,
  breakables: Array<(Int, Float, Int, Float, Bool)>,
)

class Metrics(
  text: Vector<Char>,
  lines: Array<(Text.Range, Run)>,
  height: Float,
  space: Float,
  style: Text.Style,
) extends SKStore.File {
  static fun compute(
    context: mutable SKStore.Context,
    controller: Controller,
  ): this {
    fontSupport = context.getFontSupport();
    style = controller.getStyle(context);
    lineHeight = fontSupport.getLineHeight(context, style.faceId);
    space = style.lineSpacing.getLineSpace(context, lineHeight);
    str = context.translate(controller.getText(context));
    !str = style.transform match {
    | Text.Uppercase() -> Text.uppercase(str)
    | Text.Lowercase() -> Text.lowercase(str)
    | Text.UppercaseFirst() -> Text.uppercaseFirst(str)
    | Text.Capitalize() -> Text.capitalize(str)
    | Text.NoCapitalization() -> str
    };
    chars = str.chars();
    splitter = Text.LineSplitter();
    lines = splitter.split(chars);
    isBreakable: Char ~> Bool = style.wrapping match {
    | Text.WordWrap(separators) -> c ~> separators.test(c)
    | Text.CharWrap() -> _c ~> true
    | _ -> _c ~> false
    };
    static(
      chars,
      lines.map(line -> {
        breakables = mutable Vector<(Int, Float, Int, Float, Bool)>[];
        optPrevious: ?Char = None();
        width = 0.0;
        optBeforeWhiteSpace: ?(Int, Float) = None();
        columns = Array::fillBy(line.size(), idx -> {
          char = chars[line.start + idx];
          optBeforeWhiteSpace match {
          | Some(bwsw) ->
            if (!Char.isWhitespace(char)) {
              breakables.push((bwsw.i0, bwsw.i1, idx, width, true));
              !optBeforeWhiteSpace = None();
            }
          | _ ->
            if (isBreakable(char) && Char.isWhitespace(char)) {
              !optBeforeWhiteSpace = Some((idx, width));
            }
          };
          glyph = fontSupport.getGlyph(context, char, style.faceId);
          cw = glyph.width();
          ck = glyph.getKern(optPrevious);
          if (isBreakable(char) && optBeforeWhiteSpace.isNone()) {
            breakables.push((idx, width, idx + 1, width + cw - ck, false));
          };
          !width = width + cw - ck;
          !optPrevious = Some(char);
          (cw, ck);
        });
        (line, Run(width, columns, breakables.toArray()))
      }),
      lineHeight,
      space,
      style,
    )
  }

  fun split(width: Float): this {
    lines = mutable Vector<(Text.Range, Run)>[];
    this.lines.each(li -> {
      (line, run) = li;
      if (!run.breakables.isEmpty() && run.width > width) {
        refIdx = 0;
        ref = 0.0;
        kern = 0.0;
        breakables = mutable Vector<(Int, Float, Int, Float, Bool)>[];
        optBefore: ?(Int, Float, Int, Float, Bool) = None();
        pushLine = () ->
          optBefore.each(before -> {
            line.slice(refIdx, before.i0).each(range ->
              lines.push(
                (
                  range,
                  Run(
                    before.i1 - ref + kern,
                    run.columns.slice(refIdx, before.i0),
                    breakables.toArray(),
                  ),
                ),
              )
            );
            (!refIdx, !ref) = if (before.i4) (before.i2, before.i3) else {
              (before.i0, before.i1)
            };
            if (refIdx < line.size()) {
              !kern = run.columns[refIdx].i1;
            };
            breakables.clear();
          });
        for (breakable in run.breakables) {
          (bi, bw, ai, aw, skipable) = breakable;
          if (bw - ref + kern > width) {
            pushLine()
          } else {
            breakables.push(
              (
                bi - refIdx,
                bw - ref + kern,
                ai - refIdx,
                aw - ref + kern,
                skipable,
              ),
            );
          };
          !optBefore = Some(breakable);
        };
        if (run.width - ref > width) {
          pushLine();
        };
        if (refIdx < line.size()) {
          line.slice(refIdx, line.size()).each(range ->
            lines.push(
              (
                range,
                Run(
                  run.width - ref + kern,
                  run.columns.slice(refIdx, line.size()),
                  breakables.toArray(),
                ),
              ),
            )
          );
        };
      } else {
        lines.push((line, run))
      }
    });
    !this.lines = lines.toArray();
    this
  }

  fun reduce(
    context: mutable SKStore.Context,
    max: Float,
  ): Array<(String, Float)> {
    this.lines.map(line ->
      this.style.overrun match {
      | Text.Visible() ->
        (
          String::fromChars(
            this.text.slice(line.i0.start, line.i0.end).toArray(),
          ),
          line.i1.width,
        )
      | overflow @ Text.Overflow _ ->
        (reducer, reduction) = overflow match {
        | oc @ Text.OverflowChar _ ->
          (
            Text.Reducer::charsReducer(
              context,
              this.text,
              this.style.faceId,
              oc.optEllipsis,
              Some(line.i0),
            ),
            oc.toReduction(),
          )
        | ow @ Text.OverflowWord _ ->
          (
            Text.Reducer::wordsReducer(
              context,
              this.text,
              this.style.faceId,
              ow.optEllipsis,
              Some(line.i0),
            ),
            ow.toReduction(),
          )
        };
        reducer.reduce(max, reduction)
      }
    )
  }
}

class Cache(
  metricsHdl: SKStore.LHandle<SKStore.IID, Metrics>,
  nodesHdl: SKStore.LHandle<Ui.KConstraints, Ui.Node>,
) extends Ui.NodeBuffer {
  //
  static fun create(path: Ui.Path): this {
    metricsPath = path.toDirName(metricsPath);
    nodesPath = Ui.nodesBufferPath(path);
    static(
      SKStore.LHandle(SKStore.IID::keyType, Metrics::type, metricsPath),
      SKStore.LHandle(Ui.KConstraints::keyType, Ui.Node::type, nodesPath),
    );
  }

  fun getMetrics(context: mutable SKStore.Context): Metrics {
    this.metricsHdl.get(context, SKStore.IID(0))
  }

  fun getNode(
    context: mutable SKStore.Context,
    constraints: Ui.BoxConstraints,
  ): Ui.Node {
    this.nodesHdl.get(context, Ui.KConstraints(constraints))
  }

  fun init(context: mutable SKStore.Context, widget: Ui.Widget): void {
    vtext = widget as Ui.VText _;
    _ = SKStore.LHandle::lazy(
      SKStore.IID::keyType,
      Metrics::type,
      context,
      vtext.path.toDirName(metricsPath),
      (context, _, _) ~> Metrics::compute(context, vtext.controller),
    );
    _ = Ui.nNodesBuffer(context, vtext, this.nodesHdl.dirName)
  }
}

class Layout(size: Geometry.Size, metrics: Metrics) extends Ui.UserData {
  fun fullLine(): Float {
    Math.ceil(this.metrics.height + this.metrics.space)
  }

  fun getTextAt(index: Int): String {
    range = this.metrics.lines[index].i0;
    String::fromChars(this.metrics.text.slice(range.start, range.end).toArray())
  }
}

module end;

module Ui;

class VText protected {
  controller: UiText.Controller,
  pxRange: Int,
} extends StrictWidget uses FWK.NoFocusHandler, NoViewports {
  //
  type Params = UiText.Parameters;
  type Buffer = UiText.Cache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Ui.Path,
    params: UiText.Parameters,
    cache: UiText.Cache,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static{
      path,
      controller => params.controller,
      pxRange => params.pxRange,
      optConfiguration,
      cache,
      tick => context.getTick(),
    }
  }

  static fun createForController(
    context: mutable SKStore.Context,
    path: Ui.Path,
    controller: UiText.Controller,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static::create(
      context,
      path,
      UiText.Parameters(controller, 8),
      optConfiguration,
    )
  }

  protected static fun makeCache(path: Ui.Path): UiText.Cache {
    UiText.Cache::create(path)
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    metrics = this.cache.getMetrics(context);
    if (constraints.hasBoundedWidth()) {
      !metrics = metrics.split(constraints.maxWidth().floor())
    };
    len = metrics.lines.size();
    fullLine = Math.ceil(metrics.height + metrics.space);
    height =
      fullLine * Math.max(len - 1, 0).toFloat() +
      Math.ceil(metrics.height);
    width = metrics.lines.reduce(
      (acc, line) -> Math.max(acc, line.i1.width),
      0.0,
    );
    innerSize = Geometry.Size(width, height);
    size = constraints.constrain(innerSize);
    Node::create(
      this,
      size,
      Array[],
      constUserData(Some(UiText.Layout(innerSize, metrics))),
    )
  }

  fun computeLayer(
    context: mutable SKStore.Context,
    _support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    layer match {
    | MainLayer() ->
      drawables = mutable Vector<Ui.Drawable>[];
      layout = node.optUserData.map(l ~> l as UiText.Layout _).fromSome();
      drawInfo = node.optDrawInfo.map(di ~> di as UiText.DrawInfo _).fromSome();
      this.fillMain(
        context,
        absolute,
        node.size(),
        layout,
        drawInfo,
        drawables,
      );
      drawables.toArray()
    | BackgroundLayer()
    | ForegroundLayer() ->
      Array[]
    };
  }

  private fun fillMain(
    context: mutable SKStore.Context,
    absolute: Geometry.Offset,
    _size: Geometry.Size,
    layout: UiText.Layout,
    drawInfo: UiText.DrawInfo,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    // TODO Mange clip
    textSupport = context.getTextSupport();
    display = layout.metrics.style.toDisplay();
    drawInfo.value.each(optLineInfo ->
      optLineInfo.each(lineInfo -> {
        offset = lineInfo.offset + absolute;
        textSupport
          .getDrawables(context, lineInfo.text, display, this.pxRange)
          .each(ds -> ds.each(d -> drawables.push(d.translate(offset))));
      })
    )
  }

  fun computeDrawInfo(
    context: mutable SKStore.Context,
    _support: Ui.DrawableSupport,
    _relative: Geometry.Offset,
    nodeSum: NodeSum,
    optUserData: ?UserData,
  ): ?DrawInfo {
    layout = optUserData.map(ud ~> ud as UiText.Layout _).fromSome();
    Some(
      UiText.DrawInfo::compute(
        context,
        Geometry.Offset::zero,
        nodeSum.size,
        layout,
      ),
    );
  }
}

module end;
