module MTSDF;

fun solveQuadratic(a: Float, b: Float, c: Float): Array<Float> {
  // a == 0 -> linear equation
  if (a == 0.0 || Math.abs(b) > 1e12 * Math.abs(a)) {
    // a == 0, b == 0 -> no solution
    if (b == 0.0) {
      Array[]
    } else {
      Array[-c / b]
    }
  } else {
    dscr = b * b - 4.0 * a * c;
    if (dscr > 0.0) {
      !dscr = Math.sqrt(dscr);
      Array[(-b + dscr) / (2.0 * a), (-b - dscr) / (2.0 * a)]
    } else if (dscr == 0.0) {
      Array[-b / (2.0 * a)]
    } else {
      Array[]
    }
  }
}

fun solveCubicNormed(a: Float, b: Float, c: Float): Array<Float> {
  a2 = a * a;
  q = 1.0 / 9.0 * (a2 - 3.0 * b);
  r = 1.0 / 54.0 * (a * (2.0 * a2 - 9.0 * b) + 27.0 * c);
  r2 = r * r;
  q3 = q * q * q;
  !a = a * 1.0 / 3.0;
  if (r2 < q3) {
    t = r / Math.sqrt(q3);
    if (t < -1.0) !t = -1.0;
    if (t > 1.0) !t = 1.0;
    !t = Math.arcCos(t);
    !q = -2.0 * Math.sqrt(q);
    Array[
      q * Math.cos(1.0 / 3.0 * t) - a,
      q * Math.cos(1.0 / 3.0 * (t + 2.0 * Math.PI)) - a,
      q * Math.cos(1.0 / 3.0 * (t - 2.0 * Math.PI)) - a,
    ]
  } else {
    u =
      (if (r < 0.0) 1.0 else -1.0) *
      Math.pow(Math.abs(r) + Math.sqrt(r2 - q3), 1.0 / 3.0);
    v = if (u == 0.0) 0.0 else q / u;
    ret0 = (u + v) - a;
    if (u == v || Math.abs(u - v) < 1e-12 * Math.abs(u + v)) {
      Array[ret0, -0.5 * (u + v) - a]
    } else {
      Array[ret0]
    }
  }
}

fun solveCubic(a: Float, b: Float, c: Float, d: Float): Array<Float> {
  if (a != 0.0) {
    bn = b / a;
    if (Math.abs(bn) < 1e6) return solveCubicNormed(bn, c / a, d / a); // Above this ratio, the numerical error gets larger than if we treated a as zero
  };
  solveQuadratic(b, c, d);
}

module end;
