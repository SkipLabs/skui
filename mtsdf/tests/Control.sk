module SKUIMTSDFTest;

@test
fun control(): void {
  Control().run()
}

fun expectEquals<T: Equality>(
  actual: T,
  expected: T,
  optName: ?String = None(),
  conv: T ~> String = Utils.toString,
  msg: String = "expected equality",
): void {
  if (actual != expected) {
    throw SKTest.ExpectationError(
      optName.map(n -> `${msg} [${n}]`).default(msg),
      conv(expected),
      conv(actual),
    )
  }
}

fun expectLikes<T: Equivalent>(
  actual: T,
  expected: T,
  optName: ?String = None(),
  precision: Float = MTSDF.precisionEpsilon,
  conv: T ~> String = Utils.toString,
  msg: String = "expected equivalent",
): void {
  if (!actual.like(expected, precision)) {
    throw SKTest.ExpectationError(
      optName.map(n -> `${msg} [${n}] ±${precision}`).default(msg),
      conv(expected),
      conv(actual),
    )
  }
}

base class Case {
  fun exec(idx: Int): void;
}

class ControlCase(
  name: String,
  shape: MTSDF.Shape,
  expected: MTSDF.Shape,
  todo: MTSDF.Shape ~> MTSDF.Shape,
) extends Case {
  fun exec(_idx: Int): void {
    got = this.todo(this.shape);
    expectEquals(got, this.expected, Some(this.name))
  }
}

class DirectionCase(
  edge: MTSDF.EdgeSegment,
  direction: MTSDF.Vector2,
  normalized: MTSDF.Vector2,
  param: Float = 1.0,
) extends Case {
  fun exec(_idx: Int): void {
    direction = this.edge.direction(this.param);
    expectLikes(direction, this.direction, Some("Direction"));
    normalized = direction.normalize();
    expectLikes(normalized, this.normalized, Some("Normalized"));
  }
}

class Scan(
  shape: MTSDF.Shape,
  index: Int,
  expected: Array<Bool>,
  fillRule: MTSDF.FillRule = MTSDF.NoneZero(),
) extends Case {
  fun exec(_idx: Int): void {
    scanline = this.shape.scanline(this.index.toFloat() + 0.5);
    got = Array::fillBy(this.expected.size(), idx ->
      scanline.filled(idx.toFloat() + 0.5, this.fillRule)
    );
    expectEquals(got, this.expected, Some(`scanline[${this.index}]`))
  }
}

class Coloring(
  shape: MTSDF.Shape,
  expected: Array<Array<Int>>,
  edgeColoring: (
    MTSDF.Shape,
    Float,
    Int,
  ) ~> MTSDF.Shape = MTSDF.edgeColoringSimple,
  angleThreshold: Float = MTSDF.defaultAngleThreshold.toFloat(),
  coloringSeed: Int = 0,
) extends Case {
  //
  fun exec(_idx: Int): void {
    shape = this.edgeColoring(
      this.shape,
      this.angleThreshold,
      this.coloringSeed,
    );
    got = shape.contours.map(contour -> contour.edges.map(e -> e.color.value));
    expectEquals(got, this.expected, Some("coloring"))
  }
}

class DistanceToPseudoDistance(
  edge: MTSDF.EdgeSegment,
  distance: MTSDF.SignedDistance,
  origine: MTSDF.Vector2,
  param: Float,
  expected: MTSDF.SignedDistance,
) extends Case {
  fun exec(_idx: Int): void {
    got = this.edge.distanceToPseudoDistance(
      this.distance,
      this.origine,
      this.param,
    );
    expectLikes(got, this.expected, Some("distanceToPseudoDistance"))
  }
}

fun toString<T: Show>(a: readonly Array<T>, nb: Int = 1): String {
  val = a.mapWithIndex((idx, v) -> {
    if (nb > 1 && (idx + 1) % nb == 0) {
      `${v},\n`
    } else {
      `${v}, `
    }
  });
  `[${val.join("")}]`
}

fun checkImage(image: Ui.Image, a1: Array<UInt8>, size: Int): Bool {
  idx = 0;
  for (pix in image.data) {
    value = Ui.Pix::fromArray(a1.slice(idx, idx + size));
    like = pix.like(value);
    if (!like) {
      break false;
    };
    !idx = idx + size;
  } else {
    true
  }
}

class Checker(
  a: Array<Float>,
  width: Int,
  displayDiff: Bool = false,
) uses Equivalent, Show {
  fun like(other: Checker, precision: Float = MTSDF.precisionEpsilon): Bool {
    SKUIMTSDFTest.like(
      this.a,
      other.a,
      precision,
      this.displayDiff || other.displayDiff,
    )
  }

  fun toString(): String {
    SKUIMTSDFTest.toString(this.a, this.width)
  }
}

fun like(
  a1: readonly Array<Float>,
  a2: Array<Float>,
  precision: Float = MTSDF.precisionEpsilon,
  displayDiff: Bool = false,
): Bool {
  like = a1.size() == a2.size();
  idx = 0;
  while (idx < a1.size() && like) {
    !like = Math.like(a1[idx], a2[idx], precision);
    !idx = idx + 1;
  };
  if (!like && displayDiff) {
    max = 0.0;
    a1.eachWithIndex((idx, v) -> {
      diff = v - a2.maybeGet(idx).default(0.0);
      !max = Math.max(max, diff);
    });
    print_string(`DIFF: ${a1.size()} ${a2.size()} ${max}`);
    debug(
      (
        a1.size(),
        a2.size(),
        a1
          .mapWithIndex((idx, v) -> {
            o = a2.maybeGet(idx);
            diff = v - o.default(0.0);
            if (Math.abs(diff) <= precision) None() else Some((idx, v, o, diff))
          })
          .filter(v -> v.isSome())
          .map(v -> v.fromSome()),
      ),
    )
  };
  like
}

class EstimateEdgeLength(
  edge: MTSDF.EdgeSegment,
  expected: Float,
) extends Case {
  fun exec(_caseIdx: Int): void {
    got = MTSDF.estimateEdgeLength(this.edge);
    expectLikes(got, this.expected, Some("EstimateEdgeLength"))
  }
}

class Control() {
  //
  fun run(): void {
    this.cases().eachWithIndex((idx, c) -> c.exec(idx))
  }

  protected fun cases(): Array<Case> {
    st = size -> MTSDF.Shape(Array[triangle(size)], false);
    vec = mutable Vector<Case>[
      ControlCase("normalize", st(1.0), st(1.0), s ~> s.normalize()),
      ControlCase("normalize", st(2.0), st(2.0), s ~> s.normalize()),
    ];
    t = st(16.0);
    scanlines1.eachWithIndex((idx, r) -> vec.push(Scan(t, idx, r)));
    fc = t.contours.first();
    t2 = MTSDF.Shape(Array[fc, triangle(9.0, 3.5, 5.0)], false);
    scanlines2.eachWithIndex((idx, r) ->
      vec.push(Scan(t2, idx, r, MTSDF.EvenOdd()))
    );
    vec.push(EstimateEdgeLength(fc.edges[0], 16.0));
    vec.push(EstimateEdgeLength(fc.edges[1], 17.88854382));
    vec.push(EstimateEdgeLength(fc.edges[2], 17.88854382));
    vec.push(Coloring(t, Array[Array[6, 5, 3]]));
    vec.push(Coloring(t, Array[Array[6, 5, 3]], MTSDF.edgeColoringInkTrap));
    vec.push(Coloring(t, Array[Array[6, 5, 3]], MTSDF.edgeColoringByDistance));
    distanceToPseudoDistance(vec);
    vec.push(
      DirectionCase(
        MTSDF.line(MTSDF.Vector2(10.5312, 0.0), MTSDF.Vector2(2.64062, 0.0)),
        MTSDF.Vector2(-7.89058, 0.0),
        MTSDF.Vector2(-1.0, 0.0),
      ),
    );
    vec.push(
      DirectionCase(
        MTSDF.quad(
          MTSDF.Vector2(10.0781, 22.75),
          MTSDF.Vector2(13.7812, 22.75),
          MTSDF.Vector2(15.6406, 21.2188),
          7,
        ),
        MTSDF.Vector2(3.7031, 0.0),
        MTSDF.Vector2(1.0, 0.0),
        0.0,
      ),
    );
    vec.push(
      DirectionCase(
        MTSDF.quad(
          MTSDF.Vector2(10.0781, 22.75),
          MTSDF.Vector2(13.7812, 22.75),
          MTSDF.Vector2(15.6406, 21.2188),
          7,
        ),
        MTSDF.Vector2(1.8594, -1.5312),
        MTSDF.Vector2(0.771944616, -0.63568979),
        1.0,
      ),
    );
    vec.toArray()
  }
}

fun triangle(size: Float, x: Float = 0.0, y: Float = 0.0): MTSDF.Contour {
  p0 = MTSDF.Vector2(x, y);
  p1 = MTSDF.Vector2(x + size, y);
  p2 = MTSDF.Vector2(x + size / 2.0, y + size);
  MTSDF.Contour(
    Array[MTSDF.line(p0, p1), MTSDF.line(p1, p2), MTSDF.line(p2, p0)],
  )
}

fun distanceToPseudoDistance(vec: mutable Vector<Case>): void {
  vec.push(
    DistanceToPseudoDistance(
      MTSDF.line(MTSDF.Vector2(16.0, 0.0), MTSDF.Vector2(8.0, 16.0)),
      MTSDF.SignedDistance(-8.27345, 0.0270172),
      MTSDF.Vector2(0.5, 12.5),
      1.0125,
      MTSDF.SignedDistance(-8.27345, 0.0),
    ),
  );
  vec.push(
    DistanceToPseudoDistance(
      MTSDF.line(MTSDF.Vector2(8.0, 16.0), MTSDF.Vector2(0.0, 0.0)),
      MTSDF.SignedDistance(-8.27345, 0.0270172),
      MTSDF.Vector2(15.5, 12.5),
      -0.0125,
      MTSDF.SignedDistance(-8.27345, 0.0),
    ),
  );
  vec.push(
    DistanceToPseudoDistance(
      MTSDF.line(MTSDF.Vector2(16.0, 0.0), MTSDF.Vector2(8.0, 16.0)),
      MTSDF.SignedDistance(-7.90569, 0.141421),
      MTSDF.Vector2(0.5, 13.5),
      1.0625,
      MTSDF.SignedDistance(-7.82624, 0.0),
    ),
  );
  vec.push(
    DistanceToPseudoDistance(
      MTSDF.line(MTSDF.Vector2(16.0, 0.0), MTSDF.Vector2(8.0, 16.0)),
      MTSDF.SignedDistance(-6.96419, 0.0963242),
      MTSDF.Vector2(1.5, 13.5),
      1.0375,
      MTSDF.SignedDistance(-6.93181, 0.0),
    ),
  );
  vec.push(
    DistanceToPseudoDistance(
      MTSDF.line(MTSDF.Vector2(16.0, 0.0), MTSDF.Vector2(8.0, 16.0)),
      MTSDF.SignedDistance(-6.04152, 0.0370117),
      MTSDF.Vector2(2.5, 13.5),
      1.0125,
      MTSDF.SignedDistance(-6.03738, 0.0),
    ),
  );
  vec.push(
    DistanceToPseudoDistance(
      MTSDF.line(MTSDF.Vector2(8.0, 16.0), MTSDF.Vector2(0.0, 0.0)),
      MTSDF.SignedDistance(-6.04152, 0.0370117),
      MTSDF.Vector2(13.5, 13.5),
      -0.0125,
      MTSDF.SignedDistance(-6.03738, 0.0),
    ),
  );
  vec.push(
    DistanceToPseudoDistance(
      MTSDF.line(MTSDF.Vector2(8.0, 16.0), MTSDF.Vector2(0.0, 0.0)),
      MTSDF.SignedDistance(-6.96419, 0.0963242),
      MTSDF.Vector2(14.5, 13.5),
      -0.0375,
      MTSDF.SignedDistance(-6.93181, 0.0),
    ),
  );
}

module end;
