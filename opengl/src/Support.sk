class BDrawables(
  value: Array<(GLProgram.Used, GLDrawable)>,
  optViewport: ?Ui.Path,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ BDrawables _ -> x
    | _ -> SKStore.cast_violation("SKUIGL.BDrawables", obj)
    }
  }
}

@debug
fun populateViewport(
  gl: GL.Ctx,
  viewport: Ui.NViewport,
  handles: Array<Array<Ui.Handles>>,
  height: Int,
  ratio: Float,
  frame: Int,
): void {
  top = height - viewport.window.height() - viewport.window.top();
  fLeft = (viewport.window.left().toFloat() * ratio).toInt();
  fTop = (top.toFloat() * ratio).toInt();
  fWidth = (viewport.window.width().toFloat() * ratio).toInt();
  fHeight = (viewport.window.height().toFloat() * ratio).toInt();
  gl.save();
  gl.enableBlend();
  gl.srcAlphaBlendOneMinus();
  gl.viewport(int32(fLeft), int32(fTop), uint32(fWidth), uint32(fHeight));
  fOffset = Ui.Shift(viewport.offset.x, viewport.offset.y);
  fWindow = viewport.window;
  handles.each(hdls ->
    hdls.each(v ->
      v.value.each(handle ->
        handle.draw(fOffset, fWindow, height, ratio, frame)
      )
    )
  );
  gl.flush();
  gl.restore();
}

@debug
fun drawFrame(
  context: readonly SKStore.Context,
  cid: UInt32,
  width: UInt32,
  height: UInt32,
  ratio: UInt32,
  frames: UInt32,
): void {
  fRatio = ratio.toFloat() / 100.0;
  fWidth = (width.toFloat() * fRatio).toInt();
  fHeight = (height.toFloat() * fRatio).toInt();
  ctx = GL.Ctx(cid);
  ctx.bindMainFrameBuffer();
  ctx.enableBlend();
  ctx.straitAlphaBlending();
  ctx.viewport(int32(0), int32(0), uint32(fWidth), uint32(fHeight));
  ctx.clearColor(1.0, 1.0, 1.0, 1.0);
  ctx.clear();
  drawViewports(
    ctx,
    context,
    width.toInt(),
    height.toInt(),
    fRatio,
    frames.toInt(),
  )
}

@debug
fun drawViewports(
  gl: GL.Ctx,
  context: readonly SKStore.Context,
  width: Int,
  height: Int,
  ratio: Float,
  frames: Int,
): void {
  doOnDirectory(context, Ui.viewportsPath, viewportsDir ->
    doOnDirectory(context, layerHandlesPath, layerHandlesDir ->
      doOnDirectory(context, Ui.vpInfosPath, vpInfosDir -> {
        viewportDef = getValue(
          viewportsDir,
          Ui.MainKey(),
          Ui.ViewportDefinition::btype,
        );
        drawViewport(
          gl,
          context,
          viewportDef,
          Ui.NViewport(
            Geometry.Point(0, 0),
            Geometry.Rectangle(
              Geometry.Point(0, 0),
              Geometry.Point(width, height),
            ),
          ),
          width,
          height,
          ratio,
          frames,
          layerHandlesDir,
          vpInfosDir,
        );
      })
    )
  )
}

fun drawViewport(
  gCtx: GL.Ctx,
  context: readonly SKStore.Context,
  viewportDef: Ui.ViewportDefinition,
  absolute: Ui.NViewport,
  width: Int,
  height: Int,
  ratio: Float,
  frames: Int,
  layerHandlesDir: SKStore.EagerDir,
  vpInfosDir: SKStore.EagerDir,
): void {
  vpPath = viewportDef.path;
  if (viewportDef.hasContent()) {
    viewport = getValue(vpInfosDir, vpPath, Ui.NViewport::type);
    currentBounds = viewport.window.translate(absolute.window.min);
    visibleBounds = currentBounds.intersect(absolute.window);
    if (!visibleBounds.isEmpty()) {
      ctxId = gCtx.id.toInt();
      diff = (currentBounds.min - visibleBounds.min);
      toPopulate = Ui.NViewport(viewport.offset + diff, visibleBounds);
      layerHandles = Array[
        CtxLayer(ctxId, Ui.KLayer(vpPath, Ui.BackgroundLayer())),
        CtxLayer(ctxId, Ui.KLayer(vpPath, Ui.MainLayer())),
        CtxLayer(ctxId, Ui.KLayer(vpPath, Ui.ForegroundLayer())),
      ].map(key -> getValues(layerHandlesDir, key, Ui.Handles::type));
      populateViewport(gCtx, toPopulate, layerHandles, height, ratio, frames);
      !absolute = Ui.NViewport(diff, visibleBounds);
    }
  };
  viewportDef.getChildren().each(def ->
    drawViewport(
      gCtx,
      context,
      def,
      absolute,
      width,
      height,
      ratio,
      frames,
      layerHandlesDir,
      vpInfosDir,
    )
  )
}

fun doOnDirectory(
  context: readonly SKStore.Context,
  dirName: SKStore.DirName,
  todo: SKStore.EagerDir -> void,
  ignore: Bool = true,
): void {
  context.unsafeMaybeGetEagerDir(dirName) match {
  | Some(dir) -> todo(dir)
  | _ ->
    if (!ignore) {
      invariant_violation(`${dirName} must be defined.`)
    }
  };
}

fun getValue<T: frozen>(
  dir: SKStore.EagerDir,
  key: SKStore.Key,
  conv: SKStore.File ~> T,
): T {
  conv(dir.getArrayRaw(key).first())
}

fun getValues<T: frozen>(
  dir: SKStore.EagerDir,
  key: SKStore.Key,
  conv: SKStore.File ~> T,
): Array<T> {
  dir.getArrayRaw(key).map(conv)
}

module end;
