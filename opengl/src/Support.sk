module SKUIGL;

const kAlwaysDraw: Bool = false;

const webglPath: SKStore.DirName = SKStore.DirName::create("/ui/fwk/webgl/");
const webglProgramsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/programs/",
);

const webglFilteredProgramsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/programs/filtered/",
);

const webglComputedProgramsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/programs/computed/",
);

const webglComputedBuffersPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/buffers/computed/",
);

const webglComputedArraysPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/arrays/computed/",
);

const layerHandlesPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/layerHandles/",
);

const nodeHandlesPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/nodeHandles/",
);

const ctxHandle: SKStore.IHandle<
  SKStore.Key,
  SKStore.IntFile,
> = SKStore.IHandle(k ~> k, SKStore.IntFile::type, webglPath);

// Draw all frames to allow shader animation
@export("SKIP_SKUIGL_performFrame")
fun performFrame(
  cid: UInt32,
  width: UInt32,
  height: UInt32,
  ratio: UInt32,
  frames: UInt32,
): void {
  pos = SKStore.newObstack();
  current = SKStore.gUnsafeContextsGet();
  drawFrame(current.main, cid, width, height, ratio, frames);
  SKStore.gUnsafeFree(current);
  SKStore.destroyObstack(pos);
}

@export("SKIP_SKUIGL_setWindowContext")
fun setWindowContext(window: UInt32, cid: UInt32): void {
  pos = SKStore.newObstack();
  win = window.toInt();
  key = if (win == 0) Ui.MainKey() else SKStore.IID(win);
  SKStore.Context::withoutGc(context ~>
    ctxHandle.write(context, key, SKStore.IntFile(cid.toInt()))
  );
  SKStore.destroyObstack(pos);
}

class DrawableSupport(
  conv: (Ui.Picture, Bool) ~> ?GL.Texturable,
  pxRange: Int = 8,
) extends Ui.DrawableSupport {
  fun init(
    context: mutable SKStore.Context,
    nodeDrawablesToCheckHdl: SKStore.EHandle<Ui.KLayer, Ui.Drawables>,
  ): void {
    nodeDrawablesHdl = nodeDrawablesToCheckHdl
      .map(
        Ui.KLayer::keyType,
        Ui.Drawables::type,
        context,
        nodeDrawablesToCheckHdl.dirName.sub("orig"),
        (_context, writer, key, it) ~> {
          writer.set(key, it.first.toOrigin())
        },
      )
      .map(
        Ui.KLayer::keyType,
        Ui.Drawables::type,
        context,
        nodeDrawablesToCheckHdl.dirName.sub("check"),
        (context, writer, key, it) ~> {
          drawables = it.first;
          verified = Ui.Drawables(
            drawables.value.map(uiDrawable -> {
              drawable = uiDrawable as GLDrawable _;
              drawable.check(context)
            }),
            drawables.optViewport,
          );
          writer.set(key, verified)
        },
      )
      .map(
        Ui.KLayer::keyType,
        Ui.Drawables::type,
        context,
        nodeDrawablesToCheckHdl.dirName.sub("positionned"),
        (context, writer, key, it) ~> {
          pDrawables = nodeDrawablesToCheckHdl.get(context, key);
          drawables = it.first;
          writer.set(
            key,
            Ui.Drawables(
              pDrawables.value.mapWithIndex((idx, pDrawable) -> {
                drawable = drawables.value[idx];
                drawable.translate((pDrawable as GLDrawable _).getOffset())
              }),
              drawables.optViewport,
            ),
          );
        },
      );
    webglHdl = context.makeDir(
      k ~> k,
      SKStore.IntFile::type,
      webglPath,
      Array[],
    );
    webglProgramsHdl = nodeDrawablesHdl.map(
      k ~> k,
      f ~> f,
      context,
      webglProgramsPath,
      (context, writer, key, it) ~> {
        drawables = it.first;
        webglHdl.maybeGet(context, Ui.MainKey()).each(webgl -> {
          initializer = mutable GLProgram.Initializer();
          prepared = BDrawables(
            drawables.value.map(uiDrawable -> {
              drawable = uiDrawable as GLDrawable _;
              (drawable.prepare(initializer), drawable)
            }),
            drawables.optViewport,
          );
          writer.set(key, prepared);
          initializer.programs.each((k, v) ->
            writer.set(PrgKey(webgl.value, k, v), SKStore.KeyFile(key))
          );
          initializer.buffers.each((k, v) ->
            writer.set(BufKey(webgl.value, k, v), SKStore.KeyFile(key))
          );
          initializer.arrays.each((k, v) ->
            writer.set(ArrayKey(webgl.value, k, v), SKStore.KeyFile(key))
          )
        })
      },
    );
    webglFilteredProgramsHdl = webglProgramsHdl.map(
      k ~> k,
      f ~> f,
      context,
      webglFilteredProgramsPath,
      (_, writer, key, it) ~> {
        key match {
        | BufKey _
        | ArrayKey _
        | PrgKey _ ->
          writer.set(key, SKStore.IntFile(0))
        | _ -> writer.set(key, it.first)
        }
      },
    );
    webglComputedBuffersHdl = webglFilteredProgramsHdl.map(
      BufId::keyType,
      GLProgram.Buffer::type,
      context,
      webglComputedBuffersPath,
      (_, writer, key, _) ~> {
        key match {
        | bk @ BufKey _ ->
          ctx = GL.Ctx(UInt32::truncate(bk.webgl));
          buffer = bk.builder(ctx);
          bid = bk.toBufId();
          writer.set(bid, buffer)
        | _ -> void
        }
      },
    );
    webglComputedArraysHdl = webglFilteredProgramsHdl.map(
      ArrayId::keyType,
      GLProgram.ArrayInfo::type,
      context,
      webglComputedArraysPath,
      (context, writer, key, _) ~> {
        key match {
        | ak @ ArrayKey _ ->
          ctx = GL.Ctx(UInt32::truncate(ak.webgl));
          array = ak.builder(ctx);
          buffer = webglComputedBuffersHdl.get(
            context,
            BufId(ak.webgl, array.buffer.value),
          );
          writer.set(ak.toArrayId(), GLProgram.ArrayInfo(array, buffer))
        | _ -> void
        }
      },
    );
    webglComputedProgramsHdl = webglFilteredProgramsHdl.map(
      PrgId::keyType,
      GLProgram.TriangleProgram::type,
      context,
      webglComputedProgramsPath,
      (_, writer, key, _) ~> {
        key match {
        | pk @ PrgKey _ ->
          gl = GL.Ctx(UInt32::truncate(pk.webgl));
          writer.set(pk.toPrgId(), pk.builder(gl))
        | _ -> void
        }
      },
    );
    nodeHandlesHdl = webglFilteredProgramsHdl.map(
      CtxLayer::keyType,
      Ui.Handles::type,
      context,
      nodeHandlesPath,
      (context, writer, key, it) ~> {
        key match {
        | kLayer @ Ui.KLayer _ ->
          drawables = BDrawables::type(it.first);
          webglHdl.maybeGet(context, Ui.MainKey()).each(webgl -> {
            gl = GL.Ctx(UInt32::truncate(webgl.value));
            supplier = GLProgram.Supplier(name ~>
              SKStore.getWorkingContext().flatMap(ctx ->
                webglComputedProgramsHdl.maybeGet(ctx, PrgId(webgl.value, name))
              )
            );
            tmp = mutable Vector<Ui.Handle>[];
            bufferGetter = id ->
              webglComputedBuffersHdl.maybeGet(context, BufId(webgl.value, id));
            arrayGetter = id ->
              webglComputedArraysHdl.maybeGet(
                context,
                ArrayId(webgl.value, id),
              );
            drawables.value.each(drawable ->
              static::toHandles(
                gl,
                drawable,
                bufferGetter,
                arrayGetter,
                supplier,
                tmp,
              )
            );
            if (!tmp.isEmpty()) {
              writer.set(
                CtxLayer(webgl.value, kLayer),
                Ui.Handles(tmp.toArray(), drawables.optViewport),
              );
            }
          })
        | _ -> void
        }
      },
    );
    _ = nodeHandlesHdl.map(
      CtxLayer::keyType,
      Ui.Handles::type,
      context,
      layerHandlesPath,
      (_, writer, ctxLayer, it) ~> {
        handles = it.first;
        !ctxLayer.layer.path = handles.optViewport.fromSome();
        writer.set(ctxLayer, handles);
      },
    );
  }

  fun ellipse(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
  ): Ui.Drawable {
    paint match {
    | color @ .Color _ ->
      GLDrawable.SolidEllipse(
        color,
        0.5,
        Geometry.Rect::fromOffsetSize(offset, size),
      )
    | _ -> invariant_violation("Not implemented; only Color Fill managed")
    }
  }

  fun disk(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    thickness: Float,
  ): Ui.Drawable {
    paint match {
    | color @ .Color _ ->
      GLDrawable.SolidDisk(
        color,
        thickness,
        0.5,
        Geometry.Rect::fromOffsetSize(offset, size),
      )
    | _ -> invariant_violation("Not implemented; only Color Fill managed")
    }
  }

  fun roundedRectangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    color: .Color,
    radius: Float,
    smooth: Float = 2.0,
    optBorder: ?Ui.Border = None(),
  ): Ui.Drawable {
    GLDrawable.RoundedRectangle(
      color,
      radius,
      smooth,
      optBorder,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun rectangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
  ): Ui.Drawable {
    GLDrawable.rectangle(offset, size, paint)
  }

  fun diagonal(
    offset: Geometry.Offset,
    size: Geometry.Size,
    fromTopLeft: Bool,
    thickness: Float,
    color: .Color,
  ): Ui.Drawable {
    GLDrawable.diagonal(offset, size, fromTopLeft, thickness, color)
  }

  fun triangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    side: .UiSide,
  ): Ui.Drawable {
    GLDrawable.triangle(offset, size, paint, side)
  }

  fun progress(
    offset: Geometry.Offset,
    size: Geometry.Size,
    progress: Float,
    color1: .Color,
    color2: .Color,
    thickness: Float,
  ): Ui.Drawable {
    GLDrawable.Progress(
      progress,
      color1,
      color2,
      thickness,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun loading(
    offset: Geometry.Offset,
    size: Geometry.Size,
    color1: .Color,
    color2: .Color,
    step: Int,
  ): Ui.Drawable {
    GLDrawable.Loading(
      color1,
      color2,
      step,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun boxShadow(
    offset: Geometry.Offset,
    size: Geometry.Size,
    sigma: Float,
    paint: Ui.Paint,
  ): Ui.Drawable {
    paint match {
    | color @ .Color _ ->
      GLDrawable.BoxShadow(
        sigma,
        color,
        Geometry.Rect::fromOffsetSize(offset, size),
      )
    | _ -> invariant_violation("Not implemented; only Color Fill managed")
    }
  }

  fun image(
    offset: Geometry.Offset,
    size: Geometry.Size,
    picture: Ui.Picture,
  ): Ui.Drawable {
    GLDrawable.Bilinear::create(
      ctx ~> this.conv(picture, true).map(t -> t.asTexture(ctx)),
      offset,
      size,
    )
  }

  fun msdf(
    offset: Geometry.Offset,
    size: Geometry.Size,
    picture: Ui.Picture,
    conv: Geometry.Rect ~> Geometry.Rect,
    pxRange: Int,
    thickness: Float,
    paint: Ui.Paint,
  ): Ui.Drawable {
    paint match {
    | color @ .Color _ ->
      GLDrawable.Msdf::create(
        ctx ~> this.conv(picture, true).map(t -> t.asTexture(ctx)),
        conv,
        pxRange,
        color,
        thickness,
        offset,
        size,
      )
    | _ -> invariant_violation("Not implemented; only Color Fill managed")
    }
  }

  fun shape(path: Shape.Path, paint: Ui.Paint): Ui.Drawable {
    bounds = path.getBounds();
    offset = bounds.topLeft();
    GLDrawable.Shape::create(
      path.translate(Geometry.Offset::zero - offset),
      paint,
      this.conv,
      this.pxRange,
      offset,
      bounds.size(),
    )
  }

  static fun toHandles(
    gl: GL.Ctx,
    drawable: (GLProgram.Used, GLDrawable),
    bufferGetter: (id: String) -> ?GLProgram.Buffer,
    arrayGetter: (id: String) -> ?GLProgram.ArrayInfo,
    supplier: GLProgram.Supplier,
    handles: mutable Vector<Ui.Handle>,
  ): void {
    drawable.i0 match {
    | GLProgram.UBuffer(bufId) ->
      bufferGetter(bufId).each(buffer ->
        drawable.i1.build(gl, buffer, supplier).each(handles.push)
      )
    | GLProgram.UArray(arrId) ->
      arrayGetter(arrId).each(array ->
        drawable.i1.build(gl, array, supplier).each(handles.push)
      )
    | GLProgram.UMany(value) ->
      multiple = GLProgram.Multiple(
        value
          .map(elem -> {
            (name, used) = elem;
            used match {
            | GLProgram.UBuffer(bufId) ->
              bufferGetter(bufId).map(buffer -> (name, buffer))
            | GLProgram.UArray(arrId) ->
              arrayGetter(arrId).map(array -> (name, array))
            | GLProgram.UMany _ ->
              invariant_violation("Many of Many ot managed")
            }
          })
          .filterNone(),
      );
      drawable.i1.build(gl, multiple, supplier).each(handles.push)
    }
  }
}

trait Key {
  macro fun toString(): String {
    `${this.webgl}:${this.name}`
  }
}

class CtxLayer(ctxId: Int, layer: Ui.KLayer) extends SKStore.Key {
  fun toString(): String {
    `${this.ctxId}:${this.layer}`
  }
}

class PrgKey(
  webgl: Int,
  name: String,
  builder: GLProgram.Builder,
) extends SKStore.Key uses Key {
  //
  fun toString from Key;

  fun hash(): Int {
    h = this.getClassName().hash();
    !h = Hashable.combine(h, this.webgl);
    Hashable.combine(h, this.name);
  }

  fun compare(other: SKStore.Key): Order {
    other match {
    | oKey @ PrgKey _ ->
      (this.webgl, this.name).compare((oKey.webgl, oKey.name))
    | _ -> this.getClassName().compare(other.getClassName())
    }
  }

  fun toPrgId(): PrgId {
    PrgId(this.webgl, this.name)
  }
}

class PrgId(webgl: Int, name: String) extends SKStore.Key {
  fun toString(): String {
    `${this.webgl}:${this.name}`
  }

  fun hash(): Int {
    h = this.getClassName().hash();
    !h = Hashable.combine(h, this.webgl);
    Hashable.combine(h, this.name);
  }
}

