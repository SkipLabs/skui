base class GLDrawable extends Ui.Drawable {
  overridable fun check(_context: mutable SKStore.Context): GLDrawable {
    this
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used;
  fun build(
    _gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle;

  fun getOffset(): Geometry.Offset;
}

base class GLRectangleDrawable extends Ui.RectangleDrawable, GLDrawable {
  fun getOffset(): Geometry.Offset {
    this.bounds.topLeft()
  }
}
