module GLDrawable;

class SolidEllipse(color: .Color, radius: Float) extends GLRectangleDrawable {
  //
  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.ellipse();
  }

  fun build(
    _gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    buffer = data as GLProgram.Buffer _;
    supplier.ellipseDrawer().map(drawer ->
      Ui.LambdaHandle((shift, window, _height, ratio, _frame) ~> {
        size = this.bounds.size();
        side = Math.max(size.width, size.height) * ratio;
        smooth = Math.min(2.0, side / 16.0);
        precision = smooth / side;
        drawer.run(
          GLProgram.EllipseParameters(
            this.color,
            this.radius * ratio,
            precision,
          ),
          GLProgram.RectangleParameters(
            this.bounds.shift(shift.toOffset()).scale(ratio),
            buffer,
          ),
          window.size() * ratio,
        )
      })
    )
  }
}

class SolidDisk(
  color: .Color,
  thickness: Float,
  radius: Float,
) extends GLRectangleDrawable {
  //
  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.disk();
  }

  fun build(
    _gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    buffer = data as GLProgram.Buffer _;
    supplier.diskDrawer().map(drawer ->
      Ui.LambdaHandle((shift, window, _height, ratio, _frame) ~> {
        size = this.bounds.size();
        side = Math.max(size.width, size.height) * ratio;
        smooth = Math.min(2.0, side / 16.0);
        precision = smooth / side;
        rect = this.bounds.shift(shift.toOffset()).scale(ratio);
        drawer.run(
          GLProgram.DiskParameters(
            rect,
            this.color,
            this.thickness * ratio,
            this.radius * ratio,
            precision,
          ),
          GLProgram.RectangleParameters(rect, buffer),
          window.size() * ratio,
        )
      })
    )
  }
}

module end;
