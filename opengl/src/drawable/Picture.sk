module GLDrawable;

class Bilinear(texture: GL.Ctx ~> ?GL.Texture) extends GLRectangleDrawable {
  //
  static fun create(
    texture: GL.Ctx ~> ?GL.Texture,
    offset: Geometry.Offset,
    size: Geometry.Size,
  ): this {
    static(texture, Geometry.Rect::fromOffsetSize(offset, size))
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.billinear();
  }

  fun build(
    gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    array = data as GLProgram.ArrayInfo _;
    supplier.bilinearDrawer().flatMap(drawer -> {
      this.texture(gl).map(texture -> {
        Ui.LambdaHandle((shift, window, _height, ratio, _frame) ~> {
          array.init(0);
          bounds = this.bounds.shift(shift.toOffset()).scale(ratio);
          drawer.run(
            GLProgram.TextureParameters(texture),
            GLProgram.BoundsParameters(bounds, array.array),
            window.size() * ratio,
          )
        })
      })
    })
  }
}

class Msdf(
  texture: GL.Ctx ~> ?GL.Texture,
  conv: Geometry.Rect ~> Geometry.Rect,
  pxRange: Int,
  color: .Color,
  thickness: Float,
  effects: Ui.TextEffects,
) extends GLRectangleDrawable {
  //
  static fun create(
    texture: GL.Ctx ~> ?GL.Texture,
    conv: Geometry.Rect ~> Geometry.Rect,
    pxRange: Int,
    color: .Color,
    thickness: Float,
    offset: Geometry.Offset,
    size: Geometry.Size,
    effects: Ui.TextEffects = Ui.TextEffects::none,
  ): this {
    static(
      texture,
      conv,
      pxRange,
      color,
      thickness,
      effects,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.msdf();
  }

  fun build(
    gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    array = data as GLProgram.ArrayInfo _;
    supplier.msdfDrawer().flatMap(drawer ->
      this.texture(gl).map(texture ->
        Ui.LambdaHandle((shift, window, _height, ratio, _frame) ~> {
          array.init(0);
          // The rectangle of the MSDF image, in device pixels.
          image = this.conv(this.bounds.shift(shift.toOffset()).scale(ratio));
          effects = this.effects;
          // The quad covers the image and the effects around it.
          margin = Math.ceil(effects.extent() * ratio);
          quad = Geometry.Rect(
            image.left - margin,
            image.top - margin,
            image.right + margin,
            image.bottom + margin,
          );
          toUv = (x, y) ->
            Geometry.Offset(
              (x - image.left) / image.width(),
              (y - image.top) / image.height(),
            );
          uvTopLeft = toUv(quad.left, quad.top);
          uvBottomRight = toUv(quad.right, quad.bottom);
          drawer.run(
            GLProgram.MsdfParameters(
              texture,
              this.pxRange,
              this.color,
              this.thickness * ratio,
              Geometry.Rect(
                uvTopLeft.dx,
                uvTopLeft.dy,
                uvBottomRight.dx,
                uvBottomRight.dy,
              ),
              effects.optOutline.map(o -> (o.color, o.width * ratio)),
              effects.optShadow.map(s ->
                (
                  s.color,
                  Geometry.Offset(
                    s.offset.dx * ratio / image.width(),
                    s.offset.dy * ratio / image.height(),
                  ),
                  s.blur * ratio,
                )
              ),
            ),
            GLProgram.BoundsParameters(quad, array.array),
            window.size() * ratio,
          )
        })
      )
    )
  }
}

class Shape(
  path: Shape.Path,
  paint: Ui.Paint,
  conv: (Ui.Picture, Bool) ~> ?GL.Texturable,
  pxRange: Int,
) extends GLRectangleDrawable {
  //
  static fun create(
    path: Shape.Path,
    paint: Ui.Paint,
    conv: (Ui.Picture, Bool) ~> ?GL.Texturable,
    pxRange: Int,
    offset: Geometry.Offset,
    size: Geometry.Size,
  ): this {
    static(
      path,
      paint,
      conv,
      pxRange,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.msdf();
  }

  fun check(_context: mutable SKStore.Context): GLDrawable {
    (picture, conv) = MTSDF.toMSDF{
      shape => MTSDF.Shape::fromPath(this.path),
      pxRange => this.pxRange,
    };
    width = this.bounds.width();
    Msdf::create(
      ctx ~> this.conv(picture, true).map(t -> t.asTexture(ctx)),
      // r is the rectangle in device pixels: its ratio to the bounds is the
      // device pixel ratio.
      r ~> conv(r, if (width > 0.0) r.width() / width else 1.0),
      this.pxRange,
      this.paint as .Color _,
      0.0,
      this.bounds.topLeft(),
      this.bounds.size(),
    );
  }

  fun build(
    _gl: GL.Ctx,
    _data: GLProgram.Data,
    _supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    invariant_violation("GLDrawable.Shape.build should not be called")
  }
}

module end;
