module GLDrawable;

class Bilinear(texture: GL.Ctx ~> ?GL.Texture) extends GLRectangleDrawable {
  //
  static fun create(
    texture: GL.Ctx ~> ?GL.Texture,
    offset: Geometry.Offset,
    size: Geometry.Size,
  ): this {
    static(texture, Geometry.Rect::fromOffsetSize(offset, size))
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.billinear();
  }

  fun build(
    gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    array = data as GLProgram.ArrayInfo _;
    supplier.bilinearDrawer().flatMap(drawer -> {
      this.texture(gl).map(texture -> {
        Ui.LambdaHandle((shift, window, _height, ratio, _frame) ~> {
          array.init(0);
          bounds = this.bounds.shift(shift.toOffset()).scale(ratio);
          drawer.run(
            GLProgram.TextureParameters(texture),
            GLProgram.BoundsParameters(bounds, array.array),
            window.size() * ratio,
          )
        })
      })
    })
  }
}

class Msdf(
  texture: GL.Ctx ~> ?GL.Texture,
  conv: Geometry.Rect ~> Geometry.Rect,
  pxRange: Int,
  color: .Color,
  thickness: Float,
) extends GLRectangleDrawable {
  //
  static fun create(
    texture: GL.Ctx ~> ?GL.Texture,
    conv: Geometry.Rect ~> Geometry.Rect,
    pxRange: Int,
    color: .Color,
    thickness: Float,
    offset: Geometry.Offset,
    size: Geometry.Size,
  ): this {
    static(
      texture,
      conv,
      pxRange,
      color,
      thickness,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.msdf();
  }

  fun build(
    gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    array = data as GLProgram.ArrayInfo _;
    supplier.msdfDrawer().flatMap(drawer ->
      this.texture(gl).map(texture ->
        Ui.LambdaHandle((shift, window, _height, ratio, _frame) ~> {
          array.init(0);
          rect = this.conv(this.bounds.shift(shift.toOffset()).scale(ratio));
          drawer.run(
            GLProgram.MsdfParameters(
              texture,
              this.pxRange,
              this.color,
              this.thickness * ratio,
            ),
            GLProgram.BoundsParameters(rect, array.array),
            window.size() * ratio,
          )
        })
      )
    )
  }
}

class Shape(
  path: Shape.Path,
  paint: Ui.Paint,
  conv: (Ui.Picture, Bool) ~> ?GL.Texturable,
  pxRange: Int,
) extends GLRectangleDrawable {
  //
  static fun create(
    path: Shape.Path,
    paint: Ui.Paint,
    conv: (Ui.Picture, Bool) ~> ?GL.Texturable,
    pxRange: Int,
    offset: Geometry.Offset,
    size: Geometry.Size,
  ): this {
    static(
      path,
      paint,
      conv,
      pxRange,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.msdf();
  }

  fun check(_context: mutable SKStore.Context): GLDrawable {
    (picture, conv) = MTSDF.toMSDF{
      shape => MTSDF.Shape::fromPath(this.path),
      pxRange => this.pxRange,
    };
    Msdf::create(
      ctx ~> this.conv(picture, true).map(t -> t.asTexture(ctx)),
      r ~> conv(r, 1.0),
      this.pxRange,
      this.paint as .Color _,
      0.0,
      this.bounds.topLeft(),
      this.bounds.size(),
    );
  }

  fun build(
    _gl: GL.Ctx,
    _data: GLProgram.Data,
    _supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    invariant_violation("GLDrawable.Shape.build should not be called")
  }
}

module end;
