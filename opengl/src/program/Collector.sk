module GLProgram;

type GetBuffer = String ~> ?Buffer;
type GetVertexArray = String ~> ?VertexArray;
type Builder = GL.Ctx ~> TriangleProgram;
type GetProgram = String ~> ?TriangleProgram;

class Supplier(programs: GetProgram) {
  //
  fun linearGradientRectangle(count: Int): ?TriangleProgram {
    this.programs(`FWK.LinearGradientRectangleDrawer.${count}`)
  }

  fun radialGradientRectangle(count: Int): ?TriangleProgram {
    this.programs(`FWK.RadialGradientRectangle.${count}`);
  }

  fun textureDrawer(flipped: Bool = false): ?TriangleProgram {
    this.programs(`FWK.TextureDrawer.${flipped}`)
  }

  fun bilinearDrawer(): ?TriangleProgram {
    this.programs("FWK.BilinearDrawer")
  }

  fun msdfDrawer(): ?TriangleProgram {
    this.programs("FWK.MsdfDrawer")
  }

  fun diskDrawer(): ?TriangleProgram {
    this.programs("FWK.SolidDiskDrawer")
  }

  fun ellipseDrawer(): ?TriangleProgram {
    this.programs("FWK.SolidEllipseDrawer");
  }

  fun rectangleDrawer(): ?TriangleProgram {
    this.programs("FWK.SolidRectangleDrawer")
  }

  fun roundedRectangleDrawer(): ?TriangleProgram {
    this.programs("FWK.RoundedRectangleDrawer")
  }

  fun boxShadowDrawer(): ?TriangleProgram {
    this.programs("FWK.BoxShadowDrawer")
  }

  fun glslDrawer(
    program: GLSL.Program,
    version: ?GLSL.Version = None(),
    level: GLSL.Level = GLSL.High(),
  ): ?TriangleProgram {
    this.programs(
      `FWK.GLSL.${program.hash()}.${version
        .default(GLSL.Version())
        .getId()}.${level}`,
    )
  }

  fun radialGradientTriangle(count: Int, side: .UiSide): ?TriangleProgram {
    name = side match {
    | UiSide.Left() -> "left"
    | UiSide.Top() -> "top"
    | UiSide.Right() -> "right"
    | UiSide.Bottom() -> "bottom"
    };
    this.programs(`FWK.RadialGradientTriangle.${count}.${name}`)
  }

  fun linearGradientTriangle(count: Int, side: .UiSide): ?TriangleProgram {
    name = side match {
    | UiSide.Left() -> "left"
    | UiSide.Top() -> "top"
    | UiSide.Right() -> "right"
    | UiSide.Bottom() -> "bottom"
    };
    this.programs(`FWK.LinearGradientTriangle.${count}.${name}`)
  }

  fun solidTriangle(side: .UiSide): ?TriangleProgram {
    name = side match {
    | UiSide.Left() -> "left"
    | UiSide.Top() -> "top"
    | UiSide.Right() -> "right"
    | UiSide.Bottom() -> "bottom"
    };
    this.programs(`FWK.SolidGradientTriangle.${name}`)
  }

  fun progress(): ?TriangleProgram {
    this.programs("FWK.ProgressRectangle");
  }

  fun loading(): ?TriangleProgram {
    this.programs("FWK.LoadingRectangle");
  }

  fun solidVertexes(normalized: Bool): ?TriangleProgram {
    this.programs(`FWK.SolidVertexesDrawer.${normalized}`);
  }
}

base class Used extends SKStore.File {
  children =
  | UBuffer(value: String)
  | UArray(value: String)
  | UMany(value: Array<(String, Used)>)
}

mutable class Initializer(
  programs: mutable Map<String, Builder> = mutable Map[],
  buffers: mutable Map<String, GL.Ctx ~> Buffer> = mutable Map[],
  arrays: mutable Map<String, GL.Ctx ~> VertexArray> = mutable Map[],
) {
  //
  mutable fun linearGradientRectangle(count: Int): Used {
    this.rectangleBase(
      `FWK.LinearGradientRectangleDrawer.${count}`,
      LinearGradientShader(count),
    );
  }

  mutable fun radialGradientRectangle(count: Int): Used {
    this.rectangleBase(
      `FWK.RadialGradientRectangleDrawer.${count}`,
      RadialGradientShader(count),
    );
  }

  mutable fun texture(flipped: Bool = false): Used {
    id = `FWK.TextureDrawer.${flipped}`;
    if (this.programs.maybeGet(id).isNone()) {
      vShader = if (flipped) FlippedShader() else {
        RectangleShader()
      };
      fn = gl ~> triangleProgram(gl, TextureShader(), vShader);
      this.programs.set(id, fn);
    };
    this.rectanglePositionBuffer();
  }

  mutable fun billinear(): Used {
    id = "FWK.BilinearDrawer";
    if (this.programs.maybeGet(id).isNone()) {
      fn = gl ~> triangleProgram(gl, BilinearFragment(), EsRectangleShader());
      this.programs.set(id, fn);
    };
    this.bilinearVertexArray();
  }

  mutable fun msdf(): Used {
    id = "FWK.MsdfDrawer";
    if (this.programs.maybeGet(id).isNone()) {
      fn = gl ~> triangleProgram(gl, MsdfFragment(), EsRectangleShader());
      this.programs.set(id, fn);
    };
    this.bilinearVertexArray();
  }

  mutable fun disk(): Used {
    this.rectangleBase("FWK.SolidDiskDrawer", DiskShader())
  }

  mutable fun ellipse(): Used {
    this.rectangleBase("FWK.SolidEllipseDrawer", EllipseShader())
  }

  mutable fun rectangle(): Used {
    this.rectangleBase("FWK.SolidRectangleDrawer", SolidShader())
  }

  mutable fun roundedRectangle(): Used {
    this.rectangleBase("FWK.RoundedRectangleDrawer", RoundedRectangleShader())
  }

  mutable fun glsl(
    program: GLSL.Program,
    version: ?GLSL.Version = None(),
    level: GLSL.Level = GLSL.High(),
  ): Used {
    id = `FWK.GLSL.${program.hash()}.${version
      .default(GLSL.Version())
      .getId()}.${level}`;
    vertexShader = program.toVertexShader(level);
    if (this.programs.maybeGet(id).isNone()) {
      vShader = GLSL.VertexShaderBuilder(
        vertexShader,
        program.getVertexSize(),
        version,
      );
      fShader = GLSL.FragmentShaderBuilder(
        program.toFragmentShader(level),
        version,
      );
      fn = gl ~> triangleProgram(gl, fShader, vShader);
      this.programs.set(id, fn);
    };
    es = version.map(v -> v.es).default(false);
    UMany(
      vertexShader.attributes.map(a -> {
        builder = program.getAttributeBuilder(a);
        (
          a.getName(),
          if (es) {
            this.array(builder.getName(), builder.build)
          } else {
            this.buffer(builder.getName(), builder.build)
          },
        )
      }),
    )
  }

  mutable fun boxShadow(): Used {
    id = "FWK.BoxShadowDrawer";
    if (this.programs.maybeGet(id).isNone()) {
      vShader = ShadowVertexShader();
      fn = gl ~> triangleProgram(gl, ShadowShader(), vShader);
      this.programs.set(id, fn);
    };
    this.rectanglePositionBuffer();
  }

  mutable fun radialGradientTriangle(count: Int, side: .UiSide): Used {
    this.triangleBase(
      `FWK.RadialGradientTriangle.${count}`,
      side,
      RadialGradientShader(count),
    );
  }

  mutable fun linearGradientTriangle(count: Int, side: .UiSide): Used {
    this.triangleBase(
      `FWK.LinearGradientTriangle.${count}`,
      side,
      LinearGradientShader(count),
    );
  }

  mutable fun solidTriangle(side: .UiSide): Used {
    this.triangleBase("FWK.SolidGradientTriangle", side, SolidShader());
  }

  mutable fun progress(): Used {
    this.rectangleBase("FWK.ProgressRectangle", ProgressShader());
  }

  mutable fun loading(): Used {
    this.rectangleBase("FWK.LoadingRectangle", LoadingShader());
  }

  mutable fun solidVertexes(
    vertexes: Array<Geometry.Offset>,
    normalized: Bool,
  ): Used {
    bHash = vertexes.hash();
    bId = `FWK.Vertexes.${bHash}`;
    if (this.buffers.maybeGet(bId).isNone()) {
      fn = gl ~> Buffer(vertexesPositionBuffer(gl, vertexes));
      this.buffers.set(bId, fn)
    };
    id = `FWK.SolidVertexesDrawer.${normalized}`;
    if (this.programs.maybeGet(id).isNone()) {
      fn = gl ~> triangleProgram(gl, SolidShader(), VertexesShader(normalized));
      this.programs.set(id, fn);
    };
    UBuffer(bId)
  }

  private mutable fun rectangleBase(
    id: String,
    fShader: FragmentShaderBuilder,
  ): Used {
    if (this.programs.maybeGet(id).isNone()) {
      vShader = RectangleShader();
      fn = gl ~> triangleProgram(gl, fShader, vShader);
      this.programs.set(id, fn);
    };
    this.rectanglePositionBuffer();
  }

  private mutable fun triangleBase(
    prefix: String,
    side: .UiSide,
    fShader: FragmentShaderBuilder,
  ): Used {
    name = side match {
    | UiSide.Left() -> "left"
    | UiSide.Top() -> "top"
    | UiSide.Right() -> "right"
    | UiSide.Bottom() -> "bottom"
    };
    id = `${prefix}.${name}`;
    if (this.programs.maybeGet(id).isNone()) {
      vShader = TriangleShader(side);
      fn = gl ~> triangleProgram(gl, fShader, vShader);
      this.programs.set(id, fn);
    };
    this.trianglePositionBuffer(side);
  }

  // VertexArray

  mutable fun array(id: String, builder: GLSL.Ctx ~> GLSL.Buffer): UArray {
    if (this.arrays.maybeGet(id).isNone()) {
      buffer = this.buffer(id, builder);
      fn = gl ~> VertexArray(GL.VertexArray::create(gl), buffer);
      this.arrays.set(id, fn)
    };
    UArray(id)
  }

  mutable fun bilinearVertexArray(): Used {
    id = "FWK.BilinearVertexArray";
    if (this.arrays.maybeGet(id).isNone()) {
      positions = this.rectanglePositionBuffer();
      fn = gl ~> VertexArray(GL.VertexArray::create(gl), positions);
      this.arrays.set(id, fn)
    };
    UArray(id)
  }

  // Buffers

  mutable fun buffer(id: String, builder: GLSL.Ctx ~> GLSL.Buffer): UBuffer {
    if (this.buffers.maybeGet(id).isNone()) {
      fn = gl ~> Buffer(builder(gl) as GL.Buffer _);
      this.buffers.set(id, fn)
    };
    UBuffer(id)
  }

  mutable fun rectanglePositionBuffer(): UBuffer {
    this.buffer("FWK.RectanglePositionBuffer", (gl) ~>
      gl.rectanglePositionBuffer()
    );
  }

  mutable fun trianglePositionBuffer(side: .UiSide): UBuffer {
    name = side match {
    | UiSide.Left() -> "left"
    | UiSide.Top() -> "top"
    | UiSide.Right() -> "right"
    | UiSide.Bottom() -> "bottom"
    };
    id = `FWK.TrianglePositionBuffer.${name}`;
    if (this.buffers.maybeGet(id).isNone()) {
      fn = gl ~> Buffer(trianglePositionBuffer(gl, side));
      this.buffers.set(id, fn)
    };
    UBuffer(id)
  }
}

module end;
