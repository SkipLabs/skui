module GLProgram;

const textureFramentShader: String = source(
  Array[
    "precision highp float;",
    "varying vec2 v_position;",
    "uniform sampler2D u_texture;",
    "void main() {",
    "  gl_FragColor = texture2D(u_texture, v_position);",
    "}",
    "",
  ],
);

const flippedVertexShader: String = source(
  Array[
    "attribute vec4 a_position;",
    "uniform mat4 u_matrix;",
    "varying vec2 v_position;",
    "void main() {",
    "  gl_Position = u_matrix * a_position;",
    "  v_position = vec2(a_position.x, 1.0 - a_position.y);",
    "}",
    "",
  ],
);

const esVertexShader: String = source(
  Array[
    "#version 300 es",
    "#define POSITION_LOCATION 0",
    "",
    "precision highp float;",
    "",
    "uniform mat4 u_matrix;",
    "",
    "layout(location = POSITION_LOCATION) in vec2 position;",
    "",
    "out vec2 v_position;",
    "",
    "void main()",
    "{",
    "  v_position = position;",
    "  gl_Position = u_matrix * vec4(position, 0.0, 1.0);",
    "}",
  ],
);

const texelFramentShader: String = source(
  Array[
    "#version 300 es",
    "precision highp float;",
    "precision highp int;",
    "",
    "uniform sampler2D u_texture;",
    "",
    "in vec2 v_position;",
    "",
    "out vec4 glColor;",
    "",
    "void main()",
    "{",
    "  vec2 size = vec2(textureSize(u_texture, 0) - 1);",
    "  vec2 texcoord = v_position * size;",
    "  ivec2 coord = ivec2(texcoord);",
    "",
    "  vec4 texel00 = texelFetch(u_texture, coord + ivec2(0, 0), 0);",
    "  vec4 texel10 = texelFetch(u_texture, coord + ivec2(1, 0), 0);",
    "  vec4 texel11 = texelFetch(u_texture, coord + ivec2(1, 1), 0);",
    "  vec4 texel01 = texelFetch(u_texture, coord + ivec2(0, 1), 0);",
    "",
    "  vec2 sampleCoord = fract(texcoord.xy);",
    "",
    "  vec4 texel0 = mix(texel00, texel01, sampleCoord.y);",
    "  vec4 texel1 = mix(texel10, texel11, sampleCoord.y);",
    "",
    "  glColor = mix(texel0, texel1, sampleCoord.x);",
    "}",
  ],
);

const msdfFramentShader: String = source(
  Array[
    "#version 300 es",
    "precision highp float;",
    "",
    "uniform sampler2D u_texture;",
    "uniform vec4 u_color;",
    "uniform float u_pxRange;",
    "uniform float u_thickness;",
    // The texture coordinates of the corners of the drawn quad: the quad is
    // larger than the glyph image when effects extend beyond it.
    "uniform vec4 u_uvBox;",
    // Outline: color, and width in device pixels (0 for none).
    "uniform vec4 u_outlineColor;",
    "uniform float u_outlineWidth;",
    // Shadow: color (alpha 0 for none), offset in texture coordinates, and
    // blur width in device pixels.
    "uniform vec4 u_shadowColor;",
    "uniform vec2 u_shadowOffset;",
    "uniform float u_shadowBlur;",
    "",
    "in vec2 v_position;",
    "",
    "out vec4 glColor;",
    "",
    "float median(float r, float g, float b) {",
    "  return max(min(r, g), min(max(r, g), b));",
    "}",
    "",
    // Device pixels per unit of signed distance.
    "float screenPxRange(vec2 uv) {",
    "  ivec2 size = textureSize(u_texture, 0);",
    "  vec2 unitRange = vec2(u_pxRange) / vec2(float(size.x), float(size.y));",
    "  vec2 screenTexSize = vec2(1.0) / fwidth(uv);",
    "  return max(0.5 * dot(unitRange, screenTexSize), 1.0);",
    "}",
    "",
    // Outside the texture, the distance is the largest one it holds.
    "vec4 sampleSdf(vec2 uv) {",
    "  if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) {",
    "    return vec4(0.0);",
    "  }",
    "  return texture(u_texture, uv);",
    "}",
    "",
    // Premultiplied over.
    "vec4 over(vec4 top, vec4 bottom) {",
    "  return top + bottom * (1.0 - top.a);",
    "}",
    "",
    "void main() {",
    "  vec2 uv = u_uvBox.xy + v_position * u_uvBox.zw;",
    "  float range = screenPxRange(uv);",
    "  vec4 sdf = sampleSdf(uv);",
    "  vec3 msd = sdf.rgb + clamp(u_thickness, -0.5, 0.5);",
    "  float fillDistance = range * (median(msd.r, msd.g, msd.b) - 0.5);",
    "  float fill = clamp(fillDistance + 0.5, 0.0, 1.0);",
    "  vec4 color = vec4(u_color.rgb, 1.0) * u_color.a * fill;",
    "  if (u_outlineWidth > 0.0) {",
    "    float trueDistance = range * (sdf.a - 0.5);",
    "    float outline = clamp(trueDistance + u_outlineWidth + 0.5, 0.0, 1.0);",
    "    vec4 outlineColor = vec4(u_outlineColor.rgb, 1.0) * u_outlineColor.a;",
    "    color = over(color, outlineColor * outline);",
    "  }",
    "  if (u_shadowColor.a > 0.0) {",
    "    float shadowDistance = range * (sampleSdf(uv - u_shadowOffset).a - 0.5);",
    "    float blur = max(u_shadowBlur, 1.0);",
    "    float shadow = clamp(shadowDistance / blur + 0.5, 0.0, 1.0);",
    "    vec4 shadowColor = vec4(u_shadowColor.rgb, 1.0) * u_shadowColor.a;",
    "    color = over(color, shadowColor * shadow);",
    "  }",
    "  glColor = color.a > 0.0 ? vec4(color.rgb / color.a, color.a) : vec4(0.0);",
    "}",
  ],
);

class FlippedShader() extends RectangleBaseShader {
  fun source(): String {
    flippedVertexShader
  }

  fun getSize(): Int {
    6
  }
}

class TextureParameters(texture: GL.Texture) extends Parameters {
  //
  static fun fromParams(obj: Parameters): this {
    obj match {
    | x @ TextureParameters _ -> x
    | _ ->
      invariant_violation(
        `Must be GLProgram.TextureParameters got ${obj.getClassName()}`,
      )
    }
  }
}

// uvBox is the texture coordinates of the drawn quad corners (left, top,
// width, height); the outline width and shadow blur are in device pixels and
// the shadow offset in texture coordinates.
class MsdfParameters(
  texture: GL.Texture,
  pxRange: Int,
  color: .Color,
  thickness: Float,
  uvBox: Geometry.Rect = Geometry.Rect(0.0, 0.0, 1.0, 1.0),
  optOutline: ?(.Color, Float) = None(),
  optShadow: ?(.Color, Geometry.Offset, Float) = None(),
) extends Parameters {
  //
  static fun fromParams(obj: Parameters): this {
    obj match {
    | x @ MsdfParameters _ -> x
    | _ ->
      invariant_violation(
        `Must be GLProgram.MsdfParameters got ${obj.getClassName()}`,
      )
    }
  }
}

class BoundsParameters(rect: Geometry.Rect) extends LayoutVertexParams {
  static fun fromParams(obj: Parameters): this {
    obj match {
    | x @ BoundsParameters _ -> x
    | _ ->
      invariant_violation(
        `Must be GLProgram.BoundsParameters got ${obj.getClassName()}`,
      )
    }
  }
}

base class BoundsBaseShader extends VertexShaderBuilder {
  //
  fun getSize(): Int;

  fun build(program: GL.Prepared): VertexShader {
    // lookup uniforms
    matrixLocation = program.getIdxUniformLocation(uMatrix);
    LamLayoutVertexShader(
      (parameters, window) ~> {
        ctx = program.context();
        rectParams = parameters as BoundsParameters _;
        rect = rectParams.rect;
        updateMatrix(ctx, rect, window, matrixLocation);
        this.getSize();
      },
      () ~> void,
    )
  }
}

class TextureShader() extends FragmentShaderBuilder {
  fun source(): String {
    textureFramentShader
  }

  fun build(program: GL.Prepared): FragmentShader {
    textureLocation = program.getIdxUniformLocation(uTexture);
    LambdaFragmentShader((parameters, _) ~> {
      gl = program.context();
      tps = TextureParameters::fromParams(parameters);
      activateTexture(gl, 0, tps.texture, textureLocation);
    });
  }
}

class EsRectangleShader() extends BoundsBaseShader {
  fun source(): String {
    esVertexShader
  }

  fun getSize(): Int {
    6
  }
}

class BilinearFragment() extends FragmentShaderBuilder {
  fun source(): String {
    texelFramentShader
  }

  fun build(program: GL.Prepared): FragmentShader {
    textureLocation = program.getIdxUniformLocation(uTexture);
    LambdaFragmentShader((parameters, _) ~> {
      gl = program.context();
      tps = TextureParameters::fromParams(parameters);
      activateTexture(gl, 0, tps.texture, textureLocation);
    });
  }
}

class MsdfFragment() extends FragmentShaderBuilder {
  fun source(): String {
    msdfFramentShader
  }

  fun build(program: GL.Prepared): FragmentShader {
    textureUniform = program.getIdxUniformLocation(uTexture);
    colorUniform = program.getIdxUniformLocation(uColor);
    pxRangeUniform = program.getIdxUniformLocation(uPxRange);
    thicknessUniform = program.getIdxUniformLocation(uThickness);
    uvBoxUniform = program.getIdxUniformLocation(uUvBox);
    outlineColorUniform = program.getIdxUniformLocation(uOutlineColor);
    outlineWidthUniform = program.getIdxUniformLocation(uOutlineWidth);
    shadowColorUniform = program.getIdxUniformLocation(uShadowColor);
    shadowOffsetUniform = program.getIdxUniformLocation(uShadowOffset);
    shadowBlurUniform = program.getIdxUniformLocation(uShadowBlur);
    LambdaFragmentShader((parameters, _) ~> {
      gl = program.context();
      ps = MsdfParameters::fromParams(parameters);
      activateTexture(gl, 0, ps.texture, textureUniform);
      setColor = (uniform: GL.UniformLocation, color: .Color) ->
        gl.uniform4f(uniform, color.red, color.green, color.blue, color.alpha);
      setColor(colorUniform, ps.color);
      gl.uniform1f(pxRangeUniform, ps.pxRange.toFloat());
      gl.uniform1f(thicknessUniform, ps.thickness.toFloat());
      gl.uniform4f(
        uvBoxUniform,
        ps.uvBox.left,
        ps.uvBox.top,
        ps.uvBox.width(),
        ps.uvBox.height(),
      );
      ps.optOutline match {
      | Some((color, width)) ->
        setColor(outlineColorUniform, color);
        gl.uniform1f(outlineWidthUniform, width)
      | None() -> gl.uniform1f(outlineWidthUniform, 0.0)
      };
      ps.optShadow match {
      | Some((color, offset, blur)) ->
        setColor(shadowColorUniform, color);
        gl.uniform2f(shadowOffsetUniform, offset.dx, offset.dy);
        gl.uniform1f(shadowBlurUniform, blur)
      | None() -> gl.uniform4f(shadowColorUniform, 0.0, 0.0, 0.0, 0.0)
      };
    });
  }
}

@debug
fun activateTexture(
  gl: GL.Ctx,
  chanel: Int,
  texture: GLSL.Texture,
  location: GL.UniformLocation,
): void {
  gl.activeTexture(uint32(chanel));
  texture.bind();
  gl.uniform1i(location, int32(chanel));
}

@debug
fun activateTextures(
  gl: GL.Ctx,
  textures: Array<GLSL.Texture>,
  location: GL.UniformLocation,
): void {
  if (textures.isEmpty()) {
    return void
  };
  size = textures.size();
  gl.uniform1iv(
    location,
    uint32(size),
    Array::fillBy(size, chanel -> {
      gl.activeTexture(uint32(chanel));
      textures[chanel].bind();
      int32(chanel)
    }),
  );
}

module end;
