module SkuiBaseBuild;

@skbuild_source_dirs
fun source_dirs(env: Skbuild.Env): Array<String> {
  if (!env.isWasm32()) {
    Array["native/src"]
  } else {
    Array["wasm/src"]
  }
}

@skbuild_include_dirs
fun include_dirs(env: Skbuild.Env): Array<String> {
  if (!env.isWasm32()) {
    Array["native/src/includes"]
  } else {
    Array[]
  }
}

@skbuild_links
fun links(env: Skbuild.Env): Array<String> {
  if (!env.isWasm32()) {
    Array["-lssl", "-lcrypto"]
  } else {
    Array[]
  }
}

@skbuild_extra_sources
fun extra_sources(env: Skbuild.Env): Array<String> {
  path = if (env.isWasm32()) {
    env.resolve("extra/src/Wasm32.sk")
  } else {
    env.resolve("extra/src/Host.sk")
  };
  Array[path]
}

module end;

@debug
fun main(): void {
  Skbuild.build() match {
  | Failure(err) -> skipExit(err.code)
  | _ -> void
  }
}
