{
  "skipVersion": "1.0",
  "variables": {
    "backend": {
      "values": ["native"],
      "default": "native"
    }
  },
  "programUnits": {
    "skui_base": {
      "kind": "Library",
      "sources": ["src"],
      "references": [
        { "path": ".", "name": "prelude"},
        { "path": ".", "name": "skfs"}
      ]
    },
    "skfs": {
      "kind": "Library",
      "sources": [
        "../skfs/src/**"
      ],
      "references": []
    },
    "prelude": {
      "kind": "Library",
      "sources": [
        "../prelude/src/Runtime.sk",
        "../prelude/src/core/**",
        "../prelude/src/stdlib/**"
      ],
      "parameters": {
        "backend": {
            "native": {"sources": ["../prelude/src/native"]}
        }
      },
      "references": []
    }
  },
  "default": "skui_base"
}
