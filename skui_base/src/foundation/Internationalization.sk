base class Text uses Hashable, Orderable, Show {}

type Dictionary = (mutable SKFS.Context, String) ~> ?String;

base class LocaleBase extends Text {
  fun toLocalized(i18n: I18N): String;

  fun translate(context: mutable SKFS.Context, dictionary: Dictionary): String;
}

class Raw(text: String) extends Text {
  //
  fun toString(): String {
    this.text
  }
}

class Texts(texts: Array<Text>) extends Text {
  //
  fun toString(): String {
    this.texts.map(txt -> txt.toString()).join("");
  }
}

class LocaleText(
  text: String,
  optCategory: ?String = None(),
) extends LocaleBase {
  fun toLocalized(i18n: I18N): String {
    i18n.getText(this.text, this.optCategory);
  }

  fun translate(context: mutable SKFS.Context, dictionary: Dictionary): String {
    I18N.localized(context, dictionary, this.text, this.optCategory);
  }

  fun toString(): String {
    this.text
  }
}

class Format(
  format: Text,
  parameters: Array<Text> = Array[],
) extends LocaleBase {
  fun toLocalized(i18n: I18N): String {
    format = i18n.translate(this.format);
    // TODO: In one cross
    this.parameters.eachWithIndex((index, parameter) ->
      !format = format.replace(`{${index + 1}}`, i18n.translate(parameter))
    );
    format;
  }

  fun toString(): String {
    format = this.format.toString();
    this.parameters.eachWithIndex((index, parameter) ->
      !format = format.replace(`{${index + 1}}`, parameter.toString())
    );
    format
  }

  fun translate(context: mutable SKFS.Context, dictionary: Dictionary): String {
    format = I18N.translate(context, dictionary, this.format);
    this.parameters.eachWithIndex((index, parameter) ->
      !format = format.replace(
        `{${index + 1}}`,
        I18N.translate(context, dictionary, parameter),
      )
    );
    format;
  }
}

base class I18NExceptionBase(message: Text) extends Exception {
  fun getMessage(): String {
    this.message.toString();
  }
}

class I18NException extends I18NExceptionBase {}

base class I18N() uses Hashable, Equality {
  fun getDefaultLocale(): Locale;

  fun translate(text: Text): String {
    text match {
    | texts @ Texts _ ->
      texts.texts.reduce((acc, value) -> acc + this.translate(value), "")
    | Raw(raw) -> raw
    | local @ LocaleBase _ -> local.toLocalized(this)
    }
  }

  fun getTextForLocale(
    text: String,
    locale: Locale,
    category: ?String = None(),
  ): String;
  fun getText(text: String, category: ?String = None()): String {
    this.getTextForLocale(text, this.getDefaultLocale(), category);
  }
}

class NoI18N() extends I18N {
  fun getDefaultLocale(): Locale {
    Locale{language => Language::make("en_US")}
  }
  fun getTextForLocale(
    text: String,
    _locale: Locale,
    _category: ?String = None(),
  ): String {
    text
  }
}

extension class String {
  fun !(): Text {
    LocaleText(this)
  }

  fun isBlank(): Bool {
    this.chars().all(c -> Char.isWhitespace(c));
  }

  fun dropLeft(count: Int): String {
    String::fromChars(this.chars().drop(count).toArray());
  }

  fun toBytes(): Array<UInt8> {
    vec = mutable Vector<UInt8>[];
    this.chars().each(c ->
      c.utf8Encode().each(i -> vec.push(UInt8::truncate(i)))
    );
    vec.toArray();
  }
}

module SKFS;

fun normalize(text: String, allowSlash: Bool = false): String {
  if (text.isEmpty()) {
    return "_"
  };
  nChars = text.chars().map(c -> {
    if (
      (c >= 'a' && c <= 'z') ||
      (c >= 'A' && c <= 'Z') ||
      c == '_' ||
      (c >= '0' && c <= '9') ||
      (allowSlash && c == '/')
    ) {
      c
    } else {
      '_'
    }
  });
  String::fromChars(nChars.toArray())
}

module end;

module I18N;

@wasm_export
@cpp_export
fun text(text: String, optCategory: ?String): Text {
  LocaleText(text, optCategory)
}

@wasm_export
@cpp_export
fun raw(text: String): Text {
  Raw(text)
}

@wasm_export
@cpp_export
fun format(format: Text, parameters: Vector<Text>): Text {
  Format(format, parameters.toArray())
}

@wasm_export
@cpp_export
fun textVector(): mutable Vector<Text> {
  mutable Vector<Text>[]
}

@wasm_export
@cpp_export
fun pushText(v: mutable Vector<Text>, text: Text): void {
  v.push(text);
}

fun localized(
  context: mutable SKFS.Context,
  dictionary: Dictionary,
  text: String,
  optCategory: ?String = None(),
): String {
  entry = optCategory.map(category -> `${category}:${text}`).default(text);
  dictionary(context, SKFS.normalize(entry)).default(text)
}

fun translate(
  context: mutable SKFS.Context,
  dictionary: Dictionary,
  text: Text,
): String {
  //;
  text match {
  | texts @ Texts _ ->
    texts.texts.reduce(
      (acc, value) -> acc + translate(context, dictionary, value),
      "",
    )
  | Raw(raw) -> raw
  | local @ LocaleBase _ -> local.translate(context, dictionary)
  }
}

module end;
