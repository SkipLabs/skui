module SKUIMessage;

type Supplier = mutable SKFS.Context ~> Message;

base class Repeat {
  fun isRepeating(context: mutable SKFS.Context): Bool;
}

class MessagesChecker(fn: () ~> void) extends SKFS.File

class Sender(
  fn: (
    readonly SKFS.Context,
    message: String,
    asyncMode: Bool,
    delay: UInt32,
  ) ~> Bool,
) extends SKFS.File

base class Command extends JSONValue uses HasClassName {
  overridable fun isExternal(): Bool {
    false
  }
}

class Custom(fields: Map<String, JSON.Value>) extends Command {
  fun toJSON(): JSON.Value {
    JSON.Object(this.fields)
  }
}

class DummyCommand() extends Command {
  fun toJSON(): JSON.Value {
    dummy()
  }
}

base class Support extends SKFS.File uses HasClassName {
  overridable fun init(_context: mutable SKFS.Context): void {
    void
  }

  fun run(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    command: Command,
  ): void;

  fun manage(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    message: JSON.Value,
  ): void;

  fun cancel(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    message: JSON.Value,
  ): void;

  static fun forFile(obj: SKFS.File): Support {
    obj match {
    | x @ Support _ -> x
    | _ -> SKFS.cast_violation("SKUIMessage.Support", obj)
    }
  }
}

trait WithUpdate<T: Command> extends HasClassName {
  protected fun execute(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    command: T,
  ): void;

  overridable protected fun performCancel(
    _context: mutable SKFS.Context,
    _name: String,
    _scope: String,
    _command: T,
  ): void {
    void
  }

  protected fun convert(message: JSON.Value): T;
  protected fun convertCmd(command: Command): T;

  overridable protected fun profile(): Bool {
    false
  }

  fun manage(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    message: JSON.Value,
  ): void {
    if (this.profile()) {
      SKFS.profileCall(context, `${this.getClassName()}.manage`, () -> {
        this.execute(context, name, scope, this.convert(message));
        context.updateIfRoot();
      });
    } else {
      this.execute(context, name, scope, this.convert(message));
      context.updateIfRoot();
    }
  }

  fun cancel(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    message: JSON.Value,
  ): void {
    if (this.profile()) {
      SKFS.profileCall(context, `${this.getClassName()}.manage`, () -> {
        this.performCancel(context, name, scope, this.convert(message));
        context.updateIfRoot();
      });
    } else {
      this.performCancel(context, name, scope, this.convert(message));
      context.updateIfRoot();
    }
  }

  fun run(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    command: Command,
  ): void {
    !command = command match {
    | Custom(fields) -> this.convert(JSON.Object(fields))
    | _ -> command
    };
    function = () -> {
      this.execute(context, name, scope, this.convertCmd(command));
      context.updateIfRoot();
    };
    if (this.profile()) {
      SKFS.profileCall(context, `${this.getClassName()}.run`, function);
    } else {
      function()
    }
  }
}

fun performMessage(
  context: mutable SKFS.Context,
  strModule: String,
  strScope: String,
  jsCommand: JSON.Value,
): void {
  context.getMessageSupport(strModule, strScope) match {
  | Some(support) -> support.manage(context, strModule, strScope, jsCommand)
  | _ ->
    context.getMessageSupport(strModule, "*") match {
    | Some(support) -> support.manage(context, strModule, strScope, jsCommand)
    | _ ->
      //TODO manage missed message log ???
      print_error(
        `Missed message[${
          context.tick
        }]: (No message support) for ${strModule} ${strScope}`,
      )
    }
  }
}

fun executeMessage(context: mutable SKFS.Context, jsv: JSON.Value): void {
  jsv match {
  | jso @ JSON.Object _ ->
    (strModule, strScope, jsCommand) = jso.maybeGetString("__class") match {
    | Some("SKUIMessage.Message") ->
      (jso.getString("name"), jso.getString("scope"), jso.get("command"))
    | _ -> (jso.getString("module"), jso.getString("scope"), jso.get("message"))
    };
    performMessage(context, strModule, strScope, jsCommand)
  | JSON.IntNumber(v) ->
    context.getInternalMessage(v) match {
    | Some(message) ->
      performMessage(
        context,
        message.name,
        message.scope,
        message.command.toJSON(),
      )
    | _ ->
      print_error(
        `Missed message[${context.tick}]: (Unknown internal message) ${v}`,
      )
    }
  | _ -> SKFS.cast_violation("JSON.Object | JSON.IntNumber", jsv)
  }
}

fun cancelMessage(context: mutable SKFS.Context, message: String): void {
  jso = JSON.decode(message).expectObject();
  (strModule, strScope, jsCommand) = jso.maybeGetString("__class") match {
  | Some("SKUIMessage.Message") ->
    (jso.getString("name"), jso.getString("scope"), jso.get("command"))
  | _ -> (jso.getString("module"), jso.getString("scope"), jso.get("message"))
  };
  context.getMessageSupport(strModule, strScope) match {
  | Some(support) -> support.cancel(context, strModule, strScope, jsCommand)
  | _ ->
    context.getMessageSupport(strModule, "*") match {
    | Some(support) -> support.cancel(context, strModule, strScope, jsCommand)
    | _ ->
      //TODO manage missed message log ???
      print_error(
        `Missed cancelation[${
          context.tick
        }]: (No message support) for ${strModule} ${strScope}`,
      )
    }
  }
}

@wasm_export("SKIP_SKUIMessage_manage")
@wasm_export("SKIP_SKUIMessage_manage")
fun manage(message: String): void {
  SKFS.Context::withoutGc(context ~> {
    jsv = vtry<JSON.Value>(
      () -> JSON.decode(message),
      e -> {
        print_error(
          `Missed message[${context.tick}]: (${e.getMessage()}) ${if (
            message.length() > 256
          ) message.sub(message.getIter(), 256) + "..." else {
            message
          }}`,
        );
        throw e
      },
    );
    catchErrors = context.getBoolGlobal("SKUIMessage.catchErrors");
    if (catchErrors) {
      vtry<void>(
        () -> executeMessage(context, jsv),
        e ->
          //TODO manage missed message log ???
          print_error(
            `Missed message[${context.tick}]: (${e.getMessage()}) ${if (
              message.length() > 256
            ) message.sub(message.getIter(), 256) + "..." else {
              message
            }}`,
          )
        ,
      )
    } else {
      executeMessage(context, jsv)
    }
  });
}

@debug
@wasm_export("SKIP_SKUIMessage_messageFailure")
@cpp_export("SKIP_SKUIMessage_messageFailure")
fun messageFailure(message: String): void {
  SKFS.Context::withoutGc(context ~> {
    catchErrors = context.getBoolGlobal("SKUIMessage.catchErrors");
    if (catchErrors) {
      vtry<void>(
        () -> cancelMessage(context, message),
        e ->
          //TODO manage missed message log ???
          print_error(
            `Missed cancelation[${
              context.tick
            }]: (${e.getMessage()}) ${message}`,
          )
        ,
      )
    } else {
      cancelMessage(context, message)
    }
  });
}

fun send(
  context: readonly SKFS.Context,
  message: String,
  asyncMode: Bool,
  delay: UInt32,
): Bool {
  context
    .getGlobal("SKUIMessage.Sender")
    .map(Sender::fromFile)
    .map(sender -> sender.fn(context, message, asyncMode, delay))
    .default(false)
}

class Message(
  name: String,
  scope: String,
  command: Command,
  optDelay: ?Int = None(),
) extends SKFS.File uses HasClassName {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Message _ -> x
    | _ -> SKFS.cast_violation("SKUIMessage.Message", obj)
    }
  }

  fun toJSON(): JSON.Value {
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "name" => JSON.String(this.name),
        "scope" => JSON.String(this.scope),
        "command" => this.command.toJSON(),
        "delay" => this.optDelay.map(delay -> JSON.IntNumber(delay)).default(
          JSON.Null(),
        ),
      ].filter((_k, v) -> !v.isNull()),
    )
  }

  static fun fromJSON(jsv: JSON.Value): Message {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "SKUIMessage.Message" ->
      Message(
        jso.getString("name"),
        jso.getString("scope"),
        Custom(jso.getObject("command").value),
        jso.maybeGetInt("delay"),
      )
    | _ ->
      invariant_violation(`Invalid json object ${cl} for SKUIMessage.Message`)
    }
  }
}

class Messages(messages: Array<Message>) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Messages _ -> x
    | _ -> SKFS.cast_violation("SKUIMessage.Messages", obj)
    }
  }

  fun add(message: Message): Messages {
    !this.messages = Arrays.add(this.messages, message);
    this;
  }

  fun send(context: mutable SKFS.Context): void {
    this.messages.each(message -> emitMessage(context, message, false))
  }
}

class Target(
  name: String,
  scope: String,
  command: JSON.Object,
  asyncMode: Bool,
) extends SKFS.File, JSONValue uses HasClassName {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Target _ -> x
    | _ -> SKFS.cast_violation("SKUIMessage.Target", obj)
    }
  }

  static fun forClass(
    name: String,
    scope: String,
    className: String,
    asyncMode: Bool = false,
  ): Target {
    Target(
      name,
      scope,
      JSON.Object(Map["__class" => JSON.String(className)]),
      asyncMode,
    )
  }

  static fun forSequencedClass(
    name: String,
    scope: String,
    className: String,
    sequence: SKFS.RunSequence,
    asyncMode: Bool,
  ): Target {
    Target(
      name,
      scope,
      JSON.Object(
        Map[
          "__class" => JSON.String(className),
          "sequence" => sequence.toJSON(),
        ],
      ),
      asyncMode,
    )
  }

  fun toMessage(
    fields: Map<String, JSON.Value>,
    optDelay: ?Int = None(),
  ): Message {
    Message(
      this.name,
      this.scope,
      Custom(Maps.merge(fields, this.command.value)),
      optDelay,
    )
  }

  fun toJSON(): JSON.Value {
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "name" => JSON.String(this.name),
        "scope" => JSON.String(this.scope),
        "command" => this.command,
        "async" => JSON.Bool(this.asyncMode),
      ],
    )
  }

  static fun fromJSON(jsv: JSON.Value): Target {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "SKUIMessage.Target" ->
      Target(
        jso.getString("name"),
        jso.getString("scope"),
        jso.getObject("command"),
        jso.getBool("async"),
      )
    | _ ->
      invariant_violation(`Invalid json object ${cl} for SKUIMessage.Target`)
    }
  }
}

class Sequence private (
  count: Int,
  toPerform: (mutable SKFS.Context, ?Command) ~> void,
  onCancel: mutable SKFS.Context ~> void,
) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Sequence _ -> x
    | _ -> SKFS.cast_violation("SKUIMessage.Sequence", obj)
    }
  }

  static fun create(
    count: Int,
    toPerform: (mutable SKFS.Context, ?Command) ~> void,
    onCancel: mutable SKFS.Context ~> void,
  ): this {
    invariant(count > 0, "Sequence count must be strictly greater than 0.");
    Sequence(count, toPerform, onCancel)
  }

  fun decr(): Sequence {
    !this.count = this.count - 1;
    this;
  }
}

fun repeat(
  context: mutable SKFS.Context,
  name: String,
  scope: String,
  command: Command,
  toPerform: mutable SKFS.Context ~> void,
  optRepeatOn: ?Repeat,
  asyncMode: Bool = false,
  delay: Int = 100,
  finalize: mutable SKFS.Context ~> void = _ctx ~> void,
): void {
  optRepeatOn match {
  | Some(repeatOn) ->
    if (repeatOn.isRepeating(context)) {
      toPerform(context);
      emit(context, name, scope, command, asyncMode, Some(delay));
    } else {
      finalize(context)
    }
  | _ -> toPerform(context)
  }
}

fun target(
  context: mutable SKFS.Context,
  target: Target,
  fields: Map<String, JSON.Value>,
): void {
  emitJSON(
    context,
    target.name,
    target.scope,
    JSON.Object(Maps.merge(fields, target.command.value)),
    target.asyncMode,
  );
}

fun emitMessage(
  context: mutable SKFS.Context,
  message: Message,
  asyncMode: Bool = false,
  allowPending: Bool = true,
): void {
  emit(
    context,
    message.name,
    message.scope,
    message.command,
    asyncMode,
    message.optDelay,
    allowPending,
  )
}

fun debugJSON(context: mutable SKFS.Context, command: JSON.Value): void {
  chars = command.toString().chars();
  if (chars.size() > 128) {
    !chars = chars.slice(0, 128);
  };
  debug(`emit[${context.tick}]: ${String::fromChars(chars.toArray())}`);
}

fun emit(
  context: mutable SKFS.Context,
  name: String,
  scope: String,
  command: Command,
  asyncMode: Bool = false,
  optDelay: ?Int = None(),
  allowPending: Bool = true,
): void {
  message = Message(name, scope, command, optDelay);
  optMessage = if (command.isExternal()) {
    Some(
      JSON.Object(
        Map[
          "module" => JSON.String(name),
          "scope" => JSON.String(scope),
          "message" => command.toJSON(),
        ],
      ).toString(),
    )
  } else if (optDelay.default(0) > 0) {
    messageId = context.registerInternalMessage(message);
    Some(messageId.toString())
  } else {
    None()
  };
  optMessage match {
  | Some(msg) ->
    if (
      !send(
        context,
        msg,
        asyncMode,
        UInt32::truncate(Math.max(optDelay.default(0), 0)),
      )
    ) {
      if (allowPending) {
        context.addPendingMessage(message)
      } else {
        print_error(
          `Unsent message[${
            context.tick
          }]: ${name} ${scope} ${command.toJSON()}`,
        )
      }
    }
  | _ -> performMessage(context, message.name, message.scope, command.toJSON())
  }
}

fun emitJSON(
  context: mutable SKFS.Context,
  name: String,
  scope: String,
  jsv: JSON.Value,
  asyncMode: Bool = false,
  optDelay: ?Int = None(),
): void {
  _ = send(
    context,
    JSON.Object(
      Map[
        "module" => JSON.String(name),
        "scope" => JSON.String(scope),
        "message" => jsv,
      ],
    ).toString(),
    asyncMode,
    UInt32::truncate(Math.max(optDelay.default(0), 0)),
  )
}

fun getChannelId(context: readonly SKFS.Context): ?UInt32 {
  context
    .getGlobal("SKUIMessage.Channel")
    .map(SKFS.UInt32File::fromFile)
    .map(f -> f.value)
}

class DummySupport() extends Support {
  fun init(_context: mutable SKFS.Context): void {
    dummy()
  }

  fun run(
    _context: mutable SKFS.Context,
    _name: String,
    _scope: String,
    _command: Command,
  ): void {
    dummy()
  }

  fun manage(
    _context: mutable SKFS.Context,
    _name: String,
    _scope: String,
    _message: JSON.Value,
  ): void {
    dummy()
  }

  fun cancel(
    _context: mutable SKFS.Context,
    _name: String,
    _scope: String,
    _message: JSON.Value,
  ): void {
    dummy()
  }
}

module end;
