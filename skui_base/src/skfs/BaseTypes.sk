module SKFS;

@always_inline
fun cast_violation<T: frozen>(name: String, casted: T): _ {
  invariant_violation(
    `Cast violation: expected ${name}, got ${Utils.toString(casted)}`,
  )
}

extension base class BaseName uses HasClassName {
  overridable fun compare(y: BaseName): Order {
    (this, y) match {
    | (SKFS.DirTag(), SKFS.DirTag()) -> EQ()
    | (SKFS.DirTag(), _) -> LT()
    | (_, SKFS.DirTag()) -> GT()

    | (SKFS.FilesTag(), SKFS.FilesTag()) -> EQ()
    | (SKFS.FilesTag(), _) -> LT()
    | (_, SKFS.FilesTag()) -> GT()

    | (SKFS.SizeTag(), SKFS.SizeTag()) -> EQ()
    | (SKFS.SizeTag(), _) -> LT()
    | (_, SKFS.SizeTag()) -> GT()

    | (SKFS.IsEmptyTag(), SKFS.IsEmptyTag()) -> EQ()
    | (SKFS.IsEmptyTag(), _) -> LT()
    | (_, SKFS.IsEmptyTag()) -> GT()

    | (dir1 @ SKFS.DirName _, SKFS.DirName _) ->
      dir1.toString().compare(y.toString())
    | (SKFS.DirName _, _) -> LT()
    | (_, SKFS.DirName _) -> GT()

    | (SKFS.IID(n1), SKFS.IID(n2)) -> n1.compare(n2)
    | (SKFS.IID(_), _) -> LT()
    | (_, SKFS.IID(_)) -> GT()

    | (SKFS.SID(n1), SKFS.SID(n2)) -> n1.compare(n2)
    | (SKFS.SID(_), _) -> LT()
    | (_, SKFS.SID(_)) -> GT()

    | (SKFS.StrID(n1), SKFS.StrID(n2)) -> n1.compare(n2)
    | (SKFS.StrID(_), _) -> LT()
    | (_, SKFS.StrID(_)) -> GT()

    | _ ->
      order = this.getClassName().compare(y.getClassName());
      order match {
      | EQ() -> this.sameCompare(y)
      | _ -> order
      }
    }
  }

  overridable fun sameCompare(y: BaseName): Order {
    this.hash().compare(y.hash())
  }
}

class StrID(value: String) extends BaseName {
  fun sameCompare(key: BaseName): Order {
    key match {
    | StrID(v2) -> this.value.compare(v2)
    | _ -> SKFS.cast_violation("SKFS.StrID", key)
    }
  }

  fun toString(): String {
    this.value
  }

  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ StrID _ -> x
    | _ -> SKFS.cast_violation("SKFS.StrID", obj)
    }
  }
}

class ProfileEntity(
  time: System.TimeStamp,
  forceDisplay: Bool,
  count: Int = 1,
  ticks: Int = 1,
) uses Orderable {
  fun compare(other: ProfileEntity): Order {
    this.time.compare(other.time)
  }

  fun +(other: ProfileEntity): ProfileEntity {
    !this.time = this.time + other.time;
    !this.count = this.count + other.count;
    !this.ticks = this.ticks + 1;
    !this.forceDisplay = this.forceDisplay || other.forceDisplay;
    this
  }

  fun average(): System.TimeStamp {
    this.time.div(this.count)
  }
}

class Profile(
  min: ProfileEntity,
  max: ProfileEntity,
  avg: ProfileEntity,
  forceDisplay: Bool = false,
) {
  fun update(entity: ProfileEntity): Profile {
    if (entity < this.min) {
      !this.min = entity;
    };
    if (entity > this.max) {
      !this.max = entity;
    };
    !this.avg = this.avg + entity;
    !this.forceDisplay = this.forceDisplay || entity.forceDisplay;
    this
  }

  @debug
  fun print(name: String): void {
    if (this.max.time.toMicroseconds() > 100 || this.forceDisplay) {
      print_string(
        `${name}: ${this.avg.count} calls for ${this.avg.ticks} ticks`,
      );
      print_string(`\tMin: ${this.min.time}`);
      print_string(`\tMax: ${this.max.time}`);
      print_string(`\tAvg: ${this.avg.time.div(this.avg.count)}`);
      print_string(`\tTick avg: ${this.avg.time.div(this.avg.ticks)}`);
      if (this.avg.count > 1) {
        diff = this.avg.time - this.max.time;
        number = this.avg.count - 1;
        print_string(`\tAvg without max: ${diff.div(number)}`)
      };
      print_string(`\tTotal: ${this.avg.time}`);
    }
  }
}

class Profiles(
  profiles: Map<String, Profile> = Map[],
  tick: SKFS.Tick = SKFS.Tick(0),
  current: Map<String, ProfileEntity> = Map[],
) extends File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Profiles _ -> x
    | _ -> SKFS.cast_violation("SKFS.Profiles", obj)
    }
  }

  fun update(name: String, tick: SKFS.Tick, entity: ProfileEntity): Profiles {
    if (tick != this.tick) {
      !this = this.check(tick);
    };
    upd = this.current.maybeGet(name) match {
    | Some(cur) -> cur + entity
    | _ -> entity
    };
    !this.current = Maps.set(this.current, name, upd);
    this
  }

  fun print(tick: SKFS.Tick): void {
    print_string("Profile start ___");
    namedProfiles = mutable Vector<(String, Profile)>[];
    this.check(tick).profiles.each((key, value) ->
      namedProfiles.push((key, value))
    );
    namedProfiles
      .sortedFor(profile ~> profile.i1.avg.average())
      .each(v -> v.i1.print(v.i0));
    print_string("_____ Profile end");
  }

  private fun check(tick: SKFS.Tick): Profiles {
    this.current.each((uptName, cur) -> {
      profile = this.profiles.maybeGet(uptName) match {
      | Some(profile) -> profile.update(cur)
      | _ ->
        value = cur with {ticks => 1};
        Profile(value, value, value)
      };
      !this.profiles = Maps.set(this.profiles, uptName, profile);
    });
    !this.tick = tick;
    !this.current = Map[];
    this;
  }
}

class DummyBaseName() extends BaseName {
  fun toString(): String {
    dummy()
  }

  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ DummyBaseName _ -> x
    | _ -> SKFS.cast_violation("SKFS.DummyBaseName", obj)
    }
  }
}

module end;
