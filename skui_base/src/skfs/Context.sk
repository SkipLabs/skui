module SKStore;

class Updater(fn: mutable Context ~> void) extends File

class Random(value: .Random) extends File {
  //
  static fun type(obj: File): this {
    obj match {
    | x @ Random _ -> x
    | _ -> cast_violation("SKStore.Random", obj)
    }
  }
}

@cpp_extern("SKIP_check_memory")
native fun .checkMemory(): void;

extension class Context {
  //
  static fun withoutGc<T>(fn: mutable Context ~> T): T {
    getWorkingContext() match {
    | Some(context) -> fn(context)
    | _ ->
      fromContext = gUnsafeContextGet();
      fromTick = fromContext.tick;
      context = Context::fromSaved(fromContext);
      context.performOnce(fn, fromContext, fromTick)
    }
  }

  mutable fun updateIfRoot(): void {
    if (this.currentArrow().isNone()) {
      if (this.updateWithStatus()) {
        this.getGlobal("SKStore.Updater").map(Updater::type).each(u ->
          u.fn(this)
        )
      }
    }
  }

  mutable fun loopWithGC(
    fn: mutable Context -> Bool,
    needGC: () -> Bool,
  ): ?SKStore.Obstack {
    optPos = Some(SKStore.newObstack());
    loop {
      pos = optPos.fromSome();
      if (fn(this)) {
        break void
      };
      if (needGC()) {
        icontext = SKStore.destroyObstackWithValue(
          pos,
          List[this.clone()],
        ).getHead();
        this.replaceFromSaved(icontext);
        !optPos = Some(SKStore.newObstack());
      }
    };
    optPos
  }

  @debug
  private mutable fun performOnce<T>(
    fn: mutable Context ~> T,
    fromContext: Context,
    fromTick: Tick,
  ): T {
    setWorkingContext(Some(this));
    try {
      res = fn(this);
      setWorkingContext(None());
      invariant(
        this.currentArrow().isNone(),
        "gContextSync cannot be done durring update",
      );
      sContext = gContextSync(
        fromTick,
        fromContext,
        this.clone(),
        None(),
        UInt32::truncate(0),
        None(),
      );
      gUnsafeFree(sContext);
      res;
    } catch {
    | ex ->
      setWorkingContext(None());
      gUnsafeFree(fromContext);
      throw ex
    };
  }

  static fun withGc<T>(fn: mutable Context ~> T): T {
    pos = newObstack();
    res = static::withoutGc(fn);
    destroyObstack(pos);
    res;
  }

  mutable fun makeDir<K: Key, T: File>(
    convKey: Key ~> K,
    conv: File ~> T,
    dirName: DirName,
    content: Array<(K, T)> = Array[],
  ): EHandle<K, T> {
    this.mkdir(convKey, conv, dirName, content);
  }

  mutable fun makeFileDir<K: Key>(
    convKey: Key ~> K,
    dirName: DirName,
    content: Array<(K, File)> = Array[],
  ): EHandle<K, File> {
    this.mkdir(convKey, f ~> f, dirName, content);
  }

  mutable fun makeNotTyped(
    dirName: DirName,
    content: Array<(Key, File)> = Array[],
  ): EHandle<Key, File> {
    this.mkdir(k ~> k, f ~> f, dirName, content);
  }

  mutable fun makePreDir<K: Key, T: File>(
    convKey: Key ~> K,
    conv: File ~> T,
    dirName: DirName,
    content: Array<(K, T)> = Array[],
  ): EHandle<K, T> {
    value = this.makeDir(convKey, conv, dirName.pre(), content);
    if (!this.hasPre.contains(dirName)) {
      this.!hasPre = this.hasPre.add(dirName);
    };
    value;
  }

  mutable fun makeNotTypedPre(
    dirName: DirName,
    content: Array<(Key, File)> = Array[],
  ): EHandle<Key, File> {
    this.makePreDir(k ~> k, f ~> f, dirName, content);
  }

  mutable fun setProfiling(optPerformProfile: ?Bool): void {
    optPerformProfile match {
    | Some(profiling) ->
      this.setGlobal("SKStore.Profiling", BoolFile(profiling))
    | _ -> this.removeGlobal("SKStore.Profiling")
    }
  }

  readonly fun getProfiling(): ?Bool {
    this.getGlobal("SKStore.Profiling").map(f -> BoolFile::type(f).value)
  }

  mutable fun registerMessageSupport(
    name: String,
    scope: String,
    support: SKUIMessage.Support,
    replace: Bool = true,
  ): void {
    id = `SKUIMessage.Support.${name}.${scope}`;
    if (replace || this.getGlobal(id).isNone()) {
      support.init(this);
      this.setGlobal(`SKUIMessage.Support.${name}.${scope}`, support);
    }
  }

  readonly fun getMessageSupport(
    name: String,
    scope: String,
  ): ?SKUIMessage.Support {
    supportId = `SKUIMessage.Support.${name}.${scope}`;
    this.getGlobal(supportId).map(SKUIMessage.Support::btype)
  }

  mutable fun removeMessageSupport(name: String, scope: String): void {
    this.removeGlobal(`SKUIMessage.Support.${name}.${scope}`);
  }

  mutable fun registerSequence(sequence: SKUIMessage.Sequence): RunSequence {
    time = this.timeStamp();
    name = `SKUIMessage.Sequence[${time}]`;
    this.setGlobal(name, sequence);
    RunSequence(time.value)
  }

  mutable fun checkSequence(
    seqId: Int,
    optCommand: ?SKUIMessage.Command,
  ): void {
    name = `SKUIMessage.Sequence[${seqId}]`;
    this.getGlobal(name).map(SKUIMessage.Sequence::type) match {
    | Some(sequence) ->
      nSequence = sequence.decr();
      if (nSequence.count == 0) {
        this.removeGlobal(name);
        nSequence.toPerform(this, optCommand);
      } else {
        this.setGlobal(name, nSequence);
      }
    | _ -> void
    }
  }

  mutable fun clearSequence(id: Int): void {
    name = `SKUIMessage.Sequence[${id}]`;
    optSequence = this.getGlobal(name).map(SKUIMessage.Sequence::type);
    this.removeGlobal(name);
    optSequence.each(sequence -> sequence.onCancel(this))
  }

  mutable fun addPendingMessage(message: SKUIMessage.Message): void {
    this.getGlobal("SKUIMessage.Pedding").map(
      SKUIMessage.Messages::type,
    ) match {
    | Some(messages) ->
      this.setGlobal("SKUIMessage.Pedding", messages.add(message))
    | _ ->
      this.setGlobal(
        "SKUIMessage.Pedding",
        SKUIMessage.Messages(Array[message]),
      )
    }
  }

  mutable fun checkPendingMessages(): void {
    this.getGlobal("SKUIMessage.Pedding")
      .map(SKUIMessage.Messages::type)
      .each(messages -> messages.send(this));
    this.removeGlobal("SKUIMessage.Pedding");
  }

  mutable fun registerInternalMessage(message: SKUIMessage.Message): Int {
    messageId = this.timeStamp().value;
    gID = `SKUIMessage.Message.${messageId}`;
    this.setGlobal(gID, message);
    messageId;
  }

  mutable fun getInternalMessage(messageId: Int): ?SKUIMessage.Message {
    gID = `SKUIMessage.Message.${messageId}`;
    optMessage = this.getGlobal(gID).map(SKUIMessage.Message::type);
    if (optMessage.isSome()) {
      this.removeGlobal(gID)
    };
    optMessage;
  }

  @debug
  mutable fun systemTimeStamp(): System.TimeStamp {
    System.timeStamp();
  }

  mutable fun random(start: Int, end: Int): Int {
    random = this.getRandom();
    res = random.random(start, end);
    this.setGlobal("SKStore.Random", Random(random.chill()));
    res;
  }

  private mutable fun getRandom(): mutable .Random {
    this.getGlobal("SKStore.Random") match {
    | Some(file) -> Random::type(file).value.clone()
    | _ -> .Random::mcreate(this.timeStamp().value)
    }
  }

  mutable fun randomBytes(size: Int): Array<UInt8> {
    random = this.getRandom();
    bytes = Array::fillBy(size, _idx -> UInt8::truncate(random.random(0, 256)));
    this.setGlobal("SKStore.Random", Random(random.chill()));
    bytes
  }

  readonly fun getBoolGlobal(name: String): Bool {
    this.getGlobal(name).map(BoolFile::type).map(f -> f.value).default(false)
  }
}

@debug
@cpp_extern("SKIP_SKStore_setWorkingContext")
native fun setWorkingContext(optContext: ?mutable Context): void;

@debug
@cpp_extern("SKIP_SKStore_getWorkingContext")
native fun getWorkingContext(): ?mutable Context;

class RunSequence(id: Int) extends JSONValue, File {
  //
  static fun type(obj: File): this {
    obj match {
    | x @ RunSequence _ -> x
    | _ -> cast_violation("SKStore.RunSequence", obj)
    }
  }

  fun execute(
    context: mutable Context,
    optCommand: ?SKUIMessage.Command,
  ): void {
    context.checkSequence(this.id, optCommand)
  }

  fun cancel(context: mutable Context): void {
    context.clearSequence(this.id)
  }

  fun toJSON(): JSON.Value {
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "id" => JSON.IntNumber(this.id),
      ],
    )
  }

  static fun fromJSON(jsv: JSON.Value): RunSequence {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "SKStore.RunSequence" -> RunSequence(jso.getInt("id"))
    | _ ->
      invariant_violation(`Invalid json object ${cl} for SKStore.RunSequence`)
    }
  }
}

module end;
