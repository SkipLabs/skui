module SKFS;

class Identity() extends Converter<File> {
  fun fromFile(file: File): File {
    file
  }

  fun toFile(value: File): File {
    value
  }
}

class FileConverter<T: File>(conv: File ~> T) extends Converter<T> {
  fun fromFile(file: File): T {
    this.conv(file)
  }

  fun toFile(value: T): File {
    value
  }
}

class IntConverter() extends Converter<Int> {
  fun fromFile(file: SKFS.File): Int {
    IntFile::fromFile(file).value;
  }

  fun toFile(value: Int): SKFS.File {
    IntFile(value)
  }
}

class FloatConverter() extends Converter<Float> {
  fun fromFile(file: SKFS.File): Float {
    FloatFile::fromFile(file).value;
  }

  fun toFile(value: Float): SKFS.File {
    FloatFile(value)
  }
}

class StringConverter() extends Converter<String> {
  fun fromFile(file: SKFS.File): String {
    StringFile::fromFile(file).value;
  }

  fun toFile(value: String): SKFS.File {
    StringFile(value)
  }
}

class BoolConverter() extends Converter<Bool> {
  fun fromFile(file: SKFS.File): Bool {
    BoolFile::fromFile(file).value;
  }

  fun toFile(value: Bool): SKFS.File {
    BoolFile(value)
  }
}

class ArrayConverter<T: frozen>(
  converter: Converter<T>,
) extends Converter<Array<T>> {
  fun fromFile(file: SKFS.File): Array<T> {
    ArrayFile::fromFile(file).value.map(this.converter.fromFile);
  }

  fun toFile(value: Array<T>): SKFS.File {
    ArrayFile(value.map(this.converter.toFile))
  }
}

module end;
