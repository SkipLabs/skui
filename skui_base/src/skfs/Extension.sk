module SKFS;

class FloatFile(value: Float) extends File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ FloatFile _ -> x
    | _ -> invariant_violation("Must be SKFS.FloatFile")
    }
  }
}

