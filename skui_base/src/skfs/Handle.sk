module SKStore;

type ENotTyped = EHandle<Key, File>;
type INotTyped = IHandle<Key, File>;
type NotTyped = Handle<Key, File>;
type EHandleSK<T> = EHandle<StrID, T>;
type EHandleIK<T> = EHandle<IID, T>;

class HValue<K: Key, T: File>(hdl: Handle<K, T>, key: K) {
  fun get(context: mutable Context, isUntracked: Bool = false): T {
    this.hdl.getValue(context, this.key, isUntracked)
  }

  fun maybeGet(context: mutable Context, isUntracked: Bool = false): ?T {
    this.hdl.maybeGetValue(context, this.key, isUntracked)
  }
}

class EHValue<K: Key, T: File>(hdl: EHandle<K, T>, key: K) {
  //
  fun getDirName(): DirName {
    this.hdl.getDirName()
  }

  fun get(context: mutable Context, isUntracked: Bool = false): T {
    this.hdl.getValue(context, this.key, isUntracked)
  }

  fun maybeGet(context: mutable Context, isUntracked: Bool = false): ?T {
    this.hdl.maybeGetValue(context, this.key, isUntracked)
  }

  fun convert<U: File>(conv: T ~> U): EHValue<K, U> {
    EHValue(this.hdl.convert(conv), this.key)
  }

  fun getChildDirName(subPath: String): DirName {
    DirName::make(
      this.getDirName(),
      `${normalize(this.key.toString())}/${subPath}`,
    )
  }

  fun map<U: File>(
    conv: File ~> U,
    context: mutable Context,
    dirName: DirName,
    fn: T ~> U,
  ): EHValue<K, U> {
    EHValue(
      this.hdl.map(
        this.hdl.getKeyType(),
        conv,
        context,
        dirName,
        (_, writer, key, it) ~> {
          if (key == this.key) {
            writer.set(key, fn(it.first))
          };
        },
      ),
      this.key,
    )
  }

  fun mapChild<U: File>(
    conv: File ~> U,
    context: mutable Context,
    subPath: String,
    fn: T ~> U,
  ): EHValue<K, U> {
    this.map(conv, context, this.getChildDirName(subPath), fn)
  }

  fun mapContext<U: File>(
    conv: File ~> U,
    context: mutable Context,
    dirName: DirName,
    fn: (mutable Context, T) ~> U,
  ): EHValue<K, U> {
    EHValue(
      this.hdl.map(
        this.hdl.getKeyType(),
        conv,
        context,
        dirName,
        (ctx, writer, key, it) ~> {
          if (key == this.key) {
            writer.set(key, fn(ctx, it.first))
          };
        },
      ),
      this.key,
    )
  }

  fun mapContextChild<U: File>(
    conv: File ~> U,
    context: mutable Context,
    subPath: String,
    fn: (mutable Context, T) ~> U,
  ): EHValue<K, U> {
    this.mapContext(conv, context, this.getChildDirName(subPath), fn)
  }

  fun mapWriter<U: File>(
    conv: File ~> U,
    context: mutable Context,
    dirName: DirName,
    fn: (mutable TWriter<K, U>, T) ~> void,
  ): EHandle<K, U> {
    this.hdl.map(
      this.hdl.getKeyType(),
      conv,
      context,
      dirName,
      (_ctx, writer, key, it) ~> {
        if (key == this.key) {
          fn(writer, it.first)
        }
      },
    )
  }

  fun mapWriterChild<U: File>(
    conv: File ~> U,
    context: mutable Context,
    subPath: String,
    fn: (mutable TWriter<K, U>, T) ~> void,
  ): EHandle<K, U> {
    this.mapWriter(conv, context, this.getChildDirName(subPath), fn)
  }

  fun mapContextWriter<U: File>(
    conv: File ~> U,
    context: mutable Context,
    dirName: DirName,
    fn: (mutable Context, mutable TWriter<K, U>, K, T) ~> void,
  ): EHandle<K, U> {
    this.hdl.map(
      this.hdl.getKeyType(),
      conv,
      context,
      dirName,
      (ctx, writer, key, it) ~> {
        if (key == this.key) {
          fn(ctx, writer, key, it.first)
        };
      },
    )
  }

  fun mapContextWriterChild<U: File>(
    conv: File ~> U,
    context: mutable Context,
    subPath: String,
    fn: (mutable Context, mutable TWriter<K, U>, K, T) ~> void,
  ): EHandle<K, U> {
    this.mapContextWriter(conv, context, this.getChildDirName(subPath), fn)
  }
}

extension base class Handle {
  //
  fun exists(context: readonly Context): Bool {
    context.unsafeMaybeGetDir(this.getDirName()).isSome()
  }

  fun getValue(context: mutable Context, key: K, isUntracked: Bool = false): V {
    if (isUntracked) {
      this.uGet(context, key)
    } else {
      this.get(context, key)
    }
  }

  fun maybeGetValue(
    context: mutable Context,
    key: K,
    isUntracked: Bool = false,
  ): ?V {
    if (isUntracked) {
      this.uMaybeGet(context, key)
    } else {
      this.maybeGetArray(context, key).flatMap(values -> {
        if (values.size() == 0) return None();
        Some(values[0])
      });
    }
  }

  fun maybeGetArray(context: mutable Context, key: K): ?Array<V> {
    context.maybeGetDir(this.getDirName()).map(dir ->
      dir.getArray(context, key).map(this.getType())
    )
  }

  fun getArrayValue(
    context: mutable Context,
    key: K,
    isUntracked: Bool = false,
  ): Array<V> {
    dirName = this.getDirName();
    if (!isUntracked) {
      path = Path::create(dirName, key);
      context.addDep(path);
    };
    this.uGetArray(context, key).default(Array[]);
  }

  fun uGetArray(context: readonly Context, key: K): ?Array<V> {
    context.unsafeMaybeGetDir(this.getDirName()).map(dir ->
      dir.getArrayRaw(key).map(this.getType())
    );
  }

  fun uMaybeGet(context: readonly Context, key: K): ?V {
    this.uGetArray(context, key).flatMap(values ->
      if (values.isEmpty()) {
        None()
      } else {
        Some(values.first())
      }
    )
  }

  fun uGet(context: readonly Context, key: K): V {
    this.uMaybeGet(context, key).fromSome()
  }

  fun maybeGetProp<U>(
    context: mutable Context,
    property: K,
    conv: V ~> U,
    isUntracked: Bool = false,
  ): ?U {
    this.maybeGetValue(context, property, isUntracked).map(conv);
  }

  fun getProp<U>(
    context: mutable Context,
    property: K,
    conv: V ~> U,
    default: U,
    isUntracked: Bool = false,
  ): U {
    this.maybeGetProp(context, property, conv, isUntracked).default(default)
  }

  fun getOptProp<U>[V: File](
    context: mutable Context,
    property: K,
    conv: File ~> U,
    isUntracked: Bool = false,
  ): ?U {
    this.maybeGetProp(context, property, OptFile::type, isUntracked).flatMap(
      optFile -> optFile.map(conv),
    )
  }

  fun is(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): Bool {
    this.getProp(
      context,
      property,
      f ~> BoolFile::type(f).value,
      false,
      isUntracked,
    )
  }

  fun getOptString(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): ?String {
    this.getOptProp(
      context,
      property,
      f ~> StringFile::type(f).value,
      isUntracked,
    )
  }

  fun getString(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): String {
    this.maybeGetString(context, property, isUntracked).default("")
  }

  fun maybeGetString(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): ?String {
    this.maybeGetProp(
      context,
      property,
      f ~> StringFile::type(f).value,
      isUntracked,
    )
  }

  fun getInt(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): Int {
    this.getProp(context, property, f ~> IntFile::type(f).value, 0, isUntracked)
  }

  fun maybeGetInt(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): ?Int {
    this.maybeGetProp(
      context,
      property,
      f ~> IntFile::type(f).value,
      isUntracked,
    )
  }

  fun getChar(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): Char {
    this.getProp(
      context,
      property,
      f ~> CharFile::type(f).value,
      '\0',
      isUntracked,
    )
  }

  fun maybeGetChar(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): ?Char {
    this.maybeGetProp(
      context,
      property,
      f ~> CharFile::type(f).value,
      isUntracked,
    )
  }

  fun getBool(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): Bool {
    this.getProp(
      context,
      property,
      f ~> BoolFile::type(f).value,
      false,
      isUntracked,
    )
  }

  fun maybeGetBool(
    context: mutable Context,
    property: K,
    isUntracked: Bool = false,
  ): ?Bool {
    this.maybeGetProp(
      context,
      property,
      f ~> BoolFile::type(f).value,
      isUntracked,
    )
  }
}

extension class LHandle {
  static fun lazy<T: File>(
    keyType: Key ~> K,
    conv: File ~> T,
    context: mutable Context,
    dirName: DirName,
    f: (mutable Context, LHandle<K, T>, K) ~> T,
    collect: Bool = true,
  ): LHandle<K, T> {
    static::create(
      keyType,
      conv,
      context,
      dirName,
      (conv, self, key) ~> Array[f(conv, self, key)],
      collect,
    )
  }

  static fun optLazy<T: File>(
    keyType: Key ~> K,
    conv: File ~> T,
    context: mutable Context,
    dirName: DirName,
    f: (mutable Context, LHandle<K, T>, K) ~> ?T,
    collect: Bool = true,
  ): LHandle<K, T> {
    static::create(
      keyType,
      conv,
      context,
      dirName,
      (conv, self, key) ~>
        f(conv, self, key).map(v -> Array[v]).default(Array[]),
      collect,
    )
  }
}

extension class EHandle {
  //
  static fun notTyped(dirName: DirName): EHandle<Key, File> {
    EHandle<Key, File>(k ~> k, f ~> f, dirName)
  }

  fun contextKeyMap<T2: File>(
    conv: File ~> T2,
    context: mutable Context,
    dirName: DirName,
    f: (mutable Context, K, V) ~> T2,
  ): EHandle<K, T2> {
    this.map(
      this.getKeyType(),
      conv,
      context,
      dirName,
      (context, writer, key, it) ~> {
        it.assertUnique();
        writer.set(key, f(context, key, it.first));
      },
    )
  }

  fun convert<U: File>(conv: V ~> U): EHandle<K, U> {
    EHandle(
      this.getKeyType(),
      f ~> conv((this.getType())(f)),
      this.getDirName(),
    )
  }

  fun contextMapValues<T2: File>(
    conv: File ~> T2,
    context: mutable Context,
    dirName: DirName,
    f: (mutable Context, Array<V>) ~> T2,
  ): EHandle<K, T2> {
    this.map(
      this.getKeyType(),
      conv,
      context,
      dirName,
      (context, writer, key, it) ~>
        writer.set(key, f(context, it.collect(Array)))
      ,
    )
  }

  fun isWritable(context: mutable Context): Bool {
    context
      .maybeGetEagerDir(this.getDirName())
      .map(d -> d.isInput())
      .default(false)
  }
}

fun toIHandle<K: Key, T: File>(hdl: Handle<K, T>): IHandle<K, T> {
  IHandle(hdl.getKeyType(), hdl.getType(), hdl.getDirName())
}

class IHandle<K: Key, T: File>(
  keyType: Key ~> K,
  type: File ~> T,
  dirName: DirName,
) extends Handle<K, T> {
  //
  static fun notTyped(dirName: DirName): IHandle<Key, File> {
    IHandle<Key, File>(k ~> k, f ~> f, dirName)
  }

  fun toEHandle(): EHandle<K, T> {
    EHandle(this.keyType, this.type, this.dirName)
  }

  fun getKeyType(): SKStore.Key ~> K {
    this.keyType
  }

  fun remove(context: mutable Context, key: K): void {
    this.writeArray(context, key, Array[]);
  }

  fun write(context: mutable Context, key: K, value: T): void {
    this.writeArray(context, key, Array[value]);
  }

  fun writeOrRemove(context: mutable Context, key: K, optValue: ?T): void {
    this.writeArray(
      context,
      key,
      optValue.map(value -> Array[value]).default(Array[]),
    );
  }

  fun writeArray(context: mutable Context, key: Key, value: Array<T>): void {
    if (context.currentArrow().isSome()) {
      context.postpone(ToWrite(this.dirName, key, _ctx ~> value))
    } else {
      invariant(context.currentArrow().isNone(), "Must be call on root.");
      context.maybeGetEagerDir(this.dirName) match {
      | None() ->
        invariant_violation(`Could not find input directory: ${this.dirName}`)
      | Some(dir) ->
        if (!dir.isInput()) {
          invariant_violation(`Not an input Dir: ${this.dirName}`)
        };
        dir.writeArray(context, key, value)
      }
    }
  }

  fun writeDeferredArray(
    context: mutable Context,
    key: Key,
    valuesGetter: readonly Context ~> Array<T>,
  ): void {
    if (context.currentArrow().isSome()) {
      context.postpone(ToWrite(this.dirName, key, valuesGetter))
    } else {
      invariant(context.currentArrow().isNone(), "Must be call on root.");
      context.maybeGetEagerDir(this.dirName) match {
      | None() ->
        invariant_violation(`Could not find input directory: ${this.dirName}`)
      | Some(dir) ->
        invariant(dir.isInput(), `Not an input Dir: ${this.dirName}`);
        dir.writeArray(context, key, valuesGetter(context))
      }
    }
  }
}

module end;
