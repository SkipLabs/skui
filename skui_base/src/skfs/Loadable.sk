module SKStore;

base class Loadable extends File {
  children =
  | ToLoad()
  | Loading(optProgression: ?Int = None())
  | LoadFailed(optError: ?Text = None())
  | Loaded(file: File)

  fun isLoading(): Bool {
    this match {
    | _tl @ ToLoad _
    | _l @ Loading _ ->
      true
    | _ -> false
    }
  }

  fun then(
    context: mutable Context,
    conv: (mutable Context, File) ~> Loadable = (_, file) ~> Loaded(file),
  ): Loadable
  | Loaded(file) -> conv(context, file)
  | _ -> this

  fun otherwise(
    context: mutable Context,
    conv: (mutable Context, LoadFailed) ~> Loadable = (_, lf) ~> lf,
  ): Loadable
  | LoadFailed _ -> conv(context, this)
  | _ -> this

  fun maybeGet<T>(conv: File ~> T): ?T
  | loaded @ Loaded _ -> Some(conv(loaded.file))
  | _ -> None()

  static fun forFile(obj: File): Loadable {
    obj match {
    | l @ Loadable _ -> l
    | _ -> invariant_violation("Invalid state")
    }
  }
}

module end;

fun toLoadFailed(e: Exception): SKStore.LoadFailed {
  e match {
  | i18NException @ I18NExceptionBase _ ->
    SKStore.LoadFailed(Some(i18NException.getTextMessage()))
  | _ -> SKStore.LoadFailed(Some(!e.getMessage()))
  }
}
