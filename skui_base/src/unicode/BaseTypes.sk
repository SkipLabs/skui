module Utf8;

const error: Char = '\uFFFD'; // the "error" Char or "Unicode replacement character"
const self: UInt8 = UInt8::truncate(0x80); // characters below Self are represented as themselves in a single byte.
const max: Char = '\U0010FFFF'; // Maximum valid Unicode code point.
const maxSize: Int = 4; // Maximum valid Unicode code point.

module end;

module Unicode;

// Bit masks for each code point under U+0100, for fast lookup.
const pC: Int = 1; // a control character.
const pP: Int = 2; // a punctuation character.
const pN: Int = 4; // a numeral.
const pS: Int = 8; // a symbolic character.
const pZ: Int = 16; // a spacing character.
const pLu: Int = 32; // an upper-case letter.
const pLl: Int = 64; // a lower-case letter.
const pp: Int = 128; // a printable character according to Go's definition.
const pg: Int = pp.or(pZ); // a graphical character according to the Unicode definition.
const pLo: Int = pLl.or(pLu); // a letter that is neither upper nor lower case.
const pLmask: Int = pLo;

const firstMulti: Int = 0x1870;
const firstCCC: Int = 0x2CAB;
const endMulti: Int = 0x2F77;
const firstLeadingCCC: Int = 0x49C5;
const firstCCCZeroExcept: Int = 0x4A8F;
const firstStarterWithNLead: Int = 0x4AB6;
const lastDecomp: Int = 0x4AB8;
const maxDecomp: Int = 0x8000;

const maxNonStarters: UInt8 = UInt8::truncate(30);
// The maximum number of characters needed for a buffer is
// maxNonStarters + 1 for the starter + 1 for the GCJ
const maxBufferSize: Int = maxNonStarters + 2;
const maxNFCExpansion: Int = 3; // NFC(0x1D160)
const maxNFKCExpansion: Int = 18; // NFKC(0xFDFA)
const maxByteBufferSize: Int = Utf8.maxSize * maxBufferSize; // 128

const hangulUTF8Size: Int = 3;

// For Hangul we combine algorithmically, instead of using tables.
const hangulBase: Int = 0xAC00; // UTF-8(hangulBase) -> EA B0 80
const hangulBase0: Int = 0xEA;
const hangulBase1: Int = 0xB0;
const hangulBase2: Int = 0x80;

const hangulEnd: Int = hangulBase + jamoLVTCount; // UTF-8(0xD7A4) -> ED 9E A4
const hangulEnd0: Int = 0xED;
const hangulEnd1: Int = 0x9E;
const hangulEnd2: Int = 0xA4;

const jamoLBase: Int = 0x1100; // UTF-8(jamoLBase) -> E1 84 00
const jamoLBase0: Int = 0xE1;
const jamoLBase1: Int = 0x84;
const jamoLEnd: Int = 0x1113;
const jamoVBase: Int = 0x1161;
const jamoVEnd: Int = 0x1176;
const jamoTBase: Int = 0x11A7;
const jamoTEnd: Int = 0x11C3;

const jamoTCount: Int = 28;
const jamoVCount: Int = 21;
const jamoVTCount: Int = 21 * 28;
const jamoLVTCount: Int = 19 * 21 * 28;

class ValueRange(value: UInt16, lo: UInt8, hi: UInt8) {
  static fun make(value: Int, lo: Int, hi: Int = 0): ValueRange {
    ValueRange(
      UInt16::truncate(value),
      UInt8::truncate(lo),
      UInt8::truncate(hi),
    )
  }
}

base class ScState {
  children =
  | Success()
  | Starter()
  | Overflow()
}

module end;
