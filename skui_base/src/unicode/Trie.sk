module Unicode;

base class Trie {
  fun lookup(s: Array<UInt8>): (UInt16, Int);
  fun lookupUnsafe(s: Array<UInt8>): UInt16;
}

base class NfTrie extends Trie {
  protected fun getValue(index: Int): UInt16;
  protected fun getIndex(index: Int): UInt8;
  protected fun getSparseValue(index: Int): ValueRange;
  protected fun getSparseOffset(index: Int): Int;
  protected fun getLimit(): Int;

  // lookup returns the trie value for the first UTF-8 encoding in s and
  // the width in bytes of this encoding. The size will be 0 if s does not
  // hold enough bytes to complete the encoding. len(s) must be greater than 0.
  fun lookup(s: Array<UInt8>): (UInt16, Int) {
    c0 = s[0].toInt();
    if (c0 < 0x80) { // is ASCII
      return (this.getValue(c0), 1);
    };
    if (c0 < 0xC2) {
      return (UInt16::zero, 1) // Illegal UTF-8: not a starter, not ASCII.
    };
    if (c0 < 0xF8) { // 4-byte UTF-8
      if (s.size() < 2) {
        return (UInt16::zero, 0)
      };
      i = this.getIndex(c0);
      c1 = s[1].toInt();
      if (c1 < 0x80 || 0xC0 <= c1) {
        return (UInt16::zero, 1) // Illegal UTF-8: not a continuation byte.
      };
      if (c0 < 0xE0) { // 2-byte UTF-8
        return (this.lookupValue(i, c1), 2)
      };
      if (s.size() < 3) {
        return (UInt16::zero, 0)
      };
      o = i.shl(6) + c1;
      !i = this.getIndex(o);
      c2 = s[2].toInt();
      if (c2 < 0x80 || 0xC0 <= c2) {
        return (UInt16::zero, 2) // Illegal UTF-8: not a continuation byte.
      };
      if (c0 < 0xF0) { // 3-byte UTF-8
        return (this.lookupValue(i, c2), 3)
      };
      if (s.size() < 4) {
        return (UInt16::zero, 0)
      };
      !o = i.shl(6) + c2;
      !i = this.getIndex(o);
      c3 = s[3].toInt();
      if (c3 < 0x80 || 0xC0 <= c3) {
        return (UInt16::zero, 3) // Illegal UTF-8: not a continuation byte.
      };
      return (this.lookupValue(i, c3), 4)
    };
    // Illegal rune
    (UInt16::zero, 1)
  }

  // lookupValue determines the type of block n and looks up the value for b.
  fun lookupValue(n: UInt8, b: Int): UInt16 {
    limit = this.getLimit();
    if (n < limit) {
      this.getValue(n.shl(6) + b)
    } else {
      this.lookupSparse(n - limit, b)
    }
  }

  // lookupUnsafe returns the trie value for the first UTF-8 encoding in s.
  // s must start with a full and valid UTF-8 encoded rune.
  fun lookupUnsafe(s: Array<UInt8>): UInt16 {
    c0 = s[0].toInt();
    if (c0 < 0x80) { // is ASCII
      return nfcValues[c0]
    };
    i = this.getIndex(c0);
    if (c0 < 0xE0) { // 2-byte UTF-8
      return this.lookupValue(i, s[1].toInt())
    };
    !i = this.getIndex(i.shl(6) + s[1]);
    if (c0 < 0xF0) { // 3-byte UTF-8
      return this.lookupValue(i, s[2].toInt())
    };
    !i = this.getIndex(i.shl(6) + s[2]);
    if (c0 < 0xF8) { // 4-byte UTF-8
      return this.lookupValue(i, s[3].toInt())
    };
    UInt16::zero
  }

  // lookupValue determines the type of block n and looks up the value for b.
  // For n < t.cutoff, the block is a simple lookup table. Otherwise, the block
  // is a list of ranges with an accompanying value. Given a matching range r,
  // the value for b is by r.value + (b - r.lo) * stride.
  fun lookupSparse(n: Int, b: Int): UInt16 {
    offset = this.getSparseOffset(n);
    header = this.getSparseValue(offset);
    lo = offset + 1;
    hi = lo + header.lo;
    while (lo < hi) {
      m = lo + (hi - lo) / 2;
      r = this.getSparseValue(m);
      if (r.lo <= b && b <= r.hi) {
        return UInt16::truncate(r.value + (b - r.lo) * header.value)
      };
      if (b < r.lo) {
        !hi = m
      } else {
        !lo = m + 1
      }
    };
    UInt16::zero
  }
}

class NfcTrie() extends NfTrie {
  protected fun getValue(index: Int): UInt16 {
    nfcValues[index]
  }
  protected fun getIndex(index: Int): UInt8 {
    nfcIndex[index]
  }
  protected fun getSparseValue(index: Int): ValueRange {
    nfcSparseValues[index]
  }
  protected fun getSparseOffset(index: Int): Int {
    nfcSparseOffset[index].toInt()
  }

  protected fun getLimit(): Int {
    46
  }
}

class NfkcTrie() extends NfTrie {
  protected fun getValue(index: Int): UInt16 {
    nfkcValues[index]
  }

  protected fun getIndex(index: Int): UInt8 {
    nfkcIndex[index]
  }
  protected fun getSparseValue(index: Int): ValueRange {
    nfkcSparseValues[index]
  }
  protected fun getSparseOffset(index: Int): Int {
    nfkcSparseOffset[index].toInt()
  }

  protected fun getLimit(): Int {
    92
  }
}

module end;
