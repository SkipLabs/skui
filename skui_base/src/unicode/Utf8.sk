module Utf8;

// AcceptRange gives the range of valid values for the second byte in a UTF-8
// sequence.
class AcceptRange(
  lo: UInt8, // lowest value for second byte.
  hi: UInt8, // highest value for second byte.
) {
  static fun make(lo: Int, hi: Int): AcceptRange {
    AcceptRange(UInt8::truncate(lo), UInt8::truncate(hi))
  }
}

// DecodeRune unpacks the first UTF-8 encoding in p and returns the rune and
// its width in bytes. If p is empty it returns (RuneError, 0). Otherwise, if
// the encoding is invalid, it returns (RuneError, 1). Both are impossible
// results for correct, non-empty UTF-8.
//
// An encoding is invalid if it is incorrect UTF-8, encodes a rune that is
// out of range, or is not the shortest possible UTF-8 encoding for the
// value. No other validation is performed.
fun decodeChar(p: Array<UInt8>): (Char, Int) {
  n = p.size();
  if (n < 1) {
    return (error, 0)
  };
  p0 = p[0].toInt();
  x = first[p0];
  if (x >= asc) {
    // The following code simulates an additional check for x == xx and
    // handling the ASCII and invalid cases accordingly. This mask-and-or
    // approach prevents an additional branch.
    mask = UInt32::truncate(x.shl(31)).shr(31); // Create 0x0000 or 0xFFFF.
    code = p[0].and(mask.not()).or(error.code().and(mask));
    return (Char::fromCode(code), 1)
  };
  sz = x.and(7);
  if (n < sz) {
    return (error, 1)
  };
  accept = acceptRanges[x.shr(4)];
  b1 = p[1].toInt();
  if (b1 < accept.lo || accept.hi < b1) {
    return (error, 1)
  };
  if (sz <= 2) {
    code = p0.and(mask2).shl(6).or(b1.and(maskx));
    return (Char::fromCode(code), 2)
  };
  b2 = p[2].toInt();
  if (b2 < locb || hicb < b2) {
    return (error, 1)
  };
  if (sz <= 3) {
    code = p0.and(mask3).shl(12).or(b1.and(maskx).shl(6)).or(b2.and(maskx));
    return (Char::fromCode(code), 3)
  };
  b3 = p[3].toInt();
  if (b3 < locb || hicb < b3) {
    return (error, 1)
  };
  code = p0
    .and(mask4)
    .shl(18)
    .or(b1.and(maskx).shl(12))
    .or(b2.and(maskx).shl(6))
    .or(b3.and(maskx));
  (Char::fromCode(code), 4)
}

// EncodeRune writes into p (which must be large enough) the UTF-8 encoding of the rune.
// If the rune is out of range, it writes the encoding of RuneError.
// It returns the number of bytes written.
fun encodeChar(char: Char): Array<UInt8> {
  // Negative values are erroneous. Making it unsigned addresses the problem.
  code = char.code();
  if (code < rune1Max) {
    return Array[UInt8::truncate(code)]
  };
  if (code < rune2Max) {
    return Array[
      UInt8::truncate(t2.or(code.shr(6))),
      UInt8::truncate(tx.or(code.and(maskx))),
    ]
  };
  if (code > max.code() && surrogateMin <= code && code <= surrogateMax) {
    !code = error.code();
  };
  if (code <= rune3Max) {
    return Array[
      UInt8::truncate(t3.or(code.shr(12))),
      UInt8::truncate(tx.or(code.shr(6).and(maskx))),
      UInt8::truncate(tx.or(code.and(maskx))),
    ]
  };
  Array[
    UInt8::truncate(t4.or(code.shr(18))),
    UInt8::truncate(tx.or(code.shr(12).and(maskx))),
    UInt8::truncate(tx.or(code.shr(6).and(maskx))),
    UInt8::truncate(tx.or(code.and(maskx))),
  ]
}

// charStart reports whether the byte could be the first byte of an encoded,
// possibly invalid rune. Second and subsequent bytes always have the top two
// bits set to 10.
fun charStart(b: UInt8): Bool {
  b.and(0xC0) != 0x80
}

// These names of these constants are chosen to give nice alignment in the
// table below. The first nibble is an index into acceptRanges or F for
// special one-byte cases. The second nibble is the Rune length or the
// Status for the special one-byte case.
const xx: Int = 0xF1; // invalid: size 1
const asc: Int = 0xF0; // ASCII: size 1
const s1: Int = 0x02; // accept 0, size 2
const s2: Int = 0x13; // accept 1, size 3
const s3: Int = 0x03; // accept 0, size 3
const s4: Int = 0x23; // accept 2, size 3
const s5: Int = 0x34; // accept 3, size 4
const s6: Int = 0x04; // accept 0, size 4
const s7: Int = 0x44; // accept 4, size 4

// The default lowest and highest continuation byte.
const locb: Int = 0x80;
const hicb: Int = 0xBF;

const maskx: Int = 0x3F;
const mask2: Int = 0x1F;
const mask3: Int = 0xF;
const mask4: Int = 0x7;

const rune1Max: Int = 1.shl(7) - 1;
const rune2Max: Int = 1.shl(11) - 1;
const rune3Max: Int = 1.shl(16) - 1;

const t1: Int = 0x0;
const tx: Int = 0x80;
const t2: Int = 0xC0;
const t3: Int = 0xE0;
const t4: Int = 0xF0;
const t5: Int = 0xF8;

const surrogateMin: Int = 0xD800;
const surrogateMax: Int = 0xDFFF;

// acceptRanges has size 16 to avoid bounds checks in the code that uses it.
const acceptRanges: Array<AcceptRange> = Array[
  AcceptRange::make(locb, hicb),
  AcceptRange::make(0xA0, hicb),
  AcceptRange::make(locb, 0x9F),
  AcceptRange::make(0x90, hicb),
  AcceptRange::make(locb, 0x8F),
];

