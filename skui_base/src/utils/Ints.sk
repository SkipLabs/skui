extension class UInt16 {
  const zero: UInt16 = UInt16::truncate(0);

  static fun bigEndian(bytes: Array<UInt8>): UInt32 {
    UInt32::truncate(bytes[1].or(bytes[0].shl(8)))
  }

  static fun littleEndian(bytes: Array<UInt8>): UInt32 {
    UInt32::truncate(bytes[0].or(bytes[1].shl(8)))
  }
}

extension class UInt32 {
  const zero: UInt32 = UInt32::truncate(0);

  static fun bigEndian(bytes: Array<UInt8>): UInt32 {
    UInt32::truncate(
      bytes[3].or(bytes[2].shl(8)).or(bytes[1].shl(16)).or(bytes[0].shl(24)),
    )
  }

  static fun littleEndian(bytes: Array<UInt8>): UInt32 {
    UInt32::truncate(
      bytes[0].or(bytes[1].shl(8)).or(bytes[2].shl(16)).or(bytes[3].shl(24)),
    )
  }
}
