module SkuibuildTest;

@skui_envcmd
fun command(): (Cli.Command, (Cli.ParseResults, Skargo.Env) ~> void) {
  (
    Skuibuild.buildCommand("test")
      .short("t")
      .about("Run the tests")
      .arg(
        Cli.StringArg("filter")
          .positional()
          .about("If specified, only run tests with names matching the filter"),
      )
      .arg(Cli.StringArg("junitxml").about("Generate a JUnit XML report")),
    exec,
  )
}

fun exec(args: Cli.ParseResults, env: Skargo.Env): void {
  deps = Skargo.getDependencies(env.manifest) match {
  | Success(v) -> v
  | Failure(e) -> throw e
  };
  bc = Skargo.BuildContext::create(
    env,
    args.maybeGetString("target"),
    args.maybeGetString("target-dir"),
    args.getBool("debug"),
  );
  Skargo.genVersionFile(bc);
  libraries = mutable Vector<String>[];
  preambles = mutable Vector<String>[];
  links = mutable Set<String>[];
  srcDirs = Array["src"];
  for (dep in deps) {
    Skuibuild.checkLibrary(bc, srcDirs, dep, libraries, preambles, links)
  };
  Skuibuild.checkLibrary(
    bc,
    Array["tests"],
    env.manifest,
    libraries,
    preambles,
    links,
  );
  Skuibuild.applyLibrairies(libraries, preambles, links, bc.env.verbose);
  Skargo.compile(bc, "test", env.manifest.testHarness);
  filter = args.maybeGetString("filter");
  junitxml = args.maybeGetString("junitxml").map(f -> `--junitxml=${f}`);
  if (!bc.isWasm()) {
    Skargo.run(
      Array[Path.join(bc.targetDir, "test")].concat(
        Array[junitxml, filter].filterNone(),
      ),
      env.verbose,
      true,
    );
  } else {
    target = Path.join(bc.targetDir, "ts");
    Skuibuild.ensureDirectory(target, env.verbose);
    Skuibuild.manageJs(target, deps, bc, "test", srcDirs, true)
  }
}

module end;
