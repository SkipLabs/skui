module SkuibuildJS;

fun performers(name: String): ?Performer {
  name match {
  | "html" -> Some(HTMLPerformer())
  | "node" -> Some(NodePerformer(Array[]))
  | _ -> None()
  }
}

base class Performer {
  fun generate(
    root: String,
    target: String,
    name: String,
    env: String,
    runner: String,
    configs: String,
    modules: String,
    verbose: Bool,
  ): ?() ~> void;

  fun generateEnv(target: String, name: String): String;

  protected fun writeLauncher(
    target: String,
    name: String,
    env: String,
    runner: String,
    configs: String,
    modules: String,
  ): void {
    FileSystem.writeTextFile(
      Path.join(target, `${name}.mjs`),
      `
import {run} from "${runner}";

var wasm64 = "${name}";
var environment = "${env}";
var congifs = [${configs}];
var modules = [${modules}];

run(wasm64, environment, modules, congifs);
`,
    );
  }
}

fun manage(
  bin: Skargo.ManifestBinary,
  deps: readonly Map<String, Skargo.Manifest>,
  bc: Skargo.BuildContext,
  srcDirs: Array<String>,
  optPerformer: ?Performer = None(),
): ?() ~> void {
  bin.optPerformer match {
  | Some(performer) ->
    rootTsDir = Path.join(bc.env.rootDir, "ts");
    performerDir = performer
      .dependency(deps)
      .map(dep -> Path.join(Path.join(dep.path, "ts"), performer.name))
      .default(Path.join(rootTsDir, performer.name));
    (optPDir, !optPerformer) = if (FileSystem.exists(performerDir)) {
      (Some(performerDir), None())
    } else {
      (
        None(),
        optPerformer match {
        | None() ->
          performers(performer.name) match {
          | None() ->
            invariant_violation(`Unable to find '${performer.name}' performer`)
          | opt -> opt
          }
        | _ -> optPerformer
        },
      )
    };
    target = Path.join(Path.join(bc.targetDir, bin.name), "ts");
    Skuibuild.ensureDirectory(target, bc.env.verbose);
    copyTypescriptsDeps(deps, target, srcDirs, false, bc.env.verbose);
    configsDir = Path.join(rootTsDir, "configs");
    copyTypescripts(configsDir, target, false, bc.env.verbose);
    optPDir.each(pDir -> copyTypescripts(pDir, target, false, bc.env.verbose));
    tsconfig = Path.join(target, "tsconfig.json");
    FileSystem.writeTextFile(tsconfig, SkuibuildJS.tsConfig(deps));
    Skargo.run(Array["tsc", "--project", tsconfig], bc.env.verbose);
    jsDir = Path.join(target, "js");
    jsFiles = if (FileSystem.exists(jsDir)) {
      FileSystem.readFilesRecursive(jsDir, f ~> f.endsWith(".js"), _f ~> false)
    } else {
      Vector[]
    };
    runDir = Path.join(bc.targetDir, performer.name);
    performDir = Path.join(bc.targetDir, performer.path());
    Skuibuild.ensureDirectory(performDir, bc.env.verbose);
    res = copyAndConvertImport(
      runDir,
      performDir,
      performer,
      bin.name,
      jsFiles,
      optPerformer,
      bc.env.verbose,
    );
    optPDir.each(pDir ->
      Skuibuild.copyFiles(
        pDir,
        runDir,
        f ~> !f.endsWith(".ts") && Path.basename(f) != "tsconfig.json",
        true,
        bc.env.verbose,
      )
    );
    wasmFile = Path.join(bc.targetDir, `${bin.name}.wasm`);
    wasmTarget = Path.join(performDir, `${bin.name}.wasm.mjs`);
    FileSystem.writeTextFile(wasmTarget, wasm(wasmFile));
    res
  | _ -> None()
  }
}

fun copyAndConvertImport(
  root: String,
  target: String,
  performer: Skargo.Performer,
  path: String,
  jsFiles: Vector<String>,
  optPerformer: ?Performer,
  verbose: Bool,
): ?() ~> void {
  wasm64Line = "var wasm64 = \"/*--NAME--*/\";";
  envLine = "var environment = \"/*--ENVIRONMENT--*/\";";
  modulesLines = "var modules = [ /*--MODULES--*/];";
  configsLines = "var congifs = [ /*--CONFIGS--*/];";
  moduleFiles = mutable Vector<String>[];
  configFiles = mutable Vector<String>[];
  tmplFiles = mutable Vector<(String, Vector<String>)>[];
  envFiles = mutable Vector<String>[];
  runFiles = mutable Vector<String>[];
  jsFiles.each(f -> {
    contents = FileSystem.readTextFile(f);
    withInit = false;
    withConfig = false;
    withTmpl = false;
    withEnv = false;
    withRun = false;
    lines = contents.split("\n").map(line -> {
      if (line.startsWith("import ")) {
        elements = line.split(" from ");
        if (elements.size() == 2) {
          imported = elements[1].split("\"");
          if (imported.size() == 3) {
            elems = imported[1].split("/");
            size = elems.size();
            if (size > 1 && elems[0].startsWith("#")) {
              !elems = elems.mapWithIndex((idx, v) ->
                if (idx == 0) "." else if (idx == size - 1) {
                  `${v}.mjs`
                } else {
                  v
                }
              );
              !line = `${elements[0]} from "${elems.join("/")}"`
            }
          }
        }
      };
      cLine = line.trim();
      if (
        cLine == wasm64Line ||
        cLine == modulesLines ||
        cLine == configsLines
      ) {
        !withTmpl = true;
      } else if (cLine == "/** @sk config */") {
        !withConfig = true;
      } else if (cLine == "/** @sk init */") {
        !withInit = true;
      } else if (cLine == `/** @sk env ${performer.name} */`) {
        !withEnv = true;
      } else if (cLine == `/** @sk run */`) {
        !withRun = true;
      };
      line;
    });
    tf = Path.join(target, Path.basename(f).replace(".js", ".mjs"));
    invariant(
      i(withTmpl) + i(withInit) + i(withConfig) + i(withEnv) + i(withRun) <= 1,
      `The file ${Path.basename(f).replace(
        ".js",
        ".ts",
      )} cannot have multiple behaviors.`,
    );
    if (!withTmpl) {
      FileSystem.writeTextFile(tf, lines.join("\n"));
      if (withInit) {
        moduleFiles.push(Path.basename(tf));
      } else if (withConfig) {
        configFiles.push(Path.basename(tf));
      } else if (withEnv) {
        envFiles.push(Path.basename(tf));
      } else if (withRun) {
        runFiles.push(Path.basename(tf));
      }
    } else {
      tmplFiles.push((tf, lines))
    };
  });
  strConfigs = configFiles.map(c -> `"./${c}"`).join(", ");
  strModules = moduleFiles.map(m -> `"./${m}"`).join(", ");
  check("environment providers", envFiles, None());
  check("run providers", runFiles, Some("A run supplier"));
  env = envFiles.maybeGet(0) match {
  | Some(env) -> env
  | _ ->
    optPerformer match {
    | Some(p) -> p.generateEnv(target, path)
    | _ ->
      invariant_violation(
        `An environment supplier must be defined for '${performer.name}'.`,
      )
    }
  };
  strEnvironment = `./${env}`;
  strRun = `./${runFiles[0]}`;
  tmplFiles.each(fi -> {
    (tf, lines) = fi;
    !lines = lines.map(line -> {
      cLine = line.trim();
      if (cLine == wasm64Line) {
        `var wasm64 = "${path}";`
      } else if (cLine == modulesLines) {
        `var modules = [${strModules}];`
      } else if (cLine == configsLines) {
        `var congifs = [${strConfigs}];`
      } else if (cLine == envLine) {
        `var environment = "${strEnvironment}";`
      } else {
        line
      }
    });
    FileSystem.writeTextFile(tf, lines.join("\n"));
  });
  optPerformer.flatMap(p ->
    p.generate(
      root,
      target,
      path,
      strEnvironment,
      strRun,
      strConfigs,
      strModules,
      verbose,
    )
  )
}

fun i(v: Bool): Int {
  if (v) 1 else 0;
}

fun wasm(path: String): String {
  p = System.subprocess(Array["base64", path]);
  strOut = p.stdout.trim();
  b64 = strOut.replace("\n", "");
  `export var base64 = "${b64}";`
}

class HTMLPerformer() extends Performer {
  //
  fun generate(
    root: String,
    target: String,
    name: String,
    env: String,
    runner: String,
    configs: String,
    modules: String,
    verbose: Bool,
  ): ?() ~> void {
    this.writeLauncher(target, name, env, runner, configs, modules);
    this.writeIndex(
      root,
      Skuibuild.relative(target, root)
        .map(r -> Path.join(r, name))
        .default(name),
    );
    Some(this.writeRun(root, verbose))
  }

  fun generateEnv(_target: String, _name: String): String {
    invariant_violation("An environment supplier must be defined for 'html'.");
  }

  private fun writeIndex(target: String, name: String): void {
    FileSystem.writeTextFile(
      Path.join(target, "index.html"),
      Array[
        "<!DOCTYPE html>",
        "<html>",
        "  <head lang=\"en\">",
        "    <meta charset=\"utf-8\">",
        "    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />",
        `    <script type="module" src=\"./${name}.mjs\"></script>`,
        "    <link rel=\"icon\" href=\"data:,\">",
        "  </head>",
        "  <body>",
        "  </body>",
        "</html>",
      ].join("\n"),
    )
  }

  private fun writeRun(target: String, verbose: Bool): () ~> void {
    runFile = Path.join(target, "run.sh");
    FileSystem.writeTextFile(
      runFile,
      "#!/bin/bash\npython3 -m http.server 8000\n",
    );
    Skargo.run(Array["chmod", "+x", runFile], verbose);
    () ~> Skargo.run(Array["bash", runFile], verbose);
  }
}

class NodePerformer(args: Array<String>) extends Performer {
  fun generate(
    _root: String,
    target: String,
    name: String,
    env: String,
    runner: String,
    configs: String,
    modules: String,
    verbose: Bool,
  ): ?() ~> void {
    this.writeLauncher(target, name, env, runner, configs, modules);
    Some(() ~>
      Skargo.run(
        Array["node", "--experimental-modules"].concat(this.args).concat(
          Array[Path.join(target, `${name}.mjs`)],
        ),
        verbose,
        true,
      )
    )
  }

  fun generateEnv(target: String, name: String): String {
    envname = `${name}_node_env.mjs`;
    FileSystem.writeTextFile(
      Path.join(target, envname),
      Array[
        "import * as fs from 'fs';",
        "import * as util from 'util';",
        "import * as perf_hooks from 'perf_hooks';",
        "",
        "var decoder = new util.TextDecoder('utf8');",
        "",
        "class Env {",
        "  constructor(configs) {",
        "    this.configs = configs;",
        "    this.timestamp = () => perf_hooks.performance.now();",
        "    this.decodeUTF8 = (v) => decoder.decode(v);",
        "    this.arguments = process.argv.slice(3);",
        "    this.appendTextTo = fs.appendFileSync;",
        "    this.base64Decode = (base64) => Buffer.from(base64, \"base64\");",
        "    this.complete = (exports, shared) => exports.skip_main();",
        "    this.throwRuntime = (code) => process.exit(code);",
        "  }",
        "}",
        "",
        "/** @sk env node */",
        "export function environment(configs) {",
        "  return new Env(configs);",
        "}",
      ].join("\n"),
    );
    envname
  }
}

fun check(
  several: String,
  files: readonly Vector<String>,
  optSingle: ?String,
): void {
  optSingle.each(single ->
    invariant(!files.isEmpty(), `${single} must be defined.`)
  );
  if (files.size() > 1) {
    invariant_violation(
      `Several ${several} have been found (${files.map(f ->
        f.split(".").take(files.size() - 1).join(".")
      )}), please specify which one to use.`,
    )
  }
}

fun tsConfig(deps: readonly Map<String, Skargo.Manifest>): String {
  path = JSON.Array(Vector[JSON.String("./*")]);
  paths = mutable Map<String, JSON.Value>[];
  deps.each((_, v) -> paths.set(`#${v.name}` + "/*", path));
  JSON.Object(
    Map[
      "compilerOptions" => JSON.Object(
        Map[
          "target" => JSON.String("ES2021"),
          "outDir" => JSON.String("js"),
          "baseUrl" => JSON.String("."),
          "paths" => JSON.Object(unsafe_chill_trust_me(paths)),
          "strictNullChecks" => JSON.Bool(true),
          "module" => JSON.String("esnext"),
        ],
      ),
    ],
  ).toString()
}

fun copyTypescriptsDeps(
  deps: readonly Map<String, Skargo.Manifest>,
  target: String,
  srcDirs: Array<String>,
  dip: Bool,
  verbose: Bool,
): void {
  for (dep in deps) {
    srcDirs.each(srcDir -> {
      tsPath = Path.join(Path.join(dep.path, "ts"), srcDir);
      resPath = Path.join(Path.join(dep.path, "resources"), srcDir);
      if (FileSystem.exists(resPath)) {
        FileSystem.readFilesRecursive(
          resPath,
          f ~> f.endsWith(".bin"),
          _f ~> false,
        ).each(f ~> {
          fn = Path.basename(f).replace(".", "_");
          tf = Path.join(target, `${dep.name}.${srcDir}.${fn}.ts`);
          FileSystem.writeTextFile(tf, tsResource(`${dep.name}_${srcDir}`, f))
        });
      };
      copyTypescripts(tsPath, target, dip, verbose)
    })
  }
}

fun tsResource(mName: String, path: String): String {
  name = Path.basename(path).replace(".", "_");
  p = System.subprocess(Array["base64", path]);
  strOut = p.stdout.trim();
  b64 = strOut.replace("\n", "");
  Array[
    `var ${name} = "${b64}";`,
    "",
    "interface ToWasm {",
    `  SKIP_${mName}_${name}: () => number;`,
    "}",
    "interface Env {",
    `  base64Decode: (base64: String) => Uint8Array;`,
    "}",
    "",
    "interface Utils {",
    "  exportBytes: (s: Uint8Array) => number;",
    "}",
    "",
    "class LinksImpl implements ToWasm {",
    "  env: Env;",
    "  constructor(env: Env) {",
    "    this.env = env;",
    "  }",
    `  SKIP_${mName}_${name}: () => number;`,
    "",
    "  complete = (utils: Utils, exports: object) => {",
    `    this.SKIP_${mName}_${name} = () => {`,
    `      let buffer = this.env.base64Decode(${name});`,
    "      return utils.exportBytes(buffer);",
    "    }",
    "    return null;",
    "  }",
    "}",
    "",
    "class Manager {",
    "  env: Env;",
    "  constructor(env: Env) {",
    "   this.env = env;",
    "  }",
    "  prepare = (wasm: object) => {",
    "    let toWasm = wasm as ToWasm;",
    "    let links = new LinksImpl(this.env);",
    `    toWasm.SKIP_${mName}_${name} =  () => links.SKIP_${mName}_${name}();`,
    "    return links;",
    "  }",
    "}",
    "",
    "/** @sk init */",
    "export function init(env: Env) {",
    "  return Promise.resolve(new Manager(env));",
    "}",
    "",
  ].join("\n")
}

fun copyTypescripts(
  sourceDir: String,
  targetDir: String,
  dip: Bool,
  verbose: Bool,
): void {
  Skuibuild.copyFiles(
    sourceDir,
    targetDir,
    f ~> f.endsWith(".ts"),
    dip,
    verbose,
  )
}

module end;
