module Skuibuild;

fun main(): void {
  envCommands = Map["build" => buildInfo(), "test" => testInfo()];
  cmd = Cli.Command("skuiargo")
    .about("Skip UI's package manager")
    .arg(
      Cli.BoolArg("version")
        .short("V")
        .long("version")
        .about("Print version info and exit"),
    )
    .arg(
      Cli.BoolArg("verbose")
        .short("v")
        .long("verbose")
        .about("Use verbose output")
        .global(),
    )
    .help();
  envCommands.each((_, ci) -> !cmd = cmd.subcommand(ci.i0));
  args = cmd
    .subcommand(
      Cli.Command("check")
        .short("c")
        .about(
          "Analyze the current package and report errors, but don't build object files",
        )
        .arg(Cli.StringArg("target").about("Check for the target triple"))
        .arg(
          Cli.StringArg("target-dir").about(
            "Directory for all generated artifacts",
          ),
        )
        .arg(
          Cli.StringArg("profile").about(
            "Build artifacts with the specified profile",
          ),
        )
        .arg(
          Cli.BoolArg("release")
            .short("r")
            .long("release")
            .about("Build artifacts in release mode, with optimizations"),
        ),
    )
    .subcommand(
      Cli.Command("clean")
        .about("Remove the target directory")
        .arg(
          Cli.StringArg("target-dir").about(
            "Directory for all generated artifacts",
          ),
        )
        .arg(
          Cli.StringArg("profile").about(
            "Build artifacts with the specified profile",
          ),
        )
        .arg(
          Cli.BoolArg("release")
            .short("r")
            .long("release")
            .about("Build artifacts in release mode, with optimizations"),
        ),
    )
    .subcommand(
      Cli.Command("fmt")
        .arg(Cli.BoolArg("one").about("Format file one by one"))
        .about("Format all files using skfmt"),
    )
    .subcommand(
      Cli.Command("init")
        .about("Create a new skargo package")
        .arg(
          Cli.StringArg("path")
            .default(".")
            .about("Directory where to perform the initialization"),
        )
        .arg(
          Cli.StringArg("test-harness")
            .short("t")
            .long("test-harness")
            .about("Specify the test harness"),
        ),
    )
    .subcommand(
      Cli.Command("update").about("Update dependencies listed in Skargo.lock"),
    )
    .subcommand(
      Cli.Command("help")
        .extra()
        .about("Displays help for a skargo subcommand"),
    )
    .parseArgs();

  if (args.getBool("version")) {
    print_string("skuiargo " + SkargoVersion.kVersion);
    skipExit(0)
  } else if (args.maybeGetSubcommand().isNone()) {
    print_string(Cli.usage(args.cmd, true));
    skipExit(0)
  } else {
    trycall = run ->
      vtry<Int>(
        () -> {
          run();
          0
        },
        exn ->
          exn match {
          | Skargo.SystemCallException(code, _) -> code
          | _ -> throw exn
          }
        ,
      );
    skipExit(
      args
        .maybeGetSubcommand()
        .map(subcmd ->
          envCommands.maybeGet(subcmd) match {
          | Some(ci) -> Some(ci.i1)
          | _ ->
            subcmd match {
            | "update" -> Some(Skuibuild.execUpdate)
            | "check" -> Some(Skuibuild.execCheck)
            | "clean" -> Some(Skuibuild.execClean)
            | "fmt" -> Some(Skuibuild.execFmt)
            | _ -> None()
            }
          } match {
          | Some(subcmd_handler) ->
            env = Skargo.Env::create(args.getBool("verbose"));
            trycall(() -> subcmd_handler(args, env))
          | _ ->
            trycall(() ->
              subcmd match {
              | "init" -> Skargo.execInit(args)
              | "help" -> Skargo.execHelp(args)
              | _ -> invariant_violation(`Unknown subcommand ${subcmd}`)
              }
            )
          }
        )
        .default(0),
    )
  }
}

@skui_envcmd
fun buildInfo(): (Cli.Command, (Cli.ParseResults, Skargo.Env) ~> void) {
  (
    Skuibuild.buildCommand("build")
      .short("b")
      .arg(Cli.BoolArg("sk2llvm").about("Build with skip_to_llvm"))
      .about("Compile a local package"),
    execBuild,
  )
}

fun build(
  args: Cli.ParseResults,
  env: Skargo.Env,
  then: (
    readonly Map<String, Skargo.Manifest>,
    Skargo.BuildContext,
    Skargo.ManifestBinary,
    Array<String>,
  ) ~> void,
  allows: (Skargo.ManifestBinary, Skargo.BuildContext) ~> Bool,
  dirs: Array<String>,
  binaries: ?Array<Skargo.ManifestBinary>,
  allowSk2Llvm: Bool,
): void {
  deps = Skargo.getDependencies(env.manifest) match {
  | Success(v) -> v
  | Failure(e) -> throw e
  };
  profile = Skargo.getProfile(args);
  bc = Skargo.BuildContext::create(
    env,
    args.maybeGetString("target"),
    args.maybeGetString("target-dir"),
    profile,
  );
  Skargo.genVersionFile(bc);
  (libraries, preambles) = checkLibraries(bc, dirs, deps);
  for (bin in binaries.default(env.manifest.bin)) {
    if (allows(bin, bc)) {
      if (allowSk2Llvm && args.getBool("sk2llvm")) {
        compile(bc, bin.name, bin.main, libraries, preambles)
      } else {
        simpleCompile(bc, bin.name, bin.main)
      };
      then(deps, bc, bin, dirs)
    }
  };
}

fun execBuild(args: Cli.ParseResults, env: Skargo.Env): void {
  build(
    args,
    env,
    (deps, bc, bin, dirs) ~>
      if (bc.isWasm()) {
        _ = SkuibuildJS.manage(bin, deps, bc, dirs);
      },
    (bin, bc) ~> bin.allows(bc.target),
    Array["src"],
    None(),
    true,
  )
}

@skui_envcmd
fun testInfo(): (Cli.Command, (Cli.ParseResults, Skargo.Env) ~> void) {
  (
    Skuibuild.buildCommand("test")
      .short("t")
      .about("Run the tests")
      .arg(
        Cli.StringArg("filter")
          .positional()
          .about("If specified, only run tests with names matching the filter"),
      )
      .arg(Cli.StringArg("junitxml").about("Generate a JUnit XML report")),
    execTest,
  )
}

fun execTest(args: Cli.ParseResults, env: Skargo.Env): void {
  bin = Skargo.ManifestBinary(
    "test",
    env.manifest.testHarness,
    None(),
    Some(Skargo.Performer("node")),
  );
  build(
    args,
    env,
    (deps, bc, bin, dirs) ~> {
      filter = args.maybeGetString("filter");
      junitxml = args.maybeGetString("junitxml").map(f -> `--junitxml=${f}`);
      runArgs = Array[junitxml, filter].filterNone();
      if (!bc.isWasm()) {
        Skargo.run(
          Array[Path.join(bc.targetDir, "test")].concat(runArgs),
          env.verbose,
          true,
        );
      } else {
        SkuibuildJS.manage(
          bin,
          deps,
          bc,
          dirs,
          Some(SkuibuildJS.NodePerformer(runArgs)),
        ).each(runner -> runner())
      }
    },
    (_bin, _bc) ~> true,
    Array["src", "tests"],
    Some(Array[bin]),
    false,
  );
}

fun buildCommand(name: String): Cli.Command {
  Cli.Command(name)
    .arg(Cli.StringArg("target").about("Check for the target triple"))
    .arg(
      Cli.StringArg("target-dir").about(
        "Directory for all generated artifacts",
      ),
    )
    .arg(
      Cli.StringArg("profile").about(
        "Build artifacts with the specified profile",
      ),
    )
    .arg(
      Cli.BoolArg("release")
        .short("r")
        .long("release")
        .about("Build artifacts in release mode, with optimizations"),
    )
}

fun execUpdate(args: Cli.ParseResults, env: Skargo.Env): void {
  Skargo.execUpdate(args, env)
}

fun checkLibrary(
  bc: Skargo.BuildContext,
  dirs: Array<String>,
  dep: Skargo.Manifest,
  libraries: mutable Vector<String>,
  preambles: mutable Vector<String>,
  links: mutable Set<String>,
  includeDirs: SortedSet<String>,
  optITime: ?Int,
): void {
  isWasm = bc.isWasm();
  (dir, ext, resources) = if (isWasm) ("wasm", ".bc", Array[]) else {
    resources = Array[];
    refPath = Path.join(dep.path, "resources");
    if (FileSystem.exists(refPath)) {
      dirs.each(dir -> {
        rscsPath = Path.join(refPath, dir);
        if (FileSystem.exists(rscsPath)) {
          !resources = resources.concat(
            buildResources(bc, dep.path, refPath, rscsPath),
          )
        }
      })
    };
    ("native", ".a", resources)
  };
  refPath = Path.join(dep.path, dir);

  if (FileSystem.exists(refPath)) {
    for (name in dirs) {
      sourceDir = Path.join(refPath, name);
      if (FileSystem.exists(sourceDir)) {
        libname = `lib${dep.name}_${name}${if (bc.isDebug()) "_debug" else {
          ""
        }}${ext}`;
        target = Path.join(bc.targetDir, libname);
        buildLibrary(
          bc,
          refPath,
          sourceDir,
          target,
          resources,
          includeDirs,
          optITime,
        ).each(lib -> libraries.push(lib))
      }
    }
  };
  if (!isWasm) {
    dirs.each(srcDir ->
      getExternals(dep, `lib/${srcDir}`).each(external -> {
        contents = FileSystem.readTextFile(external).split("\n");
        contents.each(link ->
          if (!link.trim().isEmpty()) {
            links.insert(link)
          }
        )
      })
    );
  };
  llExt = if (isWasm) "32.ll" else "64.ll";
  dirs.each(srcDir ->
    getFiles(dep, llExt, `lib/${srcDir}`).each(preambles.push)
  );
}

fun setEnv(name: String, value: String, verbose: Bool): void {
  if (verbose) print_error(`>> SET ${name}=${value}`);
  invariant(!setenv(name, value, true), `Unable to set ${name}`);
}

fun applyLibrairies(
  libraries: readonly Vector<String>,
  preambles: readonly Vector<String>,
  links: readonly Set<String>,
  verbose: Bool,
): void {
  setEnv(
    "SKC_LINK",
    libraries.toArray().concat(links.toArray()).join(" ").trim(),
    verbose,
  );
  setEnv("SKC_PREAMBLE", preambles.join(" ").trim(), verbose);
}

fun checkLibraries(
  bc: Skargo.BuildContext,
  dirs: Array<String>,
  deps: readonly Map<String, Skargo.Manifest>,
): (Array<String>, Array<String>) {
  includeDirs = SortedSet[];
  optITime: ?Int = None();
  for (dep in deps) {
    dirs.each(dir -> {
      sourcesDir = Path.join(
        Path.join(dep.path, if (bc.isWasm()) "wasm" else "native"),
        dir,
      );
      if (FileSystem.exists(sourcesDir)) {
        files = FileSystem.readFilesRecursive(
          sourcesDir,
          f ~> f.endsWith(".hpp") || f.endsWith(".h"),
          _f ~> true,
        );
        files.each(i -> {
          !includeDirs = includeDirs.set(Path.dirname(i));
          !optITime = max(optITime, mtime(i))
        })
      }
    });
  };
  libraries = mutable Vector<String>[];
  preambles = mutable Vector<String>[];
  links = mutable Set<String>[];
  for (dep in deps) {
    checkLibrary(
      bc,
      dirs,
      dep,
      libraries,
      preambles,
      links,
      includeDirs,
      optITime,
    )
  };
  applyLibrairies(libraries, preambles, links, bc.env.verbose);
  (libraries.toArray().concat(links.toArray()), preambles.toArray())
}

fun execClean(args: Cli.ParseResults, env: Skargo.Env): void {
  Skargo.execClean(args, env)
}

fun execFmt(args: Cli.ParseResults, env: Skargo.Env): void {
  if (args.getBool("one")) {
    files = env.manifest.srcs.concat(env.manifest.tests);
    files.each(f -> Skargo.run(Array["skfmt", "-i", f], env.verbose))
  } else {
    Skargo.execFmt(args, env)
  }
}

fun execCheck(args: Cli.ParseResults, env: Skargo.Env): void {
  execFormatAndCheck(args, env)
}

fun execFormatAndCheck(
  args: Cli.ParseResults,
  env: Skargo.Env,
  doNotFormat: Bool = false,
): void {
  if (env.config.formatOnCheck && !doNotFormat) {
    Skargo.execFmt(args, env)
  };
  Skargo.execCheck(args, env)
}

@cpp_extern("SKIP_setenv")
native fun setenv(name: String, value: String, replace: Bool): Bool;

private fun getMakefiles(
  deps: readonly Map<String, Skargo.Manifest>,
): Array<(String, String)> {
  files = mutable Vector<(String, String)>[];
  for (dep in deps) {
    makefilePath = Path.join(dep.path, "Libraries.mk");
    if (FileSystem.exists(makefilePath)) {
      files.push((dep.path, makefilePath))
    }
  };
  files.collect(Array)
}

private fun getFiles(
  dep: Skargo.Manifest,
  ext: String,
  path: String,
  depth: Bool = false,
): Array<String> {
  libPath = Path.join(dep.path, path);
  if (FileSystem.exists(libPath)) {
    FileSystem.readFilesRecursive(
      libPath,
      f ~> f.endsWith(ext),
      _f ~> depth,
    ).toArray()
  } else {
    Array[]
  }
}

fun getExternals(dep: Skargo.Manifest, path: String): ?String {
  externalsPath = Path.join(Path.join(dep.path, path), "externals.lnk");
  if (FileSystem.exists(externalsPath)) {
    Some(externalsPath)
  } else {
    None()
  }
}

fun copyFiles(
  sourceDir: String,
  targetDir: String,
  test: String ~> Bool,
  dip: Bool,
  verbose: Bool,
): void {
  if (FileSystem.exists(sourceDir)) {
    FileSystem.readFilesRecursive(sourceDir, test, _f ~> dip).each(f ~> {
      fn = Path.basename(f);
      targetFile = Path.join(targetDir, fn);
      Skargo.run(Array["cp", f, targetFile], verbose);
    })
  }
}

fun relative(path: String, to: String): ?String {
  if (!to.endsWith("/")) {
    !to = to + "/";
  };
  if (path.startsWith(to)) {
    Some(path.sub(path.getIter().drop(to.chars().size()), path.chars().size()))
  } else {
    None()
  }
}

private fun ensureDirectory(path: String, verbose: Bool): void {
  if (!FileSystem.exists(path)) {
    Skargo.run(Array["mkdir", "-p", path], verbose)
  }
}

fun mtime(path: String): ?Int {
  if (FileSystem.exists(path)) {
    p = System.subprocess(Array["stat", "-c", "%Y", path]);
    if (p.exitcode != 0) {
      None()
    } else {
      p.stdout.trim().toIntOption()
    }
  } else {
    None()
  }
}

fun buildResources(
  bc: Skargo.BuildContext,
  rootDir: String,
  refDir: String,
  rscsDir: String,
): Array<String> {
  // TODO: Manage correctly architectures
  resources = FileSystem.readFilesRecursive(
    rscsDir,
    f ~> f.endsWith(".bin"),
    _f ~> true,
  ).map(bf -> buildResource(rootDir, refDir, bc.targetDir, bf, bc.env.verbose));
  resources.toArray()
}

fun buildLibrary(
  bc: Skargo.BuildContext,
  refDir: String,
  sourcesDir: String,
  target: String,
  resources: Array<String>,
  includeDirs: SortedSet<String>,
  optITime: ?Int,
): ?String {
  sources = FileSystem.readFilesRecursive(
    sourcesDir,
    f ~> f.endsWith(".cpp") || f.endsWith(".c"),
    _f ~> true,
  );
  if (sources.isEmpty()) {
    return None()
  };
  optTime = mtime(target);
  optSTime = optITime;
  timedSources = sources.map(s -> {
    fOptMTime = mtime(s);
    !optSTime = max(optSTime, fOptMTime);
    (s, fOptMTime)
  });
  includeOptions = includeDirs.toArray().map(i -> `-I${i}`);
  if (optTime.map(t -> optSTime.map(s -> t < s).default(true)).default(true)) {
    objects = timedSources
      .map(f ->
        compileFile(bc, refDir, f.i0, max(f.i1, optITime), includeOptions)
      )
      .toArray();
    cmd = if (bc.isWasm()) {
      Array["llvm-link", "-o", target].concat(objects).concat(resources)
    } else {
      Array["ar", "rcs", target].concat(objects).concat(resources)
    };
    Skargo.run(cmd, bc.env.verbose);
  };
  Some(target)
}

fun compileFile(
  bc: Skargo.BuildContext,
  refDir: String,
  source: String,
  optTime: ?Int,
  includes: Array<String>,
): String {
  debugMode = bc.isDebug();
  ext = if (bc.isWasm()) ".bc" else ".o";
  suffix = if (debugMode) `_debug${ext}` else ext;
  object = targetPath(
    bc.targetDir,
    relative(source, refDir).fromSome(),
    suffix,
  );
  oTime = mtime(object);
  compile = oTime.isNone() || optTime.isNone() || optTime > oTime;
  if (compile) {
    ensureDirectory(Path.dirname(object), bc.env.verbose);
    cmd = (if (source.endsWith(".c")) Array["clang"] else {
      Array["clang++", "-std=c++17"]
    })
      .concat(
        if (debugMode) {
          Array["-g", "-O0", "-DDEBUG"]
        } else if (bc.isRelease()) {
          Array["-O3"]
        } else {
          Array["-O0"]
        },
      )
      .concat(
        if (bc.isWasm()) {
          Array["-DSKIP32", "--target=wasm32", "-emit-llvm"]
        } else {
          Array["-DSKIP64"]
        },
      )
      .concat(includes)
      .concat(Array["-o", object, "-c", source]);
    Skargo.run(cmd, bc.env.verbose);
  };
  object
}

fun buildResource(
  rootDir: String,
  refDir: String,
  targetDir: String,
  file: String,
  verbose: Bool,
): String {
  optTime = mtime(file);
  object = targetPath(targetDir, relative(file, refDir).fromSome(), ".o");
  oTime = mtime(object);
  create = oTime.isNone() || optTime.isNone() || optTime > oTime;
  if (create) {
    ensureDirectory(Path.dirname(object), verbose);
    relative = relative(file, rootDir).fromSome();
    nf = file.replace("/", "_").replace(".", "_");
    nr = relative.replace("/", "_").replace(".", "_");
    redefs = mutable Vector<String>[];
    Array["start", "size", "end"].each(suffix -> {
      redefs.push("--redefine-sym");
      redefs.push(`_binary_${nf}_${suffix}=_binary_${nr}_${suffix}`);
    });
    (b, o) = copyObjOptions();
    cmd = Array[
      "objcopy",
      "-B",
      b,
      "-I",
      "binary",
      "-O",
      o,
      file,
      object,
    ].concat(redefs.toArray());
    Skargo.run(cmd, verbose);
  };
  object
}

fun targetPath(dir: String, file: String, suffix: String): String {
  dirname = Path.dirname(file);
  ext = Path.extname(file);
  basename = Path.basename(file);
  !basename = basename.take(basename.length() - ext.length());
  Path.join(dir, Path.join(dirname, `${basename}${suffix}`));
}

fun max(ot1: ?Int, ot2: ?Int): ?Int {
  (ot1, ot2) match {
  | (Some(t1), Some(t2)) -> Some(if (t1 > t2) t1 else t2)
  | (optTime, None()) -> optTime
  | (None(), optTime) -> optTime
  }
}

fun arch(): String {
  p = System.subprocess(Array["gcc", "-dumpmachine"]);
  p.stdout.trim();
}

fun copyObjOptions(): (String, String) {
  arch().split("-").maybeGet(0) match {
  | Some("x86_64") -> ("i386:x86-64", "elf64-x86-64")
  | Some("aarch64")
  | _ ->
    ("aarch64", "elf64-littleaarch64")
  }
}

fun simpleCompile(
  bc: Skargo.BuildContext,
  binName: String,
  main: String,
): void {
  output = bc.target match {
  | Some(t) if (t.isWasm()) -> binName + ".wasm"
  | _ if (bc.isDebug()) -> binName + "_debug"
  | _ -> binName
  };
  Skargo.invokeSkc(
    bc,
    Array[
      "--export-function-as",
      `${main}=skip_main`,
      "-o",
      Path.join(bc.targetDir, output),
    ].concat(profileOptions(bc.profile)),
  )
}

fun profileOptions(profile: String): Array<String> {
  if (profile == Skargo.kReleaseProfile) {
    Array["-O3"]
  } else {
    Array["-O0"]
  }
}

module end;

module Skargo;

const kDebugProfile: String = "debug";

extension class BuildContext {
  fun isDebug(): Bool {
    this.profile == kDebugProfile;
  }

  fun isRelease(): Bool {
    this.profile == kReleaseProfile;
  }
}

module end;
