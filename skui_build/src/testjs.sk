module Skuibuild;

fun testjs(path: String, modules: Array<String>): String {
  Array[
    "import {start} from \"./skui_types.mjs\";",
    "import * as fs from 'fs';",
    "import * as util from 'util';",
    "import * as perf_hooks from 'perf_hooks';",
    "",
    "var decoder = new util.TextDecoder('utf8');",
    "",
    "class Env {",
    "  constructor() {",
    "    this.timestamp = () => perf_hooks.performance.now();",
    "    this.decodeUTF8 = (v) => decoder.decode(v);",
    "    this.arguments = process.argv.slice(3);",
    "    this.appendTextTo = fs.appendFileSync;",
    "    this.base64Decode = (base64) => Buffer.from(base64, \"base64\");",
    "    this.complete = (exports, shared) => exports.skip_main();",
    "  }",
    "}",
    "",
    "function readData(path) {",
    "  return new Promise(function (resolve, reject) {",
    "    fs.readFile(path, null, (err, data) => {",
    "      err ? reject(err) : resolve(data);",
    "    });",
    "  });",
    "};",
    `var modules = [${modules.map(m -> "\"./" + m + "\"").join(", ")}];`,
    `var path = "${path}";`,
    "var env = new Env();",
    "readData(path).then(buffer => start(modules, buffer, env)).catch(e => console.error(e));",
    "/**/",
  ].join("\n")
}

fun tsConfig(deps: readonly Map<String, Skargo.Manifest>): String {
  path = JSON.Array(Vector[JSON.String("./*")]);
  paths = mutable Map<String, JSON.Value>[];
  deps.each((_, v) -> paths.set(`#${v.name}` + "/*", path));
  JSON.Object(
    Map[
      "compilerOptions" => JSON.Object(
        Map[
          "target" => JSON.String("ES2021"),
          "outDir" => JSON.String("js"),
          "baseUrl" => JSON.String("."),
          "paths" => JSON.Object(unsafe_chill_trust_me(paths)),
          "strictNullChecks" => JSON.Bool(true),
          "module" => JSON.String("esnext"),
        ],
      ),
    ],
  ).toString()
}

module end;
