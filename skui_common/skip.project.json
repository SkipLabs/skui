{
  "skipVersion": "1.0",
  "variables": {
    "backend": {
      "values": ["native"],
      "default": "native"
    }
  },
  "programUnits": {
    "skui_common": {
      "kind": "Library",
      "sources": ["src/**"],
      "references": [
        { "path": ".", "name": "prelude" },
        { "path": ".", "name": "skfs" },
        { "path": ".", "name": "base" }
      ]
    },
    "test": {
      "kind": "Library",
      "sources": ["tests/**"],
      "references": [
        { "path": ".", "name": "skui_common" },
        { "path": ".", "name": "sktest" }
      ]
    },
    "base": {
      "kind": "Library",
      "sources": ["../skui_base/src/**"],
      "references": []
    },
    "skfs": {
      "kind": "Library",
      "sources": ["../../skfs_new/skfs/src/**"],
      "references": []
    },
    "prelude": {
      "kind": "Library",
      "sources": [
        "../../skfs_new/prelude/src/Runtime.sk",
        "../../skfs_new/prelude/src/core/**",
        "../../skfs_new/prelude/src/stdlib/**"
      ],
      "parameters": {
        "backend": {
          "native": { "sources": ["../../skfs_new/prelude/src/native"] }
        }
      },
      "references": []
    },
    "sktest": {
      "kind": "Library",
      "sources": ["../../skfs_new/sktest/src/**"],
      "references": [
        { "path": ".", "name": "termcolor" },
        { "path": ".", "name": "cli" }
      ]
    },
    "termcolor": {
      "kind": "Library",
      "sources": ["../../skfs_new/termcolor/src/**"],
      "references": []
    },
    "cli": {
      "kind": "Library",
      "sources": ["../../skfs_new/cli/src/**"],
      "references": []
    }
  },
  "default": "skui_common"
}
