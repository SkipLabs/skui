module Geometry;

value class Range(min: Float, max: Float) uses Hashable, Equality {
  fun size(): Float {
    this.max - this.min
  }

  fun isIn(n: Float): Bool {
    n >= this.min && n < this.max;
  }
}

/**
 * Holds a 2D floating-point size.
 * You can think of this as an Offset from the origin.
 */
class Size(
  /**
   * The horizontal extent of this size.
   */
  width: Float,
  /**
   * The vertical extent of this size.
   */
  height: Float,
) uses Hashable, Orderable {
  /**
   * Size with the given width and height to 0.0
   */
  const zero: Size = Size(0.0, 0.0);

  /**
   * Creates a Size with the given height and an infinite width.
   */
  static fun fromHeight(height: Float): Size {
    Size(Float::inf, height);
  }
  /**
   * Creates a square Size whose width and height are twice the given dimension.
   * This is a square that contains a circle with the given radius.
   */
  static fun fromRadius(radius: Float): Size {
    Size(radius * 2.0, radius * 2.0);
  }
  /**
   * Creates a Size with the given height and an infinite width.
   */
  static fun fromWidth(width: Float): Size {
    Size(width, Float::inf);
  }
  /**
   * Creates a square Size whose width and height are the given dimension.
   */
  static fun square(dimension: Float): Size {
    Size(dimension, dimension);
  }

  /**
   * The aspect ratio of this size.
   *
   * This returns the width divided by the height.
   *
   * If the width is zero, the result will be zero. If the height is zero (and the width is not), the result will be double.infinity or double.negativeInfinity as determined by the sign of width.
   */
  fun aspectRatio(): Float {
    if (this.height != 0.0) {
      this.width / this.height;
    } else if (Math.greater(this.width, 0.0)) {
      Float::inf
    } else if (Math.lower(this.width, 0.0)) {
      -Float::inf
    } else {
      0.0;
    }
  }

  /**
   * A Size with the width and height swapped.
   */
  fun flipped(): Size {
    Size(this.height, this.width);
  }

  /**
   * Whether this size encloses a non-zero area.
   * Negative areas are considered empty.
   */
  fun isEmpty(): Bool {
    this.width <= 0.0 || this.height <= 0.0
  }

  fun diagonal(): Float {
    Math.sqrt((this.width * this.width) + (this.height * this.height));
  }

  /**
   * The greater of the magnitudes of the width and the height.
   */
  fun longestSide(): Float {
    Math.max(Math.abs(this.width), Math.abs(this.height));
  }

  /**
   * The lesser of the magnitudes of the width and the height.
   */
  fun shortestSide(): Float {
    Math.min(Math.abs(this.width), Math.abs(this.height));
  }

  /**
   * The offset to the center of the bottom edge of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun bottomCenter(origin: Offset): Offset {
    Offset(origin.dx + this.width / 2.0, origin.dy + this.height);
  }

  /**
   * The offset to the intersection of the bottom and left edges of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun bottomLeft(origin: Offset): Offset {
    Offset(origin.dx, origin.dy + this.height);
  }

  /**
   * The offset to the intersection of the bottom and right edges of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun bottomRight(origin: Offset): Offset {
    Offset(origin.dx + this.width, origin.dy + this.height);
  }

  /**
   * The offset to the intersection of the bottom and right edges of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun center(origin: Offset): Offset {
    Offset(origin.dx + this.width / 2.0, origin.dy + this.height / 2.0);
  }

  /**
   * The offset to the center of the left edge of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun centerLeft(origin: Offset): Offset {
    Offset(origin.dx, origin.dy + this.height / 2.0);
  }

  /**
   * The offset to the center of the right edge of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun centerRight(origin: Offset): Offset {
    Offset(origin.dx + this.width, origin.dy + this.height / 2.0);
  }

  /**
   * The offset to the center of the top edge of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun topCenter(origin: Offset): Offset {
    Offset(origin.dx + this.width / 2.0, origin.dy);
  }

  /**
   * The offset to the intersection of the top and left edges of the rectangle described by the given Offset (which is interpreted as the top-left corner) and this Size.
   */
  fun topLeft(origin: Offset): Offset {
    origin;
  }

  /**
   * The offset to the intersection of the top and right edges of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun topRight(origin: Offset): Offset {
    Offset(origin.dx + this.width, origin.dy);
  }

  /**
   * The offset to the intersection of the top and right edges of the rectangle described by the given offset (which is interpreted as the top-left corner) and this size.
   */
  fun contains(offset: Offset): Bool {
    offset.dx >= 0.0 &&
      offset.dx < this.width &&
      offset.dy >= 0.0 &&
      offset.dy < this.height;
  }

  fun +(other: Size): Size {
    Size(this.width + other.width, this.height + other.height);
  }

  fun -(other: Size): Size {
    Size(this.width - other.width, this.height - other.height);
  }

  /**
   * Returns a Size whose dimensions are the dimensions of the left-hand-side operand (a Size) multiplied by the scalar right-hand-side operand (a double).
   */
  fun *(operand: Float): Size {
    Size(this.width * operand, this.height * operand);
  }

  /**
   * Returns a Size whose dimensions are the dimensions of the left-hand-side operand (a Size) divided by the scalar right-hand-side operand (a double).
   */
  fun /(operand: Float): Size {
    Size(this.width / operand, this.height / operand);
  }

  fun toDimension2D(): Geometry.Dimension2D {
    Geometry.Dimension2D(this.width, this.height)
  }

  fun toOffset(): Geometry.Offset {
    Geometry.Offset(this.width, this.height)
  }

  fun max(size: Geometry.Size): Size {
    Size(Math.max(this.width, size.width), Math.max(this.height, size.height));
  }

  fun min(size: Geometry.Size): Size {
    Size(Math.min(this.width, size.width), Math.min(this.height, size.height));
  }

  fun vertical(size: Geometry.Size): Size {
    Size(Math.max(this.width, size.width), this.height + size.height);
  }

  fun horizontal(size: Geometry.Size): Size {
    Size(this.width + size.width, Math.max(this.height, size.height));
  }

  fun floor(): Size {
    Size(Math.floor(this.width), Math.floor(this.height))
  }

  fun ceil(): Size {
    Size(Math.ceil(this.width), Math.ceil(this.height));
  }

  fun area(): Float {
    this.width * this.height
  }

  fun mult(sw: Float, sh: Float): Size {
    Size(this.width * sw, this.height * sh);
  }

  fun div(sw: Float, sh: Float): Size {
    Size(this.width / sw, this.height / sh);
  }
}

/**
 * A radius for either circular or elliptical shapes.
 */
value class Radius(
  /**
   * The radius value on the horizontal axis.
   */
  x: Float,
  /**
   * The radius value on the vertical  axis.
   */
  y: Float,
) uses Hashable, Equality {
  static fun circular(radius: Float): Radius {
    Radius(radius, radius);
  }

  static fun elliptical(x: Float, y: Float): Radius {
    Radius(x, y);
  }

  static fun zero(): Radius {
    static::circular(0.0);
  }

  fun isCircular(): Bool {
    this.x == this.y
  }

  /**
   * Binary addition operator.
   * Returns a radius whose x value is the sum of the x values of the two operands, and whose y value is the sum of the y values of the two operands.
   */
  fun +(other: Radius): Radius {
    Radius(this.x + other.x, this.y + other.y);
  }

  /**
   * Binary subtraction operator
   * Returns a radius whose x value is the left-hand-side operand's x minus the right-hand-side operand's x and whose y value is the left-hand-side operand's y minus the right-hand-side operand's y.
   */
  fun -(other: Radius): Radius {
    Radius(this.x - other.x, this.y - other.y);
  }

  /**
   * Returns a Radius whose dimensions are the dimensions of the left-hand-side operand (a Size) multiplied by the scalar right-hand-side operand (a Float).
   */
  fun *(operand: Float): Radius {
    Radius(this.x * operand, this.y * operand);
  }

  /**
   * Returns a radius whose coordinates are the coordinates of the left-hand-side operand (a radius) divided by the scalar right-hand-side operand (a Float).
   */
  fun /(operand: Float): Radius {
    Radius(this.x / operand, this.y / operand);
  }

  /**
   * Returns a radius whose coordinates are the coordinates of the left-hand-side operand (a radius) divided by the scalar right-hand-side operand (a Int).
   */
  fun iDiv(operand: Int): Radius {
    Radius(
      (this.x.toInt() / operand).toFloat(),
      (this.y.toInt() / operand).toFloat(),
    );
  }

  fun %(operand: Int): Radius {
    Radius(Math.modulo(this.x, operand), Math.modulo(this.y, operand));
  }

  fun inflate(delta: Float): Radius {
    Radius(this.x + delta, this.y + delta);
  }
}

/**
 * An set of radii for each corner of a rectangle.
 *
 *
 * The [RectRadius] class specifies offsets in terms of visual corners, e.g. [topLeft].
 */
base class RectRadius private () {
  /**
   * The top-left [Radius].
   */
  fun getTopLeft(): Radius;

  /**
   * The top-right [Radius].
   */
  fun getTopRight(): Radius;

  /**
   * The bottom-left [Radius].
   */
  fun getBottomLeft(): Radius;

  /**
   * The bottom-right [Radius].
   */
  fun getBottomRight(): Radius;
}
/**
 * A transform consisting of a translation, a rotation, and a uniform scale.
 */
value class RSTransform(
  /**
   * The cosine of the rotation multiplied by the scale factor.
   */
  scos: Float,
  /**
   * The sine of the rotation multiplied by that same scale factor.
   */
  ssin: Float,
  /**
   * The x coordinate of the translation, minus [scos] multiplied by the
   * x-coordinate of the rotation point, plus [ssin] multiplied by the
   * y-coordinate of the rotation point.
   */
  tx: Float,
  /**
   * The y coordinate of the translation, minus [ssin] multiplied by the
   * x-coordinate of the rotation point, minus [scos] multiplied by the
   * y-coordinate of the rotation point.
   */
  ty: Float,
) uses Hashable, Equality {}

/**
 * Position a child box within a container box, either above or below a target
 * point.
 *
 * The container's size is described by `size`.
 *
 * The target point is specified by `target`, as an offset from the top left of
 * the container.
 *
 * The child box's size is given by `childSize`.
 *
 * The return value is the suggested distance from the top left of the
 * container box to the top left of the child box.
 *
 * The suggested position will be above the target point if `preferBelow` is
 * false, and below the target point if it is true, unless it wouldn't fit on
 * the preferred side but would fit on the other side.
 *
 * The suggested position will place the nearest side of the child to the
 * target point `verticalOffset` from the target point (even if it cannot fit
 * given that constraint).
 *
 * The suggested position will be at least `margin` away from the edge of the
 * container. If possible, the child will be positioned so that its center is
 * aligned with the target point. If the child cannot fit horizontally within
 * the container given the margin, then the child will be centered in the
 * container.
 *
 * Used by [Tooltip] to position a tooltip relative to its parent.
 *
 */
fun positionDependentBox{
  size: Size,
  childSize: Size,
  target: Offset,
  preferBelow: Bool,
  verticalOffset: Float = 0.0,
  margin: Float = 10.0,
}: Offset {
  // VERTICAL DIRECTION
  fitsBelow =
    target.dy + verticalOffset + childSize.height <=
    size.height - margin;
  fitsAbove = target.dy - verticalOffset - childSize.height >= margin;
  tooltipBelow = if (preferBelow) {
    fitsBelow || !fitsAbove
  } else {
    !(fitsAbove || !fitsBelow)
  };
  y = if (tooltipBelow) {
    Math.min(target.dy + verticalOffset, size.height - margin);
  } else {
    Math.max(target.dy - verticalOffset - childSize.height, margin);
  };
  // HORIZONTAL DIRECTION
  x = if (size.width - margin * 2.0 < childSize.width) {
    (size.width - childSize.width) / 2.0;
  } else {
    normalizedTargetX = Math.clamp(target.dx, margin, size.width - margin);
    edge = margin + childSize.width / 2.0;
    if (normalizedTargetX < edge) {
      margin;
    } else if (Math.greater(normalizedTargetX, size.width - edge)) {
      size.width - margin - childSize.width;
    } else {
      normalizedTargetX - childSize.width / 2.0;
    }
  };
  Offset(x, y);
}
module end;
