module Ui;

type IUGetter<T> = (mutable SKFS.Context, Bool) ~> T;

fun iUDefault<T: frozen>(t: T): IUGetter<T> {
  (_ctx, _iu) ~> t
}

type Getter<T> = mutable SKFS.Context ~> T;

fun default<T: frozen>(t: T): Getter<T> {
  _ctx ~> t
}

type GetterOne<T, P> = (mutable SKFS.Context, P) ~> T;

fun defaultOne<T: frozen, P>(t: T): GetterOne<T, P> {
  (_ctx, _p) ~> t
}

type GetterTwo<T, P1, P2> = (mutable SKFS.Context, P1, P2) ~> T;

fun defaultTwo<T: frozen, P1, P2>(t: T): GetterTwo<T, P1, P2> {
  (_, _, _) ~> t
}

type GetterThree<T, P1, P2, P3> = (mutable SKFS.Context, P1, P2, P3) ~> T;

fun defaultThree<T: frozen, P1, P2, P3>(t: T): GetterThree<T, P1, P2, P3> {
  (_, _, _, _) ~> t
}

const full: UInt8 = UInt8::truncate(255);

class Shift(x: Int, y: Int) uses Hashable, Equality, Show {
  fun toOffset(): Geometry.Offset {
    Geometry.Offset(this.x.toFloat(), this.y.toFloat())
  }

  fun toPoint(): Geometry.Point {
    Geometry.Point(this.x, this.y)
  }

  fun toString(): String {
    `(${this.x},${this.y})`
  }
}

base class Paint private (alpha: Float = 1.0) uses Hashable, Orderable {
  fun withAlpha(alpha: Float): this;
  fun scaleAlpha(factor: Float): this;

  fun toPainter(priority: Priority = High()): Ui.Painter;
  fun translate(offset: Geometry.Offset): this;

  overridable protected fun lerpTo(b: Paint, t: Float): Paint {
    if (t > 0.5) {
      b.scaleAlpha((t - 0.5) * 2.0)
    } else {
      this.scaleAlpha(1.0 - (2.0 * t))
    }
  }

  static fun lerp(optA: ?Paint, optB: ?Paint, t: Float): ?Paint {
    optA match {
    | Some(a) ->
      optB match {
      | Some(b) -> Some(a.lerpTo(b, t))
      | _ -> Some(a.scaleAlpha(1.0 - t))
      }
    | _ ->
      optB match {
      | Some(b) -> Some(b.scaleAlpha(t))
      | _ -> None()
      }
    }
  }

  overridable fun compare(y: Paint): Order {
    (this, y) match {
    | (.Color(_, _, _, _), .Color(_, _, _, _)) -> this.sameCompare(y)
    | (.Color(_, _, _, _), _) -> LT()
    | (_, .Color(_, _, _, _)) -> GT()
    | _ ->
      order = this.getClassName().compare(y.getClassName());
      order match {
      | EQ() -> this.sameCompare(y)
      | _ -> order
      }
    }
  }

  overridable fun sameCompare(y: Paint): Order {
    this.hash().compare(y.hash())
  }
}

value class Pix(
  red: UInt8,
  green: UInt8,
  blue: UInt8,
  alpha: UInt8,
) uses Equality {
  //
  const transparent: Pix = Pix(
    UInt8::truncate(0),
    UInt8::truncate(0),
    UInt8::truncate(0),
    UInt8::truncate(0),
  );

  static fun fromArray(elems: Array<UInt8>): Pix {
    zero = UInt8::zero;
    max = UInt8::truncate(255);
    Pix(
      elems.maybeGet(0).default(zero),
      elems.maybeGet(1).default(zero),
      elems.maybeGet(2).default(zero),
      elems.maybeGet(3).default(max),
    )
  }

  fun +(other: Pix): Pix {
    this.add(other)
  }

  fun under(foreground: Pix): Pix {
    this.modify(
      foreground,
      (bA, fA) ~> (fA + (bA * (1.0 - fA))),
      (back, bA, fore, fA, alpha) ~> {
        UInt8::truncate(
          (((fore.toFloat() * fA) + back.toFloat() * bA * (1.0 - fA)) /
            alpha).toInt(),
        )
      },
    );
  }

  fun add(other: Pix): Pix {
    this.modify(
      other,
      (bA, fA) ~> bA + fA,
      (back, bA, fore, fA, alpha) ~> {
        UInt8::truncate(
          (((fore.toFloat() * fA) + (back.toFloat() * bA)) / alpha).toInt(),
        )
      },
    );
  }

  private fun modify(
    foreground: Pix,
    compAlpha: (Float, Float) ~> Float,
    compEntity: (UInt8, Float, UInt8, Float, Float) ~> UInt8,
  ): Pix {
    if (foreground.alpha == full || this.alpha == UInt8::zero) {
      foreground
    } else if (foreground.alpha == UInt8::zero) {
      this
    } else {
      alpha1 = this.alpha.toFloat() / 255.0;
      alpha2 = foreground.alpha.toFloat() / 255.0;
      alpha = compAlpha(alpha1, alpha2);
      if (Math.like(alpha, 0.0)) {
        Pix::transparent
      } else {
        Pix(
          compEntity(this.red, alpha1, foreground.red, alpha2, alpha),
          compEntity(this.green, alpha1, foreground.green, alpha2, alpha),
          compEntity(this.blue, alpha1, foreground.blue, alpha2, alpha),
          UInt8::truncate(
            Math.clamp(Math.round(alpha * 255.0).toInt(), 0, 255),
          ),
        );
      }
    }
  }

  fun like(other: Pix, tolerance: Int = 1): Bool {
    Math.abs(this.red - other.red) <= tolerance &&
      Math.abs(this.green - other.green) <= tolerance &&
      Math.abs(this.blue - other.blue) <= tolerance &&
      Math.abs(this.alpha - other.alpha) <= tolerance
  }
}

base class Picture {
  //
  fun getSize(): Geometry.ISize;

  fun resized(width: Int, height: Int): ?Picture;
}

class Image(
  data: Array<Pix>,
  width: Int,
  height: Int,
  optShift: ?Shift = None(),
) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Image _ -> x
    | _ -> SKFS.cast_violation("Ui.Image", obj)
    }
  }

  static fun empty(width: Int, height: Int, optShift: ?Shift = None()): Image {
    Image(
      Array::fill(width * height, Pix::transparent),
      width,
      height,
      optShift,
    )
  }

  static fun build(painter: Ui.Painter, width: Int, height: Int): Image {
    Image(
      Array::fillBy(width * height, index ~> {
        x = index % width;
        y = index / width;
        px = painter.getColorAt(x, y);
        Pix(px.getRed(), px.getGreen(), px.getBlue(), px.getAlpha())
      }),
      width,
      height,
    )
  }

  static fun make(width: Int, height: Int, supplier: (Int, Int) -> Pix): Image {
    Image(
      Array::fillBy(width * height, index -> {
        supplier(index % width, index / width)
      }),
      width,
      height,
    )
  }

  fun size(): Geometry.Size {
    Geometry.Size(this.width.toFloat(), this.height.toFloat())
  }

  fun get(x: Int, y: Int): Pix {
    this.data.unsafeGet(index(x, y, this.width));
  }

  @always_inline
  private fun index(x: Int, y: Int): Int {
    index(x, y, this.width)
  }

  private fun getPixX(x: Int, y: Int, fy: Float, xScale: Float): Pix {
    pix = if (y > 0) {
      cur = this.data.unsafeGet(this.index(x, y - 1));
      !cur.alpha = UInt8::truncate(
        Math.round(cur.alpha.toFloat() * fy * xScale).toInt(),
      );
      cur;
    } else {
      Pix(UInt8::zero, UInt8::zero, UInt8::zero, UInt8::zero);
    };
    pix +
      if (y < this.height) {
        cur = this.data.unsafeGet(this.index(x, y));
        !cur.alpha = UInt8::truncate(
          Math.round(cur.alpha.toFloat() * (1.0 - fy) * xScale).toInt(),
        );
        cur
      } else {
        Pix(UInt8::zero, UInt8::zero, UInt8::zero, UInt8::zero);
      };
  }

  fun shiftImage(relative: Geometry.Offset): Image {
    if (relative.like(Geometry.Offset::zero)) {
      this;
    } else {
      bounds = Geometry.Rect::fromOffsetSize(
        relative,
        Geometry.Size(this.width.toFloat(), this.height.toFloat()),
      ).toRectangle();
      nWidth = bounds.width();
      nHeight = bounds.height();
      fx = relative.dx;
      fy = relative.dy;
      Image(
        Array::fillBy(nWidth * nHeight, index ~> {
          x = index % nWidth;
          y = index / nWidth;
          pix = if (x > 0) {
            this.getPixX(x - 1, y, fy, fx);
          } else {
            Pix(UInt8::zero, UInt8::zero, UInt8::zero, UInt8::zero);
          };
          pix +
            if (x < this.width) {
              this.getPixX(x, y, fy, 1.0 - fx);
            } else {
              Pix(UInt8::zero, UInt8::zero, UInt8::zero, UInt8::zero);
            };
        }),
        nWidth,
        nHeight,
        this.optShift,
      );
    }
  }

  fun save(path: String): Bool {
    Ui.saveImage(
      path,
      this.data,
      UInt32::truncate(this.width),
      UInt32::truncate(this.height),
    )
  }
}

base class DrawableSupport {
  //
  fun init(
    context: mutable SKFS.Context,
    drawables: SKFS.EHandle<Ui.Drawables>,
    dirName: SKFS.DirName,
  ): SKFS.EHandle<Ui.Handles>;

  fun msdf(
    offset: Geometry.Offset,
    size: Geometry.Size,
    image: Image,
    conv: (Geometry.Rect, Float) ~> Geometry.Rect,
    pxRange: Int,
    thickness: Float,
    paint: Ui.Paint,
  ): Ui.Drawable;

  fun ellipse(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
  ): Ui.Drawable;

  fun disk(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    thickness: Float,
  ): Ui.Drawable;

  fun roundedRectangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    color: .Color,
    radius: Float,
    smooth: Int = 2,
    optBorder: ?(.Color, Int) = None(),
  ): Ui.Drawable;

  fun rectangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
  ): Ui.Drawable;

  fun diagonal(
    offset: Geometry.Offset,
    size: Geometry.Size,
    fromTopLeft: Bool,
    thickness: Float,
    color: .Color,
  ): Ui.Drawable;

  fun triangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    side: .UiSide,
  ): Ui.Drawable;

  fun progress(
    offset: Geometry.Offset,
    size: Geometry.Size,
    progress: Float,
    color1: .Color,
    color2: .Color,
    thickness: Float,
  ): Ui.Drawable;

  fun loading(
    offset: Geometry.Offset,
    size: Geometry.Size,
    color1: .Color,
    color2: .Color,
    step: Int,
  ): Ui.Drawable;

  fun image(
    offset: Geometry.Offset,
    size: Geometry.Size,
    picture: Picture,
  ): Ui.Drawable;

  fun boxShadow(
    offset: Geometry.Offset,
    size: Geometry.Size,
    sigma: Float,
    paint: Ui.Paint,
  ): Ui.Drawable;

  fun drawAminationFrame(
    context: mutable SKFS.Context,
    width: Int,
    height: Int,
  ): void;
}


class Path(id: String, optParent: ?Path = None()) extends SKFS.BaseName {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Path _ -> x
    | _ -> SKFS.cast_violation("Ui.Path", obj)
    }
  }

  static fun create(name: String): this {
    static(name)
  }

  fun sameCompare(other: SKFS.FileName): Order {
    other match {
    | ok @ Path _ ->
      iComp = this.id.compare(ok.id);
      if (iComp == EQ()) {
        this.optParent.compare(ok.optParent)
      } else {
        iComp
      }
    | _ -> invariant_violation("Must be compared with a UI.Path")
    }
  }

  fun toString(): String {
    this.optParent match {
    | Some(parent) -> parent.toString() + "/" + this.id
    | _ -> this.id
    }
  }

  fun toPath(): String {
    this.optParent match {
    | Some(parent) -> parent.toPath() + "/" + SKFS.normalize(this.id, true)
    | _ -> SKFS.normalize(this.id, true)
    }
  }

  fun toDirName(root: String = "/"): SKFS.DirName {
    path = this.toPath();
    SKFS.DirName::create(root + path + "/");
  }

  fun makeChild(id: String): this {
    Path(id, Some(this))
  }

  fun add(toAdd: Path): this {
    toAdd.optParent match {
    | Some(parent) -> toAdd with {optParent => Some(this.add(parent))}
    | _ -> toAdd with {optParent => Some(this)}
    }
  }

  fun isParentOf(path: Path): Bool {
    tPath = this.toString();
    pPath = path.toString();
    tPath == pPath || pPath.startsWith(tPath + "/")
  }

  fun isChildOf(path: Path): Bool {
    path.optParent.map(p -> p == this || this.isChildOf(p)).default(false)
  }

  fun statePath(): this {
    this.makeChild("__states")
  }
}


@cpp_extern
private native fun saveImage(
  path: String,
  data: Array<Ui.Pix>,
  width: UInt32,
  height: UInt32,
): Bool;

