module Bmp;

const undef: Int = 0;
/**
 *  24-bit bitmap header
 *  @see http://www.fastgraph.com/help/bmp_header_format.html
 */
const bmpHeader: Array<Int> = Array[
  //////////////////////////////////
  /* 00 */ 0x42,
  0x4d, // signature, "BM"
  //////////////////////////////////
  /* 02 */ undef,
  undef,
  undef,
  undef, // size in bytes, filled dynamically
  //////////////////////////////////
  /* 06 */ 0x00,
  0x00, // reserved, must be zero
  //////////////////////////////////
  /* 08 */ 0x00,
  0x00, // reserved, must be zero
  //////////////////////////////////
  /* 10 */ 0x36,
  0x00,
  0x00,
  0x00, // offset to start of image data in bytes
  //////////////////////////////////
  /* 14 */ 0x28,
  0x00,
  0x00,
  0x00, // size of BITMAPINFOHEADER structure, must be 40 (0x28)
  //////////////////////////////////
  /* 18 */ undef,
  undef,
  undef,
  undef, // image width in pixels, filled dynamically
  //////////////////////////////////
  /* 22 */ undef,
  undef,
  undef,
  undef, // image height in pixels, filled dynamically
  //////////////////////////////////
  /* 26 */ 0x01,
  0x00, // number of planes, must be 1
  //////////////////////////////////
  /* 28 */ 0x18,
  0x00, // number of bits per pixel (1, 4, 8, or 24) -> 24 = 0x18
  //////////////////////////////////
  /* 30 */ 0x00,
  0x00,
  0x00,
  0x00, // compression type (0=none, 1=RLE-8, 2=RLE-4)
  //////////////////////////////////
  /* 34 */ undef,
  undef,
  undef,
  undef, // size of image data in bytes (including padding)
  //////////////////////////////////
  /* 38 */ undef,
  undef,
  undef,
  undef, // normally: horizontal resolution in pixels per meter (unreliable)
  //////////////////////////////////
  /* 42 */ undef,
  undef,
  undef,
  undef, // vertical resolution in pixels per meter (unreliable)
  //////////////////////////////////
  /* 46 */ 0x00,
  0x00,
  0x00,
  0x00, // number of colors in image, or zero
  //////////////////////////////////
  /* 50 */ 0x00,
  0x00,
  0x00,
  0x00, // number of important colors, or zero
];

private const BMP_SIZE_HEADER: Int = 54; // total header length, 54 bytes
private const BMP_SIZE_IMAGE_WIDTH: Int = 4; // size of image width field, 4 bytes
private const BMP_SIZE_PAYLOAD_LENGTH: Int = 4; // size of 'horizontal resolution' field, here: payload length, 4 bytes
private const BMP_SIZE_BMPUTIL_MAGIC: Int = 4; // size of 'vertical resolution' field, here: payload length, 4 bytes

private const BMP_OFFSET_FILESIZE_BYTES: Int = 2; // offset of filesize field, 4 bytes
private const BMP_OFFSET_IMAGE_WIDTH: Int = 18; // offset of image width field, 4 bytes
private const BMP_OFFSET_IMAGE_HEIGHT: Int = 22; // offset of image height field, 4 bytes
private const BMP_OFFSET_IMAGE_DATA_BYTES: Int = 34; // 4 bytes
private const BMP_OFFSET_HORIZONTAL_RESOLUTION: Int = 38; // 4 bytes
private const BMP_OFFSET_VERTICAL_RESOLUTION: Int = 42; // 4 bytes

class Pixel(r: UInt8, g: UInt8, b: UInt8) {
  static fun fromColor(
    color: .Color,
    background: .Color = Colors.white(),
  ): Pixel {
    fcolor = if (color.alpha == 1.0) {
      color;
    } else if (color.alpha == 0.0) {
      background;
    } else {
      background + (color - background).mult(color.alpha)
    };
    Pixel(fcolor.getRed(), fcolor.getGreen(), fcolor.getBlue())
  }
}

module end;
