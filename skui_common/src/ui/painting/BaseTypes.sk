module Ui;

base class Handle extends SKFS.File {
  fun draw(
    shift: Ui.Shift,
    window: Geometry.Rectangle,
    height: Int,
    ratio: Float,
  ): void;
}

class LambdaHandle(
  fn: (Ui.Shift, Geometry.Rectangle, Int, Float) ~> void,
) extends Ui.Handle {
  fun draw(
    shift: Ui.Shift,
    window: Geometry.Rectangle,
    height: Int,
    ratio: Float,
  ): void {
    this.fn(shift, window, height, ratio);
  }
}

class Handles(
  value: Array<Ui.Handle>,
  optViewport: ?Ui.Path = None(),
) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Handles _ -> x
    | _ -> SKFS.cast_violation("Ui.Handles", obj)
    }
  }
}

base class Drawable extends SKFS.File uses HasClassName {
  fun translate(offset: Geometry.Offset): this;
  fun size(): Geometry.Size;
}

class Drawables(
  value: Array<Drawable>,
  optViewport: ?Ui.Path = None(),
) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Drawables _ -> x
    | _ -> SKFS.cast_violation("Ui.Drawables", obj)
    }
  }
}

base class Supplier

base class RectangleDrawable(bounds: Geometry.Rect) extends Drawable {
  fun translate(offset: Geometry.Offset): this {
    !this.bounds = this.bounds.translate(offset.dx, offset.dy);
    this
  }

  fun size(): Geometry.Size {
    this.bounds.size()
  }
}

class DummyDrawable() extends Drawable {
  fun translate(_offset: Geometry.Offset): this {
    dummy()
  }

  fun size(): Geometry.Size {
    dummy()
  }
}

module end;
