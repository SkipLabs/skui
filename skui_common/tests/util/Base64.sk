module SKUICommonTest;

@test
fun base64Encode(): void {
  Base64Encode().run();
}

@test
fun base64Decode(): void {
  Base64Decode().run();
}

class Base64Encode() {
  const cases: Array<(String, String)> = Array[
    ("aaaaaaaaaaaaaaaaa", "YWFhYWFhYWFhYWFhYWFhYWE="),
    ("Hello World", "SGVsbG8gV29ybGQ="),
    ("foobar", "Zm9vYmFy"),
    ("fooba", "Zm9vYmE="),
    ("foob", "Zm9vYg=="),
    ("foo", "Zm9v"),
    ("fo", "Zm8="),
    ("f", "Zg=="),
    ("", ""),
  ];

  fun run(): void {
    static::cases.each(case -> {
      (decoded, encoded) = case;
      expectEq(Base64.encodeString(decoded), encoded, v ~> v)
    });
  }
}

class Base64Decode() {
  const cases: Array<(String, String)> = Array[
    ("aaaaaaaaaaaaaaaaa", "YWFhYWFhYWFhYWFhYWFhYWE="),
    ("Hello World", "SGVsbG8gV29ybGQ="),
    ("foobar", "Zm9vYmFy"),
    ("fooba", "Zm9vYmE="),
    ("foob", "Zm9vYg=="),
    ("foo", "Zm9v"),
    ("fo", "Zm8="),
    ("f", "Zg=="),
    ("", ""),
  ];

  fun run(): void {
    static::cases.each(case -> {
      (decoded, encoded) = case;
      res = decoded.chars().map(c -> UInt8::truncate(c.code()));
      expectEq(Base64.decodeString(encoded), res.toArray(), v ~> `${v}`)
    });
  }
}

module end;
