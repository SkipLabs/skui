module SkuiEndBuild;

@skui_build__extra_sources
fun extra_sources(env: SkuiBuild.Env): Array<String> {
  if (env.isWasm32()) {
    Array["extra/src/Handle.sk", "extra/src/Picture.sk", "extra/src/Main.sk"]
  } else {
    Array[]
  }
}

module end;

@debug
fun main(): void {
  SkuiBuild.build("skuieng") match {
  | Failure(err) -> skipExit(err.code)
  | _ -> void
  }
}
