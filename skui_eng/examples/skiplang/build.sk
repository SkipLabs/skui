module SkuiEngExamplesBuild;

@skui_build__source_dirs
fun source_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) Array["../../../skui_views/native/src"] else Array[]
}

@skui_build__include_dirs
fun include_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) {
    Array[
      "../../../skui_opengl/native/src/includes",
      "../../../skui_base/native/src/includes",
      "../../../skui_x11gl/native/src/includes",
    ]
  } else {
    Array[]
  }
}

@skui_build__extra_sources
fun extra_sources(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) {
    Array[
      "../../../skui_x11gl/extra/Host.sk",
      "../../../skui_x11gl/extra/X11Events.sk",
      "../../../skui_x11gl/extra/X11Key.sk",
    ]
  } else {
    Array[]
  }
}

module end;

fun main(): void {
  SkuiBuild.build("skuieng_examples") match {
  | Failure(err) -> skipExit(err.code)
  | _ -> void
  }
}
