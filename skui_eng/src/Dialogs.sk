module alias H = UiEngineHandle;

module UiEngine;

base class Confirmation {
  fun confirm(context: mutable SKFS.Context, confirm: Bool, dId: Int): void;
}

base class OnInput {
  fun perform(context: mutable SKFS.Context, value: String, dId: Int): void;
}

base class Dialog extends SObject {
  fun open(context: mutable SKFS.Context): void;
}

class Settings{
  // settings
  kind: UiInput.Kind = UiInput.Text(),
  maxChars: Int = 64,
  visibleChars: Int = 10,
  //
  optText: ?Serializable = None(),
  optPosition: ?Serializable = None(),
  optSelection: ?Serializable = None(),
  optStatus: ?Serializable = None(),
  //
  optPrefix: ?Serializable = None(),
  optSuffix: ?Serializable = None(),
  optPlaceHolder: ?Serializable = None(),
  optTooltip: ?Serializable = None(),
  optIcon: ?Serializable = None(),
  optDisabled: ?Serializable = None(),
  optWithCounter: ?Serializable = None(),
  optWithStatus: ?Serializable = None(),
  optWithClear: ?Serializable = None(),
  optAlignRight: ?Serializable = None(),
} {
  fun toSettings(_context: mutable SKFS.Context): UiDialogs.Settings {
    todo("UiEngine.Settings.toSettings");
  }
}

class Confirm{
  text: Text,
  optAction: ?Function,
  type: UiDialogs.QType = UiDialogs.YesNo(),
  optTitle: ?Text = None(),
} extends Dialog {
  fun open(context: mutable SKFS.Context): void {
    optConfirmation = this.optAction.map(action -> H.Confirmation(action));
    context.openConfirmDialog(
      this.text,
      (ctx, confirm, dId) ~>
        optConfirmation.each(c -> c.confirm(ctx, confirm, dId)),
      true,
      this.type,
      this.optTitle,
    );
  }
}

class InputDialog{
  label: Text,
  optAction: ?Function,
  optTitle: ?Text = None(),
  autoClose: Bool = true,
  settings: Settings = Settings{},
} extends Dialog {
  fun open(context: mutable SKFS.Context): void {
    optOnInput = this.optAction.map(action -> H.OnInput(action));
    context.openInputDialog(
      this.label,
      (ctx, v, dId) ~> optOnInput.each(o -> o.perform(ctx, v, dId)),
      this.autoClose,
      this.optTitle,
      this.settings.toSettings(context),
    );
  }
}

module end;
