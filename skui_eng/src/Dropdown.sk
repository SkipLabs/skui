module alias H = UiEngineHandle;

module UiEngine;

base class DropdownSupplier {
  fun supply(context: mutable SKFS.Context): ?Array<DItemBase>;
}

base class DItemBase{
  id: String,
  text: String,
  optIcon: ?UiIcon.Description,
  optTooltip: ?String,
  disabled: Bool,
  separator: Ui.Separator,
} {
  fun toMenuItem(): UiDropdown.ItemBase;
}

class DItem{optShortcut: ?Ui.Shortcut, performer: Int} extends DItemBase {
  fun toMenuItem(): UiDropdown.ItemBase {
    text = Text::fromString(this.text);
    performer = H.Performer(this.performer);
    UiDropdown.Item{
      id => this.id,
      text => Ui.default(text),
      icon => Ui.default(this.optIcon),
      disabled => Ui.default(this.disabled),
      separator => Ui.default(this.separator),
      shortcut => Ui.default(this.optShortcut),
      perform => performer.perform,
    }
  }
}

base class Items {
  children =
  | ConstItems(value: Array<DItemBase>)
  | ComputedItems(supplier: Int)
}

class DMenu{items: Items} extends DItemBase {
  fun toMenuItem(): UiDropdown.ItemBase {
    text = Text::fromString(this.text);
    UiDropdown.Menu{
      id => this.id,
      text => Ui.default(text),
      icon => Ui.default(this.optIcon),
      disabled => Ui.default(this.disabled),
      separator => Ui.default(this.separator),
      items => this.items match {
      | ConstItems(value) ->
        itemsCollection = UiDropdown.ArrayCollection(
          value.map(v -> v.toMenuItem()),
        );
        Ui.defaultOne(itemsCollection)
      | ComputedItems(supplier) ->
        ddSupplier = H.DropdownSupplier(supplier);
        (ctx, _iu) ~>
          UiDropdown.ArrayCollection(
            ddSupplier.supply(ctx).default(Array[]).map(v -> v.toMenuItem()),
          )
      },
    }
  }
}

module end;
