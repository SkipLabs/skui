module alias H = UiEngineHandle;

module UiEngine;

base class DropdownSupplier {
  fun supply(context: mutable SKStore.Context): ?Array<DItemBase>;
}

base class DItemBase{
  id: String,
  text: String,
  optIcon: ?UiIcon.Description,
  optTooltip: ?String,
  disabled: Bool,
  separator: Ui.Separator,
} {
  fun toMenuItem(): UiDropdown.ItemBase;
}

class DItem{
  optShortcut: ?Ui.Shortcut,
  optPerformer: ?Function,
} extends DItemBase {
  fun toMenuItem(): UiDropdown.ItemBase {
    text = Text::fromString(this.text);
    optPerformer = this.optPerformer.map(p -> H.Performer(p));
    UiDropdown.Item{
      id => this.id,
      text => Ui.default(text),
      icon => Ui.default(this.optIcon),
      disabled => Ui.default(this.disabled),
      separator => Ui.default(this.separator),
      shortcut => Ui.default(this.optShortcut),
      perform => (ctx) ~> optPerformer.each(p -> p.perform(ctx)),
    }
  }
}

base class Items {
  children =
  | ConstItems(value: Array<DItemBase>)
  | ComputedItems(optSupplier: ?Function)
}

class DMenu{items: Items} extends DItemBase {
  fun toMenuItem(): UiDropdown.ItemBase {
    text = Text::fromString(this.text);
    UiDropdown.Menu{
      id => this.id,
      text => Ui.default(text),
      icon => Ui.default(this.optIcon),
      disabled => Ui.default(this.disabled),
      separator => Ui.default(this.separator),
      items => this.items match {
      | ConstItems(value) ->
        itemsCollection = UiDropdown.ArrayCollection(
          value.map(v -> v.toMenuItem()),
        );
        Ui.defaultOne(itemsCollection)
      | ComputedItems(optSupplier) ->
        optDdSupplier = optSupplier.map(s -> H.DropdownSupplier(s));
        (ctx, _iu) ~>
          UiDropdown.ArrayCollection(
            optDdSupplier
              .flatMap(s -> s.supply(ctx))
              .default(Array[])
              .map(v -> v.toMenuItem()),
          )
      },
    }
  }
}

module end;
