module UiEngine;

base class DropdownSupplier extends SKFS.BaseName {
  fun getId(): String;
  fun supply(context: mutable SKFS.Context): ?Array<DItemBase>;

  fun toString(): String {
    `${this.getClassName()}[${this.getId()}]`
  }

  fun hash(): Int {
    this.toString().hash()
  }

  fun sameCompare(other: SKFS.FileName): Order {
    this.toString().compare(other.toString())
  }
}

base class DropdownPerformer {
  fun perform(context: mutable SKFS.Context): void;
}

base class DItemBase{
  id: String,
  text: String,
  optIcon: ?UiIcon.Description,
  optTooltip: ?String,
  disabled: Bool,
  separator: Ui.Separator,
} {
  fun toMenuItem(
    cache: (mutable SKFS.Context, DropdownSupplier, Bool) ~> Array<
      UiDropdown.ItemBase,
    >,
  ): UiDropdown.ItemBase;
}

class DItem{
  optShortcut: ?Ui.Shortcut,
  performer: DropdownPerformer,
} extends DItemBase {
  fun toMenuItem(
    _cache: (mutable SKFS.Context, DropdownSupplier, Bool) ~> Array<
      UiDropdown.ItemBase,
    >,
  ): UiDropdown.ItemBase {
    text = Text::fromString(this.text);
    UiDropdown.Item{
      id => this.id,
      text => Ui.default(text),
      icon => Ui.default(this.optIcon),
      disabled => Ui.default(this.disabled),
      separator => Ui.default(this.separator),
      shortcut => Ui.default(this.optShortcut),
      message => (ctx, _ui) ~> {
        this.performer.perform(ctx);
        Array[]
      },
    }
  }
}

base class Items {
  children =
  | ConstItems(value: Array<DItemBase>)
  | ComputedItems(supplier: DropdownSupplier)
}

class DMenu{items: Items} extends DItemBase {
  fun toMenuItem(
    cache: (mutable SKFS.Context, DropdownSupplier, Bool) ~> Array<
      UiDropdown.ItemBase,
    >,
  ): UiDropdown.ItemBase {
    text = Text::fromString(this.text);
    UiDropdown.Menu{
      id => this.id,
      text => Ui.default(text),
      icon => Ui.default(this.optIcon),
      disabled => Ui.default(this.disabled),
      separator => Ui.default(this.separator),
      items => this.items match {
      | ConstItems(value) ->
        itemsCollection = UiDropdown.ArrayCollection(
          value.map(v -> v.toMenuItem(cache)),
        );
        Ui.defaultOne(itemsCollection)
      | ComputedItems(supplier) ->
        (ctx, iu) ~> UiDropdown.ArrayCollection(cache(ctx, supplier, iu))
      },
    }
  }
}

// DUMMY

class DummyDropdownSupplier() extends DropdownSupplier {
  fun getId(): String {
    dummy()
  }
  fun supply(_context: mutable SKFS.Context): ?Array<DItemBase> {
    dummy()
  }
}

class DummyDropdownPerformer() extends DropdownPerformer {
  fun perform(_context: mutable SKFS.Context): void {
    dummy()
  }
}

module end;
