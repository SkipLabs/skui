module UiEngine;

fun getJSON(
  context: mutable SKStore.Context,
  optPath: ?String,
  name: String,
): ?JSON.Value {
  prop = UiSerializableProp.Property::forName(context, optPath, name);
  prop.maybeGet(context).map(toJSON);
}

fun setJSON(
  context: mutable SKStore.Context,
  optPath: ?String,
  name: String,
  optValue: ?JSON.Value,
): void {
  prop = UiSerializableProp.Property::forName(context, optPath, name);
  prop.set(context, optValue.map(fromJSON), 0);
}

@wasm_export("SKIP_UiEngineJS_getValue")
fun getValue(optPath: ?String, name: String): ?JSON.Value {
  SKStore.Context::withoutGc(context ~> getJSON(context, optPath, name))
}

@wasm_export("SKIP_UiEngineJS_setValue")
fun setValue(optPath: ?String, name: String, optValue: ?JSON.Value): void {
  SKStore.Context::withoutGc(context ~> {
    setJSON(context, optPath, name, optValue);
    context.updateIfRoot();
  })
}
@wasm_export("SKIP_UiEngineJS_create")
fun create(optPath: ?String, optValue: ?JSON.Value): String {
  SKStore.Context::withoutGc(context ~> {
    prop = UiSerializableProp.Property::create(
      context,
      optPath,
      optValue.map(fromJSON),
    );
    prop.getName();
  })
}

@wasm_export("SKIP_UiEngineJS_combine")
fun combine(
  optPath: ?String,
  jsCombine: JSON.Value,
  optJsWrite: ?JSON.Value,
): String {
  SKStore.Context::withoutGc(context ~> {
    combineFn = fromJSON(jsCombine) as Function _;
    optWriteFn = optJsWrite.map(fromJSON).map(f ~> f as Function _);
    combine = UiEngineHandle.ECombine(combineFn, optWriteFn);
    UiSerializableProp.Property::combine(context, optPath, combine).value;
  })
}

/// Dialogs

@wasm_export("SKIP_UiEngineJS_alert")
fun alert(text: Text, optTitle: ?Text): void {
  SKStore.Context::withoutGc(context ~> {
    context.openAlert(text, optTitle);
  })
}

@wasm_export("SKIP_UiEngineJS_dialog")
fun dialog(dialog: JSON.Value): void {
  SKStore.Context::withoutGc(context ~> {
    ser = UiEngine.fromJSON(dialog);
    ser match {
    | d @ UiEngine.Dialog _ -> d.open(context)
    | _ -> SKStore.cast_violation("UiEngine.Dialog", ser)
    }
  })
}

fun fillVectorWithPath(path: Ui.Path, vec: mutable Vector<SString>): void {
  path.optParent.each(p -> fillVectorWithPath(p, vec));
  vec.push(SString(path.id))
}

fun pathToSArray(path: Ui.Path): SArray {
  vec = mutable Vector<SString>[];
  fillVectorWithPath(path, vec);
  SArray(vec.toArray());
}

module end;
