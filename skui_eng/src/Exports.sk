module UiEngine;

// Serializable property

fun getJSON(
  context: mutable SKFS.Context,
  optPath: ?String,
  name: String,
): ?JSON.Value {
  prop = UiJSONProp.Property::forName(context, optPath, name);
  prop.maybeGet(context);
}

fun setJSON(
  context: mutable SKFS.Context,
  optPath: ?String,
  name: String,
  optValue: ?JSON.Value,
): void {
  prop = UiJSONProp.Property::forName(context, optPath, name);
  prop.set(context, optValue, 0);
}

@wasm_export("SKIP_Eng_getValue")
fun getValue(optPath: ?String, name: String): ?JSON.Value {
  SKFS.Context::withoutGc(context ~> getJSON(context, optPath, name))
}

@wasm_export("SKIP_Eng_setValue")
fun setValue(optPath: ?String, name: String, optValue: ?JSON.Value): void {
  SKFS.Context::withoutGc(context ~> {
    setJSON(context, optPath, name, optValue);
    context.updateIfRoot();
  })
}
@wasm_export("SKIP_Eng_create")
fun create(optPath: ?String, optValue: ?JSON.Value): String {
  SKFS.Context::withoutGc(context ~> {
    prop = UiJSONProp.Property::create(context, optPath, optValue);
    prop.getName();
  })
}

@wasm_export("SKIP_Eng_combine")
fun combine(optPath: ?String, combineHdl: UInt32, writeHdl: UInt32): String {
  SKFS.Context::withoutGc(context ~> {
    combine = UiEngineHandle.Combine(combineHdl.toInt(), writeHdl.toInt());
    UiJSONProp.Property::combine(context, optPath, combine).value;
  })
}

/// Dialogs

@wasm_export("SKIP_Eng_alert")
fun alert(text: Text, optTitle: ?Text): void {
  SKFS.Context::withoutGc(context ~> {
    message = context.openAlertMessage(text, optTitle);
    SKUIMessage.emitMessage(context, message);
  })
}

@wasm_export("SKIP_Eng_dialog")
fun dialog(dialog: JSON.Value): void {
  SKFS.Context::withoutGc(context ~> {
    ser = UiEngine.fromJSON(dialog);
    ser match {
    | dialog @ UiEngine.Dialog _ -> dialog.open(context)
    | _ -> SKFS.cast_violation("UiEngine.Dialog", ser)
    }
  })
}

fun fillVectorWithPath(path: Ui.Path, vec: mutable Vector<SString>): void {
  path.optParent.each(p -> fillVectorWithPath(p, vec));
  vec.push(SString(path.id))
}

fun pathToSArray(path: Ui.Path): SArray {
  vec = mutable Vector<SString>[];
  fillVectorWithPath(path, vec);
  SArray(vec.toArray());
}

module end;
