module UiEngine;

fun onConfirmation(
  _context: mutable SKFS.Context,
  action: String,
  value: Bool,
): void {
  natOnConfirmation(action, value);
}

fun onInput(
  _context: mutable SKFS.Context,
  action: String,
  optValue: ?String,
  optCloseMessage: ?SKUIMessage.Message,
): void {
  optClose = optCloseMessage.map(msg -> msg.toJSON().toString());
  natOnInput(action, optValue, optClose)
}
@cpp_extern("SKIP_ENG_onConfirmation")
native fun natOnConfirmation(action: String, value: Bool): void;
@cpp_extern("SKIP_ENG_onInput")
native fun natOnInput(
  action: String,
  optValue: ?String,
  optClose: ?String,
): void;
@cpp_extern("SKIP_ENG_render")
native fun natRender(renderable: UInt32, optPath: ?String): ?String;
@cpp_extern("SKIP_ENG_perform")
native fun natPerform(action: UInt32, count: UInt32): void;
@cpp_extern("SKIP_ENG_deleteRenderable")
private native fun deleteRenderable(renderable: UInt32): void;
@cpp_extern("SKIP_ENG_deleteActionPerformer")
private native fun deleteActionPerformer(action: UInt32): void;
@cpp_extern("SKIP_ENG_inputPerform")
private native fun natInputPerform(action: UInt32, text: String): void;
@cpp_extern("SKIP_ENG_deleteInputPerformer")
private native fun deleteInputPerformer(action: UInt32): void;
