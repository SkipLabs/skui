module UiBoolProp;

class Serializable extends Ui.BoolProperty, UiEngine.PropertySerializable<Bool>{
  //
  fun get from UiEngine.PropertySerializable;
  fun getTimed from UiEngine.PropertySerializable;

  protected static fun valueFromSerializable(s: UiEngine.Serializable): Bool {
    UiEngine.optBool(s).default(false)
  }

  protected static fun valueToSerializable(v: Bool): UiEngine.Serializable {
    UiEngine.SBool(v)
  }

  protected static fun getDefaultValue(): Bool {
    false
  }

  fun toggle(context: mutable SKStore.Context, source: Int): void {
    this.set(context, Some(!this.get(context, true)), source)
  }
}
module end;

