module UiEngine;

class File(value: Serializable) extends SKStore.File

base class SerializableProperty extends Ui.Property<Serializable>

class Prop extends Ui.Prop {
  //
  fun toProperty(
    context: readonly SKStore.Context,
  ): UiSerializableProp.Property {
    this.kind match {
    | Ui.PProp() ->
      UiSerializableProp.Property::forName(context, this.optPath, this.name)
    | Ui.PCombined() ->
      UiSerializableProp.Property::forName(
        context,
        Ui.combinedPath(this.optPath),
        this.name,
      )
    | Ui.PLoadable()
    | Ui.PHandle() ->
      invariant_violation("Must be Ui.PProp or Ui.PCombined property")
    }
  }
}

base class PropertySerializable<T: frozen> final (
  property: SerializableProperty,
) extends Ui.Property<T> {
  protected static fun valueFromSerializable(s: Serializable): T;
  protected static fun valueToSerializable(v: T): Serializable;
  protected static fun getDefaultValue(): T;

  fun getName(): String {
    this.property.getName()
  }

  fun getPath(): ?String {
    this.property.getPath()
  }

  fun maybeGet(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?T {
    this.property.maybeGet(context, isUntracked).map(
      static::valueFromSerializable,
    )
  }

  fun get(context: mutable SKStore.Context, isUntracked: Bool = false): T {
    this.maybeGet(context, isUntracked) match {
    | Some(v) -> v
    | _ -> static::getDefaultValue()
    }
  }

  fun maybeGetTimed(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?(?T, SKStore.Tick, Int) {
    this.property.maybeGetTimed(context, isUntracked).map(t ->
      (t.i0.map(static::valueFromSerializable), t.i1, t.i2)
    )
  }

  fun getTimed(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): (T, SKStore.Tick, Int) {
    this.maybeGetTimed(context, isUntracked) match {
    | Some(v) -> (v.i0.default(static::getDefaultValue()), v.i1, v.i2)
    | _ -> (static::getDefaultValue(), SKStore.Tick(0), 0)
    }
  }

  fun set(context: mutable SKStore.Context, optValue: ?T, source: Int): void {
    this.property.set(
      context,
      optValue.map(static::valueToSerializable),
      source,
    )
  }
}

module end;

module UiSerializableProp;

class Timed extends Ui.TimedFile<UiEngine.Serializable> {
  static fun type(file: SKStore.File): Timed {
    file match {
    | x @ Timed _ -> x
    | _ -> SKStore.cast_violation("UiSerializableProp.Timed", file)
    }
  }
}

class Property extends
  UiEngine.SerializableProperty,
  Ui.PropertyFile<UiEngine.Serializable, Timed, UiEngine.File>,
{
  //
  fun get from Ui.PropertyFile;
  fun getTimed from Ui.PropertyFile;

  protected static fun timed(
    optV: ?UiEngine.Serializable,
    tick: SKStore.Tick,
    source: Int,
  ): Timed {
    Timed(optV, tick, source)
  }

  protected static fun timedFromFile(file: SKStore.File): Timed {
    file match {
    | x @ Timed _ -> x
    | _ -> SKStore.cast_violation("UiSerializableProp.Timed", file)
    }
  }

  protected static fun valueFromFile(
    file: SKStore.File,
  ): UiEngine.Serializable {
    UiEngine.File::type(file).value
  }

  protected static fun fileValueFromFile(file: SKStore.File): UiEngine.File {
    UiEngine.File::type(file)
  }

  protected static fun valueToFile(
    value: UiEngine.Serializable,
  ): UiEngine.File {
    UiEngine.File(value)
  }

  protected static fun getDefaultValue(): UiEngine.Serializable {
    UiEngine.SOption(None())
  }

  static fun toIHandle(
    hdl: SKStore.EHandle<SKStore.StrID, Timed>,
  ): SKStore.IHandle<SKStore.StrID, Timed> {
    SKStore.toIHandle(hdl)
  }

  fun toOptIntGetter(): Ui.GetterOne<?Int, Bool> {
    (ctx, iu) ~> this.maybeGet(ctx, iu).flatMap(UiEngine.optInt)
  }

  fun toOptFloatGetter(): Ui.GetterOne<?Float, Bool> {
    (ctx, iu) ~> this.maybeGet(ctx, iu).flatMap(UiEngine.optFloat)
  }

  fun toOptStringGetter(): Ui.GetterOne<?String, Bool> {
    (ctx, iu) ~> this.maybeGet(ctx, iu).flatMap(UiEngine.optString)
  }

  fun toOptBoolGetter(): Ui.GetterOne<?Bool, Bool> {
    (ctx, iu) ~> this.maybeGet(ctx, iu).flatMap(UiEngine.optBool)
  }

  fun toOptValueGetter<T>(
    conv: UiEngine.Serializable ~> ?T,
  ): Ui.GetterOne<?T, Bool> {
    (ctx, iu) ~> this.maybeGet(ctx, iu).flatMap(conv)
  }

  fun toValueGetter<T>(
    conv: UiEngine.Serializable ~> T,
  ): Ui.GetterOne<T, Bool> {
    (ctx, iu) ~> conv(this.get(ctx, iu))
  }

  fun set(
    context: mutable SKStore.Context,
    optValue: ?UiEngine.Serializable,
    source: Int,
  ): void {
    if (this.timedHdl.hdl.isWritable(context)) {
      static::toIHandle(this.timedHdl.hdl).write(
        context,
        this.timedHdl.key,
        static::timed(optValue, context.tick.next(), source),
      );
    } else {
      combinesDirName = SKStore.DirName::make(
        this.timedHdl.hdl.dirName,
        "combines/",
      );
      combinesHdl = SKStore.EHandle(
        SKStore.StrID::keyType,
        UiEngine.Combine::sinceFile,
        combinesDirName,
      );
      if (combinesHdl.exists(context)) {
        combinesHdl.maybeGet(context, this.timedHdl.key).each(combine ->
          combine.write(context, optValue)
        )
      }
    }
  }

  static fun combine(
    context: mutable SKStore.Context,
    optPath: ?String,
    combine: UiEngine.Combine,
  ): SKStore.StrID {
    optCombined = Ui.combinedPath(optPath);
    dirName = Ui.toDirName(context, optCombined);
    className = SKStore.normalize(static::sClassName().lowercase());
    timedDirName = SKStore.DirName::make(dirName, `${className}/`);
    combinesDirName = SKStore.DirName::make(timedDirName, "combines/");
    hdl = SKStore.EHandle(
      SKStore.StrID::keyType,
      UiEngine.Combine::sinceFile,
      combinesDirName,
    );
    key = SKStore.StrID(`prop${context.timeStamp().value}`);
    SKStore.toIHandle(hdl).write(context, key, combine);
    key;
  }

  static fun initCombines(
    context: mutable SKStore.Context,
    path: String,
  ): void {
    dirName = Ui.toDirName(context, Some(path));
    className = SKStore.normalize(static::sClassName().lowercase());
    timedDirName = SKStore.DirName::make(dirName, `${className}/`);
    combinesDirName = SKStore.DirName::make(timedDirName, "combines/");
    combinesCacheDirName = SKStore.DirName::make(combinesDirName, "cache/");
    valueDirName = SKStore.DirName::make(timedDirName, "value/");
    combinesHdl = context.makeDir(
      SKStore.StrID::keyType,
      UiEngine.Combine::sinceFile,
      combinesDirName,
    );
    cache = SKStore.LHandle::lazy(
      SKStore.StrID::keyType,
      static::timedFromFile,
      context,
      combinesCacheDirName,
      (context, _self, key) ~> {
        optValue = combinesHdl.maybeGet(context, key).map(combine ->
          combine.combine(context, path)
        );
        static::timed(optValue, context.tick, 0)
      },
    );
    _ = combinesHdl
      .map(
        SKStore.StrID::keyType,
        static::timedFromFile,
        context,
        timedDirName,
        (ctx, writer, key, _) ~> writer.set(key, cache.get(ctx, key)),
      )
      .map(
        SKStore.StrID::keyType,
        static::fileValueFromFile,
        context,
        valueDirName,
        (_ctx, writer, key, it) ~>
          it.first.optValue.each(v -> writer.set(key, static::valueToFile(v)))
        ,
      )
  }
}

class Const(
  value: UiEngine.Serializable,
  writer: UiEngine.Writer,
) extends UiEngine.SerializableProperty {
  //
  fun getName(): String {
    UiEngine.toJSON(this.value).toString()
  }

  fun getPath(): ?String {
    None()
  }

  fun maybeGet(
    _context: mutable SKStore.Context,
    _isUntracked: Bool = false,
  ): ?UiEngine.Serializable {
    this.value match {
    | UiEngine.SOption(opt) -> opt
    | _ -> Some(this.value)
    }
  }

  fun set(
    context: mutable SKStore.Context,
    optValue: ?UiEngine.Serializable,
    _source: Int,
  ): void {
    this.writer.write(context, optValue)
  }

  fun maybeGetTimed(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?(?UiEngine.Serializable, SKStore.Tick, Int) {
    Some((this.maybeGet(context, isUntracked), SKStore.Tick(0), 0))
  }
}

module end;

module UiSeparationProp;

class Serializable extends
  Ui.SeparationProperty,
  UiEngine.PropertySerializable<Ui.Separation>,
{
  //
  fun get from UiEngine.PropertySerializable;
  fun getTimed from UiEngine.PropertySerializable;

  protected static fun valueFromSerializable(
    s: UiEngine.Serializable,
  ): Ui.Separation {
    UiEngine.optSeparation(s).default(Ui.FromStart(100))
  }

  protected static fun valueToSerializable(
    s: Ui.Separation,
  ): UiEngine.Serializable {
    s
  }

  protected static fun getDefaultValue(): Ui.Separation {
    Ui.FromStart(100)
  }
}

module end;

