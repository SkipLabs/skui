fun toTextOptGetter(
  context: readonly SKFS.Context,
  optVar: ?Serializable,
): Ui.GetterOne<?Text, Bool> {
  toOptGetter(
    context,
    optVar,
    p ~> p.toOptValueGetter(s ~> optText(s)),
    optText,
    file ~>
      file match {
      | t @ Text _ -> t
      | str @ SKFS.StringFile _ -> Raw(str.value)
      | i @ SKFS.IntFile _ -> Raw(i.value.toString())
      | f @ SKFS.FloatFile _ -> Raw(f.value.toString())
      | b @ SKFS.BoolFile _ -> Raw(b.value.toString())
      | _ -> Raw("")
      }
    ,
  )
}

