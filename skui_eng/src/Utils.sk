fun expectArray(serializable: Serializable): Array<Serializable> {
  serializable match {
  | v @ SArray _
  | SOption(Some(v @ SArray _)) ->
    v.value
  | _ -> SKFS.cast_violation("UiEngine.SArray", serializable)
  }
}

fun expectString(serializable: Serializable): String {
  serializable match {
  | SInt(v)
  | SOption(Some(SInt(v))) ->
    v.toString()
  | SFloat(v)
  | SOption(Some(SFloat(v))) ->
    v.toString()
  | SString(v)
  | SOption(Some(SString(v))) ->
    v
  | SBool(v)
  | SOption(Some(SBool(v))) ->
    v.toString()
  | _ -> SKFS.cast_violation("showable value", serializable)
  }
}

fun widgetableToWidget(
  context: mutable SKFS.Context,
  root: UiRoot.Storage,
  prebuilt: (mutable SKFS.Context, String) ~> ?Ui.Widget,
  value: ?Widgetable,
): ?Ui.Widget {
  value.flatMap(w ->
    w match {
    | d @ Description _ ->
      Some(d.build(context, context.timeStamp().toString(), root, prebuilt))
    | r @ Renderable _ ->
      prebuilt(context, r.getId()) match {
      | Some(pb) -> Some(pb)
      | _ ->
        r.render(context).map(d ->
          d.build(context, context.timeStamp().toString(), root, prebuilt)
        )
      }
    }
  )
}

fun toOptGetter<T: frozen>(
  context: readonly SKFS.Context,
  optVar: ?Serializable,
  propConv: UiSerializableProp.Property ~> Ui.GetterOne<?T, Bool>,
  optConv: Serializable ~> ?T,
  fileConv: SKFS.File ~> T,
): Ui.GetterOne<?T, Bool> {
  optVar match {
  | Some(s) ->
    s match {
    | UiEngine.Prop(name, optPath, kind) ->
      kind match {
      | Ui.PProp() ->
        propConv(UiSerializableProp.Property::forName(context, optPath, name))
      | Ui.PCombined() ->
        propConv(
          UiSerializableProp.Property::forName(
            context,
            optPath match {
            | Some(p) -> Some(`${p}/combined`)
            | _ -> Some("combined")
            },
            name,
          ),
        )
      | Ui.PLoadable() ->
        optHandle = optPath.map(path ->
          SKFS.LHandle(SKFS.Loadable::forFile, SKFS.DirName::create(path))
        );
        (ctx, iu) ~>
          optHandle
            .flatMap(hdl -> hdl.maybeGetValue(ctx, SKFS.StrID(name), iu))
            .flatMap(loadable -> loadable.maybeGet(fileConv))
      | Ui.PHandle() ->
        optHandle = optPath.map(path ->
          SKFS.EHandle(fileConv, SKFS.DirName::create(path))
        );
        (ctx, iu) ~>
          optHandle.flatMap(hdl -> hdl.maybeGetValue(ctx, SKFS.StrID(name), iu))
      }
    | _ -> Ui.defaultOne(optConv(s))
    }
  | _ -> Ui.defaultOne(None())
  };
}

fun toBoolOptGetter(
  context: readonly SKFS.Context,
  optVar: ?Serializable,
): Ui.GetterOne<?Bool, Bool> {
  toOptGetter(
    context,
    optVar,
    p ~> p.toOptBoolGetter(),
    optBool,
    f ~> SKFS.BoolFile::fromFile(f).value,
  )
}

