module UiEngine;

fun optInt(serializable: Serializable): ?Int {
  serializable match {
  | SInt(v)
  | SOption(Some(SInt(v))) ->
    Some(v)
  | SFloat(v)
  | SOption(Some(SFloat(v))) ->
    Some(v.toInt())
  | SString(v)
  | SOption(Some(SString(v))) ->
    v.toIntOption() match {
    | Some(iv) -> Some(iv)
    | _ -> v.toFloatOption().map(v -> v.toInt())
    }
  | SBool(v)
  | SOption(Some(SBool(v))) ->
    Some(if (v) 1 else 0)
  | _ -> None()
  }
}

fun optFloat(serializable: Serializable): ?Float {
  serializable match {
  | SInt(v)
  | SOption(Some(SInt(v))) ->
    Some(v.toFloat())
  | SFloat(v)
  | SOption(Some(SFloat(v))) ->
    Some(v)
  | SString(v)
  | SOption(Some(SString(v))) ->
    v.toIntOption() match {
    | Some(iv) -> Some(iv.toFloat())
    | _ -> v.toFloatOption()
    }
  | SBool(v)
  | SOption(Some(SBool(v))) ->
    Some(if (v) 1.0 else 0.0)
  | _ -> None()
  }
}

fun optString(serializable: Serializable): ?String {
  serializable match {
  | SInt(v)
  | SOption(Some(SInt(v))) ->
    Some(v.toString())
  | SFloat(v)
  | SOption(Some(SFloat(v))) ->
    Some(v.toString())
  | SString(v)
  | SOption(Some(SString(v))) ->
    Some(v)
  | SBool(v)
  | SOption(Some(SBool(v))) ->
    Some(v.toString())
  | v @ Text _ -> Some(v.toString())
  | SOption(Some(v @ Text _)) -> Some(v.toString())
  | _ -> None()
  }
}

fun optText(serializable: Serializable): ?Text {
  serializable match {
  | v @ Text _ -> Some(v)
  | SOption(Some(v @ Text _)) -> Some(v)
  | _ -> optString(serializable).map(str -> Raw(str))
  }
}

fun optBool(serializable: Serializable): ?Bool {
  serializable match {
  | SInt(v)
  | SOption(Some(SInt(v))) ->
    Some(v != 0)
  | SFloat(v)
  | SOption(Some(SFloat(v))) ->
    Some(!Math.like(v, 0.0))
  | SString(v)
  | SOption(Some(SString(v))) ->
    Some(v == "true")
  | SBool(v)
  | SOption(Some(SBool(v))) ->
    Some(v)
  | _ -> None()
  }
}

fun optRange(serializable: Serializable): ?Range {
  serializable match {
  | v @ Range _
  | SOption(Some(v @ Range _)) ->
    Some(v)
  | _ -> None()
  }
}

