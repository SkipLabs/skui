fun collect(s: Serializable, collector: Renderable -> void): void {
  s match {
  | a @ SArray _
  | SOption(Some(a @ SArray _)) ->
    a.value.each(cs -> collect(cs, collector))
  | v @ Description _
  | SOption(Some(v @ Description _)) ->
    v.collect(collector)
  | r @ Renderable _
  | SOption(Some(r @ Renderable _)) ->
    collector(r)
  | _ -> void
  }
}

module end;
