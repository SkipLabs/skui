fun isPropertyNeeded(optS: ?Serializable, allowConst: Bool = true): Bool {
  optS
    .map(s ->
      s match {
      | UiEngine.Prop _ -> false
      | UiSerializableProp.Const _ -> !allowConst
      | _ -> true
      }
    )
    .default(true)
}

fun toSerializableProperty(
  context: mutable SKFS.Context,
  optS: ?Serializable,
): UiSerializableProp.Property {
  optS.flatMap(s ->
    s match {
    | prop @ Prop _ -> Some(prop.toProperty(context))
    | _ -> None()
    }
  ) match {
  | Some(prop) -> prop
  | _ ->
    optScope = Some(`sc${context.timeStamp().value}`);
    key = SKFS.StrID(`prop${context.timeStamp().value}`);
    UiSerializableProp.Property::initValues(
      context,
      optScope,
      Array[(key, optS)],
    );
    UiSerializableProp.Property::forStrID(context, optScope, key)
  }
}

fun toValueProperty(
  context: mutable SKFS.Context,
  optS: ?Serializable,
): SerializableProperty {
  optS.flatMap(s ->
    s match {
    | prop @ Prop _ -> Some(prop.toProperty(context))
    | c @ UiSerializableProp.Const _ -> Some(c)
    | _ -> None()
    }
  ) match {
  | Some(prop) -> prop
  | _ ->
    optScope = Some(`sc${context.timeStamp().value}`);
    key = SKFS.StrID(`prop${context.timeStamp().value}`);
    UiSerializableProp.Property::initValues(
      context,
      optScope,
      Array[(key, optS)],
    );
    UiSerializableProp.Property::forStrID(context, optScope, key)
  }
}

class WidgetHandle(hdl: SKFS.EHValue<Ui.WidgetFile>) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ WidgetHandle _ -> x
    | _ -> SKFS.cast_violation("UiEngine.WidgetHandle", obj)
    }
  }
}

fun isWidgetable(s: Serializable): Bool {
  s match {
  | Widgetable _
  | UiEngine.Prop _ ->
    true
  | _ -> false
  }
}

fun widgetPipeline(
  context: mutable SKFS.Context,
  property: UiSerializableProp.Property,
  root: UiRoot.Storage,
  prebuilt: (mutable SKFS.Context, String) ~> ?Ui.Widget = (_ctx, _name) ~>
    None(),
): SKFS.EHValue<Ui.WidgetFile> {
  dirname = property.valueHdl.getChildDirName;
  verifiedHdl = property.valueHdl.mapChild(
    WidgetableFile::fromFile,
    context,
    "verifiedwidget/",
    s ~>
      WidgetableFile(
        s match {
        | widget @ Widgetable _
        | SOption(Some(widget @ Widgetable _)) ->
          widget
        | _ -> // Invalid Widget widget
          UiEngine.Indicator{}
        },
      )
    ,
  );
  renderablesHdl = verifiedHdl.hdl.contextWriterKeyMap(
    RenderableFile::fromFile,
    context,
    dirname("renderables/"),
    (_context, writer, _key, widgetable) ~> {
      collector: Renderable -> void = r -> {
        id = r.getId();
        writer.write(SKFS.StrID(id), RenderableFile(r));
      };
      widgetable.value match {
      | r @ Renderable _ -> collector(r)
      | d @ Description _ -> d.collect(collector)
      }
    },
  );
  renderedsHdl = renderablesHdl
    .contextWriterKeyMap(
      DescriptionFile::fromFile,
      context,
      dirname("descriptions/"),
      (context, writer, key, renderable) ~> {
        desc = renderable.value.render(context).default(UiEngine.Indicator{});
        writer.write(key, DescriptionFile(desc))
      },
    )
    .contextWriterKeyMap(
      Ui.WidgetFile::fromFile,
      context,
      dirname("rendereds/"),
      (context, writer, key, description) ~> {
        widget = description.value.build(
          context,
          key.toString(),
          root,
          prebuilt,
        );
        writer.write(key, Ui.WidgetFile(widget))
      },
    );
  cPrebuilt = (ctx, name) ~>
    renderedsHdl.maybeGet(ctx, SKFS.StrID(name)) match {
    | None() -> prebuilt(ctx, name)
    | v -> v.map(wf -> wf.widget)
    };
  SKFS.EHValue(
    verifiedHdl.mapContextWriter(
      Ui.WidgetFile::fromFile,
      context,
      dirname("built/"),
      (context, writer, key, widgetable) ~> {
        widget = widgetable.value match {
        | r @ Renderable _ ->
          renderedsHdl.get(context, SKFS.StrID(r.getId())).widget
        | d @ Description _ -> d.build(context, key.toString(), root, cPrebuilt)
        };
        writer.write(key, Ui.WidgetFile(widget))
      },
    ),
    verifiedHdl.key,
  )
}

fun toWidgetHandle(
  context: mutable SKFS.Context,
  prop: UiEngine.Prop,
  root: UiRoot.Storage,
  prebuilt: (mutable SKFS.Context, String) ~> ?Ui.Widget = (_ctx, _name) ~>
    None(),
): WidgetHandle {
  property = prop.toProperty(context);
  WidgetHandle(widgetPipeline(context, property, root, prebuilt))
}

fun toWidgetsCollection(
  context: mutable SKFS.Context,
  optS: ?Serializable,
  root: UiRoot.Storage,
  prebuilt: (mutable SKFS.Context, String) ~> ?Ui.Widget,
): Ui.WidgetsCollection {
  property = toSerializableProperty(context, optS);
  dirname = property.valueHdl.getChildDirName;
  verifiedVarsHdl = property.valueHdl.mapChild(
    file ~>
      file match {
      | x @ SArray _ -> x
      | _ -> invariant_violation("Must be UiEngine.SArray")
      },
    context,
    "verifiedwidgets/",
    sf ~>
      sf match {
      | arr @ SArray _ -> SArray(arr.value.filter(isWidgetable))
      | s if (isWidgetable(s)) -> SArray(Array[s])
      | _ -> SArray(Array[])
      }
    ,
  );
  widgetVarsHdl = verifiedVarsHdl.mapContextWriterChild(
    f ~> f,
    context,
    "splittedwidgets/",
    (_context, writer, _key, array) ~> {
      keys = mutable Vector<SKFS.BaseName>[];
      array.value.each(s -> {
        sk = SKFS.IID(hash(s));
        keys.push(sk);
        writer.write(sk, s)
      });
      writer.write(SKFS.KKeys(), SKFS.Keys(keys.toArray()));
      writer.write(SKFS.KSize(), SKFS.IntFile(keys.size()));
    },
  );
  renderablesHdl = widgetVarsHdl.contextWriterKeyMap(
    RenderableFile::fromFile,
    context,
    dirname("renderables/"),
    (_context, writer, _key, file) ~> {
      collector: Renderable -> void = r -> {
        writer.write(SKFS.StrID(r.getId()), RenderableFile(r));
      };
      file match {
      | r @ Renderable _ -> collector(r)
      | d @ Description _ -> d.collect(collector)
      | _ -> void
      }
    },
  );
  propertiesHdl = widgetVarsHdl.contextWriterKeyMap(
    WidgetHandle::fromFile,
    context,
    dirname("properties/"),
    (context, writer, key, file) ~> {
      file match {
      | prop @ UiEngine.Prop _ ->
        writer.write(key, toWidgetHandle(context, prop, root))
      | _ -> void
      }
    },
  );
  descriptionsHdl = renderablesHdl.contextWriterKeyMap(
    DescriptionFile::fromFile,
    context,
    dirname("descriptions/"),
    (context, writer, key, renderable) ~> {
      writer.write(
        key,
        DescriptionFile(
          renderable.value.render(context).default(UiEngine.Indicator{}),
        ),
      )
    },
  );
  renderedsHdl = descriptionsHdl.contextWriterKeyMap(
    Ui.WidgetFile::fromFile,
    context,
    dirname("rendereds/"),
    (context, writer, key, description) ~> {
      widget = description.value.build(context, key.toString(), root, prebuilt);
      writer.write(key, Ui.WidgetFile(widget))
    },
  );
  cPrebuilt = (ctx, name) ~>
    renderedsHdl.maybeGet(ctx, SKFS.StrID(name)) match {
    | None() -> prebuilt(ctx, name)
    | v -> v.map(wf -> wf.widget)
    };
  widgetsHdl = widgetVarsHdl.contextWriterKeyMap(
    f ~> f,
    context,
    dirname("built/"),
    (context, writer, key, file) ~> {
      toWrite = file match {
      | r @ Renderable _ -> renderedsHdl.get(context, SKFS.StrID(r.getId()))
      | d @ Description _ ->
        Ui.WidgetFile(
          d.build(context, `${key}#${context.timeStamp()}`, root, cPrebuilt),
        )
      | UiEngine.Prop _ -> propertiesHdl.get(context, key).hdl.get(context)
      | _ -> file
      };
      writer.write(key, toWrite)
    },
  );
  Ui.HandledCollection(widgetsHdl)
}

fun toWidgetGetter(
  context: mutable SKFS.Context,
  optS: ?Serializable,
  root: UiRoot.Storage,
  prebuilt: (mutable SKFS.Context, String) ~> ?Ui.Widget,
): Ui.Getter<Ui.Widget> {
  property = toSerializableProperty(context, optS);
  hdl = widgetPipeline(context, property, root, prebuilt);
  ctx ~> hdl.get(ctx, false).widget;
}

fun toOptWidgetGetter(
  context: mutable SKFS.Context,
  optS: ?Serializable,
  root: UiRoot.Storage,
  prebuilt: (mutable SKFS.Context, String) ~> ?Ui.Widget,
): Ui.Getter<?Ui.Widget> {
  default: ?Ui.Widget = None();
  optS
    .map(s -> {
      property = toSerializableProperty(context, Some(s));
      hdl = widgetPipeline(context, property, root, prebuilt);
      ctx ~> hdl.maybeGet(ctx, false).map(wf -> wf.widget);
    })
    .default(Ui.default(default));
}

fun toStringPropOptGetter(
  context: mutable SKFS.Context,
  optS: ?Serializable,
): Ui.GetterOne<?Ui.StringProperty, Bool> {
  default: ?Ui.StringProperty = None();
  optS
    .map(s -> {
      property = toValueProperty(context, Some(s));
      strProp = UiStringProp.Serializable(property);
      Ui.defaultOne(Some(strProp));
    })
    .default(Ui.defaultOne(default));
}

