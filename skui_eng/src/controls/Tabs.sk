module alias H = UiEngineHandle;

module UiEngine;

base class TabsCloser {
  fun close(context: mutable SKStore.Context, tabs: Array<String>): void;
}

base class Performer {
  fun perform(context: mutable SKStore.Context): void;
}

class Tab{
  id: String,
  //
  optWidget: ?Serializable = None(),
  optText: ?Serializable = None(),
  optIcon: ?Serializable = None(),
  optTooltip: ?Serializable = None(),
  optDiscriminant: ?Serializable = None(),
  optBadge: ?Serializable = None(),
  optProgress: ?Serializable = None(),
  optDisabled: ?Serializable = None(),
  optClosable: ?Serializable = None(),
} extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Tab _ -> x
    | _ -> invariant_violation("Must be UiEngine.Tab")
    }
  }

  fun toGetters(context: mutable SKStore.Context): TabGetter {
    TabGetter(
      toTextOptGetter(context, this.optText),
      toIconOptGetter(context, this.optIcon),
      toTextOptGetter(context, this.optTooltip),
      toTextOptGetter(context, this.optDiscriminant),
      toTextOptGetter(context, this.optBadge),
      toIntOptGetter(context, this.optProgress),
      toBoolOptGetter(context, this.optDisabled),
      toBoolOptGetter(context, this.optClosable),
    )
  }
}

class TabGetter(
  text: Ui.GetterOne<?Text, Bool>,
  icon: Ui.GetterOne<?UiIcon.Description, Bool>,
  tooltip: Ui.GetterOne<?Text, Bool>,
  discriminant: Ui.GetterOne<?Text, Bool>,
  badge: Ui.GetterOne<?Text, Bool>,
  progress: Ui.GetterOne<?Int, Bool>,
  disabled: Ui.GetterOne<?Bool, Bool>,
  closable: Ui.GetterOne<?Bool, Bool>,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ TabGetter _ -> x
    | _ -> invariant_violation("Must be UiEngine.TabGetter")
    }
  }

  fun toTab(context: mutable SKStore.Context): UiTabPane.Tab {
    UiTabPane.Tab{
      optText => this.text(context, false),
      optDiscriminant => this.discriminant(context, false),
      optTooltip => this.tooltip(context, false),
      optIcon => this.icon(context, false).flatMap(ei -> ei.toIconBuilder()),
    }
  }
}

class Action{
  id: String,
  //
  optIcon: ?Serializable = None(),
  optTooltip: ?Serializable = None(),
  optDisabled: ?Serializable = None(),
  optAction: ?Serializable = None(),
} extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Action _ -> x
    | _ -> SKStore.cast_violation("UiEngine.Action", obj)
    }
  }

  fun toGetters(context: mutable SKStore.Context): ActionGetter {
    ActionGetter(
      this.id,
      toIconOptGetter(context, this.optIcon),
      toTextOptGetter(context, this.optTooltip),
      toBoolOptGetter(context, this.optDisabled),
      this.optAction.flatMap(optFunction),
    )
  }
}

class ActionGetter(
  id: String,
  icon: Ui.GetterOne<?UiIcon.Description, Bool>,
  tooltip: Ui.GetterOne<?Text, Bool>,
  disabled: Ui.GetterOne<?Bool, Bool>,
  optAction: ?Function,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ ActionGetter _ -> x
    | _ -> invariant_violation("Must be UiEngine.ActionGetter")
    }
  }

  fun toAction(context: mutable SKStore.Context): UiTabs.Action {
    optAction = this.optAction.map(f ~> H.Performer(f));
    UiTabs.Action(
      this.id,
      this.icon(context, false)
        .flatMap(ei -> ei.toIconBuilder())
        .default(
          Ui.InnerIconBuilder(pt ~>
            Icon.Fill(
              Math.ceil(pt.pixels()).toInt(),
              Some(Colors.transparent()),
            )
          ),
        ),
      this.tooltip(context, false),
      ctx ~> optAction.each(a -> a.perform(ctx)),
      ctx ~> this.disabled(ctx, false).default(false),
    )
  }
}

class Tabs{
  optTabs: ?Serializable = None(),
  optActions: ?Serializable = None(),
  optActive: ?Serializable = None(),
  optPlaceHolder: ?Serializable = None(),
  optKind: ?Serializable = None(),
  optMode: ?Serializable = None(),
  optSide: ?Serializable = None(),
  optMinWidth: ?Serializable = None(),
  optMaxWidth: ?Serializable = None(),
  optIconOnTop: ?Serializable = None(),
  optCloseTabs: ?Serializable = None(),
} extends Description {
  //
  fun collect(_collector: Renderable -> void): void {
    void
  }

  fun build(
    context: mutable SKStore.Context,
    name: String,
    root: UiRoot.Storage,
    prebuilt: (mutable SKStore.Context, String) ~> ?Ui.Widget,
  ): Ui.Widget {
    path = Ui.Path::create(`#in#${static::identifier}#${name}`);
    tabsNeeded = isPropertyNeeded(this.optTabs);
    actionsNeeded = isPropertyNeeded(this.optActions);
    time = context.timeStamp();
    ppsPath = `sc${time}`;
    if (tabsNeeded || actionsNeeded) {
      UiSerializableProp.Property::initValues(
        context,
        Some(ppsPath),
        Array[
          (SKStore.StrID("tabs"), if (tabsNeeded) this.optTabs else None()),
          (
            SKStore.StrID("actions"),
            if (actionsNeeded) this.optActions else None(),
          ),
        ],
      )
    };
    tabsProperty = if (tabsNeeded) {
      UiSerializableProp.Property::forName(context, Some(ppsPath), "tabs")
    } else {
      toSerializableProperty(context, this.optTabs)
    };
    verifiedTabsHdl = tabsProperty.valueHdl.mapChild(
      SArray::type,
      context,
      "verifiedTabs/",
      sf ~> {
        isTab = s ~>
          s match {
          | Tab _ -> true
          | _ -> false
          };
        sf.value match {
        | arr @ SArray _ -> SArray(arr.value.filter(isTab))
        | s -> if (isTab(s)) SArray(Array[s]) else SArray(Array[])
        }
      },
    );
    tabsIdsHdl = verifiedTabsHdl.mapChild(
      SKStore.Strings::type,
      context,
      "tabsIds/",
      sa ~> {
        ids = sa.value.map(Tab::fromSerializable).map(t -> t.id);
        SKStore.Strings(ids)
      },
    );
    splitedTabsHdl = verifiedTabsHdl.mapWriterChild(
      Tab::type,
      context,
      "splitted/",
      (writer, sa) ~>
        sa.value.each(var -> {
          tab = Tab::fromSerializable(var);
          writer.set(SKStore.StrID(tab.id), tab)
        })
      ,
    );
    refDir = splitedTabsHdl.getDirName();
    tabsWidgetsHdl = splitedTabsHdl.map(
      SKStore.StrID::keyType,
      WidgetHandle::type,
      context,
      SKStore.DirName::make(refDir, "widgets/"),
      (context, writer, key, it) ~> {
        property = toSerializableProperty(context, it.first.optWidget);
        hdl = WidgetHandle(widgetPipeline(context, property, root, prebuilt));
        writer.set(key, hdl);
      },
    );
    tabGettersHdl = splitedTabsHdl.map(
      SKStore.StrID::keyType,
      TabGetter::type,
      context,
      SKStore.DirName::make(refDir, "getters/"),
      (ctx, writer, key, it) ~> writer.set(key, it.first.toGetters(ctx)),
    );
    uiTabsHdl = tabGettersHdl.map(
      SKStore.StrID::keyType,
      UiTabPane.Tab::type,
      context,
      SKStore.DirName::make(refDir, "uitabs/"),
      (ctx, writer, key, it) ~> writer.set(key, it.first.toTab(ctx)),
    );
    actionsProperty = if (actionsNeeded) {
      UiSerializableProp.Property::forName(context, Some(ppsPath), "actions")
    } else {
      toSerializableProperty(context, this.optActions)
    };
    verifiedActionsHdl = actionsProperty.valueHdl.mapChild(
      SArray::type,
      context,
      "verifiedActions/",
      sf ~> {
        isAction = s ~>
          s match {
          | Action _ -> true
          | _ -> false
          };
        sf.value match {
        | arr @ SArray _ -> SArray(arr.value.filter(isAction))
        | s -> if (isAction(s)) SArray(Array[s]) else SArray(Array[])
        }
      },
    );
    actionsIdsHdl = verifiedActionsHdl.mapChild(
      SKStore.Strings::type,
      context,
      "actionsIds/",
      sa ~>
        SKStore.Strings(sa.value.map(Action::fromSerializable).map(t -> t.id))
      ,
    );
    splitedActionsHdl = verifiedActionsHdl.mapWriterChild(
      Action::type,
      context,
      "splitted/",
      (writer, vars) ~>
        vars.value.each(var -> {
          action = Action::fromSerializable(var);
          writer.set(SKStore.StrID(action.id), action)
        })
      ,
    );
    actionGettersHdl = splitedActionsHdl.map(
      SKStore.StrID::keyType,
      ActionGetter::type,
      context,
      SKStore.DirName::make(splitedActionsHdl.getDirName(), "getters/"),
      (ctx, writer, key, it) ~> writer.set(key, it.first.toGetters(ctx)),
    );
    uiActionsHdl = actionGettersHdl.map(
      SKStore.StrID::keyType,
      UiTabs.Action::type,
      context,
      SKStore.DirName::make(refDir, "uiactions/"),
      (ctx, writer, key, it) ~> writer.set(key, it.first.toAction(ctx)),
    );
    kindGetter = toIntOptGetter(context, this.optKind);
    modeGetter = toIntOptGetter(context, this.optMode);
    sideGetter = toIntOptGetter(context, this.optSide);
    placeHolderGetter = toTextOptGetter(context, this.optPlaceHolder);
    iconOnTopGetter = toBoolOptGetter(context, this.optIconOnTop);
    minWidthGetter = toIntOptGetter(context, this.optMinWidth);
    maxWidthGetter = toIntOptGetter(context, this.optMaxWidth);
    active = toStringPropOptGetter(context, this.optActive);
    optTabsCloser = this.optCloseTabs.flatMap(optFunction).map(f ->
      H.TabsCloser(f)
    );
    Ui.TabPane::create(
      context,
      path,
      UiTabPane.LamController{
        active => ctx ~> active(ctx, false),
        tabs => ctx ~>
          tabsIdsHdl.maybeGet(ctx).map(v -> v.value).default(Array[]),
        tab => (ctx, tab) ~> uiTabsHdl.get(ctx, SKStore.StrID(tab)),
        actions => ctx ~>
          actionsIdsHdl.maybeGet(ctx).map(v -> v.value).default(Array[]),
        action => (ctx, action) ~> uiActionsHdl.get(ctx, SKStore.StrID(action)),
        mode => ctx ~>
          modeGetter(ctx, false)
            .map(UiTab.Mode::fromCode)
            .default(UiTab.Basic()),
        kind => ctx ~>
          kindGetter(ctx, false)
            .map(UiTabs.Kind::fromCode)
            .default(UiTabs.Fixed()),
        side => ctx ~>
          sideGetter(ctx, false).map(.UiSide::fromCode).default(UiSide.Top()),
        disabled => (ctx, tab) ~>
          tabGettersHdl
            .maybeGet(ctx, SKStore.StrID(tab))
            .flatMap(g -> g.disabled(ctx, false))
            .default(false),
        closable => (ctx, tab) ~>
          optTabsCloser match {
          | None() -> false
          | _ ->
            tabGettersHdl
              .maybeGet(ctx, SKStore.StrID(tab))
              .flatMap(g -> g.closable(ctx, false))
              .default(false)
          },
        progress => (ctx, tab) ~>
          tabGettersHdl.maybeGet(ctx, SKStore.StrID(tab)).flatMap(g ->
            g.progress(ctx, false).map(Ui.Progress::fromInt)
          ),
        badge => (ctx, tab) ~>
          tabGettersHdl.maybeGet(ctx, SKStore.StrID(tab)).flatMap(g ->
            g.badge(ctx, false).map(bt -> Ui.Badge(bt))
          ),
        placeHolder => ctx ~>
          placeHolderGetter(ctx, false).default(!"No active tab."),
        iconOnTop => ctx ~> iconOnTopGetter(ctx, false).default(false),
        minWidth => ctx ~> minWidthGetter(ctx, false),
        maxWidth => ctx ~> maxWidthGetter(ctx, false),
        widget => (ctx, tab) ~>
          tabsWidgetsHdl
            .maybeGet(ctx, SKStore.StrID(tab))
            .flatMap(hdl -> hdl.hdl.maybeGet(ctx))
            .map(wf -> wf.widget),
        onClose_ => (ctx, tabs) ~>
          optTabsCloser.each(closer -> closer.close(ctx, tabs)),
      },
    );
  }
}

module end;
