module alias H = UiEngineHandle;

module UiEngine;

class TreeItems(value: Array<TreeItem>) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ TreeItems _ -> x
    | _ -> invariant_violation("Must be UiEngine.TreeItems")
    }
  }
}

class TreeItem(
  id: String,
  item: UiTree.Item,
  optItems: ?Serializable,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ TreeItem _ -> x
    | _ -> invariant_violation("Must be UiEngine.TreeItem")
    }
  }
}

private fun toUiPath(treePath: Array<String>): ?Ui.Path {
  optPath: ?Ui.Path = None();
  treePath.each(e ->
    !optPath = optPath match {
    | Some(p) -> Some(p.makeChild(e))
    | _ -> Some(Ui.Path(e))
    }
  );
  optPath
}

base class TreeMenuGetter {
  fun getContextMenu(
    context: mutable SKStore.Context,
    optCurrent: ?Ui.Path,
    selection: Array<Ui.Path>,
  ): Array<DItemBase>;
}

base class TreeExpansionListener {
  fun expansionChanged(
    context: mutable SKStore.Context,
    path: Ui.Path,
    value: Bool,
  ): void;
}

base class TreeSelectionListener {
  fun selectionChanged(
    context: mutable SKStore.Context,
    selection: Array<Ui.Path>,
  ): void;
}

base class TreePerformer {
  fun perform(
    context: mutable SKStore.Context,
    optCurrent: ?Ui.Path,
    selection: Array<Ui.Path>,
  ): void;
}

base class TreeDropper {
  fun drop(
    context: mutable SKStore.Context,
    from: Ui.Path,
    to: Ui.Path,
    drop: Ui.Drop,
  ): void;
}

class DDItems(value: Array<UiDropdown.ItemBase>) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ DDItems _ -> x
    | _ -> invariant_violation("Must be UiEngine.DDItems")
    }
  }
}

class TreeItemChildren(
  items: Ui.Getter<?Array<String>>,
  item: Ui.GetterOne<UiTree.Item, String>,
  itemChildren: Ui.GetterOne<TreeItemChildren, String>,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ TreeItemChildren _ -> x
    | _ -> invariant_violation("Must be UiEngine.TreeItemChildren")
    }
  }

  fun getItems(
    context: mutable SKStore.Context,
    optPath: ?Ui.Path,
  ): ?Array<String> {
    this.getChildrenForPath(context, optPath).items(context)
  }

  fun getItem(context: mutable SKStore.Context, path: Ui.Path): UiTree.Item {
    this.getChildrenForPath(context, path.optParent).item(context, path.id)
  }

  private fun getChildrenForPath(
    context: mutable SKStore.Context,
    optPath: ?Ui.Path,
  ): TreeItemChildren {
    optPath match {
    | Some(path) ->
      this.getChildrenForPath(context, path.optParent).itemChildren(
        context,
        path.id,
      )
    | _ -> this
    }
  }
}

fun toTreeItemChildren(
  context: mutable SKStore.Context,
  items: Serializable,
): TreeItemChildren {
  itemsProperty = toSerializableProperty(context, Some(items));
  verifiedItemsHdl = itemsProperty.valueHdl.mapChild(
    file ~>
      file match {
      | x @ SArray _ -> x
      | _ -> invariant_violation("Must be UiEngine.SArray")
      },
    context,
    "verifiedItems/",
    sf ~> {
      isItem = s ~>
        s match {
        | TreeItem _ -> true
        | _ -> false
        };
      sf.value match {
      | arr @ SArray _ -> SArray(arr.value.filter(isItem))
      | s if (isItem(s)) -> SArray(Array[s])
      | _ -> SArray(Array[])
      }
    },
  );
  itemsIdsHdl = verifiedItemsHdl.mapChild(
    SKStore.Strings::type,
    context,
    "itemsIds/",
    sa ~> {
      ids = sa.value.map(TreeItem::fromSerializable).map(t -> t.id);
      SKStore.Strings(ids)
    },
  );
  splitedItemHdl = verifiedItemsHdl.mapWriterChild(
    TreeItem::type,
    context,
    "splitted/",
    (writer, sa) ~>
      sa.value.each(s -> {
        item = TreeItem::fromSerializable(s);
        writer.set(SKStore.StrID(item.id), item)
      })
    ,
  );
  refDir = splitedItemHdl.getDirName();
  treeItemChildrenHdl = splitedItemHdl.map(
    SKStore.StrID::keyType,
    TreeItemChildren::type,
    context,
    SKStore.DirName::make(refDir, "children/"),
    (context, writer, key, it) ~> {
      it.first.optItems.each(itemChildren ->
        writer.set(key, toTreeItemChildren(context, itemChildren))
      )
    },
  );
  TreeItemChildren(
    ctx ~> itemsIdsHdl.maybeGet(ctx).map(v -> v.value),
    (ctx, name) ~> splitedItemHdl.get(ctx, SKStore.StrID(name)).item,
    (ctx, name) ~> treeItemChildrenHdl.get(ctx, SKStore.StrID(name)),
  )
}

class Tree{
  items: Serializable,
  optAllowMultipleSelection: ?Serializable = None(),
  optBadgeMaxChar: ?Serializable = None(),
  optMenuGetter: ?Serializable = None(),
  optSelectionListener: ?Serializable = None(),
  optExpansionListener: ?Serializable = None(),
  optTreePerformer: ?Serializable = None(),
  optTreeDropper: ?Serializable = None(),
} extends Description {
  //
  fun collect(_collector: Renderable -> void): void {
    void
  }

  fun build(
    context: mutable SKStore.Context,
    id: String,
    _root: UiRoot.Storage,
    _prebuilt: (mutable SKStore.Context, String) ~> ?Ui.Widget,
  ): Ui.Widget {
    path = Ui.Path::create(`#control#${static::identifier}#${id}`);
    itemChildren = toTreeItemChildren(context, this.items);
    allowMultipleSelectionGetter = toBoolOptGetter(
      context,
      this.optAllowMultipleSelection,
    );
    badgeMaxCharGetter = toIntOptGetter(context, this.optBadgeMaxChar);
    optSelectionListener = this.optSelectionListener.flatMap(optFunction).map(
      f -> H.TreeSelectionListener(f),
    );
    selectionChange = optSelectionListener
      .map(sl ~> sl.selectionChanged)
      .default(Ui.defaultOne(void));
    optExpansionListener = this.optExpansionListener.flatMap(optFunction).map(
      f -> H.TreeExpansionListener(f),
    );
    expansionChange = optExpansionListener
      .map(sl ~> sl.expansionChanged)
      .default(Ui.defaultTwo(void));
    optTreePerformer = this.optTreePerformer.flatMap(optFunction).map(f ->
      H.TreePerformer(f)
    );
    fire = optTreePerformer.map(p ~> p.perform).default(Ui.defaultTwo(void));
    optTreeDropper = this.optTreeDropper.flatMap(optFunction).map(f ->
      H.TreeDropper(f)
    );
    drop = optTreeDropper.map(d ~> d.drop).default((_, _, _, _) ~> void);
    optMenuGetter = this.optMenuGetter.flatMap(optFunction).map(f ->
      H.TreeMenuGetter(f)
    );
    contextMenuItems = optMenuGetter match {
    | Some(mg) ->
      (ctx, optPath, selection) ~>
        mg.getContextMenu(ctx, optPath, selection).map(items ->
          items.toMenuItem()
        )
    | _ -> Ui.defaultTwo(Array[])
    };
    controller = UiTree.LamController{
      selectionModel => (ctx, iu) ~>
        if (allowMultipleSelectionGetter(ctx, iu).default(false)) {
          UiTree.Multiple()
        } else {
          UiTree.Single()
        },
      badgeMaxChar => ctx ~> badgeMaxCharGetter(ctx, false),
      selectionChange,
      expansionChange,
      fire,
      drop,
      contextMenuItems,
      items => itemChildren.getItems,
      item => itemChildren.getItem,
      //progress: Ui.GetterOne<?Ui.Progress, Ui.Path> = Ui.defaultOne(None()),
      //badge: Ui.GetterOne<?Text, Ui.Path> = Ui.defaultOne(None()),
    };
    Ui.Tree::create(context, path, UiTree.init(context, path, controller));
  }
}

module end;
