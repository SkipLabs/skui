module alias H = UiEngineHandle;

module UiEngine;

extension class Button extends SObject {
  const identifier: String = "button";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "text" => SOption(this.optText),
        "icon" => SOption(this.optIcon),
        "tooltip" => SOption(this.optTooltip),
        "kind" => SInt(
          this.kind match {
          | UiButton.Regular() -> 0
          | UiButton.Primary() -> 1
          | UiButton.Accent() -> 2
          | UiButton.Warn() -> 3
          },
        ),
        "mode" => SInt(
          this.mode match {
          | UiButton.Basic() -> 0
          | UiButton.Stroked() -> 1
          | UiButton.Raised() -> 2
          | UiButton.Flat() -> 3
          | UiButton.Icon(mini) -> if (!mini) 4 else 5
          | UiButton.Fab(mini) -> if (!mini) 6 else 7
          },
        ),
        "onFire" => SOption(
          this.optOnFire.flatMap(f ->
            f match {
            | ha @ H.ActionPerformer _ -> Some(ha.fn)
            | _ -> None()
            }
          ),
        ),
        "disabled" => SOption(this.optDisabled),
        "configuration" => SOption(this.optConfiguration),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    Button{
      kind => maybeGetInt(value, "kind")
        .map(kind ->
          kind match {
          | 1 -> UiButton.Primary()
          | 2 -> UiButton.Accent()
          | 3 -> UiButton.Warn()
          | 0
          | _ ->
            UiButton.Regular()
          }
        )
        .default(UiButton.Regular()),
      mode => maybeGetInt(value, "mode")
        .map(mode ->
          mode match {
          | 1 -> UiButton.Stroked()
          | 2 -> UiButton.Raised()
          | 3 -> UiButton.Flat()
          | 4 -> UiButton.Icon(false)
          | 5 -> UiButton.Icon(true)
          | 6 -> UiButton.Fab(false)
          | 7 -> UiButton.Fab(true)
          | 0
          | _ ->
            UiButton.Basic()
          }
        )
        .default(UiButton.Basic()),
      optOnFire => maybeGet(value, "onFire").flatMap(s ~>
        s match {
        | v @ UiEngine.Function _
        | SOption(Some(v @ UiEngine.Function _)) ->
          Some(H.ActionPerformer(v))
        | _ -> None()
        }
      ),
      optDisabled => maybeGet(value, "disabled"),
      optText => maybeGet(value, "text"),
      optIcon => maybeGet(value, "icon"),
      optTooltip => maybeGet(value, "tooltip"),
      optConfiguration => maybeGet(value, "configuration"),
    }
  }
}

extension class Slider extends SObject {
  const identifier: String = "slider";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "value" => this.value,
        "bounds" => SOption(this.optBounds),
        "range" => SOption(this.optRange),
        "vertical" => SOption(this.optVertical),
        "labeled" => SOption(this.optLabeled),
        "small" => SOption(this.optSmall),
        "disabled" => SOption(this.optDisabled),
        "step" => SOption(this.optStep),
        "ticks" => SOption(this.optTicks),
        "configuration" => SOption(this.optConfiguration),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    Slider{
      value => value.get("value"),
      optBounds => maybeGet(value, "bounds"),
      optLabeled => maybeGet(value, "labeled"),
      optVertical => maybeGet(value, "vertical"),
      optSmall => maybeGet(value, "small"),
      optRange => maybeGet(value, "range"),
      optDisabled => maybeGet(value, "disabled"),
      optStep => maybeGet(value, "step"),
      optTicks => maybeGet(value, "ticks"),
      optConfiguration => maybeGet(value, "configuration"),
    }
  }
}

extension class Input extends SObject {
  const identifier: String = "input";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "label" => SOption(this.optLabel),
        "icon" => SOption(this.optIcon),
        "prefix" => SOption(this.optPrefix),
        "suffix" => SOption(this.optSuffix),
        "placeHolder" => SOption(this.optPlaceHolder),
        "tooltip" => SOption(this.optTooltip),
        "kind" => this.kind,
        "onInputAction" => SOption(this.optInputAction),
        "onFocusLost" => SOption(this.optFocusLost),
        "actionIcon" => SOption(this.optActionIcon),
        "disabled" => SOption(this.optDisabled),
        "editable" => SOption(this.optEditable),
        "withCounter" => SOption(this.optWithCounter),
        "withStatus" => SOption(this.optWithStatus),
        "withLabel" => SOption(this.optWithLabel),
        "withClear" => SOption(this.optWithClear),
        "alignRight" => SOption(this.optAlignRight),
        "placeholderAsLabel" => SOption(this.optPlaceholderAsLabel),
        //
        "text" => SOption(this.optText),
        "position" => SOption(this.optPosition),
        "selection" => SOption(this.optSelection),
        "status" => SOption(this.optStatus),
        //
        "maxChars" => SInt(this.maxChars),
        "visibleChars" => SInt(this.visibleChars),
        "configuration" => SOption(this.optConfiguration),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    Input{
      kind => maybeGet(value, "kind")
        .map(v -> v as UiInput.Kind _)
        .default(UiInput.Text()),
      maxChars => maybeGetInt(value, "maxChars").default(64),
      visibleChars => maybeGetInt(value, "visibleChars").default(10),
      //
      optText => maybeGet(value, "text"),
      optPosition => maybeGet(value, "position"),
      optSelection => maybeGet(value, "selection"),
      optStatus => maybeGet(value, "status"),
      //
      optIcon => maybeGet(value, "icon"),
      optActionIcon => maybeGet(value, "actionIcon"),
      //
      optInputAction => maybeGet(value, "onInputAction"),
      optFocusLost => maybeGet(value, "onFocusLost"),
      optLabel => maybeGet(value, "label"),
      optPrefix => maybeGet(value, "prefix"),
      optSuffix => maybeGet(value, "suffix"),
      optPlaceHolder => maybeGet(value, "placeHolder"),
      optTooltip => maybeGet(value, "tooltip"),
      optDisabled => maybeGet(value, "disabled"),
      optEditable => maybeGet(value, "editable"),
      optWithCounter => maybeGet(value, "withCounter"),
      optWithStatus => maybeGet(value, "withStatus"),
      optWithLabel => maybeGet(value, "withLabel"),
      optWithClear => maybeGet(value, "withClear"),
      optAlignRight => maybeGet(value, "alignRight"),
      optPlaceholderAsLabel => maybeGet(value, "placeholderAsLabel"),
      //
      optConfiguration => maybeGet(value, "configuration"),
    }
  }
}

