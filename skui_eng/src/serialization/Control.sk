extension class Toggle extends SObject {
  const identifier: String = "toggle";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "selected" => this.selected,
        "indeterminate" => SOption(this.optIndeterminate),
        //
        "text" => SOption(this.optText),
        "icon" => SOption(this.optIcon),
        "tooltip" => SOption(this.optTooltip),
        "kind" => SOption(this.optKind),
        "configuration" => SOption(this.optConfiguration),
        "disabled" => SOption(this.optDisabled),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    Toggle{
      selected => value.get("selected"),
      optKind => maybeGet(value, "kind"),
      optIndeterminate => maybeGet(value, "indeterminate"),
      optDisabled => maybeGet(value, "disabled"),
      optText => maybeGet(value, "text"),
      optIcon => maybeGet(value, "icon"),
      optTooltip => maybeGet(value, "tooltip"),
      optConfiguration => maybeGet(value, "configuration"),
    }
  }
}

extension class Scroll {
  const identifier: String = "scroll";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "child" => SOption(this.optWidget),
        "hScroll" => SOption(this.optHScroll),
        "vScroll" => SOption(this.optVScroll),
        "hPolicy" => SOption(this.optHPolicy),
        "vPolicy" => SOption(this.optVPolicy),
        "unit" => SOption(this.optUnit),
        "negative" => SOption(this.optNegative),
        "configuration" => SOption(this.optConfiguration),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): Scroll {
    Scroll{
      optWidget => maybeGet(value, "child"),
      optHScroll => maybeGet(value, "hScroll"),
      optVScroll => maybeGet(value, "vScroll"),
      optHPolicy => maybeGet(value, "hPolicy"),
      optVPolicy => maybeGet(value, "vPolicy"),
      optUnit => maybeGet(value, "unit"),
      optNegative => maybeGet(value, "vertical"),
      optConfiguration => maybeGet(value, "configuration"),
    }
  }
}

module end;
