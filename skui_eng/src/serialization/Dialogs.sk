module UiEngine;

extension class Confirm {
  const identifier: String = "confirm";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "text" => this.text,
        "action" => UiEngine.SOption(this.optAction),
        "type" => this.type,
        "title" => UiEngine.SOption(this.optTitle),
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Confirm {
    Confirm{
      text => maybeGet(value, "text")
        .map(Text::fromSerializable)
        .default(!"No text defined."),
      optAction => maybeGet(value, "action").flatMap(optFunction),
      type => maybeGet(value, "type")
        .map(UiDialogs.QType::fromSerializable)
        .default(UiDialogs.YesNo()),
      optTitle => maybeGet(value, "title").map(Text::fromSerializable),
    }
  }

  static fun fromSerializable(s: UiEngine.Serializable): Confirm {
    s match {
    | t @ Confirm _ -> t
    | _ -> SKFS.cast_violation("UiEngine.Confirm", s)
    }
  }
}

extension class InputDialog {
  const identifier: String = "inputDialog";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "label" => this.label,
        "action" => UiEngine.SOption(this.optAction),
        "title" => UiEngine.SOption(this.optTitle),
        "autoClose" => UiEngine.SBool(this.autoClose),
        //
        "kind" => this.settings.kind,
        "icon" => SOption(this.settings.optIcon),
        "prefix" => SOption(this.settings.optPrefix),
        "suffix" => SOption(this.settings.optSuffix),
        "placeHolder" => SOption(this.settings.optPlaceHolder),
        "tooltip" => SOption(this.settings.optTooltip),
        "disabled" => SOption(this.settings.optDisabled),
        "withCounter" => SOption(this.settings.optWithCounter),
        "withStatus" => SOption(this.settings.optWithStatus),
        "withClear" => SOption(this.settings.optWithClear),
        "alignRight" => SOption(this.settings.optAlignRight),
        //
        "text" => SOption(this.settings.optText),
        "position" => SOption(this.settings.optPosition),
        "selection" => SOption(this.settings.optSelection),
        "status" => SOption(this.settings.optStatus),
        //
        "maxChars" => SInt(this.settings.maxChars),
        "visibleChars" => SInt(this.settings.visibleChars),
      ],
    )
  }

  static fun deserialize(
    value: Map<String, UiEngine.Serializable>,
  ): InputDialog {
    InputDialog{
      label => maybeGet(value, "label")
        .map(Text::fromSerializable)
        .default(!"No text defined."),
      optAction => maybeGet(value, "action").flatMap(optFunction),
      optTitle => maybeGet(value, "title").map(Text::fromSerializable),
      autoClose => UiEngine.getBool(value, "autoClose"),
      settings => UiEngine.Settings{
        // settings
        kind => maybeGet(value, "kind")
          .map(v -> v as UiInput.Kind _)
          .default(UiInput.Text()),
        maxChars => maybeGetInt(value, "maxChars").default(64),
        visibleChars => maybeGetInt(value, "visibleChars").default(10),
        //
        optText => maybeGet(value, "text"),
        optPosition => maybeGet(value, "position"),
        optSelection => maybeGet(value, "selection"),
        optStatus => maybeGet(value, "status"),
        //
        optIcon => maybeGet(value, "icon"),
        optPrefix => maybeGet(value, "prefix"),
        optSuffix => maybeGet(value, "suffix"),
        optPlaceHolder => maybeGet(value, "placeHolder"),
        optTooltip => maybeGet(value, "tooltip"),
        optDisabled => maybeGet(value, "disabled"),
        optWithCounter => maybeGet(value, "withCounter"),
        optWithStatus => maybeGet(value, "withStatus"),
        optWithClear => maybeGet(value, "withClear"),
        optAlignRight => maybeGet(value, "alignRight"),
      },
    }
  }

  static fun fromSerializable(s: UiEngine.Serializable): InputDialog {
    s match {
    | t @ InputDialog _ -> t
    | _ -> SKFS.cast_violation("UiEngine.InputDialog", s)
    }
  }
}

module end;
