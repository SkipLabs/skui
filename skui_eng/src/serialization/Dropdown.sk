module UiEngine;

extension base class DItemBase extends SObject {
  static fun fromSerializable(s: Serializable): DItemBase {
    s match {
    | t @ DItemBase _ -> t
    | _ -> SKFS.cast_violation("UiEngine.DItemBase", s)
    }
  }
}

extension class DItem {
  const identifier: String = "dropdownitem";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "id" => SString(this.id),
        "text" => SString(this.text),
        "icon" => SOption(this.optIcon),
        "tooltip" => SOption(this.optTooltip.map(v -> SString(v))),
        "disabled" => SBool(this.disabled),
        "separator" => SInt(this.separator.toCode()),
        "shortcut" => SOption(this.optShortcut),
        "performer" => SInt(this.performer),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    static{
      id => getString(value, "id"),
      text => getString(value, "text"),
      optIcon => maybeGet(value, "icon").map(
        UiIcon.Description::fromSerializable,
      ),
      optTooltip => maybeGetString(value, "tooltip"),
      disabled => getBool(value, "disabled"),
      separator => Ui.Separator::fromCode(getInt(value, "separator")),
      optShortcut => maybeGet(value, "shortcut").map(
        Ui.Shortcut::fromSerializable,
      ),
      performer => getInt(value, "performer"),
    }
  }
}

extension class DMenu {
  const identifier: String = "dropdownmenu";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "id" => SString(this.id),
        "text" => SString(this.text),
        "icon" => SOption(this.optIcon),
        "tooltip" => SOption(this.optTooltip.map(v -> SString(v))),
        "disabled" => SBool(this.disabled),
        "separator" => SInt(this.separator.toCode()),
        "items" => this.items match {
        | ConstItems(value) -> SArray(value)
        | ComputedItems(supplier) -> SInt(supplier)
        },
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    static{
      id => getString(value, "id"),
      text => getString(value, "text"),
      optIcon => maybeGet(value, "icon").map(
        UiIcon.Description::fromSerializable,
      ),
      optTooltip => maybeGetString(value, "tooltip"),
      disabled => getBool(value, "disabled"),
      separator => Ui.Separator::fromCode(getInt(value, "separator")),
      items => value.get("items") match {
      | arr @ SArray _ -> ConstItems(arr.value.map(DItemBase::fromSerializable))
      | _ -> ComputedItems(getInt(value, "items"))
      },
    }
  }
}

module end;
