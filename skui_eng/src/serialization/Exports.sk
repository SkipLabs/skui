fun checkExternals(
  type_: String,
  value: Map<String, UiEngine.Serializable>,
): ?UiEngine.Serializable {
  if (type_ == Renderable::identifier) {
    Some(Renderable::deserialize(value))
  } else if (type_ == ExExternal::identifier) {
    Some(ExExternal::deserialize(value))
  } else if (type_ == InputPerformerImpl::identifier) {
    Some(InputPerformerImpl::deserialize(value))
  } else if (type_ == CombineImpl::identifier) {
    Some(CombineImpl::deserialize(value))
  } else if (type_ == WriterImpl::identifier) {
    Some(WriterImpl::deserialize(value))
  } else if (type_ == DropdownPerformerImpl::identifier) {
    Some(DropdownPerformerImpl::deserialize(value))
  } else if (type_ == DropdownSupplierImpl::identifier) {
    Some(DropdownSupplierImpl::deserialize(value))
  } else {
    None()
  }
}

