extension class ExExternal extends SObject {
  const identifier: String = "external";

  fun serialize(): (String, Map<String, Serializable>) {
    (static::identifier, Map["id" => SInt(this.value)])
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    ExExternal(getInt(value, "id"))
  }
}

