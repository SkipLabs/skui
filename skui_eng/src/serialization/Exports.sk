module UiEngine;

extension class Renderable extends SObject {
  const identifier: String = "renderable";

  fun serialize(): (String, Map<String, Serializable>) {
    (static::identifier, Map["id" => SInt(this.eptr.value.toInt())])
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    static::make(UInt32::truncate(getInt(value, "id")))
  }
}

fun checkExternals(
  type_: String,
  value: Map<String, UiEngine.Serializable>,
): ?UiEngine.Serializable {
  if (type_ == Renderable::identifier) {
    Some(Renderable::deserialize(value))
  } else {
    None()
  }
}

module end;
