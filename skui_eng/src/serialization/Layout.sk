module UiEngine;

extension class Wrap extends SObject {
  const identifier: String = "wrap";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "widgets" => SOption(this.optWidgets),
        "vertical" => SOption(this.optVertical),
        "rigthToLeft" => SOption(this.optRigthToLeft),
        "downToUp" => SOption(this.optDownToUp),
        "mainAlignment" => SOption(this.optMainAlignment),
        "crossAlignment" => SOption(this.optCrossAlignment),
        "runAlignment" => SOption(this.optRunAlignment),
        "spacing" => SOption(this.optSpacing),
        "runSpacing" => SOption(this.optRunSpacing),
        "configuration" => SOption(this.optConfiguration),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    Wrap{
      optWidgets => maybeGet(value, "widgets"),
      optVertical => maybeGet(value, "vertical"),
      optRigthToLeft => maybeGet(value, "rigthToLeft"),
      optDownToUp => maybeGet(value, "downToUp"),
      optMainAlignment => maybeGet(value, "mainAlignment"),
      optCrossAlignment => maybeGet(value, "crossAlignment"),
      optRunAlignment => maybeGet(value, "runAlignment"),
      optSpacing => maybeGet(value, "spacing"),
      optRunSpacing => maybeGet(value, "runSpacing"),
      optConfiguration => maybeGet(value, "configuration"),
    }
  }
}

