module UiEngine;

extension base class ColumnPerformer extends SObject {
  //
  static fun fromSerializable(s: Serializable): ColumnPerformer {
    s match {
    | t @ ColumnPerformer _ -> t
    | _ -> SKFS.cast_violation("UiEngine.ColumnPerformer", s)
    }
  }
}

extension base class RowsRequirer extends SObject {
  //
  static fun fromSerializable(s: Serializable): RowsRequirer {
    s match {
    | t @ RowsRequirer _ -> t
    | _ -> SKFS.cast_violation("UiEngine.RowsRequirer", s)
    }
  }
}

extension class Sort extends UiEngine.SObject {
  const identifier: String = "sort";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "column" => UiEngine.SString(this.column),
        "order" => UiEngine.SInt(this.optOrder.map(o -> o.toCode()).default(2)),
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Sort {
    Sort(
      getString(value, "column"),
      maybeGetInt(value, "order").flatMap(UiTable.Order::fromCode),
    )
  }

  static fun fromSerializable(s: UiEngine.Serializable): Sort {
    s match {
    | x @ Sort _ -> x
    | _ -> SKFS.cast_violation("UiEngine.Sort", s)
    }
  }
}

extension class Column extends UiEngine.SObject {
  const identifier: String = "column";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "id" => UiEngine.SString(this.id),
        "text" => UiEngine.SOption(this.optText),
        "icon" => UiEngine.SOption(this.optIcon),
        "tooltip" => UiEngine.SOption(this.optTooltip),
        "size" => UiEngine.SOption(this.optSize),
        "actionIcon" => UiEngine.SOption(this.optActionIcon),
        "actionTooltip" => UiEngine.SOption(this.optActionTooltip),
        "cellAlignment" => UiEngine.SOption(this.optCellAlignment),
        "columnPerformer" => UiEngine.SOption(this.optColumnPerformer),
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Column {
    Column{
      id => getString(value, "id"),
      optText => maybeGet(value, "text"),
      optIcon => maybeGet(value, "icon"),
      optTooltip => maybeGet(value, "tooltip"),
      optSize => maybeGet(value, "size"),
      optActionIcon => maybeGet(value, "actionIcon"),
      optActionTooltip => maybeGet(value, "actionTooltip"),
      optCellAlignment => maybeGet(value, "cellAlignment"),
      optColumnPerformer => maybeGet(value, "columnPerformer").map(
        ColumnPerformer::fromSerializable,
      ),
    }
  }

  static fun fromSerializable(s: UiEngine.Serializable): Column {
    s match {
    | x @ Column _ -> x
    | _ -> SKFS.cast_violation("UiEngine.Column", s)
    }
  }
}

