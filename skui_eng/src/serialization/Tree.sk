module UiEngine;

extension class TreeItem extends SObject {
  //
  fun serialize(): (String, Map<String, Serializable>) {
    (identifier, fields) = this.item.serialize();
    !fields = Maps.add(fields, "id", SString(this.id));
    !fields = Maps.add(fields, "items", SOption(this.optItems));
    (identifier, fields)
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    TreeItem(
      getString(value, "id"),
      UiTree.Item::deserialize(value),
      maybeGet(value, "items"),
    );
  }

  static fun fromSerializable(s: Serializable): TreeItem {
    s match {
    | t @ TreeItem _ -> t
    | _ -> SKFS.cast_violation("UiEngine.TreeItem", s)
    }
  }
}

extension class Tree {
  //
  const identifier: String = "tree";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "items" => this.items,
        "allowMultipleSelection" => SOption(this.optAllowMultipleSelection),
        "badgeMaxChar" => SOption(this.optBadgeMaxChar),
        "requestMenu" => SInt(this.requestMenu),
        "onSelectionChange" => SInt(this.onSelectionChange),
        "onExpansionChange" => SInt(this.onExpansionChange),
        "onTreePerform" => SInt(this.onTreePerform),
        "onTreeDrop" => SInt(this.onTreeDrop),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    static{
      items => value.get("items"),
      optAllowMultipleSelection => maybeGet(value, "allowMultipleSelection"),
      optBadgeMaxChar => maybeGet(value, "badgeMaxChar"),
      requestMenu => getInt(value, "requestMenu"),
      onSelectionChange => getInt(value, "onSelectionChange"),
      onExpansionChange => getInt(value, "onExpansionChange"),
      onTreePerform => getInt(value, "onTreePerform"),
      onTreeDrop => getInt(value, "onTreeDrop"),
    }
  }
}

module end;
