extension class Tree {
  //
  const identifier: String = "tree";

  fun serialize(): (String, Map<String, Serializable>) {
    (
      static::identifier,
      Map[
        "items" => this.items,
        "allowMultipleSelection" => SOption(this.optAllowMultipleSelection),
        "badgeMaxChar" => SOption(this.optBadgeMaxChar),
        "menuGetter" => SOption(this.optMenuGetter),
        "onSelectionChange" => SOption(this.optSelectionListener),
        "onExpansionChange" => SOption(this.optExpansionListener),
        "onTreePerform" => SOption(this.optTreePerformer),
        "onTreeDrop" => SOption(this.optTreeDropper),
      ],
    )
  }

  static fun deserialize(value: Map<String, Serializable>): this {
    static{
      items => value.get("items"),
      optExpansionListener => maybeGet(value, "onExpansionChange").map(
        External::fromSerializable,
      ),
      optAllowMultipleSelection => maybeGet(value, "allowMultipleSelection"),
      optBadgeMaxChar => maybeGet(value, "badgeMaxChar"),
      optMenuGetter => maybeGet(value, "menuGetter").map(
        External::fromSerializable,
      ),
      optSelectionListener => maybeGet(value, "onSelectionChange").map(
        External::fromSerializable,
      ),
      optTreePerformer => maybeGet(value, "onTreePerform").map(
        External::fromSerializable,
      ),
      optTreeDropper => maybeGet(value, "onTreeDrop").map(
        External::fromSerializable,
      ),
    }
  }
}

