extension class Portion extends UiEngine.SObject {
  const identifier: String = "portion";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (static::identifier, Map["start" => this.start, "end" => this.end])
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): this {
    Portion(
      Position::fromSerializable(value.get("start")),
      Position::fromSerializable(value.get("end")),
    )
  }

  static fun fromSerializable(obj: UiEngine.Serializable): Portion {
    obj match {
    | x @ Portion _ -> x
    | _ -> SKStore.cast_violation("Ui.Portion", obj)
    }
  }
}

fun checkSerializable(
  type_: String,
  value: Map<String, UiEngine.Serializable>,
): ?UiEngine.Serializable {
  if (type_ == Size::identifier) {
    Some(Size::deserialize(value))
  } else if (type_ == Background::identifier) {
    Some(Background::deserialize(value))
  } else if (type_ == BorderLine::identifier) {
    Some(BorderLine::deserialize(value))
  } else if (type_ == Padding::identifier) {
    Some(Padding::deserialize(value))
  } else if (type_ == Nested::identifier) {
    Some(Nested::deserialize(value))
  } else if (type_ == UiFlex.Configuration::identifier) {
    Some(UiFlex.Configuration::deserialize(value))
  } else if (type_ == UiStack.Configuration::identifier) {
    Some(UiStack.Configuration::deserialize(value))
  } else if (type_ == UiDialogs.QType::identifier) {
    Some(UiDialogs.QType::deserialize(value))
  } else if (type_ == Geometry.InsetsGeometry::identifier) {
    Some(Geometry.InsetsGeometry::deserialize(value))
  } else if (type_ == Separation::identifier) {
    Some(Separation::deserialize(value))
  } else if (type_ == Shortcut::identifier) {
    Some(Shortcut::deserialize(value))
  } /*else if (type_ == UiTexturable.Impl::identifier) {
  Some(UiTexturable.Impl::deserialize(value))
  }*/ else if (type_ == BoxConstraints::identifier) {
    Some(BoxConstraints::deserialize(value))
  } else {
    UiEngine.checkVariables(type_, value)
  }
}

extension base class Configuration extends UiEngine.SObject

extension class DummyConfiguration {
  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    dummy()
  }

  static fun deserialize(_value: Map<String, UiEngine.Serializable>): this {
    dummy()
  }
}

module end;

module UiFlex;

extension class Configuration {
  const identifier: String = "flexConf";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "flex" => UiEngine.SInt(this.flex),
        "fitLoose" => UiEngine.SBool(this.fit == Loose()),
        "ignoreCross" => UiEngine.SBool(this.ignoreCross),
      ],
    )
  }

  static fun deserialize(
    value: Map<String, UiEngine.Serializable>,
  ): Configuration {
    Configuration{
      flex => UiEngine.maybeGetInt(value, "flex").default(1),
      fit => if (UiEngine.maybeGetBool(value, "fitLoose").default(false)) {
        Loose()
      } else {
        Tight()
      },
      ignoreCross => UiEngine.maybeGetBool(value, "ignoreCross").default(false),
    }
  }
}

module end;

module UiStack;

extension class Configuration {
  const identifier: String = "stackConf";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "fit" => UiEngine.SInt(
          this.fit match {
          | Loose() -> 0
          | Expand() -> 1
          | Passthrough() -> 2
          },
        ),
        "visible" => UiEngine.SBool(this.overflow == Visible()),
        "opaque" => UiEngine.SBool(this.opaque),
      ],
    )
  }

  static fun deserialize(
    value: Map<String, UiEngine.Serializable>,
  ): Configuration {
    Configuration{
      fit => UiEngine.maybeGetInt(value, "fit").default(2) match {
      | 0 -> Loose()
      | 1 -> Expand()
      | 2
      | _ ->
        Passthrough()
      },
      overflow => if (UiEngine.maybeGetBool(value, "visible").default(false)) {
        Visible()
      } else {
        Clip()
      },
      opaque => UiEngine.maybeGetBool(value, "opaque").default(false),
    }
  }
}

module end;

module UiDialogs;

extension base class QType extends UiEngine.SObject {
  const identifier: String = "questionType";

  fun code(): Int
  | YesNo _ -> 0
  | AcceptDecline _ -> 1
  | AgreeDisagree _ -> 2
  | ConfirmDismiss _ -> 3
  | QCustom _ -> 4

  fun serialize(): (String, Map<String, UiEngine.Serializable>)
  | YesNo(withNeutral) ->
    (
      static::identifier,
      Map[
        "kind" => UiEngine.SInt(0),
        "withNeutral" => UiEngine.SBool(withNeutral),
      ],
    )
  | AcceptDecline(withNeutral) ->
    (
      static::identifier,
      Map[
        "kind" => UiEngine.SInt(1),
        "withNeutral" => UiEngine.SBool(withNeutral),
      ],
    )
  | AgreeDisagree(withNeutral) ->
    (
      static::identifier,
      Map[
        "kind" => UiEngine.SInt(2),
        "withNeutral" => UiEngine.SBool(withNeutral),
      ],
    )
  | ConfirmDismiss(withNeutral) ->
    (
      static::identifier,
      Map[
        "kind" => UiEngine.SInt(3),
        "withNeutral" => UiEngine.SBool(withNeutral),
      ],
    )
  | QCustom(confirm, dismiss, optNeutral) ->
    (
      static::identifier,
      Map[
        "kind" => UiEngine.SInt(4),
        "confirm" => confirm,
        "dismiss" => dismiss,
        "neutral" => UiEngine.SOption(optNeutral),
      ],
    )

  static fun deserialize(value: Map<String, UiEngine.Serializable>): QType {
    UiEngine.maybeGetInt(value, "kind")
      .map(kind ->
        kind match {
        | 1 ->
          AcceptDecline(
            UiEngine.maybeGetBool(value, "withNeutral").default(false),
          )
        | 2 ->
          AgreeDisagree(
            UiEngine.maybeGetBool(value, "withNeutral").default(false),
          )
        | 3 ->
          ConfirmDismiss(
            UiEngine.maybeGetBool(value, "withNeutral").default(false),
          )
        | 4 ->
          QCustom(
            UiEngine.maybeGet(value, "confirm")
              .map(Text::fromSerializable)
              .default(!"Yes"),
            UiEngine.maybeGet(value, "dismiss")
              .map(Text::fromSerializable)
              .default(!"No"),
            UiEngine.maybeGet(value, "neutral").map(Text::fromSerializable),
          )
        | _ -> YesNo(UiEngine.maybeGetBool(value, "withNeutral").default(false))
        }
      )
      .default(YesNo());
  }

  static fun fromSerializable(s: UiEngine.Serializable): QType {
    s match {
    | t @ QType _ -> t
    | _ -> SKStore.cast_violation("UiEngine.QType", s)
    }
  }
}

module end;

module UiTree;

extension class Item extends UiEngine.SObject {
  //
  const identifier: String = "treeitem";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "text" => this.text,
        "tooltip" => UiEngine.SOption(this.tooltip),
        "icon" => UiEngine.SOption(this.icon),
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Item {
    Item{
      text => Text::fromSerializable(value.get("text")),
      icon => UiEngine.maybeGet(value, "icon").map(
        UiIcon.Description::fromSerializable,
      ),
      tooltip => UiEngine.maybeGet(value, "tooltip").map(
        Text::fromSerializable,
      ),
      leaf => UiEngine.maybeGet(value, "items").isNone(),
    }
  }
}

module end;
