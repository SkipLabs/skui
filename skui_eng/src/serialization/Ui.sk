extension base class EndLine extends UiEngine.SObject {
  const identifier: String = "endline";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "type" => UiEngine.SInt(
          this match {
          | CR() -> 0
          | LF() -> 1
          | CRLF() -> 2
          },
        ),
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): EndLine {
    UiEngine.getInt(value, "type") match {
    | 1 -> LF()
    | 2 -> CRLF()
    | 0
    | _ ->
      CR()
    }
  }

  static fun fromSerializable(obj: UiEngine.Serializable): EndLine {
    obj match {
    | x @ EndLine _ -> x
    | _ -> SKStore.cast_violation("Ui.EndLine", obj)
    }
  }
}

extension base class Indentation extends UiEngine.SObject {
  const identifier: String = "indentation";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "type" => UiEngine.SInt(
          this match {
          | Space _ -> 0
          | Tabulation _ -> 1
          },
        ),
        "size" => UiEngine.SInt(this.size),
      ],
    )
  }

  static fun deserialize(
    value: Map<String, UiEngine.Serializable>,
  ): Indentation {
    UiEngine.getInt(value, "type") match {
    | 1 -> Tabulation(UiEngine.getInt(value, "size"))
    | 0
    | _ ->
      Space(UiEngine.getInt(value, "size"))
    }
  }

  static fun fromSerializable(obj: UiEngine.Serializable): Indentation {
    obj match {
    | x @ Indentation _ -> x
    | _ -> SKStore.cast_violation("Ui.Indentation", obj)
    }
  }
}

