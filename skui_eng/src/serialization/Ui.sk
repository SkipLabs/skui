module Ui;

extension class BoxConstraints extends UiEngine.SObject {
  const identifier: String = "constraints";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "minWidth" => UiEngine.SString(Ui.Px(this.minWidth()).toString()),
        "maxWidth" => UiEngine.SOption(
          if (this.hasBoundedWidth()) {
            Some(UiEngine.SString(Ui.Px(this.maxWidth()).toString()))
          } else {
            None()
          },
        ),
        "minHeight" => UiEngine.SString(Ui.Px(this.minHeight()).toString()),
        "maxHeight" => UiEngine.SOption(
          if (this.hasBoundedHeight()) {
            Some(UiEngine.SString(Ui.Px(this.maxHeight()).toString()))
          } else {
            None()
          },
        ),
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): this {
    optSize = mane -> {
      UiEngine.maybeGetString(value, mane).flatMap(str ->
        Ui.Dim::fromString(str).flatMap(dim ->
          dim match {
          | fs @ FixedSize _ -> Some(fs.pixels())
          | _ -> None()
          }
        )
      )
    };
    BoxConstraints::make{
      minWidth => optSize("minWidth"),
      maxWidth => optSize("maxWidth"),
      minHeight => optSize("minHeight"),
      maxHeight => optSize("maxHeight"),
    }
  }
}

extension class Size extends UiEngine.SObject {
  const identifier: String = "size";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "width" => UiEngine.SString(this.width.toString()),
        "height" => UiEngine.SString(this.width.toString()),
        "keepRatio" => UiEngine.SBool(this.keepRatio),
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): this {
    Size(
      Ui.Dim::fromString(UiEngine.getString(value, "width")).fromSome(),
      Ui.Dim::fromString(UiEngine.getString(value, "height")).fromSome(),
      UiEngine.getBool(value, "keepRatio"),
    )
  }
}

extension class Shortcut extends UiEngine.SObject {
  const identifier: String = "shortcut";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "key" => UiEngine.SString(this.key),
        "ctrl" => UiEngine.SBool(this.ctrl),
        "shift" => UiEngine.SBool(this.shift),
        "alt" => UiEngine.SBool(this.alt),
        "meta" => UiEngine.SBool(this.meta),
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): this {
    Shortcut(
      UiEngine.getString(value, "key"),
      UiEngine.getBool(value, "ctrl"),
      UiEngine.getBool(value, "shift"),
      UiEngine.getBool(value, "alt"),
      UiEngine.getBool(value, "meta"),
    )
  }

  static fun fromSerializable(obj: UiEngine.Serializable): Shortcut {
    obj match {
    | x @ Shortcut _ -> x
    | _ -> SKStore.cast_violation("Ui.Shortcut", obj)
    }
  }
}

extension base class Separation extends UiEngine.SObject {
  const identifier: String = "separation";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "type" => UiEngine.SInt(
          this match {
          | FromStart _ -> 0
          | FromEnd _ -> 1
          | Percent _ -> 2
          },
        ),
        "value" => UiEngine.SInt(this.value),
      ],
    )
  }

  static fun deserialize(
    value: Map<String, UiEngine.Serializable>,
  ): Separation {
    UiEngine.getInt(value, "type") match {
    | 1 -> FromEnd(UiEngine.getInt(value, "value"))
    | 2 -> Percent(Math.clamp(UiEngine.getInt(value, "value"), 0, 100))
    | 0
    | _ ->
      FromStart(UiEngine.getInt(value, "value"))
    }
  }

  static fun fromSerializable(obj: UiEngine.Serializable): Separation {
    obj match {
    | x @ Separation _ -> x
    | _ -> SKStore.cast_violation("Ui.Separation", obj)
    }
  }
}

extension base class Decoration extends UiEngine.SObject {
  //
  static fun fromSerializable(obj: UiEngine.Serializable): Decoration {
    obj match {
    | x @ Decoration _ -> x
    | _ -> SKStore.cast_violation("Ui.Decoration", obj)
    }
  }
}

extension class Background {
  const identifier: String = "background";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "color" => this.paint match {
        | color @ Color _ -> UiEngine.SString(color.toWeb())
        | _ -> invariant_violation("Engine manage only colors.")
        },
        "padding" => this.padding,
        "radius" => UiEngine.SOption(
          this.optRadius.map(v -> UiEngine.SString(`${v}px`)),
        ),
      ],
    )
  }

  static fun deserialize(
    value: Map<String, UiEngine.Serializable>,
  ): Background {
    Background(
      Ui.parseColor(UiEngine.getString(value, "color")).default(Colors.black()),
      UiEngine.maybeGet(value, "padding")
        .map(v -> v as Geometry.InsetsGeometry _)
        .default(Geometry.Insets::all(0.0)),
      UiEngine.maybeGetString(value, "radius").flatMap(Ui.Dim::fromString),
    )
  }
}

extension class BorderLine {
  const identifier: String = "borderline";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "color" => this.paint match {
        | color @ Color _ -> UiEngine.SString(color.toWeb())
        | _ -> invariant_violation("Engine manage only colors.")
        },
        "padding" => this.padding,
      ],
    )
  }

  static fun deserialize(
    value: Map<String, UiEngine.Serializable>,
  ): BorderLine {
    BorderLine{
      padding => UiEngine.maybeGet(value, "padding")
        .map(v -> v as Geometry.InsetsGeometry _)
        .default(Geometry.Insets::all(0.0)),
      paint => Ui.parseColor(UiEngine.getString(value, "color")).default(
        Colors.black(),
      ),
    }
  }
}

extension class Padding {
  const identifier: String = "padding";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (static::identifier, Map["padding" => this.padding])
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Padding {
    Padding(
      UiEngine.maybeGet(value, "padding")
        .map(v -> v as Geometry.InsetsGeometry _)
        .default(Geometry.Insets::all(0.0)),
    )
  }
}

extension class Nested {
  const identifier: String = "nested";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map["decorations" => UiEngine.SArray(this.decorations)],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Nested {
    Nested(
      UiEngine.maybeGetArray(value, "decorations")
        .map(a -> a.map(v -> v as Decoration _))
        .default(Array[]),
    )
  }
}

