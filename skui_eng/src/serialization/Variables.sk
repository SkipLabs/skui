  static fun fromSerializable(s: UiEngine.Serializable): TextProp {
    s match {
    | x @ TextProp _ -> x
    | _ -> SKFS.cast_violation("Ui.TextProp", s)
    }
  }
}

fun checkVariables(
  type_: String,
  value: Map<String, UiEngine.Serializable>,
): ?UiEngine.Serializable {
  if (type_ == JSONProp::identifier) {
    Some(JSONProp::deserialize(value))
  } else if (type_ == IntProp::identifier) {
    Some(IntProp::deserialize(value))
  } else if (type_ == TextProp::identifier) {
    Some(TextProp::deserialize(value))
  } else if (type_ == UiJSONProp.Const::identifier) {
    Some(UiJSONProp.Const::deserialize(value))
  } else {
    None()
  }
}

module end;

module UiJSONProp;

extension class Const extends UiEngine.SObject {
  const identifier: String = "jsonConst";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map[
        "value" => UiEngine.fromJSON(this.value),
        "writer" => (this.writer as H.Writer _).fn,
      ],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Const {
    Const(
      UiEngine.toJSON(value.get("value")),
      H.Writer(value.get("writer") as UiEngine.Function _),
    )
  }

  static fun fromSerializable(s: UiEngine.Serializable): Const {
    s match {
    | x @ Const _ -> x
    | _ -> SKFS.cast_violation("Ui.Const", s)
    }
  }
}

module end;
