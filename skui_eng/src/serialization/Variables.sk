}

extension class TextProp extends UiEngine.SObject {
  const identifier: String = "textProp";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    this.pSerialize(static::identifier)
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): TextProp {
    TextProp::pDeserialize(value)
