module UiJSONProp;

extension class Const extends UiEngine.SObject {
  const identifier: String = "jsonConst";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map["value" => UiEngine.fromJSON(this.value), "writer" => this.writer],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Const {
    Const(
      UiEngine.toJSON(value.get("value")),
      Ui.JSONWriter::forSerializable(value.get("writer")),
    )
  }

  static fun fromSerializable(s: UiEngine.Serializable): Const {
    s match {
    | x @ Const _ -> x
    | _ -> SKFS.cast_violation("Ui.Const", s)
    }
  }
}

module end;
