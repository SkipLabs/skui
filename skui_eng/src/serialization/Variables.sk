module alias H = UiEngineHandle;

module Ui;

extension base class Prop {
  fun pSerialize(
    identifier: String,
  ): (String, Map<String, UiEngine.Serializable>) {
    (
      identifier,
      Map[
        "name" => UiEngine.SString(this.name),
        "path" => UiEngine.SOption(
          this.optPath.map(v -> UiEngine.SString(v.toString())),
        ),
        "combined" => UiEngine.SBool(this.kind == Ui.PCombined()),
      ],
    )
  }

  deferred static fun pDeserialize(
    value: Map<String, UiEngine.Serializable>,
  ): this {
    static(
      UiEngine.getString(value, "name"),
      UiEngine.maybeGetString(value, "path"),
      if (UiEngine.getBool(value, "combined")) Ui.PCombined() else Ui.PProp(),
    )
  }
}

module end;

module UiEngine;

extension class Prop extends SObject {
  const identifier: String = "prop";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    this.pSerialize(static::identifier)
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Prop {
    Prop::pDeserialize(value)
  }

  static fun fromSerializable(s: UiEngine.Serializable): Prop {
    s match {
    | x @ Prop _ -> x
    | _ -> SKStore.cast_violation("UiEngine.Prop", s)
    }
  }
}

fun checkVariables(
  type_: String,
  value: Map<String, UiEngine.Serializable>,
): ?UiEngine.Serializable {
  if (type_ == Prop::identifier) {
    Some(Prop::deserialize(value))
  } else if (type_ == UiSerializableProp.Const::identifier) {
    Some(UiSerializableProp.Const::deserialize(value))
  } else {
    None()
  }
}

module end;

module UiSerializableProp;

extension class Const extends UiEngine.SObject {
  const identifier: String = "const";

  fun serialize(): (String, Map<String, UiEngine.Serializable>) {
    (
      static::identifier,
      Map["value" => this.value, "writer" => (this.writer as H.EWriter _).fn],
    )
  }

  static fun deserialize(value: Map<String, UiEngine.Serializable>): Const {
    Const(
      value.get("value"),
      H.EWriter(value.get("writer") as UiEngine.Function _),
    )
  }

  static fun fromSerializable(s: UiEngine.Serializable): Const {
    s match {
    | x @ Const _ -> x
    | _ -> SKStore.cast_violation("UiSerializableProp.Const", s)
    }
  }
}

module end;
