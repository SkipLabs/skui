module SkuiFontBuild;

@skui_build__source_dirs
fun source_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) {
    Array["native/tests"]
  } else {
    Array[]
  }
}

@skui_build__resources
fun resources(_env: SkuiBuild.Env): Array<String> {
  Array[
    "resources/tests/luximr.bin",
    "resources/tests/luxirr.bin",
    "resources/tests/luxisr.bin",
    "resources/tests/xab.bin",
    "resources/tests/xdsff.bin",
    "resources/tests/xdvso.bin",
    "resources/tests/xtnr.bin",
  ]
}

module end;

@debug
fun main(): void {
  SkuiBuild.build("skuifont") match {
  | Failure(err) -> skipExit(err.code)
  | _ -> void
  }
}
