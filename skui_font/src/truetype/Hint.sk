        }
      } else if (iOpcode == opSHPIX) {
        !top = top - 1;
        d = fixed26_6(this.stack[top.toInt()].toInt());
        loopCount = this.gs.loopCount.toInt();
        toMove = this.getPoints(2, current);
        while (loopCount > 0) {
          !top = top - 1;
          i = this.stack[top].toInt();
          toMove.set(i, this.move(toMove.get(i), d, true));
