        (_, rp1, rp2) = this.gs.rp;
        p = this.getPoints(1, pointType).get(rp2.toInt());
        oldP = this.getPoints(0, pointType).get(rp1.toInt());
        oldRange = dotProduct(p.x - oldP.x, p.y - oldP.y, this.gs.dv);
        !p = this.getPoints(1, current).get(rp2.toInt());
        curP = this.getPoints(0, current).get(rp1.toInt());
        curRange = dotProduct(p.x - curP.x, p.y - curP.y, this.gs.pv);
        loopCount = this.gs.loopCount.toInt();
