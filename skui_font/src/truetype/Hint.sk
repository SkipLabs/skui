          } else {
            p0 = this.getPoints(1, inFontUnits).get(i);
            p1 = this.getPoints(0, inFontUnits).get(rp0.toInt());
            tmp = dotProduct(p0.x - p1.x, p0.y - p1.y, this.gs.dv);
            fixed26_6(this.font.scale(this.scale.asInt() * tmp.asInt()))
          };
          x = (oldDist - this.gs.singleWidth).abs();
          if (x < this.gs.singleWidthCutIn) {
            !oldDist = if (oldDist.asInt() >= 0) {
              this.gs.singleWidth
            } else {
              fixed26_6(0) - this.gs.singleWidth
            }
          };
          // Rounding bit.
          // TODO: metrics compensation.
          distance = if (iOpcode.and(0x04) != 0) {
            this.round(oldDist)
          } else {
            oldDist
          };
          // Minimum distance bit.
          if (iOpcode.and(0x08) != 0) {
            if (oldDist.asInt() >= 0) {
              if (distance < this.gs.minDist) {
                !distance = this.gs.minDist;
              }
            } else {
              negMinDist = fixed26_6(0) - this.gs.minDist;
              if (distance > negMinDist) {
                !distance = negMinDist
              }
            }
          };
          // Set-RP0 bit.
          !rp1 = rp0;
          !rp2 = int32(i);
          if (iOpcode.and(0x10) != 0) {
            !rp0 = int32(i);
          };
          !this.gs.rp = (rp0, rp1, rp2);
          // Move the point.
          !oldDist = dotProduct(p.x - ref.x, p.y - ref.y, this.gs.pv);
          toUpdate.set(i, this.move(p, distance - oldDist, true));
        } else {
          // MIRPxxxxx opcode.
          !top = top - 2;
          i = this.stack[top].toInt();
          cvtDist = this.getScaledCVT(this.stack[top + 1].toInt());
          if (
            (cvtDist - this.gs.singleWidth).abs() < this.gs.singleWidthCutIn
          ) {
            !cvtDist = if (cvtDist.asInt() >= 0) {
              cvtDist + this.gs.singleWidth
            } else {
              cvtDist - this.gs.singleWidth
            }
          };
          (rp0, rp1, rp2) = this.gs.rp;
          (zp0, zp1, _) = this.gs.zp;
          // TODO: implement once we have a .ttf file that triggers
          // this, so that we can step through C's freetype.
          invariant(
            zp1 != 0,
            "TrueType: hinting: unimplemented twilight point adjustment",
          );
          ref = this.getPoints(0, unhinted).get(rp0.toInt());
          p = this.getPoints(1, unhinted).get(i);
          oldDist = dotProduct(p.x - ref.x, p.y - ref.y, this.gs.dv);
          !ref = this.getPoints(0, current).get(rp0.toInt());
          !p = this.getPoints(1, current).get(i);
          curDist = dotProduct(p.x - ref.x, p.y - ref.y, this.gs.pv);
          if (this.gs.autoFlip && oldDist.asInt().xor(cvtDist.asInt()) < 0) {
            !cvtDist = fixed26_6(0) - cvtDist;
          };
          // Rounding bit.
          // TODO: metrics compensation.
          distance = if (iOpcode.and(0x04) != 0) {
            // The CVT value is only used if close enough to oldDist.
            this.round(
              if (
                zp0 == zp1 &&
                (cvtDist - oldDist).abs() > this.gs.controlValueCutIn
              ) {
                oldDist
              } else {
                cvtDist
              },
            )
          } else {
            cvtDist
          };
          // Minimum distance bit.
          if (iOpcode.and(0x08) != 0) {
            if (oldDist.asInt() >= 0) {
              if (distance < this.gs.minDist) {
                !distance = this.gs.minDist
              }
            } else {
              if (distance > fixed26_6(0) - this.gs.minDist) {
                !distance = fixed26_6(0) - this.gs.minDist
              }
            }
          };
          // Set-RP0 bit.
          !rp1 = rp0;
          !rp2 = int32(i);
          if (iOpcode.and(0x10) != 0) {
            !rp0 = int32(i);
          };
          !this.gs.rp = (rp0, rp1, rp2);
          // Move the point.
          this.getPoints(1, current).set(
            i,
            this.move(p, distance - curDist, true),
          );
        }
      };
      !pc = pc + 1;
    };
    this
  }

  mutable fun delta(opcode: Int, pc: Int, top: Int): (Int, Int) {
    if (opcode >= opDELTAC1 && !this.scaledCVTInitialized) {
      this.initializeScaledCVT()
    };
    !top = top - 1;
    n = this.stack[top].toInt();
    invariant(top >= 2 * n, "TrueType: hinting: stack underflow");
    while (n > 0) {
      !top = top - 2;
      b = this.stack[top].toInt();
      c = b.and(0xf0).shr(4);
      if (opcode == opDELTAP2 || opcode == opDELTAC2) {
        !c = c + 16;
      } else if (opcode == opDELTAP3 || opcode == opDELTAC3) {
        !c = c + 32;
      };
      !c = c + this.gs.deltaBase.toInt();
      ppem = (this.scale.asInt() + 1.shl(5)).shr(6);
      if (ppem == c) {
        !b = b.and(0x0f) - 8;
        if (b >= 0) {
          !b = b + 1;
        };
        !b = b * 64 / 1.shl(toUInt32(this.gs.deltaShift));
        a = this.stack[top + 1].toInt();
        if (opcode >= opDELTAC1) {
          this.scaledCVT.set(a, this.scaledCVT.get(a) + fixed26_6(b));
        } else {
          points = this.getPoints(0, current);
          p = points.get(a);
          points.set(a, this.move(p, fixed26_6(b), true));
        }
      };
      !n = n - 1;
    };
    !pc = pc + 1;
    (pc, top)
  }

  mutable fun push(
    program: Array<UInt8>,
    opcode: Int,
    pc: Int,
    top: Int,
  ): (Int, Int) {
    width = 1;
    if (opcode.and(0x80) != 0) {
      !opcode = opcode.and(0x80.not());
      !width = 2;
    };
    if (opcode == 0) {
      !pc = pc + 1;
      invariant(pc < program.size(), "TrueType: hinting:  insufficient data");
      !opcode = program[pc].toInt();
    };
    !pc = pc + 1;
    invariant(
      top + opcode <= this.stack.size(),
      "TrueType: hinting:  stack overflow",
    );
    invariant(
      pc + (width * opcode) <= program.size(),
      "TrueType: hinting:  insufficient data",
    );
    while (opcode > 0) {
      v1 = program[pc];
      this.stack.set(
        top,
        if (width == 1) {
          int32(v1.toInt())
        } else {
          v2 = program[pc + 1].toInt();
          int32(toInt8(v1).shl(8).or(v2))
        },
      );
      !top = top + 1;
      !pc = pc + width;
      !opcode = opcode - 1;
    };
    (pc, top)
  }
  /**
   * Overrides the scaled value from the font's Control Value Table.
   */
  mutable fun setScaledCVT(i: Int, v: Fixed.Int26_6): void {
    if (!this.scaledCVTInitialized) {
      this.initializeScaledCVT();
    };
    if (i >= 0 && i < this.scaledCVT.size()) {
      this.scaledCVT.set(i, v);
    };
  }

  /**
   * Returns the scaled value from the font's Control Value Table.
   */
  mutable fun getScaledCVT(i: Int): Fixed.Int26_6 {
    if (!this.scaledCVTInitialized) {
      this.initializeScaledCVT();
    };
    this.scaledCVT.maybeGet(i).default(fixed26_6(0));
  }

  mutable fun initializeScaledCVT(): void {
    this.!scaledCVTInitialized = true;
    len = this.font.cvt.size() / 2;
    n = if (len < 32) {
      32
    } else {
      len
    };
    this.scaledCVT.resize(n, fixed26_6(0));
    for (i in .Range(0, len)) {
      v1 = this.font.cvt[2 * i];
      v2 = this.font.cvt[(2 * i) + 1];
      unscaled = v1.toInt().shl(8).or(v2.toInt());
      scaled = this.font.scale(this.scale.asInt() * toInt16(uint16(unscaled)));
      this.scaledCVT.set(i, fixed26_6(scaled));
    };
  }

  mutable fun iupShift(interpY: Bool, p1: Int, p2: Int, p: Int): void {
    delta = if (interpY) {
      this.glyphCurrent.get(p).y - this.glyphUnhinted.get(p).y;
    } else {
      this.glyphCurrent.get(p).x - this.glyphUnhinted.get(p).x;
    };
    if (delta.asInt() == 0) {
      return void
    };
    for (i in .Range(p1, p2)) {
      if (i == p) {
        continue;
      };
      cp = this.glyphCurrent.get(i);
      if (interpY) {
        !cp.y = cp.y + delta;
      } else {
        !cp.x = cp.x + delta;
      };
      this.glyphCurrent.set(i, cp);
    }
  }

  mutable fun displacement(useZP1: Bool): (Int, Int, Fixed.Int26_6) {
    (_, rp1, rp2) = this.gs.rp;
    (zonePointer, i) = if (useZP1) {
      (1, rp2.toInt());
    } else {
      (0, rp1.toInt());
    };
    p = this.getPoints(zonePointer, current).get(i);
    q = this.getPoints(zonePointer, unhinted).get(i);
    d = dotProduct(p.x - q.x, p.y - q.y, this.gs.pv);
    (zonePointer, i, d)
  }

  mutable fun iupInterp(
    interpY: Bool,
    p1: Int,
    p2: Int,
    ref1: Int,
    ref2: Int,
  ): void {
    if (p1 > p2) {
      return void;
    };
    if (ref1 >= this.glyphCurrent.size() || ref2 >= this.glyphCurrent.size()) {
      return void;
    };
    ip1 = this.glyphInFontUnits.get(ref1);
    ip2 = this.glyphInFontUnits.get(ref2);
    (ifu1, ifu2) = if (interpY) {
      (ip1.y, ip2.y)
    } else {
      (ip1.x, ip2.x)
    };
    if (ifu1 > ifu2) {
      (!ifu1, !ifu2) = (ifu2, ifu1);
      (!ref1, !ref2) = (ref2, ref1);
    };
    up1 = this.glyphUnhinted.get(ref1);
    up2 = this.glyphUnhinted.get(ref2);
    (unh1, unh2, delta1, delta2) = if (interpY) {
      (
        up1.y,
        up2.y,
        this.glyphCurrent.get(ref1).y - up1.y,
        this.glyphCurrent.get(ref2).y - up2.y,
      )
    } else {
      (
        up1.x,
        up2.x,
        this.glyphCurrent.get(ref1).x - up1.x,
        this.glyphCurrent.get(ref2).x - up2.x,
      )
    };
    if (ifu1 == ifu2) {
      for (i in .Range(p1, p2 + 1)) {
        up = this.glyphUnhinted.get(i);
        xy = if (interpY) {
          up.y
        } else {
          up.x
        };
        !xy = if (xy <= unh1) {
          xy + delta1
        } else {
          xy + delta2
        };
        cp = this.glyphCurrent.get(i);
        if (interpY) {
          !cp.y = xy;
        } else {
          !cp.x = xy;
        };
        this.glyphCurrent.set(i, cp);
      };
      return void;
    };
    scale = 0;
    scaleOK = false;
    for (i in .Range(p1, p2 + 1)) {
      up = this.glyphUnhinted.get(i);
      ifup = this.glyphInFontUnits.get(i);
      (xy, ifuXY) = if (interpY) {
        (up.y, ifup.y)
      } else {
        (up.x, ifup.x)
      };
      !xy = if (xy <= unh1) {
        xy + delta1
      } else if (xy >= unh2) {
        xy + delta2
      } else {
        if (!scaleOK) {
          !scaleOK = true;
          !scale = mulDiv(
            (unh2 + delta2 - unh1 - delta1).asInt(),
            0x10000,
            (ifu2 - ifu1).asInt(),
          )
        };
        numer = (ifuXY - ifu1).asInt() * scale;
        !numer = if (numer >= 0) {
          numer + 0x8000
        } else {
          numer - 0x8000
        };
        unh1 + delta1 + fixed26_6(numer / 0x10000);
      };
      cp = this.glyphCurrent.get(i);
      if (interpY) {
        !cp.y = xy;
      } else {
        !cp.x = xy;
      };
      this.glyphCurrent.set(i, cp);
    };
  }

  /**
   * Skip past bytecode until the next ELSE (if opcode == 0) or the
   * next EIF (for all opcodes). Opcode == 0 means that we have come
   * from an IF. Opcode == 1 means that we have come from an ELSE.
   */
  mutable fun ifelse(program: Array<UInt8>, opcode: Int, pc: Int): Int {
    depth = 0;
    loop {
      !pc = pc + 1;
      invariant(
        pc < program.size(),
        "TrueType: hinting: unbalanced IF or ELSE",
      );
      code = program[pc].toInt();
      if (code == opIF) {
        !depth = depth + 1;
      } else if (code == opELSE) {
        if (depth == 0 && opcode == 0) {
          break void;
        }
      } else if (code == opEIF) {
        !depth = depth - 1;
        if (depth < 0) {
          break void;
        }
      } else {
        !pc = skipInstructionPayload(program, pc, "unbalanced IF or ELSE")
      }
    };
    !pc = pc + 1;
    pc;
  }

  mutable fun getPoints(zp: Int, pt: Int): mutable Array<Point> {
    (zp0, zp1, zp2) = this.gs.zp;
    czp = zp match {
    | 0 -> zp0
    | 1 -> zp1
    | _ -> zp2
    };
    czp.toInt() match {
    | 0 ->
      if (pt == current) {
        this.twilightCurrent
      } else if (pt == unhinted) {
        this.twilightUnhinted
      } else {
        this.twilightInFontUnits
      }
    | _ ->
      if (pt == current) {
        this.glyphCurrent
      } else if (pt == unhinted) {
        this.glyphUnhinted
      } else {
        this.glyphInFontUnits
      }
    };
  }

  mutable fun move(p: Point, distance: Fixed.Int26_6, touch: Bool): Point {
    (fv0, fv1) = this.gs.fv;
    (pv0, pv1) = this.gs.pv;
    fvx = fv0.toInt();
    pvx = pv0.toInt();
    if (fvx == 0x4000 && pvx == 0x4000) {
      if (this.debug) {
        debug(("Before move 1", p.toTuple(), distance));
      };
      !p.x = p.x + distance;
      if (touch) {
        !p.flags = p.flags.or(flagTouchedX)
      };
      if (this.debug) {
        debug(("After move 1", p.toTuple()));
      };
      return p;
    };
    fvy = fv1.toInt();
    pvy = pv1.toInt();
    if (fvy == 0x4000 && pvy == 0x4000) {
      if (this.debug) {
        debug(("Before move 2", p.toTuple(), distance));
      };
      !p.y = p.y + distance;
      if (touch) {
        !p.flags = p.flags.or(flagTouchedY)
      };
      if (this.debug) {
        debug(("After move 2", p.toTuple()));
      };
      return p;
    };
    fvDotPv = (fvx * pvx + fvy * pvy).shr(14);
    if (this.debug) {
      debug(
        ("Before move 3", p.toTuple(), distance.asInt(), fvx, fvy, fvDotPv),
      );
    };
    if (fvx != 0) {
      !p.x = p.x + fixed26_6(mulDiv(fvx, distance.asInt(), fvDotPv));
      if (touch) {
        !p.flags = p.flags.or(flagTouchedX)
      };
    };
    if (fvy != 0) {
      !p.y = p.y + fixed26_6(mulDiv(fvy, distance.asInt(), fvDotPv));
      if (touch) {
        !p.flags = p.flags.or(flagTouchedY)
      };
    };
    if (this.debug) {
      debug(("After move 3", p.toTuple()));
    };
    p;
  }

  /**
   * Rounds the given number. The rounding algorithm is described at
   * https://developer.apple.com/fonts/TTRefMan/RM02/Chap2.html#rounding
   */
  mutable fun round(x: Fixed.Int26_6): Fixed.Int26_6 {
    zero = fixed26_6(0);
    if (this.gs.roundPeriod == zero) {
      // Rounding is off.
      return x
    };
    if (x >= zero) {
      ret = x - this.gs.roundPhase + this.gs.roundThreshold;
      if (this.gs.roundSuper45) {
        !ret = fixed26_6(ret.asInt() / this.gs.roundPeriod.asInt());
        !ret = fixed26_6(ret.asInt() * this.gs.roundPeriod.asInt());
      } else {
        !ret = fixed26_6(ret.asInt().and(-this.gs.roundPeriod.asInt()));
      };
      if (x != zero && ret < zero) {
        !ret = zero;
      };
      return ret + this.gs.roundPhase;
    };
    ret = zero - x - this.gs.roundPhase + this.gs.roundThreshold;
    if (this.gs.roundSuper45) {
      !ret = fixed26_6(ret.asInt() / this.gs.roundPeriod.asInt());
      !ret = fixed26_6(ret.asInt() * this.gs.roundPeriod.asInt());
    } else {
      !ret = fixed26_6(ret.asInt().and(-this.gs.roundPeriod.asInt()));
    };
    if (ret < zero) {
      !ret = zero;
    };
    zero - ret - this.gs.roundPhase;
  }
}
/**
 * Returns x/y in 26.6 fixed point arithmetic.
 */
fun fdiv(x: Fixed.Int26_6, y: Fixed.Int26_6): Fixed.Int26_6 {
  fixed26_6(x.asInt().shl(6) / y.asInt());
}
/**
 * Returns x*y in 26.6 fixed point arithmetic.
 */
fun fmul(x: Fixed.Int26_6, y: Fixed.Int26_6): Fixed.Int26_6 {
  fixed26_6((x.asInt() * y.asInt() + 1.shl(5)).shr(6))
}

/**
 * Increments pc by the extra data that follows a
 * variable length PUSHB or PUSHW instruction.
 */
fun skipInstructionPayload(
  program: Array<UInt8>,
  pc: Int,
  message: String,
): Int {
  code = program[pc].toInt();
  if (code == opNPUSHB) {
    !pc = pc + 1;
    invariant(pc < program.size(), `TrueType: hinting: ${message}`);
    pc + program[pc].toInt();
  } else if (code == opNPUSHW) {
    !pc = pc + 1;
    invariant(pc < program.size(), `TrueType: hinting: ${message}`);
    pc + (2 * program[pc].toInt());
  } else if (
    code == opPUSHB000 ||
    code == opPUSHB001 ||
    code == opPUSHB010 ||
    code == opPUSHB011 ||
    code == opPUSHB100 ||
    code == opPUSHB101 ||
    code == opPUSHB110 ||
    code == opPUSHB111
  ) {
    pc + program[pc].toInt() - (opPUSHB000 - 1);
  } else if (
    code == opPUSHW000 ||
    code == opPUSHW001 ||
    code == opPUSHW010 ||
    code == opPUSHW011 ||
    code == opPUSHW100 ||
    code == opPUSHW101 ||
    code == opPUSHW110 ||
    code == opPUSHW111
  ) {
    pc + (2 * (program[pc].toInt() - (opPUSHW000 - 1)));
  } else {
    pc;
  }
}

fun resetTwilightPoints(
  f: Font,
  p: mutable Array<Point>,
): mutable Array<Point> {
  n = f.maxTwilightPoints.toInt() + 4;
  len = p.size();
  if (n <= len) {
    Array<Point>::mfillBy(len, index -> {
      if (index < n) {
        Point{}
      } else {
        p.get(index)
      }
    })
  } else {
    Array<Point>::mfill(n, Point{})
  }
}
/**
 * dotProduct returns the dot product of [x, y] and q. It is almost the same as
 *	return Fixed.Int26_6((px*qx + py*qy + 1<<13) >> 14)
 */
fun dotProduct(
  x: Fixed.Int26_6,
  y: Fixed.Int26_6,
  q: (Int16, Int16),
): Fixed.Int26_6 {
  (q0, q1) = q;
  ires = (x.asInt() * q0.toInt()) + (y.asInt() * q1.toInt());
  fixed26_6((ires + 1.shl(13)).shr(14));
}

/**
 * mulDiv returns x*y/z, rounded to the nearest integer.
 */
fun mulDiv(x: Int, y: Int, z: Int): Int {
  xy = x * y;
  if (z < 0) {
    (!xy, !z) = (-xy, -z);
  };
  if (xy >= 0) {
    !xy = xy + (z / 2);
  } else {
    !xy = xy - (z / 2);
  };
  xy / z
}

fun normalize(x: Int16, y: Int16): (Int16, Int16) {
  fx = x.toInt().toFloat();
  fy = y.toInt().toFloat();
  hypot = Math.sqrt((fx * fx) + (fy * fy));
  l = 0x4000.toFloat() / hypot;
  !fx = fx * l;
  !fx = if (fx >= 0.0) {
    fx + 0.5
  } else {
    fx - 0.5
  };
  !fy = fy * l;
  !fy = if (fy >= 0.0) {
    fy + 0.5
  } else {
    fy - 0.5
  };
  (int16(fx.toInt()), int16(fy.toInt()))
}

fun toPrintable(array: Array<Point>): Array<(Int, Int, Int)> {
  array.map(p -> p.toTuple())
}

module end;
