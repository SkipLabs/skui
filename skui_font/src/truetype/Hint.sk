module TrueType;

const twilightZone: Int = 0;
const glyphZone: Int = 1;
const numZone: Int = 2;

const current: Int = 0;
const unhinted: Int = 1;
const inFontUnits: Int = 2;
const numPointType: Int = 3;

/**
 * CallStackEntry is a bytecode call stack entry.
 */
class CallStackEntry(
  program: Array<UInt8> = Array[],
  pc: Int = 0,
  loopCount: Int32 = int32(0),
) {}

/**
 * graphicsState is described at https://developer.apple.com/fonts/TTRefMan/RM04/Chap4.html
 */
class GraphicsState{
  // Projection vector, freedom vector and dual projection vector.
  pv: (Int16, Int16), // 2.14 fixed point number
  fv: (Int16, Int16), // 2.14 fixed point number
  dv: (Int16, Int16), // 2.14 fixed point number
  // Reference points and zone pointers.
  rp: (Int32, Int32, Int32),
  zp: (Int32, Int32, Int32),
  // Control Value / Single Width Cut-In.
  controlValueCutIn: Fixed.Int26_6,
  singleWidthCutIn: Fixed.Int26_6,
  singleWidth: Fixed.Int26_6,
  // Delta base / shift.
  deltaBase: Int32,
  deltaShift: Int32,
  // Minimum distance.
  minDist: Fixed.Int26_6,
  // Loop count.
  loopCount: Int32,
  // Rounding policy.
  roundPeriod: Fixed.Int26_6,
  roundPhase: Fixed.Int26_6,
  roundThreshold: Fixed.Int26_6,
  roundSuper45: Bool,
  // Auto-flip.
  autoFlip: Bool,
} {
  const default: GraphicsState = GraphicsState{
    pv => (int16(0x4000), int16(0)), // Unit vector along the X axis.
    fv => (int16(0x4000), int16(0)),
    dv => (int16(0x4000), int16(0)),
    rp => (int32(0), int32(0), int32(0)),
    zp => (int32(1), int32(1), int32(1)),
    controlValueCutIn => fixed26_6((17.shl(6)) / 16), // 17/16 as a fixed.Int26_6.
    singleWidthCutIn => fixed26_6(0),
    singleWidth => fixed26_6(0),
    deltaBase => int32(9),
    deltaShift => int32(3),
    minDist => fixed26_6(1.shl(6)), // 1 as a fixed.Int26_6.
    loopCount => int32(1),
    roundPeriod => fixed26_6(1.shl(6)), // 1 as a fixed.Int26_6.
    roundPhase => fixed26_6(0),
    roundThreshold => fixed26_6(1.shl(5)), // 1/2 as a fixed.Int26_6.
    roundSuper45 => false,
    autoFlip => true,
  };
}

/**
 * Hinter implements bytecode hinting.
 * A hinter can be re-used to hint a series of glyphs from a Font.
 */
mutable class Hinter{
  stack: mutable Array<Int32> = mutable Array[],
  store: mutable Array<Int32> = mutable Array[],
  // functions is a map from function number to bytecode.
  functions: mutable Map<Int32, Array<UInt8>> = mutable Map[],
  // font and scale are the font and scale last used for this hinter.
  // Changing the font will require running the new font's fpgm bytecode.
  // Changing either will require running the font's prep bytecode.
  font: Font = TrueType.Font{},
  scale: Fixed.Int26_6 = fixed26_6(0),
  // gs and defaultGS are the current and default graphics state. The
  // default graphics state is the global default graphics state after
  // the font's fpgm and prep programs have been run.
  gs: GraphicsState = GraphicsState::default,
  defaultGS: GraphicsState = GraphicsState::default,
  // points and ends are the twilight zone's points, glyph's points
  // and glyph's contour boundaries.
  twilightCurrent: mutable Array<Point> = mutable Array[],
  twilightUnhinted: mutable Array<Point> = mutable Array[],
  twilightInFontUnits: mutable Array<Point> = mutable Array[],
  glyphCurrent: mutable Array<Point> = mutable Array[],
  glyphUnhinted: mutable Array<Point> = mutable Array[],
  glyphInFontUnits: mutable Array<Point> = mutable Array[],
  ends: mutable Array<Int> = mutable Array[],
  // scaledCVT is the lazily initialized scaled Control Value Table.
  mutable scaledCVTInitialized: Bool = false,
  scaledCVT: mutable Vector<Fixed.Int26_6> = mutable Vector[],
  debug: Bool = false,
  index: Int = 0,
} {
  mutable fun init(font: Font, scale: Fixed.Int26_6): mutable Hinter {
    !this.twilightCurrent = resetTwilightPoints(font, this.twilightCurrent);
    !this.twilightUnhinted = resetTwilightPoints(font, this.twilightUnhinted);
    !this.twilightInFontUnits = resetTwilightPoints(
      font,
      this.twilightInFontUnits,
    );
    rescale = this.scale != scale;
    if (this.font != font) {
      !this.font = font;
      !rescale = true;
      !this.functions = mutable Map[];
      if (font.maxStackElements > this.stack.size()) {
        x = font.maxStackElements + 255;
        !x = x.and(255.not());
        !this.stack = Array<Int32>::mfill(x, int32(0));
      };
      if (font.maxStorage > this.store.size()) {
        x = font.maxStorage + 15;
        !x = x.and(15.not());
        !this.store = Array<Int32>::mfill(x, int32(0));
      };
      if (!font.fpgm.isEmpty()) {
        !this = this.run(font.fpgm, None(), None(), None(), None());
      }
    };
    if (rescale) {
      !this.scale = scale;
      this.!scaledCVTInitialized = false;
      !this.defaultGS = GraphicsState::default;
      if (!font.prep.isEmpty()) {
        !this = this.run(font.prep, None(), None(), None(), None());
        !this.defaultGS = this.gs;
        // The MS rasterizer doesn't allow the following graphics state
        // variables to be modified by the CVT program.
        !this.defaultGS.pv = GraphicsState::default.pv;
        !this.defaultGS.fv = GraphicsState::default.fv;
        !this.defaultGS.dv = GraphicsState::default.dv;
        !this.defaultGS.rp = GraphicsState::default.rp;
        !this.defaultGS.zp = GraphicsState::default.zp;
        !this.defaultGS.loopCount = GraphicsState::default.loopCount;
      }
    };
    this;
  }

  mutable fun run(
    program: Array<UInt8>,
    optCurrent: ?(Vector<Point>) = None(),
    optUnhinted: ?(Vector<Point>) = None(),
    optInFontUnits: ?(Vector<Point>) = None(),
    optEnds: ?(Vector<Int>) = None(),
  ): mutable Hinter {
    invariant(
      program.size() <= 50000,
      "TrueType: hinting: too many instructions",
    );
    !this.gs = this.defaultGS;
    !this.glyphCurrent = Array::mcreateFromItems(optCurrent.default(Vector[]));
    !this.glyphUnhinted = Array::mcreateFromItems(
      optUnhinted.default(Vector[]),
    );
    !this.glyphInFontUnits = Array::mcreateFromItems(
      optInFontUnits.default(Vector[]),
    );
    !this.ends = Array::mcreateFromItems(optEnds.default(Vector[]));
    steps = 0;
    pc = 0;
    top = 0;
    callStack = Array::mfill(32, CallStackEntry());
    callStackTop = 0;
    while (pc >= 0 && pc < program.size()) {
      !steps = steps + 1;
      invariant(steps < 100000, "TrueType: hinting: too many steps");
      opcode = program[pc];
      invariant(
        top >= popCount[opcode.toInt()].toInt(),
        "TrueType: hinting: stack underflow",
      );
      iOpcode = opcode.toInt();
      if (iOpcode == opSVTCA0) {
        !this.gs.pv = (int16(0), int16(0x4000));
        !this.gs.fv = (int16(0), int16(0x4000));
        !this.gs.dv = (int16(0), int16(0x4000));
      } else if (iOpcode == opSVTCA1) {
        !this.gs.pv = (int16(0x4000), int16(0));
        !this.gs.fv = (int16(0x4000), int16(0));
        !this.gs.dv = (int16(0x4000), int16(0));
      } else if (iOpcode == opSPVTCA0) {
        !this.gs.pv = (int16(0), int16(0x4000));
        !this.gs.dv = (int16(0), int16(0x4000));
      } else if (iOpcode == opSPVTCA1) {
        !this.gs.pv = (int16(0x4000), int16(0));
        !this.gs.dv = (int16(0x4000), int16(0));
      } else if (iOpcode == opSFVTCA0) {
        !this.gs.fv = (int16(0), int16(0x4000));
      } else if (iOpcode == opSFVTCA1) {
        !this.gs.fv = (int16(0x4000), int16(0));
      } else if (
        iOpcode == opSPVTL0 ||
        iOpcode == opSPVTL1 ||
        iOpcode == opSFVTL0 ||
        iOpcode == opSFVTL1
      ) {
        !top = top - 2;
        pPoints = this.getPoints(0, current);
        p1 = pPoints.get(this.stack.get(top).toInt());
        p2 = pPoints.get(this.stack.get(top + 1).toInt());
        dx = int16(p1.x.value.toInt() - p2.x.value.toInt());
        dy = int16(p1.y.value.toInt() - p2.y.value.toInt());
        if (dx == 0 && dy == 0) {
          !dx = int16(0x4000);
        } else if (iOpcode.and(1) != 0) {
          // Counter-clockwise rotation.
          (!dx, !dy) = (int16(-dy.toInt()), dx);
        };
        v = normalize(dx, dy);
        if (iOpcode < opSFVTL0) {
          !this.gs.pv = v;
          !this.gs.dv = v;
        } else {
          !this.gs.fv = v;
        }
      } else if (iOpcode == opSPVFS) {
        !top = top - 2;
        !this.gs.pv = normalize(
          int16(this.stack.get(top).toInt()),
          int16(this.stack.get(top + 1).toInt()),
        );
        !this.gs.dv = this.gs.pv
      } else if (iOpcode == opSFVFS) {
        !top = top - 2;
        !this.gs.fv = normalize(
          int16(this.stack.get(top).toInt()),
          int16(this.stack.get(top + 1).toInt()),
        );
      } else if (iOpcode == opGPV || iOpcode == opGFV) {
        invariant(
          top + 1 < this.stack.size(),
          "TrueType: hinting: stack overflow",
        );
        (x, y) = if (iOpcode == opGPV) this.gs.pv else this.gs.fv;
        this.stack.set(top, int32(x.toInt()));
        this.stack.set(top + 1, int32(y.toInt()));
        !top = top + 2;
      } else if (iOpcode == opSFVTPV) {
        !this.gs.fv = this.gs.pv;
      } else if (iOpcode == opISECT) {
        !top = top - 5;
        toUpdate = this.getPoints(2, current);
        index = this.stack[top].toInt();
        p = toUpdate.get(index);
        a0 = this.getPoints(1, current).get(this.stack[top + 1].toInt());
        a1 = this.getPoints(1, current).get(this.stack[top + 2].toInt());
        b0 = this.getPoints(0, current).get(this.stack[top + 3].toInt());
        b1 = this.getPoints(0, current).get(this.stack[top + 4].toInt());
        dbx = b1.x - b0.x;
        dby = b1.y - b0.y;
        dax = a1.x - a0.x;
        day = a1.y - a0.y;
        dx = b0.x - a0.x;
        dy = b0.y - a0.y;
        discriminant =
          mulDiv(dax.asInt(), -dby.asInt(), 0x40) +
          mulDiv(day.asInt(), dbx.asInt(), 0x40);
        dotProduct =
          mulDiv(dax.asInt(), dbx.asInt(), 0x40) +
          mulDiv(day.asInt(), dby.asInt(), 0x40);
        // The discriminant above is actually a cross product of vectors
        // da and db. Together with the dot product, they can be used as
        // surrogates for sine and cosine of the angle between the vectors.
        // Indeed,
        //       dotproduct   = |da||db|cos(angle)
        //       discriminant = |da||db|sin(angle)
        // We use these equations to reject grazing intersections by
        // thresholding abs(tan(angle)) at 1/19, corresponding to 3 degrees.
        (absDisc, absDotP) = (discriminant, dotProduct);
        if (absDisc < 0) {
          !absDisc = -absDisc;
        };
        if (absDotP < 0) {
          !absDotP = -absDotP;
        };
        if (19 * absDisc > absDotP) {
          val =
            mulDiv(dx.asInt(), -dby.asInt(), 0x40) +
            mulDiv(dy.asInt(), dbx.asInt(), 0x40);
          rx = mulDiv(val, dax.asInt(), discriminant);
          ry = mulDiv(val, day.asInt(), discriminant);
          !p.x = a0.x + fixed26_6(rx);
          !p.y = a0.y + fixed26_6(ry);
        } else {
          !p.x = fixed26_6((a0.x + a1.x + b0.x + b1.x).asInt() / 4);
          !p.y = fixed26_6((a0.y + a1.y + b0.y + b1.y).asInt() / 4);
        };
        !p.flags = p.flags.or(flagTouchedX.or(flagTouchedY));
        toUpdate.set(index, p);
      } else if (iOpcode == opSRP0 || iOpcode == opSRP1 || iOpcode == opSRP2) {
        !top = top - 1;
        val = this.stack[top];
        (rp0, rp1, rp2) = this.gs.rp;
        (opcode.toInt() - opSRP0) match {
        | 0 -> !rp0 = val
        | 1 -> !rp1 = val
        | _ -> !rp2 = val
        };
        !this.gs.rp = (rp0, rp1, rp2);
      } else if (iOpcode == opSZP0 || iOpcode == opSZP1 || iOpcode == opSZP2) {
        !top = top - 1;
        val = this.stack[top];
        (zp0, zp1, zp2) = this.gs.zp;
        (opcode.toInt() - opSZP0) match {
        | 0 -> !zp0 = val
        | 1 -> !zp1 = val
        | _ -> !zp2 = val
        };
        !this.gs.zp = (zp0, zp1, zp2);
      } else if (iOpcode == opSZPS) {
        !top = top - 1;
        val = this.stack[top];
        !this.gs.zp = (val, val, val);
      } else if (iOpcode == opSLOOP) {
        !top = top - 1;
        // https://developer.apple.com/fonts/TrueType-Reference-Manual/RM05/Chap5.html#SLOOP
        // says that "Setting the loop variable to zero is an error". In
        // theory, the inequality on the next line should be "<=" instead
        // of "<". In practice, some font files' bytecode, such as the '2'
        // glyph in the DejaVuSansMono.ttf that comes with Ubuntu 14.04,
        // issue SLOOP with a zero on top of the stack. Just like the C
        // Freetype code, we allow the zero.
        invariant(this.stack[top] >= 0, "TrueType: hinting: invalid data");
        !this.gs.loopCount = this.stack[top];
      } else if (iOpcode == opRTG) {
        !this.gs.roundPeriod = fixed26_6(1.shl(6));
        !this.gs.roundPhase = fixed26_6(0);
        !this.gs.roundThreshold = fixed26_6(1.shl(5));
        !this.gs.roundSuper45 = false;
      } else if (iOpcode == opRTHG) {
        !this.gs.roundPeriod = fixed26_6(1.shl(6));
        !this.gs.roundPhase = fixed26_6(1.shl(5));
        !this.gs.roundThreshold = fixed26_6(1.shl(5));
        !this.gs.roundSuper45 = false;
      } else if (iOpcode == opSMD) {
        !top = top - 1;
        !this.gs.minDist = fixed26_6(this.stack[top].toInt());
      } else if (iOpcode == opELSE) {
        !pc = this.ifelse(program, 1, pc);
        continue;
      } else if (iOpcode == opJMPR) {
        !top = top - 1;
        !pc = pc + this.stack[top].toInt();
        continue;
      } else if (iOpcode == opSCVTCI) {
        !top = top - 1;
        !this.gs.controlValueCutIn = fixed26_6(this.stack[top].toInt());
      } else if (iOpcode == opSSWCI) {
        !top = top - 1;
        !this.gs.singleWidthCutIn = fixed26_6(this.stack[top].toInt());
      } else if (iOpcode == opSSW) {
        !top = top - 1;
        !this.gs.singleWidth = fixed26_6(
          this.font.scale(this.scale.asInt() * this.stack[top].toInt()),
        );
      } else if (iOpcode == opDUP) {
        invariant(top < this.stack.size(), "TrueType: hinting: stack overflow");
        this.stack.set(top, this.stack[top - 1]);
        !top = top + 1;
      } else if (iOpcode == opPOP) {
        !top = top - 1;
      } else if (iOpcode == opCLEAR) {
        !top = 0;
      } else if (iOpcode == opSWAP) {
        v1 = this.stack[top - 1];
        v2 = this.stack[top - 2];
        this.stack.set(top - 1, v2);
        this.stack.set(top - 2, v1);
      } else if (iOpcode == opDEPTH) {
        invariant(top < this.stack.size(), "TrueType: hinting: stack overflow");
        this.stack.set(top, int32(top));
        !top = top + 1;
      } else if (iOpcode == opCINDEX || iOpcode == opMINDEX) {
        x = this.stack[top - 1].toInt();
        invariant(x > 0 && x < top, "TrueType: hinting: invalid data");
        this.stack.set(top - 1, this.stack[top - 1 - x]);
        if (opcode == opMINDEX) {
          toCopy = this.stack.slice(top - x, top);
          toCopy.eachWithIndex((index, value) -> {
            this.stack.set(top - x - 1 + index, value);
          });
          !top = top - 1;
        };
      } else if (iOpcode == opALIGNPTS) {
        !top = top - 2;
        pPoints = this.getPoints(1, current);
        qPoints = this.getPoints(0, current);
        ip = this.stack[top].toInt();
        iq = this.stack[top + 1].toInt();
        p = pPoints.get(ip);
        q = qPoints.get(iq);
        d = dotProduct(q.x - p.x, q.y - p.y, this.gs.pv).idiv(2);
        pPoints.set(ip, this.move(p, d, true));
        qPoints.set(ip, this.move(p, fixed26_6(0) - d, true));
      } else if (iOpcode == opUTP) {
        !top = top - 1;
        pPoints = this.getPoints(1, current);
        ip = this.stack[top].toInt();
        p = pPoints.get(ip);
        !p.flags = p.flags.and(flagTouchedX.or(flagTouchedY).not());
        pPoints.set(ip, p);
      } else if (iOpcode == opLOOPCALL || iOpcode == opCALL) {
        invariant(
          callStackTop < callStack.size(),
          "TrueType: hinting: call stack overflow",
        );
        !top = top - 1;
        f = this.functions.get(this.stack[top]);
        stackEntry = CallStackEntry(program, pc, int32(1));
        if (iOpcode == opLOOPCALL) {
          !top = top - 1;
          if (this.stack[top].toInt() == 0) {
            break void;
          };
          !stackEntry.loopCount = this.stack[top];
        };
        callStack.set(callStackTop, stackEntry);
        !callStackTop = callStackTop + 1;
        !program = f;
        !pc = 0;
        continue;
      } else if (iOpcode == opFDEF) {
        // Save all bytecode up until the next ENDF.
        startPC = pc + 1;
        loop {
          !pc = pc + 1;
          invariant(pc < program.size(), "TrueType: hinting: unbalanced FDEF");
          subCode = program[pc].toInt();
          invariant(subCode != opFDEF, "TrueType: hinting: nested FDEF");
          if (subCode == opENDF) {
            !top = top - 1;
            this.functions.set(this.stack[top], program.slice(startPC, pc + 1));
            break void;
          } else {
            !pc = skipInstructionPayload(program, pc, "unbalanced FDEF");
          }
        };
      } else if (iOpcode == opENDF) {
        invariant(callStackTop != 0, "TrueType: hinting: call stack underflow");
        !callStackTop = callStackTop - 1;
        stackEntry = callStack[callStackTop];
        !stackEntry.loopCount = int32(stackEntry.loopCount - 1);
        callStack.set(callStackTop, stackEntry);
        if (stackEntry.loopCount != 0) {
          !callStackTop = callStackTop + 1;
          !pc = 0;
          continue;
        };
        !program = stackEntry.program;
        !pc = stackEntry.pc;
      } else if (iOpcode == opMDAP0 || iOpcode == opMDAP1) {
        !top = top - 1;
        i = this.stack[top];
        toUpdate = this.getPoints(0, current);
        p = toUpdate.get(i.toInt());
        distance = fixed26_6(0);
        if (iOpcode == opMDAP1) {
          !distance = dotProduct(p.x, p.y, this.gs.pv);
          // TODO: metrics compensation.
          !distance = this.round(distance) - distance;
        };
        !p = this.move(p, distance, true);
        toUpdate.set(i.toInt(), p);
        (_, _, rp2) = this.gs.rp;
        !this.gs.rp = (i, i, rp2);
      } else if (iOpcode == opIUP0 || iOpcode == opIUP1) {
        iupY = iOpcode == opIUP0;
        mask = if (iupY) flagTouchedY else flagTouchedX;
        prevEnd = 0;
        this.ends.each(end -> {
          i = prevEnd;
          while (i < end) {
            p = this.glyphCurrent.get(i);
            while (i < end && p.flags.and(mask) == 0) {
              !i = i + 1;
              !p = this.glyphCurrent.get(i);
            };
            if (i == end) {
              break void;
            };
            (firstTouched, curTouched) = (i, i);
            !i = i + 1;
            while (i < end) {
              !p = this.glyphCurrent.get(i);
              if (p.flags.and(mask) != 0) {
                this.iupInterp(iupY, curTouched + 1, i - 1, curTouched, i);
                !curTouched = i;
              };
              !i = i + 1;
            };
            if (curTouched == firstTouched) {
              this.iupShift(iupY, prevEnd, end, curTouched);
            } else {
              this.iupInterp(
                iupY,
                curTouched + 1,
                end - 1,
                curTouched,
                firstTouched,
              );
              if (firstTouched > 0) {
                this.iupInterp(
                  iupY,
                  prevEnd,
                  firstTouched - 1,
                  curTouched,
                  firstTouched,
                );
              }
            }
          };
          !prevEnd = end;
        });
      } else if (iOpcode == opSHP0 || iOpcode == opSHP1) {
        invariant(
          top >= this.gs.loopCount,
          "TrueType: hinting:  stack underflow",
        );
        (_, _, d) = this.displacement(iOpcode.and(1) == 0);
        loopCount = this.gs.loopCount.toInt();
        toMove = this.getPoints(2, current);
        while (loopCount > 0) {
          !top = top - 1;
          i = this.stack[top].toInt();
          toMove.set(i, this.move(toMove.get(i), d, true));
          !loopCount = loopCount - 1;
        };
        !this.gs.loopCount = int32(1);
      } else if (iOpcode == opSHC0 || iOpcode == opSHC1) {
        !top = top - 1;
        (zonePointer, i, d) = this.displacement(iOpcode.and(1) == 0);
        (zp0, zp1, zp2) = this.gs.zp;
        invariant(
          zp2 != 0,
          "TrueType: hinting:  unimplemented SHC instruction",
        );
        contour = this.stack[top];
        j0 = if (contour.toInt() > 0) {
          this.ends[contour.toInt() - 1]
        } else {
          0
        };
        j1 = this.ends[contour.toInt()];
        czp = zonePointer match {
        | 0 -> zp0
        | 1 -> zp1
        | _ -> zp2
        };
        move = czp != zp2;
        toMove = this.getPoints(2, current);
        for (j in .Range(j0, j1)) {
          if (move || j != i) {
            toMove.set(j, this.move(toMove.get(j), d, true));
          }
        };
      } else if (iOpcode == opSHZ0 || iOpcode == opSHZ1) {
        !top = top - 1;
        (zonePointer, i, d) = this.displacement(iOpcode.and(1) == 0);
        // As per C Freetype, SHZ doesn't move the phantom points, or mark
        // the points as touched.
        (zp0, zp1, zp2) = this.gs.zp;
        toMove = this.getPoints(2, current);
        limit = toMove.size();
        if (zp2.toInt() == glyphZone) {
          !limit = limit - 4;
        };
        czp = zonePointer match {
        | 0 -> zp0
        | 1 -> zp1
        | _ -> zp2
        };
        for (j in .Range(0, limit)) {
