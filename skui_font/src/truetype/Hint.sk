          toUpdate = this.getPoints(1, current);
          ref = this.getPoints(0, current).get(rp0.toInt());
          p = toUpdate.get(i);
          oldDist = if (zp0 == 0 || zp1 == 0) {
            p0 = this.getPoints(1, unhinted).get(i);
            p1 = this.getPoints(0, unhinted).get(rp0.toInt());
