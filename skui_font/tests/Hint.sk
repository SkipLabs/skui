module SKUIFontTest;

@test
fun bytecode(): void {
  Bytecode().run()
}

@test
fun move(): void {
  Move().run()
}

@test
fun normalize(): void {
  Normalize().run()
}

fun uint8(array: Array<Int>): Array<UInt8> {
  array.map(e -> .uint8(e))
}

fun int32(array: Array<Int>): Array<Int32> {
  array.map(e -> .int32(e))
}

class Bytecode() {
  //
  fun run(): void {
    for (i in Range(0, 24)) {
      try {
        this.test(i)
      } catch {
      | exn @ SKTest.ExpectationError _ -> throw exn
      | exn -> SKTest.expectEq(i, i + 1, exn.getMessage())
      }
    }
  }

  fun test(number: Int): void {
    h = mutable TrueType.Hinter{};
    !h = h.init(
      TrueType.Font{maxStorage => uint16(32), maxStackElements => uint16(100)},
      fixed26_6(768),
    );
    number match {
    | 0 ->
      // underflow
      SKTest.expectThrow(
        () -> _ = h.run(uint8(Array[TrueType.opDUP])),
        `expected throw [${number}: underflow]`,
      )
    | 1 ->
      // infinite loop
      SKTest.expectThrow(
        () ->
          _ = h.run(
            uint8(
              Array[
                TrueType.opPUSHW000, // [-1]
                0xff,
                0xff,
                TrueType.opDUP, // [-1, -1]
                TrueType.opJMPR, // [-1]
              ],
            ),
          ),
        `expected throw [${number}: too many steps]`,
      )
    | 2 ->
      // unbalanced if/else
      SKTest.expectThrow(
        () ->
          _ = h.run(
            uint8(
              Array[
                TrueType.opPUSHB000, // [0]
                0,
                TrueType.opIF,
              ],
            ),
          ),
        `expected throw [${number}: unbalanced IF or ELSE]`,
      )
    | 3 ->
      // vector set/gets
      !h = h.run(
        uint8(
          Array[
            TrueType.opSVTCA1, // []
            TrueType.opGPV, // [0x4000, 0]
            TrueType.opSVTCA0, // [0x4000, 0]
            TrueType.opGFV, // [0x4000, 0, 0, 0x4000]
            TrueType.opNEG, // [0x4000, 0, 0, -0x4000]
            TrueType.opSPVFS, // [0x4000, 0]
            TrueType.opSFVTPV, // [0x4000, 0]
            TrueType.opPUSHB000, // [0x4000, 0, 1]
            1,
            TrueType.opGFV, // [0x4000, 0, 1, 0, -0x4000]
            TrueType.opPUSHB000, // [0x4000, 0, 1, 0, -0x4000, 2]
            2,
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 6),
        int32(Array[0x4000, 0, 1, 0, -0x4000, 2]),
        number,
      )
    | 4 ->
      // jumps
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB001, // [10, 2]
            10,
            2,
            TrueType.opJMPR, // [10]
            TrueType.opDUP, // not executed
            TrueType.opDUP, // [10, 10]
            TrueType.opPUSHB010, // [10, 10, 20, 2, 1]
            20,
            2,
            1,
            TrueType.opJROT, // [10, 10, 20]
            TrueType.opDUP, // not executed
            TrueType.opDUP, // [10, 10, 20, 20]
            TrueType.opPUSHB010, // [10, 10, 20, 20, 30, 2, 1]
            30,
            2,
            1,
            TrueType.opJROF, // [10, 10, 20, 20, 30]
            TrueType.opDUP, // [10, 10, 20, 20, 30, 30]
            TrueType.opDUP, // [10, 10, 20, 20, 30, 30, 30]
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 7),
        int32(Array[10, 10, 20, 20, 30, 30, 30]),
        number,
      )
    | 5 ->
      // stack ops
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB010, // [10, 20, 30]
            10,
            20,
            30,
            TrueType.opCLEAR, // []
            TrueType.opPUSHB010, // [40, 50, 60]
            40,
            50,
            60,
            TrueType.opSWAP, // [40, 60, 50]
            TrueType.opDUP, // [40, 60, 50, 50]
            TrueType.opDUP, // [40, 60, 50, 50, 50]
            TrueType.opPOP, // [40, 60, 50, 50]
            TrueType.opDEPTH, // [40, 60, 50, 50, 4]
            TrueType.opCINDEX, // [40, 60, 50, 50, 40]
            TrueType.opPUSHB000, // [40, 60, 50, 50, 40, 4]
            4,
            TrueType.opMINDEX, // [40, 50, 50, 40, 60]
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 5),
        int32(Array[40, 50, 50, 40, 60]),
        number,
      )
    | 6 ->
      // push ops
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB000, // [255]
            255,
            TrueType.opPUSHW001, // [255, -2, 253]
            255,
            254,
            0,
            253,
            TrueType.opNPUSHB, // [1, -2, 253, 1, 2]
            2,
            1,
            2,
            TrueType.opNPUSHW, // [1, -2, 253, 1, 2, 0x0405, 0x0607, 0x0809]
            3,
            4,
            5,
            6,
            7,
            8,
            9,
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 8),
        int32(Array[255, -2, 253, 1, 2, 0x0405, 0x0607, 0x0809]),
        number,
      )
    | 7 ->
      // store ops
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB011, // [1, 22, 3, 44]
            1,
            22,
            3,
            44,
            TrueType.opWS, // [1, 22]
            TrueType.opWS, // []
            TrueType.opPUSHB000, // [3]
            3,
            TrueType.opRS, // [44]
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 1), int32(Array[44]), number)
    | 8 ->
      // comparison ops
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB001, // [10, 20]
            10,
            20,
            TrueType.opLT, // [1]
            TrueType.opPUSHB001, // [1, 10, 20]
            10,
            20,
            TrueType.opLTEQ, // [1, 1]
            TrueType.opPUSHB001, // [1, 1, 10, 20]
            10,
            20,
            TrueType.opGT, // [1, 1, 0]
            TrueType.opPUSHB001, // [1, 1, 0, 10, 20]
            10,
            20,
            TrueType.opGTEQ, // [1, 1, 0, 0]
            TrueType.opEQ, // [1, 1, 1]
            TrueType.opNEQ, // [1, 0]
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 2), int32(Array[1, 0]), number)
    | 9 ->
      // odd/even
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB000, // [159]
            159,
            TrueType.opODD, // [0]
            TrueType.opPUSHB000, // [0, 160]
            160,
            TrueType.opODD, // [0, 1]
            TrueType.opPUSHB000, // [0, 1, 128]
            128,
            TrueType.opEVEN, // [0, 1, 1]
            TrueType.opPUSHB000, // [0, 1, 1, 64]
            64,
            TrueType.opEVEN, // [0, 1, 1, 0]
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 4), int32(Array[0, 1, 1, 0]), number)
    | 10 ->
      // if true
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB001, // [255, 1]
            255,
            1,
            TrueType.opIF,
            TrueType.opPUSHB000, // [255, 2]
            2,
            TrueType.opEIF,
            TrueType.opPUSHB000, // [255, 2, 254]
            254,
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 3), int32(Array[255, 2, 254]), number)
    | 11 ->
      // if false
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB001, // [255, 0]
            255,
            0,
            TrueType.opIF,
            TrueType.opPUSHB000, // [255]
            2,
            TrueType.opEIF,
            TrueType.opPUSHB000, // [255, 254]
            254,
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 2), int32(Array[255, 254]), number)
    | 12 ->
      // if/else true
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB000, // [1]
            1,
            TrueType.opIF,
            TrueType.opPUSHB000, // [2]
            2,
            TrueType.opELSE,
            TrueType.opPUSHB000, // not executed
            3,
            TrueType.opEIF,
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 1), int32(Array[2]), number)
    | 13 ->
      // if/else false
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB000, // [0]
            0,
            TrueType.opIF,
            TrueType.opPUSHB000, // not executed
            2,
            TrueType.opELSE,
            TrueType.opPUSHB000, // [3]
            3,
            TrueType.opEIF,
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 1), int32(Array[3]), number)
    | 14 ->
      // if/else true if/else false
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB010, // [255, 0, 1]
            255,
            0,
            1,
            TrueType.opIF,
            TrueType.opIF,
            TrueType.opPUSHB001, // not executed
            0x58,
            0x58,
            TrueType.opELSE,
            TrueType.opPUSHW000, // [255, 0x5858]
            0x58,
            0x58,
            TrueType.opEIF,
            TrueType.opELSE,
            TrueType.opIF,
            TrueType.opNPUSHB, // not executed
            3,
            0x58,
            0x58,
            0x58,
            TrueType.opELSE,
            TrueType.opNPUSHW, // not executed
            2,
            0x58,
            0x58,
            0x58,
            0x58,
            TrueType.opEIF,
            TrueType.opEIF,
            TrueType.opPUSHB000, // [255, 0x5858, 254]
            254,
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 3),
        int32(Array[255, 0x5858, 254]),
        number,
      )
    | 15 ->
      // if/else false if/else true
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB010, // [255, 1, 0]
            255,
            1,
            0,
            TrueType.opIF,
            TrueType.opIF,
            TrueType.opPUSHB001, // not executed
            0x58,
            0x58,
            TrueType.opELSE,
            TrueType.opPUSHW000, // not executed
            0x58,
            0x58,
            TrueType.opEIF,
            TrueType.opELSE,
            TrueType.opIF,
            TrueType.opNPUSHB, // [255, 0x58, 0x58, 0x58]
            3,
            0x58,
            0x58,
            0x58,
            TrueType.opELSE,
            TrueType.opNPUSHW, // not executed
            2,
            0x58,
            0x58,
            0x58,
            0x58,
            TrueType.opEIF,
            TrueType.opEIF,
            TrueType.opPUSHB000, // [255, 0x58, 0x58, 0x58, 254]
            254,
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 5),
        int32(Array[255, 0x58, 0x58, 0x58, 254]),
        number,
      )
    | 16 ->
      // logical ops
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB010, // [0, 10, 20]
            0,
            10,
            20,
            TrueType.opAND, // [0, 1]
            TrueType.opOR, // [1]
            TrueType.opNOT, // [0]
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 1), int32(Array[0]), number)
    | 17 ->
      // arithmetic ops
      // Calculate abs((-(1 - (2*3)))/2 + 1/64).
      // The answer is 5/2 + 1/64 in ideal numbers, or 161 in 26.6 fixed point math.
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB010, // [64, 128, 192]
            1.shl(6),
            2.shl(6),
            3.shl(6),
            TrueType.opMUL, // [64, 384]
            TrueType.opSUB, // [-320]
            TrueType.opNEG, // [320]
            TrueType.opPUSHB000, // [320, 128]
            2.shl(6),
            TrueType.opDIV, // [160]
            TrueType.opPUSHB000, // [160, 1]
            1,
            TrueType.opADD, // [161]
            TrueType.opABS, // [161]
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 1), int32(Array[161]), number)
    | 18 ->
      // floor, ceiling
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB000, // [96]
            96,
            TrueType.opFLOOR, // [64]
            TrueType.opPUSHB000, // [64, 96]
            96,
            TrueType.opCEILING, // [64, 128]
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 2), int32(Array[64, 128]), number)
    | 19 ->
      // rounding
      !h = h.run(
        uint8(
          Array[
            TrueType.opROFF, // []
            TrueType.opPUSHB000, // [90]
            90,
            TrueType.opROUND00, // [90]
            TrueType.opRTG, // [90]
            TrueType.opPUSHB000, // [90, 90]
            90,
            TrueType.opROUND00, // [90, 64]
            TrueType.opRTHG, // [90, 64]
            TrueType.opPUSHB000, // [90, 64, 90]
            90,
            TrueType.opROUND00, // [90, 64, 96]
            TrueType.opRDTG, // [90, 64, 96]
            TrueType.opPUSHB000, // [90, 64, 96, 90]
            90,
            TrueType.opROUND00, // [90, 64, 96, 64]
            TrueType.opRUTG, // [90, 64, 96, 64]
            TrueType.opPUSHB000, // [90, 64, 96, 64, 90]
            90,
            TrueType.opROUND00, // [90, 64, 96, 64, 128]
            TrueType.opRTDG, // [90, 64, 96, 64, 128]
            TrueType.opPUSHB000, // [90, 64, 96, 64, 128, 90]
            90,
            TrueType.opROUND00, // [90, 64, 96, 64, 128, 96]
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 6),
        int32(Array[90, 64, 96, 64, 128, 96]),
        number,
      )
    | 20 ->
      // super-rounding
      // See figure 20 of https://developer.apple.com/fonts/TTRefMan/RM02/Chap2.html#rounding
      // and the sign preservation steps of the "Order of rounding operations" section.
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB000, // [0x58]
            0x58,
            TrueType.opSROUND, // []
            TrueType.opPUSHW000, // [-81]
            0xff,
            0xaf,
            TrueType.opROUND00, // [-80]
            TrueType.opPUSHW000, // [-80, -80]
            0xff,
            0xb0,
            TrueType.opROUND00, // [-80, -80]
            TrueType.opPUSHW000, // [-80, -80, -17]
            0xff,
            0xef,
            TrueType.opROUND00, // [-80, -80, -16]
            TrueType.opPUSHW000, // [-80, -80, -16, -16]
            0xff,
            0xf0,
            TrueType.opROUND00, // [-80, -80, -16, -16]
            TrueType.opPUSHB000, // [-80, -80, -16, -16, 0]
            0,
            TrueType.opROUND00, // [-80, -80, -16, -16, 16]
            TrueType.opPUSHB000, // [-80, -80, -16, -16, 16, 16]
            16,
            TrueType.opROUND00, // [-80, -80, -16, -16, 16, 16]
            TrueType.opPUSHB000, // [-80, -80, -16, -16, 16, 16, 47]
            47,
            TrueType.opROUND00, // [-80, -80, -16, -16, 16, 16, 16]
            TrueType.opPUSHB000, // [-80, -80, -16, -16, 16, 16, 16, 48]
            48,
            TrueType.opROUND00, // [-80, -80, -16, -16, 16, 16, 16, 80]
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 8),
        int32(Array[-80, -80, -16, -16, 16, 16, 16, 80]),
        number,
      )
    | 21 ->
      // roll
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB010, // [1, 2, 3]
            1,
            2,
            3,
            TrueType.opROLL, // [2, 3, 1]
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 3), int32(Array[2, 3, 1]), number)
    | 22 ->
      // max/min
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHW001, // [-2, -3]
            0xff,
            0xfe,
            0xff,
            0xfd,
            TrueType.opMAX, // [-2]
            TrueType.opPUSHW001, // [-2, -4, -5]
            0xff,
            0xfc,
            0xff,
            0xfb,
            TrueType.opMIN, // [-2, -5]
          ],
        ),
      );
      expectEqualsAt(h.stack.slice(0, 2), int32(Array[-2, -5]), number)
    | 23 ->
      // functions
      !h = h.run(
        uint8(
          Array[
            TrueType.opPUSHB011, // [3, 7, 0, 3]
            3,
            7,
            0,
            3,

            TrueType.opFDEF, // Function #3 (not called)
            TrueType.opPUSHB000,
            98,
            TrueType.opENDF,

            TrueType.opFDEF, // Function #0
            TrueType.opDUP,
            TrueType.opADD,
            TrueType.opENDF,

            TrueType.opFDEF, // Function #7
            TrueType.opPUSHB001,
            10,
            0,
            TrueType.opCALL,
            TrueType.opDUP,
            TrueType.opENDF,

            TrueType.opFDEF, // Function #3 (again)
            TrueType.opPUSHB000,
            99,
            TrueType.opENDF,

            TrueType.opPUSHB001, // [2, 0]
            2,
            0,
            TrueType.opCALL, // [4]
            TrueType.opPUSHB000, // [4, 3]
            3,
            TrueType.opLOOPCALL, // [99, 99, 99, 99]
            TrueType.opPUSHB000, // [99, 99, 99, 99, 7]
            7,
            TrueType.opCALL, // [99, 99, 99, 99, 20, 20]
          ],
        ),
      );
      expectEqualsAt(
        h.stack.slice(0, 6),
        int32(Array[99, 99, 99, 99, 20, 20]),
        number,
      )
    | _ -> invariant_violation(`Invalid test number ${number}`)
    }
  }
}

class Move() {
  //
  const values: Array<Array<Int>> = Array[
    // pvX, pvY, fvX, fvY, expectedX, expectedY
    Array[0x4000, 0x0000, 0x4000, 0x0000, 1000, 0],
    Array[0x4000, 0x0000, -0x4000, 0x0000, 1000, 0],
    Array[-0x4000, 0x0000, 0x4000, 0x0000, -1000, 0],
    Array[-0x4000, 0x0000, -0x4000, 0x0000, -1000, 0],
    Array[0x0000, 0x4000, 0x0000, 0x4000, 0, 1000],
    Array[0x0000, 0x4000, 0x0000, -0x4000, 0, 1000],
    Array[0x4000, 0x0000, 0x2d41, 0x2d41, 1000, 1000],
    Array[0x4000, 0x0000, -0x2d41, 0x2d41, 1000, -1000],
    Array[0x4000, 0x0000, 0x2d41, -0x2d41, 1000, -1000],
    Array[0x4000, 0x0000, -0x2d41, -0x2d41, 1000, 1000],
    Array[-0x4000, 0x0000, 0x2d41, 0x2d41, -1000, -1000],
    Array[-0x4000, 0x0000, -0x2d41, 0x2d41, -1000, 1000],
    Array[-0x4000, 0x0000, 0x2d41, -0x2d41, -1000, 1000],
    Array[-0x4000, 0x0000, -0x2d41, -0x2d41, -1000, -1000],
    Array[0x376d, 0x2000, 0x2d41, 0x2d41, 732, 732],
    Array[-0x376d, 0x2000, 0x2d41, 0x2d41, -2732, -2732],
    Array[0x376d, 0x2000, 0x2d41, -0x2d41, 2732, -2732],
    Array[-0x376d, 0x2000, 0x2d41, -0x2d41, -732, 732],
    Array[-0x376d, -0x2000, 0x2d41, 0x2d41, -732, -732],
    Array[0x376d, 0x2000, 0x4000, 0x0000, 1155, 0],
    Array[0x376d, 0x2000, 0x0000, 0x4000, 0, 2000],
  ];

  fun run(): void {
    static::values.eachWithIndex(this.test)
  }

  fun test(idx: Int, current: Array<Int>): void {
    h = mutable TrueType.Hinter{};
    p = TrueType.Point{};
    !h.gs.pv = (int16(current[0]), int16(current[1]));
    !h.gs.fv = (int16(current[2]), int16(current[3]));
    !p = h.move(p, fixed26_6(1000), true);
    tx = p.flags.and(TrueType.flagTouchedX) != 0;
    ty = p.flags.and(TrueType.flagTouchedY) != 0;
    expectTX = current[4] != 0;
    expectTY = current[5] != 0;
    expectEqualsAt(
      ((p.x.asInt(), p.y.asInt()), (tx, ty)),
      ((current[4], current[5]), (expectTX, expectTY)),
      `${idx}:0`,
    );
    a = p.x.asInt() * current[3];
    b = p.y.asInt() * current[2];
    expectEqualsAt(a, b, `${idx}:1`);
    dotProd = ((p.x.asInt() * current[0]) +
      (p.y.asInt() * current[1]) +
      1.shl(13)).shr(14);
    expectEqualsAt(dotProd, 1000, `${idx}:2`);
  }
}

// TestNormalize tests that the normalize function matches the output of the C
// Freetype implementation.
class Normalize() {
  //
  const values: Array<(Int, Int)> = Array[
    (-15895, 3974),
    (-15543, 5181),
    (-14654, 7327),
    (-11585, 11585),
    (0, 16384),
    (11585, 11585),
    (14654, 7327),
    (15543, 5181),
    (15895, 3974),
    (16066, 3213),
    (16161, 2694),
    (16219, 2317),
    (16257, 2032),
    (16284, 1809),
  ];

  fun count(): Int {
    static::values.size();
  }

  fun run(): void {
    static::values.eachWithIndex(this.test)
  }

  fun test(idx: Int, value: (Int, Int)): void {
    (ex, ey) = value;
    expectEqualsAt(
      TrueType.normalize(int16(idx - 4), int16(1)),
      (int16(ex), int16(ey)),
      idx,
    )
  }
}

module end;
