module SKUIFontTest;

base class Case uses HasClassName

fun expectEq<T: frozen>(
  actual: T,
  expected: T,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected equality",
): void {
  if (inspect(actual) != inspect(expected)) {
    throw SKTest.ExpectationError(msg, conv(expected), conv(actual))
  }
}

fun expectEqAt<T: frozen, I: Show>(
  actual: T,
  expected: T,
  number: I,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected equality",
): void {
  expectEq(actual, expected, conv, `${msg} [${number}]`)
}

fun expectNEq<T: frozen>(
  actual: T,
  expected: T,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected inequality",
): void {
  if (inspect(actual) == inspect(expected)) {
    throw SKTest.ExpectationError(msg, conv(expected), conv(actual))
  }
}

fun expectEquals<T: Equality>(
  actual: T,
  expected: T,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected equality",
): void {
  if (actual != expected) {
    throw SKTest.ExpectationError(msg, conv(expected), conv(actual))
  }
}

fun expectEqualsAt<T: Equality, I: Show>(
  actual: T,
  expected: T,
  number: I,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected equality",
): void {
  expectEquals(actual, expected, conv, `${msg} [${number}]`)
}

fun expectNEquals<T: Equality>(
  actual: T,
  expected: T,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected inequality",
): void {
  if (actual == expected) {
    throw SKTest.ExpectationError(msg, conv(expected), conv(actual))
  }
}

fun mute<T>(_t: T): void {
  void
}

class File(font: TrueType.Font) extends SKFS.File

fun main(): void {
  pos = SKFS.newObstack();
  resources = (name) ~>
    name match {
    | "luximr" -> TrueType.parse(SKIP_SKUIFontTestsRes.luximrBin())
    | "luxirr" -> TrueType.parse(SKIP_SKUIFontTestsRes.luxirrBin())
    | "luxisr" -> TrueType.parse(SKIP_SKUIFontTestsRes.luxisrBin())
    | "xab" -> TrueType.parse(SKIP_SKUIFontTestsRes.xabBin())
    | "xdsff" -> TrueType.parse(SKIP_SKUIFontTestsRes.xdsffBin())
    | "xdvso" -> TrueType.parse(SKIP_SKUIFontTestsRes.xdvsoBin())
    | "xtnr" -> TrueType.parse(SKIP_SKUIFontTestsRes.xtnrBin())
    | _ -> invariant_violation(`Unknown resource named ${name}`)
    };
  tests = mutable Map[];
  #forEachFunction (@testr, #function, #functionName) {
    // TODO: Properly handle tests outside of module/suite?
    (testSuite, testName) = #functionName.splitFirst(".");
    if (!tests.containsKey(testSuite)) {
      tests.set(testSuite, mutable Map[])
    };
    tests[testSuite].set(testName, () ~> #function(resources))
  };
  mute(resources);
  #forEachFunction (@test, #function, #functionName) {
    // TODO: Properly handle tests outside of module/suite?
    (testSuite, testName) = #functionName.splitFirst(".");
    if (!tests.containsKey(testSuite)) {
      tests.set(testSuite, mutable Map[])
    };
    tests[testSuite].set(testName, #function)
  };
  fTests = SKFS.destroyObstackWithValue(
    pos,
    List.Cons(unsafe_chill_trust_me(tests), List.Nil()),
  ) match {
  | List.Cons(x, _) -> x
  | _ -> invariant_violation("error")
  };
  SKTest.test_harness(fTests);
}

module end;
