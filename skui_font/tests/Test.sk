module SKUIFontTest;

base class Case uses HasClassName

fun expectEq<T: frozen>(
  actual: T,
  expected: T,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected equality",
): void {
  if (inspect(actual) != inspect(expected)) {
    throw SKTest.ExpectationError(msg, conv(expected), conv(actual))
  }
}

fun expectEqAt<T: frozen, I: Show>(
  actual: T,
  expected: T,
  number: I,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected equality",
): void {
  expectEq(actual, expected, conv, `${msg} [${number}]`)
}

fun expectNEq<T: frozen>(
  actual: T,
  expected: T,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected inequality",
): void {
  if (inspect(actual) == inspect(expected)) {
    throw SKTest.ExpectationError(msg, conv(expected), conv(actual))
  }
}

fun expectEquals<T: Equality>(
  actual: T,
  expected: T,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected equality",
): void {
  if (actual != expected) {
    throw SKTest.ExpectationError(msg, conv(expected), conv(actual))
  }
}

fun expectEqualsAt<T: Equality, I: Show>(
  actual: T,
  expected: T,
  number: I,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected equality",
): void {
  expectEquals(actual, expected, conv, `${msg} [${number}]`)
}

fun expectNEquals<T: Equality>(
  actual: T,
  expected: T,
  conv: T ~> String = v ~> inspect(v).toString(),
  msg: String = "expected inequality",
): void {
  if (actual == expected) {
    throw SKTest.ExpectationError(msg, conv(expected), conv(actual))
  }
}

fun mute<T>(_t: T): void {
  void
}

class File(font: TrueType.Font) extends SKStore.File

fun main(): void {
  pos = SKStore.newObstack();
  p = (fn: () ~> Array<UInt8>) ~> {
    TrueType.parse(fn())
  };
  resources = (name: String) ~> {
    name match {
    | "luximr" -> p(SKIP_SKUIFontTestsRes.luximrBin)
    | "luxirr" -> p(SKIP_SKUIFontTestsRes.luxirrBin)
    | "luxisr" -> p(SKIP_SKUIFontTestsRes.luxisrBin)
    | "xab" -> p(SKIP_SKUIFontTestsRes.xabBin)
    | "xdsff" -> p(SKIP_SKUIFontTestsRes.xdsffBin)
    | "xdvso" -> p(SKIP_SKUIFontTestsRes.xdvsoBin)
    | "xtnr" -> p(SKIP_SKUIFontTestsRes.xtnrBin)
    | _ -> invariant_violation(`Unknown resource named ${name}`)
    };
  };
  tests = mutable Map[];
  #forEachFunction (@testr, #function, #functionName) {
    (testSuite, testName) = #functionName.splitFirst(".");
    if (!tests.containsKey(testSuite)) {
      tests.set(testSuite, mutable Vector[])
    };
    tests[testSuite].push(
      SKTest.Test{name => testName, func => () ~> #function(resources)},
    );
  };
  mute(resources);
  #forEachFunction (@test, #function, #functionName) {
    (testSuite, testName) = #functionName.splitFirst(".");
    if (!tests.containsKey(testSuite)) {
      tests.set(testSuite, mutable Vector[])
    };
    tests[testSuite].push(SKTest.Test{name => testName, func => #function})
  };
  fTests = SKStore.destroyObstackWithValue(
    pos,
    List.Cons(unsafe_chill_trust_me(tests), List.Nil()),
  ).getHead();
  SKTest.test_harness(fTests);
}

module end;
