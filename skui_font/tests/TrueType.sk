module SKUIFontTest;

@testr
fun truetypeParse(r: String ~> TrueType.Font): void {
  Parse(r).run()
}

@testr
fun truetypeName(r: String ~> TrueType.Font): void {
  Name(r).run()
}

@testr
fun truetypeGlyph(r: String ~> TrueType.Font): void {
  Glyph(r).run()
}

@testr
fun truetypeIndex1(r: String ~> TrueType.Font): void {
  runIndex(r("luxisr"), SKUIFontTest.luxisrChars())
}

@testr
fun truetypeIndex2(r: String ~> TrueType.Font): void {
  runIndex(r("xab"), SKUIFontTest.xabChars())
}

@testr
fun truetypeIndex3(r: String ~> TrueType.Font): void {
  runIndex(r("xtnr"), SKUIFontTest.xtnrChars())
}

