module SkuiFwkBuild;

@skui_build__extra_sources
fun extra_sources(env: SkuiBuild.Env): Array<String> {
  path = if (env.isWasm32()) {
    "extra/src/Wasm32.sk"
  } else {
    "extra/src/Host.sk"
  };
  Array[path]
}

module end;

@debug
fun main(): void {
  SkuiBuild.build() match {
  | Failure(err) -> skipExit(err.code)
  | _ -> void
  }
}
