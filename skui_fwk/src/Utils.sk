module SKUI;

fun initSizeManager(
  context: mutable SKStore.Context,
): (
  SKStore.EHandle<SKStore.IID, UiEvent.Size>,
  SKStore.EHandle<SKStore.IID, SKStore.FloatFile>,
) {
  windowHdl = context.makeDir(
    SKStore.IID::keyType,
    UiEvent.Size::type,
    SKStore.DirName::create("/ui/window/"),
  );
  ratioHdl = context.makeDir(
    SKStore.IID::keyType,
    SKStore.FloatFile::type,
    SKStore.DirName::create("/ui/window/ratio/"),
  );
  iWindowHdl = SKStore.toIHandle(windowHdl);
  iRatioHdl = SKStore.toIHandle(ratioHdl);
  context.setGlobal(
    "FWK.Window.Size",
    FWK.Sizer((ctx, wId, w, h, r) ~> {
      iWindowHdl.write(ctx, SKStore.IID(wId), UiEvent.Size(w, h));
      iRatioHdl.write(ctx, SKStore.IID(wId), SKStore.FloatFile(r));
    }),
  );
  context.setGlobal(
    "FWK.Ratio",
    FWK.Ratio((ctx, wId) ~>
      iRatioHdl
        .maybeGetValue(ctx, SKStore.IID(wId))
        .map(v -> v.value)
        .default(1.0)
    ),
  );
  (windowHdl, ratioHdl);
}

fun init(
  context: mutable SKStore.Context,
  wId: Int,
  builder: (mutable SKStore.Context, UiRoot.Storage) ~> Ui.GetterOne<
    Ui.Widget,
    UiRoot.Storage,
  >,
  support: Ui.DrawableSupport,
  inits: Array<mutable SKStore.Context ~> void> = Array[],
): void {
  FWKEnv.init(context, wId);
  context.initFontSupport();
  context.initIconSupport();
  context.initTextSupport(support);
  root = UiRoot.HStorage::create(context, SKStore.DirName::create("/ui/root/"));
  context.setGlobal("FWK.Root", root);
  (windowHdl, _ratioHdl) = initSizeManager(context);
  SystemProperties.init(context);
  Ui.init(context);
  inits.each(i -> i(context));
  getter = builder(context, root);

  FWKPipeline.initPipeline(context, getter, windowHdl, root, support, wId);
  context.setGlobal(
    "SKStore.Updater",
    SKStore.Updater(_ctx ~> FWK.update(uint32(wId))),
  )
}

@export("SKUI_update")
fun update(): void {
  pos = checkObstack();
  SKStore.Context::withoutGc(context ~> context.updateIfRoot());
  cleanObstack(pos);
}

module end;
