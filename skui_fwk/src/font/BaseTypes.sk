module Font;

class Weight private (index: Int) uses Hashable, Orderable, Show {
  const w100: Weight = Weight(0);
  const w200: Weight = Weight(1);
  const w300: Weight = Weight(2);
  const w400: Weight = Weight(3);
  const w500: Weight = Weight(4);
  const w600: Weight = Weight(5);
  const w700: Weight = Weight(6);
  const w800: Weight = Weight(7);
  const w900: Weight = Weight(8);

  const thin: Weight = Weight::w100;
  const extralight: Weight = Weight::w200;
  const light: Weight = Weight::w300;
  const normal: Weight = Weight::w400;
  const medium: Weight = Weight::w500;
  const semibold: Weight = Weight::w600;
  const bold: Weight = Weight::w700;
  const extrabold: Weight = Weight::w800;
  const black: Weight = Weight::w900;

  fun compare(other: Weight): Order {
    this.index.compare(other.index)
  }

  fun isBold(): Bool {
    this.index > 3
  }

  static fun fromIndex(index: Int): Weight {
    index match {
    | 0 -> Weight::w100
    | 1 -> Weight::w200
    | 2 -> Weight::w300
    | 3 -> Weight::w400
    | 4 -> Weight::w500
    | 5 -> Weight::w600
    | 6 -> Weight::w700
    | 7 -> Weight::w800
    | 8 -> Weight::w900
    | _ ->
      if (index < 0) {
        Weight::w100
      } else {
        Weight::w900
      }
    }
  }

  static fun fromWeight(weight: Int): Weight {
    static::fromIndex(Math.clamp(weight / 100, 1, 9) - 1)
  }

  fun toWeight(): Int {
    (this.index + 1) * 100
  }

  fun incr(): Int {
    this.index - 3;
  }

  fun previous(): ?Weight {
    if (this.index > 0) {
      Some(Weight(this.index - 1))
    } else {
      None()
    }
  }

  fun toString(): String {
    this.index match {
    | 0 -> "thin"
    | 1 -> "extralight"
    | 2 -> "light"
    | 3 -> "normal"
    | 4 -> "medium"
    | 5 -> "semibold"
    | 6 -> "bold"
    | 7 -> "extrabold"
    | 8 -> "black"
    | _ ->
      if (this.index < 0) {
        "thin"
      } else {
        "black"
      }
    }
  }

  /**
   * Linearly interpolates between two font weights.
   * Rather than using fractional weights, the interpolation rounds to the nearest weight.
   * If both a and b are None(), then this method will return None(). Otherwise, any None() values for a or b are interpreted as equivalent to normal (also known as w400).
   * The t argument represents position on the timeline, with 0.0 meaning that the interpolation has not started, returning a (or something equivalent to a), 1.0 meaning that the interpolation has finished, returning b (or something equivalent to b), and values in between meaning that the interpolation is at the relevant point on the timeline between a and b. The interpolation can be extrapolated beyond 0.0 and 1.0, so negative values and values greater than 1.0 are valid (and can easily be generated by curves such as Curves.elasticInOut). The result is clamped to the range w100–w900.
   * Values for t are usually obtained from an Animation<double>, such as an AnimationController.
   */
  static fun lerp(optA: ?Weight, optB: ?Weight, t: Float): ?Weight {
    if (!optA.isSome() && !optB.isSome()) {
      None()
    } else {
      index = Math.clamp(
        Math.round(
          Math.lerp(
            optA.default(Weight::normal).index,
            optB.default(Weight::normal).index,
            t,
          ),
        ).toInt(),
        0,
        8,
      );
      Some(static::fromIndex(index))
    }
  }
}

/**
 * Whether to slant the glyphs in the font
 */
base class Slant() uses Hashable, Orderable, Show {
  children =
  /**
   * Use glyphs designed for slanting
   */
  | Italic()
  /**
   * Use glyphs designed for slanting
   */
  | Oblique()
  /**
   * Use the upright glyphs
   */
  | Normal()

  static fun fromName(name: String): Slant {
    name match {
    | "oblique" -> Oblique()
    | "italic" -> Italic()
    | _ -> Normal()
    }
  }

  fun compare(other: Slant): Order {
    this.code().compare(other.code())
  }

  fun code(): Int {
    this match {
    | Normal() -> 0
    | Italic() -> 1
    | Oblique() -> 2
    }
  }

  fun previous(): ?Slant {
    this match {
    | Normal() -> None()
    | Italic() -> Some(Normal())
    | Oblique() -> Some(Italic())
    }
  }

  fun toString(): String {
    this match {
    | Oblique() -> "oblique"
    | Italic() -> "italic"
    | Normal() -> "normal"
    }
  }

  static fun fromCode(code: Int): Slant {
    code match {
    | 1 -> Italic()
    | 2 -> Oblique()
    | 0
    | _ ->
      Normal()
    }
  }
}

class TypefaceInfo(
  family: String,
  weight: Weight,
  slant: Slant,
) extends SKStore.Key {
  static fun create(
    family: String,
    weight: Weight = Weight::normal,
    slant: Slant = Normal(),
  ): this {
    TypefaceInfo(family, weight, slant)
  }

  fun toString(): String {
    `${this.family}:${this.slant}:${this.weight}`;
  }

  // TODO select familly lower/upper/normalized
  fun select(sources: Array<FaceSource>): ?FaceSource {
    family = sources.filter(a -> a.typeface.family == this.family);
    if (family.isEmpty()) {
      return None();
    };
    tested = mutable Set<Slant>[];
    this.selectSlant(family, this.slant, tested);
  }

  fun default(sources: Array<FaceSource>): FaceSource {
    defaultSources = sources.filter(a -> a.default);
    invariant(
      !defaultSources.isEmpty(),
      "At least one default FaceSource must be defined",
    );
    tested = mutable Set<Slant>[];
    this.selectSlant(defaultSources, this.slant, tested).fromSome();
  }

  private fun selectSlant(
    sources: Array<FaceSource>,
    slant: Slant,
    tested: mutable Set<Slant>,
  ): ?FaceSource {
    tested.add(slant);
    availables = sources.filter(fs -> fs.typeface.slant == slant);
    if (!availables.isEmpty()) {
      this.selectWeight(availables, this.weight);
    } else if (slant == Italic()) {
      if (!tested.contains(Oblique())) {
        this.selectSlant(sources, Oblique(), tested)
      } else {
        this.selectSlant(sources, Normal(), tested)
      }
    } else if (slant == Oblique()) {
      if (!tested.contains(Italic())) {
        this.selectSlant(sources, Italic(), tested)
      } else {
        this.selectSlant(sources, Normal(), tested)
      }
    } else {
      invariant(tested.size() < 3, "At least one slant shall be present");
      if (!tested.contains(Italic())) {
        this.selectSlant(sources, Italic(), tested)
      } else {
        this.selectSlant(sources, Oblique(), tested)
      }
    }
  }

  private fun selectWeight(
    sources: Array<FaceSource>,
    weight: Weight,
  ): ?FaceSource {
    if (sources.isEmpty()) {
      return None();
    };
    sorted = sources.sortedFor(fs ~> fs.typeface.weight);
    optPrevious: ?FaceSource = None();
    optNext: ?FaceSource = None();
    for (fs in sorted) {
      if (fs.typeface.weight == weight) {
        return Some(fs);
      } else if (fs.typeface.weight < weight) {
        !optPrevious = Some(fs);
      } else {
        !optNext = Some(fs);
        break void;
      }
    };
    optPrevious match {
    | Some(previous) ->
      optNext match {
      | Some(next) ->
        if (
          weight.index - previous.typeface.weight.index <
          next.typeface.weight.index - weight.index
        ) {
          optPrevious
        } else {
          optNext
        }
      | _ -> optPrevious
      }
    | _ -> optNext
    }
  }
}

class FaceSource{
  typeface: Font.TypefaceInfo,
  source: String,
  default: Bool = false,
} extends SKStore.File uses Equality {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ FaceSource _ -> x
    | _ -> invariant_violation("Must be Font.FaceSource")
    }
  }

  static fun fromJSON(data: JSON.Value): FaceSource {
    jso = data.expectObject();
    family = jso["family"].expectString();
    weight = Font.Weight::fromWeight(jso["weight"].expectInt());
    slant = Font.Slant::fromName(jso["slant"].expectString());
    source = jso["src"].expectString();
    default = jso.maybeGet("main").map(d -> d.expectBool()).default(false);
    FaceSource{
      typeface => Font.TypefaceInfo::create(family, weight, slant),
      source,
      default,
    }
  }
}

class FaceSources(value: Array<FaceSource>) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ FaceSources _ -> x
    | _ -> invariant_violation("Must be Font.FaceSources")
    }
  }

  static fun parse(json: String): FaceSources {
    static::fromJSON(JSON.decode(json))
  }

  static fun fromJSON(jsv: JSON.Value): FaceSources {
    jsonArray = jsv.expectArray();
    FaceSources(
      jsonArray.value.map(jsv -> FaceSource::fromJSON(jsv)).toArray(),
    );
  }
}

class TypeFace(typeface: TypefaceInfo, face: Face) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ TypeFace _ -> x
    | _ -> invariant_violation("Must be Font.TypeFace")
    }
  }

  fun height(): Float {
    this.face.height();
  }

  fun metrics(): (Float, Float) {
    (this.face.metrics.ascent.toFloat(), this.face.metrics.descent.toFloat())
  }
}

class FaceID(
  typeface: TypefaceInfo,
  size: Float,
  dpi: Float,
  hinting: Font.Hinting,
) extends SKStore.Key {
  static fun create(
    typeface: TypefaceInfo,
    size: Float,
    dpi: Float = 96.0,
    hinting: Font.Hinting = Font.HintingNone(),
  ): this {
    FaceID(typeface, size, dpi, hinting)
  }

  fun isNotBold(): Bool {
    !this.typeface.weight.isBold()
  }

  fun toString(): String {
    `${this.typeface}:${this.hinting}:${this.size}:${this.dpi}`;
  }
}

class GlyphID(fid: FaceID, char: Char, pxRange: Int = 8) extends SKStore.Key {
  //
  static fun create(fid: FaceID, char: Char, pxRange: Int = 8): this {
    GlyphID(fid, char, pxRange);
  }

  fun scale(s: Float): GlyphID {
    !this.fid.size = this.fid.size * s;
    this
  }

  fun compare(other: SKStore.Key): Order {
    other match {
    | oid @ GlyphID _ ->
      cOrder = this.char.compare(oid.char);
      if (cOrder == EQ()) {
        fidOrder = this.fid.compare(oid.fid);
        if (fidOrder == EQ()) {
          this.pxRange.compare(oid.pxRange);
        } else {
          fidOrder
        }
      } else {
        cOrder
      }
    | _ -> this.getClassName().compare(other.getClassName())
    }
  }

  fun toString(): String {
    `${this.fid}:${this.char}:${this.pxRange}`;
  }
}

class Msdf(
  image: Ui.Image,
  conv: Geometry.Rect ~> Geometry.Rect,
) extends SKStore.File {
  //
  static fun make(
    _char: Char,
    info: (Ui.Image, (Geometry.Rect, Float) ~> Geometry.Rect),
    scale: Float = 1.0,
  ): this {
    static(info.i0, r ~> info.i1(r, scale))
  }
}

class GlyphFile(optFace: ?Face, glyph: Glyph) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ GlyphFile _ -> x
    | _ -> invariant_violation("Must be Font.GlyphFile")
    }
  }

  fun getKern(optPrevious: ?Char = None()): Float {
    optPrevious
      .flatMap(previous ->
        this.optFace.map(face ->
          face.getKern(previous, this.glyph.index).toFloat()
        )
      )
      .default(0.0);
  }

  fun ascent(): Float {
    this.optFace.map(face -> face.metrics.ascent.toFloat()).default(0.0);
  }

  fun descent(): Float {
    this.optFace.map(face -> face.metrics.descent.toFloat()).default(0.0);
  }

  fun width(): Float {
    this.glyph.width();
  }

  fun height(): Float {
    this.optFace.map(face -> face.height()).default(this.glyph.height());
  }

  fun topLeft(): Geometry.Offset {
    this.glyph.topLeft()
  }

  fun offset(kern: Float): Geometry.Offset {
    this.topLeft().translate(kern, this.ascent())
  }

  fun size(): Geometry.Size {
    Geometry.Size(this.width(), this.height())
  }

  fun imageSize(): (Int, Int) {
    (this.glyph.imageWidth(), this.glyph.imageHeight())
  }

  static fun default(optFace: ?Font.Face, size: Float): GlyphFile {
    height = optFace
      .map(face -> face.metrics.height())
      .default(Ui.Pt(size).pixels());
    rect = Geometry.Rect::fromOffsetSize(
      Geometry.Offset::zero,
      Geometry.Size(height / 2.0, height),
    );
    GlyphFile(
      None(),
      Font.Glyph{
        index => -1,
        optPath => Some(Shape.Path::strokeRectangle(rect, 2.0)),
        bounds => Bounds{
          bounds => rect.toFixed(),
          advance => Fixed.Int26_6::fromFloat((height / 2.0) + 2.0),
        },
        dr => rect.toRectangle(),
      },
    );
  }
}

fun predefined(): SortedMap<TypefaceInfo, String> {
  p = SortedMap<TypefaceInfo, String>::create();
  !p = Roboto.fill(p);
  fillNotoMono(p)
}

module end;
