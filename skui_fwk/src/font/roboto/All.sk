module Roboto;

fun fill(
  p: SortedMap<Font.TypefaceInfo, String>,
): SortedMap<Font.TypefaceInfo, String> {
  roboto = "Roboto";
  thinB64 = Roboto.thinB64();
  thinItalicB64 = Roboto.thinItalicB64();
  // Roboto thin
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::thin, Font.Normal()),
    thinB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::thin, Font.Italic()),
    thinItalicB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::thin, Font.Oblique()),
    thinItalicB64,
  );
  // Roboto extra light
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::extralight, Font.Normal()),
    thinB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::extralight, Font.Italic()),
    thinItalicB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::extralight, Font.Oblique()),
    thinItalicB64,
  );
  // Roboto light
  lightB64 = Roboto.lightB64();
  lightItalicB64 = Roboto.lightItalicB64();
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::light, Font.Normal()),
    lightB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::light, Font.Italic()),
    lightItalicB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::light, Font.Oblique()),
    lightItalicB64,
  );
  // Roboto normal
  regularB64 = Roboto.regularB64();
  italicB64 = Roboto.italicB64();
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::normal, Font.Normal()),
    regularB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::normal, Font.Italic()),
    italicB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::normal, Font.Oblique()),
    italicB64,
  );
  // Roboto medium
  mediumB64 = Roboto.mediumB64();
  mediumItalicB64 = Roboto.mediumItalicB64();
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::medium, Font.Normal()),
    mediumB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::medium, Font.Italic()),
    mediumItalicB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::medium, Font.Oblique()),
    mediumItalicB64,
  );
  // Roboto semi bold
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::semibold, Font.Normal()),
    mediumB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::semibold, Font.Italic()),
    mediumItalicB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::semibold, Font.Oblique()),
    mediumItalicB64,
  );
  // Roboto bold
  boldB64 = Roboto.boldB64();
  boldItalicB64 = Roboto.boldItalicB64();
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::bold, Font.Normal()),
    boldB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::bold, Font.Italic()),
    boldItalicB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::bold, Font.Oblique()),
    boldItalicB64,
  );
  // Roboto extra bold
  blackB64 = Roboto.blackB64();
  blackItalicB64 = Roboto.blackItalicB64();
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::extrabold, Font.Normal()),
    blackB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::extrabold, Font.Italic()),
    blackItalicB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::extrabold, Font.Oblique()),
    blackItalicB64,
  );
  // Roboto black
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::black, Font.Normal()),
    blackB64,
  );
  !p = p.add(
    Font.TypefaceInfo(roboto, Font.Weight::black, Font.Italic()),
    blackItalicB64,
  );
  p.add(
    Font.TypefaceInfo(roboto, Font.Weight::black, Font.Oblique()),
    blackItalicB64,
  );
}

module end;
