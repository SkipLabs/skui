module FWK;

trait NoFocusHandler {
  fun checkFocusHandlers(
    _context: mutable SKFS.Context,
    _nodeInfo: Ui.Getter<Ui.NodeInfo>,
    handlers: readonly Vector<FWK.FocusHandler>,
  ): Vector<FWK.FocusHandler> {
    handlers.chill()
  }
}

trait Shortcuts {
  protected fun getCategory(): String;
  fun getIdentifier(): Ui.Path;

  protected fun getShortcuts(
    context: mutable SKFS.Context,
  ): Array<ShortcutAction>;

  protected fun beforeShortcuts(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
  ): Bool;

  protected fun afterShortcuts(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
  ): Bool;

  protected fun onKeys(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
  ): Bool {
    consumed = this.beforeShortcuts(context, keys);
    if (!consumed) {
      shortCuts = this.getShortcuts(context);
      for (info in shortCuts) {
        shortCut = FWKKeys.getShortcut(
          context,
          info.name,
          this.getCategory(),
          this.getIdentifier().toString(),
        ).default(info.shortcut);
        for (stroke in shortCut.keyStrokes) {
          if (stroke.test(keys, context.tick)) {
            !consumed = this.performAction(
              context,
              info.name,
              info.action,
              stroke.asRepeat(keys),
            );
            break void;
          }
        }
      }
    };
    if (!consumed) {
      !consumed = this.afterShortcuts(context, keys);
    };
    consumed
  }

  private fun performAction(
    context: mutable SKFS.Context,
    _name: String,
    action: Action,
    optRepeat: ?FWK.Repeat,
  ): Bool {
    action match {
    | Standard(fn) ->
      fn(context);
      true
    | Repeatable(fn) ->
      fn(context, optRepeat);
      true
    | Skipable(fn) -> fn(context)
    }
  }
}

trait OnlyShortcuts extends Shortcuts {
  protected fun beforeShortcuts(
    _context: mutable SKFS.Context,
    _keys: UiEvent.KeysFile,
  ): Bool {
    false
  }

  protected fun afterShortcuts(
    _context: mutable SKFS.Context,
    _keys: UiEvent.KeysFile,
  ): Bool {
    false
  }
}

trait LeafFH {
  fun getIdentifier(): Ui.Path;

  protected fun checkGotoNext(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
  ): Bool;

  protected fun checkGotoPrevious(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
  ): Bool;

  protected fun onKeys(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
  ): Bool;

  fun isGotoNext(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
    source: Ui.Path,
  ): ?Bool {
    if (source == this.getIdentifier()) {
      Some(this.checkGotoNext(context, keys))
    } else {
      None()
    }
  }

  fun isGotoPrevious(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
    source: Ui.Path,
  ): ?Bool {
    if (source == this.getIdentifier()) {
      Some(this.checkGotoPrevious(context, keys))
    } else {
      None()
    }
  }

  fun manage(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
    source: Ui.Path,
  ): Bool {
    if (source != this.getIdentifier()) {
      return false;
    };
    this.onKeys(context, keys);
  }

  fun fillSources(path: mutable FWK.SSet<Ui.Path>): void {
    path.set(this.getIdentifier())
  }

  fun getSource(sources: SortedSet<Ui.Path>): ?Ui.Path {
    identifier = this.getIdentifier();
    if (sources.contains(identifier)) {
      Some(identifier)
    } else {
      None()
    }
  }

  fun hasSource(source: Ui.Path): Bool {
    this.getIdentifier() == source;
  }
}

module end;
