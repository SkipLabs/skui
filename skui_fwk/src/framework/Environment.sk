module FWKEnv;

const propKey: SKStore.IID = SKStore.IID(0);

const statePath: SKStore.DirName = SKStore.DirName::create(
  "/ui/system/env/state/",
);

const envHandle: SKStore.IHandle<
  SKStore.DirName,
  SKStore.BoolFile,
> = SKStore.IHandle(
  SKStore.DirName::keyType,
  SKStore.BoolFile::type,
  statePath,
);

fun init(context: mutable SKStore.Context, rootId: Int): void {
  context.setGlobal("FWKEnv.RootWindow", SKStore.IntFile(rootId));
  _ = context.makeDir(
    SKStore.DirName::keyType,
    SKStore.BoolFile::type,
    statePath,
    Array[],
  );
}

fun declare(context: mutable SKStore.Context, dirName: SKStore.DirName): void {
  envHandle.write(context, dirName, SKStore.BoolFile(true));
}

fun exists(
  context: mutable SKStore.Context,
  dirName: SKStore.DirName,
  isUntracked: Bool = false,
): Bool {
  envHandle.getBool(context, dirName, isUntracked)
}

fun getRootId(context: mutable SKStore.Context): ?UInt32 {
  context.getGlobal("FWKEnv.RootWindow").map(SKStore.IntFile::type).map(f ~>
    uint32(f.value)
  )
}

module end;
