module FWKEnv;

const propKey: SKFS.IID = SKFS.IID(0);

const statePath: SKFS.DirName = SKFS.DirName::create("/ui/system/env/state/");

const envHandle: SKFS.IHandle<SKFS.BoolFile> = SKFS.IHandle(
  SKFS.FileConverter(SKFS.BoolFile::fromFile),
  statePath,
);

fun init(context: mutable SKFS.Context, rootId: Int): void {
  context.setGlobal("FWKEnv.RootWindow", SKFS.IntFile(rootId));
  _ = context.makeDir(SKFS.BoolFile::fromFile, statePath, Array[]);
}

fun declare(context: mutable SKFS.Context, dirName: SKFS.DirName): void {
  envHandle.write(context, dirName, SKFS.BoolFile(true));
}

fun exists(
  context: mutable SKFS.Context,
  dirName: SKFS.DirName,
  isUntracked: Bool = false,
): Bool {
  envHandle.getBool(context, dirName, isUntracked)
}

fun getRootId(context: mutable SKFS.Context): ?UInt32 {
  context.getGlobal("FWKEnv.RootWindow").map(SKFS.IntFile::fromFile).map(f ~>
    uint32(f.value)
  )
}

module end;
