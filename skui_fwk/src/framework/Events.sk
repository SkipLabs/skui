module FWK;

class KeyDown(symbol: String, tick: SKFS.Tick) {}

class MouseDown(button: Button, tick: SKFS.Tick, optOffset: ?Geometry.Offset) {}

base class Repeat(
  ctrl: Bool,
  shift: Bool,
  alt: Bool,
) extends SKUIMessage.Repeat, JSONValue {
  children =
  | KeysRepeat(keys: Array<KeyDown>)
  | MouseRepeat(buttons: Array<MouseDown>)

  fun isRepeating(context: mutable SKFS.Context): Bool
  | KeysRepeat(keys, ctrl, shift, alt) ->
    keysFile = FWKKeys.getKeys(context);
    modifier = UiEvent.Modifier(ctrl, shift, alt);
    (valid, _count) = modifier.test(keysFile, context.tick);
    if (valid) {
      !valid = for (keyDown in keys) {
        if (
          !keysFile
            .getForSymbol(keyDown.symbol)
            .map(key ->
              (key.state.isPressed(context.tick) ||
                key.state.isDown(context.tick)) &&
                key.state.tick == keyDown.tick
            )
            .default(false)
        ) {
          break false
        }
      } else {
        true
      }
    };
    valid
  | MouseRepeat(buttons, ctrl, shift, alt) ->
    keysFile = FWKKeys.getKeys(context);
    modifier = UiEvent.Modifier(ctrl, shift, alt);
    (valid, _count) = modifier.test(keysFile, context.tick);
    if (valid) {
      mouseFile = FWKMouse.getMouse(context);
      !valid = for (button in buttons) {
        if (
          button.button match {
          | Primary() -> !mouseFile.mouse.primaryButton.isRepeating(button)
          | Middle() -> !mouseFile.mouse.middleButton.isRepeating(button)
          | Secondary() -> !mouseFile.mouse.secondaryButton.isRepeating(button)
          | WheelUp()
          | WheelDown()
          | Unknown _ ->
            true
          }
        ) {
          break false
        }
      } else {
        true
      }
    };
    valid
}

base class Button uses Equality {
  children =
  | Primary()
  | Middle()
  | Secondary()
  | WheelUp()
  | WheelDown()
  | Unknown(code: Int)
}

class PrimaryDown(offset: Geometry.Offset) {
  fun test(toTest: UiEvent.MouseFile, tick: SKFS.Tick): Bool {
    toTest.offset().like(this.offset) && toTest.isPrimaryDown(tick)
  }
}

fun env_violation(): _ {
  invariant_violation("FWK.Environment must be defined")
}

fun isShiftDown(
  context: mutable SKFS.Context,
  isUntracked: Bool = false,
): Bool {
  FWKKeys.isShiftDown(context, isUntracked)
}

fun isControlDown(
  context: mutable SKFS.Context,
  isUntracked: Bool = false,
): Bool {
  FWKKeys.isControlDown(context, isUntracked)
}

fun isAltDown(context: mutable SKFS.Context, isUntracked: Bool = false): Bool {
  FWKKeys.isAltDown(context, isUntracked)
}

fun getModifier(
  context: mutable SKFS.Context,
  isUntracked: Bool = false,
): UiEvent.Modifier {
  UiEvent.Modifier(
    isControlDown(context, isUntracked),
    isShiftDown(context, isUntracked),
    isAltDown(context, isUntracked),
  )
}

fun isScrolling(context: mutable SKFS.Context): Bool {
  FWKMouse.getMouse(context).isScrolling()
}

class Sizer(
  value: (mutable SKFS.Context, Int, Int, Int, Float) ~> void,
) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Sizer _ -> x
    | _ -> SKFS.cast_violation("FWK.Sizer", obj)
    }
  }
}

class Ratio(fn: (mutable SKFS.Context, Int) ~> Float) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Ratio _ -> x
    | _ -> SKFS.cast_violation("FWK.Ratio", obj)
    }
  }
}

module end;
