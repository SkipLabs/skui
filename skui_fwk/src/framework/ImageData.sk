module FWK;

class InvalidImageException(message: String) extends Exception {
  fun getMessage(): String {
    this.message;
  }
}

value class ExtSize(w: UInt32, h: UInt32) {
  fun toTuple(): (UInt32, UInt32) {
    (this.w, this.h)
  }
}

class ImageSupplier(
  private eptr: SKFS.ExternalPointer,
) extends Ui.ImageSupplier {
  //
  static fun make(id: UInt32): this {
    static(SKFS.ExternalPointer::create(id, deleteImageSupplier))
  }

  fun getSize(): (UInt32, UInt32) {
    natImageSize(this.eptr.value).toTuple();
  }

  fun getImage(
    _context: mutable SKFS.Context,
    width: UInt32,
    height: UInt32,
  ): ?Ui.Image {
    natImageData(this.eptr.value, width, height)
  }
}

@cpp_extern("SKIP_FWK_getImageSize")
private native fun natImageSize(actor: UInt32): ExtSize;

@cpp_extern("SKIP_FWK_getImageData")
private native fun natImageData(
  actor: UInt32,
  width: UInt32,
  height: UInt32,
): ?Ui.Image;

@cpp_extern("SKIP_FWK_deleteImageSupplier")
private native fun deleteImageSupplier(actor: UInt32): void;

class ImageLink(ref: String) extends JSONValue {
  fun toJSON(): JSON.Value {
    JSON.Object(
      .Map[
        "__class" => JSON.String(this.getClassName()),
        "ref" => JSON.String(this.ref),
      ],
    )
  }

  static fun fromJSON(jsv: JSON.Value): ImageLink {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "FWK.ImageLink" -> ImageLink(jso.getString("ref"))
    | _ -> invariant_violation(`Invalid json object ${cl} for FWK.ImageLink`)
    }
  }
}

@cpp_export("SKIP_FWK_createPixArray")
fun createPixArray(size: Int32): mutable Array<Ui.Pix> {
  Array<Ui.Pix>::mfill(size.toInt(), Ui.Pix::transparent);
}

@cpp_export("SKIP_FWK_getPixArraySize")
fun getPixArraySize(array: Array<Ui.Pix>): Int32 {
  Int32::truncate(array.size())
}

@cpp_export("SKIP_FWK_setPix")
fun setPix(
  array: mutable Array<Ui.Pix>,
  index: Int32,
  red: UInt8,
  green: UInt8,
  blue: UInt8,
  alpha: UInt8,
): void {
  array.set(index.toInt(), Ui.Pix(red, green, blue, alpha));
}

@cpp_export("SKIP_FWK_chillPixArray")
fun chillPixArray(array: mutable Array<Ui.Pix>): Array<Ui.Pix> {
  array.chill();
}

@cpp_export("SKIP_FWK_createImage")
fun createImage(array: Array<Ui.Pix>, width: UInt32, height: UInt32): Ui.Image {
  Ui.Image(array, width.toInt(), height.toInt())
}

@cpp_extern("SKIP_FWK_loadInternalImage")
native fun loadInternalImage(
  wId: UInt32,
  base64: String,
  path: String,
  key: String,
): void;

@cpp_extern("SKIP_FWK_resizeImage")
native fun resizeImage(
  wId: UInt32,
  data: Array<Ui.Pix>,
  srcWidth: UInt32,
  srcHeight: UInt32,
  width: UInt32,
  height: UInt32,
  path: String,
  key: String,
): void;

module end;
