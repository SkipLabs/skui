module FWKKeys;

const statePath: SKFS.DirName = SKFS.DirName::create("/ui/system/keys/state/");
const modifiersPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/system/keys/modifiers/",
);

const propKey: SKFS.IID = SKFS.IID(0);
const ctrlKey: SKFS.IID = SKFS.IID(0);
const shiftKey: SKFS.IID = SKFS.IID(1);
const altKey: SKFS.IID = SKFS.IID(2);

const kfHandle: SKFS.IHandle<UiEvent.KeysFile> = SKFS.IHandle(
  SKFS.FileConverter(UiEvent.KeysFile::fromFile),
  statePath,
);

const mdHandle: SKFS.EHandle<SKFS.BoolFile> = SKFS.EHandle(
  SKFS.BoolFile::fromFile,
  modifiersPath,
);

base class Command extends FWKMessage.Command {
  children =
  | Next()

  fun toJSON(): JSON.Value
  | KeyPressed(code, symbol, optKeyValue, locks, timeStamp, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "code" => JSON.String(code),
        "symbol" => JSON.String(symbol),
        "keyValue" => optKeyValue.map(v -> JSON.String(v)).default(JSON.Null()),
        "locks" => locks.toJSON(),
        "timeStamp" => timeStamp.toJSON(),
        "tick" => JSON.IntNumber(tick.value),
      ].filter((_k, v) -> !v.isNull()),
    )
  | KeyReleased(code, timeStamp, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "code" => JSON.String(code),
        "timeStamp" => timeStamp.toJSON(),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )
  | Clear(timeStamp, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "timeStamp" => timeStamp.toJSON(),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )
  | Next() -> JSON.Object(Map["__class" => JSON.String(this.getClassName())])

  static fun fromJSON(jsv: JSON.Value): Command {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "FWKKeys.Next" -> Next()
    | "FWKKeys.KeyPressed" ->
      KeyPressed(
        jso.getString("code"),
        jso.getString("symbol"),
        jso.maybeGetString("keyValue"),
        UiEvent.Locks::fromJSON(jso.get("locks")),
        System.TimeStamp::fromJSON(jso.get("timeStamp")),
        SKFS.Tick(jso.getInt("tick")),
      )
    | "FWKKeys.KeyReleased" ->
      KeyReleased(
        jso.getString("code"),
        System.TimeStamp::fromJSON(jso.get("timeStamp")),
        SKFS.Tick(jso.getInt("tick")),
      )
    | "FWKKeys.Clear" ->
      Clear(
        System.TimeStamp::fromJSON(jso.get("timeStamp")),
        SKFS.Tick(jso.getInt("tick")),
      )
    | _ -> invariant_violation(`Invalid json object ${cl} for FWKKeys.Command`)
    }
  }
}

base class Event(timeStamp: System.TimeStamp, tick: SKFS.Tick) extends Command {
  fun compute(keysFile: UiEvent.KeysFile, tick: SKFS.Tick): UiEvent.KeysFile;
}

base class Shortcut {
  children =
  | Default()
  | NotDefault()
  | Specified(text: Text)
}

fun getShortcut(
  _context: mutable SKFS.Context,
  _action: String,
  _category: String,
  _identifier: String,
): ?FWK.Shortcut {
  None()
}

fun getMenuShortcut(
  _context: mutable SKFS.Context,
  _action: String,
  _category: String,
  _identifier: String,
): Shortcut {
  Default()
}

class KeyPressed(
  code: String,
  symbol: String,
  optKeyValue: ?String,
  locks: UiEvent.Locks,
) extends Event {
  fun compute(keysFile: UiEvent.KeysFile, tick: SKFS.Tick): UiEvent.KeysFile {
    nKeysFile = keysFile;
    optKeyValue = this.optKeyValue;
    if (
      nKeysFile.isAltDown(tick) &&
      nKeysFile.isControlDown(tick) &&
      optKeyValue == Some("è")
    ) {
      !optKeyValue = Some("`")
    } else if (
      nKeysFile.isAltDown(tick) &&
      nKeysFile.isControlDown(tick) &&
      optKeyValue == Some("é")
    ) {
      !optKeyValue = Some("~")
    };
    present = false;
    keys = nKeysFile.keys
      .map(key ->
        if (key.code == this.code) {
          !present = true;
          UiEvent.Key(
            key.code,
            key.info,
            key.state.derive(true, this.timeStamp, tick),
          )
        } else {
          key.next()
        }
      )
      .filter(key -> !key.state.isUp(tick));
    !nKeysFile.keys = if (!present) {
      keyInfo = UiEvent.KeyInfo::fromCodeAndValue(this.symbol, optKeyValue);
      Arrays.add(
        keys,
        UiEvent.Key(
          this.code,
          keyInfo,
          UiEvent.KeyPressed(this.timeStamp, tick),
        ),
      );
    } else {
      keys
    };
    this.locks.optCapsLock.each(capsLock ->
      capsLock match {
      | UiEvent.Strict(value) -> !nKeysFile.capsLock = value
      | UiEvent.Toggle() -> !nKeysFile.capsLock = !nKeysFile.capsLock
      }
    );
    this.locks.optNumLock.each(numLock ->
      numLock match {
      | UiEvent.Strict(value) -> !nKeysFile.numLock = value
      | UiEvent.Toggle() -> !nKeysFile.numLock = !nKeysFile.numLock
      }
    );
    this.locks.optScrollLock.each(scrollLock ->
      scrollLock match {
      | UiEvent.Strict(value) -> !nKeysFile.scrollLock = value
      | UiEvent.Toggle() -> !nKeysFile.scrollLock = !nKeysFile.scrollLock
      }
    );
    if (this.code == UiEvent.KeyInfo::insert) {
      !nKeysFile.insert = !nKeysFile.insert;
    };
    nKeysFile
  }
}

class KeyReleased(code: String) extends Event {
  fun compute(keysFile: UiEvent.KeysFile, tick: SKFS.Tick): UiEvent.KeysFile {
    nKeysFile = keysFile;
    !nKeysFile.keys = nKeysFile.keys
      .map(key -> {
        if (key.code == this.code) {
          UiEvent.Key(
            key.code,
            key.info,
            key.state.derive(false, this.timeStamp, tick),
          )
        } else {
          key.next()
        }
      })
      .filter(key -> !key.state.isUp(tick));
    nKeysFile
  }
}

class Clear() extends Event {
  fun compute(keysFile: UiEvent.KeysFile, _tick: SKFS.Tick): UiEvent.KeysFile {
    nKeysFile = keysFile;
    !nKeysFile.keys = Array[];
    nKeysFile
  }
}

fun init(context: mutable SKFS.Context): void {
  context.registerMessageSupport("system", "keys", Messages());
}

fun emit(context: mutable SKFS.Context, command: Command): void {
  FWKMessage.emit(context, "system", "keys", command)
}

fun getKeys(
  context: mutable SKFS.Context,
  isUntracked: Bool = false,
): UiEvent.KeysFile {
  kfHandle.getValue(context, propKey, isUntracked);
}

fun isControlDown(
  context: mutable SKFS.Context,
  isUntracked: Bool = false,
): Bool {
  mdHandle.getBool(context, ctrlKey, isUntracked);
}

fun isShiftDown(
  context: mutable SKFS.Context,
  isUntracked: Bool = false,
): Bool {
  mdHandle.getBool(context, shiftKey, isUntracked);
}

fun isAltDown(context: mutable SKFS.Context, isUntracked: Bool = false): Bool {
  mdHandle.getBool(context, altKey, isUntracked);
}

class Messages()
  extends FWKMessage.Support
  uses FWKMessage.WithUpdate<Command> {
  fun init(context: mutable SKFS.Context): void {
    _ = context
      .makeDir(
        UiEvent.KeysFile::fromFile,
        statePath,
        Array[(propKey, UiEvent.KeysFile(Array[], false, false, false, false))],
      )
      .contextWriterKeyMap(
        SKFS.BoolFile::fromFile,
        context,
        modifiersPath,
        (ctx, writer, _, file) ~> {
          ctrlDown = file.isControlDown(ctx.tick);
          shiftDown = file.isShiftDown(ctx.tick);
          altDown = file.isAltDown(ctx.tick);
          writer.write(ctrlKey, SKFS.BoolFile(ctrlDown));
          writer.write(shiftKey, SKFS.BoolFile(shiftDown));
          writer.write(altKey, SKFS.BoolFile(altDown));
        },
      )
  }

  protected fun convert(message: JSON.Value): Command {
    Command::fromJSON(message)
  }

  protected fun convertCmd(command: FWKMessage.Command): Command {
    command as Command _;
  }

  protected fun execute(
    context: mutable SKFS.Context,
    _name: String,
    _scope: String,
    command: Command,
  ): void {
    execute(context, command)
  }
}

fun execute(context: mutable SKFS.Context, command: Command): void {
  keysFile = kfHandle.get(context, propKey);
  command match {
  | Next() -> kfHandle.write(context, propKey, keysFile.next())
  | event @ Event _ ->
    kfHandle.write(context, propKey, event.compute(keysFile, context.tick))
  }
}

fun check(
  context: mutable SKFS.Context,
  altKey: Bool,
  ctrlKey: Bool,
  shiftKey: Bool,
  _metaKey: Bool,
): void {
  keysFile = kfHandle.getValue(context, propKey, true);
  if (
    keysFile.isControlDown(context.tick) != ctrlKey ||
    keysFile.isShiftDown(context.tick) != shiftKey ||
    keysFile.isAltDown(context.tick) != altKey
  ) {
    FWKKeys.emit(context, FWKKeys.Clear(System.TimeStamp(0, 0), context.tick));
  }
}

fun setKeys(context: mutable SKFS.Context, keys: UiEvent.KeysFile): void {
  kfHandle.write(context, propKey, keys)
}

module end;
