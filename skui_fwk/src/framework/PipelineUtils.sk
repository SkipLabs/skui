module FWK;

const sidConverter: StrIDConverter = StrIDConverter();
const msConverter: SKFS.Converter<MouseState> = SKFS.FileConverter(
  MouseState::fromFile,
);
const fsConverter: SKFS.Converter<FocusState> = SKFS.FileConverter(
  FocusState::fromFile,
);

const nodesPath: SKFS.DirName = SKFS.DirName::create("/ui/fwk/nodes/");
const widgetsPath: SKFS.DirName = SKFS.DirName::create("/ui/fwk/widgets/");

const focusablesPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/fwk/focusables/",
);
const previousFocusablesPath: SKFS.DirName = focusablesPath.pre();
const mouseStatePath: SKFS.DirName = SKFS.DirName::create(
  "/ui/fwk/state/mouse/",
);
const previousMouseStatePath: SKFS.DirName = mouseStatePath.pre();
const keysStatePath: SKFS.DirName = SKFS.DirName::create("/ui/fwk/state/keys/");
const previousKeysStatePath: SKFS.DirName = keysStatePath.pre();

const fsHandle: SKFS.IHandle<FocusState> = SKFS.IHandle(
  fsConverter,
  previousKeysStatePath,
);

const msHandle: SKFS.IHandle<MouseState> = SKFS.IHandle(
  msConverter,
  previousMouseStatePath,
);

fun getFocusState(
  context: mutable SKFS.Context,
  isUntracked: Bool = false,
): FocusState {
  fsHandle.getValue(context, Ui.MainKey(), isUntracked);
}

fun getMouseState(
  context: mutable SKFS.Context,
  isUntracked: Bool = false,
): MouseState {
  msHandle.getValue(context, Ui.MainKey(), isUntracked);
}

fun getBounds(
  context: mutable SKFS.Context,
  path: Ui.Path,
  isUntracked: Bool = false,
): ?Geometry.Rect {
  FWKPipeline.gNodeInfo.maybeGetValue(context, path, isUntracked).map(ni ->
    ni.info.getWindowBounds(context, isUntracked)
  )
}

@cpp_extern("SKIP_FWK_applyCursor")
native fun applyCursor(wId: UInt32, cursor: UInt32): void;

@cpp_extern("SKIP_FWK_update")
native fun update(wId: UInt32): void;

@cpp_extern("SKIP_FWK_close")
native fun close(wId: UInt32): void;

module end;
