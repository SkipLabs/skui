module FWKClipboard;

fun init(context: mutable SKFS.Context): void {
  context.registerMessageSupport("system", "clipboard", Messages());
}

class Messages()
  extends FWKMessage.Support
  uses FWKMessage.WithUpdate<Command> {
  fun init(_context: mutable SKFS.Context): void {
    void
  }

  protected fun convert(message: JSON.Value): Command {
    Command::fromJSON(message)
  }

  protected fun convertCmd(command: FWKMessage.Command): Command {
    command as Command _;
  }

  protected fun execute(
    context: mutable SKFS.Context,
    _name: String,
    _scope: String,
    command: Command,
  ): void {
    FWKEnv.getWindowId(context, true).each(wId -> {
      command match {
      | Copy(content) ->
        content.getFiles().each(files ->
          update(wId, Files().toMime(), files.map(f -> "file:/" + f).join(","))
        );
        content.getHtml().each(html -> update(wId, Html().toMime(), html));
        content.getRtf().each(rtf -> update(wId, Rtf().toMime(), rtf));
        content.getPlain().each(plain -> update(wId, Plain().toMime(), plain))
      | Paste(type, target) ->
        request(wId, type.toMime(), target.toJSON().toString())
      }
    })
  }
}

@cpp_extern("SKIP_FWKClipboard_request")
native fun request(window: UInt32, mimeType: String, target: String): void;

@cpp_extern("SKIP_FWKClipboard_update")
native fun update(window: UInt32, mimeType: String, data: String): void;

@cpp_export("SKIP_FWK_performPaste")
fun performPaste(strTarget: String, mimeType: String, data: String): void {
  SKFS.Context::withoutGc(context ~> {
    type = Type::fromMime(mimeType);
    target = FWKMessage.Target::fromJSON(JSON.decode(strTarget));
    content = Content(Map[type => IO.Text(data)]);
    FWKMessage.target(context, target, Map["content" => content.toJSON()]);
    context.updateIfRoot();
  });
}

module end;
