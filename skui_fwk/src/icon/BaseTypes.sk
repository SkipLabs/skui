    | "back-right" | "redo" -> Redo()
    | "exchange-vertical" -> ExchangeVertical()
    | "save" -> Save()
    | "direction" -> Direction()
    | "multiple-direction" | "direction-alt" -> MultipleDirection()
    | "user" -> User()
    | "link" -> Link()
