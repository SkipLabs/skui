base class Codes extends SKFS.File {
  fun getChar(Icon): ?Char;

  static fun forFile(obj: SKFS.File): Codes {
    obj match {
    | x @ Codes _ -> x
    | _ -> SKFS.cast_violation("UiIcon.Codes", obj)
    }
  }
}

class Predefined(codes: Codes, base64: String)

class MapCodes(value: .Map<Icon, Char>) extends Codes {
  fun getChar(icon: Icon): ?Char {
    this.value.maybeGet(icon);
  }
}

class LamCodes(lam: Icon ~> ?Char) extends Codes {
  fun getChar(icon: Icon): ?Char {
    this.lam(icon);
  }
}

fun predefined(): SortedMap<String, Predefined> {
  p = Themify.fill(SortedMap<String, Predefined>::create());
  Material.fill(p);
}

base class Kind {
  children =
  | KInner()
  | KTheme()
  | KImage()
  | KCategory(String)
}

class Description(
  kind: Kind,
  name: String,
  optSize: ?Ui.Size = None(),
) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Description _ -> x
    | _ -> invariant_violation("Must be UiIcon.Description")
    }
  }

  fun toIconBuilder(): ?Ui.IconBuilder {
    this.kind match {
    | KInner() ->
      this.name match {
      | "arrow-to-right" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Arrow(
              Math.ceil(pt.pixels()).toInt(),
              Ui.ToRight(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "arrow-to-left" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Arrow(
              Math.ceil(pt.pixels()).toInt(),
              Ui.ToLeft(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "arrow-up" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Arrow(
              Math.ceil(pt.pixels()).toInt(),
              Ui.Up(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "arrow-down" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Arrow(
              Math.ceil(pt.pixels()).toInt(),
              Ui.Down(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "check" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Check(
              Math.ceil(pt.pixels()).toInt(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "dot" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Dot(
              Math.ceil(pt.pixels()).toInt(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "indeterminate" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Indeterminate(
              Math.ceil(pt.pixels()).toInt(),
              None(),
              2,
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "select" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Select(
              Math.ceil(pt.pixels()).toInt(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "uncheck" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Uncheck(
              Math.ceil(pt.pixels()).toInt(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | "unselect" ->
        Some(
          Ui.InnerIconBuilder(pt ~>
            Icon.Unselect(
              Math.ceil(pt.pixels()).toInt(),
              None(),
              this.optSize.map(s -> s.toSize(Geometry.Size::square(pt.value))),
              this.optSize.map(s -> s.keepRatio).default(false),
            )
          ),
        )
      | _ -> None()
      }
    | KTheme() ->
      UiTheme.iconFromString(this.name).map(ic ->
        UiTheme.IconBuilder(ic, this.optSize)
      )
    | KImage() -> todo("Update image icons")
    | KCategory(cat) ->
      icon = UiIcon.Icon::forName(this.name);
      Some(Ui.FromIconSupport(icon, cat, this.optSize))
    }
  }

  static fun forFile(obj: SKFS.File): Description {
    obj match {
    | x @ Description _ -> x
    | _ -> SKFS.cast_violation("UiIcon.Description", obj)
    }
  }
}

module end;
