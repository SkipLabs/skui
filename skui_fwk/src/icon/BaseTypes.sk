    name match {
    | "arrow-left" -> ArrowLeft()
    | "arrow-up" -> ArrowUp()
    | "arrow-right" -> ArrowRight()
    | "arrow-down" -> ArrowDown()
    | "arrow-top-left" -> ArrowTopLeft()
    | "arrow-top-right" -> ArrowTopRight()
    | "arrow-circle-left" -> ArrowCircleLeft()
    | "arrow-circle-up" -> ArrowCircleUp()
