module UiIcon;

const default: String = "themify";

base class Position() uses Hashable, Equality {
  children =
  | Bottom()
  | Left()
  | Right()
  | Top()
}

class Style{position: Position = Left(), gap: Float = 8.0}

class Face(
  collection: String,
  size: Float,
  dpi: Float,
  hinting: Font.Hinting,
) extends SKFS.BaseName {
  //
  static fun create(
    collection: String,
    size: Float,
    dpi: Float = 96.0,
    hinting: Font.Hinting = Font.HintingNone(),
  ): this {
    Face(collection, size, dpi, hinting)
  }

  fun sameCompare(y: SKFS.BaseName): Order {
    y match {
    | other @ Face _ ->
      cComp = this.collection.compare(other.collection);
      if (cComp == EQ()) {
        sComp = this.size.compare(other.size);
        if (sComp == EQ()) {
          dComp = this.dpi.compare(other.dpi);
          if (dComp == EQ()) {
            this.hinting.compare(other.hinting);
          } else {
            dComp
          }
        } else {
          sComp
        }
      } else {
        cComp
      }
    | obj -> SKFS.cast_violation("UiIcon.Face", obj)
    }
  }

  fun toString(): String {
    `Face:${this.size}:${this.dpi}`;
  }
}

class Glyph(face: Face, char: Char, pxRange: Int = 8) extends SKFS.BaseName {
  //
  fun sameCompare(y: SKFS.BaseName): Order {
    y match {
    | other @ Glyph _ ->
      cComp = this.char.compare(other.char);
      if (cComp == EQ()) {
        fComp = this.face.sameCompare(other.face);
        if (fComp == EQ()) {
          this.pxRange.compare(other.pxRange);
        } else {
          fComp
        }
      } else {
        cComp
      }
    | obj -> SKFS.cast_violation("UiIcon.Glyph", obj)
    }
  }

  fun toString(): String {
    `${this.face}:${this.char}:${this.pxRange}`
  }
}

