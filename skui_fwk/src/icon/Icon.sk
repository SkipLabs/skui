module UiIcon;

fun createIconSupport(
  context: mutable SKFS.Context,
  optBasename: ?SKFS.DirName = None(),
): Support {
  statePath = SKFS.DirName::check(`icons/states/`, optBasename);
  predef = predefined();
  faceProps = faceSupplier(context, predef, optBasename);
  glyphProps = glyphSupplier(context, faceProps, optBasename);
  codesHdl = SKFS.LHandle::lazy(
    SKFS.Loadable::forFile,
    context,
    SKFS.DirName::make(statePath, "__cache/codes/"),
    (_ctx, _self, key) ~> {
      sid = FWK.sidConverter.fromBaseName(key);
      predef.maybeGet(sid) match {
      | Some(p) -> SKFS.Loaded(p.codes)
      | None() -> SKFS.LoadFailed(Some(!"Only prefefined icons are managed."))
      }
    },
    false,
  );
  msdfProps = msdfSupplier(context, glyphProps, optBasename);
  Support(
    faceProps,
    glyphProps,
    (ctx, codesId) ~>
      SKFS.LoadableFuture(Codes::forFile, codesHdl.get(ctx, codesId)),
    msdfProps,
  );
}

fun faceSupplier(
  context: mutable SKFS.Context,
  predef: SortedMap<String, Predefined>,
  optBasename: ?SKFS.DirName = None(),
): Ui.GetterOne<SKFS.Future<Font.TypeFace>, Face> {
  typefacePath = SKFS.DirName::check("icons/ttfs/typefaces/", optBasename);
  typefaceHdl = SKFS.LHandle::lazy(
    SKFS.Loadable::forFile,
    context,
    typefacePath,
    (_ctx, _self, key) ~> {
      key match {
      | typeface @ Face _ ->
        typeFace = font ~>
          Font.TypeFace(
            Font.TypefaceInfo::create(typeface.collection),
            TrueType.Face::make(
              font,
              Font.Options{
                size => typeface.size,
                dpi => typeface.dpi,
                hinting => typeface.hinting,
              },
            ),
          );
        predef.maybeGet(typeface.collection) match {
        | Some(p) ->
          buffer = Base64.decodeString(p.base64);
          font = TrueType.parse(buffer);
          SKFS.Loaded(typeFace(font))
        | None() -> SKFS.LoadFailed(Some(!"Only prefefined icons are managed."))
        }
      | _ -> invariant_violation(`Must be a UiIcon.Face key`)
      }
    },
    false,
  );
  (ctx, typeface) ~>
    SKFS.LoadableFuture(Font.TypeFace::fromFile, typefaceHdl.get(ctx, typeface))
}

fun glyphSupplier(
  context: mutable SKFS.Context,
  faceSources: Ui.GetterOne<SKFS.Future<Font.TypeFace>, Face>,
  optBasename: ?SKFS.DirName = None(),
): Ui.GetterOne<?Font.GlyphFile, Glyph> {
  glyphPath = SKFS.DirName::check("icons/ttfs/glyphs/", optBasename);
  glyphHdl = SKFS.LHandle::optLazy(
    Font.GlyphFile::fromFile,
    context,
    glyphPath,
    (context, _self, key) ~> {
      key match {
      | gid @ Glyph _ ->
        futur = faceSources(context, gid.face);
        futur.maybeGet().flatMap(typeface ~> {
          face = typeface.face;
          optGlyph = face.getGlyph(gid.char);
          if (optGlyph.isNone()) {
            !optGlyph = face.getGlyph('\ufffd');
          };
          if (optGlyph.isNone()) {
            !optGlyph = face.getGlyph('?');
          };
          optGlyph.map(glyph -> Font.GlyphFile(Some(face), glyph))
        })
      | _ -> invariant_violation(`Must be a  UiIcon.Glyph key`)
      }
    },
    false,
  );
  (ctx, glyphId) ~> glyphHdl.maybeGet(ctx, glyphId);
}

fun msdfSupplier(
  context: mutable SKFS.Context,
  glyphProps: Ui.GetterOne<?Font.GlyphFile, Glyph>,
  optBasename: ?SKFS.DirName = None(),
): Ui.GetterOne<?Font.Msdf, Glyph> {
  msdfPath = SKFS.DirName::check("icons/ttfs/msdf/", optBasename);
  msdfHdl = SKFS.LHandle::optLazy(
    Font.Msdf::fromFile,
    context,
    msdfPath,
    (context, _self, key) ~> {
      key match {
      | gid @ Glyph _ ->
        glyphProps(context, gid).flatMap(glyph ->
          glyph.glyph.optPath.map(path -> {
            info = MTSDF.toMSDF{
              shape => MTSDF.Shape::fromPath(path),
              pxRange => gid.pxRange,
            };
            Font.Msdf::make(gid.char, info)
          })
        )

      | _ -> SKFS.cast_violation("UiIcon.Glyph", key)
      }
    },
    false,
  );
  (ctx, glyphId) ~> msdfHdl.maybeGet(ctx, glyphId);
}

module end;
