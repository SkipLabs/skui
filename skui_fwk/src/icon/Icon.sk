module UiIcon;

fun createIconSupport(
  context: mutable SKStore.Context,
  optBasename: ?SKStore.DirName = None(),
): Support {
  statePath = SKStore.DirName::check(`icons/states/`, optBasename);
  predef = predefined();
  faceProps = faceSupplier(context, predef, optBasename);
  glyphProps = glyphSupplier(context, faceProps, optBasename);
  codesHdl = SKStore.LHandle::lazy(
    SKStore.StrID::keyType,
    SKStore.Loadable::btype,
    context,
    SKStore.DirName::make(statePath, "__cache/codes/"),
    (_ctx, _self, key) ~> {
      predef.maybeGet(key.value) match {
      | Some(p) -> SKStore.Loaded(p.codes)
      | None() ->
        SKStore.LoadFailed(Some(!"Only prefefined icons are managed."))
      }
    },
    false,
  );
  msdfProps = msdfSupplier(context, glyphProps, optBasename);
  Support(
    faceProps,
    glyphProps,
    (ctx, codesId) ~>
      SKStore.LoadableFuture(Codes::btype, codesHdl.get(ctx, codesId)),
    msdfProps,
  );
}

fun faceSupplier(
  context: mutable SKStore.Context,
  predef: SortedMap<String, Predefined>,
  optBasename: ?SKStore.DirName = None(),
): Ui.GetterOne<SKStore.Future<Font.TypeFace>, Face> {
  typefacePath = SKStore.DirName::check("icons/ttfs/typefaces/", optBasename);
  typefaceHdl = SKStore.LHandle::lazy(
    Face::keyType,
    SKStore.Loadable::btype,
    context,
    typefacePath,
    (_ctx, _self, typeface) ~> {
      typeFace = font ~>
        Font.TypeFace(
          Font.TypefaceInfo::create(typeface.collection),
          TrueType.Face::make(
            font,
            Font.Options{
              size => typeface.size,
              dpi => typeface.dpi,
              hinting => typeface.hinting,
            },
          ),
        );
      predef.maybeGet(typeface.collection) match {
      | Some(p) ->
        buffer = Base64.decode(p.base64);
        font = TrueType.parse(buffer);
        SKStore.Loaded(typeFace(font))
      | None() ->
        SKStore.LoadFailed(Some(!"Only prefefined icons are managed."))
      }
    },
    false,
  );
  (ctx, typeface) ~>
    SKStore.LoadableFuture(Font.TypeFace::type, typefaceHdl.get(ctx, typeface))
}

fun glyphSupplier(
  context: mutable SKStore.Context,
  faceSources: Ui.GetterOne<SKStore.Future<Font.TypeFace>, Face>,
  optBasename: ?SKStore.DirName = None(),
): Ui.GetterOne<?Font.GlyphFile, Glyph> {
  glyphPath = SKStore.DirName::check("icons/ttfs/glyphs/", optBasename);
  glyphHdl = SKStore.LHandle::optLazy(
    Glyph::keyType,
    Font.GlyphFile::type,
    context,
    glyphPath,
    (context, _self, gid) ~> {
      futur = faceSources(context, gid.face);
      futur.maybeGet().flatMap(typeface ~> {
        face = typeface.face;
        optGlyph = face.getGlyph(gid.char);
        if (optGlyph.isNone()) {
          !optGlyph = face.getGlyph('\ufffd');
        };
        if (optGlyph.isNone()) {
          !optGlyph = face.getGlyph('?');
        };
        optGlyph.map(glyph -> Font.GlyphFile(Some(face), glyph))
      })
    },
    false,
  );
  (ctx, glyphId) ~> glyphHdl.maybeGetValue(ctx, glyphId);
}

fun msdfSupplier(
  context: mutable SKStore.Context,
  glyphProps: Ui.GetterOne<?Font.GlyphFile, Glyph>,
  optBasename: ?SKStore.DirName = None(),
): Ui.GetterOne<?Font.Msdf, Glyph> {
  msdfPath = SKStore.DirName::check("icons/ttfs/msdf/", optBasename);
  msdfHdl = SKStore.LHandle::optLazy(
    Glyph::keyType,
    Font.Msdf::type,
    context,
    msdfPath,
    (context, _self, gid) ~> {
      glyphProps(context, gid).flatMap(glyph ->
        glyph.glyph.optPath.map(path -> {
          info = MTSDF.toMSDF{
            shape => MTSDF.Shape::fromPath(path),
            pxRange => gid.pxRange,
          };
          Font.Msdf::make(gid.char, info)
        })
      )
    },
    false,
  );
  (ctx, glyphId) ~> msdfHdl.maybeGetValue(ctx, glyphId);
}

module end;
