module Icon;

class Uncheck(width: Int = 16, optPaint: ?Ui.Paint = None()) extends Ui.Icon {
  protected fun computedSize(_context: mutable SKFS.Context): Geometry.Size {
    Geometry.Size::square(this.width.toFloat());
  }

  fun update(optSize: ?Geometry.Size, keepRatio: Bool): this {
    static(this.width, this.optPaint, optSize, keepRatio)
  }

  fun fillDrawables(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    drawables.push(support.rectangle(offset, size, paint));
    drawables.push(
      support.rectangle(
        offset.translate(2.0, 2.0),
        size - Geometry.Size(4.0, 4.0),
        context.getThemeColor(UiTheme.Base()),
      ),
    );
  }
}

module end;
