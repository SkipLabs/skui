extension base class Change extends JSONValue {
fun toJSON(): JSON.Value
| Single(value) ->
JSON.Object(
Map[
"__class" => JSON.String(this.getClassName()),
"value" => value.toJSON(),
],
)
| Multiple(values) ->
JSON.Object(
Map[
"__class" => JSON.String(this.getClassName()),
"values" => JSON.arrayToJSON(values, v ~> v.toJSON()),
],
)
| Clear() -> JSON.Object(Map["__class" => JSON.String(this.getClassName())])

static fun fromJSON(jsv: JSON.Value): Change {
jso = jsv.expectObject();
cl = jso.getString("__class");
cl match {
| "IO.Single" -> Single(jso.get("value"))
| "IO.Multiple" ->
Multiple(JSON.arrayFromJSON(jso.getArray("values"), j ~> j))
| "IO.Clear" -> Clear()
| _ -> invariant_violation(`Invalid json object ${cl} for IO.Change`)
}
}
}

