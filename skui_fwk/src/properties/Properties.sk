module UiBoolProp;

class Timed extends Ui.TimedFile<Bool> {
  static fun fromFile(file: SKFS.File): Timed {
    file match {
    | x @ Timed _ -> x
    | _ -> SKFS.cast_violation("UiBoolProp.Timed", file)
    }
  }
}

class Property extends
  Ui.BoolProperty,
  Ui.PropertyFile<Bool, Timed, SKFS.BoolFile>,
{
  //
  fun get from Ui.PropertyFile;
  fun getTimed from Ui.PropertyFile;

  protected static fun timed(optV: ?Bool, tick: SKFS.Tick, source: Int): Timed {
    Timed(optV, tick, source)
  }

  protected static fun timedFromFile(file: SKFS.File): Timed {
    file match {
    | x @ Timed _ -> x
    | _ -> SKFS.cast_violation("UiBoolProp.Timed", file)
    }
  }

  protected static fun valueFromFile(file: SKFS.File): Bool {
    SKFS.BoolFile::fromFile(file).value
  }

  protected static fun fileValueFromFile(file: SKFS.File): SKFS.BoolFile {
    SKFS.BoolFile::fromFile(file)
  }

  protected static fun valueToFile(value: Bool): SKFS.File {
    SKFS.BoolFile(value)
  }

  protected static fun getDefaultValue(): Bool {
    false
  }

  static fun toIHandle(hdl: SKFS.EHandle<Timed>): SKFS.IHandle<Timed> {
    SKFS.toIHandle(hdl)
  }

  fun toggle(context: mutable SKFS.Context, source: Int): void {
    this.set(context, Some(!this.get(context, true)), source)
  }
}

class Const extends Ui.BoolProperty, Ui.PropertyConst<Bool, Timed> {
  //
  fun get from Ui.PropertyConst;
  fun getTimed from Ui.PropertyConst;

  protected static fun timed(optV: ?Bool, tick: SKFS.Tick): Timed {
    Timed(optV, tick, 0)
  }

  protected static fun getDefaultValue(): Bool {
    false
  }

  fun toggle(_context: mutable SKFS.Context, _source: Int): void {
    void
  }
}

class Jsonable extends Ui.BoolProperty, Ui.PropertyJsonable<Bool> {
  //
  fun get from Ui.PropertyJsonable;
  fun getTimed from Ui.PropertyJsonable;

  protected static fun valueFromJSON(s: JSON.Value): Bool {
    JSON.optBool(s).default(false)
  }

  protected static fun valueToJSON(v: Bool): JSON.Value {
    JSON.Bool(v)
  }

  protected static fun getDefaultValue(): Bool {
    false
  }

  fun toggle(context: mutable SKFS.Context, source: Int): void {
    this.set(context, Some(!this.get(context, true)), source)
  }
}

module end;

