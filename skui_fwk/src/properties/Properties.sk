  protected static fun timed(optV: ?Ui.Decoration, tick: SKFS.Tick): Timed {
    Timed(optV, tick, 0)
  }

  protected static fun getDefaultValue(): Ui.Decoration {
    Ui.Padding::all(0.0)
  }
}

module end;

