class String(property: Property) extends Ui.StringProperty {
  fun getName(): .String {
    this.property.getName()
  }

  fun getPath(): ?.String {
    this.property.getPath()
  }

  fun maybeGet(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): ?.String {
    this.property.maybeGet(context, isUntracked).map(context.uTranslate)
  }

  fun get(context: mutable SKFS.Context, isUntracked: Bool = false): .String {
    this.maybeGet(context, isUntracked) match {
    | Some(v) -> v
    | _ -> ""
    }
  }

  fun maybeGetTimed(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): ?(?.String, SKFS.Tick, Int) {
    this.property.maybeGetTimed(context, isUntracked).map(t ->
      (t.i0.map(context.uTranslate), t.i1, t.i2)
    )
  }

  fun getTimed(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): (.String, SKFS.Tick, Int) {
    this.maybeGetTimed(context, isUntracked) match {
    | Some(v) -> (v.i0.default(""), v.i1, v.i2)
    | _ -> ("", SKFS.Tick(0), 0)
    }
  }

  fun set(
    context: mutable SKFS.Context,
    optValue: ?.String,
    source: Int,
  ): void {
    this.property.set(context, optValue.map(str -> Raw(str)), source)
  }
}

module end;

