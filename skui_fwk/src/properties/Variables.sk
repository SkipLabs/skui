module Ui;

base class PropKind uses Orderable {
  children =
  | PProp()
  | PCombined()
  | PLoadable()
  | PHandle()
}

base class Prop final (name: String, optPath: ?String, kind: PropKind)

fun combinedPath(optPath: ?String): ?String {
  optPath match {
  | Some(p) -> Some(`${p}/combined`)
  | _ -> Some("combined")
  }
}
