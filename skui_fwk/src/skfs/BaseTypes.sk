module SKStore;

extension base class File uses HasClassName {}

class TSFile(value: System.TimeStamp) extends File

class HandleFile(handle: Handle<Key, File>) extends File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ HandleFile _ -> x
    | _ -> cast_violation("SKStore.HandleFile", obj)
    }
  }
}

class Strings(value: Array<String>) extends File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Strings _ -> x
    | _ -> invariant_violation("Must be SKStore.Strings")
    }
  }
}

class StringSet(value: Set<String>) extends File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ StringSet _ -> x
    | _ -> invariant_violation("Must be SKStore.StringSet")
    }
  }
}

module end;
