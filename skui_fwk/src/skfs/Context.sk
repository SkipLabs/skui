module SKFS;

class DrawableSupportFile(value: Ui.DrawableSupport) extends File

extension class Context {
  mutable fun initFontSupport(): void {
    this.setGlobal("Ui.FontSupport", TrueType.createFontSupport(this));
  }

  readonly fun getFontSupport(): Ui.FontSupport {
    Ui.FontSupport::fromFile(this.getGlobal("Ui.FontSupport").fromSome());
  }

  mutable fun setDialogsState(state: UiDialogs.State): void {
    this.setGlobal("UiDialogs.State", state);
  }

  readonly fun openAlertMessage(
    text: Text,
    optTitle: ?Text = None(),
  ): SKUIMessage.Message {
    state = this.getGlobal("UiDialogs.State")
      .map(f ~> f as UiDialogs.State _)
      .fromSome();
    state.openAlertMessage(text, optTitle);
  }

  readonly fun openConfirmMessage(
    text: Text,
    target: SKUIMessage.Target,
    autoClose: Bool = true,
    type_: UiDialogs.QType = UiDialogs.YesNo(),
    optTitle: ?Text = None(),
  ): SKUIMessage.Message {
    state = this.getGlobal("UiDialogs.State")
      .map(f ~> f as UiDialogs.State _)
      .fromSome();
    state.openConfirmMessage(text, target, autoClose, type_, optTitle);
  }

  readonly fun openInputMessage(
    message: Text,
    target: SKUIMessage.Target,
    autoClose: Bool = true,
    optTitle: ?Text = None(),
    settings: UiDialogs.Settings = UiDialogs.Settings{},
    //optSupplier: ?UiDialogs.InputSupplier = None(),
  ): SKUIMessage.Message {
    state = this.getGlobal("UiDialogs.State")
      .map(f ~> f as UiDialogs.State _)
      .fromSome();
    state.openInputMessage(
      message,
      target,
      autoClose,
      optTitle,
      settings,
      //optSupplier,
    );
  }

  mutable fun initTextSupport(support: Ui.DrawableSupport): void {
    this.setGlobal("Ui.TextSupport", Ui.TextSupport::create(this, support));
  }

  readonly fun getTextSupport(): Ui.TextSupport {
    Ui.TextSupport::fromFile(this.getGlobal("Ui.TextSupport").fromSome());
  }

  mutable fun initIconSupport(): void {
    this.setGlobal("UiIcon.Support", UiIcon.createIconSupport(this));
  }

  readonly fun getIconSupport(): UiIcon.Support {
    UiIcon.Support::fromFile(this.getGlobal("UiIcon.Support").fromSome());
  }

  readonly fun get<T: frozen>(path: Path, conv: SKFS.File ~> T): ?T {
    this.unsafeMaybeGetDir(path.dirName) match {
    | None() -> None()
    | Some(d) ->
      files = d.getArrayRaw(path.baseName);
      if (files.isEmpty()) {
        None()
      } else {
        Some(conv(files.first()))
      }
    }
  }

  mutable fun initFocused(): void {
    dirName = SKFS.DirName::create("/system/focused/");
    handle = SKFS.LHandle::lazy(
      f ~> f,
      this,
      dirName,
      (context, _self, key) ~> {
        key match {
        | uid @ Ui.Path _ ->
          focusState = FWK.getFocusState(context);
          SKFS.BoolFile(
            focusState.optFocused match {
            | Some(focused) ->
              native_eq<Ui.Path>(uid, focused.getIdentifier()) == 0
            | _ -> false
            },
          )
        | _ -> invariant_violation("Must be a SKFS.DirName")
        }
      },
    );
    this.setGlobal("FWK.Focused", SKFS.HandleFile(handle));
  }

  mutable fun isFocused(path: Ui.Path): Bool {
    this.getGlobal("FWK.Focused") match {
    | Some(fm) ->
      BoolFile::fromFile(HandleFile::fromFile(fm).handle.get(this, path)).value
    | _ -> false
    }
  }

  mutable fun translate(text: Text): String {
    text.toString();
  }

  mutable fun uTranslate(text: Text): String {
    text.toString();
  }

  mutable fun getTheme(): Ui.Theme {
    this.getGlobal("Ui.Theme") match {
    | Some(file) -> Ui.Theme::forFile(file)
    | _ ->
      theme = UiTheme.Default();
      this.setGlobal("Ui.Theme", theme);
      theme
    }
  }

  mutable fun getThemeColor(color: UiTheme.Color): Color {
    this.getTheme().getColor(this, color);
  }

  mutable fun getThemeThickness(thickness: UiTheme.Thickness): Int {
    this.getTheme().getThickness(this, thickness);
  }

  mutable fun getThemeIcon(icon: UiTheme.Icon): Ui.IconBuilder {
    this.getTheme().getIconBuilder(this, icon);
  }

  mutable fun getThemeFont(font: UiTheme.Font): Font.FaceID {
    this.getTheme().getFont(this, font);
  }
}

class IdSupplier(
  next: UInt32 = UInt32::truncate(0),
  supplied: Map<String, UInt32> = Map[],
) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ IdSupplier _ -> x
    | _ -> invariant_violation("Must be SKFS.IdSupplier")
    }
  }

  fun idFor(name: String): (UInt32, IdSupplier) {
    this.supplied.maybeGet(name) match {
    | Some(id) -> (id, this)
    | _ ->
      id = this.next;
      !this.next = UInt32::truncate(id + 1);
      !this.supplied = Maps.add(this.supplied, name, id);
      (id, this)
    }
  }
}

module end;
