module SKStore;

base class UserData

base class KIndexed extends Key {
  children =
  | KKeys()
  | KSize()
  | KIdx(Key)

  static fun bKeyType(obj: Key): KIndexed {
    obj match {
    | x @ KIndexed _ -> x
    | _ -> cast_violation("SKStore.KIndexed", obj)
    }
  }

  fun toString(): String
  | KKeys()
  | KSize() ->
    this.getClassName()
  | KIdx(v) -> v.toString()
}

class Keys(value: Array<Key>) extends File {
  //
  static fun type(obj: File): this {
    obj match {
    | x @ Keys _ -> x
    | _ -> cast_violation("SKStore.Keys", obj)
    }
  }
}

@debug
fun derive<K: Key, T: File, U: UserData>(
  context: mutable Context,
  scope: String,
  dirName: DirName,
  src: EHandle<K, T>,
  srcKey: K,
  initKeys: Array<K>,
  updater: (
    mutable Context,
    String,
    mutable FWK.SMap<Key, ?File>,
    file: T,
    optUserData: ?U,
  ) ~> void,
  optUserData: ?U,
  optPreDir: ?ENotTyped = None(),
): ENotTyped {
  preComputedHdl = optPreDir match {
  | Some(preDirHdl) -> preDirHdl
  | _ ->
    context.makeNotTypedPre(
      dirName,
      Array<(Key, File)>[(KKeys(), Keys(initKeys))],
    )
  };
  computedHdl = src.map(
    k ~> k,
    f ~> f,
    context,
    dirName,
    (context, writer, key, it) ~> {
      if (srcKey == key) {
        f = preComputedHdl.getValue(context, KKeys(), true);
        keys = Keys::type(f);
        //map = mutable FWK.SMap<Key, ?File>[];
        //=>  Invariant violation: We shouldn't be printing those elements!
        map: mutable FWK.SMap<Key, ?File> = mutable FWK.SMap[];
        for (k in keys.value) {
          map.set(k, preComputedHdl.maybeGetValue(context, k, true))
        };
        updater(context, scope, map, it.first, optUserData);
        nKeys = Array::createFromIterator(map.smap.keys());
        map.each((k, opt) -> opt.each(v -> writer.set(k, v)));
        writer.set(KKeys(), Keys(nKeys));
      }
    },
  );
  computedHdl
}

module end;
