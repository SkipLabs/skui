module Text;

class Group{before: Float, kern: Float, range: .Range}

class Reducer(
  chars: Vector<Char>,
  groups: Array<Group>,
  ellipsisWidth: Float,
  optEllipsis: ?Char,
  optRange: ?Text.Range = None(),
) {
  static fun charsReducer(
    context: mutable SKStore.Context,
    chars: Vector<Char>,
    faceId: Font.FaceID,
    optEllipsis: ?Char = Some(Text.ellipsis),
    optRange: ?Text.Range = None(),
  ): Reducer {
    fontSupport = context.getFontSupport();
    before = 0.0;
    optChar: ?Char = None();
    groups = mutable Vector<Group>[];
    range = optRange.default(Text.Token::make(0, chars.size()));
    for (i in range.toRange()) {
      char = chars[i];
      kern = fontSupport.getKern(context, char, faceId, optChar);
      w = fontSupport.getWidth(context, char, faceId);
      !optChar = Some(char);
      g = Group{before, kern, range => .Range(i, i + 1)};
      !before = before + w + kern;
      groups.push(g);
    };
    groups.push(
      Group{before, kern => 0.0, range => .Range(range.end, range.end)},
    );
    w = optEllipsis
      .map(ellipsis -> fontSupport.getWidth(context, ellipsis, faceId))
      .default(0.0);
    Reducer(chars, groups.toArray(), w, optEllipsis, optRange);
  }

  static fun wordsReducer(
    context: mutable SKStore.Context,
    chars: Vector<Char>,
    faceId: Font.FaceID,
    optEllipsis: ?Char = Some(Text.ellipsis),
    optRange: ?Text.Range = None(),
    isSeparator: Char ~> Bool = Char.isWhitespace,
  ): Reducer {
    fontSupport = context.getFontSupport();
    before = 0.0;
    groups = mutable Vector<Group>[];
    optChar: ?Char = None();
    start: Int = 0;
    optGroup: ?Group = None();
    range = optRange.default(Text.Token::make(0, chars.size()));
    for (index in range.toRange()) {
      char = chars[index];
      kern = fontSupport.getKern(context, char, faceId, optChar);
      w = fontSupport.getWidth(context, char, faceId);
      !optChar = Some(char);
      if (isSeparator(char)) {
        optGroup match {
        | Some(group) ->
          !group.range = .Range(start, index);
          groups.push(group);
          !optGroup = None()
        | _ -> void
        };
      } else if (optGroup.isNone()) {
        !optGroup = Some(
          Group{before, kern, range => .Range(index, index + 1)},
        );
        !start = index;
      };
      !before = before + w + kern;
    };
    optGroup match {
    | Some(group) ->
      !group.range = .Range(start, chars.size());
      groups.push(group);
      !optGroup = None()
    | _ -> void
    };
    groups.push(
      Group{before, kern => 0.0, range => .Range(chars.size(), chars.size())},
    );
    w = optEllipsis
      .map(ellipsis -> fontSupport.getWidth(context, ellipsis, faceId))
      .default(0.0);
    Reducer(chars, groups.toArray(), w, optEllipsis, optRange);
  }

  fun reduce(width: Float, mode: Reduction): (String, Float) {
    (ranges, twidth) = this.reduceRanges(width, mode);
    (
      if (ranges.isEmpty()) {
        this.optRange match {
        | Some(range) ->
          String::fromChars(this.chars.slice(range.start, range.end).toArray())
        | _ -> String::fromChars(this.chars.toArray())
        };
      } else {
        ellipse = this.optEllipsis.map(e -> `${e}`).default("");
        if (mode == LeadingReduction()) {
          first = ranges.first();
          token = this.toTextRange(first);
          text = String::fromChars(
            this.chars.slice(token.start, token.end).toArray(),
          );
          `${ellipse}${text}`
        } else if (mode == EndingReduction()) {
          first = ranges.first();
          token = this.toTextRange(first);
          text = String::fromChars(
            this.chars.slice(token.start, token.end).toArray(),
          );
          `${text}${ellipse}`
        } else {
          ranges
            .map(r -> {
              token = this.toTextRange(r);
              String::fromChars(
                this.chars.slice(token.start, token.end).toArray(),
              );
            })
            .join(ellipse)
        }
      },
      twidth,
    )
  }

  private fun toTextRange(range: .Range): Range {
    start = this.groups[range.start];
    end = this.groups[range.end];
    Token::make(start.range.start, end.range.start);
  }

  private fun width(range: .Range): Float {
    if (range.start >= range.end) {
      0.0
    } else {
      start = this.groups.get(Math.max(0, range.start));
      end = this.groups.get(Math.min(this.groups.size() - 1, range.end));
      end.before - (start.before - start.kern);
    }
  }

  private fun reduceRanges(
    width: Float,
    mode: Reduction,
  ): (Array<.Range>, Float) {
    if (this.groups.isEmpty() || this.groups.last().before <= width) {
      (Array[], this.groups.last().before)
    } else if (mode == LeadingReduction()) {
      end = this.groups.size() - 1;
      start = 1;
      twidth = this.width(.Range(start, end));
      while (start < end && twidth + this.ellipsisWidth > width) {
        !start = start + 1;
        !twidth = this.width(.Range(start, end));
      };
      (Array[.Range(start, end)], twidth + this.ellipsisWidth)
    } else if (mode == CenterReduction()) {
      end = this.groups.size() - 1;
      endleft = end / 2;
      startRight = endleft + 1;
      left = this.width(.Range(0, endleft));
      right = this.width(.Range(startRight, end));
      odd = true;
      while (
        (endleft > 0 || startRight < end) &&
        left + right + this.ellipsisWidth > width
      ) {
        if (odd) {
          if (endleft > 0) {
            !endleft = endleft - 1;
          } else {
            !startRight = startRight + 1;
          }
        } else if (startRight < end) {
          !startRight = startRight + 1;
        } else {
          !endleft = endleft - 1;
        };
        !left = this.width(.Range(0, endleft));
        !right = this.width(.Range(startRight, end));
        !odd = !odd;
      };
      (
        Array[.Range(0, endleft), .Range(startRight, end)],
        left + right + this.ellipsisWidth,
      )
    } else {
      end = this.groups.size() - 2;
      twidth = this.width(.Range(0, end));
      while (end > 0 && twidth + this.ellipsisWidth > width) {
        !end = end - 1;
        !twidth = this.width(.Range(0, end));
      };
      (Array[.Range(0, end)], twidth + this.ellipsisWidth)
    }
  }
}

module end;
