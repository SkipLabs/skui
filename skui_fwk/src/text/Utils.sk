module Ui;

private fun nextValue(
  tokens: readonly Vector<Text.TokenInfo>,
  max: Float,
  idx: Int,
): (Int, ?Float) {
  res = while (idx < tokens.size()) {
    if (tokens[idx].kind == Text.KNumber()) {
      number = tokens[idx].toFloat();
      !idx = idx + 1;
      if (idx < tokens.size()) {
        tokens[idx].text match {
        | "deg" ->
          !idx = idx + 1;
          break (idx, Some(max * number / 360.0))
        | "grad" ->
          !idx = idx + 1;
          break (idx, Some(max * number / 400.0))
        | "rad" ->
          !idx = idx + 1;
          break (idx, Some(max * number / (2.0 * Math.PI)))
        | "turn" ->
          !idx = idx + 1;
          break (idx, Some(max * number))
        | v if (v.startsWith("%")) ->
          !idx = idx + 1;
          break (idx, Some(max * number / 100.0))
        | _ -> break (idx, Some(number))
        }
      }
    };
    !idx = idx + 1;
  } else {
    (idx, None())
  };
  (res.i0, res.i1.map(v -> Math.clamp(v, 0.0, max)))
}

private fun toRgbColor(tokens: readonly Vector<Text.TokenInfo>): ?Color {
  if (tokens[0].text == "rgb" || tokens[0].text == "rgba") {
    nextValue(tokens, 255.0, 0) match {
    | (idx, Some(red)) ->
      nextValue(tokens, 255.0, idx) match {
      | (idx1, Some(green)) ->
        nextValue(tokens, 255.0, idx1) match {
        | (idx2, Some(blue)) ->
          nextValue(tokens, 1.0, idx2) match {
          | (_, Some(alpha)) ->
            Some(
              Color::rgbaInt(
                red.toInt(),
                green.toInt(),
                blue.toInt(),
                (alpha * 255.0).toInt(),
              ),
            )
          | _ -> Some(Color::rgbaInt(red.toInt(), green.toInt(), blue.toInt()))
          }
        | _ -> None()
        }
      | _ -> None()
      }
    | _ -> None()
    }
  } else {
    None()
  }
}

private fun fromRgbColor(strColor: String): ?Color {
  tokens = mutable Vector<Text.TokenInfo>[];
  lexer = mutable Text.Lexer{
    text => strColor.chars(),
    tokens,
    splitNumberAndToken => true,
    allowSymbolBeforeNumber => true,
  };
  lexer.lex();
  toRgbColor(tokens);
}

private fun toHSLColor(tokens: readonly Vector<Text.TokenInfo>): ?HSLColor {
  if (tokens[0].text == "hsl" || tokens[0].text == "hsla") {
    nextValue(tokens, 360.0, 0) match {
    | (idx, Some(hue)) ->
      nextValue(tokens, 1.0, idx) match {
      | (idx1, Some(saturation)) ->
        nextValue(tokens, 1.0, idx1) match {
        | (idx2, Some(lightness)) ->
          nextValue(tokens, 1.0, idx2) match {
          | (_, Some(alpha)) ->
            Some(HSLColor::fromHSLA(hue, saturation, lightness, alpha))
          | _ -> Some(HSLColor::fromHSLA(hue, saturation, lightness, 1.0))
          }
        | _ -> None()
        }
      | _ -> None()
      }
    | _ -> None()
    }
  } else {
    None()
  }
}

private fun fromHslColor(strColor: String): ?Color {
  tokens = mutable Vector<Text.TokenInfo>[];
  lexer = mutable Text.Lexer{
    text => strColor.chars(),
    tokens,
    splitNumberAndToken => true,
    allowSymbolBeforeNumber => true,
  };
  lexer.lex();
  toHSLColor(tokens).map(c -> c.toColor())
}

private fun htmlColor(i: mutable String.StringIterator, size: Int): ?Color {
  if (size == 7) {
    r = nextHexInt(i, 0, 2);
    g = nextHexInt(i, 0, 2);
    b = nextHexInt(i, 0, 2);
    Some(
      Color::rgba(UInt8::truncate(r), UInt8::truncate(g), UInt8::truncate(b)),
    )
  } else if (size == 4) {
    r = nextHexInt(i, 0, 1);
    g = nextHexInt(i, 0, 1);
    b = nextHexInt(i, 0, 1);
    Some(
      Color::rgba(
        UInt8::truncate(r.shl(4).or(r.and(0xF))),
        UInt8::truncate(g.shl(4).or(g.and(0xF))),
        UInt8::truncate(b.shl(4).or(b.and(0xF))),
      ),
    )
  } else {
    None()
  }
}

fun webColor(strColor: String): ?Color {
  cleaned = strColor.trim();
  i = cleaned.getIter();
  i.next() match {
  | None() -> None()
  | Some('r') -> fromRgbColor(cleaned)
  | Some('h') -> fromHslColor(cleaned)
  | Some('#') -> htmlColor(i, strColor.length())
  | Some('0') ->
    i.next() match {
    | Some('x') -> htmlColor(i, strColor.length() - 1)
    | _ -> None()
    }
  | _ -> None()
  }
}

fun calculateLightness(color: .Color): Float {
  0.3 * color.red + 0.59 * color.green + 0.11 * color.blue;
}

/**
 * Derives a lighter or darker of a given color.
 *
 * @param c           The color to derive from
 * @param lightness  The lightness difference for the new color -1.0 being 100% dark which is always black, 0.0 being
 *                    no change and 1.0 being 100% lighter which is always white
 */
fun deriveColor(c: .Color, lightness: Float): .Color {
  baseLightness = calculateLightness(c);
  calcLightness = if (lightness > 0.0) {
    if (baseLightness > 0.85) {
      lightness * 1.6;
    } else if (baseLightness > 0.6) {
      lightness
    } else if (baseLightness > 0.5) {
      lightness * 0.9;
    } else if (baseLightness > 0.4) {
      lightness * 0.8;
    } else if (baseLightness > 0.3) {
      lightness * 0.7;
    } else {
      lightness * 0.6;
    }
  } else {
    if (baseLightness < 0.2) {
      lightness * 0.6;
    } else {
      lightness;
    }
  };
  !calcLightness = Math.clamp(calcLightness, -1.0, 1.0);
  hsl = c.toHSL();
  res = if (calcLightness > 0.0) { // brighter
    HSLColor::fromHSL(
      hsl.hue,
      Math.clamp(hsl.saturation * (1.0 - calcLightness), 0.0, 1.0),
      Math.clamp(
        hsl.lightness + ((1.0 - hsl.lightness) * calcLightness),
        0.0,
        1.0,
      ),
    );
  } else { // darker
    HSLColor::fromHSL(
      hsl.hue,
      hsl.saturation,
      Math.clamp(hsl.lightness * (1.0 + calcLightness), 0.0, 1.0),
    );
  };
  res.toColor();
}

fun parseColor(color: String): ?.Color {
