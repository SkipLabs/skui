  | "cadetblue" -> Some(.Color::rgbaInt(95, 158, 160))
  | "chartreuse" -> Some(.Color::rgbaInt(127, 255, 0))
  | "chocolate" -> Some(.Color::rgbaInt(210, 105, 30))
  | "coral" -> Some(.Color::rgbaInt(255, 127, 80))
  | "cornflowerblue" -> Some(.Color::rgbaInt(100, 149, 237))
  | "cornsilk" -> Some(.Color::rgbaInt(255, 248, 220))
  | "crimson" -> Some(.Color::rgbaInt(220, 20, 60))
  | "cyan" -> Some(.Color::rgbaInt(0, 255, 255))
  | "darkblue" -> Some(.Color::rgbaInt(0, 0, 139))
  | "darkcyan" -> Some(.Color::rgbaInt(0, 139, 139))
  | "darkgoldenrod" -> Some(.Color::rgbaInt(184, 134, 11))
