base class IconBuilder {
  fun buildIcon(context: mutable SKStore.Context, fontSize: Float): ?Icon;
}

class FromIconSupport(
  icon: UiIcon.Icon,
  collection: String = UiIcon.default,
  optSize: ?Size = None(),
) extends IconBuilder {
  fun buildIcon(_context: mutable SKStore.Context, fontSize: Float): ?Icon {
    pixels = Ui.Pt(fontSize).pixels();
    Some(
      FontIcon(
        this.icon,
        this.collection,
        fontSize,
        this.optSize.map(s -> s.toSize(Geometry.Size::square(pixels))),
        this.optSize.map(s -> s.keepRatio).default(false),
      ),
    )
  }
}

class InnerIconBuilder(builder: Pt ~> Icon) extends IconBuilder {
  fun buildIcon(_context: mutable SKStore.Context, fontSize: Float): ?Icon {
    Some(this.builder(Pt(fontSize)));
  }
}

base class WithShortcuts{
  optShortcuts: ?(
    String,
    mutable SKStore.Context ~> Array<FWK.ShortcutAction>,
    Bool,
  ) = None(),
} {
  fun getIdentifier(): Path;

  fun checkFocusHandlers(
    _context: mutable SKStore.Context,
    handlers: readonly Vector<FWK.FocusHandler>,
  ): Vector<FWK.FocusHandler> {
    this.optShortcuts match {
    | Some(descriptor) ->
      (category, shortcuts, parentBefore) = descriptor;
      handlers.map(cfh ->
        FocusHandlerWithShortcuts{
          identifier => this.getIdentifier(),
          category,
          shortcuts,
          optFocusHandler => Some(cfh),
          parentBefore,
        }
      )
    | _ -> handlers.chill()
    }
  }
}

base class Executable extends SKStore.File {
  children =
  | Init()
  | Multiple(Array<Executable>)
}

class Todo(command: Executable, tick: SKStore.Tick) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Todo _ -> x
    | _ -> SKStore.cast_violation("Ui.Todo", obj)
    }
  }
}

fun setTodo(
  context: mutable SKStore.Context,
  handle: SKStore.INotTyped,
  value: Executable,
): void {
  getter = ctx ~> {
    optExecutable = handle
      .uMaybeGet(ctx, Ui.todoProp)
      .map(Ui.Todo::type)
      .flatMap(t -> if (t.tick == ctx.tick) Some(t.command) else None());
    Array[
      Ui.Todo(
        optExecutable match {
        | Some(command) ->
          command match {
          | Multiple(cmds) -> Multiple(Arrays.add(cmds, value))
          | _ -> Multiple(Array[command, value])
          }
        | _ -> value
        },
        ctx.tick,
      ),
    ]
  };
  handle.writeDeferredArray(context, todoProp, getter)
}

class Shortcut(
  key: String,
  ctrl: Bool,
  shift: Bool,
  alt: Bool,
  meta: Bool = false,
) {
  fun toText(): Text {
    v = mutable Vector<Text>[];
    if (this.ctrl) v.push(!"Ctrl");
    if (this.meta) v.push(!"Meta");
    if (this.alt) v.push(!"Alt");
    if (this.shift) v.push(!"Shift");
    v.push(Raw(this.key));
    format = Array::fillBy(v.size(), idx -> `{${idx + 1}}`).join("+");
    Format(Raw(format), v.toArray())
  }
}

base class Drawer {
  fun fillDrawables(
    context: SKStore.Context,
    support: Ui.DrawableSupport,
    layer: Ui.LayerId,
    drawables: mutable Vector<Ui.Drawable>,
  ): void;
}

base class StorageWithScroll {
  fun getScrolling(context: mutable SKStore.Context): ?SKStore.Tick;
  fun setScrolling(
    context: mutable SKStore.Context,
    optTick: ?SKStore.Tick,
  ): void;
  fun setScroll(context: mutable SKStore.Context, optScroll: ?Ui.Scroll): void;
}

base class StateWithScroll {
  fun getScroll(context: mutable SKStore.Context): ?Ui.Scroll;
  fun getEnsureVisible(context: mutable SKStore.Context): ?Ui.Visible;
  fun emitScroll(context: mutable SKStore.Context, value: ?Ui.Scroll): void;
  fun emitScrolling(context: mutable SKStore.Context, value: Int): void;
}

base class Drop uses Orderable extends SKStore.File {
  children =
  | DropBefore()
  | DropAfter()
  | DropIn()

  static fun all(): Array<Drop> {
    Array[DropBefore(), DropAfter(), DropIn()]
  }

  fun toString(): String
  | DropBefore() -> "DropBefore"
  | DropAfter() -> "DropAfter"
  | DropIn() -> "DropIn"

  fun toCode(): Int
  | DropBefore() -> 0
  | DropAfter() -> 1
  | DropIn() -> 2

  static fun fromCode(code: Int): Drop {
    code match {
    | 1 -> DropAfter()
    | 2 -> DropIn()
    | 0
    | _ ->
      DropIn()
    }
  }
}

class Visibility(tick: SKStore.Tick, visible: Bool) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Visibility _ -> x
    | _ -> invariant_violation("Must be Ui.Visibility")
    }
  }
}

class ListHandle<T: frozen>(
  handle: SKStore.EHandle<SKStore.Key, SKStore.File>,
  conv: SKStore.File ~> T,
) {
  fun getSize(context: mutable SKStore.Context): Int {
    this.handle.getInt(context, SKStore.KSize())
  }

  fun getKeys(context: mutable SKStore.Context): Array<SKStore.Key> {
    this.handle.getProp(
      context,
      SKStore.KKeys(),
      SKStore.Keys::type,
      SKStore.Keys(Array[]),
    ).value
  }

  fun getElement(context: mutable SKStore.Context, key: SKStore.Key): T {
    this.handle.maybeGetProp(context, key, this.conv).fromSome()
  }

  fun getElementAt(context: mutable SKStore.Context, index: Int): T {
    this.getElement(context, this.getKeys(context)[index])
  }

  fun map<U: frozen>(
    context: mutable SKStore.Context,
    dirName: SKStore.DirName,
    builder: (mutable SKStore.Context, SKStore.Key, T) ~> U,
    fromFile: SKStore.File ~> U,
    toFile: U ~> SKStore.File,
  ): ListHandle<U> {
    ListHandle<U>(
      this.handle.map(
        this.handle.keyType,
        this.handle.type,
        context,
        dirName,
        (context, writer, key, it) ~>
          key match {
          | SKStore.KKeys()
          | SKStore.KSize() ->
            writer.set(key, it.first)
          | _ ->
            writer.set(key, toFile(builder(context, key, this.conv(it.first))))
          }
        ,
      ),
      fromFile,
    )
  }
}

class WidgetsList(handle: ListHandle<WidgetFile>) extends WidgetsCollection {
  //
  fun getSize(context: mutable SKStore.Context): Int {
    this.handle.getSize(context)
  }

  fun getWidget(context: mutable SKStore.Context, index: Int): Widget {
    this.handle.getElementAt(context, index).widget
  }

  fun all(context: mutable SKStore.Context): Array<Widget> {
    keys = this.handle.getKeys(context);
    keys.map(key -> this.handle.getElement(context, key).widget)
  }
}

class Token(info: Text.TokenInfo, optColor: ?Color)

class Tokens(
  value: Vector<Token>,
  size: Int,
  start: Int = 0,
  shift: Int = 0,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Tokens _ -> x
    | _ -> invariant_violation("Must be Ui.Tokens")
    }
  }

  fun filter(start: Int, count: Int): this {
    newValues = mutable Vector<Token>[];
    end = start + count;
    toAdd = false;
    index = 0;
    startIndex = 0;
    shift = 0;
    for (token in this.value) {
      if (!toAdd) {
        !toAdd = (index + token.info.count) > start;
        if (toAdd) {
          !startIndex = start - index;
          if (token.info.kind != Text.KWhiteSpace()) {
            !shift = token.info.shift;
          }
        } else if (token.info.kind != Text.KWhiteSpace()) {
          !shift = token.info.shift;
        }
      } else if (index >= end) {
        break void;
      };
      if (toAdd) newValues.push(token);
      !index = index + token.info.count;
    };
    Tokens(unsafe_chill_trust_me(newValues), this.size, startIndex, shift)
  }

  fun indexes(): Vector<Int> {
    indexes = mutable Vector<Int>[];
    index = this.shift;
    this.value.each(token -> {
      if (token.info.kind == Text.KWhiteSpace()) {
        token.info.text.chars().each(char -> {
          indexes.push(index);
          if (char == Text.tabSuffix || char == Text.whiteSpace) {
            !index = index + 1;
          }
        });
      } else {
        for (_idx in .Range(0, token.info.count)) {
          indexes.push(index);
          !index = index + 1;
        }
      }
    });
    unsafe_chill_trust_me(indexes);
  }
}

