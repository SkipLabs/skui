  fun getNode(
    _context: mutable SKStore.Context,
    _constraints: BoxConstraints,
  ): Node {
    dummy()
  }

  fun getViewportDefinition(_context: mutable SKStore.Context): ?ViewportDef {
    dummy()
  }
}

