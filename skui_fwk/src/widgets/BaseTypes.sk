module Ui;

type HoverHandlerGetter = (
  mutable SKStore.Context,
  Geometry.Offset,
  NodeInfo,
) ~> ?FWK.HoverHandler;

type LockHandlerGetter = (
  mutable SKStore.Context,
  UiEvent.MouseFile,
  NodeInfo,
) ~> ?FWK.LockHandler;

type DragHandlerGetter = (
  mutable SKStore.Context,
  Geometry.Offset,
  NodeInfo,
) ~> ?FWK.DragHandler;

type DropHandlerGetter = (
  mutable SKStore.Context,
  Geometry.Offset,
  NodeInfo,
) ~> ?FWK.DropHandler;

type UserDataGetter = (mutable SKStore.Context) ~> ?UserData;

fun constUserData(optUserData: ?UserData): UserDataGetter {
  (_) ~> optUserData
}

fun constHoverHandler(hh: FWK.HoverHandler): HoverHandlerGetter {
  (_, _, _) ~> Some(hh)
}

base class Object uses Orderable, Show

base class Separator uses Hashable, Equality {
  children =
  | Nil()
  | Before()
  | After()
  | Both()

  fun before(): Bool {
    this == Before() || this == Both()
  }

  fun after(): Bool {
    this == After() || this == Both()
  }

  fun toCode(): Int
  | Nil() -> 0
  | Before() -> 1
  | After() -> 2
  | Both() -> 3

  static fun fromCode(code: Int): Separator {
    code match {
    | 1 -> Before()
    | 2 -> After()
    | 3 -> Both()
    | 0
    | _ ->
      Nil()
    }
  }
}

base class DrawInfo private (offset: Geometry.Point = Geometry.Point(0, 0)) {}

base class UserData

base class LayerData

base class Configuration extends SKStore.File {
  static fun btype(obj: SKStore.File): Configuration {
    obj match {
    | x @ Configuration _ -> x
    | _ -> SKStore.cast_violation("Ui.Configuration", obj)
    }
  }
}

class DummyConfiguration{} extends Configuration {}

base class Converter<T> {
  fun convert(value: T): Text;
}

class NumberConverter<T: Number>() extends Converter<T> {
  fun convert(value: T): Text {
    Raw(value.toString())
  }
}

class Opaque(mouse: Bool = true, keys: Bool = false)

class NodeSum(
  nodeInfoGetter: NodeInfoGetter,
  nodeOffsetsGetter: NodeOffsetsGetter,
  viewportGetter: ViewportGetter,
  size: Geometry.Size,
  optParent: ?Path,
  optViewport: ?Path,
)

class NodeOffsets(
  viewport: Geometry.Offset,
  relative: Geometry.Offset,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ NodeOffsets _ -> x
    | _ -> invariant_violation("Must be Ui.NodeOffsets")
    }
  }

  fun relativeViewport(): Geometry.Offset {
    this.viewport - this.viewport.floor()
  }
}

class NodeInfo(
  nodeSum: NodeSum,
  optUserData: ?UserData = None(),
  optDrawInfo: ?DrawInfo = None(),
) {
  //
  fun size(): Geometry.Size {
    this.nodeSum.size
  }

  fun viewport(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Geometry.Offset {
    this.nodeSum.nodeOffsetsGetter(context, isUntracked)
      .map(nos -> nos.viewport)
      .default(Geometry.Offset::zero)
  }

  fun getWindowBounds(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
    offsetsUntracked: Bool = false,
  ): Geometry.Rect {
    Geometry.Rect::fromOffsetSize(
      this.getWindowOffset(context, isUntracked, offsetsUntracked),
      this.nodeSum.size,
    )
  }

  fun getWindowOffset(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
    offsetsUntracked: Bool = false,
  ): Geometry.Offset {
    this.nodeSum.nodeOffsetsGetter(context, offsetsUntracked)
      .map(nodeOffsets ->
        nodeOffsets.viewport +
          this.nodeSum.optViewport.map(vp ->
            this.getParentViewportOffset(context, vp, isUntracked)
          ).default(Geometry.Offset::zero)
      )
      .default(Geometry.Offset::zero);
  }

  fun getParentViewportOffset(
    context: mutable SKStore.Context,
    path: Path,
    isUntracked: Bool = false,
    offsetsUntracked: Bool = false,
  ): Geometry.Offset {
    vp = this.nodeSum.viewportGetter(context, path, isUntracked);
    offset = vp.offset.toOffset();
    if (vp.optViewport.map(pVp ~> pVp != path).default(false)) {
      ni = this.nodeSum.nodeInfoGetter(context, path, isUntracked);
      offset + ni.getWindowOffset(context, isUntracked, offsetsUntracked);
    } else {
      offset
    }
  }
}

