base class Widget protected {
  path: Path,
  optConfiguration: ?Getter<Configuration> = None(),
  protected tick: SKStore.Tick,
} uses HasClassName {
  fun getNode(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node;

  fun getViewportDefinition(context: mutable SKStore.Context): ?ViewportDef;

  fun checkFocusHandlers(
    context: mutable SKStore.Context,
    nodeInfo: Getter<NodeInfo>,
    handlers: readonly Vector<FWK.FocusHandler>,
  ): Vector<FWK.FocusHandler>;

  overridable fun getHoverHandler(
    _context: mutable SKStore.Context,
    _childGetter: Getter<?FWK.HoverHandler>,
  ): ?HoverHandlerGetter {
    None()
  }

  overridable fun getLockHandler(
    _context: mutable SKStore.Context,
    _childGetter: Getter<?FWK.LockHandler>,
  ): ?LockHandlerGetter {
    None()
  }

  overridable fun getDragHandler(
    _context: mutable SKStore.Context,
    _childGetter: Getter<?FWK.DragHandler>,
  ): ?DragHandlerGetter {
    None()
  }

  overridable fun getDropHandler(
    _context: mutable SKStore.Context,
    _childGetter: Getter<?FWK.DropHandler>,
  ): ?DropHandlerGetter {
    None()
  }

  overridable fun computeDrawInfo(
    _context: mutable SKStore.Context,
    _support: DrawableSupport,
    _relative: Geometry.Offset,
    _nodeSum: NodeSum,
    _optUserData: ?UserData,
  ): ?DrawInfo {
    None()
  }

  overridable fun computeLayer(
    _context: mutable SKStore.Context,
    _support: DrawableSupport,
    _absolute: Geometry.Offset,
    _layer: LayerId,
    _node: NodeInfo,
  ): Array<Drawable> {
    Array[]
  }

  protected fun getPath(): Path {
    this.path
  }
}

class WidgetFile(widget: Widget) extends SKStore.File {
  static fun type(obj: SKStore.File): WidgetFile {
    obj match {
    | x @ WidgetFile _ -> x
    | _ -> SKStore.cast_violation("Ui.WidgetFile", obj)
    }
  }
}

class Node(
  widget: Widget,
  size: Geometry.Size,
  subNodes: Array<NChild> = Array[],
  userData: UserDataGetter = constUserData(None()),
  manageVisibility: Bool = false,
  reversedEvents: Bool = false,
) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Node _ -> x
    | _ -> invariant_violation("Must be Ui.Node")
    }
  }

  static fun reversed(
    widget: Widget,
    size: Geometry.Size,
    subNodes: Array<NChild> = Array[],
    userData: UserDataGetter = constUserData(None()),
    manageVisibility: Bool = false,
  ): Node {
    Node(widget, size, subNodes, userData, manageVisibility, true)
  }

  //
  fun getEventsNode(): Array<NChild> {
    if (this.reversedEvents) {
      this.subNodes.reversed()
    } else {
      this.subNodes
    };
  }
}

class Badge(text: Text, optMaxCharCount: ?Int = None()) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Badge _ -> x
    | _ -> SKStore.cast_violation("Ui.Badge", obj)
    }
  }
}

base class Progress extends SKStore.File {
  children =
  | Indeterminate()
  | Progression(Int)

  static fun fromInt(value: Int): Progress {
    if (value >= 0) Ui.Progression(value) else Ui.Indeterminate()
  }

  static fun btype(obj: SKStore.File): Progress {
    obj match {
    | x @ Progress _ -> x
    | _ -> SKStore.cast_violation("Ui.Progress", obj)
    }
  }
}

type NodeGetter = (mutable SKStore.Context, Path, Bool) ~> Node;
type ViewportGetter = (mutable SKStore.Context, Path, Bool) ~> NViewport;
type NodeInfoGetter = (mutable SKStore.Context, Path, Bool) ~> NodeInfo;
type NodeOffsetsGetter = (mutable SKStore.Context, Bool) ~> ?NodeOffsets;

base class NChild(constraints: BoxConstraints) {
  children =
  | CNode(node: Node, offset: Geometry.Offset)
  | CLink(path: Path, bounds: Geometry.Rect, opaque: Opaque)

  fun getOffset(): Geometry.Offset
  | CNode(__, offset, _) -> offset
  | CLink(_, bounds, _, _) -> bounds.topLeft()

  fun getSize(): Geometry.Size
  | CNode(node, _, _) -> node.size
  | CLink(_, bounds, _, _) -> bounds.size()

  fun getBounds(): Geometry.Rect
  | CNode(node, offset, _) -> Geometry.Rect::fromOffsetSize(offset, node.size)
  | CLink(_, bounds, _, _) -> bounds

  fun getMouseNode(
    context: mutable SKStore.Context,
    nodeGetter: NodeGetter,
    viewportGetter: ViewportGetter,
    isUntracked: Bool = false,
  ): (Geometry.Offset, Node, Bool)
  | CNode(node, _, _) -> (Geometry.Offset::zero, node, false)
  | CLink(path, _, opaque, _) ->
    viewport = viewportGetter(context, path, isUntracked);
    node = nodeGetter(context, path, isUntracked);
    (viewport.offset.toOffset(), node, opaque.mouse)

  fun getKeysNode(
    context: mutable SKStore.Context,
    nodeGetter: NodeGetter,
    isUntracked: Bool = false,
  ): (Node, Bool)
  | CNode(node, _, _) -> (node, false)
  | CLink(path, _, opaque, _) ->
    node = nodeGetter(context, path, isUntracked);
    (node, opaque.keys)
}

base class Parameters extends SKStore.File

base class Cache {
  static fun create(path: Ui.Path): this;
  fun init(context: mutable SKStore.Context, w: ParameterizedWidget): void;
}

base class NodeBuffer extends Cache {
  fun getNode(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node;
}

base class ParameterizedWidget protected {
  protected cache: this::Buffer,
} extends Widget {
  //
  type Params: Parameters;
  type Buffer: Cache;

  protected static deferred fun makeWithCache(
    context: mutable SKStore.Context,
    params: this::Params,
    path: Path,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    // Create node cache
    w = static::make(
      context,
      path,
      params,
      static::makeCache(path),
      optConfiguration,
    );
    w.cache.init(context, w);
    w
  }

  protected static deferred fun makeCache(path: Path): this::Buffer;

  static deferred fun create(
    context: mutable SKStore.Context,
    path: Path,
    params: this::Params,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static::makeWithCache(context, params, path, optConfiguration);
  }

  protected static deferred fun make(
    context: mutable SKStore.Context,
    path: Path,
    params: this::Params,
    cache: this::Buffer,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this;

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node;
}

base class StrictWidget extends ParameterizedWidget {
  type Buffer: NodeBuffer;

  fun getNode(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    this.cache.getNode(context, constraints)
  }
}

base class Hoverable {
  fun isHover(context: mutable SKStore.Context): Bool;
  fun hover(context: mutable SKStore.Context): void;
}

class Widgets(value: Array<Widget>) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Widgets _ -> x
    | _ -> invariant_violation("Must be Ui.Widgets")
    }
  }
}

base class WidgetsCollection extends SKStore.File {
  fun getSize(context: mutable SKStore.Context): Int;
  fun getWidget(context: mutable SKStore.Context, index: Int): Widget;

  overridable fun all(context: mutable SKStore.Context): Array<Widget> {
    this.collect(context)
  }

  protected fun collect(context: mutable SKStore.Context): Array<Widget> {
    Array::fillBy(this.getSize(context), index ->
      this.getWidget(context, index)
    )
  }

  static fun type(obj: SKStore.File): WidgetsCollection {
    obj match {
    | x @ WidgetsCollection _ -> x
    | _ -> SKStore.cast_violation("Ui.WidgetsCollection", obj)
    }
  }
}

class WidgetsArray(widgets: Array<Widget>) extends WidgetsCollection {
  fun getSize(_context: mutable SKStore.Context): Int {
    this.widgets.size()
  }
  fun getWidget(_context: mutable SKStore.Context, index: Int): Widget {
    this.widgets[index]
  }
  fun all(_context: mutable SKStore.Context): Array<Widget> {
    this.widgets
  }
}

class WidgetsGetterArray(
  widgets: Array<Ui.Getter<Widget>>,
) extends WidgetsCollection {
  fun getSize(_context: mutable SKStore.Context): Int {
    this.widgets.size()
  }
  fun getWidget(context: mutable SKStore.Context, index: Int): Widget {
    this.widgets[index](context)
  }
}

class MergeCollection(
  c1: WidgetsCollection,
  c2: WidgetsCollection,
) extends WidgetsCollection {
  //
  fun getSize(context: mutable SKStore.Context): Int {
    this.c1.getSize(context) + this.c2.getSize(context)
  }

  fun getWidget(context: mutable SKStore.Context, index: Int): Widget {
    size = this.c1.getSize(context);
    if (index < size) {
      this.c1.getWidget(context, index);
    } else {
      this.c2.getWidget(context, index - size);
    }
  }
}

class HandledCollection(
  handle: SKStore.Handle<SKStore.Key, SKStore.File>,
  keyConv: SKStore.Key ~> SKStore.Key = k ~> k,
  withIndex: Bool = false,
) extends WidgetsCollection {
  //
  fun getSize(context: mutable SKStore.Context): Int {
    this.handle.getInt(context, this.keyConv(SKStore.KSize()))
  }

  fun getWidget(context: mutable SKStore.Context, index: Int): Widget {
    if (this.withIndex) {
      WidgetFile::type(
        this.handle.get(context, this.keyConv(SKStore.IID(index))),
      ).widget
    } else {
      key = (this.handle.get(
        context,
        this.keyConv(SKStore.KKeys()),
      ) as SKStore.Keys _).value[index];
      WidgetFile::type(this.handle.get(context, key)).widget
    }
  }

  fun all(context: mutable SKStore.Context): Array<Widget> {
    if (this.withIndex) {
      this.collect(context)
    } else {
      this.handle.maybeGetProp(
        context,
        this.keyConv(SKStore.KKeys()),
        SKStore.Keys::type,
      )
        .map(keys ->
          keys.value.map(key ->
            WidgetFile::type(this.handle.get(context, key)).widget
          )
        )
        .default(Array[])
    }
  }
}

base class WInfo extends SKStore.File {
  children =
  | WSize(value: Int)
  | WKeys(value: Array<SKStore.Key>)
  | WElem(value: Widget)

  static fun btype(obj: SKStore.File): WInfo {
    obj match {
    | x @ WInfo _ -> x
    | _ -> SKStore.cast_violation("Ui.WInfo", obj)
    }
  }
}

class KIndexedCollection(
  handle: SKStore.Handle<SKStore.KIndexed, WInfo>,
) extends WidgetsCollection {
  //
  fun getSize(context: mutable SKStore.Context): Int {
    WSize::type(this.handle.get(context, SKStore.KSize())).value
  }

  fun getWidget(context: mutable SKStore.Context, index: Int): Widget {
    key = WKeys::type(this.handle.get(context, SKStore.KKeys())).value[index];
    WElem::type(this.handle.get(context, SKStore.KIdx(key))).value
  }

  fun all(context: mutable SKStore.Context): Array<Widget> {
    this.handle.maybeGetProp(context, SKStore.KKeys(), WKeys::type)
      .map(keys ->
        keys.value.map(key ->
          WElem::type(this.handle.get(context, SKStore.KIdx(key))).value
        )
      )
      .default(Array[])
  }
}

