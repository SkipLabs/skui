module Ui;

extension class Path extends JSONValue {
  fun toJSON(): JSON.Value {
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "id" => JSON.String(this.id),
        "parrent" => this.optParent.map(p -> p.toJSON()).default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  }

  static fun fromJSON(jsv: JSON.Value): Path {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "Ui.Path" ->
      Path(jso.getString("id"), jso.maybeGet("parrent").map(Path::fromJSON))
    | _ -> invariant_violation(`Invalid json object ${cl} for Ui.Path`)
    }
  }
}

extension base class Scroll extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | Start(position)
  | End(position) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "position" => JSON.IntNumber(position),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Scroll {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "Ui.Start" -> Start(jso.getInt("position"))
    | "Ui.End" -> End(jso.getInt("position"))
    | _ -> invariant_violation(`Invalid json object ${cl} for Ui.Scroll`)
    }
  }
}

extension base class Visible extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | Pos(value, tick)
  | Incr(value, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.IntNumber(value),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Visible {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "Ui.Pos" -> Pos(jso.getInt("value"), SKFS.Tick(jso.getInt("tick")))
    | "Ui.Incr" -> Incr(jso.getInt("value"), SKFS.Tick(jso.getInt("tick")))
    | _ -> invariant_violation(`Invalid json object ${cl} for Ui.Visible`)
    }
  }
}

extension base class Timed extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | TimedBool(value, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.Bool(value),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )
  | TimedString(value, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.String(value),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )
  | TimedInt(value, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.IntNumber(value),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )
  | TimedRange(value, tick)
  | TimedStatus(value, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => value.toJSON(),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Timed {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "Ui.TimedBool" ->
      TimedBool(jso.getBool("value"), SKFS.Tick(jso.getInt("tick")))
    | "Ui.TimedString" ->
      TimedString(jso.getString("value"), SKFS.Tick(jso.getInt("tick")))
    | "Ui.TimedInt" ->
      TimedInt(jso.getInt("value"), SKFS.Tick(jso.getInt("tick")))
    | "Ui.TimedRange" ->
      TimedRange(
        Range::fromJSON(jso.get("value")),
        SKFS.Tick(jso.getInt("tick")),
      )
    | "Ui.TimedStatus" ->
      TimedStatus(
        Status::fromJSON(jso.get("value")),
        SKFS.Tick(jso.getInt("tick")),
      )
    | _ -> invariant_violation(`Invalid json object ${cl} for Ui.Timed`)
    }
  }
}

