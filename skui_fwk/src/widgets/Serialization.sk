extension base class Separation extends JSONValue {
  fun toJSON(): JSON.Value
  | FromStart(value)
  | FromEnd(value)
  | Percent(value) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.IntNumber(value),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Separation {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "Ui.FromStart" -> FromStart(JSON.getInt("value", jso))
    | "Ui.FromEnd" -> FromEnd(JSON.getInt("value", jso))
    | "Ui.Percent" -> Percent(Math.clamp(JSON.getInt("value", jso), 0, 100))
    | _ ->
      invariant_violation(`Invalid json object ${cl} for UiSplit.Separation`)
    }
  }
}

extension class Size extends JSONValue {
  fun toJSON(): JSON.Value {
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "width" => this.width.toJSON(),
        "height" => this.height.toJSON(),
        "keepRatio" => JSON.Bool(this.keepRatio),
      ],
    )
  }

  static fun fromJSON(jsv: JSON.Value): Size {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "Ui.Size" ->
      Size(
        Ui.Dim::fromJSON(jso.get("width")),
        Ui.Dim::fromJSON(jso.get("height")),
        jso.getBool("keepRatio"),
      )
    | _ -> invariant_violation(`Invalid json object ${cl} for Ui.Size`)
    }
  }
}

extension base class Dim extends JSONValue {
  fun toJSON(): JSON.Value {
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.FloatNumber(this.value),
      ],
    )
  }

  static fun fromJSON(jsv: JSON.Value): Dim {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    value = JSON.getFloat("value", jso);
    cl match {
    | "Ui.Px" -> Px(value)
    | "Ui.Pt" -> Pt(value)
    | "Ui.Inch" -> Inch(value)
    | "Ui.Pica" -> Pica(value)
    | "Ui.Centimeter" -> Centimeter(value)
    | "Ui.Millimeter" -> Millimeter(value)
    | "Ui.RWidth" -> RWidth(value)
    | "Ui.RHeight" -> RHeight(value)
    | "Ui.RMin" -> RMin(value)
    | "Ui.RMax" -> RMax(value)
    | _ -> invariant_violation(`Invalid json object ${cl} for Ui.Dim`)
    }
  }
}

module end;
