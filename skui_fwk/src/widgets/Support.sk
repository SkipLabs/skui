module Ui;

const nodesPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/widgets/support/nodes/",
);

const nNodesPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/widgets/support/nnodes/",
);

const widgetsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/widgets/support/widgets/",
);

const childrensPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/widgets/support/childrens/",
);

class KConstraints(constraints: BoxConstraints) extends SKStore.Key {
  //
  fun toString(): String {
    width = this.intervalToString(this.constraints.width);
    height = this.intervalToString(this.constraints.height);
    `${width}-${height}`;
  }

  fun hash(): Int {
    h = this.getClassName().hash();
    Hashable.combine(h, this.constraints);
  }

  fun intervalToString(interval: Interval): String {
    `${this.boundaryToString(interval.min)}-${this.boundaryToString(
      interval.max,
    )}`
  }

  fun boundaryToString(boundary: Boundary): String {
    if (boundary.isFinite()) {
      value = (boundary.value * 10.0).toInt();
      included = if (boundary.included) "t" else "f";
      `b${value}${included}`
    } else {
      "inf"
    }
  }
}

fun nodesBufferPath(path: Ui.Path): SKStore.DirName {
  path.toDirName(nodesPath.toString())
}

fun widgetsBufferPath(path: Ui.Path): SKStore.DirName {
  path.toDirName(widgetsPath.toString())
}

fun childrensBufferPath(path: Ui.Path): SKStore.DirName {
  path.toDirName(childrensPath.toString())
}

fun nNodesBuffer(
  context: mutable SKStore.Context,
  widget: ParameterizedWidget,
  dirName: SKStore.DirName,
): SKStore.LHandle<KConstraints, Node> {
  SKStore.LHandle::lazy(
    KConstraints::keyType,
    Node::type,
    context,
    dirName,
    (context, _self, key) ~> widget.layout(context, key.constraints),
  )
}

class NodeCache(
  nodesHdl: SKStore.LHandle<KConstraints, Node>,
) extends NodeBuffer {
  static fun create(path: Ui.Path): this {
    NodeCache(
      SKStore.LHandle(KConstraints::keyType, Node::type, nodesBufferPath(path)),
    )
  }

  fun init(
    context: mutable SKStore.Context,
    widget: ParameterizedWidget,
  ): void {
    _ = nNodesBuffer(context, widget, this.nodesHdl.dirName)
  }

  fun getNode(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    this.nodesHdl.get(context, KConstraints(constraints))
  }
}

trait WithNodeCache {
  protected static fun makeCache(path: Path): NodeCache {
    NodeCache::create(path)
  }
}

module end;
