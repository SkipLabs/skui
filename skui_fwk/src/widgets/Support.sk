module Ui;

const nodesPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/widgets/support/nodes/",
);

const nNodesPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/widgets/support/nnodes/",
);

const widgetsPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/widgets/support/widgets/",
);

const childrensPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/widgets/support/childrens/",
);

class KConstraints(constraints: BoxConstraints) extends SKFS.BaseName {
  //
  fun toString(): String {
    width = this.intervalToString(this.constraints.width);
    height = this.intervalToString(this.constraints.height);
    `${width}-${height}`;
  }

  fun hash(): Int {
    h = this.getClassName().hash();
    Hashable.combine(h, this.constraints);
  }

  fun intervalToString(interval: Interval): String {
    `${this.boundaryToString(interval.min)}-${this.boundaryToString(
      interval.max,
    )}`
  }

  fun boundaryToString(boundary: Boundary): String {
    if (boundary.isFinite()) {
      value = (boundary.value * 10.0).toInt();
      included = if (boundary.included) "t" else "f";
      `b${value}${included}`
    } else {
      "inf"
    }
  }
}

fun nodesBufferPath(path: Ui.Path): SKFS.DirName {
  path.toDirName(nodesPath.toString())
}

fun widgetsBufferPath(path: Ui.Path): SKFS.DirName {
  path.toDirName(widgetsPath.toString())
}

fun childrensBufferPath(path: Ui.Path): SKFS.DirName {
  path.toDirName(childrensPath.toString())
}

fun nNodesBuffer(
  context: mutable SKFS.Context,
  widget: ParameterizedWidget,
  dirName: SKFS.DirName,
): SKFS.LHandle<Node> {
  SKFS.LHandle::lazy(Node::fromFile, context, dirName, (context, _self, key) ~> {
    key match {
    | k @ KConstraints _ -> widget.layout(context, k.constraints)
    | _ -> invariant_violation(`Invalid Ui.KConstraints key ${key}`)
    }
  })
}

class NodeCache(nodesHdl: SKFS.LHandle<Node>) extends NodeBuffer {
  static fun create(path: Ui.Path): this {
    NodeCache(SKFS.LHandle(Node::fromFile, nodesBufferPath(path)))
  }

  fun init(context: mutable SKFS.Context, widget: ParameterizedWidget): void {
    _ = nNodesBuffer(context, widget, this.nodesHdl.getDirName())
  }

  fun getNode(
    context: mutable SKFS.Context,
    constraints: BoxConstraints,
  ): Node {
    this.nodesHdl.get(context, KConstraints(constraints))
  }
}

trait WithNodeCache {
  protected static fun makeCache(path: Path): NodeCache {
    NodeCache::create(path)
  }
}

module end;
