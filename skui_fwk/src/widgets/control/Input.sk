module Ui;

class Input protected {
  controller: UiInput.Controller,
  state: UiInput.State,
} extends ParameterizedWidget {
  //
  type Params = UiInput.Parameters;
  type Buffer = UiInput.MetricsCache;

  static fun new(
    context: mutable SKFS.Context,
    path: Ui.Path,
    controller: UiInput.Controller,
    supplier: UiInput.Supplier,
  ): this {
    static::create(
      context,
      path,
      UiInput.init(context, path, controller, supplier),
    );
  }

  protected static fun make(
    context: mutable SKFS.Context,
    path: Ui.Path,
    params: UiInput.Parameters,
    cache: UiInput.MetricsCache,
    optConfiguration: ?Ui.Configuration = None(),
  ): this {
    static{
      path,
      controller => params.controller,
      state => params.state,
      optConfiguration,
      cache,
      tick => context.tick,
    }
  }

  protected static fun makeCache(path: Ui.Path): UiInput.MetricsCache {
    UiInput.MetricsCache::create(path)
  }

  fun getNode(
    context: mutable SKFS.Context,
    constraints: BoxConstraints,
  ): Node {
    this.cache.getNode(context, constraints)
  }

  fun getMetrics(context: mutable SKFS.Context, width: Float): UiInput.Metrics {
    this.cache.getMetrics(context, width)
  }

  fun layout(context: mutable SKFS.Context, constraints: BoxConstraints): Node {
    fontSupport = context.getFontSupport();
    textSupport = context.getTextSupport();
    height = UiInput.hSpace.toFloat();
    iconTextGap = context.getThemeThickness(UiTheme.IconTextGap()).toFloat();
    if (this.controller.isWithLabel(context)) {
      labelFaceId = context.getThemeFont(UiTheme.ILabel());
      !height =
        height +
        fontSupport.getLineHeight(context, labelFaceId) +
        UiInput.textGap.toFloat();
    };
    textOffset = height;
    faceId = context.getThemeFont(UiTheme.Basic());
    !height =
      height +
      fontSupport.getLineHeight(context, faceId) +
      UiInput.hSpace.toFloat();
    body = height;
    if (this.controller.isWithStatus(context)) {
      helperFaceId = context.getThemeFont(UiTheme.IHelper());
      !height =
        height +
        fontSupport.getLineHeight(context, helperFaceId) +
        UiInput.textGap.toFloat();
    };
    width = UiInput.vSpace.toFloat();
    leading = 0.0;
    this.controller.getIcon(context, faceId.size).each(icon -> {
      iSize = icon.size(context);
      !width = width + iSize.width + iconTextGap;
      !height = Math.max(height, iSize.height);
      !leading = iSize.width;
    });
    allText = 0.0;
    textHeight = 0.0;
    prefix = 0.0;
    this.controller.getPrefix(context).map(context.translate).each(str -> {
      tSize = textSupport.getSize(context, str, faceId);
      !prefix = tSize.width;
      !allText = allText + tSize.width + UiInput.vTextGap.toFloat();
      !textHeight = Math.max(textHeight, tSize.height);
    });
    suffix = 0.0;
    this.controller.getSuffix(context).map(context.translate).each(str -> {
      tSize = textSupport.getSize(context, str, faceId);
      !suffix = tSize.width;
      !allText = allText + tSize.width + UiInput.vTextGap.toFloat();
      !textHeight = Math.max(textHeight, tSize.height);
    });
    vs = Math.max(this.controller.getVisibleChars(context), 2);
    txt = String::fromChars(Array::fill(vs, 'W'));
    tSize = textSupport.getSize(context, txt, faceId);
    !allText = allText + tSize.width;
    !width = width + allText + UiInput.vSpace.toFloat();
    !textHeight = Math.max(textHeight, tSize.height);
    clear = 0.0;
    if (
      this.controller.isWithClear(context) &&
      this.controller.isEditable(context)
    ) {
      !width = width + 16.0 + iconTextGap;
      !clear = 16.0;
    };
    hide = 0.0;
    this.controller.getKind(context) match {
    | UiInput.Password() ->
      i1 = context.getThemeIcon(UiTheme.Show(true));
      i2 = context.getThemeIcon(UiTheme.Show(false));
      optSize1 = i1.buildIcon(context, faceId.size).map(ic -> ic.size(context));
      optSize2 = i2.buildIcon(context, faceId.size).map(ic -> ic.size(context));
      optSize = optSize1 match {
      | Some(s1) ->
        optSize2 match {
        | Some(s2) -> Some(s1.max(s2))
        | _ -> Some(s1)
        }
      | _ -> optSize2
      };
      optSize.each(iSize -> {
        !hide = iSize.width;
        !width = width + hide + iconTextGap;
        !height = Math.max(height, iSize.height)
      })
    | _ -> void
    };
    fire = 0.0;
    this.controller.getFireIcon(context, faceId.size).each(icon -> {
      iSize = icon.size(context);
      !fire = iSize.width;
      !width = width + fire + iconTextGap;
      !height = Math.max(height, iSize.height)
    });
    size = constraints.constrain(Geometry.Size(width, height));
    layout = UiInput.Layout(
      textOffset,
      allText,
      textHeight,
      body,
      width,
      height,
      prefix,
      suffix,
      fire,
      clear,
      hide,
      leading,
    );
    (fRect, _) = this.getTextBounds(
      Geometry.Offset::zero,
      size,
      layout,
      iconTextGap,
    );
    Node(
      this,
      size,
      Array[
        CLink(
          this.path.makeChild("vp"),
          fRect,
          Opaque(),
          BoxConstraints::new(),
        ),
      ],
      constUserData(Some(layout)),
    );
  }

  fun getHoverHandler(
    context: mutable SKFS.Context,
    _childGetter: Getter<?FWK.HoverHandler>,
  ): ?HoverHandlerGetter {
    if (this.controller.isDisabled(context)) {
      None()
    } else {
      Some((_, _, ni) ~> Some(UiInput.HoverHandler(this, ni)))
    }
  }

  fun checkFocusHandlers(
    context: mutable SKFS.Context,
    _nodeInfo: Ui.Getter<Ui.NodeInfo>,
    handlers: readonly Vector<FWK.FocusHandler>,
  ): Vector<FWK.FocusHandler> {
    if (this.controller.isDisabled(context)) {
      handlers.chill()
    } else {
      Vector[UiInput.FocusHandler{category => "input", input => this}]
    }
  }

  fun computeDrawInfo(
    context: mutable SKFS.Context,
    _support: Ui.DrawableSupport,
    _relative: Geometry.Offset,
    nodeSum: NodeSum,
    optUserData: ?UserData,
  ): ?DrawInfo {
    layout = optUserData.map(ud ~> ud as UiInput.Layout _).fromSome();
    Some(
      UiInput.OffsetLengths::compute(
        context,
        this,
        Geometry.Offset::zero,
        nodeSum.size,
        layout,
      ),
    );
  }

  fun computeLayer(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    drawables = mutable Vector<Ui.Drawable>[];
    layout = node.optUserData.map(ud ~> ud as UiInput.Layout _).fromSome();
    layer match {
    | MainLayer() ->
      ol = node.optDrawInfo.fromSome() as UiInput.OffsetLengths _;
      this.fillMain(context, support, ol.shift(absolute), drawables)
    | BackgroundLayer() ->
      this.fillBackground(
        context,
        support,
        absolute,
        node.size(),
        layout,
        drawables,
      )
    | ForegroundLayer() ->
      this.fillForeground(
        context,
        support,
        absolute,
        node.size(),
        layout,
        drawables,
      )
    };
    drawables.toArray()
  }

  fun getViewportDefinition(context: mutable SKFS.Context): ?ViewportDef {
    Some(
      ViewportDef(
        Some(
          UiInput.Viewport{
            path => this.path.makeChild("viewport"),
            input => this,
            tick => context.tick,
          },
        ),
        Array[],
        this.path.makeChild("vp"),
        None(),
      ),
    )
  }

  fun getDragHandler(
    context: mutable SKFS.Context,
    _childGetter: Getter<?FWK.DragHandler>,
  ): ?DragHandlerGetter {
    if (this.state.isMoveSelection(context, true)) {
      Some((context, offset, ni) ~> {
        (position, _, _, _, _) = this.getMousePosition(
          context,
          offset,
          ni,
          true,
        );
        this.state.getSelection(context) match {
        | Some(
          selection,
        ) if (
          UiInput.contains(selection, position) ||
          selection.end == position
        ) ->
          text = this.state.getText(context);
          content = FWKClipboard.Content::plain(
            String::fromChars(
              text.chars().slice(selection.start, selection.end).toArray(),
            ),
          );
          Some(
            UiInput.DragHandler{
              input => this,
              optClipboardContent => Some(content),
            },
          )
        | _ -> None()
        }
      })
    } else {
      None()
    }
  }

  fun getDropHandler(
    _context: mutable SKFS.Context,
    _childGetter: Getter<?FWK.DropHandler>,
  ): ?DropHandlerGetter {
    Some((_, _o, nodeInfo) ~>
      Some(UiInput.DropHandler{input => this, nodeInfo})
    );
  }

  fun computeViewportBounds(
    context: mutable SKFS.Context,
    nodeInfo: Ui.NodeInfo,
    iconTextGap: Float,
  ): Geometry.Rectangle {
    layout = nodeInfo.optUserData.map(l ~> l as UiInput.Layout _).fromSome();
    (bounds, _) = this.getTextBounds(
      nodeInfo.viewport(context),
      nodeInfo.size(),
      layout,
      iconTextGap,
    );
    bounds.toRectangle()
  }

  fun getMousePosition(
    context: mutable SKFS.Context,
    offset: Geometry.Offset,
    nodeInfo: Ui.NodeInfo,
    relative: Bool,
    limit: Bool = true,
  ): (Int, Bool, Bool, Bool, Bool) {
    layout = nodeInfo.optUserData.map(l ~> l as UiInput.Layout _).fromSome();
    viewport = nodeInfo.viewport(context, true);
    rOffset = if (relative) offset else {
      offset - viewport
    };
    (bounds, _) = this.getTextBounds(
      viewport,
      nodeInfo.size(),
      layout,
      context.getThemeThickness(UiTheme.IconTextGap()).toFloat(),
    );
    metrics = this.getMetrics(context, bounds.width());
    ol = nodeInfo.optDrawInfo.fromSome() as UiInput.OffsetLengths _;
    show = ol.optShow
      .map(sI -> {
        min = sI.i1.topLeft().dx;
        max = min + sI.i1.width();
        rOffset.dx > min && rOffset.dx < max
      })
      .default(false);
    clear = ol.optClear
      .map(rect -> {
        min = rect.topLeft().dx;
        max = min + rect.width();
        rOffset.dx > min && rOffset.dx < max
      })
      .default(false);
    fire = ol.optFireIcon
      .map(sI -> {
        min = sI.i1.topLeft().dx;
        max = min + sI.i1.width();
        rOffset.dx > min && rOffset.dx < max
      })
      .default(false);
    if (this.state.getSize(context) > 0) {
      xOffset = offset.dx - bounds.topLeft().dx;
      position = metrics
        .getPosition(xOffset, limit)
        .default(this.state.getPosition(context));
      (position, show, clear, fire, metrics.isIn(position))
    } else {
      (0, show, clear, fire, metrics.isIn(0))
    }
  }

  fun getStatus(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Status {
    this.state.getStatus(context, isUntracked);
  }

  private fun getTextBounds(
    absolute: Geometry.Offset,
    size: Geometry.Size,
    layout: UiInput.Layout,
    iconTextGap: Float,
  ): (Geometry.Rect, Geometry.Offset) {
    withIcons = size.width >= layout.width;
    withAnnexes = size.height >= layout.height;
    withPrefixAndSuffix =
      size.width - 2.0 * UiInput.vSpace.toFloat() >=
      layout.textWidth.toFloat();
    left = UiInput.vSpace.toFloat();
    right = size.width - UiInput.vSpace.toFloat();
    if (withIcons) {
      if (layout.icon > 0.0) {
        !left = left + layout.icon + iconTextGap
      };
      if (layout.clear > 0.0) {
        !right = right - layout.clear + iconTextGap
      };
      if (layout.fire > 0.0) {
        !right = right - layout.fire + iconTextGap
      };
    };
    if (withPrefixAndSuffix) {
      if (layout.prefix > 0.0) {
        !left = left + layout.prefix + UiInput.vTextGap.toFloat()
      };
      if (layout.suffix > 0.0) {
        !right = right - (layout.suffix + UiInput.vTextGap.toFloat())
      }
    };
    top = if (withAnnexes) {
      layout.textOffset;
    } else {
      Math.max((size.height - layout.textHeight) / 2.0, 0.0)
    };
    offset = absolute.translate(left, top);
    fRect = Geometry.Rect::fromOffsetSize(
      offset,
      Geometry.Size(right - left, Math.min(layout.textHeight, size.height)),
    );
    (fRect, offset);
  }

  private fun fillMain(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    ol: UiInput.OffsetLengths,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    textSupport = context.getTextSupport();
    faceId = context.getThemeFont(UiTheme.Basic());
    disabled = context.getThemeColor(UiTheme.Disabled());
    isDisabled = this.controller.isDisabled(context);
    focused = context.isFocused(this.path);
    informations = if (isDisabled) {
      disabled
    } else {
      context.getThemeColor(UiTheme.Information());
    };
    ol.optIcon.each(iInfo ->
      iInfo.i0.fillDrawables(
        context,
        support,
        iInfo.i1.topLeft(),
        iInfo.i1.size(),
        informations,
        drawables,
      )
    );
    lColor = if (isDisabled) {
      disabled
    } else if (focused) {
      context.getThemeColor(UiTheme.Primary())
    } else {
      informations
    };
    ol.optLabel.each(labelInfo -> {
      lFaceId = context.getThemeFont(UiTheme.ILabel());
      textSupport
        .getDrawables(context, labelInfo.i0, Text.Display(lFaceId, lColor))
        .each(ds -> ds.each(d -> drawables.push(d.translate(labelInfo.i1))))
    });
    ol.optPrefix.each(pInfo ->
      textSupport
        .getDrawables(context, pInfo.i0, Text.Display(faceId, informations))
        .each(ds -> ds.each(d -> drawables.push(d.translate(pInfo.i1))))
    );
    ol.optFireIcon.each(iInfo ->
      iInfo.i0.fillDrawables(
        context,
        support,
        iInfo.i1.topLeft(),
        iInfo.i1.size(),
        informations,
        drawables,
      )
    );
    ol.optClear.each(rect -> {
      offset = rect.topLeft();
      clear = rect.size().width;
      drawables.push(support.disk(offset, rect.size(), informations, 2.0));
      !offset = offset.translate(clear / 4.0, clear / 4.0);
      cSize = Geometry.Size::square(clear / 2.0);
      pushCrux(support, offset, cSize, -2.0, informations, drawables);
    });
    ol.optShow.each(iInfo ->
      iInfo.i0.fillDrawables(
        context,
        support,
        iInfo.i1.topLeft(),
        iInfo.i1.size(),
        informations,
        drawables,
      )
    );
    ol.optSuffix.each(sInfo ->
      textSupport
        .getDrawables(context, sInfo.i0, Text.Display(faceId, informations))
        .each(ds -> ds.each(d -> drawables.push(d.translate(sInfo.i1))))
    );
    ol.optPlaceHolder.each(phInfo ->
      Ui.drawConstrainedText(
        context,
        support,
        textSupport,
        phInfo.i0,
        phInfo.i1,
        informations,
        faceId,
        drawables,
      )
    );
    helperFaceId = context.getThemeFont(UiTheme.IHelper());
    ol.optCounter.each(cInfo ->
      textSupport
        .getDrawables(context, cInfo.i0, Text.Display(helperFaceId, lColor))
        .each(ds -> ds.each(d -> drawables.push(d.translate(cInfo.i1))))
    );
    ol.optStatusIcon.each(iInfo -> {
      iInfo.i0.fillDrawables(
        context,
        support,
        iInfo.i1.topLeft(),
        iInfo.i1.size(),
        iInfo.i2
          .map(l -> context.getThemeColor(UiTheme.Error(l)))
          .default(informations),
        drawables,
      )
    });
    ol.optStatusMessage.each(smInfo ->
      Ui.drawConstrainedText(
        context,
        support,
        textSupport,
        smInfo.i0,
        smInfo.i1,
        smInfo.i2
          .map(l -> context.getThemeColor(UiTheme.Error(l)))
          .default(informations),
        faceId,
        drawables,
      )
    );
  }

  private fun fillBackground(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    size: Geometry.Size,
    layout: UiInput.Layout,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    (color, body) = if (this.controller.isDisabled(context)) {
      (context.getThemeColor(UiTheme.Disabled()), size.height)
    } else {
      withAnnexes = size.height >= layout.height;
      (
        context.getThemeColor(
          UiTheme.Background(this.controller.isEditable(context)),
        ),
        if (withAnnexes) layout.body else size.height,
      )
    };
    drawables.push(
      support.roundedRectangle(
        absolute,
        size with {height => body},
        color,
        6.0,
      ),
    )
  }

  private fun fillForeground(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    size: Geometry.Size,
    layout: UiInput.Layout,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    focused = context.isFocused(this.path);
    disabled = this.controller.isDisabled(context);
    info = if (disabled) {
      (context.getThemeColor(UiTheme.Disabled()), 2.0)
    } else {
      hoverColor = context.getThemeColor(UiTheme.Regular()).scaleAlpha(0.2);
      hover = this.state.isHover(context);
      withAnnexes = size.height >= layout.height;
      body = if (withAnnexes) layout.body else size.height;
      if (hover) {
        drawables.push(
          support.roundedRectangle(
            absolute,
            size with {height => body},
            hoverColor,
            6.0,
          ),
        )
      };
      info = if (focused) {
        (context.getThemeColor(UiTheme.Primary()), 4.0)
      } else {
        (context.getThemeColor(UiTheme.Border()), 2.0)
      };
      status = this.state.getStatus(context);
      status match {
      | KO(_, level) -> (context.getThemeColor(UiTheme.Error(level)), info.i1)
      | _ -> info
      };
    };
    drawables.push(
      support.rectangle(
        absolute.translateY(layout.body - info.i1),
        size with {height => info.i1.toFloat()},
        info.i0,
      ),
    )
  }
}

fun pushCrux(
  support: Ui.DrawableSupport,
  offset: Geometry.Offset,
  size: Geometry.Size,
  thickness: Float,
  color: .Color,
  drawables: mutable Vector<Ui.Drawable>,
): void {
  ct = thickness / 2.0;
  drawables.push(support.diagonal(offset, size, true, -ct, color));
  drawables.push(support.diagonal(offset, size, true, ct, color));
  drawables.push(support.diagonal(offset, size, false, -ct, color));
  drawables.push(support.diagonal(offset, size, false, ct, color));
}

module end;
