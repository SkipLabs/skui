module Ui;

class Split protected {
  controller: UiSplit.Controller,
} extends StrictWidget uses WithNodeCache, FWK.NoFocusHandler {
  //
  type Params = UiSplit.Controller;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKFS.Context,
    path: Ui.Path,
    controller: UiSplit.Controller,
    cache: NodeCache,
    optConfiguration: ?Ui.Configuration = None(),
  ): this {
    static{path, controller, cache, optConfiguration, tick => context.tick}
  }

  fun layout(context: mutable SKFS.Context, constraints: BoxConstraints): Node {
    first = this.controller.getFirstWidget(context);
    second = this.controller.getSecondWidget(context);
    thickness =
      Math.ceil(context.getThemeThickness(UiTheme.Split()).toFloat() / 2.0) *
      2.0;
    separation = this.controller.getSeparation(context).get(context);
    this.controller.getAxis(context) match {
    | Ui.HorizontalAxis() ->
      (fc, sc) = if (constraints.hasBoundedWidth()) {
        width = constraints.maxWidth();
        firstWidth = Math.clamp(
          Math.floor(separation.toOffset(width) - (thickness / 2.0)),
          0.0,
          width - thickness,
        );
        fConstraints = constraints.withMaxWidth(firstWidth);
        secondWidth = Math.clamp(
          Math.floor(width - firstWidth - thickness),
          0.0,
          width - thickness,
        );
        sConstraints = constraints.withMaxWidth(secondWidth);
        (fConstraints, sConstraints)
      } else {
        (constraints, constraints)
      };
      fNode = first.getNode(context, fc);
      fWidth = Math.ceil(fNode.size.width);
      sNode = second.getNode(context, sc);
      offset = Geometry.Offset::zero;
      size = constraints.constrain(
        Geometry.Size(
          fWidth + thickness + sNode.size.width,
          Math.max(fNode.size.height, sNode.size.height),
        ),
      );
      Ui.Node(
        this,
        size,
        Array[
          CLink(
            this.path.makeChild("firstVp"),
            Geometry.Rect::fromOffsetSize(
              offset,
              Geometry.Size(fWidth, size.height),
            ),
            Opaque(false, false),
            fc,
          ),
          CLink(
            this.path.makeChild("secondVp"),
            Geometry.Rect::fromOffsetSize(
              offset.translateX(fWidth + thickness),
              Geometry.Size(sNode.size.width, size.height),
            ),
            Opaque(false, false),
            sc,
          ),
        ],
        _ctx ~>
          Some(
            UiSplit.UserData(
              Geometry.Rect::fromOffsetSize(
                offset.translateX(fWidth),
                Geometry.Size(thickness, size.height),
              ),
            ),
          )
        ,
      )
    | _ ->
      (fc, sc) = if (constraints.hasBoundedHeight()) {
        height = constraints.maxHeight();
        firstHeight = Math.clamp(
          Math.floor(separation.toOffset(height) - (thickness / 2.0)),
          0.0,
          height - thickness,
        );
        fConstraints = constraints.withMaxHeight(firstHeight);
        secondHeight = Math.clamp(
          Math.floor(height - firstHeight - thickness),
          0.0,
          height - thickness,
        );
        sConstraints = constraints.withMaxHeight(secondHeight);
        (fConstraints, sConstraints)
      } else {
        (constraints, constraints)
      };
      fNode = first.getNode(context, fc);
      fHeight = Math.ceil(fNode.size.height);
      sNode = second.getNode(context, sc);
      offset = Geometry.Offset::zero;
      size = constraints.constrain(
        Geometry.Size(
          Math.max(fNode.size.width, sNode.size.width),
          fHeight + thickness + sNode.size.height,
        ),
      );
      Ui.Node(
        this,
        size,
        Array[
          CLink(
            this.path.makeChild("firstVp"),
            Geometry.Rect::fromOffsetSize(
              offset,
              Geometry.Size(size.width, fHeight),
            ),
            Opaque(false, false),
            fc,
          ),
          CLink(
            this.path.makeChild("secondVp"),
            Geometry.Rect::fromOffsetSize(
              offset.translateY(fHeight + thickness),
              Geometry.Size(size.width, sNode.size.height),
            ),
            Opaque(false, false),
            sc,
          ),
        ],
        _ctx ~>
          Some(
            UiSplit.UserData(
              Geometry.Rect::fromOffsetSize(
                offset.translateY(fHeight),
                Geometry.Size(size.width, thickness),
              ),
            ),
          )
        ,
      )
    };
  }

  fun getViewportDefinition(context: mutable SKFS.Context): ?ViewportDef {
    first = this.controller.getFirstWidget(context);
    second = this.controller.getSecondWidget(context);
    optFirstVp = first.getViewportDefinition(context);
    optFSecondVp = second.getViewportDefinition(context);
    Some(
      ViewportDef(
        None(),
        Array[
          ViewportDef(
            Some(first),
            optFirstVp.map(def -> Array[def]).default(Array[]),
            this.path.makeChild("firstVp"),
            None(),
          ),
          ViewportDef(
            Some(second),
            optFSecondVp.map(def -> Array[def]).default(Array[]),
            this.path.makeChild("secondVp"),
            None(),
          ),
        ],
        this.path,
        None(),
      ),
    )
  }

  fun computeLayer(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    layer match {
    | BackgroundLayer()
    | ForegroundLayer() ->
      Array[]
    | MainLayer() ->
      node.optUserData
        .map(ud ~> ud as UiSplit.UserData _)
        .map(ud -> {
          rect = ud.bar.shift(absolute);
          Array[
            support.rectangle(
              rect.topLeft(),
              rect.size(),
              context.getThemeColor(UiTheme.Primary()),
            ),
          ]
        })
        .default(Array[])
    };
  }

  fun getHoverHandler(
    _context: mutable SKFS.Context,
    childGetter: Getter<?FWK.HoverHandler>,
  ): ?HoverHandlerGetter {
    Some((ctx, offset, ni) ~> {
      optChildHandler = childGetter(ctx);
      if (optChildHandler.isSome()) {
        optChildHandler
      } else if (this.isHoverSeparator(offset, ni)) {
        Some(UiSplit.HoverHandler(this))
      } else {
        None()
      }
    })
  }

  fun getLockHandler(
    _context: mutable SKFS.Context,
    childGetter: Getter<?FWK.LockHandler>,
  ): ?Ui.LockHandlerGetter {
    Some((ctx, mouse, ni) ~> {
      optChildHandler = childGetter(ctx);
      if (optChildHandler.isSome()) {
        optChildHandler
      } else if (
        mouse.isPrimaryPressed(ctx.tick) &&
        this.isHoverSeparator(mouse.offset(), ni)
      ) {
        Some(UiSplit.LockHandler(this))
      } else {
        None()
      }
    })
  }

  private fun isHoverSeparator(
    offset: Geometry.Offset,
    node: Ui.NodeInfo,
  ): Bool {
    node.optUserData
      .map(ud -> ud as UiSplit.UserData _)
      .map(ud -> ud.bar.contains(offset))
      .default(false)
  }
}

module end;
