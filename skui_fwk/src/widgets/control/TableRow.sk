module Ui;

class TableRow protected {
  controller: UiTableRow.Controller,
} extends StrictWidget uses WithNodeCache, NoViewports, FWK.NoFocusHandler {
  //
  type Params = UiTableRow.Controller;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Ui.Path,
    controller: UiTableRow.Controller,
    cache: NodeCache,
    optConfiguration: ?Ui.Configuration = None(),
  ): this {
    static{path, controller, optConfiguration, cache, tick => context.tick}
  }

  fun layout(
    context: mutable SKStore.Context,
    _constraints: BoxConstraints,
  ): Node {
    widths = this.controller.getWidths(context);
    height = this.controller.getHeight(context);
    cells = this.controller.getCells(context);
    left = 0.0;
    childVector = mutable Vector<Ui.NChild>[];
    cells.eachWithIndex((idx, cell) -> {
      cWidth = widths[idx];
      cContraints = BoxConstraints::tight(cWidth, height);
      node = cell.getNode(context, cContraints);
      childVector.push(CNode(node, Geometry.Offset(left, 0.0), cContraints));
      !left = left + cWidth;
    });
    Node(this, Geometry.Size(left, height), childVector.toArray());
  }

  fun computeDrawInfo(
    _context: mutable SKStore.Context,
    _support: Ui.DrawableSupport,
    _relative: Geometry.Offset,
    _nodeSum: Ui.NodeSum,
    _optUserData: ?UserData,
  ): ?DrawInfo {
    None()
  }

  fun getHoverHandler(
    _context: mutable SKStore.Context,
    childGetter: Getter<?FWK.HoverHandler>,
  ): ?HoverHandlerGetter {
    Some((context, _offset, _node) ~>
      Some(UiTableRow.HoverHandler(this.path, childGetter(context)))
    )
  }

  fun computeLayer(
    context: mutable SKStore.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    layer match {
    | MainLayer() -> Array[]
    | ForegroundLayer() ->
      left = -1.0;
      widths = this.controller.getWidths(context);
      drawables = mutable Vector<Ui.Drawable>[];
      height = node.size().height - 8.0;
      if (height > 1.0 && this.controller.hasSeparators(context)) {
        foreground = context.getThemeColor(UiTheme.Primary()).scaleAlpha(0.5);
        size = Geometry.Size(2.0, height);
        widths.eachWithIndex((idx, width) -> {
          if (idx != 0 && idx != widths.size() - 1) {
            drawables.push(
              support.rectangle(
                absolute.translate(left, 4.0),
                size,
                foreground,
              ),
            )
          };
          !left = left + width;
        });
      };
      drawables.toArray()
    | BackgroundLayer() ->
      drawables = mutable Vector<Ui.Drawable>[];
      selected = this.controller.isSelected(context);
      hover = this.controller.isHover(context);
      optAlpha = if (selected && hover) {
        Some(0.6)
      } else if (selected) {
        Some(0.4)
      } else if (hover) {
        Some(0.2)
      } else {
        None()
      };
      if (this.controller.isHighlighted(context)) {
        drawables.push(
          support.rectangle(
            absolute,
            node.size(),
            context.getThemeColor(UiTheme.Accent()).scaleAlpha(0.1),
          ),
        )
      };
      optAlpha.each(alpha -> {
        foreground = context.getThemeColor(UiTheme.Primary()).scaleAlpha(alpha);
        drawables.push(support.rectangle(absolute, node.size(), foreground))
      });
      drawables.toArray()
    };
  }
}

module end;
