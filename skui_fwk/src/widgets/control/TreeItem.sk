module Ui;

class TreeItem protected {
  reference: Ui.Path,
  id: Ui.Path,
  controller: UiTreeItem.Controller,
  state: UiTreeItem.State,
} extends StrictWidget uses WithNodeCache, NoViewports, FWK.NoFocusHandler {
  //
  type Params = UiTreeItem.Parameters;
  type Buffer = NodeCache;

  protected static fun make(
    context: mutable SKFS.Context,
    path: Ui.Path,
    params: UiTreeItem.Parameters,
    cache: NodeCache,
    optConfiguration: ?Ui.Configuration = None(),
  ): this {
    static{
      path,
      reference => params.reference,
      id => params.id,
      controller => params.controller,
      state => params.state,
      optConfiguration,
      cache,
      tick => context.tick,
    }
  }

  fun layout(context: mutable SKFS.Context, constraints: BoxConstraints): Node {
    ts = context.getTextSupport();
    fil = context.getThemeFont(UiTheme.Tree());
    label = Ui.getTextInfo(
      context,
      ts,
      fil,
      context.translate(this.controller.getText(context)),
    );
    fib = context.getThemeFont(UiTheme.Badge());
    optBadge = this.controller.getBadge(context).map(b -> {
      str = context.translate(b.text);
      Ui.getTextInfo(
        context,
        ts,
        fib,
        b.optMaxCharCount match {
        | Some(count) if (count > 0) ->
          chars = str.chars();
          if (chars.size() > count) {
            String::fromChars(chars.slice(0, count - 1).toArray()) + "+"
          } else {
            str
          }
        | _ -> str
        },
      )
    });
    optIcon = this.controller.getIcon(context, fil.size).map(icon ->
      (icon, icon.size(context))
    );
    layout = UiTreeItem.Layout(
      label,
      optBadge,
      optIcon,
      this.controller.isAllowExpansion(context),
      this.controller.getDepth(context),
      context.getThemeThickness(UiTheme.TreeTabulation()),
      context.getThemeThickness(UiTheme.IconTextGap()).toFloat(),
    );
    size = constraints.constrain(layout.computeSize());
    Node(this, size, Array[], constUserData(Some(layout)));
  }

  fun computeDrawInfo(
    context: mutable SKFS.Context,
    _relative: Geometry.Offset,
    nodeSum: Ui.NodeSum,
    optUserData: ?UserData,
  ): ?DrawInfo {
    layout = optUserData.map(ud ~> ud as UiTreeItem.Layout _).fromSome();
    Some(
      UiTreeItem.DrawInfo::compute(
        context,
        layout,
        Geometry.Offset::zero,
        nodeSum.size,
        context.getThemeThickness(UiTheme.IconTextGap()).toFloat(),
      ),
    );
  }

  fun getHoverHandler(
    _context: mutable SKFS.Context,
    _childGetter: Getter<?FWK.HoverHandler>,
  ): ?HoverHandlerGetter {
    Some((_, offset, node) ~> {
      layout = node.optUserData.map(ud ~> ud as UiTreeItem.Layout _).fromSome();
      Some(
        if (layout.expandable) {
          di = node.optDrawInfo
            .map(di ~> di as UiTreeItem.DrawInfo _)
            .fromSome();
          expand = di.optExpand.map(e -> e.contains(offset)).default(false);
          UiTreeItem.HoverHandler(
            this.path,
            this.controller,
            this.state,
            expand,
          )
        } else {
          UiTreeItem.HoverHandler(this.path, this.controller, this.state, false)
        },
      )
    })
  }

  fun computeLayer(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    layer: Ui.LayerId,
    node: Ui.NodeInfo,
  ): Array<Ui.Drawable> {
    di = node.optDrawInfo.map(di ~> di as UiTreeItem.DrawInfo _).fromSome();
    drawables = mutable Vector<Ui.Drawable>[];
    layer match {
    | MainLayer() -> this.fillMain(context, support, absolute, di, drawables)
    | BackgroundLayer() -> void
    | ForegroundLayer() ->
      this.fillForeground(
        context,
        support,
        absolute,
        node.size(),
        di,
        drawables,
      )
    };
    drawables.toArray()
  }

  fun getDragHandler(
    _context: mutable SKFS.Context,
    _childGetter: Getter<?FWK.DragHandler>,
  ): ?DragHandlerGetter {
    Some((_ctx, _o, _ni) ~> Some(UiTreeItem.DragHandler(this)))
  }

  fun getDropHandler(
    _context: mutable SKFS.Context,
    _childGetter: Getter<?FWK.DropHandler>,
  ): ?DropHandlerGetter {
    Some((_, o, ni) ~> {
      di = ni.optDrawInfo.map(di ~> di as UiTreeItem.DrawInfo _).fromSome();
      if (o.dx < ni.size().width / 2.0 || di.optExpand.isNone()) {
        if (o.dy > ni.size().height / 2.0) {
          Some(UiTreeItem.DropHandler(this, Ui.DropAfter()))
        } else {
          Some(UiTreeItem.DropHandler(this, Ui.DropBefore()))
        }
      } else {
        Some(UiTreeItem.DropHandler(this, Ui.DropIn()))
      }
    })
  }

  private fun fillMain(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    di: UiTreeItem.DrawInfo,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    selected = this.controller.isSelected(context);
    fill = if (selected) {
      context.getThemeColor(UiTheme.Primary());
    } else {
      context.getThemeColor(UiTheme.Regular());
    };
    di.optIcon.each(i ->
      i.i0.fillDrawables(
        context,
        support,
        absolute + i.i1,
        i.i2,
        fill,
        drawables,
      )
    );
    di.optExpand.each(expand -> {
      cSize = expand.size() / 2.0;
      cOffset = expand.topLeft().move(absolute + (cSize / 2.0).toOffset());
      drawables.push(
        support.triangle(
          cOffset,
          cSize,
          fill,
          if (this.controller.isExpanded(context)) UiSide.Bottom() else {
            UiSide.Right()
          },
        ),
      );
    });
    ts = context.getTextSupport();
    Ui.drawConstrainedText(
      context,
      support,
      ts,
      di.label.i0,
      di.label.i1.shift(absolute),
      fill,
      di.label.i2,
      drawables,
      di.label.i3,
    );
    di.optBadge.each(b -> {
      bSize = b.i3.size();
      (color, bFill) = (
        context.getThemeColor(UiTheme.Warn()),
        context.getThemeColor(UiTheme.Base()),
      );
      drawables.push(
        support.roundedRectangle(
          absolute + b.i3.topLeft(),
          bSize,
          color,
          bSize.height / 2.0,
        ),
      );
      b.i0.each(txt ->
        ts.getDrawables(context, txt, Text.Display(b.i2, bFill)).each(ds ->
          ds.each(d -> drawables.push(d.translate(absolute + b.i1)))
        )
      );
    });
  }

  private fun fillForeground(
    context: mutable SKFS.Context,
    support: Ui.DrawableSupport,
    absolute: Geometry.Offset,
    size: Geometry.Size,
    di: UiTreeItem.DrawInfo,
    drawables: mutable Vector<Ui.Drawable>,
  ): void {
    selected = this.controller.isSelected(context);
    focused = this.controller.isFocused(context);
    foreground = context.getThemeColor(UiTheme.Primary());
    optArmed = this.state.getArmed(context);
    optColor = if (optArmed == Some(false)) {
      Some(foreground.scaleAlpha(0.5))
    } else if (selected) {
      count = 1;
      if (selected) !count = count + 1;
      if (focused) !count = count + 1;
      Some(foreground.scaleAlpha(count.toFloat() / 10.0))
    } else {
      None()
    };
    optColor.each(color ->
      drawables.push(support.rectangle(absolute, size, color))
    );
    if (this.state.getHover(context).isSome()) {
      drawables.push(
        support.rectangle(
          absolute,
          size,
          context.getThemeColor(UiTheme.Regular()).scaleAlpha(0.2),
        ),
      )
    };
    if (focused && this.controller.isCurrent(context)) {
      pushStrokeRectangle(
        support,
        absolute,
        size,
        2.0,
        context.getThemeColor(UiTheme.Border()),
        drawables,
      );
    };
    this.controller.getProgress(context).each(progress -> {
      (bpOffset, bpSize) = (absolute, size with {width => 4.0});
      drawables.push(
        support.rectangle(bpOffset, bpSize, foreground.scaleAlpha(0.25)),
      );
      progress match {
      | Ui.Progression(value) ->
        percent = Math.clamp(value, 0, 100).toFloat() / 100.0;
        (pOffset, pSize) = (
          absolute,
          Geometry.Size(4.0, size.height * percent),
        );
        drawables.push(support.rectangle(pOffset, pSize, foreground))
      | Ui.Indeterminate() ->
        step = this.state.getIndeterminate(context) match {
        | Some(v) -> v
        | _ ->
          this.state.emitIndeterminate(context, 1);
          0
        };
        height = size.height / 4.0;
        (pOffset, pSize) = (
          absolute.translateY(step.toFloat() * height),
          Geometry.Size(4.0, height),
        );
        drawables.push(support.rectangle(pOffset, pSize, foreground))
      }
    });
    this.state.getTargeted(context).each(drop -> {
      (tOffset, tSize) = drop match {
      | Ui.DropBefore() ->
        (absolute.translateX(di.tab), Geometry.Size(size.width - di.tab, 3.0))
      | Ui.DropAfter() ->
        (
          absolute.translate(di.tab, size.height - 3.0),
          Geometry.Size(size.width - di.tab, 3.0),
        )
      | Ui.DropIn() ->
        (
          absolute.translate(di.inTab, size.height - 3.0),
          Geometry.Size(size.width - di.inTab, 3.0),
        )
      };
      drawables.push(
        support.rectangle(
          tOffset,
          tSize,
          context.getThemeColor(UiTheme.Accent()),
        ),
      )
    });
    di.optExpand.each(expand -> {
      eHover = this.state.getHover(context) == Some(true);
      eArmed = this.state.getArmed(context) == Some(true);
      (if (eArmed) {
        Some(foreground.scaleAlpha(0.6))
      } else if (eHover) {
        Some(foreground.scaleAlpha(0.3))
      } else {
        None()
      }).each(c ->
        drawables.push(
          support.ellipse(absolute + expand.topLeft(), expand.size(), c),
        )
      )
    });
  }
}

fun pushStrokeRectangle(
  support: Ui.DrawableSupport,
  offset: Geometry.Offset,
  size: Geometry.Size,
  thickness: Float,
  paint: Ui.Paint,
  drawables: mutable Vector<Ui.Drawable>,
): void {
  drawables.push(
    support.rectangle(offset, Geometry.Size(size.width, thickness), paint),
  );
  drawables.push(
    support.rectangle(
      offset.translate(size.width - thickness, thickness),
      Geometry.Size(thickness, size.height - (2.0 * thickness)),
      paint,
    ),
  );
  drawables.push(
    support.rectangle(
      offset.translateY(size.height - thickness),
      Geometry.Size(size.width, thickness),
      paint,
    ),
  );
  drawables.push(
    support.rectangle(
      offset.translateY(thickness),
      Geometry.Size(thickness, size.height - (2.0 * thickness)),
      paint,
    ),
  );
}

module end;
