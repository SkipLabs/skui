fun inputNameProp(idx: Int): SKStore.StrID {
  SKStore.StrID(`inputName_${idx}`)
}

fun outputNameProp(idx: Int): SKStore.StrID {
  SKStore.StrID(`outputName_${idx}`)
}

fun controllerDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/control/states/")
}

base class TextCommandsManager {
  fun manageAcquire(context: mutable SKStore.Context): void;
  fun getSelectToPosCommand(position: Position): SKUIMessage.Command;
  fun getGoToPosCommand(position: Position): SKUIMessage.Command;
  fun getSetMoveSelectionCommand(move: Bool): SKUIMessage.Command;
  fun getSetArmedCommand(armed: Bool): SKUIMessage.Command;
  fun getSelectGroupCommand(): SKUIMessage.Command;
  fun getSelectLineCommand(): SKUIMessage.Command;
  fun getSelectAllCommand(): SKUIMessage.Command;
  fun getDeleteSelectionCommand(): SKUIMessage.Command;
  fun getInsertCommand(
    str: String,
    ignoreSelection: Bool,
    position: Ui.Position,
  ): SKUIMessage.Command;
  fun getTargetCommand(optPosition: ?Position): SKUIMessage.Command;

  fun emitAll(
    context: mutable SKStore.Context,
    commands: readonly Vector<SKUIMessage.Command>,
  ): void;
}

module end;
