base class Kind extends SKFS.File {
  children =
  | Alert{text: Text, optTitle: ?Text = None()}
  | Question{
    text: Text,
    onConfirm: (mutable SKFS.Context, Bool, Int) ~> void,
    type_: QType = YesNo(),
    optTitle: ?Text = None(),
    autoClose: Bool = true,
  }
  | Input{
    message: Text,
    onInput: (mutable SKFS.Context, String, Int) ~> void,
    optTitle: ?Text = None(),
    autoClose: Bool = true,
    settings: Settings = Settings{},
  }
  | Custom(dirName: SKFS.DirName, key: String)

  fun toDialog(
    context: mutable SKFS.Context,
    path: Ui.Path,
    id: Int,
    close: mutable SKFS.Context ~> void,
  ): Ui.Dialog
  | Alert{text, optTitle} ->
    alert(context, path.makeChild("alert"), text, close, optTitle)
  | Question{text, onConfirm, type_, optTitle, autoClose} ->
    confirm(
      context,
      path.makeChild("confirm"),
      text,
      type_,
      ctx ~> {
        onConfirm(ctx, true, id);
        if (autoClose) {
          close(ctx)
        }
      },
      ctx ~> {
        onConfirm(ctx, false, id);
        if (autoClose) {
          close(ctx)
        }
      },
      Some(close),
      optTitle,
      autoClose,
    )
  | Input{message, onInput, optTitle, autoClose, settings} ->
    input(
      context,
      path.makeChild("input"),
      message,
      settings,
      (ctx, optStr) ~>
        optStr match {
        | Some(value) ->
          onInput(ctx, value, id);
          if (autoClose) {
            close(ctx)
          }
        | _ ->
          if (autoClose) {
            close(ctx)
          }
        },
      optTitle,
    )
  | Custom(dirName, key) ->
    handle = SKFS.EHandle<UiDialog.Builder>(UiDialog.Builder::forFile, dirName);
    handle.get(context, SKFS.StrID(key)).build(context, id, close)
}

base class Controller {
  fun getContent(context: mutable SKFS.Context): Ui.Widget;
}

base class State extends SKFS.File {
  fun getDialogCount(context: mutable SKFS.Context): Int;
  fun getDialog(context: mutable SKFS.Context, index: Int): Ui.Dialog;

  fun open(context: mutable SKFS.Context, kind: Kind): void;
  fun close(context: mutable SKFS.Context, id: Int): void;
  fun setVisible(context: mutable SKFS.Context, id: Int, visible: Bool): void;

  fun openAlert(
    context: mutable SKFS.Context,
    text: Text,
    optTitle: ?Text = None(),
  ): void;

  fun openConfirmDialog(
    context: mutable SKFS.Context,
    text: Text,
    onConfirm: (mutable SKFS.Context, Bool, Int) ~> void,
    autoClose: Bool = true,
    type_: UiDialogs.QType = UiDialogs.YesNo(),
    optTitle: ?Text = None(),
  ): void;

  fun openInputDialog(
    context: mutable SKFS.Context,
    message: Text,
    onInput: (mutable SKFS.Context, String, Int) ~> void,
    autoClose: Bool = true,
    optTitle: ?Text = None(),
    settings: Settings = Settings{},
  ): void;
}

class Parameters(controller: Controller, state: State) extends Ui.Parameters {}

class Collection(
  controller: Controller,
  state: State,
) extends Ui.WidgetsCollection {
  fun getSize(context: mutable SKFS.Context): Int {
    this.state.getDialogCount(context) + 1;
  }

  fun getWidget(context: mutable SKFS.Context, index: Int): Ui.Widget {
    if (index == 0) {
      this.controller.getContent(context)
    } else {
      this.state.getDialog(context, index - 1)
    }
  }
}

fun alert(
  context: mutable SKFS.Context,
  path: Ui.Path,
  message: Text,
  onClose: mutable SKFS.Context ~> void,
  optTitle: ?Text = None(),
): Ui.Dialog {
  content = Ui.VText::createForController(
    context,
    path.makeChild("message"),
    UiText.LamController{
      text => _ctx ~> message,
      style => ctx ~> {
        fill = ctx.getThemeColor(UiTheme.Message());
        faceId = ctx.getThemeFont(UiTheme.Message());
        Text.Style{faceId, fill, wrapping => Text.WordWrap()}
      },
    },
  );
  Ui.Dialog::create(
    context,
    path,
    UiDialog.LamController{
      kind => _ctx ~>
        UiDialog.LeftRight(
          Array[],
          Array[
            UiDialog.Action("close", !"OK", onClose, Some(UiDialog.Both())),
          ],
        ),
      content => _ctx ~> content,
      title => _ctx ~> optTitle,
      mainFocusable => _ctx ~> None(),
    },
  );
}

fun confirm(
  context: mutable SKFS.Context,
  path: Ui.Path,
  message: Text,
  qType: QType,
  onConfirm: mutable SKFS.Context ~> void,
  onDismiss: mutable SKFS.Context ~> void,
  optOnNeutral: ?mutable SKFS.Context ~> void = None(),
  optTitle: ?Text = None(),
  neutralInEach: Bool = false,
): Ui.Dialog {
  content = Ui.VText::createForController(
    context,
    path.makeChild("message"),
    UiText.LamController{
      text => _ctx ~> message,
      style => ctx ~> {
        fill = ctx.getThemeColor(UiTheme.Message());
        faceId = ctx.getThemeFont(UiTheme.Message());
        Text.Style{faceId, fill, wrapping => Text.WordWrap()}
      },
    },
  );
  (optNeutral, confirm, dismiss) = qType match {
  | YesNo(withNeutral) ->
    (if (withNeutral) Some(!"Cancel") else None(), !"Yes", !"No")
  | AcceptDecline(withNeutral) ->
    (if (withNeutral) Some(!"Cancel") else None(), !"Accept", !"Decline")
  | AgreeDisagree(withNeutral) ->
    (if (withNeutral) Some(!"Cancel") else None(), !"Agree", !"Disagree")
  | ConfirmDismiss(withNeutral) ->
    (if (withNeutral) Some(!"Cancel") else None(), !"Confirm", !"Dismiss")
  | QCustom(confirm, dismiss, optNeutral) -> (optNeutral, confirm, dismiss)
  };
  kind = UiDialog.LeftRight(
    optNeutral
      .flatMap(neutral ->
        optOnNeutral.map(perform ->
          Array[UiDialog.Action("neutral", neutral, perform)]
        )
      )
      .default(Array[]),
    Array[
      UiDialog.Action(
        "confirm",
        confirm,
        ctx ~> {
          if (neutralInEach) {
            optOnNeutral.each(perform -> perform(ctx));
          };
          onConfirm(ctx)
        },
        Some(UiDialog.Submit()),
      ),
      UiDialog.Action(
        "dismiss",
        dismiss,
        ctx ~> {
          if (neutralInEach) {
            optOnNeutral.each(perform -> perform(ctx));
          };
          onDismiss(ctx)
        },
        Some(UiDialog.Exit()),
      ),
    ],
  );
  Ui.Dialog::create(
    context,
    path,
    UiDialog.LamController{
      kind => _ctx ~> kind,
      content => _ctx ~> content,
      title => _ctx ~> optTitle,
      mainFocusable => _ctx ~> None(),
    },
  );
}

fun input(
  context: mutable SKFS.Context,
  path: Ui.Path,
  message: Text,
  settings: Settings,
  onSubmit: (mutable SKFS.Context, ?String) ~> void,
  optTitle: ?Text = None(),
): Ui.Dialog {
  contentPath = path.makeChild("content");
  textView = Ui.VText::createForController(
    context,
    contentPath.makeChild("message"),
    UiText.LamController{
      text => _ctx ~> message,
      style => ctx ~> {
        fill = ctx.getThemeColor(UiTheme.Message());
        faceId = ctx.getThemeFont(UiTheme.Message());
        Text.Style{faceId, fill, wrapping => Text.WordWrap()}
      },
    },
  );
  padding = Ui.Decorated::create(
    context,
    contentPath.makeChild("padding"),
    UiDecorated.LamController{
      decoration => _ctx ~> Ui.Padding(Geometry.Insets::only{bottom => 16.0}),
      widget => _ctx ~> Some(textView),
    },
  );
  controller = settings.toController(context);
  input = Ui.Input::new(
    context,
    contentPath.makeChild("input"),
    controller,
    settings.toSupplier(context),
  );
  content = Ui.Flex::createForController(
    context,
    contentPath,
    UiFlex.LamController{
      widgets => Ui.WidgetsArray(Array[padding, input]),
      direction => _ctx ~> Ui.VerticalAxis(),
      crossAxisAlignment => _ctx ~> UiFlex.CrossStretch(),
    },
  );
  disabled = settings.toDisabled(context);
  Ui.Dialog::create(
    context,
    path,
    UiDialog.LamController{
      kind => _ctx ~>
        UiDialog.LeftRight(
          Array[],
          Array[
            UiDialog.Action(
              "submit",
              !"Submit",
              ctx ~> {
                onSubmit(ctx, Some(input.state.getText(ctx, true)));
              },
              Some(UiDialog.Submit()),
              (ctx, iu) ~>
                disabled(ctx, iu) || !input.getStatus(ctx, iu).isGood()
              ,
            ),
            UiDialog.Action(
              "cancel",
              !"Cancel",
              ctx ~> {
                onSubmit(ctx, None());
              },
              Some(UiDialog.Exit()),
            ),
          ],
        ),
      content => _ctx ~> content,
      title => _ctx ~> optTitle,
      mainFocusable => _ctx ~> Some(input.path),
    },
  );
}

module end;
