module UiDialogs;

base class QType() {
  children =
  | YesNo(withNeutral: Bool = false)
  | AcceptDecline(withNeutral: Bool = false)
  | AgreeDisagree(withNeutral: Bool = false)
  | ConfirmDismiss(withNeutral: Bool = false)
  | QCustom(confirm: Text, dismiss: Text, optNeutral: ?Text)
}

