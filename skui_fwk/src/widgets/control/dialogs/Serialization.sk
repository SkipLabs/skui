extension base class QType extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | YesNo(withNeutral)
  | AcceptDecline(withNeutral)
  | AgreeDisagree(withNeutral)
  | ConfirmDismiss(withNeutral) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "withNeutral" => JSON.Bool(withNeutral),
      ],
    )
  | QCustom(confirm, dismiss, optNeutral) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "confirm" => confirm.toJSON(),
        "dismiss" => dismiss.toJSON(),
        "neutral" => optNeutral
          .map(neutral -> neutral.toJSON())
          .default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )

  static fun fromJSON(jsv: JSON.Value): QType {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiDialogs.YesNo" -> YesNo(jso.getBool("withNeutral"))
    | "UiDialogs.AcceptDecline" -> AcceptDecline(jso.getBool("withNeutral"))
    | "UiDialogs.AgreeDisagree" -> AgreeDisagree(jso.getBool("withNeutral"))
    | "UiDialogs.ConfirmDismiss" -> ConfirmDismiss(jso.getBool("withNeutral"))
    | "UiDialogs.QCustom" ->
      QCustom(
        Text::fromJSON(jso.get("confirm")),
        Text::fromJSON(jso.get("dismiss")),
        jso.maybeGet("neutral").map(Text::fromJSON),
      )
    | _ -> invariant_violation(`Invalid json object ${cl} for UiDialogs.Kind`)
    }
  }
}

extension class Settings extends JSONValue {
  //
  fun toJSON(): JSON.Value {
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "kind" => this.kind.toJSON(),
        "maxChars" => JSON.IntNumber(this.maxChars),
        "visibleChars" => JSON.IntNumber(this.visibleChars),
        "text" => this.optText.map(toJSON).default(JSON.Null()),
        "position" => this.optPosition.map(toJSON).default(JSON.Null()),
        "selection" => this.optSelection.map(toJSON).default(JSON.Null()),
        "status" => this.optStatus.map(toJSON).default(JSON.Null()),
        //
        "prefix" => this.optPrefix.map(toJSON).default(JSON.Null()),
        "suffix" => this.optSuffix.map(toJSON).default(JSON.Null()),
        "placeHolder" => this.optPlaceHolder.map(toJSON).default(JSON.Null()),
        "tooltip" => this.optTooltip.map(toJSON).default(JSON.Null()),
        "icon" => this.optIcon.map(toJSON).default(JSON.Null()),
        "disabled" => this.optDisabled.map(toJSON).default(JSON.Null()),
        "withCounter" => this.optWithCounter.map(toJSON).default(JSON.Null()),
        "withStatus" => this.optWithStatus.map(toJSON).default(JSON.Null()),
        "withClear" => this.optWithClear.map(toJSON).default(JSON.Null()),
        "alignRight" => this.optAlignRight.map(toJSON).default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  }

  static fun fromJSON(jsv: JSON.Value): Settings {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiDialogs.Settings" ->
      Settings{
        kind => UiInput.Kind::fromJSON(jso.get("kind")),
        maxChars => jso.getInt("maxChars"),
        visibleChars => jso.getInt("visibleChars"),
        //
        optText => jso.maybeGet("text"),
        optPosition => jso.maybeGet("position"),
        optSelection => jso.maybeGet("selection"),
        optStatus => jso.maybeGet("status"),
        //
        optSuffix => jso.maybeGet("suffix"),
        optPrefix => jso.maybeGet("prefix"),
        optPlaceHolder => jso.maybeGet("placeHolder"),
        optTooltip => jso.maybeGet("tooltip"),
        optIcon => jso.maybeGet("icon"),
        optDisabled => jso.maybeGet("disabled"),
        optWithCounter => jso.maybeGet("withCounter"),
        optWithStatus => jso.maybeGet("withStatus"),
        optWithClear => jso.maybeGet("withClear"),
        optAlignRight => jso.maybeGet("alignRight"),
      }
    | _ ->
      invariant_violation(`Invalid json object ${cl} for UiDialogs.Settings`)
    }
  }
}

fun linkToJSON(
  className: String,
  dirName: SKFS.DirName,
  property: SKFS.StrID,
): JSON.Value {
  JSON.Object(
    Map[
      "__class" => JSON.String(className),
      "dirName" => JSON.String(dirName.toString()),
      "property" => JSON.String(property.toString()),
    ],
  )
}

module end;
