module UiDialogs;

fun toJSON(jsv: JSONValue): JSON.Value {
  jsv.toJSON()
}

extension base class Command {
  //
  fun toJSON(): JSON.Value
  | Open(kind) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "kind" => kind.toJSON(),
      ],
    )
  | SetVisible(dialogId, visible) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "dialogId" => JSON.IntNumber(dialogId),
        "visible" => JSON.Bool(visible),
      ],
    )
  | Close(dialogId) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "dialogId" => JSON.IntNumber(dialogId),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Command {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiDialogs.Open" -> Open(Kind::fromJSON(jso.get("kind")))
    | "UiDialogs.Close" -> Close(jso.getInt("dialogId"))
    | "UiDialogs.SetVisible" ->
      SetVisible(jso.getInt("dialogId"), jso.getBool("visible"))
    | _ ->
      invariant_violation(`Invalid json object ${cl} for UiDialogs.Command`)
    }
  }
}

extension base class Kind extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | Alert{text, optTitle} ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "text" => text.toJSON(),
        "title" => optTitle.map(title -> title.toJSON()).default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  | Question{text, target, type_, optTitle, autoClose} ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "text" => text.toJSON(),
        "target" => target.toJSON(),
        "type" => type_.toJSON(),
        "title" => optTitle.map(toJSON).default(JSON.Null()),
        "autoClose" => JSON.Bool(autoClose),
      ].filter((_k, v) -> !v.isNull()),
    )
  | Input{message, target, optTitle, autoClose, settings} ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "message" => message.toJSON(),
        "target" => target.toJSON(),
        "settings" => settings.toJSON(),
        "title" => optTitle.map(toJSON).default(JSON.Null()),
        "autoClose" => JSON.Bool(autoClose),
      ].filter((_k, v) -> !v.isNull()),
    )
  | Custom(dirName, key) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "dirName" => JSON.String(dirName.toString()),
        "key" => JSON.String(key),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Kind {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiDialogs.Alert" ->
      Alert{
        text => Text::fromJSON(jso.get("text")),
        optTitle => jso.maybeGet("title").map(Text::fromJSON),
      }
    | "UiDialogs.Question" ->
      Question{
        text => Text::fromJSON(jso.get("text")),
        target => SKUIMessage.Target::fromJSON(jso.get("target")),
        type_ => QType::fromJSON(jso.get("type")),
        optTitle => jso.maybeGet("title").map(Text::fromJSON),
        autoClose => jso.getBool("autoClose"),
      }
    | "UiDialogs.Input" ->
      Input{
        message => Text::fromJSON(jso.get("message")),
        target => SKUIMessage.Target::fromJSON(jso.get("target")),
        optTitle => jso.maybeGet("title").map(Text::fromJSON),
        autoClose => jso.getBool("autoClose"),
        settings => Settings::fromJSON(jso.get("settings")),
      }
    | "UiDialogs.Custom" ->
      Custom(
        SKFS.DirName::create(jso.getString("dirName")),
        jso.getString("key"),
      )
    | _ -> invariant_violation(`Invalid json object ${cl} for UiDialogs.Kind`)
    }
  }
}
