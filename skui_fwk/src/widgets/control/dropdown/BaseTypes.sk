module UiDropdown;

fun widgetsDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/dropdown/widgets/")
}

fun dataDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/dropdown/data/")
}

base class ItemsCollection {
  fun getNumberOfItems(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Int;

  fun getItem(
    context: mutable SKStore.Context,
    index: Int,
    isUntracked: Bool = false,
  ): ItemBase;
}

base class Accessor{items: Ui.GetterOne<ItemsCollection, Bool>} {
  //
  fun getTitle(context: mutable SKStore.Context): ?Text;
}

base class ItemBase{
  id: String,
  text: mutable SKStore.Context ~> Text,
  icon: mutable SKStore.Context ~> ?UiIcon.Description = _ctx ~> None(),
  disabled: mutable SKStore.Context ~> Bool = _ctx ~> false,
  separator: mutable SKStore.Context ~> Ui.Separator = _ctx ~> Ui.Nil(),
} extends SKStore.File {
  children =
  | Item{
    shortcut: mutable SKStore.Context ~> ?Ui.Shortcut = _ ~> None(),
    perform: (mutable SKStore.Context) ~> void,
  }

  fun isMenu(): Bool
  | _i @ Item _ -> false
  | _m @ Menu _ -> true
}

class Menu extends ItemBase, Accessor {
  //
  fun getTitle(context: mutable SKStore.Context): ?Text {
    Some(this.text(context))
  }
}

class ArrayCollection(items: Array<ItemBase>) extends ItemsCollection {
  fun getNumberOfItems(
    _context: mutable SKStore.Context,
    _isUntracked: Bool = false,
  ): Int {
    this.items.size()
  }

  fun getItem(
    _context: mutable SKStore.Context,
    index: Int,
    _isUntracked: Bool = false,
  ): ItemBase {
    this.items[index]
  }
}

class LamCollection(
  numberOfItems: Ui.GetterOne<Int, Bool>,
  items: Ui.GetterTwo<ItemBase, Int, Bool>,
) extends ItemsCollection {
  fun getNumberOfItems(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Int {
    this.numberOfItems(context, isUntracked)
  }

  fun getItem(
    context: mutable SKStore.Context,
    index: Int,
    isUntracked: Bool = false,
  ): ItemBase {
    this.items(context, index, isUntracked)
  }
}

base class Spot {
  children =
  | Forward(idx: Int)
  | Backward()
}

base class Target {
  children =
  | Previous()
  | Next()
  | Idx(idx: Int)
}

base class Controller extends Accessor, SKStore.UserData {
  fun onClose(context: mutable SKStore.Context): void;

  fun getTitle(_context: mutable SKStore.Context): ?Text {
    None()
  }
}

base class State extends Ui.StateWithScroll {
  fun isSelected(context: mutable SKStore.Context, index: Int): Bool;
  fun getSelected(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?Int;
  fun isRoot(context: mutable SKStore.Context): Bool;
  fun getTitle(context: mutable SKStore.Context): ?Text;
  fun getNumberOfItems(context: mutable SKStore.Context): Int;
  fun getItem(context: mutable SKStore.Context, index: Int): ItemBase;
  fun getHover(context: mutable SKStore.Context): ?Ui.Path;
  fun getCurrent(context: mutable SKStore.Context): ?Ui.Path;
  fun getActive(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Active;

  fun setHover(context: mutable SKStore.Context, optPath: ?Ui.Path): void;
  fun setGoto(context: mutable SKStore.Context, value: Spot): void;
  fun setClose(context: mutable SKStore.Context): void;

  fun emitSelect(
    context: mutable SKStore.Context,
    value: Target,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;
}

base class Storage extends Ui.StorageWithScroll {
  fun getName(): String;
  fun getScope(): String;

  fun setTodo(context: mutable SKStore.Context, cmd: Ui.Executable): void;
}

class Parameters(controller: Controller, state: State) extends Ui.Parameters {}

class UserData(metrics: Ui.Metrics) extends Ui.UserData

class DrawInfo private () extends Ui.DrawInfo {
  static fun compute(
    context: mutable SKStore.Context,
    dropdown: Ui.Dropdown,
    metrics: Ui.Metrics,
  ): this {
    optEV = dropdown.state.getEnsureVisible(context);
    fMetrics = metrics.checkEnsureVisible(optEV);
    if (fMetrics.optScroll.isSome()) {
      dropdown.state.emitScroll(context, fMetrics.optScroll)
    };
    iOffset = fMetrics.offset.toInt();
    DrawInfo(Geometry.Point(0, iOffset))
  }
}

module end;
