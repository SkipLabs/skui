module UiDropdown;

class LamController{
  closeMessage: Ui.GetterOne<SKUIMessage.Message, Bool>,
} extends Controller {
  //
  static fun fromArray(
    items: Ui.GetterOne<Array<ItemBase>, Bool>,
    closeMessage: Ui.GetterOne<SKUIMessage.Message, Bool>,
  ): this {
    LamController{
      items => (ctx, ui) ~> ArrayCollection(items(ctx, ui)),
      closeMessage,
    }
  }

  fun getCloseMessage(
    context: mutable SKFS.Context,
    isUntracked: Bool,
  ): SKUIMessage.Message {
    this.closeMessage(context, isUntracked)
  }
}

module end;
