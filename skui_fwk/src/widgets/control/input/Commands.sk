module UiInput;

base class Executable extends Ui.Executable {
  children =
  | SetStatus(status: Status, source: Int)
  | SetText(value: String, source: Int)
  | SetPosition(value: Int, source: Int)
  | SetSelection(optValue: ?Range, source: Int)
}

base class Command extends SKUIMessage.Command {
  children =
  | SetHover(value: Bool)
  | SetArmed(value: Bool)
  | SetShowing(value: Bool)
  | SetMoveSelection(moveSelection: Bool)
  | SetScroll(optScroll: ?Scroll)
  | CancelScrolling(tick: SKStore.Tick)
  | Reset()
  | SetBlinking(value: Bool)
  | ToggleHidden(tick: SKStore.Tick)
  | Multiples(commands: Array<Command>)
}

base class ExecCommand extends Command, Executable {
  children =
  | ManageDiacritic(char: Char)
  | ManageUnicode(optUnicode: ?Int)
  | ManageScrolling(value: Int, tick: SKStore.Tick)
  | Copy()
  | Cut()
  | Paste(content: FWKClipboard.Content)
  | Insert(text: String, ignoreSelection: Bool, optPosition: ?Int)
  | Upper()
  | Lower()
  | ManageTarget(optTarget: ?Int, scrolling: Bool)
}

base class Repeatable(
  optRepeatOn: ?FWK.Repeat = None(),
  count: Int = 1,
) extends ExecCommand {
  children =
  | GoTo(target: Target)
  | SelectTo(target: Target, ensureVisible: Bool = true)
  | DeleteTo(target: Target)
  | Undo()
  | Redo()

  fun next(): this {
    !this.count = this.count + 1;
    this;
  }
}

module end;
