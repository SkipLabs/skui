module UiInput;

class FocusHandler{
  input: Ui.Input,
} extends Ui.TabFocusHandler uses FWK.Shortcuts {
  //
  fun getIdentifier(): Ui.Path {
    this.input.path;
  }

  fun enter(context: mutable SKFS.Context): void {
    this.input.state.emitBlinking(context, true)
  }

  fun exit(context: mutable SKFS.Context): void {
    this.input.state.emitBlinking(context, false);
    _ = emitMessage(
      context,
      this.input.state,
      this.input.controller.getFocusLostMessages,
    )
  }

  protected fun getShortcuts(
    context: mutable SKFS.Context,
  ): Array<FWK.ShortcutAction> {
    getShortcuts(context, this.input.state, this.input.controller)
  }

  protected fun beforeShortcuts(
    _context: mutable SKFS.Context,
    _keys: UiEvent.KeysFile,
  ): Bool {
    false
  }

  protected fun afterShortcuts(
    context: mutable SKFS.Context,
    keys: UiEvent.KeysFile,
  ): Bool {
    if (this.input.controller.isEditable(context)) {
      keys.getChar(false, false, context.tick) match {
      | Some(info) ->
        info match {
        | UiEvent.Unicode(char) ->
          this.input.state.emitUnicode(context, toNumber(char))
        | UiEvent.Diacritic(char) ->
          this.input.state.emitDiacritic(context, char)
        | UiEvent.Letter(char) ->
          this.input.state.emitInsert(context, char.toString(), false, None())
        | UiEvent.Word(chars) ->
          this.input.state.emitInsert(
            context,
            String::fromChars(chars),
            false,
            None(),
          )
        };
        true
      | _ -> false
      };
    } else {
      false;
    }
  }
}

fun emitMessage(
  context: mutable SKFS.Context,
  state: State,
  messages: Message,
): Bool {
  send = () -> {
    text = state.getText(context, true);
    msgs = messages(context, text, true);
    msgs.each(msg -> FWKMessage.emitMessage(context, msg));
    !msgs.isEmpty();
  };
  state.getStatus(context, true) match {
  | OK _
  | Valid _ ->
    send()
  | KO(_, level) if (level != Error()) -> send()
  | _ -> false
  };
}

fun getShortcuts(
  context: mutable SKFS.Context,
  state: State,
  controller: Controller,
): Array<FWK.ShortcutAction> {
  shortcuts = mutable Vector<FWK.ShortcutAction>[];
  shortcuts.push(
    FWK.ShortcutAction(
      "goToPrevious",
      FWK.Shortcut(Array[UiEvent.pureKeyPressed(UiEvent.KeyInfo::arrowLeft)]),
      FWK.Repeatable((ctx, repeat) ~>
        state.emitGoTo(ctx, TColumn(false), repeat)
      ),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "goToNext",
      FWK.Shortcut(Array[UiEvent.pureKeyPressed(UiEvent.KeyInfo::arrowRight)]),
      FWK.Repeatable((ctx, repeat) ~>
        state.emitGoTo(ctx, TColumn(true), repeat)
      ),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "goToGroupBegin",
      FWK.Shortcut(Array[UiEvent.control(UiEvent.KeyInfo::arrowLeft)]),
      FWK.Repeatable((ctx, repeat) ~>
        state.emitGoTo(ctx, TGroup(Some(false)), repeat)
      ),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "goToGroupEnd",
      FWK.Shortcut(Array[UiEvent.control(UiEvent.KeyInfo::arrowRight)]),
      FWK.Repeatable((ctx, repeat) ~>
        state.emitGoTo(ctx, TGroup(Some(true)), repeat)
      ),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "goToBegin",
      FWK.Shortcut(Array[UiEvent.key(UiEvent.KeyInfo::home)]),
      FWK.Standard(ctx ~> state.emitGoTo(ctx, TLine(Some(false)))),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "goToEnd",
      FWK.Shortcut(Array[UiEvent.key(UiEvent.KeyInfo::end)]),
      FWK.Standard(ctx ~> state.emitGoTo(ctx, TLine(Some(true)))),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "fire",
      FWK.Shortcut(Array[UiEvent.pureKeyPressed(UiEvent.KeyInfo::enter)]),
      FWK.Skipable(ctx ~>
        emitMessage(ctx, state, controller.getActionMessages)
      ),
    ),
  );
  ///////// SELECTION
  shortcuts.push(
    FWK.ShortcutAction(
      "selectToPrevious",
      FWK.Shortcut(Array[UiEvent.shift(UiEvent.KeyInfo::arrowLeft)]),
      FWK.Repeatable((ctx, repeat) ~>
        state.emitSelectTo(ctx, TColumn(false), true, repeat)
      ),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "selectToNext",
      FWK.Shortcut(Array[UiEvent.shift(UiEvent.KeyInfo::arrowRight)]),
      FWK.Repeatable((ctx, repeat) ~>
        state.emitSelectTo(ctx, TColumn(true), true, repeat)
      ),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "selectToGroupBegin",
      FWK.Shortcut(Array[UiEvent.controlShift(UiEvent.KeyInfo::arrowLeft)]),
      FWK.Repeatable((ctx, repeat) ~>
        state.emitSelectTo(ctx, TGroup(Some(false)), true, repeat)
      ),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "selectToGroupEnd",
      FWK.Shortcut(Array[UiEvent.controlShift(UiEvent.KeyInfo::arrowRight)]),
      FWK.Repeatable((ctx, repeat) ~>
        state.emitSelectTo(ctx, TGroup(Some(true)), true, repeat)
      ),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "selectToBegin",
      FWK.Shortcut(Array[UiEvent.shift(UiEvent.KeyInfo::home)]),
      FWK.Standard(ctx ~> state.emitSelectTo(ctx, TLine(Some(false)))),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "selectToEnd",
      FWK.Shortcut(Array[UiEvent.shift(UiEvent.KeyInfo::end)]),
      FWK.Standard(ctx ~> state.emitSelectTo(ctx, TLine(Some(true)))),
    ),
  );
  shortcuts.push(
    FWK.ShortcutAction(
      "selectAll",
      FWK.Shortcut::selectAll(),
      FWK.Standard(ctx ~> state.emitSelectTo(ctx, TLine(None()))),
    ),
  );
  // UTILS
  shortcuts.push(
    FWK.ShortcutAction(
      "copySelection",
      FWK.Shortcut::copy(),
      FWK.Standard(state.emitCopy),
    ),
  );
  if (controller.getKind(context) == Password()) {
    shortcuts.push(
      FWK.ShortcutAction(
        "togglePassword",
        FWK.Shortcut(Array[UiEvent.controlChar('h')]),
        FWK.Standard(ctx ~> state.emitShowing(ctx, !state.isShowing(ctx))),
      ),
    );
  };
  if (controller.isEditable(context)) {
    shortcuts.push(
      FWK.ShortcutAction(
        "deletePrevious",
        FWK.Shortcut(Array[UiEvent.pureKeyPressed(UiEvent.KeyInfo::backspace)]),
        FWK.Repeatable((ctx, repeat) ~>
          state.emitDeleteTo(ctx, TColumn(false), repeat)
        ),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "deleteNext",
        FWK.Shortcut(Array[UiEvent.pureKeyPressed(UiEvent.KeyInfo::delete)]),
        FWK.Repeatable((ctx, repeat) ~>
          state.emitDeleteTo(ctx, TColumn(true), repeat)
        ),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "deleteToGroupBegin",
        FWK.Shortcut(Array[UiEvent.control(UiEvent.KeyInfo::backspace)]),
        FWK.Repeatable((ctx, repeat) ~>
          state.emitDeleteTo(ctx, TGroup(Some(false)), repeat)
        ),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "deleteToGroupEnd",
        FWK.Shortcut(Array[UiEvent.control(UiEvent.KeyInfo::delete)]),
        FWK.Repeatable((ctx, repeat) ~>
          state.emitDeleteTo(ctx, TGroup(Some(true)), repeat)
        ),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "deleteToBegin",
        FWK.Shortcut(
          Array[
            UiEvent.controlShift(
              UiEvent.KeyInfo::backspace,
              UiEvent.Key::isKeyPressed,
            ),
          ],
        ),
        FWK.Standard(ctx ~> state.emitDeleteTo(ctx, TLine(Some(false)))),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "deleteToEnd",
        FWK.Shortcut(
          Array[
            UiEvent.controlShift(
              UiEvent.KeyInfo::delete,
              UiEvent.Key::isKeyPressed,
            ),
          ],
        ),
        FWK.Standard(ctx ~> state.emitDeleteTo(ctx, TLine(Some(false)))),
      ),
    );
    // UTILS
    shortcuts.push(
      FWK.ShortcutAction(
        "upperSelection",
        FWK.Shortcut(Array[UiEvent.controlChar('u')]),
        FWK.Standard(state.emitUpper),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "lowerSelection",
        FWK.Shortcut(Array[UiEvent.controlShiftChar('u')]),
        FWK.Standard(state.emitLower),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "cutSelection",
        FWK.Shortcut::cut(),
        FWK.Standard(state.emitCut),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "paste",
        FWK.Shortcut::paste(),
        FWK.Standard(state.emitPaste),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "undo",
        FWK.Shortcut::undo(),
        FWK.Repeatable(state.emitUndo),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "redo",
        FWK.Shortcut::redo(),
        FWK.Repeatable(state.emitRedo),
      ),
    );
    shortcuts.push(
      FWK.ShortcutAction(
        "checkUnicode",
        FWK.Shortcut(Array[UiEvent.altReleased()]),
        FWK.Standard(ctx ~> state.emitUnicode(ctx, None())),
      ),
    );
  };
  shortcuts.toArray();
}

fun toNumber(char: Char): ?Int {
  char match {
  | '0' -> Some(0)
  | '1' -> Some(1)
  | '2' -> Some(2)
  | '3' -> Some(3)
  | '4' -> Some(4)
  | '5' -> Some(5)
  | '6' -> Some(6)
  | '7' -> Some(7)
  | '8' -> Some(8)
  | '9' -> Some(9)
  | _ -> None()
  }
}

module end;
