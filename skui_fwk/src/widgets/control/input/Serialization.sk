module UiInput;

fun toJSON(v: JSONValue): JSON.Value {
  v.toJSON()
}

extension base class Command {
  fun toJSON(): JSON.Value
  | Upper()
  | Lower()
  | Copy()
  | Cut()
  | Reset() ->
    JSON.Object(Map["__class" => JSON.String(this.getClassName())])
  | ToggleHidden(tick)
  | CancelScrolling(tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )
  | ManageScrolling(value, tick) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.IntNumber(value),
        "tick" => JSON.IntNumber(tick.value),
      ],
    )
  | Paste(content) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "content" => content.toJSON(),
      ],
    )
  | SetHover(value)
  | SetArmed(value)
  | SetShowing(value)
  | SetBlinking(value)
  | SetMoveSelection(value) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.Bool(value),
      ],
    )
  | SetScroll(optScroll) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => optScroll.map(toJSON).default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  | ManageUnicode(optUnicode) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "unicode" => optUnicode
          .map(unicode -> JSON.IntNumber(unicode))
          .default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  | ManageTarget(optTarget, scrolling) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "target" => optTarget
          .map(target -> JSON.IntNumber(target))
          .default(JSON.Null()),
        "scrolling" => JSON.Bool(scrolling),
      ].filter((_k, v) -> !v.isNull()),
    )
  | Insert(text, ignoreSelection, optPosition) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "text" => JSON.String(text),
        "ignoreSelection" => JSON.Bool(ignoreSelection),
        "position" => optPosition
          .map(p -> JSON.IntNumber(p))
          .default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  | ManageDiacritic(char) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "code" => JSON.IntNumber(char.code()),
      ],
    )
  | ManageUnicode(optUnicode) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "unicode" => optUnicode
          .map(unicode -> JSON.IntNumber(unicode))
          .default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  | SelectTo(target, ensureVisible, optRepeatOn, count) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "target" => target.toJSON(),
        "ensureVisible" => JSON.Bool(ensureVisible),
        "repeatOn" => optRepeatOn.map(toJSON).default(JSON.Null()),
        "count" => JSON.IntNumber(count),
      ].filter((_k, v) -> !v.isNull()),
    )
  | GoTo(target, optRepeatOn, count)
  | DeleteTo(target, optRepeatOn, count) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "target" => target.toJSON(),
        "repeatOn" => optRepeatOn.map(toJSON).default(JSON.Null()),
        "count" => JSON.IntNumber(count),
      ].filter((_k, v) -> !v.isNull()),
    )
  | Undo(optRepeatOn, count)
  | Redo(optRepeatOn, count) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "repeatOn" => optRepeatOn.map(toJSON).default(JSON.Null()),
        "count" => JSON.IntNumber(count),
      ].filter((_k, v) -> !v.isNull()),
    )
  | Multiples(commands) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "commands" => JSON.arrayToJSON(commands, toJSON),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Command {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiInput.Upper" -> Upper()
    | "UiInput.Lower" -> Lower()
    | "UiInput.Cut" -> Cut()
    | "UiInput.Copy" -> Copy()
    | "UiInput.Reset" -> Reset()
    | "UiInput.ManageScrolling" ->
      ManageScrolling(jso.getInt("value"), SKFS.Tick(jso.getInt("tick")))
    | "UiInput.CancelScrolling" ->
      CancelScrolling(SKFS.Tick(jso.getInt("tick")))
    | "UiInput.ToggleHidden" -> ToggleHidden(SKFS.Tick(jso.getInt("tick")))
    | "UiInput.Paste" ->
      Paste(FWKClipboard.Content::fromJSON(jso.get("content")))
    | "UiInput.SetMoveSelection" -> SetMoveSelection(jso.getBool("value"))
    | "UiInput.SetHover" -> SetHover(jso.getBool("value"))
    | "UiInput.SetArmed" -> SetArmed(jso.getBool("value"))
    | "UiInput.SetShowing" -> SetShowing(jso.getBool("value"))
    | "UiInput.SetBlinking" -> SetBlinking(jso.getBool("value"))
    | "UiInput.SetScroll" ->
      SetScroll(jso.maybeGet("value").map(Scroll::fromJSON))
    | "UiInput.ManageTarget" ->
      ManageTarget(jso.maybeGetInt("target"), jso.getBool("scrolling"))
    | "UiInput.Insert" ->
      Insert(
        jso.getString("text"),
        jso.getBool("ignoreSelection"),
        jso.maybeGetInt("position"),
      )
    | "UiInput.ManageDiacritic" ->
      ManageDiacritic(Char::fromCode(jso.getInt("code")))
    | "UiInput.ManageUnicode" -> ManageUnicode(jso.maybeGetInt("unicode"))
    | "UiInput.GoTo" ->
      GoTo(
        Target::fromJSON(jso.get("target")),
        jso.maybeGet("repeatOn").map(FWK.Repeat::fromJSON),
        jso.getInt("count"),
      )
    | "UiInput.SelectTo" ->
      SelectTo(
        Target::fromJSON(jso.get("target")),
        jso.getBool("ensureVisible"),
        jso.maybeGet("repeatOn").map(FWK.Repeat::fromJSON),
        jso.getInt("count"),
      )
    | "UiInput.DeleteTo" ->
      DeleteTo(
        Target::fromJSON(jso.get("target")),
        jso.maybeGet("repeatOn").map(FWK.Repeat::fromJSON),
        jso.getInt("count"),
      )
    | "UiInput.Undo" ->
      Undo(
        jso.maybeGet("repeatOn").map(FWK.Repeat::fromJSON),
        jso.getInt("count"),
      )
    | "UiInput.Redo" ->
      Redo(
        jso.maybeGet("repeatOn").map(FWK.Repeat::fromJSON),
        jso.getInt("count"),
      )
    | "UiInput.Multiples" ->
      Multiples(JSON.arrayFromJSON(jso.getArray("commands"), static::fromJSON))
    | _ -> invariant_violation(`Invalid json object ${cl} for UiInput.Command`)
    }
  }
}

extension base class Target extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | TPos(optPos) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "pos" => optPos.map(pos -> JSON.IntNumber(pos)).default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  | TColumn(next) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "next" => JSON.Bool(next),
      ],
    )
  | TGroup(optNext)
  | TLine(optNext) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "next" => optNext.map(next -> JSON.Bool(next)).default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )

  static fun fromJSON(jsv: JSON.Value): Target {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiInput.TPos" -> TPos(jso.maybeGetInt("pos"))
    | "UiInput.TColumn" -> TColumn(jso.getBool("next"))
    | "UiInput.TGroup" -> TGroup(jso.maybeGetBool("next"))
    | "UiInput.TLine" -> TLine(jso.maybeGetBool("next"))
    | _ -> invariant_violation(`Invalid json object ${cl} for UiInput.Target`)
    }
  }
}

extension base class Scroll extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | Left(position)
  | Right(position) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "position" => JSON.IntNumber(position),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Scroll {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiInput.Left" -> Left(jso.getInt("position"))
    | "UiInput.Right" -> Right(jso.getInt("position"))
    | _ -> invariant_violation(`Invalid json object ${cl} for UiInput.Scroll`)
    }
  }
}

extension base class Kind extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | Text()
  | Password()
  | ASCII()
  | Real()
  | Hex()
  | Octal()
  | Binary() ->
    JSON.Object(Map["__class" => JSON.String(this.getClassName())])
  | Integer(optMin, optMax) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "min" => optMin.map(v -> JSON.IntNumber(v)).default(JSON.Null()),
        "max" => optMax.map(v -> JSON.IntNumber(v)).default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  | Pattern(pattern) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "pattern" => JSON.String(pattern),
      ],
    )
  | Custom(dirName, key) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "dirName" => JSON.String(dirName.toString()),
        "key" => JSON.String(key.toString()),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Kind {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiInput.Text" -> Text()
    | "UiInput.Password" -> Password()
    | "UiInput.ASCII" -> ASCII()
    | "UiInput.Real" -> Real()
    | "UiInput.Hex" -> Hex()
    | "UiInput.Octal" -> Octal()
    | "UiInput.Binary" -> Binary()
    | "UiInput.Integer" ->
      Integer(jso.maybeGetInt("min"), jso.maybeGetInt("max"))
    | "UiInput.Pattern" -> Pattern(jso.getString("pattern"))
    | "UiInput.Custom" ->
      Custom(
        SKFS.DirName::create(jso.getString("dirName")),
        SKFS.StrID(jso.getString("key")),
      )
    | _ -> invariant_violation(`Invalid json object ${cl} for UiInput.Scroll`)
    }
  }
}

module end;
