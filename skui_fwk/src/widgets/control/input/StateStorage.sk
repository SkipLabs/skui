module UiInput;

const statePath: String = "ui/input/state";
const computedPath: String = "ui/input/computed";

class HStorage(
  name: String,
  handle: SKStore.IHandle<SKStore.Key, SKStore.File>,
) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKStore.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKStore.IHandle::notTyped(SKStore.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setTargeted(context: mutable SKStore.Context, value: Bool): void {
    this.handle.write(context, Ui.targetedProp, SKStore.BoolFile(value))
  }

  fun setHover(context: mutable SKStore.Context, value: Bool): void {
    this.handle.write(context, Ui.hoverProp, SKStore.BoolFile(value))
  }

  fun setArmed(context: mutable SKStore.Context, value: Bool): void {
    this.handle.write(context, Ui.armedProp, SKStore.BoolFile(value))
  }

  fun setBlinking(context: mutable SKStore.Context, value: Bool): void {
    this.handle.write(context, Ui.blinkingProp, SKStore.BoolFile(value))
  }

  fun setShowing(context: mutable SKStore.Context, value: Bool): void {
    this.handle.write(context, Ui.showingProp, SKStore.BoolFile(value))
  }

  fun setMoveSelection(context: mutable SKStore.Context, value: Bool): void {
    this.handle.write(context, Ui.moveSelectionProp, SKStore.BoolFile(value))
  }

  fun setTodo(context: mutable SKStore.Context, value: Executable): void {
    this.handle.write(context, Ui.todoProp, Ui.Todo(value, context.tick))
  }

  fun setScroll(context: mutable SKStore.Context, optScroll: ?Scroll): void {
    this.handle.writeOrRemove(context, Ui.scrollProp, optScroll)
  }

  fun setScrolling(
    context: mutable SKStore.Context,
    optTick: ?SKStore.Tick,
  ): void {
    this.handle.writeOrRemove(
      context,
      Ui.scrollingProp,
      optTick.map(t -> SKStore.IntFile(t.value)),
    )
  }

  fun setVisibility(
    context: mutable SKStore.Context,
    optVisibility: ?Ui.Visibility,
  ): void {
    this.handle.writeOrRemove(context, Ui.visibilityProp, optVisibility)
  }

  fun getVisibility(context: mutable SKStore.Context): ?Ui.Visibility {
    this.handle.maybeGetProp(context, Ui.visibilityProp, Ui.Visibility::type)
  }

  fun getScrolling(context: mutable SKStore.Context): ?SKStore.Tick {
    this.handle.maybeGetInt(context, Ui.scrollingProp).map(v -> SKStore.Tick(v))
  }

  fun getTodo(context: mutable SKStore.Context): Ui.Todo {
    Ui.Todo::type(this.handle.get(context, Ui.todoProp))
  }
}

class HState(
  storage: SKStore.EHandle<SKStore.Key, SKStore.File>,
  after: SKStore.EHandle<SKStore.Key, SKStore.File>,
) extends State {
  //
  fun isHover(context: mutable SKStore.Context): Bool {
    this.storage.getBool(context, Ui.hoverProp)
  }

  fun isArmed(context: mutable SKStore.Context): Bool {
    this.storage.getBool(context, Ui.armedProp)
  }

  fun isShowing(context: mutable SKStore.Context): Bool {
    this.storage.getBool(context, Ui.showingProp)
  }

  fun isMoveSelection(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Bool {
    this.storage.getBool(context, Ui.moveSelectionProp, isUntracked)
  }

  fun getScroll(context: mutable SKStore.Context): ?Scroll {
    this.storage.maybeGetProp(context, Ui.scrollProp, f ~> f as Scroll _);
  }

  fun isScrolling(context: mutable SKStore.Context): Bool {
    this.storage.maybeGetInt(context, Ui.scrollingProp).isSome()
  }

  /// COMPUTED
  fun isCaretVisible(context: mutable SKStore.Context): Bool {
    optVisibility = this.storage.maybeGetProp(
      context,
      Ui.visibilityProp,
      Ui.Visibility::type,
    );
    optCaretVisible = this.after.maybeGetInt(context, Ui.caretVisibleProp).map(
      v -> SKStore.Tick(v),
    );
    optVisibility match {
    | Some(visiblity) ->
      optCaretVisible match {
      | Some(tick) if (visiblity.tick == tick) -> visiblity.visible
      | _ -> true
      }
    | _ -> optCaretVisible.isSome()
    }
  }

  fun getEnsureVisible(context: mutable SKStore.Context): ?Visible {
    this.after.maybeGetProp(context, Ui.ensureVisibleProp, f ~>
      f as Visible _
    ).flatMap(v -> if (v.tick == context.tick) Some(v) else None());
  }

  fun getSize(context: mutable SKStore.Context): Int {
    this.after.getInt(context, Ui.lengthProp)
  }

  fun getPosition(context: mutable SKStore.Context): Int {
    this.after.maybeGetProp(context, Ui.positionProp, SourcedPos::type)
      .map(v -> v.pos)
      .default(0)
  }

  fun getText(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): String {
    this.after.maybeGetProp(
      context,
      Ui.textProp,
      SourcedText::type,
      isUntracked,
    )
      .map(v -> v.text)
      .default("")
  }

  fun getSelection(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): ?.Range {
    this.after.maybeGetProp(
      context,
      Ui.selectionProp,
      SourcedSel::type,
      isUntracked,
    ).flatMap(v -> v.optRange)
  }

  fun getStatus(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Status {
    this.after.getStatus(context, Ui.statusProp, isUntracked) match {
    | OK() ->
      this.after.maybeGetProp(
        context,
        Ui.userStatusProp,
        SourcedStatus::type,
        isUntracked,
      )
        .map(v -> v.status)
        .default(OK())
    | status -> status
    }
  }

  fun getTarget(context: mutable SKStore.Context): ?Int {
    this.after.maybeGetInt(context, Ui.targetProp)
  }

  fun getParts(context: mutable SKStore.Context): Parts {
    this.after.getProp(context, Ui.partsProp, Parts::type, Parts(Vector[]))
  }

  fun emitHover(context: mutable SKStore.Context, value: Bool): void {
    this.emit(context, SetHover(value));
  }

  fun emitArmed(context: mutable SKStore.Context, value: Bool): void {
    this.emit(context, SetArmed(value));
  }

  fun emitShowing(context: mutable SKStore.Context, value: Bool): void {
    this.emit(context, SetShowing(value));
  }

  fun emitDiacritic(context: mutable SKStore.Context, value: Char): void {
    this.emit(context, ManageDiacritic(value));
  }

  fun emitUnicode(context: mutable SKStore.Context, optValue: ?Int): void {
    this.emit(context, ManageUnicode(optValue));
  }

  fun emitMoveSelection(context: mutable SKStore.Context, value: Bool): void {
    this.emit(context, SetMoveSelection(value));
  }

  fun emitReset(context: mutable SKStore.Context): void {
    this.emit(context, Reset());
  }

  fun emitUndo(
    context: mutable SKStore.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, Undo(optRepeatOn));
  }

  fun emitRedo(
    context: mutable SKStore.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, Redo(optRepeatOn));
  }

  fun emitCut(context: mutable SKStore.Context): void {
    this.emit(context, Cut());
  }

  fun emitCopy(context: mutable SKStore.Context): void {
    this.emit(context, Copy());
  }

  fun emitPaste(context: mutable SKStore.Context): void {
    FWKClipboard.paste(
      context,
      FWKClipboard.Plain(),
      SKUIMessage.Target::forClass(
        statePath,
        this.storage.getDirName().toString(),
        "UiInput.Paste",
      ),
    )
  }

  fun emitUpper(context: mutable SKStore.Context): void {
    this.emit(context, Upper());
  }

  fun emitLower(context: mutable SKStore.Context): void {
    this.emit(context, Lower());
  }

  fun emitInsert(
    context: mutable SKStore.Context,
    text: String,
    ignoreSelection: Bool,
    optPosition: ?Int,
  ): void {
    this.emit(context, Insert(text, ignoreSelection, optPosition));
  }

  fun emitTarget(
    context: mutable SKStore.Context,
    optTarget: ?Int,
    scrolling: Bool,
  ): void {
    this.emit(context, ManageTarget(optTarget, scrolling));
  }

  fun emitDeleteTo(
    context: mutable SKStore.Context,
    target: Target,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, DeleteTo(target, optRepeatOn));
  }

  fun emitGoTo(
    context: mutable SKStore.Context,
    target: Target,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, GoTo(target, optRepeatOn));
  }

  fun emitSelectTo(
    context: mutable SKStore.Context,
    target: Target,
    ensureVisble: Bool = true,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, SelectTo(target, ensureVisble, optRepeatOn));
  }

  fun emitBlinking(context: mutable SKStore.Context, value: Bool): void {
    this.emit(context, SetBlinking(value));
  }

  fun emitScroll(context: mutable SKStore.Context, value: ?Scroll): void {
    this.emit(context, SetScroll(value));
  }

  fun emitScrolling(context: mutable SKStore.Context, value: Int): void {
    this.emit(context, ManageScrolling(value, context.tick));
  }

  fun emitCancelScrolling(
    context: mutable SKStore.Context,
    tick: SKStore.Tick,
  ): void {
    this.emit(context, CancelScrolling(tick));
  }

  fun emitAll(
    context: mutable SKStore.Context,
    commands: readonly Vector<Command>,
  ): void {
    this.emit(context, Multiples(commands.toArray()))
  }

  private fun emit(
    context: mutable SKStore.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(
      context,
      statePath,
      this.storage.getDirName().toString(),
      command,
    );
  }
}

class SourcedText(text: String, source: Int) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ SourcedText _ -> x
    | _ -> invariant_violation("Must be UiInput.SourcedText")
    }
  }
}

class SourcedPos(pos: Int, source: Int) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ SourcedPos _ -> x
    | _ -> invariant_violation("Must be UiInput.SourcedPos")
    }
  }
}

class SourcedSel(optRange: ?Range, source: Int) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ SourcedSel _ -> x
    | _ -> invariant_violation("Must be UiInput.SourcedSel")
    }
  }
}

class SourcedStatus(status: Status, source: Int) extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ SourcedStatus _ -> x
    | _ -> invariant_violation("Must be UiInput.SourcedStatus")
    }
  }
}

class UserData(controller: Controller, source: Int) extends SKStore.UserData

@debug
fun init(
  context: mutable SKStore.Context,
  path: Ui.Path,
  controller: Controller,
  supplier: Supplier,
): Parameters {
  source = context.timeStamp().value;
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeNotTyped(
    dirName,
    Array<(SKStore.Key, SKStore.File)>[
      (Ui.todoProp, Ui.Todo(Ui.Init(), context.tick)),
    ],
  );
  filteredDirName = SKStore.DirName::make(dirName, "filtered/");
  preFilteredHdl = context.makeNotTypedPre(filteredDirName, Array[]);
  filteredHdl = stateHdl.map(
    k ~> k,
    Ui.Todo::type,
    context,
    filteredDirName,
    (context, writer, key, it) ~> {
      if (key == Ui.todoProp) {
        todo = Ui.Todo::type(it.first);
        executables = mutable Vector<(SKStore.Tick, Executable)>[];
        optCurrent = preFilteredHdl.maybeGetProp(
          context,
          key,
          Ui.Todo::type,
          true,
        );
        tick = optCurrent.map(c -> c.tick).default(SKStore.Tick(-1));
        max = tick;
        if (todo.tick > tick) {
          executables.push((todo.tick, todo.command as Executable _));
          !max = todo.tick;
        };
        supplier
          .getTextProperty(context)
          .flatMap(prop -> prop.maybeGetTimed(context))
          .each(timed -> {
            (optText, ttick, src) = timed;
            optText match {
            | Some(text) if (src != source && ttick > tick) ->
              executables.push((ttick, SetText(text.toString(), src)));
              !max = Math.max(max, ttick)
            | _ -> void
            }
          });
        supplier
          .getPositionProperty(context)
          .flatMap(prop -> prop.maybeGetTimed(context))
          .each(timed -> {
            (optPos, ttick, src) = timed;
            optPos match {
            | Some(pos) if (src != source && ttick > tick) ->
              executables.push((ttick, SetPosition(pos, src)));
              !max = Math.max(max, ttick)
            | _ -> void
            }
          });
        supplier
          .getSelectionProperty(context)
          .flatMap(prop -> prop.maybeGetTimed(context))
          .each(timed -> {
            (optRange, ttick, src) = timed;
            if (src != source) {
              if (ttick > tick) {
                executables.push((ttick, SetSelection(optRange, src)));
                !max = Math.max(max, ttick);
              }
            }
          });
        supplier
          .getStatusProperty(context)
          .flatMap(prop -> prop.maybeGetTimed(context))
          .each(timed -> {
            (optStatus, ttick, src) = timed;
            optStatus match {
            | Some(status) if (src != source && ttick > tick) ->
              executables.push((ttick, SetStatus(status, src)));
              !max = Math.max(max, ttick)
            | _ -> void
            }
          });
        size = executables.size();
        if (size == 0) {
          optCurrent.each(c -> writer.set(key, c))
        } else if (size == 1) {
          writer.set(key, Ui.Todo(executables.first().i1, max))
        } else {
          sorted = executables.sortedFor(v ~> v.i0);
          writer.set(
            key,
            Ui.Todo(Ui.Multiple(sorted.map(v ~> v.i1).toArray()), max),
          )
        }
      }
    },
  );
  computedDirName = SKStore.DirName::make(dirName, "computed/");
  intermediateDirName = SKStore.DirName::make(dirName, "intermediate/");
  afterDirName = SKStore.DirName::make(dirName, "after/");
  initKeys = Array[
    Ui.textProp,
    Ui.positionProp,
    Ui.selectionProp,
    Ui.diacriticProp,
    Ui.unicodeProp,
    Ui.historyProp,
    Ui.targetProp,
    Ui.ensureVisibleProp,
    Ui.userStatusProp,
  ];
  preAfterHdl = context.makeNotTypedPre(
    afterDirName,
    Array[(SKStore.KKeys(), SKStore.Keys(initKeys))],
  );
  computedHdl = SKStore.derive(
    context,
    dirName.toString(),
    computedDirName,
    filteredHdl,
    Ui.todoProp,
    initKeys,
    update,
    Some(UserData(controller, source)),
    Some(preAfterHdl),
  );
  intHdl = computedHdl.map(
    k ~> k,
    f ~> f,
    context,
    intermediateDirName,
    (context, writer, key, it) ~> {
      if (key == Ui.textProp) {
        sourced = SourcedText::type(it.first);
        kind = controller.getKind(context);
        behavior = kind.toBehavior(context);
        charFilter = behavior.optCharFilter.default(_c ~> true);
        validator = behavior.optValidator.default(_ ~> OK());
        chars = sourced.text.chars().filter(charFilter);
        max = controller.getMaxChars(context);
        if (chars.size() > max) {
          !chars = chars.slice(0, max)
        };
        validity = validator(chars);
        writer.set(Ui.statusProp, validity);
        writer.set(
          Ui.textProp,
          SourcedText(String::fromChars(chars.toArray()), sourced.source),
        )
      } else {
        writer.set(key, it.first)
      }
    },
  );
  visibilityHdl = intHdl.map(
    k ~> k,
    f ~> f,
    context,
    SKStore.DirName::make(dirName, "visibility/"),
    (context, writer, key, it) ~> {
      if (key == Ui.textProp) {
        sourced = SourcedText::type(it.first);
        count = sourced.text.chars().size();
        showing = stateHdl.getBool(context, Ui.showingProp);
        toSplit = controller.getKind(context) match {
        | Password() if (!showing) ->
          // Optimise with unicity manager
          String::fromChars(Array::fill(count, UiTheme.passChar))
        | _ -> sourced.text
        };
        writer.set(Ui.partsProp, Parts(split(toSplit)));
        writer.set(Ui.lengthProp, SKStore.IntFile(count));
        writer.set(Ui.textProp, sourced);
      } else {
        writer.set(key, it.first);
      }
    },
  );
  verifiedHdl = visibilityHdl.map(
    k ~> k,
    f ~> f,
    context,
    SKStore.DirName::make(dirName, "verified/"),
    (context, writer, key, it) ~> {
      if (key == Ui.positionProp) {
        size = visibilityHdl.getInt(context, Ui.lengthProp);
        sourced = SourcedPos::type(it.first);
        writer.set(
          key,
          SourcedPos(Math.clamp(sourced.pos, 0, size), sourced.source),
        );
      } else if (key == Ui.selectionProp) {
        size = visibilityHdl.getInt(context, Ui.lengthProp);
        sourced = SourcedSel::type(it.first);
        sourced.optRange match {
        | Some(r) if (r.start < size) ->
          writer.set(
            key,
            SourcedSel(
              Some(.Range(r.start, Math.min(r.end, size))),
              sourced.source,
            ),
          )
        | _ -> writer.set(key, SourcedSel(None(), sourced.source))
        }
      } else if (key == Ui.targetProp) {
        size = visibilityHdl.getInt(context, Ui.lengthProp);
        position = SKStore.IntFile::type(it.first).value;
        writer.set(key, SKStore.IntFile(Math.clamp(position, 0, size)));
      } else {
        writer.set(key, it.first);
      }
    },
  );
  afterHdl = verifiedHdl.map(
    k ~> k,
    f ~> f,
    context,
    afterDirName,
    (context, writer, key, it) ~> {
      if (key == Ui.positionProp) {
        if (stateHdl.getBool(context, Ui.blinkingProp)) {
          writer.set(Ui.caretVisibleProp, SKStore.IntFile(context.tick.value));
          SKUIMessage.emit(
            context,
            statePath,
            dirName.toString(),
            ToggleHidden(context.tick),
            false,
            Some(500),
          );
        };
        sourced = SourcedPos::type(it.first);
        if (sourced.source == source) {
          supplier.getPositionProperty(context, true).each(pos ->
            pos.set(context, Some(sourced.pos), source)
          )
        }
      } else if (key == Ui.selectionProp) {
        sourced = SourcedSel::type(it.first);
        if (sourced.source == source) {
          supplier.getSelectionProperty(context, true).each(sel ->
            sel.set(context, sourced.optRange, source)
          )
        }
      } else if (key == Ui.textProp) {
        sourced = SourcedText::type(it.first);
        if (sourced.source == source) {
          supplier.getTextProperty(context, true).each(txt ->
            txt.set(context, Some(sourced.text), source)
          )
        }
      } else if (key == Ui.userStatusProp) {
        sourced = SourcedStatus::type(it.first);
        if (sourced.source == source) {
          supplier.getStatusProperty(context, true).each(sts ->
            sts.set(context, Some(sourced.status), source)
          )
        }
      };
      writer.set(key, it.first)
    },
  );
  Parameters(controller, HState(stateHdl, afterHdl))
}

@debug
fun split(text: String): Vector<Part> {
  index = 0;
  chars = text.chars();
  parts = mutable Vector<Part>[];
  tmp = mutable Vector<Char>[];
  while (index < chars.size()) {
    space = 0;
    while (index < chars.size() && Char.isWhitespace(chars[index])) {
      !space = space + 1;
      !index = index + 1;
    };
    while (index < chars.size() && !Char.isWhitespace(chars[index])) {
      tmp.push(chars[index]);
      !index = index + 1;
    };
    parts.push(Part(space, String::fromChars(tmp.toArray())));
    tmp.clear();
  };
  unsafe_chill_trust_me(parts);
}

@debug
fun update(
  context: mutable SKStore.Context,
  _scope: String,
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  todo: Ui.Todo,
  optUserData: ?UserData,
): void {
  optOldHistory = values.get(Ui.historyProp).map(History::type);
  oldText = getText(values);
  oldPosition = getPosition(values);
  oldSelection = getSelection(values);
  userData = optUserData.fromSome();
  controller = userData.controller;
  oldUserStatus = getUserStatus(values);
  charFilter = controller
    .getKind(context, true)
    .toBehavior(context, true)
    .optCharFilter.default(_c ~> true);
  editable = controller.isEditable(context, true);
  check = execute(
    context,
    todo.command as Executable _,
    values,
    charFilter,
    userData.source,
  );
  newText = getText(values);
  if (check && editable) {
    history = optOldHistory match {
    | Some(history) if (oldText != newText) ->
      newPosition = getPosition(values);
      newSelection = getSelection(values);
      setUserStatus(values, OK(), userData.source);
      history.add(
        LamUndoable(
          (v, tick) ~> {
            v.writeText(oldText);
            v.writePosition(oldPosition);
            v.writeSelection(oldSelection);
            v.writeEnsureVisible(Pos(oldPosition, tick));
            v.writeUserStatus(oldUserStatus);
          },
          (v, tick) ~> {
            v.writeText(newText);
            v.writePosition(newPosition);
            v.writeSelection(newSelection);
            v.writeEnsureVisible(Pos(newPosition, tick));
            v.writeUserStatus(OK());
          },
        ),
      )
    | Some(history) -> history
    | None() -> History()
    };
    values.set(Ui.historyProp, Some(history))
  };
}

@debug
fun execute(
  context: mutable SKStore.Context,
  executable: Ui.Executable,
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  charFilter: Char ~> Bool,
  source: Int,
): Bool {
  check = true;
  executable match {
  | Ui.Multiple(cmds) ->
    cmds.each(cmd ->
      !check = execute(context, cmd, values, charFilter, source) && check
    )
  | Ui.Init() ->
    if (values.get(Ui.textProp).isNone()) {
      values.set(Ui.textProp, Some(SourcedText("", source)))
    };
    if (values.get(Ui.positionProp).isNone()) {
      values.set(Ui.positionProp, Some(SourcedPos(0, source)))
    };
    if (values.get(Ui.selectionProp).isNone()) {
      values.set(Ui.selectionProp, Some(SourcedSel(None(), source)))
    }
  | SetStatus(status, src) ->
    values.set(Ui.userStatusProp, Some(SourcedStatus(status, src)))
  | SetText(value, src) ->
    values.set(Ui.textProp, Some(SourcedText(value, src)))
  | SetPosition(value, src) ->
    values.set(Ui.positionProp, Some(SourcedPos(value, src)))
  | SetSelection(optValue, src) ->
    values.set(Ui.selectionProp, Some(SourcedSel(optValue, src)))
  | ManageTarget(optTarget, _) ->
    optTarget.each(t ->
      values.set(Ui.ensureVisibleProp, Some(Pos(t, context.tick)))
    );
    values.set(Ui.targetProp, optTarget.map(v -> SKStore.IntFile(v)))
  | Undo _ ->
    undoRedo(context, values, h ~> h.undo, source);
    !check = false
  | Redo _ ->
    undoRedo(context, values, h ~> h.redo, source);
    !check = false
  | ManageScrolling(incr, _) ->
    values.set(Ui.ensureVisibleProp, Some(Incr(incr, context.tick)))
  | Copy() -> _ = copy(context, values)
  | Cut() ->
    cut(context, values, source);
    ensureVisible(context, values)
  | Paste(content) ->
    paste(values, content, charFilter, source);
    ensureVisible(context, values)
  | Insert(text, ignoreSelection, optPosition) ->
    insert(values, charFilter, text, source, ignoreSelection, optPosition);
    ensureVisible(context, values)
  | Upper() -> modify(values, Unicode.toUpper, source)
  | Lower() -> modify(values, Unicode.toLower, source)
  | GoTo(target, _, _) ->
    manageGoTo(values, target, source);
    ensureVisible(context, values)
  | SelectTo(target, ev, _, _) ->
    manageSelectTo(values, target, source);
    if (ev) ensureVisible(context, values)
  | DeleteTo(target, _, _) ->
    manageDeleteTo(values, target, source);
    ensureVisible(context, values)
  | ManageDiacritic(char) ->
    if (manageDiacritic(values, charFilter, char, source)) {
      ensureVisible(context, values)
    }
  | ManageUnicode(optValue) ->
    if (manageUnicode(values, charFilter, optValue, source)) {
      ensureVisible(context, values)
    }
  | _ -> SKStore.cast_violation("UiInput.Executable", executable)
  };
  check
}

fun getText(values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>): String {
  values.get(Ui.textProp).map(SourcedText::type).map(f -> f.text).default("");
}

fun getSelection(values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>): ?Range {
  values.get(Ui.selectionProp).map(SourcedSel::type).flatMap(f -> f.optRange)
}

fun getPosition(values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>): Int {
  values.get(Ui.positionProp).map(SourcedPos::type).map(f -> f.pos).default(0)
}

fun getUserStatus(
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
): Status {
  values
    .get(Ui.userStatusProp)
    .map(SourcedStatus::type)
    .map(v -> v.status)
    .default(OK())
}

fun getUnicode(values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>): ?Int {
  values.get(Ui.unicodeProp).map(SKStore.IntFile::type).map(f -> f.value)
}

fun getDiacritic(values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>): ?Char {
  values.get(Ui.diacriticProp).map(SKStore.CharFile::type).map(f -> f.value)
}

fun setText(
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  text: String,
  source: Int,
): void {
  values.set(Ui.textProp, Some(SourcedText(text, source)));
}

fun setPosition(
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  position: Int,
  source: Int,
): void {
  values.set(Ui.positionProp, Some(SourcedPos(position, source)));
}

fun setUnicode(
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  optValue: ?Int,
): void {
  values.set(Ui.unicodeProp, optValue.map(v -> SKStore.IntFile(v)));
}

fun setSelection(
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  optSelection: ?Range,
  source: Int,
): void {
  values.set(Ui.selectionProp, Some(SourcedSel(optSelection, source)));
}

fun setDiacritic(
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  optDiacritic: ?Char,
): void {
  values.set(
    Ui.diacriticProp,
    optDiacritic.map(char -> SKStore.CharFile(char)),
  );
}

fun setUserStatus(
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  status: Status,
  source: Int,
): void {
  values.set(Ui.userStatusProp, Some(SourcedStatus(status, source)));
}

module end;
