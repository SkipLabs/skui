  fun getVisibility(context: mutable SKFS.Context): ?Ui.Visibility;

  fun setHover(context: mutable SKFS.Context, optValue: ?Hover): void;
  fun setArmed(context: mutable SKFS.Context, value: Bool): void;
  fun setBlinking(context: mutable SKFS.Context, value: Bool): void;
  fun setScrolling(context: mutable SKFS.Context, optTick: ?SKFS.Tick): void;
  fun setMoveSelection(
    context: mutable SKFS.Context,
    moveSelection: Bool,
  ): void;
  fun setVisibility(
    context: mutable SKFS.Context,
    optVisibility: ?Ui.Visibility,
  ): void;
