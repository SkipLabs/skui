module UiMonospace;

class Bracket(index: Int, value: Array<Char>, count: Int = 0) uses Orderable
class ColorRange(start: Ui.Position, end: Ui.Location, color: Color) {
  fun endLine(): Int {
    this.end match {
    | Ui.LineEnd(line) -> line
    | Ui.Position(line, _, _) -> line
    }
  }

  fun endColumn(): ?Int {
    this.end match {
    | Ui.LineEnd _ -> None()
    | Ui.Position(_, column, _) -> Some(column)
    }
  }

  fun startLine(): Int {
    this.start.line
  }

  fun toLinePortion(line: Int): ?LinePortion {
    endLine = this.endLine();
    if (this.start.line <= line && endLine >= line) {
      start = if (this.start.line == line) {
        this.start.column
      } else {
        0
      };
      optEnd = if (endLine == line) {
        this.endColumn()
      } else {
        None()
      };
      Some(LinePortion(Ui.LinePortion(start, optEnd), this.color))
    } else {
      None()
    }
  }
}

class ColorRanges(value: Vector<ColorRange>) extends SKFS.File

type BracketsBuilder = (Accessor, Int, Int) ~> ?Bracket;
type BracketsChecker = (
  ?Bracket,
  ?Bracket,
  mutable Vector<Bracket>,
) ~> ?Bracket;
type ColorSupplier = String ~> ?Color;

base class Accessor {
  fun get(index: Int): Char;
  fun maybeGet(index: Int): ?Char;
  fun isEmpty(): Bool;
  fun size(): Int;
}

class ArrayAccessor(value: Array<Char>) extends Accessor {
  fun get(index: Int): Char {
    this.value.get(index)
  }

  fun maybeGet(index: Int): ?Char {
    this.value.maybeGet(index)
  }

  fun isEmpty(): Bool {
    this.value.isEmpty()
  }

  fun size(): Int {
    this.value.size()
  }
}

class VectorAccessor(value: Vector<Char>) extends Accessor {
  fun get(index: Int): Char {
    this.value.get(index)
  }

  fun maybeGet(index: Int): ?Char {
    this.value.maybeGet(index)
  }

  fun isEmpty(): Bool {
    this.value.isEmpty()
  }

  fun size(): Int {
    this.value.size()
  }
}

class Line(
  id: Int,
  text: Array<Char>,
  brackets: Array<Bracket>,
  optOther: ?Int = None(),
) extends SKFS.File uses Orderable {
  //
  static fun empty(idSupplier: () -> Int): Line {
    Line(idSupplier(), Array[], Array[]);
  }

  fun compare(other: Line): Order {
    this.text.compare(other.text)
  }

  fun isEmpty(): Bool {
    this.text.isEmpty()
  }
}

class Group(start: Array<Char>, optEnd: ?Array<Char>)

class Lines(value: Vector<Line>) extends SKFS.File {
  //
  static fun empty(idSupplier: () -> Int): Lines {
    Lines(Vector[Line::empty(idSupplier)])
  }

  fun isEmpty(): Bool {
    this.value.isEmpty() || this.value[0].isEmpty()
  }
}

class LinePortion(portion: Ui.LinePortion, color: Color) {
  fun contains(idx: Int): Bool {
    this.portion.contains(idx)
  }
}

class LinePortions(value: Vector<LinePortion>) extends SKFS.File

base class StorePolicy uses Orderable, Hashable {
  children =
  | OnChange()
  | OnSave()
  | OnFocusLost()
}

base class Hover extends SKFS.File uses Orderable {
  children =
  | HLine(Int)
  | HVBar()
  | HHBar()
}

base class Selection uses HasClassName, Equality {
  children =
  | TAll()
  | TPortion(portion: Ui.Portion)

  fun toTarget(): Target {
    this match {
    | target @ Target _ -> target
    | _ -> invariant_violation("Must be a UiMonospace.Target")
    }
  }
}

base class Target extends Selection {
  children =
  | TPos(?Ui.Position)
}

base class PredefinedTarget() extends Target {
  children =
  | TColumn(next: Bool)
  | TGroup(optNext: ?Bool)
  | TInLine(optNext: ?Bool)
  | TLine(next: Bool)
  | TPage(next: Bool)
  | TDocument(next: Bool)
}

