}

class Parameters(controller: Controller, state: State) extends Ui.Parameters {}
class LayoutParameters(widgets: Ui.WidgetsCollection) extends Ui.Parameters {}

base class Undoable() {
  fun undo(updater: mutable Updater, tick: SKFS.Tick): void;
  fun redo(updater: mutable Updater, tick: SKFS.Tick): void;
}

class LamUndoable(
  lamUndo: (mutable Updater, SKFS.Tick) ~> void,
  lamRedo: (mutable Updater, SKFS.Tick) ~> void,
) extends Undoable {
  fun undo(updater: mutable Updater, tick: SKFS.Tick): void {
    this.lamUndo(updater, tick)
  }
  fun redo(updater: mutable Updater, tick: SKFS.Tick): void {
    this.lamRedo(updater, tick)
  }
}

class History(
  index: Int = -1,
  undoables: Array<Undoable> = Array[],
) extends SKFS.File {
  fun undo(updater: mutable Updater, tick: SKFS.Tick): (History, Bool) {
    this.undoables.maybeGet(this.index) match {
    | Some(undoable) ->
      undoable.undo(updater, tick);
      !this.index = Math.max(this.index - 1, -1);
      (this, true)
    | _ -> (this, false)
    }
  }

  fun redo(updater: mutable Updater, tick: SKFS.Tick): (History, Bool) {
    this.undoables.maybeGet(this.index + 1) match {
    | Some(undoable) ->
      undoable.redo(updater, tick);
      !this.index = Math.min(this.index + 1, this.undoables.size());
      (this, true)
    | _ -> (this, false)
    }
  }

  fun add(undoable: Undoable): History {
    undoables = if (this.index < this.undoables.size() - 1) {
      Vector::mcreateFromItems(this.undoables.slice(0, this.index + 1));
    } else {
      Vector::mcreateFromItems(this.undoables)
    };
    undoables.push(undoable);
    History(undoables.size() - 1, undoables.toArray())
  }
}

class NumbersDrawInfo(drawables: Array<Ui.Drawable>) extends Ui.DrawInfo {}

module end;
