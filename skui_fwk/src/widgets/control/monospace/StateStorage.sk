module UiMonospace;

const statePath: String = "ui/monospace/state";
const numberOfLinesProp: SKFS.StrID = SKFS.StrID("numberOfLines");
const numberOfColumnsProp: SKFS.StrID = SKFS.StrID("numberOfColumns");
const fontLoadingProp: SKFS.StrID = SKFS.StrID("fontLoading");
const linesProp: SKFS.StrID = SKFS.StrID("lines");
const fontSizeProp: SKFS.StrID = SKFS.StrID("fontSize");
const caretVisibleTimeProp: SKFS.StrID = SKFS.StrID("caretVisibleTime");
const verifiedPositionProp: SKFS.StrID = SKFS.StrID("verifiedPosition");
const displayPositionProp: SKFS.StrID = SKFS.StrID("displayPosition");
const verifiedSelectionProp: SKFS.StrID = SKFS.StrID("verifiedSelection");
const verifiedTargetProp: SKFS.StrID = SKFS.StrID("verifiedTarget");
const colorsProp: SKFS.StrID = SKFS.StrID("colors");

class HStorage(name: String, handle: SKFS.IHandle<SKFS.File>) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKFS.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKFS.IHandle(SKFS.FileConverter(f ~> f), SKFS.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setTodo(context: mutable SKFS.Context, value: Ui.Executable): void {
    this.handle.write(context, Ui.todoProp, Ui.Todo(value, context.tick))
  }

  fun setHScroll(context: mutable SKFS.Context, optScroll: ?Ui.Scroll): void {
    this.handle.writeOrRemove(context, Ui.hScrollProp, optScroll)
  }

  fun setVScroll(context: mutable SKFS.Context, optScroll: ?Ui.Scroll): void {
    this.handle.writeOrRemove(context, Ui.vScrollProp, optScroll)
  }

  fun setScrolling(context: mutable SKFS.Context, optTick: ?SKFS.Tick): void {
    this.handle.writeOrRemove(
      context,
      Ui.scrollingProp,
      optTick.map(t -> SKFS.IntFile(t.value)),
    )
  }

  fun setHover(context: mutable SKFS.Context, optValue: ?Hover): void {
    this.handle.writeOrRemove(context, Ui.hoverProp, optValue)
  }

  fun setArmed(context: mutable SKFS.Context, value: Bool): void {
    this.handle.write(context, Ui.armedProp, SKFS.BoolFile(value))
  }

  fun setBlinking(context: mutable SKFS.Context, value: Bool): void {
    this.handle.write(context, Ui.blinkingProp, SKFS.BoolFile(value))
  }

  fun setMoveSelection(context: mutable SKFS.Context, value: Bool): void {
    this.handle.write(context, Ui.moveSelectionProp, SKFS.BoolFile(value))
  }

  fun setVisibility(
    context: mutable SKFS.Context,
    optVisibility: ?Ui.Visibility,
  ): void {
    this.handle.writeOrRemove(context, Ui.visibilityProp, optVisibility)
  }

  // GETTERS

  fun getVisibility(context: mutable SKFS.Context): ?Ui.Visibility {
    this.handle.maybeGetProp(
      context,
      Ui.visibilityProp,
      Ui.Visibility::fromFile,
    )
  }

  fun getScrolling(context: mutable SKFS.Context): ?SKFS.Tick {
    this.handle.maybeGetInt(context, Ui.scrollingProp).map(v -> SKFS.Tick(v))
  }

  fun getTodo(context: mutable SKFS.Context): Ui.Todo {
    Ui.Todo::fromFile(this.handle.get(context, Ui.todoProp))
  }
}

class HState(
  path: Ui.Path,
  storage: SKFS.EHandle<SKFS.File>,
  computed: SKFS.EHandle<SKFS.File>,
) extends State {
  //
  fun getHover(context: mutable SKFS.Context): ?Hover {
    this.storage.maybeGetProp(context, Ui.hoverProp, f ~> f as Hover _)
  }

  fun isArmed(context: mutable SKFS.Context, isUntracked: Bool = false): Bool {
    this.storage.getBool(context, Ui.armedProp, isUntracked)
  }

  fun isMoveSelection(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Bool {
    this.storage.getBool(context, Ui.moveSelectionProp, isUntracked)
  }

  fun getHScroll(context: mutable SKFS.Context): ?Ui.Scroll {
    this.storage.maybeGetProp(context, Ui.hScrollProp, f ~> f as Ui.Scroll _);
  }

  fun getVScroll(context: mutable SKFS.Context): ?Ui.Scroll {
    this.storage.maybeGetProp(context, Ui.vScrollProp, f ~> f as Ui.Scroll _);
  }

  fun isScrolling(context: mutable SKFS.Context): Bool {
    this.storage.maybeGetInt(context, Ui.scrollingProp).isSome()
  }

  // COMPUTED

  fun getLineCommandsManager(
    _context: mutable SKFS.Context,
    _isUntracked: Bool = false,
  ): Ui.TextCommandsManager {
    TextCommandsManager(this)
  }

  fun getNumberOfLines(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Int {
    this.computed.getInt(context, numberOfLinesProp, isUntracked)
  }

  fun getNumberOfColumns(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Int {
    this.computed.getInt(context, numberOfColumnsProp, isUntracked)
  }

  fun isFontLoading(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Bool {
    this.computed.getBool(context, fontLoadingProp, isUntracked)
  }

  fun isCaretVisible(context: mutable SKFS.Context): Bool {
    this.computed.getBool(context, Ui.caretVisibleProp)
  }

  fun getHEnsureVisible(context: mutable SKFS.Context): ?Ui.Visible {
    this.computed.maybeGetProp(context, Ui.hEnsureVisibleProp, f ~>
      f as Ui.Visible _
    ).flatMap(v -> if (v.tick == context.tick) Some(v) else None());
  }

  fun getVEnsureVisible(context: mutable SKFS.Context): ?Ui.Visible {
    this.computed.maybeGetProp(context, Ui.vEnsureVisibleProp, f ~>
      f as Ui.Visible _
    ).flatMap(v -> if (v.tick == context.tick) Some(v) else None());
  }

  fun getLines(context: mutable SKFS.Context): Vector<Line> {
    this.computed.getProp(
      context,
      linesProp,
      Lines::fromFile,
      Lines(Vector[Line(context.timeStamp().value, Array[], Array[])]),
    ).value
  }

  fun getFontSize(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Ui.FontSize {
    this.computed.getProp(
      context,
      fontSizeProp,
      Ui.FontSize::fromFile,
      Ui.FontSize(8.0, 8.0, 4.0),
      isUntracked,
    )
  }

  fun getPosition(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Ui.Position {
    this.computed.getProp(
      context,
      verifiedPositionProp,
      Ui.Position::fromFile,
      Ui.Position::zero,
      isUntracked,
    )
  }

  fun getTarget(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): ?Ui.Position {
    this.computed.maybeGetProp(
      context,
      verifiedTargetProp,
      Ui.Position::fromFile,
      isUntracked,
    )
  }

  fun getSelection(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): ?Ui.Portion {
    selection = this.computed.getProp(
      context,
      verifiedSelectionProp,
      Ui.Portion::fromFile,
      Ui.Portion::empty,
      isUntracked,
    );
    if (selection.isEmpty()) {
      None()
    } else {
      Some(selection)
    }
  }

  fun getColorRanges(context: mutable SKFS.Context): Vector<ColorRange> {
    this.computed.getProp(
      context,
      colorsProp,
      ColorRanges::fromFile,
      ColorRanges(Vector[]),
    ).value;
  }

  fun computeClipboardContent(
    context: mutable SKFS.Context,
    endLine: Ui.EndLine,
    isUntracked: Bool = false,
  ): ?FWKClipboard.Content {
    lines = this.computed.getProp(
      context,
      linesProp,
      Lines::fromFile,
      Lines::empty(() -> context.timeStamp().value),
      isUntracked,
    ).value;
    toCopy = mutable Vector<Array<Char>>[];
    this.getSelection(context, isUntracked) match {
    | Some(selection) ->
      if (selection.start.line == selection.end.line) {
        line = lines[selection.start.line];
        startColumn = Math.clamp(selection.start.column, 0, line.text.size());
        endColumn = Math.clamp(selection.end.column, 0, line.text.size());
        copied = line.text.slice(startColumn, endColumn);
        if (!copied.isEmpty()) {
          toCopy.push(copied)
        };
      } else {
        sLine = lines[selection.start.line];
        startColumn = Math.clamp(selection.start.column, 0, sLine.text.size());
        sCopied = sLine.text.slice(startColumn, sLine.text.size());
        toCopy.push(sCopied);
        for (idx in Range(selection.start.line + 1, selection.end.line)) {
          toCopy.push(lines[idx].text);
        };
        eLine = lines[selection.end.line];
        endColumn = Math.clamp(selection.end.column, 0, eLine.text.size());
        eCopied = eLine.text.slice(0, endColumn);
        toCopy.push(eCopied);
      }
    | _ -> void
    };
    if (!toCopy.isEmpty()) {
      endLineChars = endLine.toChars();
      index = 0;
      withEndLines = Array::fillBy(toCopy.size() + toCopy.size() - 1, idx ->
        if (idx % 2 == 0) {
          r = toCopy[index];
          !index = index + 1;
          r
        } else {
          endLineChars
        }
      );
      Some(
        FWKClipboard.Content::plain(
          String::fromChars(Arrays.mergeAll(withEndLines)),
        ),
      )
    } else {
      None()
    }
  }

  fun emitHover(context: mutable SKFS.Context, optHover: ?Hover): void {
    this.emit(context, SetHover(optHover));
  }

  fun emitArmed(context: mutable SKFS.Context, value: Bool): void {
    this.emit(context, SetArmed(value));
  }

  fun emitDiacritic(context: mutable SKFS.Context, value: Char): void {
    this.emit(context, ManageDiacritic(value));
  }

  fun emitUnicode(context: mutable SKFS.Context, optValue: ?Int): void {
    this.emit(context, ManageUnicode(optValue));
  }

  fun emitMoveSelection(context: mutable SKFS.Context, value: Bool): void {
    this.emit(context, SetMoveSelection(value));
  }

  fun emitNewLine(
    context: mutable SKFS.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, NewLine(optRepeatOn));
  }

  fun emitUndo(
    context: mutable SKFS.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, Undo(optRepeatOn));
  }

  fun emitRedo(
    context: mutable SKFS.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, Redo(optRepeatOn));
  }

  fun emitCut(context: mutable SKFS.Context): void {
    this.emit(context, Cut());
  }

  fun emitCopy(context: mutable SKFS.Context): void {
    this.emit(context, Copy());
  }

  fun emitSave(context: mutable SKFS.Context): void {
    this.emit(context, Save());
  }

  fun emitDuplicate(context: mutable SKFS.Context): void {
    this.emit(context, Duplicate());
  }

  fun emitSwitchLine(context: mutable SKFS.Context): void {
    this.emit(context, SwitchLine());
  }

  fun emitDecrLine(
    context: mutable SKFS.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, DecrLine(optRepeatOn));
  }

  fun emitIncrLine(
    context: mutable SKFS.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, IncrLine(optRepeatOn));
  }

  fun emitIndent(
    context: mutable SKFS.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, Indent(optRepeatOn));
  }

  fun emitOutdent(
    context: mutable SKFS.Context,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, Outdent(optRepeatOn));
  }

  fun emitPaste(context: mutable SKFS.Context): void {
    FWKClipboard.paste(
      context,
      FWKClipboard.Plain(),
      SKUIMessage.Target::forClass(
        statePath,
        this.storage.getDirName().toString(),
        "UiMonospace.Paste",
      ),
    )
  }

  fun emitUpper(context: mutable SKFS.Context): void {
    this.emit(context, Upper());
  }

  fun emitLower(context: mutable SKFS.Context): void {
    this.emit(context, Lower());
  }

  fun emitInsert(
    context: mutable SKFS.Context,
    text: String,
    ignoreSelection: Bool,
    optPosition: ?Ui.Position,
  ): void {
    this.emit(context, Insert(text, ignoreSelection, optPosition));
  }

  fun emitBlinking(context: mutable SKFS.Context, value: Bool): void {
    this.emit(context, SetBlinking(value));
  }

  fun emitHScroll(context: mutable SKFS.Context, value: ?Ui.Scroll): void {
    this.emit(context, SetHScroll(value));
  }

  fun emitVScroll(context: mutable SKFS.Context, value: ?Ui.Scroll): void {
    this.emit(context, SetVScroll(value));
  }

  fun emitHScrolling(context: mutable SKFS.Context, value: Int): void {
    this.emit(context, ManageHScrolling(value, context.tick));
  }

  fun emitVScrolling(context: mutable SKFS.Context, value: Int): void {
    this.emit(context, ManageVScrolling(value, context.tick));
  }

  fun emitCancelScrolling(
    context: mutable SKFS.Context,
    tick: SKFS.Tick,
  ): void {
    this.emit(context, CancelScrolling(tick));
  }

  fun emitDeleteTo(
    context: mutable SKFS.Context,
    target: Target,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, DeleteTo(target, optRepeatOn));
  }

  fun emitGoTo(
    context: mutable SKFS.Context,
    target: Target,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, GoTo(target, optRepeatOn));
  }

  fun emitSelectTo(
    context: mutable SKFS.Context,
    target: Selection,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, SelectTo(target, optRepeatOn));
  }

  fun emitHVisible(context: mutable SKFS.Context, index: Int): void {
    this.emit(context, ManageHVisible(index))
  }

  fun emitVVisible(context: mutable SKFS.Context, index: Int): void {
    this.emit(context, ManageVVisible(index))
  }

  fun emitTarget(context: mutable SKFS.Context, optTarget: ?Ui.Position): void {
    this.emit(context, DnDTarget(optTarget));
  }

  fun emitSelectLine(context: mutable SKFS.Context, line: Int): void {
    this.emit(context, SelectLine(line))
  }

  fun emitAll(
    context: mutable SKFS.Context,
    commands: readonly Vector<Command>,
  ): void {
    this.emit(context, All(commands.toArray()))
  }

  private fun emit(
    context: mutable SKFS.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(
      context,
      statePath,
      this.storage.getDirName().toString(),
      command,
    )
  }

  fun emitOpenGoToLine(context: mutable SKFS.Context): void {
    context.openInputDialog(
      !"What is the line number?",
      todo()/*SKUIMessage.Target::forClass(
      statePath,
      this.storage.getDirName().toString(),
      "UiMonospace.GoToLine",
      )*/ ,
      true,
      None(),
      UiDialogs.Settings{
        //TODO: optPlaceHolder => Some((!"Line Number").toJSON()),
        maxChars => 6,
        kind => UiInput.Integer(Some(1)),
      },
    )
  }
}

class TextCommandsManager(state: HState) extends Ui.TextCommandsManager {
  //
  fun manageAcquire(context: mutable SKFS.Context): void {
    SystemProperties.setRequireFocus(context, this.state.path);
  }

  fun getSelectToPosCommand(position: Ui.Position): SKUIMessage.Command {
    SelectTo(TPos(Some(position)))
  }

  fun getGoToPosCommand(position: Ui.Position): SKUIMessage.Command {
    GoTo(TPos(Some(position)))
  }

  fun getSetMoveSelectionCommand(move: Bool): SKUIMessage.Command {
    SetMoveSelection(move)
  }

  fun getSetArmedCommand(armed: Bool): SKUIMessage.Command {
    SetArmed(armed)
  }

  fun getSelectGroupCommand(): SKUIMessage.Command {
    SelectTo(TGroup(None()))
  }

  fun getSelectLineCommand(): SKUIMessage.Command {
    SelectTo(TInLine(None()))
  }

  fun getSelectAllCommand(): SKUIMessage.Command {
    SelectTo(TAll())
  }

  fun getDeleteSelectionCommand(): SKUIMessage.Command {
    DeleteTo(TPos(None()))
  }

  fun getInsertCommand(
    str: String,
    ignoreSelection: Bool,
    position: Ui.Position,
  ): SKUIMessage.Command {
    Insert(str, ignoreSelection, Some(position))
  }

  fun getTargetCommand(optPosition: ?Ui.Position): SKUIMessage.Command {
    DnDTarget(optPosition)
  }

  fun emitAll(
    context: mutable SKFS.Context,
    commands: readonly Vector<SKUIMessage.Command>,
  ): void {
    this.state.emitAll(context, commands.map(cmd -> cmd as Command _));
  }
}

class UserData(
  controller: Controller,
  path: Ui.Path,
  source: Int,
) extends SKFS.UserData {}

@debug
fun init(
  context: mutable SKFS.Context,
  path: Ui.Path,
  controller: Controller,
): Parameters {
  source = context.timeStamp().value;
  dirName = Ui.controllerDirName(path);
  computedDirName = SKFS.DirName::make(dirName, "computed/");
  managedDirName = SKFS.DirName::make(dirName, "managed/");
  initKeys = Array[
    linesProp,
    Ui.diacriticProp,
    Ui.unicodeProp,
    displayPositionProp,
    Ui.positionProp,
    Ui.selectionProp,
    Ui.targetProp,
    Ui.historyProp,
    Ui.ensureVisibleProp,
  ];
  preComputedHdl = context.makePreDir(
    f ~> f,
    computedDirName,
    Array<(SKFS.BaseName, SKFS.File)>[(SKFS.KKeys(), SKFS.Keys(initKeys))],
  );
  stateHdl = context.makeDir(
    f ~> f,
    dirName,
    Array<(SKFS.BaseName, SKFS.File)>[
      (Ui.todoProp, Ui.Todo(Ui.Init(), context.tick)),
    ],
  );
  dv = SKFS.IntFile(0);
  toReallyDoHdl = stateHdl.contextWriterKeyMap(
    Ui.Todo::fromFile,
    context,
    SKFS.DirName::make(dirName, "todo/"),
    (context, writer, key, file) ~> {
      if (key == Ui.todoProp) {
        todo = Ui.Todo::fromFile(file);
        timedText = controller.getText(context).getTimed(context);
        if (timedText.i1 > todo.tick && timedText.i2 != source) {
          !todo = Ui.Todo(ManageText(timedText.i0.toString()), timedText.i1)
        };
        timedPosition = controller.getPosition(context).getTimed(context);
        if (timedPosition.i1 > todo.tick && timedPosition.i2 != source) {
          !todo = Ui.Todo(
            GoTo(TPos(Some(timedPosition.i0.decr()))),
            timedPosition.i1,
          )
        };
        timedPortion = controller.getSelection(context).getTimed(context);
        if (timedPortion.i1 > todo.tick && timedPortion.i2 != source) {
          !todo = Ui.Todo(
            SelectTo(TPortion(timedPortion.i0.decr())),
            timedPortion.i1,
          )
        };
        writer.write(key, todo);
      }
    },
  );
  managedHdl = SKFS.derive(
    context,
    dirName.toString(),
    managedDirName,
    toReallyDoHdl,
    Ui.todoProp,
    initKeys,
    update,
    Some(UserData(controller, path, source)),
    Some(preComputedHdl),
  );
  afterSourceHdl = context.makeDir(
    SKFS.IntFile::fromFile,
    SKFS.DirName::make(dirName, "afterSource/"),
    Array[
      (SKFS.KKeys(), dv),
      (linesProp, dv),
      (Ui.diacriticProp, dv),
      (Ui.unicodeProp, dv),
      (Ui.historyProp, dv),
      (Ui.hEnsureVisibleProp, dv),
      (Ui.vEnsureVisibleProp, dv),
      (Ui.positionProp, dv),
      (Ui.targetProp, dv),
      (Ui.selectionProp, dv),
      (displayPositionProp, dv),
      (fontSizeProp, dv),
      (fontLoadingProp, dv),
      (Ui.caretVisibleProp, dv),
    ],
  );
  computedHdl = afterSourceHdl
    .contextWriterKeyMap(
      f ~> f,
      context,
      SKFS.DirName::make(dirName, "after/"),
      (context, writer, key, _) ~> {
        if (key == fontSizeProp) {
          font = context.getThemeFont(UiTheme.Monospace());
          writer.write(
            key,
            context.getTextSupport().getSpaceSize(context, font),
          );
        } else if (key == fontLoadingProp) {
          font = context.getThemeFont(UiTheme.Monospace());
          writer.write(
            key,
            SKFS.BoolFile(context.getFontSupport().isLoading(context, font)),
          );
        } else if (key == Ui.caretVisibleProp) {
          optVisibility = stateHdl.maybeGetProp(
            context,
            Ui.visibilityProp,
            Ui.Visibility::fromFile,
          );
          optCaretVisible = preComputedHdl
            .maybeGetInt(context, caretVisibleTimeProp)
            .map(v -> SKFS.Tick(v));
          writer.write(
            key,
            SKFS.BoolFile(
              optVisibility match {
              | Some(visiblity) ->
                optCaretVisible match {
                | Some(tick) if (visiblity.tick == tick) -> visiblity.visible
                | _ -> true
                }
              | _ -> optCaretVisible.isSome()
              },
            ),
          )
        } else {
          managedHdl.maybeGet(context, key).each(value -> {
            if (key == linesProp) {
              lines = Lines::fromFile(value).value;
              columnsNumber = lines.reduce(
                (acc, l) -> Math.max(acc, l.text.size()),
                0,
              );
              writer.write(numberOfLinesProp, SKFS.IntFile(lines.size()));
              writer.write(numberOfColumnsProp, SKFS.IntFile(columnsNumber));
            };
            writer.write(key, value)
          })
        }
      },
    )
    .contextWriterKeyMap(
      f ~> f,
      context,
      SKFS.DirName::make(dirName, "verified/"),
      (context, writer, key, file) ~> {
        if (key == Ui.selectionProp) {
          portion = Ui.Portion::fromFile(file);
          controller
            .getSelection(context, true)
            .set(context, Some(portion.incr()), source);
          lines = managedHdl
            .maybeGet(context, linesProp)
            .map(Lines::fromFile)
            .default(Lines::empty(() -> context.timeStamp().value)).value;
          sLineIdx = Math.clamp(portion.start.line, 0, lines.size() - 1);
          eLineIdx = Math.clamp(portion.end.line, 0, lines.size() - 1);
          sLine = lines[sLineIdx];
          eLine = lines[eLineIdx];
          sColumnIdx = Math.clamp(portion.start.column, 0, sLine.text.size());
          eColumnIdx = Math.clamp(portion.end.column, 0, eLine.text.size());
          // verify
          writer.write(
            verifiedSelectionProp,
            Ui.Portion(
              Ui.Position(sLineIdx, sColumnIdx),
              Ui.Position(eLineIdx, eColumnIdx),
            ),
          )
        } else if (key == Ui.positionProp) {
          position = Ui.Position::fromFile(file);
          controller
            .getPosition(context, true)
            .set(context, Some(position.incr()), source);
          // verify
          lines = managedHdl
            .maybeGet(context, linesProp)
            .map(Lines::fromFile)
            .default(Lines::empty(() -> context.timeStamp().value)).value;
          lineIdx = Math.clamp(position.line, 0, lines.size() - 1);
          line = lines[lineIdx];
          columnIdx = Math.clamp(position.column, 0, line.text.size());
          writer.write(verifiedPositionProp, Ui.Position(lineIdx, columnIdx))
        } else if (key == Ui.targetProp) {
          position = Ui.Position::fromFile(file);
          // verify
          lines = managedHdl
            .maybeGet(context, linesProp)
            .map(Lines::fromFile)
            .default(Lines::empty(() -> context.timeStamp().value)).value;
          lineIdx = Math.clamp(position.line, 0, lines.size() - 1);
          line = lines[lineIdx];
          columnIdx = Math.clamp(position.column, 0, line.text.size());
          writer.write(verifiedTargetProp, Ui.Position(lineIdx, columnIdx))
        } else if (key == linesProp) {
          controller.getColorSupplier(context).each(supplier ->
            controller.getBracketsChecker(context).each(checker -> {
              colors = mutable Vector<ColorRange>[];
              lines = Lines::fromFile(file).value;
              stack = mutable Vector<Bracket>[];
              optCurrent: ?Bracket = None();
              optPosition: ?Ui.Position = None();
              update = (idx, current, optBracket) -> {
                supplier(String::fromChars(current.value)).each(color ->
                  optPosition.each(start ->
                    colors.push(
                      optBracket match {
                      | Some(bracket) ->
                        ColorRange(
                          start,
                          Ui.Position(
                            idx,
                            bracket.index + bracket.value.size(),
                          ),
                          color,
                        )
                      | _ -> ColorRange(start, Ui.LineEnd(idx), color)
                      },
                    )
                  )
                );
                !optPosition = None();
                !optCurrent = None()
              };
              check: (Int, ?Bracket) -> void = (idx, optBracket) -> {
                optNew = checker(optCurrent, optBracket, stack);
                (optCurrent, optNew) match {
                | (None(), Some(bracket)) ->
                  !optPosition = Some(Ui.Position(idx, bracket.index));
                  !optCurrent = Some(bracket)
                | (Some(current), None()) -> update(idx, current, optBracket)
                | (
                  Some(current),
                  Some(bracket),
                ) if (
                  optCurrent.map(b -> b.value) != optNew.map(b -> b.value)
                ) ->
                  update(idx, current, optBracket);
                  !optPosition = Some(Ui.Position(idx, bracket.index));
                  !optCurrent = Some(bracket)
                | (None(), None())
                | (Some _, Some _) ->
                  !optCurrent = optNew
                }
              };
              lines.eachWithIndex((idx, line) -> {
                line.brackets.each(bracket -> check(idx, Some(bracket)));
                check(idx, None())
              });
              writer.write(
                colorsProp,
                ColorRanges(unsafe_chill_trust_me(colors)),
              )
            })
          )
        };
        writer.write(key, file);
      },
    )
    .contextWriterKeyMap(
      f ~> f,
      context,
      computedDirName,
      (context, writer, key, file) ~>
        if (key == verifiedPositionProp) {
          if (stateHdl.getBool(context, Ui.blinkingProp)) {
            writer.write(
              caretVisibleTimeProp,
              SKFS.IntFile(context.tick.value),
            );
            SKUIMessage.emit(
              context,
              statePath,
              dirName.toString(),
              ToggleHidden(context.tick),
              false,
              Some(500),
            );
          };
          writer.write(key, file)
        } else {
          writer.write(key, file)
        }
      ,
    );
  Parameters(controller, HState(path, stateHdl, computedHdl))
}

@debug
fun update(
  context: mutable SKFS.Context,
  _scope: String,
  values: mutable Map<SKFS.BaseName, ?SKFS.File>,
  todo: Ui.Todo,
  optUserData: ?UserData,
): void {
  userData = optUserData.fromSome();
  optBracketsBuilder = userData.controller.getBracketsBuilder(context, true);
  (pagesCount, optRange) = if (FWKPipeline.gNodeInfo.exists(context)) {
    FWKPipeline.gNodeInfo.maybeGetValue(context, userData.path, true)
      .flatMap(ni ->
        ni.info.optUserData
          .map(ud ~> ud as Metrics _)
          .map(metrics ->
            (
              (metrics.vertical.pageCount, metrics.vertical.pageCount),
              Some(metrics.vertical.range),
            )
          )
      )
      .default(((80, 40), None()))
  } else {
    ((80, 40), None())
  };
  updater = mutable Updater(
    values,
    mutable Vector[],
    mutable Vector[],
    optBracketsBuilder.default((_, _, _) ~> None()),
    userData.controller.getEndLine(context, true).get(context, true),
    userData.controller.getIndentation(context, true).get(context, true),
    userData.controller.isEditable(context, true),
    () -> context.timeStamp().value,
    pagesCount,
    optRange,
    (ctx, str) ~>
      userData.controller
        .getText(ctx, true)
        .set(ctx, Some(str), userData.source),
    (ctx, policy) ~>
      userData.controller.getStorePolicies(ctx, true).contains(policy)
    ,
  );
  execute(context, todo.command, updater);
}

@debug
fun execute(
  context: mutable SKFS.Context,
  executable: Ui.Executable,
  updater: mutable Updater,
): void {
  check = true;
  oldPosition = updater.getPosition();
  oldSelection = updater.getSelection();
  executable match {
  | Ui.Multiple(cmds) -> cmds.each(cmd -> execute(context, cmd, updater))
  | Ui.Init() -> !check = false
  | ManageText(value) ->
    updater.setText(value);
    updater.ensureVisible(context)
  | ManageDiacritic(char) ->
    if (updater.manageDiacritic(char)) {
      updater.ensureVisible(context)
    }
  | Copy() -> _ = updater.copy(context)
  | Cut() ->
    updater.cut(context);
    updater.ensureVisible(context)
  | Save() -> updater.save(context)
  | Paste(content) ->
    updater.paste(content);
    updater.ensureVisible(context)
  | Duplicate() ->
    updater.duplicate();
    updater.ensureVisible(context)
  | SwitchLine() ->
    updater.switchLine();
    updater.ensureVisible(context)
  | DecrLine _ ->
    updater.decrLine();
    updater.ensureVisible(context)
  | IncrLine _ ->
    updater.incrLine();
    updater.ensureVisible(context)
  | Indent _ ->
    updater.indent();
    updater.ensureVisible(context)
  | Outdent _ ->
    updater.outdent();
    updater.ensureVisible(context)
  | Insert(text, ignoreSelection, optPosition) ->
    updater.insert(text.chars().toArray(), ignoreSelection, optPosition);
    updater.ensureVisible(context)
  | DnDTarget(optPosition) -> updater.values.set(Ui.targetProp, optPosition)
  | Upper() -> updater.modify(Unicode.toUpper)
  | Lower() -> updater.modify(Unicode.toLower)
  | ManageHScrolling(incr, _) ->
    updater.values.set(Ui.hEnsureVisibleProp, Some(Ui.Incr(incr, context.tick)))
  | ManageVScrolling(incr, _) ->
    updater.values.set(Ui.vEnsureVisibleProp, Some(Ui.Incr(incr, context.tick)))
  | ManageHVisible(visible) ->
    updater.values.set(
      Ui.hEnsureVisibleProp,
      Some(Ui.Pos(visible, context.tick)),
    )
  | ManageVVisible(visible) ->
    updater.values.set(
      Ui.vEnsureVisibleProp,
      Some(Ui.Pos(visible, context.tick)),
    )
  | GoToLine(optLineNumber) ->
    optLineNumber.each(lineNumber ->
      updater.goToLine(context, lineNumber.toInt())
    )
  | SelectLine(lineIdx) ->
    updater.selectLine(lineIdx);
    updater.ensureVisible(context)
  | GoTo(target, _, _) ->
    updater.goTo(target);
    updater.ensureVisible(context)
  | DeleteTo(target, _, _) ->
    updater.deleteTo(target);
    updater.ensureVisible(context)
  | ManageUnicode(optValue) ->
    if (updater.manageUnicode(optValue)) {
      updater.ensureVisible(context)
    }
  | SelectTo(selection, _, _) ->
    if (updater.selectTo(selection)) {
      updater.ensureVisible(context)
    }
  | Undo _ ->
    updater.undoRedo(context, h ~> h.undo);
    !check = false
  | Redo _ ->
    updater.undoRedo(context, h ~> h.redo);
    !check = false
  | NewLine _ ->
    updater.insert(updater.endLine.toChars());
    updater.ensureVisible(context)
  | _ -> SKFS.cast_violation("UiMonospace.Executable", executable)
  };
  if (check && updater.isEditable && !updater.redo.isEmpty()) {
    optOldHistory = updater.values.get(Ui.historyProp).map(History::fromFile);
    history = optOldHistory match {
    | Some(history) ->
      newPosition = updater.getPosition();
      newSelection = updater.getSelection();
      undo = updater.undo.reversed();
      redo = updater.redo.chill();
      updater.undo.clear();
      updater.redo.clear();
      history.add(
        LamUndoable(
          (u, tick) ~> {
            undo.each(u.patch);
            u.setPosition(oldPosition);
            u.setSelection(oldSelection);
            u.setHEnsureVisible(Ui.Pos(oldPosition.column, tick));
            u.setVEnsureVisible(Ui.Pos(oldPosition.line, tick));
          },
          (u, tick) ~> {
            redo.each(u.patch);
            u.setPosition(newPosition);
            u.setSelection(newSelection);
            u.setHEnsureVisible(Ui.Pos(newPosition.column, tick));
            u.setVEnsureVisible(Ui.Pos(newPosition.line, tick));
          },
        ),
      )
    | None() -> History()
    };
    updater.values.set(Ui.historyProp, Some(history));
    if (updater.hasStorePolicies(context, OnChange())) {
      updater.save(context)
    }
  }
}

module end;
