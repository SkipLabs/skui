module UiSlider;

base class Thumb extends SKStore.File uses Equality {
  children =
  | Min()
  | Max()
}

base class Variable(source: Int) extends SKStore.File uses Orderable {
  children =
  | VRange(min: Int, max: Int)
  | VValue(value: Int)

  static fun btype(f: SKStore.File): Variable {
    f match {
    | x @ Variable _ -> x
    | _ -> invariant_violation("")
    }
  }
}

base class Value extends SKStore.File {
  children =
  | RangeProp(value: Ui.RangeProperty)
  | IntProp(value: Ui.IntProperty)

  static fun btype(f: SKStore.File): Variable {
    f match {
    | x @ Variable _ -> x
    | _ -> invariant_violation("")
    }
  }
}

class Step(value: Int, first: Int = 0)

base class Controller extends SKStore.UserData {
  fun isRange(
    context: mutable SKStore.Context,
    isUnkracked: Bool = false,
  ): Bool;
  fun getRange(
    context: mutable SKStore.Context,
    isUnkracked: Bool = false,
  ): Range;
  fun getStep(
    context: mutable SKStore.Context,
    isUnkracked: Bool = false,
  ): Step;

  fun isDisabled(context: mutable SKStore.Context): Bool;
  fun getDirection(context: mutable SKStore.Context): Ui.Axis;
  fun isWithLabel(context: mutable SKStore.Context): Bool;
  fun isSmall(context: mutable SKStore.Context): Bool;
  fun getTicks(context: mutable SKStore.Context): ?Step;

  fun getValue(
    context: mutable SKStore.Context,
    isUnkracked: Bool = false,
  ): Value;
}

base class State {
  fun getHover(context: mutable SKStore.Context): ?Thumb;
  fun isArmed(context: mutable SKStore.Context): Bool;
  fun getValue(context: mutable SKStore.Context): Variable;

  fun emitHover(context: mutable SKStore.Context, optThumb: ?Thumb): void;
  fun emitArmed(context: mutable SKStore.Context, value: Bool): void;
  fun emitReset(context: mutable SKStore.Context): void;
  fun emitAll(
    context: mutable SKStore.Context,
    commands: readonly Vector<Command>,
  ): void;
  fun emitGoTo(
    context: mutable SKStore.Context,
    thumb: Thumb,
    next: Bool,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;
  fun emitSetProportion(
    context: mutable SKStore.Context,
    thumb: Thumb,
    value: Float,
  ): void;
}

base class Storage {
  fun getName(): String;
  fun getScope(): String;
  fun setTodo(context: mutable SKStore.Context, cmd: Executable): void;
  fun setArmed(context: mutable SKStore.Context, value: Bool): void;
  fun setHover(context: mutable SKStore.Context, optThumb: ?Thumb): void;
}

class Parameters(controller: Controller, state: State) extends Ui.Parameters {}

module end;
