module UiSlider;

class LamController{
  value: (mutable SKStore.Context, Bool) ~> Value,
  range: (mutable SKStore.Context, Bool) ~> Range,
  rangeKind: (mutable SKStore.Context, Bool) ~> Bool = (_ctx, _iu) ~> false,
  step: (mutable SKStore.Context, Bool) ~> Step = (_ctx, _iu) ~> Step(1),
  ticks: mutable SKStore.Context ~> ?Step = _ctx ~> None(),
  disabled: mutable SKStore.Context ~> Bool = _ctx ~> false,
  direction: mutable SKStore.Context ~> Ui.Axis = _ctx ~> Ui.HorizontalAxis(),
  withLabel: mutable SKStore.Context ~> Bool = _ctx ~> false,
  small: mutable SKStore.Context ~> Bool = _ctx ~> false,
} extends Controller {
  //
  fun isRange(
    context: mutable SKStore.Context,
    isUnkracked: Bool = false,
  ): Bool {
    this.rangeKind(context, isUnkracked)
  }

  fun getRange(
    context: mutable SKStore.Context,
    isUnkracked: Bool = false,
  ): Range {
    this.range(context, isUnkracked)
  }

  fun getStep(
    context: mutable SKStore.Context,
    isUnkracked: Bool = false,
  ): Step {
    this.step(context, isUnkracked)
  }

  fun isDisabled(context: mutable SKStore.Context): Bool {
    this.disabled(context)
  }

  fun getDirection(context: mutable SKStore.Context): Ui.Axis {
    this.direction(context)
  }

  fun isWithLabel(context: mutable SKStore.Context): Bool {
    this.withLabel(context)
  }

  fun isSmall(context: mutable SKStore.Context): Bool {
    this.small(context)
  }

  fun getTicks(context: mutable SKStore.Context): ?Step {
    this.ticks(context)
  }

  fun getValue(
    context: mutable SKStore.Context,
    isUnkracked: Bool = false,
  ): Value {
    this.value(context, isUnkracked)
  }
}

module end;
