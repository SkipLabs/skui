module UiSlider;

extension base class Command {
  //
  fun toJSON(): JSON.Value
  | SetProportion(thumb, value) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "thumb" => thumb.toJSON(),
        "value" => JSON.IntNumber(value),
      ],
    )
  | Multiples(commands) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "commands" => JSON.arrayToJSON(commands, cmd ~> cmd.toJSON()),
      ],
    )
  | SetHover(optHover) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => optHover.map(t -> t.toJSON()).default(JSON.Null()),
      ].filter((_k, v) -> !v.isNull()),
    )
  | SetArmed(value) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "value" => JSON.Bool(value),
      ],
    )
  | Reset() -> JSON.Object(Map["__class" => JSON.String(this.getClassName())])
  | GoTo(thumb, next, optRepeatOn, count) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "thumb" => thumb.toJSON(),
        "next" => JSON.Bool(next),
        "repeatOn" => optRepeatOn
          .map(repeatOn -> repeatOn.toJSON())
          .default(JSON.Null()),
        "count" => JSON.IntNumber(count),
      ].filter((_k, v) -> !v.isNull()),
    )

  static fun fromJSON(jsv: JSON.Value): Command {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiSlider.SetProportion" ->
      SetProportion(Thumb::fromJSON(jso.get("thumb")), jso.getInt("value"))
    | "UiSlider.SetHover" ->
      SetHover(jso.maybeGet("value").map(Thumb::fromJSON))
    | "UiSlider.SetArmed" -> SetArmed(jso.getBool("value"))
    | "UiSlider.Reset" -> Reset()
    | "UiSlider.Multiples" ->
      Multiples(JSON.arrayFromJSON(jso.getArray("commands"), static::fromJSON))
    | "UiSlider.GoTo" ->
      GoTo(
        Thumb::fromJSON(jso.get("thumb")),
        jso.getBool("next"),
        jso.maybeGet("repeatOn").map(FWK.Repeat::fromJSON),
        jso.getInt("count"),
      )
    | _ -> invariant_violation(`Invalid json object ${cl} for UiSlider.Command`)
    }
  }
}

extension base class Thumb extends JSONValue {
  //
  fun toJSON(): JSON.Value
  | Min()
  | Max() ->
    JSON.Object(Map["__class" => JSON.String(this.getClassName())])

  static fun fromJSON(jsv: JSON.Value): Thumb {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "UiSlider.Min" -> Min()
    | "UiSlider.Max" -> Max()
    | _ -> invariant_violation(`Invalid json object ${cl} for UiSlider.Thumb`)
    }
  }
}

module end;
