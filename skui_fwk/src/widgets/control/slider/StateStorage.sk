module UiSlider;

const statePath: String = "ui/slider/state";
const computedPath: String = "ui/slider/computed";
const factor: Float = 10000.0;

class HStorage(name: String, handle: SKFS.IHandle<SKFS.File>) extends Storage {
  //
  static fun forNameAndScope(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKFS.IHandle(SKFS.FileConverter(f ~> f), SKFS.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun setHover(context: mutable SKFS.Context, optThumb: ?Thumb): void {
    this.handle.writeOrRemove(context, Ui.hoverProp, optThumb)
  }

  fun setArmed(context: mutable SKFS.Context, value: Bool): void {
    this.handle.write(context, Ui.armedProp, SKFS.BoolFile(value))
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setTodo(context: mutable SKFS.Context, value: Executable): void {
    this.handle.write(context, Ui.todoProp, Ui.Todo(value, context.tick))
  }
}

class HState(
  storage: SKFS.EHandle<SKFS.File>,
  computed: SKFS.EHandle<SKFS.File>,
) extends State {
  fun getHover(context: mutable SKFS.Context): ?Thumb {
    this.storage.maybeGetProp(context, Ui.hoverProp, f ~> f as Thumb _)
  }

  fun isArmed(context: mutable SKFS.Context): Bool {
    this.storage.getBool(context, Ui.armedProp)
  }

  fun getValue(context: mutable SKFS.Context): Variable {
    this.computed.getProp(
      context,
      Ui.valueProp,
      Variable::forFile,
      VValue(0, 0),
    );
  }

  fun emitGoTo(
    context: mutable SKFS.Context,
    thumb: Thumb,
    next: Bool,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, GoTo(thumb, next, optRepeatOn));
  }

  fun emitSetProportion(
    context: mutable SKFS.Context,
    thumb: Thumb,
    value: Float,
  ): void {
    this.emit(context, SetProportion(thumb, (value * factor).toInt()));
  }

  fun emitArmed(context: mutable SKFS.Context, value: Bool): void {
    this.emit(context, SetArmed(value))
  }

  fun emitHover(context: mutable SKFS.Context, optThumb: ?Thumb): void {
    this.emit(context, SetHover(optThumb))
  }

  fun emitReset(context: mutable SKFS.Context): void {
    this.emit(context, Reset())
  }

  fun emitAll(
    context: mutable SKFS.Context,
    commands: readonly Vector<Command>,
  ): void {
    if (!commands.isEmpty()) {
      if (commands.size() == 1) {
        this.emit(context, commands.first())
      } else {
        this.emit(context, Multiples(commands.toArray()))
      }
    }
  }

  private fun emit(
    context: mutable SKFS.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(
      context,
      statePath,
      this.storage.getDirName().toString(),
      command,
    );
  }
}

class UserData(controller: Controller, source: Int) extends SKFS.UserData {}

fun init(
  context: mutable SKFS.Context,
  path: Ui.Path,
  controller: Controller,
): Parameters {
  source = context.timeStamp().value;
  dirName = Ui.controllerDirName(path);
  filteredDirName = SKFS.DirName::make(dirName, "filtered/");
  stateHdl = context.makeDir(
    f ~> f,
    dirName,
    Array<(SKFS.BaseName, SKFS.File)>[
      (Ui.todoProp, Ui.Todo(Init(), context.tick)),
    ],
  );
  preFilteredHdl = context.makePreDir(f ~> f, filteredDirName, Array[]);
  filteredHdl = stateHdl.contextWriterKeyMap(
    Ui.Todo::fromFile,
    context,
    filteredDirName,
    (context, writer, key, file) ~> {
      if (key == Ui.todoProp) {
        todo = Ui.Todo::fromFile(file);
        executables = mutable Vector<Executable>[];
        optCurrent = preFilteredHdl.maybeGetProp(
          context,
          key,
          Ui.Todo::fromFile,
          true,
        );
        tick = optCurrent.map(c -> c.tick).default(SKFS.Tick(-1));
        max = tick;
        if (todo.tick > tick) {
          executables.push(todo.command as Executable _);
          !max = todo.tick;
        };
        check: (SKFS.Tick, Variable) -> void = (ttick, v) -> {
          if (ttick > tick) {
            if (ttick > todo.tick) {
              executables.push(SetValue(v));
            } else {
              executables.insert(0, SetValue(v));
            };
            if (ttick > max) {
              !max = todo.tick;
            }
          }
        };
        controller.getValue(context) match {
        | IntProp(prop) ->
          (v, ttick, src) = prop.getTimed(context);
          if (src != source) {
            check(ttick, VValue(v, src))
          }
        | RangeProp(prop) ->
          (v, ttick, src) = prop.getTimed(context);
          if (src != source) {
            check(ttick, VRange(v.start, v.end, src))
          }
        };
        size = executables.size();
        if (size == 0) {
          optCurrent.each(c -> writer.write(key, c))
        } else if (size == 1) {
          toUpdate = executables.first();
          write = optCurrent
            .map(c ->
              c.command match {
              | SetProportion(ot, ov) ->
                toUpdate match {
                | SetProportion(nt, nv) -> ot != nt || ov != nv
                | _ -> true
                }
              | _ -> true
              }
            )
            .default(true);
          if (write) {
            writer.write(key, Ui.Todo(executables.first(), max))
          } else {
            optCurrent.each(c -> writer.write(key, c))
          }
        } else {
          writer.write(
            key,
            Ui.Todo(All(unsafe_chill_trust_me(executables)), max),
          )
        }
      }
    },
  );
  computedDirName = SKFS.DirName::make(dirName, "computed/");
  computedHdl = SKFS.derive(
    context,
    dirName.toString(),
    computedDirName,
    filteredHdl,
    Ui.todoProp,
    Array[Ui.valueProp],
    update,
    Some(UserData(controller, source)),
  );
  check: (Int, Range, Step) ~> Int = (c, r, s) ~> {
    incr = if (s.first > 0) s.first else s.value;
    v = r.start;
    Math.min(
      loop {
        if (c <= v + incr / 2) {
          break v;
        };
        !v = v + incr;
        !incr = s.value;
      },
      r.end,
    );
  };
  afterHdl = computedHdl.contextWriterKeyMap(
    f ~> f,
    context,
    SKFS.DirName::make(dirName, "after/"),
    (context, writer, key, file) ~> {
      if (key == Ui.valueProp) {
        step = controller.getStep(context, true);
        range = controller.getRange(context, true);
        var = Variable::forFile(file) match {
        | VRange(vMin, vMax, src) ->
          nMin = check(vMin, range, step);
          nMax = check(vMax, range, step);
          VRange(Math.min(nMin, nMax), Math.max(nMin, nMax), src)
        | VValue(value, src) -> VValue(check(value, range, step), src)
        };
        writer.write(key, var)
      }
    },
  );
  _ = afterHdl.contextWriterKeyMap(
    f ~> f,
    context,
    SKFS.DirName::make(dirName, "notified/"),
    (context, writer, key, file) ~>
      if (key == Ui.valueProp) {
        controller.getValue(context, true) match {
        | IntProp(prop) ->
          file match {
          | VValue(v, src) ->
            if (src == source) {
              prop.set(context, Some(v), source)
            }
          | _ -> print_error("Invalid int slider value")
          }
        | RangeProp(prop) ->
          file match {
          | VRange(min, max, src) ->
            if (src == source) {
              prop.set(context, Some(Range(min, max)), source)
            }
          | _ -> print_error("Invalid range slider value")
          }
        };
        writer.write(key, file);
      }
    ,
  );
  Parameters(controller, HState(stateHdl, afterHdl))
}

fun update(
  context: mutable SKFS.Context,
  _scope: String,
  values: mutable Map<SKFS.BaseName, ?SKFS.File>,
  todo: Ui.Todo,
  optUserData: ?UserData,
): void {
  userData = optUserData.fromSome();
  isRange = userData.controller.isRange(context, true);
  range = userData.controller.getRange(context, true);
  value = values
    .get(Ui.valueProp)
    .map(Variable::forFile)
    .default(
      if (isRange) {
        VRange(range.start, range.end, 0)
      } else {
        VValue(range.start, 0)
      },
    );
  step = userData.controller.getStep(context, true);
  nValue = execute(
    todo.command as Executable _,
    value,
    range,
    step,
    userData.source,
  );
  values.set(Ui.valueProp, Some(nValue));
}

fun execute(
  executable: Executable,
  value: Variable,
  range: Range,
  step: Step,
  source: Int,
): Variable {
  executable match {
  | All(cmds) ->
    cmds.each(cmd -> {
      !value = execute(cmd, value, range, step, source)
    });
    value
  | Init() -> value
  | SetValue(v) -> v
  | SetProportion(thumb, v) ->
    proportion = v.toFloat() / factor;
    res = Math.round((range.end - range.start).toFloat() * proportion).toInt();
    value match {
    | VRange(vMin, vMax, _) ->
      thumb match {
      | Min() -> VRange(Math.min(res, vMax), vMax, source)
      | Max() -> VRange(vMin, Math.max(vMin, res), source)
      }
    | _ -> VValue(res, source)
    }
  | GoTo(thumb, next, _, count) ->
    occ = Math.max(count / 10, 1);
    value match {
    | VRange(vMin, vMax, _) ->
      thumb match {
      | Min() ->
        if (next) {
          incr = if (vMin == range.start && step.first > 0) {
            step.first
          } else {
            step.value
          };
          VRange(Math.min(vMin + occ * incr, vMax), vMax, source)
        } else {
          VRange(Math.max(range.start, vMin - occ * step.value), vMax, source)
        }
      | Max() ->
        if (next) {
          incr = if (vMax == range.start && step.first > 0) {
            step.first
          } else {
            step.value
          };
          VRange(vMin, Math.min(vMax + occ * incr, range.end), source)
        } else {
          VRange(vMin, Math.max(vMin, vMax - occ * step.value), source)
        }
      }
    | VValue(v, _) ->
      VValue(
        if (next) {
          incr = if (v == range.start && step.first > 0) {
            step.first
          } else {
            step.value
          };
          Math.min(v + occ * incr, range.end);
        } else {
          Math.max(range.start, v - occ * step.value);
        },
        source,
      )
    }
  }
}

module end;
