module UiSplit;

class HoverHandler(split: Ui.Split) extends FWK.HoverHandler {
  //
  fun getIdentifier(): Ui.Path {
    this.split.path
  }

  fun enter(context: mutable SKFS.Context): void {
    FWKPointer.setCursor(
      context,
      this.split.controller.getAxis(context, true) match {
      | Ui.HorizontalAxis() -> Ui.HorizontalResizeCursor()
      | Ui.VerticalAxis() -> Ui.VerticalResizeCursor()
      },
    );
  }

  fun manage(
    _context: mutable SKFS.Context,
    _mouse: UiEvent.MouseFile,
    _optPrevious: ?FWK.HoverHandler,
  ): FWK.Result {
    FWK.Result(false)
  }

  fun exit(context: mutable SKFS.Context): void {
    FWKPointer.resetCursor(context)
  }

  fun getTooltip(_context: mutable SKFS.Context): ?FWK.SourcedWidget {
    None()
  }
}

class LockHandler(split: Ui.Split) extends FWK.LockHandler {
  //
  fun update(
    context: mutable SKFS.Context,
    mouse: UiEvent.MouseFile,
  ): ?FWK.LockHandler {
    if (!mouse.isPrimaryDown(context.tick)) {
      None()
    } else {
      FWKPipeline.gNodeInfo.maybeGetValue(
        context,
        this.split.path,
        true,
      ).flatMap(nodeInfo -> {
        wOffset = nodeInfo.info.getWindowOffset(context, true, true);
        size = nodeInfo.info.size();
        separationProp = this.split.controller.getSeparation(context, true);
        current = separationProp.get(context, true);
        separation = this.split.controller.getAxis(context) match {
        | Ui.HorizontalAxis() ->
          current.update(
            Math.clamp(mouse.absolute.dx - wOffset.dx, 0.0, size.width),
            size.width,
          )
        | _ ->
          current.update(
            Math.clamp(mouse.absolute.dy - wOffset.dy, 0.0, size.height),
            size.height,
          )
        };
        separationProp.set(context, Some(separation), 0);
        Some(this);
      })
    }
  }
}

module end;
