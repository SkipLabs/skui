module UiTab;

class LamController{
  disabled: mutable SKFS.Context ~> Bool = _ctx ~> false,
  active: mutable SKFS.Context ~> Bool = _ctx ~> false,
  selected: mutable SKFS.Context ~> Bool = _ctx ~> false,
  closable: mutable SKFS.Context ~> Bool = _ctx ~> false,
  pinned: mutable SKFS.Context ~> Bool = _ctx ~> false,
  text: mutable SKFS.Context ~> ?Text = _ctx ~> None(),
  side: mutable SKFS.Context ~> .UiSide = _ctx ~> UiSide.Top(),
  icon: (mutable SKFS.Context, Float) ~> ?Icon = (_ctx, _fs) ~> None(),
  mode: mutable SKFS.Context ~> Mode = _ctx ~> Basic(),
  discriminant: mutable SKFS.Context ~> ?Text = _ctx ~> None(),
  tooltip: mutable SKFS.Context ~> ?Text = _ctx ~> None(),
  badge: mutable SKFS.Context ~> ?Ui.Badge = _ctx ~> None(),
  progress: mutable SKFS.Context ~> ?Ui.Progress = _ctx ~> None(),
  fireMessage: (mutable SKFS.Context, Bool) ~> Array<SKUIMessage.Message> = (
    _ctx,
    _iu,
  ) ~>
    Array[],
  closeMessages: (mutable SKFS.Context, Bool) ~> Array<SKUIMessage.Message> = (
    _ctx,
    _iu,
  ) ~>
    Array[],
  dropMessages: (mutable SKFS.Context, String, String, Bool, Bool) ~> Array<
    SKUIMessage.Message,
  > = (_ctx, _src, _dst, _b, _iu) ~> Array[],
} extends Controller {
  //
  fun isDisabled(context: mutable SKFS.Context): Bool {
    this.disabled(context)
  }

  fun isActive(context: mutable SKFS.Context): Bool {
    this.active(context)
  }

  fun isSelected(context: mutable SKFS.Context): Bool {
    this.selected(context)
  }

  fun isClosable(context: mutable SKFS.Context): Bool {
    this.closable(context)
  }

  fun isPinned(context: mutable SKFS.Context): Bool {
    this.pinned(context)
  }

  fun getText(context: mutable SKFS.Context): ?Text {
    this.text(context)
  }

  fun getIcon(context: mutable SKFS.Context, fontSize: Float): ?Icon {
    this.icon(context, fontSize)
  }

  fun getSide(context: mutable SKFS.Context): .UiSide {
    this.side(context)
  }

  fun getMode(context: mutable SKFS.Context): Mode {
    this.mode(context)
  }

  fun getDiscriminant(context: mutable SKFS.Context): ?Text {
    this.discriminant(context)
  }

  fun getTooltip(context: mutable SKFS.Context): ?Text {
    this.tooltip(context)
  }

  fun getBadge(context: mutable SKFS.Context): ?Ui.Badge {
    this.badge(context)
  }

  fun getProgress(context: mutable SKFS.Context): ?Ui.Progress {
    this.progress(context)
  }

  fun getFireMessages(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.fireMessage(context, isUntracked)
  }

  fun getCloseMessages(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.closeMessages(context, isUntracked)
  }
  fun getDropMessages(
    context: mutable SKFS.Context,
    source: String,
    destination: String,
    before: Bool,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.dropMessages(context, source, destination, before, isUntracked)
  }
}

class DerivedController(
  getter: (mutable SKFS.Context, Bool) ~> ?Controller,
) extends Controller {
  //
  fun isDisabled(context: mutable SKFS.Context): Bool {
    this.get(context, c -> c.isDisabled(context), false)
  }

  fun isActive(context: mutable SKFS.Context): Bool {
    this.get(context, c -> c.isActive(context), false)
  }

  fun isSelected(context: mutable SKFS.Context): Bool {
    this.get(context, c -> c.isSelected(context), false)
  }

  fun isClosable(context: mutable SKFS.Context): Bool {
    this.get(context, c -> c.isClosable(context), false)
  }

  fun isPinned(context: mutable SKFS.Context): Bool {
    this.get(context, c -> c.isPinned(context), false)
  }

  fun getText(context: mutable SKFS.Context): ?Text {
    default: ?Text = None();
    this.get(context, c -> c.getText(context), default)
  }

  fun getSide(context: mutable SKFS.Context): .UiSide {
    default: .UiSide = UiSide.Top();
    this.get(context, c -> c.getSide(context), default)
  }

  fun getIcon(context: mutable SKFS.Context, fontSize: Float): ?Icon {
    default: ?Icon = None();
    this.get(context, c -> c.getIcon(context, fontSize), default)
  }

  fun getMode(context: mutable SKFS.Context): Mode {
    default: Mode = Basic();
    this.get(context, c -> c.getMode(context), default)
  }

  fun getDiscriminant(context: mutable SKFS.Context): ?Text {
    default: ?Text = None();
    this.get(context, c -> c.getDiscriminant(context), default)
  }

  fun getTooltip(context: mutable SKFS.Context): ?Text {
    default: ?Text = None();
    this.get(context, c -> c.getTooltip(context), default)
  }

  fun getBadge(context: mutable SKFS.Context): ?Ui.Badge {
    default: ?Ui.Badge = None();
    this.get(context, c -> c.getBadge(context), default)
  }

  fun getProgress(context: mutable SKFS.Context): ?Ui.Progress {
    default: ?Ui.Progress = None();
    this.get(context, c -> c.getProgress(context), default)
  }

  fun getFireMessages(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    default: Array<SKUIMessage.Message> = Array[];
    this.get(
      context,
      c -> c.getFireMessages(context, isUntracked),
      default,
      isUntracked,
    )
  }

  fun getCloseMessages(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    default: Array<SKUIMessage.Message> = Array[];
    this.get(
      context,
      c -> c.getCloseMessages(context, isUntracked),
      default,
      isUntracked,
    );
  }

  fun getDropMessages(
    context: mutable SKFS.Context,
    source: String,
    destination: String,
    before: Bool,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    default: Array<SKUIMessage.Message> = Array[];
    this.get(
      context,
      c -> c.getDropMessages(context, source, destination, before, isUntracked),
      default,
      isUntracked,
    );
  }

  private fun get<T: frozen>(
    context: mutable SKFS.Context,
    getter: Controller -> T,
    default: T,
    isUntracked: Bool = false,
  ): T {
    this.getter(context, isUntracked) match {
    | Some(controller) -> getter(controller)
    | _ -> default
    }
  }
}

module end;
