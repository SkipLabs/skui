module UiTab;

class DragHandler(tab: Ui.Tab) extends FWK.DragHandler {
  fun getTransfer(_context: mutable SKFS.Context): FWK.Transfer {
    FWK.TrMove()
  }

  fun getClipboardContent(
    _context: mutable SKFS.Context,
  ): ?FWKClipboard.Content {
    Some(FWKClipboard.Content::plain(this.tab.path.id))
  }

  fun getDragInfo(_context: mutable SKFS.Context): ?FWK.DragInfo {
    None()
  }

  fun dropped(
    _context: mutable SKFS.Context,
    _optInfo: ?(FWK.DropHandler, FWK.TransferMode),
  ): void {
    void
  }
}

class DropHandler(tab: Ui.Tab, drop: Ui.Drop) extends FWK.DropHandler {
  fun getIdentifier(): String {
    this.tab.path.makeChild(this.drop.toString()).toString()
  }

  fun exit(context: mutable SKFS.Context): void {
    this.tab.state.emitTargeted(context, None());
  }

  fun over(
    context: mutable SKFS.Context,
    _mouse: UiEvent.MouseFile,
    dragHandler: FWK.DragHandler,
    transfer: FWK.TransferMode,
  ): ?FWK.TransferMode {
    mode = FWK.TrMove().choose(transfer);
    dragHandler match {
    | tdh @ DragHandler _ if (
      tdh.tab.reference == this.tab.reference &&
      tdh.tab.path.id != this.tab.path.id &&
      mode == FWK.TrMove()
    ) ->
      this.tab.state.emitTargeted(context, Some(this.drop));
      Some(mode)
    | _ -> None()
    }
  }

  fun dropped(
    context: mutable SKFS.Context,
    dragHandler: FWK.DragHandler,
    transfer: FWK.TransferMode,
  ): void {
    dragHandler match {
    | tdh @ DragHandler _ if (
      tdh.tab.reference == this.tab.reference &&
      tdh.tab.path.id != this.tab.path.id &&
      transfer == FWK.TrMove()
    ) ->
      this.tab.controller.getDropMessages(
        context,
        tdh.tab.path.id,
        this.tab.path.id,
        this.drop == Ui.DropBefore(),
        true,
      ).each(message -> FWKMessage.emitMessage(context, message))
    | _ -> void
    };
    this.tab.state.emitTargeted(context, None());
  }
}

module end;
