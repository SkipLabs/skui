module UiTab;

const statePath: String = "ui/tab/state";

class HStorage(name: String, handle: SKFS.IHandle<SKFS.File>) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKFS.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKFS.IHandle(SKFS.FileConverter(f ~> f), SKFS.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setIndeterminate(context: mutable SKFS.Context, optValue: ?Int): void {
    this.handle.writeOrRemove(
      context,
      Ui.indeterminateProp,
      optValue.map(v -> SKFS.IntFile(v)),
    )
  }
}

class HState(handle: SKFS.IHandle<SKFS.File>) extends State {
  //
  fun getArmed(context: mutable SKFS.Context): ?Bool {
    this.handle.maybeGetBool(context, Ui.armedProp)
  }

  fun getHover(context: mutable SKFS.Context): ?Bool {
    this.handle.maybeGetBool(context, Ui.hoverProp)
  }

  fun getIndeterminate(context: mutable SKFS.Context): ?Int {
    this.handle.maybeGetInt(context, Ui.indeterminateProp)
  }

  fun getTargeted(context: mutable SKFS.Context): ?Ui.Drop {
    this.handle.maybeGetProp(context, Ui.targetedProp, f ~> f as Ui.Drop _)
  }

  fun setArmed(context: mutable SKFS.Context, close: Bool, value: Bool): void {
    this.handle.writeOrRemove(
      context,
      Ui.armedProp,
      if (value) Some(SKFS.BoolFile(close)) else None(),
    )
  }

  fun setHover(context: mutable SKFS.Context, close: Bool, value: Bool): void {
    this.handle.writeOrRemove(
      context,
      Ui.hoverProp,
      if (value) Some(SKFS.BoolFile(close)) else None(),
    )
  }

  fun setTargeted(context: mutable SKFS.Context, optDrop: ?Ui.Drop): void {
    this.handle.writeOrRemove(context, Ui.targetedProp, optDrop)
  }

  fun emitIndeterminate(context: mutable SKFS.Context, value: Int): void {
    this.emit(context, SetIndeterminate(value))
  }

  private fun emit(
    context: mutable SKFS.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(
      context,
      statePath,
      this.handle.getDirName().toString(),
      command,
    );
  }
}

fun init(context: mutable SKFS.Context, path: Ui.Path): State {
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeDir(f ~> f, dirName, Array[]);
  HState(SKFS.toIHandle(stateHdl))
}

module end;
