module UiTab;

const statePath: String = "ui/tab/state";

class HStorage(name: String, handle: SKStore.INotTyped) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKStore.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKStore.IHandle::notTyped(SKStore.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setIndeterminate(context: mutable SKStore.Context, optValue: ?Int): void {
    this.handle.writeOrRemove(
      context,
      Ui.indeterminateProp,
      optValue.map(v -> SKStore.IntFile(v)),
    )
  }
}

class HState(handle: SKStore.INotTyped) extends State {
  //
  fun getArmed(context: mutable SKStore.Context): ?Bool {
    this.handle.maybeGetBool(context, Ui.armedProp)
  }

  fun getHover(context: mutable SKStore.Context): ?Bool {
    this.handle.maybeGetBool(context, Ui.hoverProp)
  }

  fun getIndeterminate(context: mutable SKStore.Context): ?Int {
    this.handle.maybeGetInt(context, Ui.indeterminateProp)
  }

  fun getTargeted(context: mutable SKStore.Context): ?Ui.Drop {
    this.handle.maybeGetProp(context, Ui.targetedProp, f ~> f as Ui.Drop _)
  }

  fun setArmed(
    context: mutable SKStore.Context,
    close: Bool,
    value: Bool,
  ): void {
    this.handle.writeOrRemove(
      context,
      Ui.armedProp,
      if (value) Some(SKStore.BoolFile(close)) else None(),
    )
  }

  fun setHover(
    context: mutable SKStore.Context,
    close: Bool,
    value: Bool,
  ): void {
    this.handle.writeOrRemove(
      context,
      Ui.hoverProp,
      if (value) Some(SKStore.BoolFile(close)) else None(),
    )
  }

  fun setTargeted(context: mutable SKStore.Context, optDrop: ?Ui.Drop): void {
    this.handle.writeOrRemove(context, Ui.targetedProp, optDrop)
  }

  fun emitIndeterminate(context: mutable SKStore.Context, value: Int): void {
    this.emit(context, SetIndeterminate(value))
  }

  private fun emit(
    context: mutable SKStore.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(
      context,
      statePath,
      this.handle.getDirName().toString(),
      command,
    );
  }
}

fun init(context: mutable SKStore.Context, path: Ui.Path): State {
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeNotTyped(dirName, Array[]);
  HState(SKStore.toIHandle(stateHdl))
}

module end;
