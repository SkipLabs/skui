module UiTable;

fun itemsDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/table/items/")
}

fun widgetsDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/table/widgets/")
}

fun widgetDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/table/widget/")
}

base class Selection(multiple: Array<String>, optMain: ?String) {
  children =
  | Included()
  | Excluded()

  fun remove(row: String): Selection
  | Included _ -> Included(this.multiple.filter(i -> i != row), this.optMain)
  | Excluded _ -> Excluded(Arrays.add(this.multiple, row), this.optMain)

  fun clear(): Selection {
    Included(Array[], this.optMain)
  }

  fun add(row: String, optMain: ?String): Selection
  | Included _ -> Included(Arrays.add(this.multiple, row), optMain)
  | Excluded _ -> Excluded(this.multiple.filter(i -> i != row), optMain)
}

base class Order {
  children =
  | Asc()
  | Desc()

  fun toCode(): Int
  | Asc() -> 0
  | Desc() -> 1

  static fun fromCode(code: Int): ?Order {
    code match {
    | 0 -> Some(Asc())
    | 1 -> Some(Desc())
    | _ -> None()
    }
  }
}

class Sort(optOrder: ?Order, toggle: Bool)

base class Width {
  children =
  | Fixed(size: Float)
  | Flex(flex: Int)
  | Percent(percent: Int)
}

class Column{
  id: String,
  text: Text,
  tooltip: ?Text = None(),
  icon: ?Ui.IconBuilder = None(),
}

class Cell{
  optText: ?Text,
  optTooltip: ?Text = None(),
  optIcon: ?Ui.IconBuilder = None(),
  optAction: ?UiTableCell.Action = None(),
  alignment: Text.FixedAlign = Text.Left(),
}

class Row(id: String, cells: Array<Cell>) extends SKStore.File

base class GridPolicy {
  children =
  | Horizontal()
  | Vertical()
  | Both()
  | Nil()

  fun isHorizontal(): Bool
  | Both()
  | Horizontal() ->
    true
  | Vertical()
  | Nil() ->
    false

  fun isVertical(): Bool
  | Both()
  | Vertical() ->
    true
  | Horizontal()
  | Nil() ->
    false

  fun toCode(): Int
  | Horizontal() -> 0
  | Vertical() -> 1
  | Both() -> 2
  | Nil() -> 3

  static fun fromCode(code: Int): GridPolicy {
    code match {
    | 0 -> Horizontal()
    | 1 -> Vertical()
    | 2 -> Both()
    | 3
    | _ ->
      Nil()
    }
  }
}

base class STarget {
  children =
  | SAll()
  | SNext()
  | SPrevious()
  | SFirst()
  | SLast()
  | SClear()
  | SCurrent(Bool)
  | SToPrevious(Bool)
  | SToNext(Bool)
  | SToFirst(Bool)
  | SToLast(Bool)
  | SRow(String, Bool)
  | SToRow(String, Bool)
  | SToCurrent(Bool)
}

base class Controller {
  //
  fun getColumns(context: mutable SKStore.Context): Array<Column>;

  fun getRows(context: mutable SKStore.Context): Array<Row>;

  fun isShowCheckboxes(context: mutable SKStore.Context): Bool;
  fun isShowOddEven(context: mutable SKStore.Context): Bool;
  fun getSelectionModel(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): SelectionModel;

  fun getProgress(context: mutable SKStore.Context): ?Ui.Progress;
  fun getRowProgress(
    context: mutable SKStore.Context,
    row: String,
  ): ?Ui.Progress;
  fun getPlaceHolder(context: mutable SKStore.Context): Text;
  fun getGridPolicy(context: mutable SKStore.Context): GridPolicy;

  fun getColumnOrder(context: mutable SKStore.Context, column: String): ?Order;
  fun getColumnWidth(context: mutable SKStore.Context, column: String): Width;

  fun getRowHeight(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Float;

  fun getHeaderHeight(
    context: mutable SKStore.Context,
    isUntracked: Bool = false,
  ): Float;

  fun getContextMenuItems(
    context: mutable SKStore.Context,
    optCurrent: ?String,
    selections: Array<String>,
  ): Array<UiDropdown.Item>;

  fun getSelectionChangeMessages(
    context: mutable SKStore.Context,
    selections: Array<String>,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;

  fun getFireMessages(
    context: mutable SKStore.Context,
    optCurrent: ?String,
    selections: Array<String>,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;

  fun getSortMessages(
    context: mutable SKStore.Context,
    column: String,
    sort: Sort,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;
}

base class State {
  fun isSelected(context: mutable SKStore.Context, row: String): Bool;
  fun isHover(context: mutable SKStore.Context, row: String): Bool;
}

base class Storage {
  fun getName(): String;
  fun getScope(): String;
  fun setHScroll(context: mutable SKStore.Context, optScroll: ?Ui.Scroll): void;
  fun setVScroll(context: mutable SKStore.Context, optScroll: ?Ui.Scroll): void;
  fun setScrolling(
    context: mutable SKStore.Context,
    optTick: ?SKStore.Tick,
  ): void;
  fun setTodo(context: mutable SKStore.Context, cmd: Executable): void;
  //
  fun getScrolling(context: mutable SKStore.Context): ?SKStore.Tick;
}

class Parameters(controller: Controller, state: State) extends Ui.Parameters

class RangeKey() extends SKStore.Key {
  fun toString(): String {
    this.getClassName()
  }
}

class WidthsKey() extends SKStore.Key {
  fun toString(): String {
    this.getClassName()
  }
}

class Even(value: String) extends SKStore.Key {
  fun toString(): String {
    `${this.getClassName()}:${this.value}`
  }
}

class Widths(value: Array<Float>) extends SKStore.File

module end;
