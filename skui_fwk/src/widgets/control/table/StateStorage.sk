module UiTable;

const statePath: String = "ui/table/state";
const computedPath: String = "ui/table/computed";

class Info(
  controller: Controller,
  items: Ui.Getter<Array<String>>,
) extends SKStore.UserData

class HStorage(name: String, handle: SKStore.INotTyped) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKStore.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKStore.IHandle::notTyped(SKStore.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.dirName.toString()
  }

  protected fun getHandle(): SKStore.INotTyped {
    this.handle
  }

  fun setHScroll(
    context: mutable SKStore.Context,
    optScroll: ?Ui.Scroll,
  ): void {
    this.handle.writeOrRemove(context, Ui.hScrollProp, optScroll)
  }

  fun setVScroll(
    context: mutable SKStore.Context,
    optScroll: ?Ui.Scroll,
  ): void {
    this.handle.writeOrRemove(context, Ui.vScrollProp, optScroll)
  }

  fun setScrolling(
    context: mutable SKStore.Context,
    optTick: ?SKStore.Tick,
  ): void {
    this.handle.writeOrRemove(
      context,
      Ui.scrollingProp,
      optTick.map(t -> SKStore.IntFile(t.value)),
    )
  }

  fun setTodo(context: mutable SKStore.Context, value: Executable): void {
    this.handle.write(context, Ui.todoProp, Ui.Todo(value, context.tick))
  }

  // GETTERS

  fun getScrolling(context: mutable SKStore.Context): ?SKStore.Tick {
    this.handle.maybeGetInt(context, Ui.scrollingProp).map(v -> SKStore.Tick(v))
  }

  fun getTodo(context: mutable SKStore.Context): Ui.Todo {
    Ui.Todo::type(this.handle.get(context, Ui.todoProp))
  }
}

class LamState(
  selected: Ui.GetterOne<Bool, String>,
  hover: Ui.GetterOne<Bool, String>,
) extends State {
  //
  fun isSelected(context: mutable SKStore.Context, row: String): Bool {
    this.selected(context, row)
  }

  fun isHover(context: mutable SKStore.Context, row: String): Bool {
    this.hover(context, row)
  }
}

@debug
fun init(
  _context: mutable SKStore.Context,
  path: Ui.Path,
  _controller: Controller,
): Parameters {
  _dirName = Ui.controllerDirName(path);
  todo("UiTable.init")
}

@debug
fun update(
  context: mutable SKStore.Context,
  _scope: String,
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  todo: Ui.Todo,
  optInfo: ?Info,
): void {
  execute(context, todo.command as Executable _, values, optInfo.fromSome());
}

@debug
fun execute(
  context: mutable SKStore.Context,
  executable: Executable,
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  info: Info,
): void {
  executable match {
  | All(cmds) -> cmds.each(cmd -> execute(context, cmd, values, info))
  | Init() -> void
  | ManageScrolling(incr, _) ->
    values.set(Ui.ensureVisibleProp, Some(Ui.Incr(incr, context.tick)))
  | ManageVisible(value) ->
    values.set(Ui.ensureVisibleProp, Some(Ui.Pos(value, context.tick)))
  | Fire(optRow) ->
    optCurrent = if (optRow.isSome()) {
      optRow
    } else {
      values.get(Ui.currentProp).map(SKStore.StringFile::type).map(f -> f.value)
    };
    selection = values
      .get(Ui.selectionProp)
      .map(SKStore.Strings::type)
      .map(is -> is.value)
      .default(Array[]);
    info.controller
      .getFireMessages(context, optCurrent, selection, true)
      .each(msg -> SKUIMessage.emitMessage(context, msg))
  | ManageSelect _ -> todo("UiTable.execute ManageSelect")
  }
}

module end;
