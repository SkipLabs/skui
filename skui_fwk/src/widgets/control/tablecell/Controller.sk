module UiTableCell;

class LamController{
  text: Ui.Getter<?Text>,
  font: Ui.Getter<Font.FaceID>,
  fill: Ui.Getter<.Color>,
  icon: Ui.GetterOne<?Ui.Icon, Float> = Ui.defaultOne(None()),
  tooltip: Ui.Getter<?Text> = Ui.default(None()),
  alignment: Ui.Getter<Text.FixedAlign> = Ui.default(Text.Left()),
  action: Ui.GetterOne<?Action, Bool> = Ui.defaultOne(None()),
} extends Controller {
  //
  fun getText(context: mutable SKFS.Context): ?Text {
    this.text(context)
  }

  fun getIcon(context: mutable SKFS.Context, fontSize: Float): ?Ui.Icon {
    this.icon(context, fontSize)
  }

  fun getTooltip(context: mutable SKFS.Context): ?Text {
    this.tooltip(context)
  }

  fun getAlignment(context: mutable SKFS.Context): Text.FixedAlign {
    this.alignment(context)
  }

  fun getFont(context: mutable SKFS.Context): Font.FaceID {
    this.font(context)
  }

  fun getFill(context: mutable SKFS.Context): .Color {
    this.fill(context)
  }

  fun getAction(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): ?Action {
    this.action(context, isUntracked)
  }
}

module end;
