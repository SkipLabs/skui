module UiTabPane;

fun itemsDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/tabpane/items/")
}

fun widgetsDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/tabpane/widgets/")
}

fun widgetDirName(path: Ui.Path): SKStore.DirName {
  path.toDirName("/ui/tabpane/widget/")
}

class Tab{
  optText: ?Text = None(),
  optDiscriminant: ?Text = None(),
  optTooltip: ?Text = None(),
  optIcon: ?Ui.IconBuilder = None(),
} extends SKStore.File {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Tab _ -> x
    | _ -> invariant_violation("Must be UiTabPane.Tab")
    }
  }
}

base class Controller extends Ui.Parameters {
  fun getActive(context: mutable SKStore.Context): ?Ui.StringProperty;
  fun getKind(context: mutable SKStore.Context): UiTabs.Kind;
  fun getMode(context: mutable SKStore.Context): UiTab.Mode;
  fun getSide(context: mutable SKStore.Context): .UiSide;
  fun getPlaceHolder(context: mutable SKStore.Context): Text;

  fun getTabs(context: mutable SKStore.Context): Array<String>;
  fun getActions(context: mutable SKStore.Context): Array<String>;

  fun getAction(
    context: mutable SKStore.Context,
    action: String,
  ): UiTabs.Action;

  fun isIconOnTop(context: mutable SKStore.Context): Bool;

  fun getMinWidth(context: mutable SKStore.Context): ?Int;
  fun getMaxWidth(context: mutable SKStore.Context): ?Int;

  fun getTab(context: mutable SKStore.Context, tab: String): Tab;
  fun getWidget(context: mutable SKStore.Context, tab: String): ?Ui.Widget;

  fun getProgress(context: mutable SKStore.Context, tab: String): ?Ui.Progress;
  fun getBadge(context: mutable SKStore.Context, tab: String): ?Ui.Badge;

  fun isDisabled(context: mutable SKStore.Context, tab: String): Bool;
  fun isClosable(context: mutable SKStore.Context, tab: String): Bool;

  fun onChange(
    context: mutable SKStore.Context,
    tab: String,
    selected: Bool,
  ): void;

  fun onClose(context: mutable SKStore.Context, tabs: Array<String>): void;
}

class MainCollection(
  widgetsHdl: SKStore.EHandle<SKStore.StrID, Ui.WidgetFile>,
  keys: Array<SKStore.StrID>,
) extends Ui.WidgetsCollection {
  //
  fun getSize(_context: mutable SKStore.Context): Int {
    this.keys.size()
  }

  fun getWidget(context: mutable SKStore.Context, index: Int): Ui.Widget {
    this.widgetsHdl.get(context, this.keys[index]).widget
  }
}

module end;
