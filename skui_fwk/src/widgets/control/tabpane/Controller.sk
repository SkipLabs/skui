module UiTabPane;

class LamController{
  tabs: mutable SKStore.Context ~> Array<String>,
  tab: (mutable SKStore.Context, String) ~> Tab,
  widget: (mutable SKStore.Context, String) ~> ?Ui.Widget,
  active: Ui.Getter<?Ui.StringProperty> = Ui.default(None()),
  disabled: (mutable SKStore.Context, String) ~> Bool = (_ctx, _tab) ~> false,
  closable: (mutable SKStore.Context, String) ~> Bool = (_ctx, _tab) ~> false,
  progress: (mutable SKStore.Context, String) ~> ?Ui.Progress = (_ctx, _tab) ~>
    None(),
  badge: (mutable SKStore.Context, String) ~> ?Ui.Badge = (_ctx, _tab) ~>
    None(),
  kind: mutable SKStore.Context ~> UiTabs.Kind = _ctx ~> UiTabs.Scrollable(),
  mode: mutable SKStore.Context ~> UiTab.Mode = _ctx ~> UiTab.Basic(),
  side: mutable SKStore.Context ~> .UiSide = _ctx ~> UiSide.Top(),
  placeHolder: mutable SKStore.Context ~> Text = _ctx ~> !"No active tab.",
  iconOnTop: mutable SKStore.Context ~> Bool = _ctx ~> false,
  actions: mutable SKStore.Context ~> Array<String> = _ctx ~> Array[],
  action: (mutable SKStore.Context, String) ~> UiTabs.Action = (
    _ctx,
    _action,
  ) ~>
    invariant_violation("No actions"),
  minWidth: mutable SKStore.Context ~> ?Int = _ctx ~> None(),
  maxWidth: mutable SKStore.Context ~> ?Int = _ctx ~> None(),
  onChange_: (mutable SKStore.Context, String, Bool) ~> void = (
    _ctx,
    _value,
    _selected,
  ) ~>
    void,
  onClose_: (mutable SKStore.Context, Array<String>) ~> void = (
    _ctx,
    _value,
  ) ~>
    void,
} extends Controller {
  //
  fun getActive(context: mutable SKStore.Context): ?Ui.StringProperty {
    this.active(context)
  }

  fun getKind(context: mutable SKStore.Context): UiTabs.Kind {
    this.kind(context)
  }

  fun getMode(context: mutable SKStore.Context): UiTab.Mode {
    this.mode(context)
  }

  fun getSide(context: mutable SKStore.Context): .UiSide {
    this.side(context)
  }

  fun getActions(context: mutable SKStore.Context): Array<String> {
    this.actions(context)
  }

  fun getAction(
    context: mutable SKStore.Context,
    action: String,
  ): UiTabs.Action {
    this.action(context, action)
  }

  fun getMinWidth(context: mutable SKStore.Context): ?Int {
    this.minWidth(context)
  }

  fun getMaxWidth(context: mutable SKStore.Context): ?Int {
    this.maxWidth(context)
  }

  fun isIconOnTop(context: mutable SKStore.Context): Bool {
    this.iconOnTop(context)
  }

  fun getPlaceHolder(context: mutable SKStore.Context): Text {
    this.placeHolder(context)
  }

  fun getTabs(context: mutable SKStore.Context): Array<String> {
    this.tabs(context)
  }

  fun getTab(context: mutable SKStore.Context, tab: String): Tab {
    this.tab(context, tab)
  }

  fun getWidget(context: mutable SKStore.Context, tab: String): ?Ui.Widget {
    this.widget(context, tab)
  }

  fun getProgress(context: mutable SKStore.Context, tab: String): ?Ui.Progress {
    this.progress(context, tab)
  }

  fun getBadge(context: mutable SKStore.Context, tab: String): ?Ui.Badge {
    this.badge(context, tab)
  }

  fun isDisabled(context: mutable SKStore.Context, tab: String): Bool {
    this.disabled(context, tab)
  }

  fun isClosable(context: mutable SKStore.Context, tab: String): Bool {
    this.closable(context, tab)
  }

  fun onChange(
    context: mutable SKStore.Context,
    tab: String,
    selected: Bool,
  ): void {
    this.onChange_(context, tab, selected)
  }

  fun onClose(context: mutable SKStore.Context, tabs: Array<String>): void {
    this.onClose_(context, tabs)
  }
}

module end;
