module UiTabPane;

class LamController{
  tabs: mutable SKFS.Context ~> Array<String>,
  tab: (mutable SKFS.Context, String) ~> Tab,
  widget: (mutable SKFS.Context, String) ~> ?Ui.Widget,
  active: Ui.Getter<?Ui.StringProperty> = Ui.default(None()),
  disabled: (mutable SKFS.Context, String) ~> Bool = (_ctx, _tab) ~> false,
  closable: (mutable SKFS.Context, String) ~> Bool = (_ctx, _tab) ~> false,
  progress: (mutable SKFS.Context, String) ~> ?Ui.Progress = (_ctx, _tab) ~>
    None(),
  badge: (mutable SKFS.Context, String) ~> ?Ui.Badge = (_ctx, _tab) ~> None(),
  kind: mutable SKFS.Context ~> UiTabs.Kind = _ctx ~> UiTabs.Scrollable(),
  mode: mutable SKFS.Context ~> UiTab.Mode = _ctx ~> UiTab.Basic(),
  side: mutable SKFS.Context ~> .UiSide = _ctx ~> UiSide.Top(),
  placeHolder: mutable SKFS.Context ~> Text = _ctx ~> !"No active tab.",
  iconOnTop: mutable SKFS.Context ~> Bool = _ctx ~> false,
  actions: mutable SKFS.Context ~> Array<String> = _ctx ~> Array[],
  action: (mutable SKFS.Context, String) ~> UiTabs.Action = (_ctx, _action) ~>
    invariant_violation("No actions"),
  minWidth: mutable SKFS.Context ~> ?Int = _ctx ~> None(),
  maxWidth: mutable SKFS.Context ~> ?Int = _ctx ~> None(),
  changeMessages: (mutable SKFS.Context, String, Bool, Bool) ~> Array<
    FWKMessage.Message,
  > = (_ctx, _value, _selected, _iu) ~> Array[],
  closeMessages: (mutable SKFS.Context, Array<String>, Bool) ~> Array<
    FWKMessage.Message,
  > = (_ctx, _value, _iu) ~> Array[],
} extends Controller {
  //
  fun getActive(context: mutable SKFS.Context): ?Ui.StringProperty {
    this.active(context)
  }

  fun getKind(context: mutable SKFS.Context): UiTabs.Kind {
    this.kind(context)
  }

  fun getMode(context: mutable SKFS.Context): UiTab.Mode {
    this.mode(context)
  }

  fun getSide(context: mutable SKFS.Context): .UiSide {
    this.side(context)
  }

  fun getActions(context: mutable SKFS.Context): Array<String> {
    this.actions(context)
  }

  fun getAction(context: mutable SKFS.Context, action: String): UiTabs.Action {
    this.action(context, action)
  }

  fun getMinWidth(context: mutable SKFS.Context): ?Int {
    this.minWidth(context)
  }

  fun getMaxWidth(context: mutable SKFS.Context): ?Int {
    this.maxWidth(context)
  }

  fun isIconOnTop(context: mutable SKFS.Context): Bool {
    this.iconOnTop(context)
  }

  fun getPlaceHolder(context: mutable SKFS.Context): Text {
    this.placeHolder(context)
  }

  fun getTabs(context: mutable SKFS.Context): Array<String> {
    this.tabs(context)
  }

  fun getTab(context: mutable SKFS.Context, tab: String): Tab {
    this.tab(context, tab)
  }

  fun getWidget(context: mutable SKFS.Context, tab: String): ?Ui.Widget {
    this.widget(context, tab)
  }

  fun getProgress(context: mutable SKFS.Context, tab: String): ?Ui.Progress {
    this.progress(context, tab)
  }

  fun getBadge(context: mutable SKFS.Context, tab: String): ?Ui.Badge {
    this.badge(context, tab)
  }

  fun isDisabled(context: mutable SKFS.Context, tab: String): Bool {
    this.disabled(context, tab)
  }

  fun isClosable(context: mutable SKFS.Context, tab: String): Bool {
    this.closable(context, tab)
  }

  fun getChangeMessages(
    context: mutable SKFS.Context,
    tab: String,
    selected: Bool,
    isUntracked: Bool = false,
  ): Array<FWKMessage.Message> {
    this.changeMessages(context, tab, selected, isUntracked)
  }

  fun getCloseMessages(
    context: mutable SKFS.Context,
    tabs: Array<String>,
    isUntracked: Bool = false,
  ): Array<FWKMessage.Message> {
    this.closeMessages(context, tabs, isUntracked)
  }
}

module end;
