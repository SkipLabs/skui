module UiTabs;

class LamController{
  tabs: Ui.Getter<Array<String>>,
  tab: Ui.GetterOne<Tab, String>,
  active: Ui.Getter<?Ui.StringProperty> = Ui.default(None()),
  numberOfActions: Ui.Getter<Int> = Ui.default(0),
  actions: Ui.GetterOne<Action, Int> = (_ctx, _idx) ~>
    invariant_violation("No actions"),
  kind: Ui.Getter<Kind> = Ui.default(Scrollable()),
  mode: Ui.Getter<UiTab.Mode> = Ui.default(UiTab.Basic()),
  side: Ui.Getter<.UiSide> = Ui.default(UiSide.Top()),
  minWidth: Ui.Getter<?Int> = Ui.default(None()),
  maxWidth: Ui.Getter<?Int> = Ui.default(None()),
  onChange_: (mutable SKStore.Context, String, Bool) ~> void = (
    _ctx,
    _value,
    _selected,
  ) ~>
    void,
  onClose_: (mutable SKStore.Context, Array<String>) ~> void = (_ctx, _tabs) ~>
    void,
} extends Controller {
  //
  fun getActive(context: mutable SKStore.Context): ?Ui.StringProperty {
    this.active(context)
  }

  fun getKind(context: mutable SKStore.Context): Kind {
    this.kind(context)
  }

  fun getMode(context: mutable SKStore.Context): UiTab.Mode {
    this.mode(context)
  }

  fun getSide(context: mutable SKStore.Context): .UiSide {
    this.side(context)
  }

  fun getTabs(context: mutable SKStore.Context): Array<String> {
    this.tabs(context)
  }

  fun getTab(context: mutable SKStore.Context, id: String): Tab {
    this.tab(context, id)
  }

  fun getNumberOfActions(context: mutable SKStore.Context): Int {
    this.numberOfActions(context)
  }

  fun getAction(context: mutable SKStore.Context, index: Int): Action {
    this.actions(context, index)
  }

  fun getMinWidth(context: mutable SKStore.Context): ?Int {
    this.minWidth(context)
  }

  fun getMaxWidth(context: mutable SKStore.Context): ?Int {
    this.maxWidth(context)
  }

  fun onChange(
    context: mutable SKStore.Context,
    tab: String,
    selected: Bool,
  ): void {
    this.onChange_(context, tab, selected)
  }

  fun onClose(context: mutable SKStore.Context, tabs: Array<String>): void {
    this.onClose_(context, tabs)
  }
}

module end;
