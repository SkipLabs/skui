module UiTabs;

const statePath: String = "ui/tabs/state";
const numberOfPinnedProp: SKFS.StrID = SKFS.StrID("numberOfPinned");
const numberOfTabsProp: SKFS.StrID = SKFS.StrID("numberOfTabs");

class TabsKey() extends SKFS.BaseName {
  fun toString(): String {
    this.getClassName()
  }
}

class HistoryKey() extends SKFS.BaseName {
  fun toString(): String {
    this.getClassName()
  }
}

class ModifiedKey() extends SKFS.BaseName {
  fun toString(): String {
    this.getClassName()
  }
}

class PinnedKey() extends SKFS.BaseName {
  fun toString(): String {
    this.getClassName()
  }
}

fun pinnedProp(tab: String): SKFS.StrID {
  SKFS.StrID(`pinned[${tab}]`)
}

fun pinnedIndexProp(idx: Int): SKFS.StrID {
  SKFS.StrID(`pinned[${idx}]`)
}

fun tabIndexProp(idx: Int): SKFS.StrID {
  SKFS.StrID(`tab[${idx}]`)
}

fun activeProp(tab: String): SKFS.StrID {
  SKFS.StrID(`active[${tab}]`)
}

fun selectedProp(tab: String): SKFS.StrID {
  SKFS.StrID(`selected[${tab}]`)
}

class KIdx(value: String) extends SKFS.BaseName {
  fun sameCompare(y: SKFS.BaseName): Order {
    y match {
    | KIdx(v2) -> this.value.compare(v2)
    | _ -> invariant_violation("Must be a UiTabs.KIdx")
    }
  }

  fun toString(): String {
    this.value
  }
}

class Indexed(idx: Int, value: String) extends SKFS.File uses Orderable {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Indexed _ -> x
    | _ -> invariant_violation("Must be UiTabs.Indexed")
    }
  }
}

class HStorage(name: String, handle: SKFS.IHandle<SKFS.File>) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKFS.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKFS.IHandle(SKFS.FileConverter(f ~> f), SKFS.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun isPinned(context: mutable SKFS.Context, tab: String): Bool {
    this.handle.getBool(context, pinnedProp(tab))
  }

  fun setSelected(context: mutable SKFS.Context, optTab: ?String): void {
    this.handle.writeOrRemove(
      context,
      Ui.selectedProp,
      optTab.map(v -> SKFS.StringFile(v)),
    )
  }

  fun setTodo(context: mutable SKFS.Context, value: Executable): void {
    this.handle.write(context, Ui.todoProp, Ui.Todo(value, context.tick))
  }
}

class HState(
  handle: SKFS.Handle<SKFS.File>,
  computed: SKFS.Handle<SKFS.File>,
  verified: SKFS.Handle<SKFS.File>,
  closableInfos: SKFS.Handle<ClosableInfo>,
) extends State {
  //
  fun getNumberOfPinned(context: mutable SKFS.Context): Int {
    this.computed.getInt(context, numberOfPinnedProp)
  }

  fun getActive(context: mutable SKFS.Context): ?String {
    this.verified.maybeGetString(context, Ui.activeProp)
  }

  fun getPinned(context: mutable SKFS.Context, index: Int): Identified {
    this.computed.maybeGetProp(
      context,
      pinnedIndexProp(index),
      Identified::fromFile,
    ).fromSome()
  }

  fun getNumberOfTabs(context: mutable SKFS.Context): Int {
    this.computed.getInt(context, numberOfTabsProp)
  }

  fun getTab(context: mutable SKFS.Context, index: Int): Identified {
    this.computed.maybeGetProp(
      context,
      tabIndexProp(index),
      Identified::fromFile,
    ).fromSome()
  }

  fun emitPinned(
    context: mutable SKFS.Context,
    tab: String,
    value: Bool,
  ): void {
    this.emit(context, ManagePinned(tab, value))
  }

  fun emitSelected(context: mutable SKFS.Context, optTab: ?String): void {
    this.emit(context, SetSelected(optTab))
  }

  fun getClosableInfo(
    context: mutable SKFS.Context,
    optTab: ?String,
  ): ClosableInfo {
    this.closableInfos.get(
      context,
      optTab.map(tab -> SKFS.StrID(tab)).default(SKFS.IID(0)),
    )
  }

  fun pinMessage(tab: String, value: Bool): FWKMessage.Message {
    this.message(ManagePinned(tab, value))
  }

  fun moveMessage(
    toMove: String,
    dstTab: String,
    before: Bool,
  ): FWKMessage.Message {
    this.message(ManageMove(toMove, dstTab, before))
  }

  private fun emit(
    context: mutable SKFS.Context,
    command: FWKMessage.Command,
  ): void {
    FWKMessage.emit(
      context,
      statePath,
      this.handle.getDirName().toString(),
      command,
    );
  }

  private fun message(command: FWKMessage.Command): FWKMessage.Message {
    FWKMessage.Message(statePath, this.handle.getDirName().toString(), command);
  }
}

fun init(
  context: mutable SKFS.Context,
  path: Ui.Path,
  controller: Controller,
): Parameters {
  source = context.timeStamp().value;
  dirName = Ui.controllerDirName(path);
  initHdl = context.makeDir(
    SKFS.IntFile::fromFile,
    SKFS.DirName::make(dirName, "init/"),
    Array[(SKFS.IID(0), SKFS.IntFile(0))],
  );
  stateHdl = context.makeDir(
    f ~> f,
    dirName,
    Array<(SKFS.BaseName, SKFS.File)>[
      (Ui.todoProp, Ui.Todo(Init(), context.tick)),
    ],
  );
  managedDirName = SKFS.DirName::make(dirName, "managed/");
  preManagedHdl = context.makePreDir(
    f ~> f,
    managedDirName,
    Array<(SKFS.BaseName, SKFS.File)>[
      (TabsKey(), SKFS.Strings(Array[])),
      (HistoryKey(), SKFS.Strings(Array[])),
      (ModifiedKey(), SKFS.IntFile(0)),
      (PinnedKey(), SKFS.StringSet(Set[])),
    ],
  );
  initKeys = Array[Ui.activeProp, TabsKey(), HistoryKey(), PinnedKey()];
  verifiedHdl = initHdl.contextWriterKeyMap(
    f ~> f,
    context,
    SKFS.DirName::make(dirName, "verified/"),
    (context, writer, _key, _file) ~> {
      writer.write(SKFS.KKeys(), SKFS.Keys(initKeys));
      previousTabs = SKFS.Strings::fromFile(
        preManagedHdl.getValue(context, TabsKey()),
      ).value;
      previousOptActive = preManagedHdl
        .maybeGetValue(context, Ui.activeProp, true)
        .map(f ~> SKFS.StringFile::fromFile(f).value);
      pinned = preManagedHdl.getValue(context, PinnedKey());
      tabs = controller.getTabs(context);
      aSet = Set::createFromItems(previousTabs);
      tSet = Set::createFromItems(tabs);
      optPrevious: ?String = None();
      added = mutable Map<?String, mutable Vector<String>>[];
      optFirstAdded: ?String = None();
      tabs.each(tab ->
        if (!aSet.contains(tab)) {
          vec = added.maybeGet(optPrevious) match {
          | Some(vec) -> vec
          | _ ->
            vec = mutable Vector<String>[];
            added.add(optPrevious, vec);
            vec
          };
          vec.push(tab);
          if (optFirstAdded.isNone()) {
            !optFirstAdded = Some(tab)
          }
        } else {
          !optPrevious = Some(tab);
        }
      );
      history = SKFS.Strings::fromFile(
        preManagedHdl.getValue(context, HistoryKey(), true),
      ).value;
      if (previousTabs.size() != tabs.size() || optFirstAdded.isSome()) {
        newTabs = mutable Vector<String>[];
        added.maybeGet(None()).each(v -> v.each(newTabs.push));
        previousTabs.each(tab -> {
          if (tSet.contains(tab)) {
            newTabs.push(tab);
            added.maybeGet(Some(tab)).each(v -> v.each(newTabs.push));
          }
        });
        writer.write(TabsKey(), SKFS.Strings(newTabs.toArray()));
        optActive = optFirstAdded match {
        | Some(firstAdded) -> Some(firstAdded)
        | _ ->
          previousOptActive match {
          | Some(previousActive) if (tabs.indexOf(previousActive).isSome()) ->
            previousOptActive
          | _ -> None()
          }
        };
        !history = history.filter(f -> tSet.contains(f));
        if (optActive.isNone()) {
          if (!history.isEmpty()) {
            !optActive = Some(history.last())
          } else if (!tabs.isEmpty()) {
            !optActive = Some(tabs.last())
          }
        };
        optActive.each(active -> {
          if (optActive != previousOptActive) {
            !history = Arrays.add(history.filter(f -> f != active), active)
          };
          writer.write(Ui.activeProp, SKFS.StringFile(active));
        });
      } else {
        writer.write(TabsKey(), SKFS.Strings(previousTabs));
        previousOptActive.each(active ->
          writer.write(Ui.activeProp, SKFS.StringFile(active))
        );
      };
      writer.write(HistoryKey(), SKFS.Strings(history));
      writer.write(ModifiedKey(), SKFS.IntFile(context.tick.value));
      writer.write(PinnedKey(), pinned);
    },
  );
  toReallyDoHdl = stateHdl.contextWriterKeyMap(
    Ui.Todo::fromFile,
    context,
    SKFS.DirName::make(dirName, "todo/"),
    (context, writer, key, file) ~> {
      if (key == Ui.todoProp) {
        todo = Ui.Todo::fromFile(file);
        controller
          .getActive(context)
          .map(av -> av.getTimed(context))
          .each(info ->
            if (info.i1 > todo.tick && info.i2 != source) {
              !todo = Ui.Todo(ManageActive(info.i0.toString()), info.i1)
            }
          );
        modification = SKFS.IntFile::fromFile(
          verifiedHdl.get(context, ModifiedKey()),
        );
        if (modification.value > todo.tick.value) {
          writer.write(key, Ui.Todo(Init(), context.tick))
        } else {
          writer.write(key, file)
        }
      }
    },
  );
  managedHdl = SKFS.derive(
    context,
    dirName.toString(),
    managedDirName,
    toReallyDoHdl,
    Ui.todoProp,
    initKeys,
    update,
    None(),
    Some(verifiedHdl),
  );
  pinnedHdl = managedHdl.contextWriterKeyMap(
    f ~> f,
    context,
    SKFS.DirName::make(dirName, "pinned/"),
    (context, writer, key, file) ~> {
      if (key == PinnedKey()) {
        tabs = SKFS.Strings::fromFile(
          managedHdl.getValue(context, TabsKey(), true),
        ).value;
        pinned = SKFS.StringSet::fromFile(file).value;
        tabs.each(tab ->
          writer.write(pinnedProp(tab), SKFS.BoolFile(pinned.contains(tab)))
        )
      }
    },
  );
  activeHdl = managedHdl.contextWriterKeyMap(
    f ~> f,
    context,
    SKFS.DirName::make(dirName, "active/"),
    (_, writer, key, file) ~> {
      if (key == Ui.activeProp) {
        writer.write(
          activeProp(SKFS.StringFile::fromFile(file).value),
          SKFS.BoolFile(true),
        );
      }
    },
  );
  separatedHdl = stateHdl.contextWriterKeyMap(
    f ~> f,
    context,
    SKFS.DirName::make(dirName, "separated/"),
    (_, writer, key, file) ~> {
      if (key == Ui.selectedProp) {
        writer.write(
          selectedProp(SKFS.StringFile::fromFile(file).value),
          SKFS.BoolFile(true),
        );
      } else if (key == Ui.activeProp) {
        writer.write(
          activeProp(SKFS.StringFile::fromFile(file).value),
          SKFS.BoolFile(true),
        );
      }
    },
  );
  tabsHdl = initHdl.contextWriterKeyMap(
    SKFS.StringFile::fromFile,
    context,
    SKFS.DirName::make(dirName, "tabs/"),
    (context, writer, _key, _file) ~> {
      tabs = verifiedHdl.getProp(
        context,
        TabsKey(),
        SKFS.Strings::fromFile,
        SKFS.Strings(Array[]),
      ).value;
      for (idx in Range(0, tabs.size())) {
        writer.write(SKFS.IID(idx), SKFS.StringFile(tabs[idx]))
      }
    },
  );
  isActive = (ctx, tab) ~> activeHdl.getBool(ctx, activeProp(tab));
  isSelected = (ctx, tab) ~> separatedHdl.getBool(ctx, selectedProp(tab));
  isPinned = (ctx, tab) ~> pinnedHdl.getBool(ctx, pinnedProp(tab));
  extractedPath = SKFS.DirName::make(dirName, "extracted/");
  extractedHdl = tabsHdl.contextWriterKeyMap(
    f ~> f,
    context,
    extractedPath,
    (context, writer, key, file) ~> {
      tab = controller.getTab(context, file.value);
      writer.write(SKFS.StrID(file.value), tab);
      writer.write(KIdx(file.value), SKFS.IntFile((key as SKFS.IID _).value));
    },
  );
  closableInfosHdl = managedHdl.contextWriterKeyMap(
    ClosableInfo::fromFile,
    context,
    SKFS.DirName::make(dirName, "closableInfo/"),
    (context, writer, key, file) ~> {
      if (key == TabsKey()) {
        tabs = SKFS.Strings::fromFile(file).value;
        withInfo = tabs.map(tab -> {
          tabObj = Tab::fromFile(extractedHdl.get(context, SKFS.StrID(tab)));
          (tab, tabObj.closable(context));
        });
        collect = table ~> table.filter(i ~> i.i1).map(i ~> i.i0);
        closables = collect(withInfo);
        writer.write(SKFS.IID(0), ClosableInfo(closables, Array[], Array[]));
        // Could be to heavy
        vector = Vector::mcreateFromItems(withInfo);
        left = mutable Vector<String>[];
        while (!vector.isEmpty()) {
          last = vector.get(0);
          vector.delete(0);
          writer.write(
            SKFS.StrID(last.i0),
            ClosableInfo(closables, left.toArray(), collect(vector.toArray())),
          );
          if (last.i1) {
            left.push(last.i0)
          }
        };
      }
    },
  );
  withDiscriminantHdl = extractedHdl
    .contextWriterKeyMap(
      SKFS.StringFile::fromFile,
      context,
      SKFS.DirName::make(dirName, "texts/"),
      (context, writer, key, file) ~> {
        key match {
        | SKFS.StrID(id) ->
          tab = Tab::fromFile(file);
          optDiscriminant = tab.discriminant(context);
          if (optDiscriminant.isSome()) {
            tab.text(context).each(txt -> {
              str = SKFS.StrID(context.translate(txt));
              writer.write(str, SKFS.StringFile(id))
            })
          }
        | _ -> void
        }
      },
    )
    .contextWriterKeyValues(
      SKFS.BoolFile::fromFile,
      context,
      SKFS.DirName::make(dirName, "withDiscriminant/"),
      (_, writer, _key, files) ~> {
        withDiscriminant = SKFS.BoolFile(files.size() > 1);
        files.each(sf -> writer.write(SKFS.StrID(sf.value), withDiscriminant))
      },
    );
  controllersHdl = extractedHdl.contextWriterKeyMap(
    Identified::fromFile,
    context,
    SKFS.DirName::make(dirName, "controllers/"),
    (_, writer, key, file) ~> {
      key match {
      | SKFS.StrID(id) ->
        tab = Tab::fromFile(file);
        writer.write(
          key,
          Identified(
            id,
            UiTab.LamController{
              disabled => tab.disabled,
              closable => tab.closable,
              text => tab.text,
              tooltip => tab.tooltip,
              discriminant => ctx ~> {
                if (
                  withDiscriminantHdl
                    .maybeGet(ctx, key)
                    .map(f ~> f.value)
                    .default(false)
                ) {
                  tab.discriminant(ctx)
                } else {
                  None()
                }
              },
              badge => tab.badge,
              progress => tab.progress,
              closeMessages => (ctx, iu) ~>
                controller.getCloseMessages(ctx, Array[id], iu),
              dropMessages => (_ctx, toMove, dstTab, before, _iu) ~>
                Array[
                  FWKMessage.Message(
                    statePath,
                    stateHdl.getDirName().toString(),
                    ManageMove(toMove, dstTab, before),
                  ),
                ],
              icon => (ctx, fs) ~>
                tab
                  .icon(ctx)
                  .flatMap(ib -> ib.buildIcon(ctx, fs))
                  .map(i -> UiTab.Icon(i, tab.iconOnTop(ctx))),
              active => ctx ~> isActive(ctx, id),
              selected => ctx ~> isSelected(ctx, id),
              pinned => ctx ~> isPinned(ctx, id),
              mode => controller.getMode,
              side => controller.getSide,
              fireMessage => (ctx, iu) ~> {
                msgs = tab.fireMessage(ctx, iu);
                Arrays.add(
                  msgs,
                  FWKMessage.Message(
                    statePath,
                    dirName.toString(),
                    ManageActive(id),
                  ),
                )
              },
            },
          ),
        )
      | _ -> void
      }
    },
  );
  splittedHdl = extractedHdl.contextWriterKeyMap(
    Indexed::fromFile,
    context,
    SKFS.DirName::make(dirName, "splitted/"),
    (context, writer, key, _) ~> {
      key match {
      | id @ SKFS.StrID _ ->
        tab = id.value;
        index = SKFS.IntFile::fromFile(
          extractedHdl.get(context, KIdx(tab)),
        ).value;
        if (isPinned(context, key.toString())) {
          writer.write(SKFS.IID(0), Indexed(index, tab));
        } else {
          writer.write(SKFS.IID(1), Indexed(index, tab));
        }
      | _ -> void
      }
    },
  );
  computedHdl = splittedHdl.contextWriterKeyValues(
    f ~> f,
    context,
    SKFS.DirName::make(dirName, "computed/"),
    (context, writer, key, files) ~> {
      sorted = files.sorted();
      if (key == SKFS.IID(0)) {
        sorted.eachWithIndex((idx, v) -> {
          writer.write(
            pinnedIndexProp(idx),
            controllersHdl.get(context, SKFS.StrID(v.value)),
          )
        });
        writer.write(numberOfPinnedProp, SKFS.IntFile(sorted.size()))
      } else if (key == SKFS.IID(1)) {
        sorted.eachWithIndex((idx, v) -> {
          writer.write(
            tabIndexProp(idx),
            controllersHdl.get(context, SKFS.StrID(v.value)),
          )
        });
        writer.write(numberOfTabsProp, SKFS.IntFile(sorted.size()))
      }
    },
  );
  Parameters(
    controller,
    HState(stateHdl, computedHdl, managedHdl, closableInfosHdl),
  )
}

@debug
fun update(
  context: mutable SKFS.Context,
  _scope: String,
  values: mutable Map<SKFS.BaseName, ?SKFS.File>,
  todo: Ui.Todo,
  _optUserData: ?SKFS.UserData,
): void {
  execute(context, todo.command as Executable _, values);
}

@debug
fun execute(
  context: mutable SKFS.Context,
  executable: Executable,
  values: mutable Map<SKFS.BaseName, ?SKFS.File>,
): void {
  executable match {
  | All(cmds) -> cmds.each(cmd -> execute(context, cmd, values))
  | Init() -> void
  | ManageActive(tab) ->
    previousTabs = values
      .get(TabsKey())
      .map(SKFS.Strings::fromFile)
      .fromSome().value;
    previousOptActive = values.get(Ui.activeProp).map(f ~>
      SKFS.StringFile::fromFile(f).value
    );
    if (previousTabs.indexOf(tab).isSome()) {
      history = values
        .get(HistoryKey())
        .map(SKFS.Strings::fromFile)
        .fromSome().value;
      if (Some(tab) != previousOptActive) {
        !history = Arrays.add(history.filter(f -> f != tab), tab)
      };
      values.set(Ui.activeProp, Some(SKFS.StringFile(tab)));
      values.set(HistoryKey(), Some(SKFS.Strings(history)));
    }
  | ManageMove(toMove, dstTab, before) ->
    previousTabs = values
      .get(TabsKey())
      .map(SKFS.Strings::fromFile)
      .fromSome().value;
    previousTabs.indexOf(toMove).each(_ -> {
      tabs = previousTabs.filter(v -> v != toMove);
      tabs.indexOf(dstTab).each(dIdx -> {
        values.set(
          TabsKey(),
          Some(
            SKFS.Strings(
              Arrays.insert(tabs, if (before) dIdx else dIdx + 1, toMove),
            ),
          ),
        );
        previous = values
          .get(PinnedKey())
          .map(SKFS.StringSet::fromFile)
          .fromSome().value;
        pinned = previous.contains(dstTab);
        set = if (pinned) {
          Sets.insert(previous, toMove)
        } else {
          Sets.remove(previous, toMove)
        };
        values.set(PinnedKey(), Some(SKFS.StringSet(set)))
      });
    })
  | ManagePinned(tab, pinned) ->
    previous = values
      .get(PinnedKey())
      .map(SKFS.StringSet::fromFile)
      .fromSome().value;
    set = if (pinned) {
      Sets.insert(previous, tab)
    } else {
      Sets.remove(previous, tab)
    };
    values.set(PinnedKey(), Some(SKFS.StringSet(set)))
  }
}

module end;
