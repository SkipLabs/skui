module UiTabs;

const statePath: String = "ui/tabs/state";
const numberOfPinnedProp: SKStore.StrID = SKStore.StrID("numberOfPinned");
const numberOfTabsProp: SKStore.StrID = SKStore.StrID("numberOfTabs");

class TabsKey() extends SKStore.Key {
  fun toString(): String {
    this.getClassName()
  }
}

class HistoryKey() extends SKStore.Key {
  fun toString(): String {
    this.getClassName()
  }
}

class ModifiedKey() extends SKStore.Key {
  fun toString(): String {
    this.getClassName()
  }
}

class PinnedKey() extends SKStore.Key {
  fun toString(): String {
    this.getClassName()
  }
}

fun pinnedProp(tab: String): SKStore.StrID {
  SKStore.StrID(`pinned[${tab}]`)
}

fun pinnedIndexProp(idx: Int): SKStore.StrID {
  SKStore.StrID(`pinned[${idx}]`)
}

fun tabIndexProp(idx: Int): SKStore.StrID {
  SKStore.StrID(`tab[${idx}]`)
}

fun activeProp(tab: String): SKStore.StrID {
  SKStore.StrID(`active[${tab}]`)
}

fun selectedProp(tab: String): SKStore.StrID {
  SKStore.StrID(`selected[${tab}]`)
}

class KIdx(value: String) extends SKStore.Key {
  //
  fun toString(): String {
    this.value
  }
}

class Indexed(idx: Int, value: String) extends SKStore.File uses Orderable {
  //
  static fun type(obj: SKStore.File): this {
    obj match {
    | x @ Indexed _ -> x
    | _ -> invariant_violation("Must be UiTabs.Indexed")
    }
  }
}

class HState(
  handle: SKStore.INotTyped,
  computed: SKStore.NotTyped,
  verified: SKStore.NotTyped,
  closableInfos: SKStore.Handle<SKStore.Key, ClosableInfo>,
) extends State {
  //
  fun getNumberOfPinned(context: mutable SKStore.Context): Int {
    this.computed.getInt(context, numberOfPinnedProp)
  }

  fun getActive(context: mutable SKStore.Context): ?String {
    this.verified.maybeGetString(context, Ui.activeProp)
  }

  fun getPinned(context: mutable SKStore.Context, index: Int): Identified {
    this.computed.maybeGetProp(
      context,
      pinnedIndexProp(index),
      Identified::type,
    ).fromSome()
  }

  fun getNumberOfTabs(context: mutable SKStore.Context): Int {
    this.computed.getInt(context, numberOfTabsProp)
  }

  fun getTab(context: mutable SKStore.Context, index: Int): Identified {
    this.computed.maybeGetProp(
      context,
      tabIndexProp(index),
      Identified::type,
    ).fromSome()
  }

  fun pin(context: mutable SKStore.Context, tab: String, value: Bool): void {
    this.handle.write(
      context,
      Ui.todoProp,
      Ui.Todo(ManagePinned(tab, value), context.tick),
    );
  }

  fun select(context: mutable SKStore.Context, optTab: ?String): void {
    this.handle.writeOrRemove(
      context,
      Ui.selectedProp,
      optTab.map(v -> SKStore.StringFile(v)),
    )
  }

  fun getClosableInfo(
    context: mutable SKStore.Context,
    optTab: ?String,
  ): ClosableInfo {
    key: SKStore.Key = optTab
      .map(tab -> SKStore.StrID(tab))
      .default(SKStore.IID(0));
    this.closableInfos.get(context, key)
  }

  fun move(
    context: mutable SKStore.Context,
    toMove: String,
    dstTab: String,
    before: Bool,
  ): void {
    Ui.setTodo(context, this.handle, ManageMove(toMove, dstTab, before))
  }
}

fun init(
  context: mutable SKStore.Context,
  path: Ui.Path,
  controller: Controller,
): Parameters {
  source = context.timeStamp().value;
  dirName = Ui.controllerDirName(path);
  initHdl = context.makeDir(
    SKStore.IID::keyType,
    SKStore.IntFile::type,
    SKStore.DirName::make(dirName, "init/"),
    Array[(SKStore.IID(0), SKStore.IntFile(0))],
  );
  stateHdl = context.makeNotTyped(
    dirName,
    Array<(SKStore.Key, SKStore.File)>[
      (Ui.todoProp, Ui.Todo(Ui.Init(), context.tick)),
    ],
  );
  storage = SKStore.toIHandle(stateHdl);
  managedDirName = SKStore.DirName::make(dirName, "managed/");
  preManagedHdl = context.makeNotTypedPre(
    managedDirName,
    Array<(SKStore.Key, SKStore.File)>[
      (TabsKey(), SKStore.Strings(Array[])),
      (HistoryKey(), SKStore.Strings(Array[])),
      (ModifiedKey(), SKStore.IntFile(0)),
      (PinnedKey(), SKStore.StringSet(Set[])),
    ],
  );
  initKeys = Array[Ui.activeProp, TabsKey(), HistoryKey(), PinnedKey()];
  verifiedHdl = initHdl.map(
    k ~> k,
    f ~> f,
    context,
    SKStore.DirName::make(dirName, "verified/"),
    (context, writer, _key, _it) ~> {
      writer.set(SKStore.KKeys(), SKStore.Keys(initKeys));
      previousTabs = SKStore.Strings::type(
        preManagedHdl.getValue(context, TabsKey()),
      ).value;
      previousOptActive = preManagedHdl
        .maybeGetValue(context, Ui.activeProp, true)
        .map(f ~> SKStore.StringFile::type(f).value);
      pinned = preManagedHdl.getValue(context, PinnedKey());
      tabs = controller.getTabs(context);
      aSet = Set::createFromItems(previousTabs);
      tSet = Set::createFromItems(tabs);
      optPrevious: ?String = None();
      added = mutable Map<?String, mutable Vector<String>>[];
      optFirstAdded: ?String = None();
      tabs.each(tab ->
        if (!aSet.contains(tab)) {
          vec = added.maybeGet(optPrevious) match {
          | Some(vec) -> vec
          | _ ->
            vec = mutable Vector<String>[];
            added.add(optPrevious, vec);
            vec
          };
          vec.push(tab);
          if (optFirstAdded.isNone()) {
            !optFirstAdded = Some(tab)
          }
        } else {
          !optPrevious = Some(tab);
        }
      );
      history = SKStore.Strings::type(
        preManagedHdl.getValue(context, HistoryKey(), true),
      ).value;
      if (previousTabs.size() != tabs.size() || optFirstAdded.isSome()) {
        newTabs = mutable Vector<String>[];
        added.maybeGet(None()).each(v -> v.each(newTabs.push));
        previousTabs.each(tab -> {
          if (tSet.contains(tab)) {
            newTabs.push(tab);
            added.maybeGet(Some(tab)).each(v -> v.each(newTabs.push));
          }
        });
        writer.set(TabsKey(), SKStore.Strings(newTabs.toArray()));
        optActive = optFirstAdded match {
        | Some(firstAdded) -> Some(firstAdded)
        | _ ->
          previousOptActive match {
          | Some(previousActive) ->
            if (tabs.indexOf(previousActive).isSome()) previousOptActive else {
              None()
            }
          | _ -> None()
          }
        };
        !history = history.filter(f -> tSet.contains(f));
        if (optActive.isNone()) {
          if (!history.isEmpty()) {
            !optActive = Some(history.last())
          } else if (!tabs.isEmpty()) {
            !optActive = Some(tabs.last())
          }
        };
        optActive.each(active -> {
          if (optActive != previousOptActive) {
            !history = Arrays.add(history.filter(f -> f != active), active)
          };
          writer.set(Ui.activeProp, SKStore.StringFile(active));
        });
      } else {
        writer.set(TabsKey(), SKStore.Strings(previousTabs));
        previousOptActive.each(active ->
          writer.set(Ui.activeProp, SKStore.StringFile(active))
        );
      };
      writer.set(HistoryKey(), SKStore.Strings(history));
      writer.set(ModifiedKey(), SKStore.IntFile(context.tick.value));
      writer.set(PinnedKey(), pinned);
    },
  );
  toReallyDoHdl = stateHdl.map(
    k ~> k,
    Ui.Todo::type,
    context,
    SKStore.DirName::make(dirName, "todo/"),
    (context, writer, key, it) ~> {
      if (key == Ui.todoProp) {
        todo = Ui.Todo::type(it.first);
        controller
          .getActive(context)
          .map(av -> av.getTimed(context))
          .each(info ->
            if (info.i1 > todo.tick && info.i2 != source) {
              !todo = Ui.Todo(ManageActive(info.i0.toString()), info.i1)
            }
          );
        modification = SKStore.IntFile::type(
          verifiedHdl.get(context, ModifiedKey()),
        );
        if (modification.value > todo.tick.value) {
          writer.set(key, Ui.Todo(Ui.Init(), context.tick))
        } else {
          writer.set(key, todo)
        }
      }
    },
  );
  managedHdl = SKStore.derive(
    context,
    dirName.toString(),
    managedDirName,
    toReallyDoHdl,
    Ui.todoProp,
    initKeys,
    update,
    None(),
    Some(verifiedHdl),
  );
  pinnedHdl = managedHdl.map(
    SKStore.StrID::keyType,
    SKStore.BoolFile::type,
    context,
    SKStore.DirName::make(dirName, "pinned/"),
    (context, writer, key, it) ~> {
      if (key == PinnedKey()) {
        tabs = SKStore.Strings::type(
          managedHdl.getValue(context, TabsKey(), true),
        ).value;
        pinned = SKStore.StringSet::type(it.first).value;
        tabs.each(tab ->
          writer.set(pinnedProp(tab), SKStore.BoolFile(pinned.contains(tab)))
        )
      }
    },
  );
  activeHdl = managedHdl.map(
    SKStore.StrID::keyType,
    SKStore.BoolFile::type,
    context,
    SKStore.DirName::make(dirName, "active/"),
    (_, writer, key, it) ~> {
      if (key == Ui.activeProp) {
        writer.set(
          activeProp(SKStore.StringFile::type(it.first).value),
          SKStore.BoolFile(true),
        );
      }
    },
  );
  separatedHdl = stateHdl.map(
    SKStore.StrID::keyType,
    SKStore.BoolFile::type,
    context,
    SKStore.DirName::make(dirName, "separated/"),
    (_, writer, key, it) ~> {
      if (key == Ui.selectedProp) {
        writer.set(
          selectedProp(SKStore.StringFile::type(it.first).value),
          SKStore.BoolFile(true),
        );
      } else if (key == Ui.activeProp) {
        writer.set(
          activeProp(SKStore.StringFile::type(it.first).value),
          SKStore.BoolFile(true),
        );
      }
    },
  );
  tabsHdl = initHdl.map(
    SKStore.IID::keyType,
    SKStore.StringFile::type,
    context,
    SKStore.DirName::make(dirName, "tabs/"),
    (context, writer, _key, _file) ~> {
      tabs = verifiedHdl.getProp(
        context,
        TabsKey(),
        SKStore.Strings::type,
        SKStore.Strings(Array[]),
      ).value;
      for (idx in Range(0, tabs.size())) {
        writer.set(SKStore.IID(idx), SKStore.StringFile(tabs[idx]))
      }
    },
  );
  isActive = (ctx, tab) ~> activeHdl.getBool(ctx, activeProp(tab));
  isSelected = (ctx, tab) ~> separatedHdl.getBool(ctx, selectedProp(tab));
  isPinned = (ctx, tab) ~> pinnedHdl.getBool(ctx, pinnedProp(tab));
  extractedPath = SKStore.DirName::make(dirName, "extracted/");
  extractedHdl = tabsHdl.map(
    k ~> k,
    f ~> f,
    context,
    extractedPath,
    (context, writer, key, it) ~> {
      file = it.first;
      tab = controller.getTab(context, file.value);
      writer.set(SKStore.StrID(file.value), tab);
      writer.set(KIdx(file.value), SKStore.IntFile(key.value));
    },
  );
  closableInfosHdl = managedHdl.map(
    k ~> k,
    ClosableInfo::type,
    context,
    SKStore.DirName::make(dirName, "closableInfo/"),
    (context, writer, key, it) ~> {
      if (key == TabsKey()) {
        tabs = SKStore.Strings::type(it.first).value;
        withInfo = tabs.map(tab -> {
          tabObj = Tab::type(extractedHdl.get(context, SKStore.StrID(tab)));
          (tab, tabObj.closable(context));
        });
        collect = table ~> table.filter(i ~> i.i1).map(i ~> i.i0);
        closables = collect(withInfo);
        writer.set(SKStore.IID(0), ClosableInfo(closables, Array[], Array[]));
        // Could be to heavy
        vector = Vector::mcreateFromItems(withInfo);
        left = mutable Vector<String>[];
        while (!vector.isEmpty()) {
          last = vector.get(0);
          vector.delete(0);
          writer.set(
            SKStore.StrID(last.i0),
            ClosableInfo(closables, left.toArray(), collect(vector.toArray())),
          );
          if (last.i1) {
            left.push(last.i0)
          }
        };
      }
    },
  );
  withDiscriminantHdl = extractedHdl
    .map(
      SKStore.StrID::keyType,
      SKStore.StringFile::type,
      context,
      SKStore.DirName::make(dirName, "texts/"),
      (context, writer, key, it) ~> {
        key match {
        | SKStore.StrID(id) ->
          tab = Tab::type(it.first);
          optDiscriminant = tab.discriminant(context);
          if (optDiscriminant.isSome()) {
            tab.text(context).each(txt -> {
              str = SKStore.StrID(context.translate(txt));
              writer.set(str, SKStore.StringFile(id))
            })
          }
        | _ -> void
        }
      },
    )
    .map(
      SKStore.StrID::keyType,
      SKStore.BoolFile::type,
      context,
      SKStore.DirName::make(dirName, "withDiscriminant/"),
      (_, writer, _key, it) ~> {
        count = 0;
        values = it.toArray();
        values.each(_ -> !count = count + 1);
        withDiscriminant = SKStore.BoolFile(count > 1);
        values.each(sf -> writer.set(SKStore.StrID(sf.value), withDiscriminant))
      },
    );
  controllersHdl = extractedHdl.map(
    SKStore.StrID::keyType,
    Identified::type,
    context,
    SKStore.DirName::make(dirName, "controllers/"),
    (_, writer, key, it) ~> {
      key match {
      | sid @ SKStore.StrID(id) ->
        tab = Tab::type(it.first);
        writer.set(
          sid,
          Identified(
            id,
            UiTab.LamController{
              disabled => tab.disabled,
              closable => tab.closable,
              text => tab.text,
              tooltip => tab.tooltip,
              discriminant => ctx ~> {
                if (
                  withDiscriminantHdl
                    .maybeGet(ctx, sid)
                    .map(f ~> f.value)
                    .default(false)
                ) {
                  tab.discriminant(ctx)
                } else {
                  None()
                }
              },
              badge => tab.badge,
              progress => tab.progress,
              close => ctx ~> controller.onClose(ctx, Array[id]),
              drop => (ctx, toMove, dstTab, before) ~>
                Ui.setTodo(ctx, storage, ManageMove(toMove, dstTab, before)),
              icon => (ctx, fs) ~>
                tab
                  .icon(ctx)
                  .flatMap(ib -> ib.buildIcon(ctx, fs))
                  .map(i -> UiTab.Icon(i, tab.iconOnTop(ctx))),
              active => ctx ~> isActive(ctx, id),
              selected => ctx ~> isSelected(ctx, id),
              pinned => ctx ~> isPinned(ctx, id),
              mode => controller.getMode,
              side => controller.getSide,
              fire => ctx ~> {
                tab.fire(ctx);
                Ui.setTodo(ctx, storage, ManageActive(id))
              },
            },
          ),
        )
      | _ -> void
      }
    },
  );
  splittedHdl = extractedHdl.map(
    SKStore.IID::keyType,
    Indexed::type,
    context,
    SKStore.DirName::make(dirName, "splitted/"),
    (context, writer, key, _) ~> {
      key match {
      | id @ SKStore.StrID _ ->
        tab = id.value;
        index = SKStore.IntFile::type(
          extractedHdl.get(context, KIdx(tab)),
        ).value;
        if (isPinned(context, key.toString())) {
          writer.set(SKStore.IID(0), Indexed(index, tab));
        } else {
          writer.set(SKStore.IID(1), Indexed(index, tab));
        }
      | _ -> void
      }
    },
  );
  computedHdl = splittedHdl.map(
    k ~> k,
    f ~> f,
    context,
    SKStore.DirName::make(dirName, "computed/"),
    (context, writer, key, it) ~> {
      sorted = it.toArray().sorted();
      if (key == SKStore.IID(0)) {
        sorted.eachWithIndex((idx, v) -> {
          writer.set(
            pinnedIndexProp(idx),
            controllersHdl.get(context, SKStore.StrID(v.value)),
          )
        });
        writer.set(numberOfPinnedProp, SKStore.IntFile(sorted.size()))
      } else if (key == SKStore.IID(1)) {
        sorted.eachWithIndex((idx, v) -> {
          writer.set(
            tabIndexProp(idx),
            controllersHdl.get(context, SKStore.StrID(v.value)),
          )
        });
        writer.set(numberOfTabsProp, SKStore.IntFile(sorted.size()))
      }
    },
  );
  Parameters(
    controller,
    HState(storage, computedHdl, managedHdl, closableInfosHdl),
  )
}

@debug
fun update(
  context: mutable SKStore.Context,
  _scope: String,
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
  todo: Ui.Todo,
  _optUserData: ?SKStore.UserData,
): void {
  execute(context, todo.command, values);
}

@debug
fun execute(
  context: mutable SKStore.Context,
  executable: Ui.Executable,
  values: mutable FWK.SMap<SKStore.Key, ?SKStore.File>,
): void {
  executable match {
  | Ui.Multiple(cmds) -> cmds.each(cmd -> execute(context, cmd, values))
  | Ui.Init() -> void
  | ManageActive(tab) ->
    previousTabs = values
      .get(TabsKey())
      .map(SKStore.Strings::type)
      .fromSome().value;
    previousOptActive = values.get(Ui.activeProp).map(f ~>
      SKStore.StringFile::type(f).value
    );
    if (previousTabs.indexOf(tab).isSome()) {
      history = values
        .get(HistoryKey())
        .map(SKStore.Strings::type)
        .fromSome().value;
      if (Some(tab) != previousOptActive) {
        !history = Arrays.add(history.filter(f -> f != tab), tab)
      };
      values.set(Ui.activeProp, Some(SKStore.StringFile(tab)));
      values.set(HistoryKey(), Some(SKStore.Strings(history)));
    }
  | ManageMove(toMove, dstTab, before) ->
    previousTabs = values
      .get(TabsKey())
      .map(SKStore.Strings::type)
      .fromSome().value;
    previousTabs.indexOf(toMove).each(_ -> {
      tabs = previousTabs.filter(v -> v != toMove);
      tabs.indexOf(dstTab).each(dIdx -> {
        values.set(
          TabsKey(),
          Some(
            SKStore.Strings(
              Arrays.insert(tabs, if (before) dIdx else dIdx + 1, toMove),
            ),
          ),
        );
        previous = values
          .get(PinnedKey())
          .map(SKStore.StringSet::type)
          .fromSome().value;
        pinned = previous.contains(dstTab);
        set = if (pinned) {
          Sets.insert(previous, toMove)
        } else {
          Sets.remove(previous, toMove)
        };
        values.set(PinnedKey(), Some(SKStore.StringSet(set)))
      });
    })
  | ManagePinned(tab, pinned) ->
    previous = values
      .get(PinnedKey())
      .map(SKStore.StringSet::type)
      .fromSome().value;
    set = if (pinned) {
      Sets.insert(previous, tab)
    } else {
      Sets.remove(previous, tab)
    };
    values.set(PinnedKey(), Some(SKStore.StringSet(set)))
  | _ -> SKStore.cast_violation("UiTabs.Executable", executable)
  }
}

module end;
