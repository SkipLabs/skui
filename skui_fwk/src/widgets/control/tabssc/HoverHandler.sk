module UiTabsSc;

class HoverHandler(
  scroll: Ui.TabsSc,
  optHover: ?Hover,
) extends Ui.HoverHandlerWrapper {
  fun getIdentifier(): Ui.Path {
    this.optHover match {
    | Some(hover) -> this.scroll.path.makeChild(hover.toString())
    | _ -> this.scroll.path
    }
  }

  protected fun onEnter(context: mutable SKStore.Context): void {
    if (this.optHover.isSome()) {
      this.scroll.state.emitHover(context, this.optHover);
      FWKPointer.setCursor(context, Ui.HandCursor());
    }
  }

  protected fun onMouse(
    context: mutable SKStore.Context,
    mouse: UiEvent.MouseFile,
  ): FWK.Result {
    wheel = mouse.getWheelValue(context.tick);
    FWK.Result(
      if (wheel != 0) {
        incr = Math.sign(-wheel).toInt();
        this.scroll.state.emitScrolling(context, incr);
        true
      } else if (
        this.optHover.isSome() &&
        mouse.isPrimaryPressed(context.tick)
      ) {
        optRepeat = mouse.mouse.toMouseRepeat(context);
        this.scroll.state.emitGoTo(
          context,
          this.optHover.fromSome(),
          optRepeat,
        );
        true
      } else {
        false
      },
    );
  }

  protected fun onExit(context: mutable SKStore.Context): void {
    if (this.optHover.isSome()) {
      FWKPointer.resetCursor(context);
      this.scroll.state.emitHover(context, None());
    }
  }
}

module end;
