module UiTree;

class Item{
  text: Text,
  tooltip: ?Text = None(),
  icon: ?UiIcon.Description = None(),
  leaf: Bool,
} extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Item _ -> x
    | _ -> invariant_violation("Must be UiTree.Item")
    }
  }
}

class Selection(multiple: Array<Ui.Path>, optMain: ?Ui.Path)
class ItemFile(item: Item, depth: Int) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ ItemFile _ -> x
    | _ -> invariant_violation("Must be UiTree.ItemFile")
    }
  }
}

base class Controller {
  //
  fun getSelectionModel(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): SelectionModel;

  fun getItems(
    context: mutable SKFS.Context,
    optPath: ?Ui.Path,
  ): ?Array<String>;

  fun getItem(context: mutable SKFS.Context, path: Ui.Path): Item;

  fun getProgress(context: mutable SKFS.Context, path: Ui.Path): ?Ui.Progress;
  fun getBadge(context: mutable SKFS.Context, path: Ui.Path): ?Text;
  fun getBadgeMaxChar(context: mutable SKFS.Context): ?Int;

  fun getContextMenuItems(
    context: mutable SKFS.Context,
    optCurrent: ?Ui.Path,
    selections: Array<Ui.Path>,
  ): Array<UiDropdown.ItemBase>;

  fun getSelectionChangeMessages(
    context: mutable SKFS.Context,
    selections: Array<Ui.Path>,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;

  fun getExpansionChangeMessages(
    context: mutable SKFS.Context,
    path: Ui.Path,
    value: Bool,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;

  fun getFireMessages(
    context: mutable SKFS.Context,
    optCurrent: ?Ui.Path,
    selections: Array<Ui.Path>,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;

  fun getDropMessages(
    context: mutable SKFS.Context,
    source: Ui.Path,
    destination: Ui.Path,
    drop: Ui.Drop,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message>;
}

base class State extends Ui.StateWithScroll {
  fun isHover(context: mutable SKFS.Context): Bool;
  fun getVisibleItems(): Ui.ListHandle<ItemFile>;
  fun getSize(context: mutable SKFS.Context): Int;
  fun isExpanded(context: mutable SKFS.Context, path: Ui.Path): Bool;
  fun isSelected(context: mutable SKFS.Context, path: Ui.Path): Bool;
  fun getCurrent(context: mutable SKFS.Context): ?Ui.Path;
  fun isScrolling(context: mutable SKFS.Context): Bool;
  fun getProgress(context: mutable SKFS.Context, path: Ui.Path): ?Ui.Progress;
  fun getBadge(context: mutable SKFS.Context, path: Ui.Path): ?Ui.Badge;
  fun getSelection(context: mutable SKFS.Context): Array<Ui.Path>;

  fun getAsking(
    context: mutable SKFS.Context,
    isUntraked: Bool = false,
  ): ?Ui.Path;

  fun emitSelect(
    context: mutable SKFS.Context,
    target: STarget,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;

  fun emitGoto(
    context: mutable SKFS.Context,
    optTarget: ?GTarget,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void;

  fun emitHover(context: mutable SKFS.Context, value: Bool): void;

  fun emitExpansion(
    context: mutable SKFS.Context,
    expansion: Bool,
    optPath: ?Ui.Path,
  ): void;

  fun emitAsking(context: mutable SKFS.Context, optPath: ?Ui.Path): void;
  fun emitVisible(context: mutable SKFS.Context, index: Int): void;

  fun emitFire(context: mutable SKFS.Context): void;

  fun selectMessage(
    path: Ui.Path,
    toogle: Bool,
    keep: Bool,
  ): SKUIMessage.Message;

  fun toggleExpansionMessage(path: Ui.Path): SKUIMessage.Message;
  fun fireMessage(path: Ui.Path): SKUIMessage.Message;
}

class Parameters(controller: Controller, state: State) extends Ui.Parameters {}

base class Storage {
  fun getName(): String;
  fun getScope(): String;

  fun setScrolling(context: mutable SKFS.Context, optTick: ?SKFS.Tick): void;

  fun setTodo(context: mutable SKFS.Context, cmd: Executable): void;
  fun setScroll(context: mutable SKFS.Context, optScroll: ?Ui.Scroll): void;
  fun setHover(context: mutable SKFS.Context, value: Bool): void;
  fun setAsking(context: mutable SKFS.Context, optPath: ?Ui.Path): void;

  fun getScrolling(context: mutable SKFS.Context): ?SKFS.Tick;
  fun getAsking(context: mutable SKFS.Context): ?Ui.Path;
}

base class STarget {
  children =
  | SAll()
  | SNext()
  | SPrevious()
  | SFirst()
  | SLast()
  | SClear()
  | SCurrent(Bool)
  | SToPrevious(Bool)
  | SToNext(Bool)
  | SToFirst(Bool)
  | SToLast(Bool)
  | SPath(Ui.Path, Bool)
  | SToPath(Ui.Path, Bool)
  | SToCurrent(Bool)
}

base class GTarget {
  children =
  | GPrevious()
  | GNext()
  | GFirst()
  | GLast()
  | GIndex(Int)
}

module end;
