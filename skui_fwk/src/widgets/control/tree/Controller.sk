module UiTree;

class LamController{
  selectionModel: Ui.GetterOne<SelectionModel, Bool>,
  items: Ui.GetterOne<?Array<String>, ?Ui.Path>,
  item: Ui.GetterOne<Item, Ui.Path>,
  progress: Ui.GetterOne<?Ui.Progress, Ui.Path> = Ui.defaultOne(None()),
  badge: Ui.GetterOne<?Text, Ui.Path> = Ui.defaultOne(None()),
  badgeMaxChar: Ui.Getter<?Int> = Ui.default(None()),
  contextMenuItems: Ui.GetterTwo<
    Array<UiDropdown.ItemBase>,
    ?Ui.Path,
    Array<Ui.Path>,
  > = Ui.defaultTwo(Array[]),
  selectionChange: Ui.GetterTwo<
    Array<SKUIMessage.Message>,
    Array<Ui.Path>,
    Bool,
  > = Ui.defaultTwo(Array[]),
  expansionChange: Ui.GetterThree<
    Array<SKUIMessage.Message>,
    Ui.Path,
    Bool,
    Bool,
  > = Ui.defaultThree(Array[]),
  fire: Ui.GetterThree<
    Array<SKUIMessage.Message>,
    ?Ui.Path,
    Array<Ui.Path>,
    Bool,
  > = Ui.defaultThree(Array[]),
  drop: (mutable SKFS.Context, Ui.Path, Ui.Path, Ui.Drop, Bool) ~> Array<
    SKUIMessage.Message,
  > = (_, _, _, _, _) ~> Array[],
} extends Controller {
  //
  fun getSelectionModel(
    context: mutable SKFS.Context,
    isUntracked: Bool = false,
  ): SelectionModel {
    this.selectionModel(context, isUntracked)
  }

  fun getItems(
    context: mutable SKFS.Context,
    optPath: ?Ui.Path,
  ): ?Array<String> {
    this.items(context, optPath)
  }

  fun getItem(context: mutable SKFS.Context, path: Ui.Path): Item {
    this.item(context, path)
  }

  fun getProgress(context: mutable SKFS.Context, path: Ui.Path): ?Ui.Progress {
    this.progress(context, path)
  }

  fun getBadge(context: mutable SKFS.Context, path: Ui.Path): ?Text {
    this.badge(context, path)
  }

  fun getBadgeMaxChar(context: mutable SKFS.Context): ?Int {
    this.badgeMaxChar(context)
  }

  fun getContextMenuItems(
    context: mutable SKFS.Context,
    optCurrent: ?Ui.Path,
    selections: Array<Ui.Path>,
  ): Array<UiDropdown.ItemBase> {
    this.contextMenuItems(context, optCurrent, selections)
  }

  fun getSelectionChangeMessages(
    context: mutable SKFS.Context,
    selections: Array<Ui.Path>,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.selectionChange(context, selections, isUntracked)
  }

  fun getExpansionChangeMessages(
    context: mutable SKFS.Context,
    path: Ui.Path,
    value: Bool,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.expansionChange(context, path, value, isUntracked)
  }

  fun getFireMessages(
    context: mutable SKFS.Context,
    optCurrent: ?Ui.Path,
    selections: Array<Ui.Path>,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.fire(context, optCurrent, selections, isUntracked)
  }

  fun getDropMessages(
    context: mutable SKFS.Context,
    source: Ui.Path,
    destination: Ui.Path,
    drop: Ui.Drop,
    isUntracked: Bool = false,
  ): Array<SKUIMessage.Message> {
    this.drop(context, source, destination, drop, isUntracked)
  }
}

module end;
