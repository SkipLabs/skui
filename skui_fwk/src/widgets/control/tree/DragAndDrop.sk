module UiTree;

class DropHandler(
  tree: Ui.Tree,
  nodeInfo: Ui.NodeInfo,
  optDropHandler: ?FWK.DropHandler,
) extends FWK.DropHandler {
  fun getIdentifier(): String {
    this.optDropHandler.map(dh -> dh.getIdentifier()).default(
      this.tree.path.toString(),
    )
  }

  fun exit(context: mutable SKStore.Context): void {
    this.optDropHandler.each(dh -> dh.exit(context));
    this.tree.state.emitAsking(context, None());
  }

  fun over(
    context: mutable SKStore.Context,
    mouse: UiEvent.MouseFile,
    dragHandler: FWK.DragHandler,
    transfer: FWK.TransferMode,
  ): ?FWK.TransferMode {
    scrollables = this.nodeInfo.optUserData.map(v ~> v as Metrics _)
      .map(m -> (m.axis.range.start > 0, m.axis.range.end < m.axis.count))
      .default((false, false));
    wOffset = this.nodeInfo.getWindowOffset(context, true);
    offset = mouse.offset() - wOffset;
    if (
      (scrollables.i0 || scrollables.i1) &&
      !this.tree.state.isScrolling(context)
    ) {
      scrollGap = 6.0;
      height = this.nodeInfo.nodeSum.size.height;
      if (scrollables.i0 && offset.dy < scrollGap) {
        this.tree.state.emitScrolling(context, -1);
      } else if (scrollables.i1 && offset.dy > height - scrollGap) {
        this.tree.state.emitScrolling(context, 1);
      }
    };
    this.optDropHandler match {
    | Some(dh) ->
      dh match {
      | tiDh @ UiTreeItem.DropHandler _ ->
        if (
          tiDh.drop == Ui.DropIn() &&
          this.tree.state.getAsking(context, true) != Some(tiDh.treeItem.id)
        ) {
          this.tree.state.emitAsking(context, Some(tiDh.treeItem.id));
        }
      | _ -> void
      };
      dh.over(context, mouse, dragHandler, transfer)
    | _ -> None()
    }
  }

  fun dropped(
    context: mutable SKStore.Context,
    dragHandler: FWK.DragHandler,
    transfer: FWK.TransferMode,
  ): void {
    this.optDropHandler.each(dh -> dh.dropped(context, dragHandler, transfer))
  }
}

module end;
