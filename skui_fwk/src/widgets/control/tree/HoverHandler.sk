module UiTree;

class HoverHandler(tree: Ui.Tree, bar: Bool) extends Ui.HoverHandlerWrapper {
  //
  fun getIdentifier(): Ui.Path {
    if (this.bar) this.tree.path.makeChild("bar") else this.tree.path
  }

  protected fun onEnter(context: mutable SKFS.Context): void {
    if (this.bar) {
      this.tree.state.emitHover(context, true);
      FWKPointer.setCursor(context, Ui.HandCursor());
    }
  }

  protected fun onMouse(
    context: mutable SKFS.Context,
    mouse: UiEvent.MouseFile,
  ): FWK.Result {
    wheel = mouse.getWheelValue(context.tick);
    FWK.Result(
      if (wheel != 0) {
        incr = Math.sign(-wheel).toInt();
        this.tree.state.emitScrolling(context, 2 * incr);
        true
      } else {
        false
      },
    );
  }

  protected fun onExit(context: mutable SKFS.Context): void {
    if (this.bar) {
      FWKPointer.resetCursor(context);
      this.tree.state.emitHover(context, false);
    }
  }

  fun getDropdown(context: mutable SKFS.Context): ?FWK.SourcedWidget {
    if (!this.bar) {
      this.optHoverHandler match {
      | Some(hh) -> hh.getDropdown(context)
      | _ ->
        Some(
          FWK.SourcedWidget(Some(this.tree.path), (ctx, root) ~> {
            selection = this.tree.state.getSelection(ctx);
            items = this.tree.controller.getContextMenuItems(
              ctx,
              None(),
              selection,
            );
            if (!items.isEmpty()) {
              Some(
                root.buildDropdown(
                  ctx,
                  this.tree.path.makeChild("@treeContextMenu"),
                  items,
                ),
              )
            } else {
              None()
            }
          }),
        )
      };
    } else {
      None()
    }
  }
}

module end;
