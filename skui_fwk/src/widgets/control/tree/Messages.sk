module UiTree;

base class ForStorage
  extends FWKMessage.Support
  uses FWKMessage.WithUpdate<Command> {
  //
  fun init(_context: mutable SKFS.Context): void {
    void
  }

  protected fun executeForStorage(
    context: mutable SKFS.Context,
    storage: Storage,
    command: Command,
  ): void {
    name = storage.getName();
    scope = storage.getScope();
    command match {
    | SetAsking(optPath) ->
      optAsking = storage.getAsking(context);
      storage.setAsking(context, optPath);
      optPath.each(path ->
        if (optAsking != Some(path)) {
          FWKMessage.emit(
            context,
            name,
            scope,
            CheckAsking(path),
            false,
            Some(500),
          )
        }
      )
    | CheckAsking(path) ->
      if (storage.getAsking(context) == Some(path)) {
        FWKMessage.emit(context, name, scope, ToggleExpansion(path))
      }
    | SetScroll(optScroll) -> storage.setScroll(context, optScroll)
    | SetHover(hover) -> storage.setHover(context, hover)
    | CancelScrolling(tick) ->
      storage.getScrolling(context).each(sc ->
        if (sc == tick) {
          storage.setScrolling(context, None());
        }
      )
    | executable @ ExecCommand _ ->
      executable match {
      | repeatable @ Repeatable _ ->
        FWKMessage.repeat(
          context,
          name,
          scope,
          repeatable.next(),
          ctx ~> storage.setTodo(ctx, repeatable),
          repeatable.optRepeatOn,
          false,
          if (repeatable.count == 1) {
            500
          } else {
            50
          },
        )
      | cmd ->
        cmd match {
        | ManageScrolling(_, tick) ->
          storage.setScrolling(context, Some(tick));
          FWKMessage.emit(
            context,
            name,
            scope,
            CancelScrolling(tick),
            false,
            Some(200),
          )
        | _ -> void
        };
        storage.setTodo(context, executable)
      }
    }
  }
}

class Messages(storage: Storage) extends ForStorage {
  //
  protected fun convert(message: JSON.Value): Command {
    Command::fromJSON(message)
  }

  protected fun convertCmd(command: FWKMessage.Command): Command {
    command as Command _;
  }

  protected fun execute(
    context: mutable SKFS.Context,
    _name: String,
    _scope: String,
    command: Command,
  ): void {
    this.executeForStorage(context, this.storage, command)
  }
}

class AllMessages() extends ForStorage {
  //
  protected fun execute(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    command: Command,
  ): void {
    HStorage::forNameAndScope(context, name, scope).each(storage ->
      this.executeForStorage(context, storage, command)
    )
  }

  protected fun convert(message: JSON.Value): Command {
    Command::fromJSON(message)
  }

  protected fun convertCmd(command: FWKMessage.Command): Command {
    command as Command _;
  }
}

module end;
