module UiTree;

const statePath: String = "ui/tree/state";
const computedPath: String = "ui/tree/computed";

class Items(value: Array<Ui.Path>) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ Items _ -> x
    | _ -> invariant_violation("Must be UiTree.Items")
    }
  }
}

class ItemsSet(value: SortedSet<Ui.Path>) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ ItemsSet _ -> x
    | _ -> invariant_violation("Must be UiTree.ItemsSet")
    }
  }
}

const askingProp: SKFS.StrID = SKFS.StrID("asking");

class HStorage(name: String, handle: SKFS.IHandle<SKFS.File>) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKFS.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKFS.IHandle(SKFS.FileConverter(f ~> f), SKFS.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setTodo(context: mutable SKFS.Context, value: Executable): void {
    this.handle.write(context, Ui.todoProp, Ui.Todo(value, context.tick))
  }

  fun setScroll(context: mutable SKFS.Context, optScroll: ?Ui.Scroll): void {
    this.handle.writeOrRemove(context, Ui.scrollProp, optScroll)
  }

  fun setScrolling(context: mutable SKFS.Context, optTick: ?SKFS.Tick): void {
    this.handle.writeOrRemove(
      context,
      Ui.scrollingProp,
      optTick.map(t -> SKFS.IntFile(t.value)),
    )
  }

  fun setHover(context: mutable SKFS.Context, value: Bool): void {
    this.handle.write(context, Ui.hoverProp, SKFS.BoolFile(value))
  }

  fun setAsking(context: mutable SKFS.Context, optPath: ?Ui.Path): void {
    this.handle.writeOrRemove(context, askingProp, optPath)
  }

  fun getScrolling(context: mutable SKFS.Context): ?SKFS.Tick {
    this.handle.maybeGetInt(context, Ui.scrollingProp).map(v -> SKFS.Tick(v))
  }

  fun getAsking(context: mutable SKFS.Context): ?Ui.Path {
    this.handle.maybeGetProp(context, askingProp, Ui.Path::fromFile, true)
  }

  fun getTodo(context: mutable SKFS.Context): Ui.Todo {
    Ui.Todo::fromFile(this.handle.get(context, Ui.todoProp))
  }
}

class HState(
  storage: SKFS.IHandle<SKFS.File>,
  visibleItems: Ui.ListHandle<ItemFile>,
  size: Ui.Getter<Int>,
  selection: Ui.GetterOne<Bool, Ui.Path>,
  expansion: Ui.GetterOne<Bool, Ui.Path>,
  current: Ui.Getter<?Ui.Path>,
  computed: SKFS.EHandle<SKFS.File>,
  progress: Ui.GetterOne<?Ui.Progress, Ui.Path>,
  badge: Ui.GetterOne<?Ui.Badge, Ui.Path>,
  selectionArray: Ui.Getter<Array<Ui.Path>>,
) extends State uses Ui.ScrollingState {
  //
  fun getVisibleItems(): Ui.ListHandle<ItemFile> {
    this.visibleItems
  }

  fun isHover(context: mutable SKFS.Context): Bool {
    this.storage.getBool(context, Ui.hoverProp)
  }

  fun getSize(context: mutable SKFS.Context): Int {
    this.size(context)
  }

  fun isSelected(context: mutable SKFS.Context, path: Ui.Path): Bool {
    this.selection(context, path)
  }

  fun isExpanded(context: mutable SKFS.Context, path: Ui.Path): Bool {
    this.expansion(context, path)
  }

  fun getCurrent(context: mutable SKFS.Context): ?Ui.Path {
    this.current(context)
  }

  fun getSelection(context: mutable SKFS.Context): Array<Ui.Path> {
    this.selectionArray(context)
  }

  fun isScrolling(context: mutable SKFS.Context): Bool {
    this.storage.maybeGetInt(context, Ui.scrollingProp).isSome()
  }

  fun getAsking(
    context: mutable SKFS.Context,
    isUntraked: Bool = false,
  ): ?Ui.Path {
    this.storage.maybeGetProp(
      context,
      askingProp,
      Ui.Path::fromFile,
      isUntraked,
    )
  }

  fun getProgress(context: mutable SKFS.Context, path: Ui.Path): ?Ui.Progress {
    this.progress(context, path)
  }

  fun getBadge(context: mutable SKFS.Context, path: Ui.Path): ?Ui.Badge {
    this.badge(context, path)
  }

  protected fun getComputed(): SKFS.EHandle<SKFS.File> {
    this.computed
  }

  protected fun getHandle(): SKFS.EHandle<SKFS.File> {
    this.storage.toEHandle();
  }

  protected fun getStatePath(): String {
    statePath
  }

  protected fun setScrollCmd(value: ?Ui.Scroll): SKUIMessage.Command {
    SetScroll(value)
  }

  protected fun manageScrollingCmd(
    value: Int,
    tick: SKFS.Tick,
  ): SKUIMessage.Command {
    ManageScrolling(value, tick)
  }

  fun emitHover(context: mutable SKFS.Context, value: Bool): void {
    this.emit(context, SetHover(value))
  }

  fun emitSelect(
    context: mutable SKFS.Context,
    target: STarget,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, ManageSelect(target, optRepeatOn))
  }

  fun emitGoto(
    context: mutable SKFS.Context,
    optTarget: ?GTarget,
    optRepeatOn: ?FWK.Repeat = None(),
  ): void {
    this.emit(context, ManageGoto(optTarget, optRepeatOn))
  }

  fun emitExpansion(
    context: mutable SKFS.Context,
    expansion: Bool,
    optPath: ?Ui.Path,
  ): void {
    optPath match {
    | Some(path) -> this.emit(context, ManageExpansion(path, expansion))
    | _ -> this.emit(context, ManageCurrentExpansion(expansion))
    }
  }

  fun emitFire(context: mutable SKFS.Context): void {
    this.emit(context, Fire(None()))
  }

  fun emitAsking(context: mutable SKFS.Context, optPath: ?Ui.Path): void {
    this.emit(context, SetAsking(optPath))
  }

  fun emitVisible(context: mutable SKFS.Context, index: Int): void {
    this.emit(context, ManageVisible(index))
  }

  fun select(
    context: mutable SKFS.Context,
    path: Ui.Path,
    toogle: Bool,
    keep: Bool,
  ): void {
    target = if (keep) {
      SToPath(path, toogle)
    } else {
      SPath(path, toogle)
    };
    this.setTodo(context, ManageSelect(target))
  }

  fun toggleExpansion(context: mutable SKFS.Context, path: Ui.Path): void {
    this.setTodo(context, ToggleExpansion(path))
  }

  fun fire(context: mutable SKFS.Context, path: Ui.Path): void {
    this.setTodo(context, Fire(Some(path)))
  }

  private fun setTodo(context: mutable SKFS.Context, value: Executable): void {
    Ui.setTodo(context, this.storage, value)
  }
}

class Info(
  controller: Controller,
  items: Ui.Getter<Array<Ui.Path>>,
  item: Ui.GetterOne<Item, Ui.Path>,
) extends SKFS.UserData

@debug
fun init(
  context: mutable SKFS.Context,
  path: Ui.Path,
  controller: Controller,
): Parameters {
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeDir(
    f ~> f,
    dirName,
    Array<(SKFS.BaseName, SKFS.File)>[
      (Ui.todoProp, Ui.Todo(Init(), context.tick)),
    ],
  );
  toReallyDoHdl = stateHdl.contextWriterKeyMap(
    Ui.Todo::fromFile,
    context,
    SKFS.DirName::make(dirName, "todo/"),
    (_context, writer, key, file) ~> {
      if (key == Ui.todoProp) {
        writer.write(key, file);
        /*modification: SKFS.IntFile = .todo();
        todo = Ui.Todo::fromFile(file);
        if (modification.value > todo.tick.value) {
          writer.write(key, Ui.Todo(Init(), context.tick))
        } else {
          writer.write(key, file)
        }*/
      }
    },
  );
  allItemsDirName = itemsDirName(path.makeChild("listed"));
  preListedHdl = context.makePreDir(
    f ~> f,
    allItemsDirName,
    Array<(SKFS.BaseName, SKFS.File)>[
      (SKFS.KKeys(), SKFS.Keys(Array[])),
      (SKFS.KSize(), SKFS.IntFile(0)),
    ],
  );
  preItemHdl = context.makePreDir(f ~> f, itemsDirName(path), Array[]);
  initKeys = Array[
    Ui.selectionProp,
    Ui.ensureVisibleProp,
    Ui.currentProp,
    Ui.expansionProp,
  ];
  managedDirName = SKFS.DirName::make(dirName, "managed/");
  cleanedDirName = SKFS.DirName::make(dirName, "cleaned/");
  preCleaneddHdl = context.makePreDir(
    f ~> f,
    cleanedDirName,
    Array<(SKFS.BaseName, SKFS.File)>[(SKFS.KKeys(), SKFS.Keys(initKeys))],
  );
  getItems = (ctx, ui) ~>
    preListedHdl.getProp(
      ctx,
      SKFS.KKeys(),
      f ~> SKFS.Keys::fromFile(f).value.map(ItemKey::fromFile).map(i -> i.path),
      Array[],
      ui,
    );
  info = Info(
    controller,
    ctx ~> getItems(ctx, true),
    (ctx, path) ~>
      ItemFile::fromFile(preItemHdl.getValue(ctx, path, true)).item
    ,
  );
  managedHdl = SKFS.derive(
    context,
    dirName.toString(),
    managedDirName,
    toReallyDoHdl,
    Ui.todoProp,
    initKeys,
    update,
    Some(info),
    Some(preCleaneddHdl),
  );
  cleanedHdl = managedHdl.contextWriterKeyMap(
    f ~> f,
    context,
    cleanedDirName,
    (context, writer, key, file) ~>
      if (key == Ui.selectionProp) {
        items = getItems(context, false);
        itemsSet = SortedSet::createFromItems(items);
        writer.write(
          key,
          Items(Items::fromFile(file).value.filter(itemsSet.contains)),
        )
      } else {
        writer.write(key, file)
      }
    ,
  );
  _ = cleanedHdl.contextWriterKeyMap(
    f ~> f,
    context,
    SKFS.DirName::make(dirName, "events/"),
    (context, writer, key, file) ~>
      if (key == Ui.selectionProp) {
        selection = Items::fromFile(file).value;
        info.controller.onSelectionChange(context, selection);
        writer.write(key, file)
      }
    ,
  );
  selectionHdl = cleanedHdl.contextWriterKeyMap(
    SKFS.BoolFile::fromFile,
    context,
    SKFS.DirName::make(dirName, "selection/"),
    (_, writer, key, file) ~>
      if (key == Ui.selectionProp) {
        Items::fromFile(file).value.each(path ->
          writer.write(path, SKFS.BoolFile(true))
        )
      }
    ,
  );
  expansionHdl = cleanedHdl.contextWriterKeyMap(
    SKFS.BoolFile::fromFile,
    context,
    SKFS.DirName::make(dirName, "expansion/"),
    (_, writer, key, file) ~>
      if (key == Ui.expansionProp) {
        ItemsSet::fromFile(file).value.each(path ->
          writer.write(path, SKFS.BoolFile(true))
        )
      }
    ,
  );
  selection = (ctx, key) ~> selectionHdl.getBool(ctx, key);
  expansion = (ctx, key) ~> expansionHdl.getBool(ctx, key);
  current = ctx ~>
    cleanedHdl.maybeGetProp(ctx, Ui.currentProp, Ui.Path::fromFile);
  selectionArray = ctx ~>
    cleanedHdl.getProp(ctx, Ui.selectionProp, Items::fromFile, Items(Array[]))
      .value;
  (visibleItems, size, progress, badge) = create(
    context,
    path,
    allItemsDirName,
    controller,
    expansion,
  );
  Parameters(
    controller,
    HState(
      SKFS.toIHandle(stateHdl),
      visibleItems,
      size,
      selection,
      expansion,
      current,
      cleanedHdl,
      progress,
      badge,
      selectionArray,
    ),
  )
}

@debug
fun update(
  context: mutable SKFS.Context,
  _scope: String,
  values: mutable FWK.SMap<SKFS.BaseName, ?SKFS.File>,
  todo: Ui.Todo,
  optInfo: ?Info,
): void {
  execute(context, todo.command, values, optInfo.fromSome());
}

@debug
fun execute(
  context: mutable SKFS.Context,
  executable: Ui.Executable,
  values: mutable FWK.SMap<SKFS.BaseName, ?SKFS.File>,
  info: Info,
): void {
  expand = (path, expansion) -> {
    expansionSet = values
      .get(Ui.expansionProp)
      .map(ItemsSet::fromFile)
      .map(is -> is.value)
      .default(SortedSet[]);
    !expansionSet = if (expansion) {
      expansionSet.set(path)
    } else {
      expansionSet.remove(path)
    };
    values.set(Ui.expansionProp, Some(ItemsSet(expansionSet)))
  };
  toggleExpansion = path -> {
    expansionSet = values
      .get(Ui.expansionProp)
      .map(ItemsSet::fromFile)
      .map(is -> is.value)
      .default(SortedSet[]);
    !expansionSet = if (expansionSet.contains(path)) {
      expansionSet.remove(path)
    } else {
      expansionSet.set(path)
    };
    values.set(Ui.expansionProp, Some(ItemsSet(expansionSet)));
  };
  executable match {
  | Ui.Multiple(cmds) -> cmds.each(cmd -> execute(context, cmd, values, info))
  | Init() -> void
  | ManageScrolling(incr, _) ->
    values.set(Ui.ensureVisibleProp, Some(Ui.Incr(incr, context.tick)))
  | ManageVisible(visible) ->
    values.set(Ui.ensureVisibleProp, Some(Ui.Pos(visible, context.tick)))
  | ManageGoto(optTarget, _, _) ->
    target(values, Ui.currentProp, info.items(context), optTarget).each(
      index ->
        values.set(Ui.ensureVisibleProp, Some(Ui.Pos(index, context.tick)))
      ,
    )
  | ManageSelect(target, _, _) ->
    items = info.items(context);
    selection = Selection(
      values
        .get(Ui.selectionProp)
        .map(Items::fromFile)
        .map(is -> is.value)
        .default(Array[]),
      values.get(Ui.currentProp).map(Ui.Path::fromFile),
    );
    selectionModel = info.controller.getSelectionModel(context, true);
    target match {
    | SAll() -> !selection = selectionModel.selectAll(selection, items)
    | SClear() -> !selection = Selection(Array[], selection.optMain)
    | SPrevious() ->
      !selection = selectionModel.selectPrevious(selection, items, false)
    | SNext() -> !selection = selectionModel.selectNext(selection, items, false)
    | SFirst() ->
      items.maybeGet(0).each(path ->
        !selection = selectionModel.select(selection, path, items, false)
      )
    | SLast() ->
      items.maybeGet(items.size() - 1).each(path ->
        !selection = selectionModel.select(selection, path, items, false)
      )
    | SCurrent(toggle) ->
      selection.optMain.each(path ->
        !selection = selectionModel.select(selection, path, items, toggle)
      )
    | SPath(path, toggle) ->
      !selection = selectionModel.select(selection, path, items, toggle)
    | SToPath(path, keep) ->
      !selection = selectionModel.selectTo(selection, path, items, keep, None())
    | SToCurrent(keep) ->
      selection.optMain.each(path ->
        !selection = selectionModel.selectTo(
          selection,
          path,
          items,
          keep,
          None(),
        )
      )
    | SToFirst(keep) ->
      items.maybeGet(0).each(path ->
        !selection = selectionModel.selectTo(
          selection,
          path,
          items,
          keep,
          selection.optMain.flatMap(c -> items.indexOf(c)),
        )
      )
    | SToLast(keep) ->
      items.maybeGet(items.size() - 1).each(path ->
        !selection = selectionModel.selectTo(
          selection,
          path,
          items,
          keep,
          selection.optMain.flatMap(c -> items.indexOf(c)),
        )
      )
    | SToPrevious(keep) ->
      !selection = selectionModel.selectPrevious(selection, items, true, keep)
    | SToNext(keep) ->
      !selection = selectionModel.selectNext(selection, items, true, keep)
    };
    selection.optMain.flatMap(items.indexOf).each(index ->
      values.set(Ui.ensureVisibleProp, Some(Ui.Pos(index, context.tick)))
    );
    values.set(Ui.selectionProp, Some(Items(selection.multiple)));
    values.set(Ui.currentProp, selection.optMain)
  | ManageExpansion(path, expansion) -> expand(path, expansion)
  | ToggleExpansion(path) -> toggleExpansion(path)
  | ManageCurrentExpansion(expansion) ->
    values.get(Ui.currentProp).map(Ui.Path::fromFile).each(path ->
      expand(path, expansion)
    )
  | ToggleCurrentExpansion() ->
    values.get(Ui.currentProp).map(Ui.Path::fromFile).each(path ->
      toggleExpansion(path)
    )
  | Fire(optPath) ->
    optCurrent = if (optPath.isSome()) {
      optPath
    } else {
      values.get(Ui.currentProp).map(Ui.Path::fromFile)
    };
    fire = () -> {
      selection = values
        .get(Ui.selectionProp)
        .map(Items::fromFile)
        .map(is -> is.value)
        .default(Array[]);
      info.controller.onFire(context, optCurrent, selection);
    };
    optCurrent match {
    | Some(path) ->
      item = info.item(context, path);
      if (item.leaf) {
        fire()
      } else {
        toggleExpansion(path)
      }
    | _ -> fire()
    }
  | _ -> SKFS.cast_violation("UiTree.Executable", executable)
  }
}

fun target(
  values: mutable FWK.SMap<SKFS.BaseName, ?SKFS.File>,
  property: SKFS.BaseName,
  items: Array<Ui.Path>,
  optTarget: ?GTarget,
): ?Int {
  if (items.size() > 0) {
    optIndex = values.get(property).map(Ui.Path::fromFile).flatMap(current ->
      items.indexOf(current)
    );
    last = items.size() - 1;
    optTarget match {
    | Some(target) ->
      nIdx = target match {
      | GFirst() -> 0
      | GLast() -> last
      | GPrevious() -> optIndex.map(i -> i - 1).default(last)
      | GNext() -> optIndex.map(i -> i + 1).default(0)
      | GIndex(idx) -> idx
      };
      !nIdx = if (nIdx < 0) {
        last
      } else {
        nIdx % items.size()
      };
      values.set(property, Some(items[nIdx]));
      Some(nIdx)
    | _ ->
      values.set(property, None());
      None()
    }
  } else {
    values.set(property, None());
    None()
  }
}

module end;
