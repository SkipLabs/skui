module UiTreeItem;

const padding: Float = 8.0;
const expandIconSize: Float = 16.0;

base class Controller extends SKStore.UserData, SKStore.File {
  fun isAllowExpansion(context: mutable SKStore.Context): Bool;
  fun isExpanded(context: mutable SKStore.Context): Bool;
  fun isCurrent(context: mutable SKStore.Context): Bool;
  fun isSelected(context: mutable SKStore.Context): Bool;
  fun isFocused(context: mutable SKStore.Context): Bool;
  fun getText(context: mutable SKStore.Context): Text;
  fun getIcon(context: mutable SKStore.Context, fontSize: Float): ?Ui.Icon;
  fun getTooltip(context: mutable SKStore.Context): ?Text;
  fun getBadge(context: mutable SKStore.Context): ?Ui.Badge;
  fun getProgress(context: mutable SKStore.Context): ?Ui.Progress;
  fun getDepth(context: mutable SKStore.Context): Int;
  fun getContextMenuItems(
    context: mutable SKStore.Context,
  ): Array<UiDropdown.ItemBase>;

  fun onSelect(
    context: mutable SKStore.Context,
    toggle: Bool,
    keep: Bool,
  ): void;

  fun onFire(context: mutable SKStore.Context): void;

  fun onDrop(
    context: mutable SKStore.Context,
    source: Ui.Path,
    destination: Ui.Path,
    drop: Ui.Drop,
  ): void;
}

base class State {
  fun getArmed(context: mutable SKStore.Context): ?Bool;
  fun getHover(context: mutable SKStore.Context): ?Bool;
  fun getIndeterminate(context: mutable SKStore.Context): ?Int;
  fun getTargeted(context: mutable SKStore.Context): ?Ui.Drop;

  fun emitArmed(
    context: mutable SKStore.Context,
    expand: Bool,
    value: Bool,
  ): void;
  fun emitHover(
    context: mutable SKStore.Context,
    expand: Bool,
    value: Bool,
  ): void;
  fun emitIndeterminate(context: mutable SKStore.Context, value: Int): void;
  fun emitTargeted(context: mutable SKStore.Context, optDrop: ?Ui.Drop): void;

  fun emitAll(
    context: mutable SKStore.Context,
    close: Bool,
    armed: Bool,
    hover: Bool,
  ): void;
}

base class Storage {
  fun getName(): String;
  fun getScope(): String;

  fun setArmed(
    context: mutable SKStore.Context,
    expand: Bool,
    value: Bool,
  ): void;
  fun setHover(
    context: mutable SKStore.Context,
    expand: Bool,
    value: Bool,
  ): void;
  fun setTargeted(context: mutable SKStore.Context, optDrop: ?Ui.Drop): void;
  fun setIndeterminate(context: mutable SKStore.Context, optValue: ?Int): void;
}

class Parameters(
  reference: Ui.Path,
  id: Ui.Path,
  controller: Controller,
  state: State,
) extends Ui.Parameters {}

class Layout(
  label: (String, Geometry.Size, Font.FaceID),
  optBadge: ?(String, Geometry.Size, Font.FaceID),
  optIcon: ?(Ui.Icon, Geometry.Size),
  expandable: Bool,
  depth: Int,
  tab: Int,
  iconTextGap: Float,
) extends Ui.UserData {
  //
  fun computeSize(): Geometry.Size {
    bWidth = this.optBadge.map(badge ->
      if (badge.i0.isBlank()) {
        8.0
      } else {
        badge.i1.width.toFloat()
      }
    ).default(0.0);
    tWidth = this.label.i1.width.toFloat();
    tHeight = this.label.i1.height.toFloat();
    (width, height) = this.optIcon match {
    | Some((_, iSize)) ->
      (
        tWidth + bWidth + iSize.width + this.iconTextGap,
        Math.max(tHeight, iSize.height),
      )
    | _ -> (tWidth + bWidth, tHeight)
    };
    if (this.expandable) {
      !width = width + Math.ceil(this.iconTextGap / 2.0) + expandIconSize
    };
    tab = this.depth * this.tab;
    Geometry.Size(width + tab.toFloat() + 2.0 * padding, height + 2.0 * padding)
  }
}

module end;
