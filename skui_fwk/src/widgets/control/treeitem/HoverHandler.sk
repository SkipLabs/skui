module UiTreeItem;

class HoverHandler(
  path: Ui.Path,
  controller: Controller,
  state: State,
  expand: Bool,
) extends FWK.HoverHandler {
  fun getIdentifier(): Ui.Path {
    if (this.expand) this.path.makeChild("expand") else this.path;
  }

  fun enter(context: mutable SKFS.Context): void {
    this.state.emitHover(context, this.expand, true);
    FWKPointer.setCursor(context, Ui.HandCursor());
  }

  fun manage(
    context: mutable SKFS.Context,
    mouse: UiEvent.MouseFile,
    _optPrevious: ?FWK.HoverHandler,
  ): FWK.Result {
    FWK.Result(
      if (mouse.isPrimaryPressed(context.tick)) {
        this.state.emitArmed(context, this.expand, true);
        true
      } else if (
        mouse.isPrimaryReleased(context.tick) &&
        this.state.getArmed(context) == Some(this.expand)
      ) {
        this.state.emitArmed(context, this.expand, false);
        if (this.expand || mouse.getPrimaryClickCount() == 2) {
          this.controller.getFireMessages(context, true).each(message ->
            FWKMessage.emitMessage(context, message)
          )
        } else if (mouse.getPrimaryClickCount() == 1) {
          toggle = FWKKeys.isControlDown(context, true);
          keep = FWKKeys.isShiftDown(context, true);
          this.controller.getSelectMessages(context, toggle, keep, true).each(
            message -> FWKMessage.emitMessage(context, message),
          )
        };
        true
      } else {
        false
      },
    )
  }

  fun exit(context: mutable SKFS.Context): void {
    FWKPointer.resetCursor(context);
    this.state.emitAll(context, this.expand, false, false);
  }

  fun getTooltip(context: mutable SKFS.Context): ?FWK.SourcedWidget {
    if (!this.expand) {
      Ui.buildTooltip(context, this.path, this.controller.getTooltip)
    } else {
      None()
    }
  }

  fun getDropdown(_context: mutable SKFS.Context): ?FWK.SourcedWidget {
    Some(
      FWK.SourcedWidget(Some(this.path), (ctx, root) ~> {
        items = this.controller.getContextMenuItems(ctx);
        if (!items.isEmpty()) {
          Some(
            root.buildDropdown(
              ctx,
              this.path.makeChild("@treeContextMenu"),
              items,
            ),
          )
        } else {
          None()
        }
      }),
    );
  }
}

module end;
