module UiTreeItem;

const statePath: String = "ui/treeitem/state";

class HStorage(name: String, handle: SKStore.INotTyped) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKStore.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKStore.IHandle::notTyped(SKStore.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setArmed(
    context: mutable SKStore.Context,
    expand: Bool,
    value: Bool,
  ): void {
    this.handle.writeOrRemove(
      context,
      Ui.armedProp,
      if (value) Some(SKStore.BoolFile(expand)) else None(),
    )
  }

  fun setHover(
    context: mutable SKStore.Context,
    expand: Bool,
    value: Bool,
  ): void {
    this.handle.writeOrRemove(
      context,
      Ui.hoverProp,
      if (value) Some(SKStore.BoolFile(expand)) else None(),
    )
  }

  fun setIndeterminate(context: mutable SKStore.Context, optValue: ?Int): void {
    this.handle.writeOrRemove(
      context,
      Ui.indeterminateProp,
      optValue.map(v -> SKStore.IntFile(v)),
    )
  }

  fun setTargeted(context: mutable SKStore.Context, optDrop: ?Ui.Drop): void {
    this.handle.writeOrRemove(context, Ui.targetedProp, optDrop)
  }
}

class HState(
  stateDirName: SKStore.DirName,
  handle: SKStore.NotTyped,
) extends State {
  //
  fun getArmed(context: mutable SKStore.Context): ?Bool {
    this.handle.maybeGetBool(context, Ui.armedProp)
  }

  fun getHover(context: mutable SKStore.Context): ?Bool {
    this.handle.maybeGetBool(context, Ui.hoverProp)
  }

  fun getIndeterminate(context: mutable SKStore.Context): ?Int {
    this.handle.maybeGetInt(context, Ui.indeterminateProp)
  }

  fun getTargeted(context: mutable SKStore.Context): ?Ui.Drop {
    this.handle.maybeGetProp(context, Ui.targetedProp, f ~> f as Ui.Drop _)
  }

  fun emitArmed(
    context: mutable SKStore.Context,
    expand: Bool,
    value: Bool,
  ): void {
    this.emit(context, SetArmed(expand, value))
  }

  fun emitHover(
    context: mutable SKStore.Context,
    expand: Bool,
    value: Bool,
  ): void {
    this.emit(context, SetHover(expand, value))
  }

  fun emitIndeterminate(context: mutable SKStore.Context, value: Int): void {
    this.emit(context, SetIndeterminate(value))
  }

  fun emitTargeted(context: mutable SKStore.Context, optDrop: ?Ui.Drop): void {
    this.emit(context, SetTargeted(optDrop))
  }

  fun emitAll(
    context: mutable SKStore.Context,
    expand: Bool,
    armed: Bool,
    hover: Bool,
  ): void {
    this.emit(
      context,
      Multiple(Array[SetArmed(expand, armed), SetHover(expand, hover)]),
    )
  }

  private fun emit(
    context: mutable SKStore.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(context, statePath, this.stateDirName.toString(), command);
  }
}

fun init(
  context: mutable SKStore.Context,
  path: Ui.Path,
  controller: Controller,
): State {
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeNotTyped(dirName, Array[]);
  afterDirName = SKStore.DirName::make(dirName, "after/");
  afterHdl = stateHdl.map(
    k ~> k,
    f ~> f,
    context,
    afterDirName,
    (context, writer, key, it) ~> {
      file = it.first;
      if (key == Ui.indeterminateProp) {
        value = SKStore.IntFile::type(file).value;
        controller.getProgress(context) match {
        | Some(Ui.Indeterminate()) ->
          SKUIMessage.emit(
            context,
            statePath,
            dirName.toString(),
            SetIndeterminate((value + 1) % 4),
            false,
            Some(100),
          )
        | _ -> void
        };
        writer.set(key, file)
      } else {
        writer.set(key, file)
      }
    },
  );
  HState(dirName, afterHdl)
}

module end;
