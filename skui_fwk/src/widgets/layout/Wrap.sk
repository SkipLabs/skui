module UiWrap;

/** How Wrap should align objects. */
base class Alignment uses Hashable, Equality {
  children =
  /** Place the free space evenly between the objects. */
  | SpaceBetween()
  /**  Place the free space evenly between the children as well as half of that space before and after the first and last child. */
  | SpaceAround()
  /** Place the free space evenly between the children as well as before and after the first and last child. */
  | SpaceEvenly()
}

/** How the children should be placed along the cross axis in a flex layout. */
base class CrossAlignment extends Alignment {
  children =
  /**  Place the objects as close to the start (according direction) of the axis as possible. */
  | Start()
  /**  Place the objects as close to the end (according direction) of the axis as possible. */
  | End()
  /** Place the objects as close to the middle of the axis as possible. */
  | Center()
}

base class Controller extends Ui.WidgetsCollection {
  /** The direction to use as the main axis. */
  fun getDirection(context: mutable SKStore.Context): Ui.Axis;

  /** Determines the order to lay children out vertically and how to interpret `start` and `end` in the vertical direction. */
  fun getVerticalDirection(
    context: mutable SKStore.Context,
  ): Ui.VerticalDirection;

  /** Determines the order to lay children out horizontally and how to interpret `start` and `end` in the horizontal direction. */
  fun getHorizontalDirection(
    context: mutable SKStore.Context,
  ): Ui.HorizontalDirection;

  fun getMainAxisAlignment(context: mutable SKStore.Context): Alignment;

  fun getCrossAxisAlignment(context: mutable SKStore.Context): CrossAlignment;

  /** How the runs themselves should be placed in the cross axis. */
  fun getRunAlignment(context: mutable SKStore.Context): Alignment;

  /** How much space to place between children in a run in the main axis. */
  fun getSpacing(context: mutable SKStore.Context): Float;

  /** How much space to place between children in a run in the main axis. */
  fun getRunSpacing(context: mutable SKStore.Context): Float;
}

class LamController{
  direction: mutable SKStore.Context ~> Ui.Axis = _ctx ~> Ui.HorizontalAxis(),
  horizontalDirection: mutable SKStore.Context ~> Ui.HorizontalDirection = _ctx ~>
    Ui.ToRight(),
  verticalDirection: mutable SKStore.Context ~> Ui.VerticalDirection = _ctx ~>
    Ui.Down(),
  mainAxisAlignment: mutable SKStore.Context ~> Alignment = _ctx ~> Start(),
  crossAxisAlignment: mutable SKStore.Context ~> CrossAlignment = _ctx ~>
    Start(),
  runAlignment: mutable SKStore.Context ~> Alignment = _ctx ~> Start(),
  spacing: mutable SKStore.Context ~> Float = _ctx ~> 0.0,
  runSpacing: mutable SKStore.Context ~> Float = _ctx ~> 0.0,
  widgets: Ui.WidgetsCollection,
} extends Controller {
  //
  fun getDirection(context: mutable SKStore.Context): Ui.Axis {
    this.direction(context)
  }

  fun getHorizontalDirection(
    context: mutable SKStore.Context,
  ): Ui.HorizontalDirection {
    this.horizontalDirection(context)
  }

  fun getVerticalDirection(
    context: mutable SKStore.Context,
  ): Ui.VerticalDirection {
    this.verticalDirection(context)
  }

  fun getMainAxisAlignment(context: mutable SKStore.Context): Alignment {
    this.mainAxisAlignment(context)
  }

  fun getCrossAxisAlignment(context: mutable SKStore.Context): CrossAlignment {
    this.crossAxisAlignment(context)
  }

  fun getRunAlignment(context: mutable SKStore.Context): Alignment {
    this.runAlignment(context)
  }

  fun getSpacing(context: mutable SKStore.Context): Float {
    this.spacing(context)
  }

  fun getRunSpacing(context: mutable SKStore.Context): Float {
    this.runSpacing(context)
  }

  fun getSize(context: mutable SKStore.Context): Int {
    this.widgets.getSize(context)
  }

  fun getWidget(context: mutable SKStore.Context, index: Int): Ui.Widget {
    this.widgets.getWidget(context, index)
  }

  fun all(context: mutable SKStore.Context): Array<Ui.Widget> {
    this.widgets.all(context)
  }
}

class Parameters{
  controller: Controller,
  optFocusManager: ?Ui.FocusManager = None(),
  optDragHandler: ?Ui.Getter<?Ui.DragHandlerGetter> = None(),
  optDropHandler: ?Ui.Getter<?Ui.DropHandlerGetter> = None(),
  optHoverHandler: ?Ui.GetterOne<
    ?Ui.HoverHandlerGetter,
    Ui.Getter<?FWK.HoverHandler>,
  > = None(),
} extends Ui.Parameters {}

private value class RunMetrics(
  mainAxisExtent: Float,
  crossAxisExtent: Float,
  childCount: Int,
) uses Hashable, Equality {}

module end;

module Ui;

class Wrap protected {
  controller: UiWrap.Controller,
}
  extends
    StrictWidget,
    WithHoverHandler,
    WithDragHandler,
    WithDropHandler,
    WithFocusManager,


  uses WithNodeCache, WithViewports {
  //
  type Params = UiWrap.Parameters;
  type Buffer = NodeCache;

  fun getHoverHandler from WithHoverHandler;
  fun getDragHandler from WithDragHandler;
  fun getDropHandler from WithDropHandler;

  protected static fun make(
    context: mutable SKStore.Context,
    path: Ui.Path,
    params: UiWrap.Parameters,
    cache: NodeCache,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static{
      path,
      controller => params.controller,
      optFocusManager => params.optFocusManager,
      optDragHandler => params.optDragHandler,
      optDropHandler => params.optDropHandler,
      optHoverHandler => params.optHoverHandler,
      optConfiguration,
      cache,
      tick => context.tick,
    }
  }

  static fun createForController(
    context: mutable SKStore.Context,
    path: Ui.Path,
    controller: UiWrap.Controller,
    optConfiguration: ?Ui.Getter<Ui.Configuration> = None(),
  ): this {
    static::create(
      context,
      path,
      UiWrap.Parameters{controller},
      optConfiguration,
    )
  }

  protected fun getWidgets(context: mutable SKStore.Context): Array<Widget> {
    this.controller.all(context)
  }

  fun layout(
    context: mutable SKStore.Context,
    constraints: BoxConstraints,
  ): Node {
    direction = this.controller.getDirection(context);
    horizontalDirection = this.controller.getHorizontalDirection(context);
    verticalDirection = this.controller.getVerticalDirection(context);
    alignment = this.controller.getMainAxisAlignment(context);
    crossAlignment = this.controller.getCrossAxisAlignment(context);
    runAlignment = this.controller.getRunAlignment(context);
    spacing = this.controller.getSpacing(context);
    runSpacing = this.controller.getRunSpacing(context);
    elements = this.controller.all(context);
    mainAxisLimit = direction match {
    | Ui.HorizontalAxis() -> constraints.maxWidth()
    | Ui.VerticalAxis() -> constraints.maxHeight()
    };
    mainAxisExtent = 0.0;
    crossAxisExtent = 0.0;
    runMainAxisExtent = 0.0;
    runCrossAxisExtent = 0.0;
    childCount = 0;
    runs = 0;
    ccid = Ui.BoxConstraints::new();
    sizes = elements.map(child -> {
      rCcid = ccid;
      cNode = child.getNode(context, rCcid);
      if (this.getMainExtent(direction, cNode.size) > mainAxisLimit) {
        !rCcid = direction match {
        | Ui.HorizontalAxis() ->
          Ui.BoxConstraints::forWidth(0.0, constraints.maxWidth())
        | Ui.VerticalAxis() ->
          Ui.BoxConstraints::forHeight(0.0, constraints.maxHeight())
        };
        !cNode = child.getNode(context, rCcid);
      };
      childMainAxisExtent = this.getMainExtent(direction, cNode.size);
      childCrossAxisExtent = this.getCrossExtent(direction, cNode.size);
      if (
        childCount > 0 &&
        (runMainAxisExtent + spacing + childMainAxisExtent) > mainAxisLimit
      ) {
        !runs = runs + 1;
        !mainAxisExtent = Math.max(mainAxisExtent, runMainAxisExtent);
        !crossAxisExtent = crossAxisExtent + runCrossAxisExtent;
        !runMainAxisExtent = 0.0;
        !runCrossAxisExtent = 0.0;
        !childCount = 0;
      };
      !runMainAxisExtent = if (childCount > 0) {
        runMainAxisExtent + childMainAxisExtent + spacing;
      } else {
        runMainAxisExtent + childMainAxisExtent;
      };
      !runCrossAxisExtent = Math.max(runCrossAxisExtent, childCrossAxisExtent);
      !childCount = childCount + 1;
      (cNode, rCcid);
    });
    !mainAxisExtent = Math.max(mainAxisExtent, runMainAxisExtent);
    !crossAxisExtent =
      crossAxisExtent +
      runCrossAxisExtent +
      (runs.toFloat() * runSpacing);
    size = direction match {
    | Ui.HorizontalAxis() ->
      constraints.constrain(Geometry.Size(mainAxisExtent, crossAxisExtent))
    | Ui.VerticalAxis() ->
      constraints.constrain(Geometry.Size(crossAxisExtent, mainAxisExtent))
    };
    childArray = this.computeChildren(
      elements,
      size,
      sizes,
      direction,
      horizontalDirection,
      verticalDirection,
      alignment,
      crossAlignment,
      runAlignment,
      spacing,
      runSpacing,
    );
    Node(this, size, childArray);
  }

  //*************************************
  //* PRIVATES
  //*************************************

  private fun computeChildren(
    widgets: Array<Widget>,
    currentSize: Geometry.Size,
    sizes: Array<(Node, Ui.BoxConstraints)>,
    direction: Axis,
    horizontalDirection: Ui.HorizontalDirection,
    verticalDirection: Ui.VerticalDirection,
    alignment: UiWrap.Alignment,
    crossAlignment: UiWrap.CrossAlignment,
    runAlignment: UiWrap.Alignment,
    spacing: Float,
    runSpacing: Float,
  ): Array<NChild> {
    (mainAxisLimit, flipMainAxis, flipCrossAxis) = direction match {
    | Ui.HorizontalAxis() ->
      (
        currentSize.width,
        horizontalDirection == Ui.ToLeft(),
        verticalDirection == Ui.Up(),
      )
    | Ui.VerticalAxis() ->
      (
        currentSize.height,
        verticalDirection == Ui.Up(),
        horizontalDirection == Ui.ToLeft(),
      )
    };
    runMetrics = mutable Vector<UiWrap.RunMetrics>[];
    mainAxisExtent = 0.0;
    crossAxisExtent = 0.0;
    runMainAxisExtent = 0.0;
    runCrossAxisExtent = 0.0;
    childCount = 0;
    childArray = Array<?NChild>::mfill(sizes.size(), None());
    infos = mutable Vector<(Int, Geometry.Size, Int)>[];
    widgets.eachWithIndex((index, _child) -> {
      (childNode, _) = sizes.get(index);
      childSize = childNode.size;
      childMainAxisExtent = this.getMainExtent(direction, childSize);
      childCrossAxisExtent = this.getCrossExtent(direction, childSize);
      if (
        childCount > 0 &&
        (runMainAxisExtent + spacing + childMainAxisExtent) > mainAxisLimit
      ) {
        !mainAxisExtent = Math.max(mainAxisExtent, runMainAxisExtent);
        !crossAxisExtent = if (runMetrics.isEmpty()) {
          crossAxisExtent + runCrossAxisExtent;
        } else {
          crossAxisExtent + runCrossAxisExtent + runSpacing;
        };
        runMetrics.push(
          UiWrap.RunMetrics(runMainAxisExtent, runCrossAxisExtent, childCount),
        );
        !runMainAxisExtent = 0.0;
        !runCrossAxisExtent = 0.0;
        !childCount = 0;
      };
      !runMainAxisExtent = if (childCount > 0) {
        runMainAxisExtent + childMainAxisExtent + spacing;
      } else {
        runMainAxisExtent + childMainAxisExtent;
      };
      !runCrossAxisExtent = Math.max(runCrossAxisExtent, childCrossAxisExtent);
      !childCount = childCount + 1;
      infos.push((index, childSize, runMetrics.size()));
    });
    if (childCount > 0) {
      !mainAxisExtent = Math.max(mainAxisExtent, runMainAxisExtent);
      !crossAxisExtent = if (runMetrics.isEmpty()) {
        crossAxisExtent + runCrossAxisExtent;
      } else {
        crossAxisExtent + runCrossAxisExtent + runSpacing;
      };
      runMetrics.push(
        UiWrap.RunMetrics(runMainAxisExtent, runCrossAxisExtent, childCount),
      );
    };
    runCount = runMetrics.size();
    (containerMainAxisExtent, containerCrossAxisExtent) = direction match {
    | Ui.HorizontalAxis() -> (currentSize.width, currentSize.height)
    | Ui.VerticalAxis() -> (currentSize.height, currentSize.width)
    };
    crossAxisFreeSpace = Math.max(
      0.0,
      containerCrossAxisExtent - crossAxisExtent,
    );
    (runLeadingSpace, runBetweenSpace) = this.spaces(
      runAlignment,
      crossAxisFreeSpace,
      runCount,
    );
    !runBetweenSpace = runBetweenSpace + runSpacing;
    crossAxisOffset = if (flipCrossAxis) {
      containerCrossAxisExtent - runLeadingSpace
    } else {
      runLeadingSpace
    };
    i = 0;
    for (metrics in runMetrics) {
      mRunCrossAxisExtent = metrics.crossAxisExtent;
      mainAxisFreeSpace = Math.max(
        0.0,
        containerMainAxisExtent - metrics.mainAxisExtent,
      );
      (childLeadingSpace, childBetweenSpace) = this.spaces(
        alignment,
        mainAxisFreeSpace,
        metrics.childCount,
      );
      !childBetweenSpace = childBetweenSpace + spacing;
      childMainPosition = if (flipMainAxis) {
        containerMainAxisExtent - childLeadingSpace
      } else {
        childLeadingSpace
      };
      !crossAxisOffset = if (flipCrossAxis) {
        crossAxisOffset - mRunCrossAxisExtent;
      } else {
        crossAxisOffset;
      };
      for (tuple in infos) {
        (index, size, metric) = tuple;
        if (metric == i) {
          childMainAxisExtent = this.getMainExtent(direction, size);
          childCrossAxisExtent = this.getCrossExtent(direction, size);
          childCrossAxisOffset = this.getChildCrossOffset(
            crossAlignment,
            flipCrossAxis,
            mRunCrossAxisExtent,
            childCrossAxisExtent,
          );
          !childMainPosition = if (flipMainAxis) {
            childMainPosition - childMainAxisExtent;
          } else {
            childMainPosition;
          };
          offset = this.getOffset(
            direction,
            childMainPosition,
            crossAxisOffset + childCrossAxisOffset,
          );
          (childNode, childId) = sizes.get(index);
          childArray.set(index, Some(CNode(childNode, offset, childId)));
          !childMainPosition = if (flipMainAxis) {
            childMainPosition - childBetweenSpace;
          } else {
            childMainPosition + childMainAxisExtent + childBetweenSpace;
          };
        }
      };
      !crossAxisOffset = if (flipCrossAxis) {
        crossAxisOffset - runBetweenSpace;
      } else {
        crossAxisOffset + mRunCrossAxisExtent + runBetweenSpace;
      };
      !i = i + 1;
    };
    childArray.map(opt -> opt.fromSome());
  }

  private fun getCrossExtent(direction: Axis, size: Geometry.Size): Float {
    direction match {
    | Ui.HorizontalAxis() -> size.height
    | Ui.VerticalAxis() -> size.width
    }
  }

  private fun getMainExtent(direction: Axis, size: Geometry.Size): Float {
    direction match {
    | Ui.HorizontalAxis() -> size.width
    | Ui.VerticalAxis() -> size.height
    }
  }

  private fun getOffset(
    direction: Axis,
    mainAxisOffset: Float,
    crossAxisOffset: Float,
  ): Geometry.Offset {
    direction match {
    | Ui.HorizontalAxis() -> Geometry.Offset(mainAxisOffset, crossAxisOffset)
    | Ui.VerticalAxis() -> Geometry.Offset(crossAxisOffset, mainAxisOffset)
    }
  }

  private fun getChildCrossOffset(
    crossAlignment: UiWrap.CrossAlignment,
    flipCrossAxis: Bool,
    runCrossAxisExtent: Float,
    childCrossAxisExtent: Float,
  ): Float {
    freeSpace = runCrossAxisExtent - childCrossAxisExtent;
    crossAlignment match {
    | UiWrap.Start() ->
      if (flipCrossAxis) {
        freeSpace
      } else {
        0.0
      }
    | UiWrap.End() ->
      if (flipCrossAxis) {
        0.0
      } else {
        freeSpace
      }
    | UiWrap.Center() -> freeSpace / 2.0
    }
  }

  private fun spaces(
    alignment: UiWrap.Alignment,
    freeSpace: Float,
    count: Int,
  ): (Float, Float) {
    alignment match {
    | UiWrap.Start() -> (0.0, 0.0)
    | UiWrap.End() -> (freeSpace, 0.0)
    | UiWrap.Center() -> (freeSpace / 2.0, 0.0)
    | UiWrap.SpaceBetween() ->
      (
        0.0,
        if (count > 1) {
          freeSpace / (count - 1).toFloat()
        } else {
          0.0
        },
      )
    | UiWrap.SpaceAround() ->
      bs = freeSpace / count.toFloat();
      (bs / 2.0, bs)
    | UiWrap.SpaceEvenly() ->
      bs = freeSpace / (count + 1).toFloat();
      (bs, bs)
    };
  }
}

module end;
