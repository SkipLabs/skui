module UiProgress;

base class Controller extends Ui.Parameters {
  fun getProgress(context: mutable SKStore.Context): ?Int;
}

base class State {
  fun getIndeterminate(context: mutable SKStore.Context): ?Int;
  fun emitIndeterminate(context: mutable SKStore.Context, value: Int): void;
}

base class Storage {
  fun getName(): String;
  fun getScope(): String;

  fun setIndeterminate(context: mutable SKStore.Context, optValue: ?Int): void;
}

class Parameters(controller: Controller, state: State) extends Ui.Parameters {}

module end;
