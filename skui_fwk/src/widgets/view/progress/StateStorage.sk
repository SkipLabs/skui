module UiProgress;

const statePath: String = "ui/progress/state";

class HStorage(name: String, handle: SKFS.IHandle<SKFS.File>) extends Storage {
  //
  static fun forNameAndScope(
    context: readonly SKFS.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKFS.IHandle(SKFS.FileConverter(f ~> f), SKFS.DirName::create(scope));
    if (hdl.exists(context)) Some(HStorage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setIndeterminate(context: mutable SKFS.Context, optValue: ?Int): void {
    this.handle.writeOrRemove(
      context,
      Ui.indeterminateProp,
      optValue.map(v -> SKFS.IntFile(v)),
    )
  }
}

class HState(handle: SKFS.Handle<SKFS.File>) extends State {
  //
  fun getIndeterminate(context: mutable SKFS.Context): ?Int {
    this.handle.maybeGetInt(context, Ui.indeterminateProp)
  }

  fun emitIndeterminate(context: mutable SKFS.Context, value: Int): void {
    this.emit(context, SetIndeterminate(value))
  }

  private fun emit(
    context: mutable SKFS.Context,
    command: SKUIMessage.Command,
  ): void {
    SKUIMessage.emit(
      context,
      statePath,
      this.handle.getDirName().toString(),
      command,
    );
  }
}

fun init(context: mutable SKFS.Context, path: Ui.Path): State {
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeDir(f ~> f, dirName, Array[]);
  HState(stateHdl)
}

fun parameters(
  context: mutable SKFS.Context,
  path: Ui.Path,
  controller: Controller,
): Parameters {
  Parameters(controller, init(context, path))
}

module end;
