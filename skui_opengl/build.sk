module SkuiOpenglBuild;

@skui_build__source_dirs
fun source_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) Array["native/src"] else Array[]
}

@skui_build__include_dirs
fun include_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) Array["native/src/includes"] else Array[]
}

@skui_build__links
fun links(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) Array["-lGLEW", "-lGL", "-lGLU", "-lglut"] else Array[]
}

module end;

@debug
fun main(): void {
  SkuiBuild.build() match {
  | Failure(err) -> skipExit(err.code)
  | _ -> void
  }
}
