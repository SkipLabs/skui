fun uniformMatrix4(
  location: UniformLocation,
  transpose: Bool,
  matrix: Matrix4,
  ctx: UInt32,
): void {
  uniformMatrix4fv(
    location,
    transpose,
    matrix.matrix[0],
    matrix.matrix[1],
    matrix.matrix[2],
    matrix.matrix[3],
    matrix.matrix[4],
    matrix.matrix[5],
    matrix.matrix[6],
    matrix.matrix[7],
    matrix.matrix[8],
    matrix.matrix[9],
    matrix.matrix[10],
    matrix.matrix[11],
    matrix.matrix[12],
    matrix.matrix[13],
    matrix.matrix[14],
    matrix.matrix[15],
    ctx,
  );
}

module end;
