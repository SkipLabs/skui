  srcX: UInt32,
  srcY: UInt32,
  srcWidth: UInt32,
  srcHeight: UInt32,
  ref: TextureRef,
  dstX: UInt32,
  dstY: UInt32,
  width: UInt32,
  height: UInt32,
  reverted: Bool,
  ctx: UInt32,
): void;

@cpp_extern
private native fun bindTexture2D(texture: TextureRef, ctx: UInt32): void;
