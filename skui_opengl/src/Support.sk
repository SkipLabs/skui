module GL;

const webglPath: SKFS.DirName = SKFS.DirName::create("/ui/fwk/webgl/");
const webglProgramsPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/fwk/webgl/programs/",
);

const webglFilteredProgramsPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/fwk/webgl/programs/filtered/",
);

const webglComputedProgramsPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/fwk/webgl/programs/computed/",
);

const webglComputedBuffersPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/fwk/webgl/buffers/computed/",
);

const webglComputedArraysPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/fwk/webgl/arrays/computed/",
);
/*
trait GLKey {
  macro fun toString(): String {
    `${this.webgl}:${this.name}`
  }
}

class PrgKey(
  webgl: Int,
  name: String,
  builder: Ui.Builder,
) extends SKFS.BaseName uses GLKey {
  //
  fun toString from GLKey;

  fun hash(): Int {
    h = this.getClassName().hash();
    !h = Hashable.combine(h, this.webgl);
    Hashable.combine(h, this.name);
  }

  fun sameCompare(other: SKFS.FileName): Order {
    oKey = (other as PrgKey _);
    sComp = this.webgl.compare(oKey.webgl);
    if (sComp == EQ()) {
      this.name.compare(oKey.name);
    } else {
      sComp
    }
  }

  fun toPrgId(): PrgId {
    PrgId(this.webgl, this.name)
  }
}

