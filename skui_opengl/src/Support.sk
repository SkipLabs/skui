module SKUIGL;

const webglPath: SKFS.DirName = SKFS.DirName::create("/ui/fwk/webgl/");
const webglProgramsPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/skuigl/programs/",
);

const webglFilteredProgramsPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/skuigl/programs/filtered/",
);

const webglComputedProgramsPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/skuigl/programs/computed/",
);

const webglComputedBuffersPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/skuigl/buffers/computed/",
);

const webglComputedArraysPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/skuigl/arrays/computed/",
);

const layerHandlesPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/skuigl/layerHandles/",
);

const nodeHandlesPath: SKFS.DirName = SKFS.DirName::create(
  "/ui/skuigl/nodeHandles/",
);

base class DrawableSupport() extends Ui.DrawableSupport {
  fun init(
    context: mutable SKFS.Context,
    nodeDrawablesHdl: SKFS.EHandle<Ui.Drawables>
  ): (mutable SKFS.Context, readonly SKFS.Context ~> void) ~> void {
    webglHdl = context.makeDir(SKFS.IntFile::fromFile, webglPath, Array[]);
    /*context.setGlobal(
      "GL.GetContext",
      FWK.Ctx(ctx ~>
        webglHdl.maybeGet(ctx, Ui.MainKey()).map(v ->
          GL.Ctx(UInt32::truncate(v.value))
        )
      ),
    );
    wWebglHdl = SKFS.toIHandle(webglHdl);
    context.setGlobal(
      "GL.SetContext",
      FWK.SetCtx((ctx, optValue) ~>
        wWebglHdl.writeOrRemove(
          ctx,
          MainKey(),
          optValue.map(v -> SKFS.IntFile(v.toInt())),
        )
      ),
    );*/
    webglProgramsHdl = nodeDrawablesHdl.contextWriterKeyMap(
      f ~> f,
      context,
      webglProgramsPath,
      (context, writer, key, drawables) ~> {
        webglHdl.maybeGet(context, Ui.MainKey()).each(webgl -> {
          initializer = mutable GLProgram.Initializer();
          prepared = BDrawables(
            drawables.value.map(uiDrawable -> {
              drawable = uiDrawable as GLDrawable _;
              (drawable.prepare(initializer), drawable)
            }),
            drawables.optViewport,
          );
          writer.write(key, prepared);
          initializer.programs.each((k, v) ->
            writer.write(PrgKey(webgl.value, k, v), key)
          );
          initializer.buffers.each((k, v) ->
            writer.write(BufKey(webgl.value, k, v), key)
          );
          initializer.arrays.each((k, v) ->
            writer.write(ArrayKey(webgl.value, k, v), key)
          )
        })
      },
    );
    webglFilteredProgramsHdl = webglProgramsHdl.contextWriterKeyValues(
      f ~> f,
      context,
      webglFilteredProgramsPath,
      (_, writer, key, files) ~> {
        key match {
        | BufKey _
        | ArrayKey _
        | PrgKey _ ->
          if (!files.isEmpty()) {
            writer.write(key, SKFS.IntFile(0))
          }
        | _ -> files.maybeFirst().each(v -> writer.write(key, v))
        }
      },
    );
    webglComputedBuffersHdl = webglFilteredProgramsHdl.contextWriterKeyMap(
      GLProgram.Buffer::fromFile,
      context,
      webglComputedBuffersPath,
      (_, writer, key, _) ~> {
        key match {
        | bk @ BufKey _ ->
          ctx = GL.Ctx(UInt32::truncate(bk.webgl));
          buffer = bk.builder(ctx);
          bid = bk.toBufId();
          writer.write(bid, buffer)
        | _ -> void
        }
      },
    );
    webglComputedArraysHdl = webglFilteredProgramsHdl.contextWriterKeyMap(
      GLProgram.VertexArray::fromFile,
      context,
      webglComputedArraysPath,
      (context, writer, key, _) ~> {
        key match {
        | ak @ ArrayKey _ ->
          ctx = GL.Ctx(UInt32::truncate(ak.webgl));
          array = ak.builder(ctx);
          array.init(bufId ->
            webglComputedBuffersHdl.get(context, BufId(ak.webgl, bufId))
          );
          writer.write(ak.toArrayId(), array)
        | _ -> void
        }
      },
    );
    webglComputedProgramsHdl = webglFilteredProgramsHdl.contextWriterKeyMap(
      GLProgram.TriangleProgram::fromFile,
      context,
      webglComputedProgramsPath,
      (_, writer, key, _) ~> {
        key match {
        | pk @ PrgKey _ ->
          gl = GL.Ctx(UInt32::truncate(pk.webgl));
          writer.write(pk.toPrgId(), pk.builder(gl))
        | _ -> void
        }
      },
    );
    nodeHandlesHdl = webglFilteredProgramsHdl.contextWriterKeyMap(
      Ui.Handles::fromFile,
      context,
      nodeHandlesPath,
      (context, writer, key, file) ~> {
        key match {
        | kLayer @ Ui.KLayer _ ->
          drawables = BDrawables::fromFile(file);
          webglHdl.maybeGet(context, Ui.MainKey()).each(webgl -> {
            gl = GL.Ctx(UInt32::truncate(webgl.value));
            supplier = GLProgram.Supplier(name ~>
              SKFS.getWorkingContext().flatMap(ctx ->
                webglComputedProgramsHdl.maybeGet(ctx, PrgId(webgl.value, name))
              )
            );
            tmp = mutable Vector<Ui.Handle>[];
            drawables.value.each(drawable ->
              drawable.i0 match {
              | GLProgram.UBuffer(bufId) ->
                webglComputedBuffersHdl
                  .maybeGet(context, BufId(webgl.value, bufId))
                  .each(buffer ->
                    drawable.i1.build(gl, buffer, supplier).each(tmp.push)
                  )
              | GLProgram.UArray(arrId) ->
                webglComputedArraysHdl
                  .maybeGet(context, ArrayId(webgl.value, arrId))
                  .each(array ->
                    drawable.i1.build(gl, array, supplier).each(tmp.push)
                  )
              }
            );
            if (!tmp.isEmpty()) {
              writer.write(
                CtxLayer(webgl.value, kLayer),
                Ui.Handles(tmp.toArray(), drawables.optViewport),
              );
            }
          })
        | _ -> void
        }
      },
    );
    _ = nodeHandlesHdl.contextWriterKeyMap(
      Ui.Handles::fromFile,
      context,
      layerHandlesPath,
      (_context, writer, key, handles) ~> {
        ctxLayer = key as CtxLayer _;
        !ctxLayer.layer.path = handles.optViewport.fromSome();
        writer.write(ctxLayer, handles);
      },
    );
  }

  fun msdf(
    offset: Geometry.Offset,
    size: Geometry.Size,
    image: Ui.Image,
    conv: (Geometry.Rect, Float) ~> Geometry.Rect,
    pxRange: Int,
    thickness: Float,
    paint: Ui.Paint,
  ): Ui.Drawable;

  fun ellipse(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
  ): Ui.Drawable;

  fun disk(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    thickness: Float,
  ): Ui.Drawable;

  fun roundedRectangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    color: .Color,
    radius: Float,
    smooth: Int = 2,
    optBorder: ?(.Color, Int) = None(),
  ): Ui.Drawable;

  fun rectangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
  ): Ui.Drawable;

  fun diagonal(
    offset: Geometry.Offset,
    size: Geometry.Size,
    fromTopLeft: Bool,
    thickness: Float,
    color: .Color,
  ): Ui.Drawable;

  fun triangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    side: .UiSide,
  ): Ui.Drawable;

  fun progress(
    offset: Geometry.Offset,
    size: Geometry.Size,
    progress: Float,
    color1: .Color,
    color2: .Color,
    thickness: Float,
  ): Ui.Drawable;

  fun loading(
    offset: Geometry.Offset,
    size: Geometry.Size,
    color1: .Color,
    color2: .Color,
    step: Int,
  ): Ui.Drawable;

  fun image(
    offset: Geometry.Offset,
    size: Geometry.Size,
    picture: Ui.Picture,
  ): Ui.Drawable;

  fun boxShadow(
    offset: Geometry.Offset,
    size: Geometry.Size,
    sigma: Float,
    paint: Ui.Paint,
  ): Ui.Drawable;
}

trait Key {
  macro fun toString(): String {
    `${this.webgl}:${this.name}`
  }
}

class CtxLayer(ctxId: Int, layer: Ui.KLayer) extends SKFS.BaseName {
  fun toString(): String {
    `${this.ctxId}:${this.layer}`
  }

  fun sameCompare(other: SKFS.FileName): Order {
    oKey = (other as CtxLayer _);
    sComp = this.ctxId.compare(oKey.ctxId);
    if (sComp == EQ()) {
      this.layer.compare(oKey.layer);
    } else {
      sComp
    }
  }
}

class PrgKey(
  webgl: Int,
  name: String,
  builder: GLProgram.Builder,
) extends SKFS.BaseName uses Key {
  //
  fun toString from Key;

  fun hash(): Int {
    h = this.getClassName().hash();
    !h = Hashable.combine(h, this.webgl);
    Hashable.combine(h, this.name);
  }

  fun sameCompare(other: SKFS.FileName): Order {
    oKey = (other as PrgKey _);
    sComp = this.webgl.compare(oKey.webgl);
    if (sComp == EQ()) {
      this.name.compare(oKey.name);
    } else {
      sComp
    }
  }

  fun toPrgId(): PrgId {
    PrgId(this.webgl, this.name)
  }
}

class PrgId(webgl: Int, name: String) extends SKFS.BaseName {
  fun toString(): String {
    `${this.webgl}:${this.name}`
  }

  fun hash(): Int {
