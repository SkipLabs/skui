module SKUIGL;

const kAlwaysDraw: Bool = false;

const webglPath: SKStore.DirName = SKStore.DirName::create("/ui/fwk/webgl/");
const webglProgramsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/programs/",
);

const webglFilteredProgramsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/programs/filtered/",
);

const webglComputedProgramsPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/programs/computed/",
);

const webglComputedBuffersPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/buffers/computed/",
);

const webglComputedArraysPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/arrays/computed/",
);

const layerHandlesPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/layerHandles/",
);

const nodeHandlesPath: SKStore.DirName = SKStore.DirName::create(
  "/ui/skuigl/nodeHandles/",
);

const ctxHandle: SKStore.IHandle<Int> = SKStore.IHandle(
  SKStore.IntConverter(),
  webglPath,
);

class Useless()

@wasm_export("SKIP_SKUIGL_performFrame")
@cpp_export("SKIP_SKUIGL_performFrame")
fun performFrame(
  cid: UInt32,
  width: UInt32,
  height: UInt32,
  ratio: UInt32,
): void {
  pos = SKStore.newObstack();
  SKStore.Context::withoutGc(context ~>
    drawFrame(context, cid, width, height, ratio)
  );
  SKStore.destroyObstack(pos);
}

@wasm_export("SKIP_SKUIGL_setWindowContext")
@cpp_export("SKIP_SKUIGL_setWindowContext")
fun setWindowContext(window: UInt32, cid: UInt32): void {
  pos = SKStore.newObstack();
  win = window.toInt();
  key = if (win == 0) Ui.MainKey() else SKStore.IID(win);
  SKStore.Context::withoutGc(context ~>
    ctxHandle.write(context, key, cid.toInt())
  );
  SKStore.destroyObstack(pos);
}

class DrawableSupport(
  conv: (Ui.Picture, Bool) ~> ?GL.Texturable,
) extends Ui.DrawableSupport {
  fun init(
    context: mutable SKStore.Context,
    nodeDrawablesHdl: SKStore.EHandle<Ui.Drawables>,
  ): void {
    webglHdl = context.makeDir(SKStore.IntFile::type, webglPath, Array[]);
    webglProgramsHdl = nodeDrawablesHdl.map(
      f ~> f,
      context,
      webglProgramsPath,
      (context, writer, key, drawables) ~> {
        webglHdl.maybeGet(context, Ui.MainKey()).each(webgl -> {
          initializer = mutable GLProgram.Initializer();
          prepared = BDrawables(
            drawables.value.map(uiDrawable -> {
              drawable = uiDrawable as GLDrawable _;
              (drawable.prepare(initializer), drawable)
            }),
            drawables.optViewport,
          );
          writer.write(key, prepared);
          initializer.programs.each((k, v) ->
            writer.write(PrgKey(webgl.value, k, v), key)
          );
          initializer.buffers.each((k, v) ->
            writer.write(BufKey(webgl.value, k, v), key)
          );
          initializer.arrays.each((k, v) ->
            writer.write(ArrayKey(webgl.value, k, v), key)
          )
        })
      },
    );
    webglFilteredProgramsHdl = webglProgramsHdl.map(
      f ~> f,
      context,
      webglFilteredProgramsPath,
      (_, writer, key, files) ~> {
        key match {
        | BufKey _
        | ArrayKey _
        | PrgKey _ ->
          if (!files.isEmpty()) {
            writer.write(key, SKStore.IntFile(0))
          }
        | _ -> files.maybeFirst().each(v -> writer.write(key, v))
        }
      },
    );
    webglComputedBuffersHdl = webglFilteredProgramsHdl.map(
      GLProgram.Buffer::type,
      context,
      webglComputedBuffersPath,
      (_, writer, key, _) ~> {
        key match {
        | bk @ BufKey _ ->
          ctx = GL.Ctx(UInt32::truncate(bk.webgl));
          buffer = bk.builder(ctx);
          bid = bk.toBufId();
          writer.write(bid, buffer)
        | _ -> void
        }
      },
    );
    webglComputedArraysHdl = webglFilteredProgramsHdl.map(
      GLProgram.VertexArray::type,
      context,
      webglComputedArraysPath,
      (context, writer, key, _) ~> {
        key match {
        | ak @ ArrayKey _ ->
          ctx = GL.Ctx(UInt32::truncate(ak.webgl));
          array = ak.builder(ctx);
          array.init(bufId ->
            webglComputedBuffersHdl.get(context, BufId(ak.webgl, bufId))
          );
          writer.write(ak.toArrayId(), array)
        | _ -> void
        }
      },
    );
    webglComputedProgramsHdl = webglFilteredProgramsHdl.map(
      GLProgram.TriangleProgram::type,
      context,
      webglComputedProgramsPath,
      (_, writer, key, _) ~> {
        key match {
        | pk @ PrgKey _ ->
          gl = GL.Ctx(UInt32::truncate(pk.webgl));
          writer.write(pk.toPrgId(), pk.builder(gl))
        | _ -> void
        }
      },
    );
    nodeHandlesHdl = webglFilteredProgramsHdl.map(
      Ui.Handles::type,
      context,
      nodeHandlesPath,
      (context, writer, key, file) ~> {
        key match {
        | kLayer @ Ui.KLayer _ ->
          drawables = BDrawables::type(file);
          webglHdl.maybeGet(context, Ui.MainKey()).each(webgl -> {
            gl = GL.Ctx(UInt32::truncate(webgl.value));
            supplier = GLProgram.Supplier(name ~>
              SKStore.getWorkingContext().flatMap(ctx ->
                webglComputedProgramsHdl.maybeGet(ctx, PrgId(webgl.value, name))
              )
            );
            tmp = mutable Vector<Ui.Handle>[];
            drawables.value.each(drawable ->
              drawable.i0 match {
              | GLProgram.UBuffer(bufId) ->
                webglComputedBuffersHdl
                  .maybeGet(context, BufId(webgl.value, bufId))
                  .each(buffer ->
                    drawable.i1.build(gl, buffer, supplier).each(tmp.push)
                  )
              | GLProgram.UArray(arrId) ->
                webglComputedArraysHdl
                  .maybeGet(context, ArrayId(webgl.value, arrId))
                  .each(array ->
                    drawable.i1.build(gl, array, supplier).each(tmp.push)
                  )
              }
            );
            if (!tmp.isEmpty()) {
              writer.write(
                CtxLayer(webgl.value, kLayer),
                Ui.Handles(tmp.toArray(), drawables.optViewport),
              );
            }
          })
        | _ -> void
        }
      },
    );
    _ = nodeHandlesHdl.map(
      Ui.Handles::type,
      context,
      layerHandlesPath,
      (_, writer, key, handles) ~> {
        ctxLayer = key as CtxLayer _;
        !ctxLayer.layer.path = handles.optViewport.fromSome();
        writer.write(ctxLayer, handles);
      },
    );
  }

  fun ellipse(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
  ): Ui.Drawable {
    paint match {
    | color @ .Color _ ->
      GLDrawable.SolidEllipse(
        color,
        0.5,
        Geometry.Rect::fromOffsetSize(offset, size),
      )
    | _ -> invariant_violation("Not implemented; only Color Fill managed")
    }
  }

  fun disk(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    thickness: Float,
  ): Ui.Drawable {
    paint match {
    | color @ .Color _ ->
      GLDrawable.SolidDisk(
        color,
        thickness,
        0.5,
        Geometry.Rect::fromOffsetSize(offset, size),
      )
    | _ -> invariant_violation("Not implemented; only Color Fill managed")
    }
  }

  fun roundedRectangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    color: .Color,
    radius: Float,
    smooth: Float = 2.0,
    optBorder: ?Ui.Border = None(),
  ): Ui.Drawable {
    GLDrawable.RoundedRectangle(
      color,
      radius,
      smooth,
      optBorder,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun rectangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
  ): Ui.Drawable {
    GLDrawable.rectangle(offset, size, paint)
  }

  fun diagonal(
    offset: Geometry.Offset,
    size: Geometry.Size,
    fromTopLeft: Bool,
    thickness: Float,
    color: .Color,
  ): Ui.Drawable {
    GLDrawable.diagonal(offset, size, fromTopLeft, thickness, color)
  }

  fun triangle(
    offset: Geometry.Offset,
    size: Geometry.Size,
    paint: Ui.Paint,
    side: .UiSide,
  ): Ui.Drawable {
    GLDrawable.triangle(offset, size, paint, side)
  }

  fun progress(
    offset: Geometry.Offset,
    size: Geometry.Size,
    progress: Float,
    color1: .Color,
    color2: .Color,
    thickness: Float,
  ): Ui.Drawable {
    GLDrawable.Progress(
      progress,
      color1,
      color2,
      thickness,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun loading(
    offset: Geometry.Offset,
    size: Geometry.Size,
    color1: .Color,
    color2: .Color,
    step: Int,
  ): Ui.Drawable {
    GLDrawable.Loading(
      color1,
      color2,
      step,
      Geometry.Rect::fromOffsetSize(offset, size),
    )
  }

  fun boxShadow(
    offset: Geometry.Offset,
    size: Geometry.Size,
    sigma: Float,
    paint: Ui.Paint,
  ): Ui.Drawable {
    paint match {
    | color @ .Color _ ->
      GLDrawable.BoxShadow(
        sigma,
        color,
        Geometry.Rect::fromOffsetSize(offset, size),
      )
    | _ -> invariant_violation("Not implemented; only Color Fill managed")
    }
  }

  fun image(
    offset: Geometry.Offset,
    size: Geometry.Size,
    picture: Ui.Picture,
  ): Ui.Drawable {
    GLDrawable.Bilinear::create(
      ctx ~> this.conv(picture, true).map(t -> t.asTexture(ctx)),
      offset,
      size,
    )
  }

  fun msdf(
    offset: Geometry.Offset,
    size: Geometry.Size,
    picture: Ui.Picture,
    conv: Geometry.Rect ~> Geometry.Rect,
    pxRange: Int,
    thickness: Float,
    paint: Ui.Paint,
  ): Ui.Drawable {
    paint match {
    | color @ .Color _ ->
      GLDrawable.Msdf::create(
        ctx ~> this.conv(picture, true).map(t -> t.asTexture(ctx)),
        conv,
        pxRange,
        color,
        thickness,
        offset,
        size,
      )
    | _ -> invariant_violation("Not implemented; only Color Fill managed")
    }
  }
}

trait Key {
  macro fun toString(): String {
    `${this.webgl}:${this.name}`
  }
}

class CtxLayer(ctxId: Int, layer: Ui.KLayer) extends SKStore.BaseName {
  fun toString(): String {
    `${this.ctxId}:${this.layer}`
  }
}

class PrgKey(
  webgl: Int,
  name: String,
  builder: GLProgram.Builder,
) extends SKStore.BaseName uses Key {
  //
  fun toString from Key;

  fun hash(): Int {
    h = this.getClassName().hash();
    !h = Hashable.combine(h, this.webgl);
    Hashable.combine(h, this.name);
  }

  fun compare(other: SKStore.BaseName): Order {
    other match {
    | oKey @ PrgKey _ ->
      (this.webgl, this.name).compare((oKey.webgl, oKey.name))
    | _ -> this.getClassName().compare(other.getClassName())
    }
  }

  fun toPrgId(): PrgId {
    PrgId(this.webgl, this.name)
  }
}

class PrgId(webgl: Int, name: String) extends SKStore.BaseName {
  fun toString(): String {
    `${this.webgl}:${this.name}`
  }

  fun hash(): Int {
    h = this.getClassName().hash();
    !h = Hashable.combine(h, this.webgl);
    Hashable.combine(h, this.name);
  }
}

