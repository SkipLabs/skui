class BDrawables(
  value: Array<(GLProgram.Used, GLDrawable)>,
  optViewport: ?Ui.Path,
) extends SKFS.File {
  //
  static fun fromFile(obj: SKFS.File): this {
    obj match {
    | x @ BDrawables _ -> x
    | _ -> invariant_violation("Must be SKUIGL.BDrawables")
    }
  }
}

@debug
fun populateViewport(
  gl: GL.Ctx,
  viewport: Ui.NViewport,
  handles: Array<Array<Ui.Handles>>,
  height: Int,
): void {
  top = height - viewport.window.height() - viewport.window.top();
  gl.save();
  gl.enableBlend();
  gl.srcAlphaBlendOneMinus();
  gl.viewport(
    Int32::truncate(viewport.window.left()),
    Int32::truncate(top),
    UInt32::truncate(viewport.window.width()),
    UInt32::truncate(viewport.window.height()),
  );
  fOffset = Ui.Shift(viewport.offset.x, viewport.offset.y);
  fWindow = viewport.window;
  handles.each(hdls ->
    hdls.each(v ->
      v.value.each(handle -> handle.draw(fOffset, fWindow, height))
    )
  );
  gl.flush();
  gl.restore();
}

@debug
fun drawFrame(
  context: mutable SKFS.Context,
  _width: UInt32,
  _height: UInt32,
): void {
  optVersion = context
    .getGlobal("SKUIGL.Version")
    .map(SKFS.IntFile::fromFile)
    .map(f -> f.value);
  frame = context
    .getGlobal("SKUIGL.AnimationFrame")
    .map(SKFS.IntFile::fromFile)
    .map(f -> f.value + 1)
    .default(0);
  context.setGlobal("SKUIGL.AnimationFrame", SKFS.IntFile(frame));
  optDrawTick = getDrawTick(context);
  optDrawTick match {
  | Some(tick) if (!optVersion.map(v -> tick.value <= v).default(false)) ->
    todo("Get current context to draw")
  /*
  optGetContext = context.getGlobal("GL.GetContext").map(GL.Ctx::fromFile);
  optGetContext.each(gtctx -> {
    optGLContext = gtctx.value(context);
    optGLContext.each(gl -> drawCtxFrame(context, gl, width, height, tick.value))
  })*/
  | _ -> void
  };
}

@debug
fun drawCtxFrame(
  context: mutable SKFS.Context,
  ctx: GL.Ctx,
  width: UInt32,
  height: UInt32,
  time: Int,
): void {
  ctx.bindMainFrameBuffer();
  ctx.enableBlend();
  ctx.straitAlphaBlending();
  ctx.viewport(Int32::truncate(0), Int32::truncate(0), width, height);
  ctx.clearColor(1.0, 1.0, 1.0, 1.0);
  ctx.clear();
  drawViewports(ctx, context, width.toInt(), height.toInt());
  context.setGlobal("SKUIGL.Version", SKFS.IntFile(time));
}

fun drawViewports(
  gl: GL.Ctx,
  context: mutable SKFS.Context,
  width: Int,
  height: Int,
): void {
  doOnDirectory(context, Ui.viewportsPath, viewportsDir ->
    doOnDirectory(context, layerHandlesPath, layerHandlesDir ->
      doOnDirectory(context, Ui.vpInfosPath, vpInfosDir -> {
        viewportDef = getValue(
          viewportsDir,
          Ui.MainKey(),
          Ui.ViewportDefinition::forFile,
        );
        drawViewport(
          gl,
          context,
          viewportDef,
          Ui.NViewport(
            Geometry.Point(0, 0),
            Geometry.Rectangle(
              Geometry.Point(0, 0),
              Geometry.Point(width, height),
            ),
          ),
          width,
          height,
          layerHandlesDir,
          vpInfosDir,
        );
      })
    )
  )
}

fun drawViewport(
  gCtx: GL.Ctx,
  context: mutable SKFS.Context,
  viewportDef: Ui.ViewportDefinition,
  absolute: Ui.NViewport,
  width: Int,
  height: Int,
  layerHandlesDir: SKFS.EagerDir,
  vpInfosDir: SKFS.EagerDir,
): void {
  vpPath = viewportDef.path;
  if (viewportDef.hasContent()) {
    viewport = getValue(vpInfosDir, vpPath, Ui.NViewport::fromFile);
    currentBounds = viewport.window.translate(absolute.window.min);
    visibleBounds = currentBounds.intersect(absolute.window);
    if (!visibleBounds.isEmpty()) {
      ctxId = gCtx.id.toInt();
      diff = (currentBounds.min - visibleBounds.min);
      toPopulate = Ui.NViewport(viewport.offset + diff, visibleBounds);
      layerHandles = Array[
        CtxLayer(ctxId, Ui.KLayer(vpPath, Ui.BackgroundLayer())),
        CtxLayer(ctxId, Ui.KLayer(vpPath, Ui.MainLayer())),
        CtxLayer(ctxId, Ui.KLayer(vpPath, Ui.ForegroundLayer())),
      ].map(key -> getValues(layerHandlesDir, key, Ui.Handles::fromFile));
      populateViewport(gCtx, toPopulate, layerHandles, height);
      !absolute = Ui.NViewport(diff, visibleBounds);
    }
  };
  viewportDef.getChildren().each(def ->
    drawViewport(
      gCtx,
      context,
      def,
      absolute,
      width,
      height,
      layerHandlesDir,
      vpInfosDir,
    )
  )
}

fun doOnDirectory(
  context: mutable SKFS.Context,
  dirName: SKFS.DirName,
  todo: SKFS.EagerDir -> void,
  ignore: Bool = true,
): void {
  context.unsafeMaybeGetEagerDir(dirName) match {
  | Some(dir) -> todo(dir)
  | _ ->
    if (!ignore) {
      invariant_violation(`${dirName} must be defined.`)
    }
  };
}

fun getOnDirectory<T>(
  context: mutable SKFS.Context,
  dirName: SKFS.DirName,
  todo: SKFS.EagerDir -> T,
  ignore: Bool = true,
): ?T {
  context.unsafeMaybeGetEagerDir(dirName) match {
  | Some(dir) -> Some(todo(dir))
  | _ ->
    if (!ignore) {
      invariant_violation(`${dirName} must be defined.`)
    };
    None()
  };
}

fun getDrawTick(context: mutable SKFS.Context): ?SKFS.Tick {
  optContraintsTick = getOnDirectory(
    context,
    Ui.constraintsPath,
    constraintsDir -> constraintsDir.getLastTick(),
  );
  optHandlesTick = getOnDirectory(context, layerHandlesPath, handlesDir ->
    handlesDir.getLastTick()
  );
  (optContraintsTick, optHandlesTick) match {
  | (None(), None())
  | (Some(None()), None())
  | (None(), Some(None()))
  | (Some(None()), Some(None())) ->
    None()
  | (Some(Some(ct)), Some(Some(ht))) -> Some(Math.max(ct, ht))
  | (Some(Some(tick)), _)
  | (_, Some(Some(tick))) ->
    Some(tick)
  }
}

fun getValue<T: frozen>(
  dir: SKFS.EagerDir,
  key: SKFS.BaseName,
  conv: SKFS.File ~> T,
): T {
  conv(dir.getArrayRaw(key).first())
}

fun maybeGetValue<T: frozen>(
  dir: SKFS.EagerDir,
  key: SKFS.BaseName,
  conv: SKFS.File ~> T,
): ?T {
  vs = getValues(dir, key, conv);
  if (vs.isEmpty()) {
    None()
  } else {
    Some(vs.first())
  }
}

fun getValues<T: frozen>(
  dir: SKFS.EagerDir,
  key: SKFS.BaseName,
  conv: SKFS.File ~> T,
): Array<T> {
  dir.getArrayRaw(key).map(conv)
}

@wasm_export
@cpp_export("SKIP_SKUIGL_drawAnimationFrame")
fun drawAnimationFrame(width: UInt32, height: UInt32): void {
  pos = SKFS.newObstack();
  SKFS.Context::withoutGc(context ~>
    drawFrame(context, width.toInt(), height.toInt())
  );
  SKFS.destroyObstack(pos);
}

module end;
