module GLDrawable;

class Loading(
  color1: .Color,
  color2: .Color,
  step: Int,
) extends GLRectangleDrawable {
  //
  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.loading();
  }

  fun build(
    _gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    buffer = data as GLProgram.Buffer _;
    supplier.loading().map(drawer ->
      Ui.LambdaHandle((shift, window, _height) ~> {
        rect = this.bounds.shift(shift.toOffset());
        drawer.run(
          GLProgram.LoadingParameters(
            rect,
            this.step,
            this.color1,
            this.color2,
          ),
          GLProgram.RectangleParameters(rect, buffer),
          window.size(),
        )
      })
    )
  }
}

class Progress(
  progress: Float,
  color1: .Color,
  color2: .Color,
  thickness: Float,
) extends GLRectangleDrawable {
  //
  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.progress();
  }

  fun build(
    _gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    buffer = data as GLProgram.Buffer _;
    supplier.progress().map(drawer ->
      Ui.LambdaHandle((shift, window, _height) ~> {
        rect = this.bounds.shift(shift.toOffset());
        drawer.run(
          GLProgram.ProgressParameters(
            rect,
            this.color1,
            this.color2,
            this.thickness,
            this.progress,
          ),
          GLProgram.RectangleParameters(rect, buffer),
          window.size(),
        )
      })
    )
  }
}

module end;
