module GLDrawable;

class Bilinear(texture: GL.Ctx ~> ?GL.Texture) extends GLRectangleDrawable {
  //
  static fun create(
    texture: GL.Ctx ~> ?GL.Texture,
    offset: Geometry.Offset,
    size: Geometry.Size,
  ): this {
    static(texture, Geometry.Rect::fromOffsetSize(offset, size))
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.billinear();
  }

  fun build(
    gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    array = data as GLProgram.VertexArray _;
    supplier.bilinearDrawer().flatMap(drawer -> {
      this.texture(gl).map(texture -> {
        Ui.LambdaHandle((shift, window, _height) ~> {
          bounds = this.bounds.shift(shift.toOffset());
          drawer.run(
            GLProgram.TextureParameters(texture),
            GLProgram.BoundsParameters(bounds, array),
            window.size(),
          )
        })
      })
    })
  }
}

class Msdf(
  texture: GL.Ctx ~> ?GL.Texture,
  pxRange: Int,
  color: .Color,
  thickness: Float,
) extends GLRectangleDrawable {
  //
  static fun create(
    texture: GL.Ctx ~> ?GL.Texture,
    conv: Geometry.Rect ~> Geometry.Rect,
    pxRange: Int,
    color: .Color,
    thickness: Float,
    offset: Geometry.Offset,
    size: Geometry.Size,
  ): this {
    static(
      texture,
      pxRange,
      color,
      thickness,
      conv(Geometry.Rect::fromOffsetSize(offset, size)),
    )
  }

  fun prepare(initializer: mutable GLProgram.Initializer): GLProgram.Used {
    initializer.msdf();
  }

  fun build(
    gl: GL.Ctx,
    data: GLProgram.Data,
    supplier: GLProgram.Supplier,
  ): ?Ui.Handle {
    array = data as GLProgram.VertexArray _;
    supplier.msdfDrawer().flatMap(drawer ->
      this.texture(gl).map(texture ->
        Ui.LambdaHandle((shift, window, _height) ~> {
          drawer.run(
            GLProgram.MsdfParameters(
              texture,
              this.pxRange,
              this.color,
              this.thickness,
            ),
            GLProgram.BoundsParameters(
              this.bounds.shift(shift.toOffset()),
              array,
            ),
            window.size(),
          )
        })
      )
    )
  }
}

module end;
