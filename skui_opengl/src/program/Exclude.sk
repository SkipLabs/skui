module GLProgram;

const excludeFramentShader: String = source(
  Array[
    "precision highp float;",
    "varying vec2 v_position;",
    "uniform sampler2D u_texture1;",
    "uniform sampler2D u_texture2;",
    "void main(){",
    "  vec4 col1 = texture2D(u_texture1, v_position);",
    "  vec4 col2 = texture2D(u_texture2, v_position);",
    "  float alpha = abs(col1.a - col2.a);",
    "  float max = max(col1.a, col2.a);",
    "  float t = (col2.a <= 0.0) ?  0.0 : col2.a / max;",
    "  gl_FragColor = vec4(mix(col1.r, col2.r, t), mix(col1.g, col2.g, t), mix(col1.b, col2.b, t), alpha);",
    "}",
    "",
  ],
);

@debug
fun activateTexture(
  gl: GL.Ctx,
  chanel: Int,
  texture: GL.Texture,
  location: GL.UniformLocation,
): void {
  index = UInt32::truncate(chanel);
  gl.activeTexture(index);
  texture.bind();
  gl.uniform1i(location, index);
}

class ExcludeParameters(
  texture1: GL.Texture,
  texture2: GL.Texture,
) extends Parameters {
  static fun fromParams(obj: Parameters): this {
    obj match {
    | x @ ExcludeParameters _ -> x
    | _ ->
      invariant_violation(
        `Must be GLProgram.ExcludeParameters got ${obj.getClassName()}`,
      )
    }
  }
}

class ExcludeShader() extends FragmentShaderBuilder {
  fun source(): String {
    excludeFramentShader
  }

  fun build(program: GL.Prepared): FragmentShader {
    texture1Location = program.getUniformLocation(uTexture1);
    texture2Location = program.getUniformLocation(uTexture2);
    LambdaFragmentShader(parameters ~> {
      gl = program.context();
      eps = ExcludeParameters::fromParams(parameters);
      activateTexture(gl, 0, eps.texture1, texture1Location);
      activateTexture(gl, 1, eps.texture2, texture2Location);
    });
  }
}

module end;
