      "  vec4 info = texture(mtsdf.texture, position);",
      "  float msd = info.rgb + clamp(mtsdfthickness, -0.5, 0.5);",
      "  float sd = clamp(median(msd.r, msd.g, msd.b), 0.0, 255.0);",
      "  float distance = pxRange(mtsdf.tex, position, mtsdf.range) * (sd - 0.5);",
      "  return clamp(distance - 0.5, 0.0, 1.0);",
      "}",
    ],
  )
}

@test
fun errorApprox4Fn(): void {
  errorApprox = GLSL.errorApproxFn(4);
  got = toArray(errorApprox);
  debug(got);
  T.expectEq(
    got,
    Array[
      "vec4 errorApprox4(vec4 x) {",
      "  vec4 s = sign(x), a = abs(x);",
      "  x = 1.0 + (0.278393 + (0.230389 + 0.078108 * (a * a)) * a) * a;",
      "  x *= x;",
      "  return s - s / (x * x);",
      "}",
    ],
  )
}

@test
fun boxShadow(): void {
  boxShadow = GLSL.boxShadowFn();
  got = toArray(boxShadow);
  debug(got);
  T.expectEq(
    got,
    Array[
      "float boxShadow(vec2 upper, vec2 lower, vec2 position, float sigma) {",
      "  vec4 query = vec4(position - lower, position - upper);",
      "  vec4 integral = 0.5 + (0.5 * errorApprox4(query * (sqrt(0.5) / sigma)));",
      "  return (integral.z - integral.x) * (integral.w - integral.y);",
      "}",
    ],
  )
}

