@test
fun testPlaneNornal(): void {
  p1 = GLSL.VVec(Array[0.0, 0.0, 0.0]);
  p2 = GLSL.VVec(Array[1.0, 0.0, 0.0]);
  p3 = GLSL.VVec(Array[1.0, 1.0, 1.0]);
  res = GLSL.planeNornal(p1, p2, p3);
  nornal = res.toSize(3);
  got1 = Array[p1.dot(nornal), p2.dot(nornal), p3.dot(nornal)];
  debug(got1);
  T.expectEq(got1, Array[res.w(), res.w(), res.w()]);
  z1 = -(nornal.x() * 0.5 + nornal.y() * 0.5) / nornal.z();
  z2 = -(nornal.x() * 0.0 + nornal.y() * 0.5) / nornal.z();
  debug((z1, z2));
  T.expectEq((z1, z2), (0.5, 0.5));
  sign = Math.sign(nornal.z());
  normalized = nornal.normalize();
  p0 = GLSL.VVec(Array[0.5, 0.5, z1]);
  light0 = (GLSL.VVec(Array[0.7, 0.5, 5.0]) - p0).normalize();
  dot0 = sign.toFloat() * normalized.dot(light0);
  cosTeta0 = Math.max(dot0, 0.0);
  debug((light0, normalized, dot0, cosTeta0));
  T.expectEq(cosTeta0, 0.706409437);
}

