@test
fun testLinearGradient(): void {
  function = GLSL.linearGradientFn(3, 4);
  got = toArray(function);
  debug(got);
  T.expectEq(
    got,
    Array[
      "vec4 linearGradient3_4(vec2 position, vec4 start_end, vec4 colors[4], float offsets[3]) {",
      "  float len = length(start_end.zw - start_end.xy);",
      "  float ac = length(position - start_end.xy);",
      "  float bc = length(position - start_end.zw);",
      "  float distance = -((bc * bc) - (ac * ac) - (len * len)) / (2.0 * len);",
      "  float t = distance / len;",
      "  float tlen, ct;",
      "  if (distance >= len * offsets[2]) {",
      "    return colors[2];",
      "  }",
      "  if (distance >= len * offsets[1]) {",
      "    tlen = offsets[2] - offsets[1];",
      "    ct = (t - offsets[1]) / tlen;",
      "    return mix(colors[1], colors[2], ct);",
      "  }",
      "  if (distance >= len * offsets[0]) {",
      "    tlen = offsets[1] - offsets[0];",
      "    ct = (t - offsets[0]) / tlen;",
      "    return mix(colors[0], colors[1], ct);",
      "  }",
      "  return colors[0];",
      "}",
    ],
  )
}

@test
fun testRadialGradient(): void {
  function = GLSL.radialGradientFn(3, 3);
  got = toArray(function);
  debug(got);
  T.expectEq(
    got,
    Array[
      "vec4 radialGradient3(vec2 position, CenterRadius2 ellipse, vec4 colors[3], float offsets[3]) {",
      "  float x = position.x - ellipse.center.x;",
      "  float y = position.y - ellipse.center.y;",
      "  vec2 radius2 = ellipse.radius * offsets[2];",
      "  if(radius2.x == 0.0 || radius2.y == 0.0) {",
      "    return colors[2];",
      "  }",
      "  float e2 = ((x * x) / (radius2.x * radius2.x)) + ((y * y) / (radius2.y * radius2.y));",
      "  if(e2 >= 1.0) {",
      "    return colors[2];",
      "  }",
      "  vec2 radius1 = ellipse.radius * offsets[1];",
      "  if(radius1.x == 0.0 || radius1.y == 0.0) {",
      "    return mix(colors[1], colors[2], e2);",
      "  }",
      "  float e1 = ((x * x) / (radius1.x * radius1.x)) + ((y * y) / (radius1.y * radius1.y));",
      "  if(e1 >= 1.0) {",
      "    e2 = (radius2.x * radius2.x) / (radius1.x * radius1.x);",
      "    return mix(colors[1], colors[2], (e1 - 1.0) / (e2 - 1.0));",
      "  }",
      "  vec2 radius0 = ellipse.radius * offsets[0];",
      "  if(radius0.x == 0.0 || radius0.y == 0.0) {",
      "    return mix(colors[0], colors[1], e1);",
      "  }",
      "  float e0 = ((x * x) / (radius0.x * radius0.x)) + ((y * y) / (radius0.y * radius0.y));",
      "  if(e0 >= 1.0) {",
      "    e1 = (radius1.x * radius1.x) / (radius0.x * radius0.x);",
      "    return mix(colors[0], colors[1], (e0 - 1.0) / (e1 - 1.0));",
      "  }",
      "  return colors[0];",
      "}",
    ],
  )
}

