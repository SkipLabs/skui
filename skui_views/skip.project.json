{
  "skipVersion": "1.0",
  "variables": {
    "backend": {
      "values": ["native"],
      "default": "native"
    }
  },
  "programUnits": {
    "skui_views": {
      "kind": "Program",
      "sources": ["src/**", "target/version.sk"],
      "references": [
        { "path": ".", "name": "skui_x11gl"},
        { "path": ".", "name": "skui_fwk"}
      ]
    },
    "skui_x11gl": {
      "kind": "Library",
      "sources": ["../skui_x11gl/src/**"],
      "references": [
        { "path": ".", "name": "skui_opengl"},
        { "path": ".", "name": "cli"}
      ]
    },
    "skui_opengl": {
      "kind": "Library",
      "sources": ["../skui_opengl/src/**"],
      "references": [
        { "path": ".", "name": "skui_mtsdf"}
      ]
    },
    "skui_fwk": {
      "kind": "Library",
      "sources": ["../skui_fwk/src/**"],
      "references": [
        { "path": ".", "name": "skui_mtsdf"}
      ]
    },
    "skui_mtsdf": {
      "kind": "Library",
      "sources": ["../skui_mtsdf/src/**"],
      "references": [
        { "path": ".", "name": "skui_font"}
      ]
    },
    "skui_font": {
      "kind": "Library",
      "sources": ["../skui_font/src/**"],
      "references": [
        { "path": ".", "name": "skui_common"}
      ]
    },
    "skui_common": {
      "kind": "Library",
      "sources": ["../skui_common/src/**"],
      "references": [
        { "path": ".", "name": "prelude"},
        { "path": ".", "name": "skfs"},
        { "path": ".", "name": "base"}
      ]
    },
    "base": {
      "kind": "Library",
      "sources": [
        "../skui_base/src/**"
      ],
      "references": []
    },
    "skfs": {
      "kind": "Library",
      "sources": [
        "../../skfs_new/skfs/src/**"
      ],
      "references": []
    },
    "prelude": {
      "kind": "Library",
      "sources": [
        "../../skfs_new/prelude/src/Runtime.sk",
        "../../skfs_new/prelude/src/core/**",
        "../../skfs_new/prelude/src/stdlib/**"
      ],
      "parameters": {
        "backend": {
            "native": {"sources": ["../../skfs_new/prelude/src/native"]}
        }
      },
      "references": []
    },
    "sktest": {
      "kind": "Library",
      "sources": [
        "../../skfs_new/sktest/src/**"
      ],
      "references": [
        { "path": ".", "name": "termcolor"},
        { "path": ".", "name": "cli"}
      ]
    },
    "termcolor": {
      "kind": "Library",
      "sources": [
        "../../skfs_new/termcolor/src/**"
      ],
      "references": []
    },
    "cli": {
      "kind": "Library",
      "sources": [
        "../../skfs_new/cli/src/**"
      ],
      "references": []
    }
  },
  "default": "skui_views"
}
