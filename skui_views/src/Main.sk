module SkuiViews;

fun main(): void {
  available = mutable Vector[
    SKUIViewsButtons.view(),
    SKUIViewsSliders.view(),
    SKUIViewsSplit.view(),
    SKUIViewsProgress.view(),
    SKUIViewsTabpane.view(),
    SKUIViewsText.view(),
    SKUIViewsImage.view(),
    SKUIViewsDropdown.view(),
  ];
  /*#forEachFunction (@skuiview, #function, #functionName) {
    available.push(#function())
  };*/
  perform(available);
}

const rootPath: SKFS.DirName = SKFS.DirName::create("/ui/views/");

fun initUi(
  context: mutable SKFS.Context,
  wId: Int,
  builder: (mutable SKFS.Context, UiRoot.Storage) ~> Ui.GetterOne<
    Ui.Widget,
    UiRoot.Storage,
  >,
  support: Ui.DrawableSupport,
  inits: Array<mutable SKFS.Context ~> void> = Array[],
): void {
  FWKEnv.init(context, wId);
  context.initFontSupport();
  context.initIconSupport();
  context.initTextSupport(support);
  root = UiRoot.HStorage::create(context, SKFS.DirName::create("/ui/root/"));
  context.setGlobal("FWK.Root", root);
  (windowHdl, _ratioHdl) = initSizeManager(context);
  SystemProperties.init(context);
  Ui.init(context);
  inits.each(i -> i(context));
  getter = builder(context, root);

  FWKPipeline.initPipeline(context, getter, windowHdl, root, support, wId);
  context.setGlobal(
    "SKFS.Updater",
    SKFS.Updater(_ctx ~> FWK.update(uint32(wId))),
  );
  context.clearProfile();
}

fun initUiWidget(
  context: mutable SKFS.Context,
  wId: Int,
  getter: Ui.GetterOne<Ui.Widget, UiRoot.Storage>,
): void {
  support = SKUIGL.DrawableSupport(pictureToTexturable);
  initUi(context, wId, (_ctx, _root) ~> getter, support)
}

fun pictureToTexturable(
  picture: Ui.Picture,
  linear: Bool = true,
): ?GL.Texturable {
  picture match {
  | img @ Ui.Image _ ->
    Some(GLTexture.Image(Some(img.data), linear, img.width, img.height))
  | _ -> None()
  }
}

fun initSizeManager(
  context: mutable SKFS.Context,
): (SKFS.EHandle<UiEvent.Size>, SKFS.EHandle<SKFS.FloatFile>) {
  windowHdl = context.makeDir(
    UiEvent.Size::fromFile,
    SKFS.DirName::create("/ui/window/"),
  );
  ratioHdl = context.makeDir(
    SKFS.FloatFile::fromFile,
    SKFS.DirName::create("/ui/window/ratio/"),
  );
  iWindowHdl = SKFS.toIHandle(windowHdl);
  iRatioHdl = SKFS.toIHandle(ratioHdl);
  context.setGlobal(
    "FWK.Window.Size",
    FWK.Sizer((ctx, wId, w, h, r) ~> {
      iWindowHdl.write(ctx, SKFS.IID(wId), UiEvent.Size(w, h));
      iRatioHdl.write(ctx, SKFS.IID(wId), SKFS.FloatFile(r));
    }),
  );
  context.setGlobal(
    "FWK.Ratio",
    FWK.Ratio((ctx, wId) ~>
      iRatioHdl.maybeGet(ctx, SKFS.IID(wId)).map(v -> v.value).default(1.0)
    ),
  );
  (windowHdl, ratioHdl);
}

fun perform(
  available: readonly Vector<
    (Cli.Command, Cli.ParseResults ~> Ui.GetterOne<Ui.Widget, UiRoot.Storage>),
  >,
): void {
  command = Cli.Command("skuiviews")
    .about("SKUI's Viewer")
    .arg(
      Cli.BoolArg("version")
        .short("V")
        .long("version")
        .about("Print version info and exit"),
    );
  if (!SkargoVersion.kWasm) {
    !command = command
      .arg(
        Cli.StringArg("screen")
          .short("s")
          .long("screen")
          .about("The screen where to open the window")
          .default("0"),
      )
      .arg(
        Cli.StringArg("fps")
          .about("The frame per second refresh rate")
          .default("60"),
      )
  };
  !command = command
    .help()
    .subcommand(
      Cli.Command("help").extra().about("Displays help for a subcommand"),
    );
  available.each(v -> !command = command.subcommand(v.i0));
  args = Cli.parseArgs(command);
  args.error match {
  | Some(err) ->
    error = args.subcommand match {
    | Some(subcmd) ->
      command._subcommands.find(c -> c.name == subcmd) match {
      | Some(cmd) -> Cli.usage(cmd, false, Some(command))
      | None() -> `Unknown subcommand ${subcmd}`
      }
    | None() -> Cli.usage(command, false)
    };
    display(None(), Some(`error: ${err.getMessage()}\n${error}`))
  | _ ->
    if (args.getBool("version")) {
      display(Some("skuiviews " + SkargoVersion.kVersion))
    } else {
      args.maybeGetSubcommand() match {
      | Some(subcmd) ->
        if (subcmd == "help") {
          optSubcmd = args.extra.maybeGet(0);
          optSubcmd.flatMap(subcmd ->
            args.cmd._subcommands.filter(cmd -> cmd.name == subcmd).maybeGet(0)
          ) match {
          | Some(cmd) -> display(Some(Cli.usage(cmd, true, Some(args.cmd))))
          | _ ->
            error = optSubcmd
              .map(cmd -> `error: Invalid subcommand ${cmd}`)
              .default("error: No subcommand specified");
            display(Some(Cli.usage(args.cmd, true)), Some(error))
          };
        } else {
          available.filter(v -> v.i0.name == subcmd).maybeGet(0) match {
          | Some((cmd, fn)) ->
            wId = 0;
            title = cmd._about match {
            | Some(t) -> t
            | _ -> command._about.fromSome()
            };
            _ = SKFS.initMainContext(SKFS.Context{});
            SKFS.Context::withGc(context ~> {
              initUiWidget(context, wId, fn(args));
              context.initPre();
            });
            if (SkargoVersion.kWasm) {
              SKUIJS.init(uint32(wId), title);
            } else {
              screen = args.getString("screen").toIntOption().default(0);
              fps = args.getString("fps").toIntOption().default(60);
              SKUIX11.launch(wId, title, screen, fps);
            }
          | _ -> invariant_violation(`Unknown subcommand ${subcmd}`)
          }
        }
      | None() -> display(Some(Cli.usage(args.cmd, true)))
      }
    }
  }
}

@export("SKIP_SkuiViews_update")
fun update(): void {
  pos = checkObstack();
  SKFS.Context::withoutGc(context ~> context.updateIfRoot());
  cleanObstack(pos);
}

fun display(
  optOutput: ?String,
  optError: ?String = None(),
  html: Bool = false,
): void {
  if (SkargoVersion.kWasm) {
    SKUIJS.display(optOutput, optError, html)
  } else {
    optError.each(print_error);
    optOutput.each(print_string);
  }
}

module end;
