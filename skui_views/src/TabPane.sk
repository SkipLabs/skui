module SKUIViewsTabpane;

@skuiview
fun view(): (
  Cli.Command,
  Cli.ParseResults ~> Ui.GetterOne<Ui.Widget, UiRoot.Storage>,
) {
  (
    Cli.Command("tabpane")
      .arg(
        Cli.StringArg("side")
          .short("s")
          .long("side")
          .about("The tabpane size (left | top | right | bottom)")
          .default("top"),
      )
      .about("View that display tabpane sample."),
    args ~> {
      path = Ui.Path::create("tabpane");
      strSide = args.getString("side");
      side = strSide match {
      | "bottom" -> UiSide.Bottom()
      | "left" -> UiSide.Left()
      | "right" -> UiSide.Right()
      | _ -> UiSide.Top()
      };
      (context, _root) ~> {
        state = init(context, path.makeChild("tabsState"));
        state.registerMessageSupport(context);
        Ui.TabPane::create(
          context,
          path,
          UiTabPane.LamController{
            tabs => state.getTabs,
            tab => state.getTab,
            widget => state.getWidget,
            actions => state.getActions,
            action => state.getAction,
            side => _ctx ~> side,
            closable => (_ctx, _name) ~> true,
            closeMessages => (_ctx, tabs, _iu) ~>
              Array[state.closeMessage(tabs)],
          },
        )
      }
    },
  )
}

// TODO Simplify api

base class Executable extends Ui.Executable {
  children =
  | Init()
  | All(value: Vector<Executable>)
}

base class Command extends SKUIMessage.Command {
  fun toJSON(): JSON.Value
  | Create() -> JSON.Object(Map["__class" => JSON.String(this.getClassName())])
  | Close(toClose) ->
    JSON.Object(
      Map[
        "__class" => JSON.String(this.getClassName()),
        "toClose" => JSON.stringsToJSON(toClose),
      ],
    )

  static fun fromJSON(jsv: JSON.Value): Command {
    jso = jsv.expectObject();
    cl = jso.getString("__class");
    cl match {
    | "SKUIViewsTabpane.Create" -> Create()
    | "SKUIViewsTabpane.Close" ->
      Close(JSON.stringsFromJSON(jso.get("toClose")))
    | _ -> SKFS.cast_violation("SKUIViewsTabpane.Command", cl)
    }
  }
}

base class ExecCommand extends Command, Executable {
  children =
  | Create()
  | Close(toClose: Array<String>)
}

base class ForStorage
  extends SKUIMessage.Support
  uses SKUIMessage.WithUpdate<Command> {
  //
  fun init(_context: mutable SKFS.Context): void {
    void
  }

  protected fun executeForStorage(
    context: mutable SKFS.Context,
    storage: Storage,
    command: Command,
  ): void {
    command match {
    | executable @ ExecCommand _ -> storage.setTodo(context, executable)
    }
  }
}

class Messages(storage: Storage) extends ForStorage {
  //
  protected fun convert(message: JSON.Value): Command {
    Command::fromJSON(message)
  }

  protected fun convertCmd(command: SKUIMessage.Command): Command {
    command as Command _;
  }

  protected fun execute(
    context: mutable SKFS.Context,
    _name: String,
    _scope: String,
    command: Command,
  ): void {
    this.executeForStorage(context, this.storage, command)
  }
}

class AllMessages() extends ForStorage {
  //
  protected fun execute(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
    command: Command,
  ): void {
    Storage::forNameAndScope(context, name, scope).each(storage ->
      this.executeForStorage(context, storage, command)
    )
  }

  protected fun convert(message: JSON.Value): Command {
    Command::fromJSON(message)
  }

  protected fun convertCmd(command: SKUIMessage.Command): Command {
    command as Command _;
  }
}

const statePath: String = "ui/tpview/state";
const colors: Array<String> = Array["yellow", "blue", "green", "red", "black"];

const tabsKey: SKFS.BaseName = SKFS.StrID("tabs");
const nextKey: SKFS.BaseName = SKFS.StrID("next");

class Tab(color: String, alpha: Int = 100) uses Orderable {
  fun toId(): String {
    strAlpha = this.alpha.toString();
    aChars = strAlpha.chars();
    if (aChars.size() < 3) {
      !strAlpha = String::fromChars(
        Arrays.merge(Array::fill(3 - aChars.size(), '0'), aChars.toArray()),
      )
    };
    `${this.color}_${strAlpha}`
  }
}

class Tabs(v: Array<Tab>) extends SKFS.File
class TabIds(v: Array<String>) extends SKFS.File

class Storage(name: String, handle: SKFS.IHandle<SKFS.File>) {
  //
  static fun forNameAndScope(
    context: mutable SKFS.Context,
    name: String,
    scope: String,
  ): ?this {
    hdl = SKFS.IHandle(SKFS.FileConverter(f ~> f), SKFS.DirName::create(scope));
    if (hdl.exists(context)) Some(Storage(name, hdl)) else None()
  }

  fun getName(): String {
    this.name
  }

  fun getScope(): String {
    this.handle.getDirName().toString()
  }

  fun setTodo(context: mutable SKFS.Context, value: Executable): void {
    this.handle.write(context, Ui.todoProp, Ui.Todo(value, context.tick))
  }
}

class State(
  storage: SKFS.EHandle<SKFS.File>,
  computed: SKFS.EHandle<SKFS.File>,
) {
  //
  fun getTabs(context: mutable SKFS.Context): Array<String> {
    default: Tabs = Tabs(Array[]);
    this.computed.getProp(context, tabsKey, Tabs::fromFile, default).v.map(t ->
      t.toId()
    )
  }

  fun getTab(_context: mutable SKFS.Context, id: String): UiTabPane.Tab {
    elems = id.split("_");
    color = elems[0];
    alpha = elems[1].toInt();
    name = color match {
    | "yellow" -> "Yellow"
    | "blue" -> "Blue"
    | "green" -> "Green"
    | "red" -> "Red"
    | "black" -> "Black"
    | _ -> color
    };
    alphaTxt = Raw(`${alpha} %`);
    UiTabPane.Tab{
      optText => Some(Format(!"{1} color", Array[!name])),
      optDiscriminant => Some(alphaTxt),
      optTooltip => Some(Format(Raw("{1} {2}"), Array[!name, alphaTxt])),
    }
  }

  fun getActions(_context: mutable SKFS.Context): Array<String> {
    Array["add"]
  }

  fun getAction(context: mutable SKFS.Context, action: String): UiTabs.Action {
    action match {
    | "add" ->
      UiTabs.Action(
        action,
        context.getThemeIcon(UiTheme.Add()),
        Some(!"Add tab"),
        ctx ~> SKUIMessage.emitMessage(ctx, this.createMessage()),
      )
    | _ -> invariant_violation("Invalid action")
    }
  }

  fun getWidget(context: mutable SKFS.Context, id: String): ?Ui.Widget {
    elems = id.split("_");
    color = elems[0];
    alpha = elems[1].toInt();
    optColor = color match {
    | "yellow" -> Some(Colors.yellow())
    | "blue" -> Some(Colors.blue())
    | "green" -> Some(Colors.green())
    | "red" -> Some(Colors.red())
    | "black" -> Some(Colors.black())
    | _ -> None()
    };
    optColor.map(color ->
      Ui.Decorated::create(
        context,
        Ui.Path::create("tabpane").makeChild("content").makeChild(id),
        UiDecorated.LamController{
          decoration => _ctx ~>
            Ui.Background(color.withAlpha(alpha.toFloat() / 100.0)),
        },
      )
    );
  }

  fun createMessage(): SKUIMessage.Message {
    this.message(Create())
  }

  fun closeMessage(toClose: Array<String>): SKUIMessage.Message {
    this.message(Close(toClose))
  }

  fun registerMessageSupport(context: mutable SKFS.Context): void {
    context.registerMessageSupport(
      statePath,
      this.storage.getDirName().toString(),
      Messages(Storage(statePath, SKFS.toIHandle(this.storage))),
    );
  }

  private fun message(command: SKUIMessage.Command): SKUIMessage.Message {
    SKUIMessage.Message(
      statePath,
      this.storage.getDirName().toString(),
      command,
    )
  }
}

fun update(
  context: mutable SKFS.Context,
  _scope: String,
  values: mutable Map<SKFS.BaseName, ?SKFS.File>,
  todo: Ui.Todo,
  _optUserData: ?SKFS.UserData,
): void {
  execute(context, todo.command as Executable _, values);
}

@debug
fun execute(
  context: mutable SKFS.Context,
  executable: Executable,
  values: mutable Map<SKFS.BaseName, ?SKFS.File>,
): void {
  executable match {
  | All(cmds) -> cmds.each(cmd -> execute(context, cmd, values))
  | Init() ->
    values.set(
      tabsKey,
      Some(
        Tabs(
          Array[
            Tab("yellow"),
            Tab("blue"),
            Tab("green"),
            Tab("red"),
            Tab("black"),
          ],
        ),
      ),
    );
    values.set(nextKey, Some(SKFS.IntFile(0)))
  | Create() ->
    tabs = values.get(tabsKey).map(Tabs::fromFile).fromSome().v;
    next = values
      .get(nextKey)
      .map(f ~> SKFS.IntFile::fromFile(f).value)
      .default(0);
    nColor = colors[next];
    current = tabs.filter(t -> t.color == nColor);
    if (current.size() == 0) {
      !tabs = Arrays.add(tabs, Tab(nColor));
    } else {
      alpha = current.reduce((acc, v) -> acc + v.alpha, 0);
      nAlpha = (100.0 / (2.0 * alpha.toFloat()) * 100.0).toInt();
      // For testing only, can loop
      while (current.any(t -> t.alpha == nAlpha)) {
        !nAlpha = nAlpha / 2;
      };
      !tabs = Arrays.add(tabs, Tab(nColor, nAlpha));
    };
    values.set(tabsKey, Some(Tabs(tabs)));
    values.set(nextKey, Some(SKFS.IntFile((next + 1) % 5)))
  | Close(toClose) ->
    tabs = values.get(tabsKey).map(Tabs::fromFile).fromSome().v;
    set = SortedSet::createFromItems(toClose);
    values.set(tabsKey, Some(Tabs(tabs.filter(t -> !set.contains(t.toId())))))
  }
}

@debug
fun init(context: mutable SKFS.Context, path: Ui.Path): State {
  dirName = Ui.controllerDirName(path);
  stateHdl = context.makeDir(
    Ui.Todo::fromFile,
    dirName,
    Array[(Ui.todoProp, Ui.Todo(Init(), context.tick))],
  );
  computedDirName = SKFS.DirName::make(dirName, "computed/");
  computedHdl = SKFS.derive(
    context,
    dirName.toString(),
    computedDirName,
    stateHdl,
    Ui.todoProp,
    Array[tabsKey, nextKey],
    update,
    None(),
  );
  State(stateHdl, computedHdl)
}
