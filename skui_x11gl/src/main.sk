module SkuiX11gl;

fun main(): void {
  args = Cli.Command("skuiargo")
    .about("Skip UI's GL Shader Viewer")
    .arg(
      Cli.BoolArg("version")
        .short("V")
        .long("version")
        .about("Print version info and exit"),
    )
    .help()
    .arg(
      Cli.StringArg("name")
        .short("n")
        .long("name")
        .about("The name of the shader to show.")
        .default("rectangle"),
    )
    .parseArgs();
  if (args.getBool("version")) {
    print_string("skuix11gl " + SkargoVersion.kVersion);
  } else if (args.getBool("help")) {
    print_string(Cli.usage(args.cmd, true));
  } else {
    run(0, 10, 10, 800, 600, "Skip UI's GL Shader Viewer", 0, 60);
  }
}

@cpp_extern
native fun run(
  wId: Int,
  x: Int,
  y: Int,
  width: Int,
  height: Int,
  title: String,
  screen: Int,
  framePerSecond: Int,
): void;

@cpp_export("SKIP_SkuiX11gl_performFrame")
fun performFrame(wId: Int, width: Int, height: Int): void {
  pos = SKFS.newObstack();
  ctx = GL.Ctx(UInt32::truncate(wId));
  ctx.bindMainFrameBuffer();
  ctx.enableBlend();
  ctx.straitAlphaBlending();
  ctx.viewport(int32(0), int32(0), uint32(width), uint32(height));
  ctx.clearColor(1.0, 1.0, 1.0, 1.0);
  ctx.clear();

  ctx.flush();
  SKFS.destroyObstack(pos);
}


module end;
