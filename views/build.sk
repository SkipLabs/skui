module SkuiViewsBuild;

@skui_build__source_dirs
fun source_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) Array["native/src"] else Array[]
}

@skui_build__include_dirs
fun include_dirs(env: SkuiBuild.Env): Array<String> {
  if (!env.isWasm32()) {
    Array[
      "../opengl/native/src/includes",
      "../base/native/src/includes",
      "../x11gl/native/src/includes",
    ]
  } else {
    Array[]
  }
}

@skui_build__resources
fun resources(_env: SkuiBuild.Env): Array<String> {
  Array["resources/src/big.bin", "resources/src/small.bin"]
}

@skui_build__extra_sources
fun extra_sources(env: SkuiBuild.Env): Array<String> {
  if (env.isWasm32()) {
    Array["../framework_js/src/Wasm32.sk", "../framework_js/src/JSEvents.sk"]
  } else {
    Array[
      "../x11gl/extra/Host.sk",
      "../x11gl/extra/X11Events.sk",
      "../x11gl/extra/X11Key.sk",
    ]
  }
}

module end;

fun main(): void {
  SkuiBuild.build("skuiviews") match {
  | Failure(err) -> skipExit(err.code)
  | _ -> void
  }
}
